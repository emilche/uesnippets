      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        }
      ],
      "returnType": "Void",
      "docs": "This tells the allocator that we are about to call AllocateRecords\none or many times to allocate pRecordCount records.\n\\param pRecordCount\n\\remarks This gives the allocator a chance to do whatever it deems necessary\nto optimize subsequent allocations, for example, by preallocating a\nsufficiently large pool of memory."
    },
