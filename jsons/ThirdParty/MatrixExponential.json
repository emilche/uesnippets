    {
      "id": "matrix-exp-pade-3",
      "name": "matrix_exp_pade3",
      "category": "MatrixExponential",
      "signature": "matrix_exp_pade3(A, U, V)",
      "params": [
        {
          "name": "A",
          "type": "MatA&"
        },
        {
          "name": "U",
          "type": "MatU&"
        },
        {
          "name": "V",
          "type": "MatV&"
        }
      ],
      "returnType": "template<MatA,MatU,MatV> void",
      "docs": "\\brief Compute the (3,3)-Pad&eacute; approximant to the exponential.\nAfter exit, \\f$ (V+U)(V-U)^{-1} \\f$ is the Pad&eacute;\napproximant of \\f$ \\exp(A) \\f$ around \\f$ A = 0 \\f$."
    },
