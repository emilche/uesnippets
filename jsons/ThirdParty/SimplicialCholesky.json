    {
      "id": "simplicial-ldlt-f3e418",
      "name": "SimplicialLDLT",
      "category": "SimplicialCholesky",
      "signature": "SimplicialLDLT(Target, Base)",
      "params": [
        {
          "name": "Target",
          "type": "SimplicialCholesky*"
        },
        {
          "name": "Base",
          "type": ") :"
        }
      ],
      "returnType": "Void",
      "docs": "\\ingroup SparseCholesky_Module\n\\class SimplicialLDLT\n\\brief A direct sparse LDLT Cholesky factorizations without square root.\nThis class provides a LDL^T Cholesky factorizations without square root of sparse matrices that are\nselfadjoint and positive definite. The factorization allows for solving A.X = B where\nX and B can be either dense or sparse.\nIn order to reduce the fill-in, a symmetric permutation P is applied prior to the factorization\nsuch that the factorized matrix is P A P^-1.\n\\tparam _MatrixType the type of the sparse matrix A, it must be a SparseMatrix<>\n\\tparam _UpLo the triangular part that will be used for the computations. It can be Lower\nor Upper. Default is Lower.\n\\tparam _Ordering The ordering method to use, either AMDOrdering<> or NaturalOrdering<>. Default is AMDOrdering<>\n\\implsparsesolverconcept\n\\sa class SimplicialLLT, class AMDOrdering, class NaturalOrdering"
    },
