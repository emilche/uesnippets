        {
          "name": "Dir",
          "type": "Vector3::Arg"
        }
      ],
      "returnType": "Void",
      "docs": "/// Add a weighted sample to the sh coefficients.\nvoid AddSample( const Vec3 & dir, const Color3f & color, float w=1.0f ) {\nfor(int l = 0; l <= order; l++) {\nfor(int m = -l; m <= l; m++) {\nColor3f & elem = GetElem(l, m);\nelem.Mad( elem, color, w * y(l, m, dir) );\n}\n}\n}"
