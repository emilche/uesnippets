    {
      "id": "compute",
      "name": "compute",
      "category": "SparseLU",
      "signature": "compute(Target, Matrix)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        },
        {
          "name": "Matrix",
          "type": "MatrixType&"
        }
      ],
      "returnType": "Void",
      "docs": "Compute the symbolic and numeric factorization of the input sparse matrix.\nThe input matrix should be in column-major storage."
    },
    {
      "id": "transpose",
      "name": "transpose",
      "category": "SparseLU",
      "signature": "transpose(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        }
      ],
      "returnType": "SparseLUTransposeView<false,SparseLU<_MatrixType,_OrderingType>>",
      "docs": "\\returns an expression of the transposed of the factored matrix.\nA typical usage is to solve for the transposed problem A^T x = b:\n\\code\nsolver.compute(A);\nx = solver.transpose().solve(b);\n\\endcode\n\\sa adjoint(), solve()"
    },
    {
      "id": "adjoint",
      "name": "adjoint",
      "category": "SparseLU",
      "signature": "adjoint(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        }
      ],
      "returnType": "SparseLUTransposeView<true,SparseLU<_MatrixType,_OrderingType>>",
      "docs": "\\returns an expression of the adjoint of the factored matrix\nA typical usage is to solve for the adjoint problem A' x = b:\n\\code\nsolver.compute(A);\nx = solver.adjoint().solve(b);\n\\endcode\nFor real scalar types, this function is equivalent to transpose().\n\\sa transpose(), solve()"
    },
