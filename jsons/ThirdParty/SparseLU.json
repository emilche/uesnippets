    {
      "id": "analyze-pattern",
      "name": "analyzePattern",
      "category": "SparseLU",
      "signature": "analyzePattern(Target, Mat)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        },
        {
          "name": "Mat",
          "type": "MatrixType&"
        }
      ],
      "returnType": "template<MatrixType,OrderingType> void SparseLU<MatrixType,OrderingType",
      "docs": "Compute the column permutation to minimize the fill-in\n- Apply this permutation to the input matrix -\n- Compute the column elimination tree on the permuted matrix\n- Postorder the elimination tree and the column permutation"
    },
    {
      "id": "factorize",
      "name": "factorize",
      "category": "SparseLU",
      "signature": "factorize(Target, Matrix)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        },
        {
          "name": "Matrix",
          "type": "MatrixType&"
        }
      ],
      "returnType": "template<MatrixType,OrderingType> void SparseLU<MatrixType,OrderingType",
      "docs": "- Numerical factorization\n- Interleaved with the symbolic factorization\nOn exit,  info is\n= 0: successful factorization\n> 0: if info = i, and i is\n<= A->ncol: U(i,i) is exactly zero. The factorization has\nbeen completed, but the factor U is exactly singular,\nand division by zero will occur if it is used to solve a\nsystem of equations.\n> A->ncol: number of bytes allocated when memory allocation\nfailure occurred, plus A->ncol. If lwork = -1, it is\nthe estimated amount of space needed, plus A->ncol."
    },
