    {
      "id": "abs-determinant",
      "name": "absDeterminant",
      "category": "SparseLU",
      "signature": "absDeterminant(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        }
      ],
      "returnType": "Scalar",
      "docs": "\\returns the absolute value of the determinant of the matrix of which\n*this is the QR decomposition.\n\\warning a determinant can be very big or small, so for matrices\nof large enough dimension, there is a risk of overflow/underflow.\nOne way to work around that is to use logAbsDeterminant() instead.\n\\sa logAbsDeterminant(), signDeterminant()"
    },
    {
      "id": "log-abs-determinant",
      "name": "logAbsDeterminant",
      "category": "SparseLU",
      "signature": "logAbsDeterminant(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        }
      ],
      "returnType": "Scalar",
      "docs": "\\returns the natural log of the absolute value of the determinant of the matrix\nof which **this is the QR decomposition\n\\note This method is useful to work around the risk of overflow/underflow that's\ninherent to the determinant computation.\n\\sa absDeterminant(), signDeterminant()"
    },
    {
      "id": "sign-determinant",
      "name": "signDeterminant",
      "category": "SparseLU",
      "signature": "signDeterminant(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseLU*"
        }
      ],
      "returnType": "Scalar",
      "docs": "\\returns A number representing the sign of the determinant\n\\sa absDeterminant(), logAbsDeterminant()"
    },
    {
      "id": "determinant",
