      "id": "as-variable",
      "name": "as_variable",
      "category": "ir",
      "signature": "as_variable(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ir_instruction*"
        }
      ],
      "returnType": "class ir_variable*",
      "docs": "\\name IR instruction downcast functions\nThese functions either cast the object to a derived class or return\n\\c NULL if the object's type does not match the specified derived class.\nAdditional downcast functions will be added as needed.",
      "supportedTargets": [
        "ir_instruction*",
        "ir_variable*"
      ]
    },
