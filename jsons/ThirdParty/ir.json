      "returnType": "ir_variable*",
      "docs": "Get the variable that is ultimately referenced by an r-value",
      "supportedTargets": [
        "ir_rvalue*",
        "ir_dereference_variable*",
        "ir_dereference_array*",
        "ir_dereference_image*",
        "ir_dereference_record*"
