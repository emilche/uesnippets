    {
      "id": "whole-variable-referenced",
      "name": "whole_variable_referenced",
      "category": "ir",
      "signature": "whole_variable_referenced(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ir_rvalue*"
        }
      ],
      "returnType": "ir_variable*",
      "docs": "If an r-value is a reference to a whole variable, get that variable\n\\return\nPointer to a variable that is completely dereferenced by the r-value.  If\nthe r-value is not a dereference or the dereference does not access the\nentire variable (i.e., it's just one array element, struct field), \\c NULL\nis returned.",
      "supportedTargets": [
        "ir_rvalue*",
        "ir_dereference_variable*"
      ]
    },
    {
      "id": "function",
      "name": "function",
      "category": "ir",
      "signature": "function(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ir_function_signature*"
        }
      ],
      "returnType": "class ir_function*",
      "docs": "Get a handle to the function for which this is a signature\nThere is no setter function, this function returns a \\c const pointer,\nand \\c ir_function_signature::_function is private for a reason.  The\nonly way to make a connection between a function and function signature\nis via \\c ir_function::add_signature.  This helps ensure that certain\ninvariants (i.e., a function signature is in the list of signatures for\nits \\c _function) are met.\n\\sa ir_function::add_signature"
    },
