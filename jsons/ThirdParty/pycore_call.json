    {
      "id": "py-object-vectorcall-tstate",
      "name": "_PyObject_VectorcallTstate",
      "category": "pycore_call",
      "signature": "_PyObject_VectorcallTstate(Tstate, Callable, Args, Nargsf, Kwnames)",
      "params": [
        {
          "name": "Tstate",
          "type": "PyThreadState*"
        },
        {
          "name": "Callable",
          "type": "PyObject*"
        },
        {
          "name": "Args",
          "type": "PyObject**"
        },
        {
          "name": "Nargsf",
          "type": "size_t"
        },
        {
          "name": "Kwnames",
          "type": "PyObject*"
        }
      ],
      "returnType": "PyObject*",
      "docs": "Call the callable object 'callable' with the \"vectorcall\" calling\nconvention.\nargs is a C array for positional arguments.\nnargsf is the number of positional arguments plus optionally the flag\nPY_VECTORCALL_ARGUMENTS_OFFSET which means that the caller is allowed to\nmodify args[-1].\nkwnames is a tuple of keyword names. The values of the keyword arguments\nare stored in \"args\" after the positional arguments (note that the number\nof keyword arguments does not change nargsf). kwnames can also be NULL if\nthere are no keyword arguments.\nkeywords must only contain strings and all keys must be unique.\nReturn the result on success. Raise an exception and return NULL on\nerror."
    },
