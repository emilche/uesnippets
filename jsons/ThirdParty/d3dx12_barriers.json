      "name": "Aliasing",
      "category": "d3dx12_barriers",
      "signature": "Aliasing(P Resource Before, P Resource After)",
      "params": [
        {
          "name": "P Resource Before",
          "type": "_In_opt_ ID3D12Resource*"
        },
        {
          "name": "P Resource After",
          "type": "_In_opt_ ID3D12Resource*"
