    {
      "id": "stable-norm",
      "name": "stableNorm",
      "category": "StableNorm",
      "signature": "stableNorm()",
      "params": [],
      "returnType": "template<Derived> NumTraits<internal::traits<Derived>::Scalar>::Real MatrixBase<Derived",
      "docs": "\\returns the \\em l2 norm of \\c *this avoiding underflow and overflow.\nThis version use a blockwise two passes algorithm:\n1 - find the absolute largest coefficient \\c s\n2 - compute \\f$ s \\Vert \\frac{*this}{s} \\Vert \\f$ in a standard way\nFor architecture/scalar types supporting vectorization, this version\nis faster than blueNorm(). Otherwise the blueNorm() is much faster.\n\\sa norm(), blueNorm(), hypotNorm()"
    },
    {
      "id": "blue-norm",
      "name": "blueNorm",
      "category": "StableNorm",
      "signature": "blueNorm()",
      "params": [],
      "returnType": "template<Derived> NumTraits<internal::traits<Derived>::Scalar>::Real MatrixBase<Derived",
      "docs": "\\returns the \\em l2 norm of \\c *this using the Blue's algorithm.\nA Portable Fortran Program to Find the Euclidean Norm of a Vector,\nACM TOMS, Vol 4, Issue 1, 1978.\nFor architecture/scalar types without vectorization, this version\nis much faster than stableNorm(). Otherwise the stableNorm() is faster.\n\\sa norm(), stableNorm(), hypotNorm()"
    },
    {
      "id": "hypot-norm",
      "name": "hypotNorm",
      "category": "StableNorm",
      "signature": "hypotNorm()",
      "params": [],
      "returnType": "template<Derived> NumTraits<internal::traits<Derived>::Scalar>::Real MatrixBase<Derived",
      "docs": "\\returns the \\em l2 norm of \\c *this avoiding undeflow and overflow.\nThis version use a concatenation of hypot() calls, and it is very slow.\n\\sa norm(), stableNorm()"
    }
  ]
