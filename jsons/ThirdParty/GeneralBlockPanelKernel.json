    {
      "id": "evaluate-product-blocking-sizes-heuristic",
      "name": "evaluateProductBlockingSizesHeuristic",
      "category": "GeneralBlockPanelKernel",
      "signature": "evaluateProductBlockingSizesHeuristic(K, M, N, Num Threads)",
      "params": [
        {
          "name": "K",
          "type": "Index&"
        },
        {
          "name": "M",
          "type": "Index&"
        },
        {
          "name": "N",
          "type": "Index&"
        },
        {
          "name": "Num Threads",
          "type": "Index",
          "default": "1"
        }
      ],
      "returnType": "template<LhsScalar,RhsScalar,int KcFactor,Index> void",
      "docs": "Helper for computeProductBlockingSizes.\nGiven a m x k times k x n matrix product of scalar types \\c LhsScalar and \\c RhsScalar,\nthis function computes the blocking size parameters along the respective dimensions\nfor matrix products and related algorithms. The blocking sizes depends on various\nparameters:\n- the L1 and L2 cache sizes,\n- the register level blocking sizes defined by gebp_traits,\n- the number of scalars that fit into a packet (when vectorization is enabled).\n\\sa setCpuCacheSizes"
    },
    {
      "id": "use-specific-blocking-sizes",
      "name": "useSpecificBlockingSizes",
      "category": "GeneralBlockPanelKernel",
      "signature": "useSpecificBlockingSizes(K, M, N)",
      "params": [
        {
          "name": "K",
          "type": "Index&"
        },
        {
          "name": "M",
          "type": "Index&"
        },
        {
          "name": "N",
          "type": "Index&"
        }
      ],
      "returnType": "template<Index> bool"
    },
    {
      "id": "compute-product-blocking-sizes",
      "name": "computeProductBlockingSizes",
      "category": "GeneralBlockPanelKernel",
      "signature": "computeProductBlockingSizes(K, M, N, Num Threads)",
      "params": [
        {
          "name": "K",
          "type": "Index&"
        },
        {
          "name": "M",
          "type": "Index&"
        },
        {
          "name": "N",
          "type": "Index&"
        },
        {
          "name": "Num Threads",
          "type": "Index",
          "default": "1"
        }
      ],
      "returnType": "template<LhsScalar,RhsScalar,int KcFactor,Index> void",
      "docs": "\\brief Computes the blocking parameters for a m x k times k x n matrix product\n\\param[in,out] k Input: the third dimension of the product. Output: the blocking size along the same dimension.\n\\param[in,out] m Input: the number of rows of the left hand side. Output: the blocking size along the same dimension.\n\\param[in,out] n Input: the number of columns of the right hand side. Output: the blocking size along the same dimension.\nGiven a m x k times k x n matrix product of scalar types \\c LhsScalar and \\c RhsScalar,\nthis function computes the blocking size parameters along the respective dimensions\nfor matrix products and related algorithms.\nThe blocking size parameters may be evaluated:\n- either by a heuristic based on cache sizes;\n- or using fixed prescribed values (for testing purposes).\n\\sa setCpuCacheSizes"
    },
