        {
          "name": "Cols",
          "type": "Index"
        }
      ],
      "returnType": "Void",
      "docs": "Resizes the sparse vector to \\a rows x \\a cols\nThis method is provided for compatibility with matrices.\nFor a column vector, \\a cols must be equal to 1.\nFor a row vector, \\a rows must be equal to 1.\n\\sa resize(Index)"
    },
    {
      "id": "resize-828bff",
      "name": "resize",
      "category": "SparseVector",
      "signature": "resize(Target, New Size)",
      "params": [
        {
