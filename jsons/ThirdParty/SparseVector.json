          "type": "SparseVector*"
        },
        {
          "name": "New Size",
          "type": "Index"
        }
      ],
      "returnType": "Void",
      "docs": "Resizes the sparse vector to \\a newSize\nThis method deletes all entries, thus leaving an empty sparse vector\n\\sa  conservativeResize(), setZero()"
    },
    {
      "id": "conservative-resize",
      "name": "conservativeResize",
      "category": "SparseVector",
      "signature": "conservativeResize(Target, New Size)",
      "params": [
        {
          "name": "Target",
          "type": "SparseVector*"
        },
        {
          "name": "New Size",
          "type": "Index"
        }
      ],
      "returnType": "Void",
      "docs": "Resizes the sparse vector to \\a newSize, while leaving old values untouched.\nIf the size of the vector is decreased, then the storage of the out-of bounds coefficients is kept and reserved.\nCall .data().squeeze() to free extra memory.\n\\sa reserve(), setZero()"
    },
