    {
      "id": "doit",
      "name": "doit",
      "category": "Value",
      "signature": "doit(Val)",
      "params": [
        {
          "name": "Val",
          "type": "Value&"
        }
      ],
      "returnType": "Bool",
      "docs": "template <class Compare>\nvoid Value::mergeUseListsImpl(Use *L, Use *R, Use **Next, Compare Cmp) {\nif (!L) {\nNext = R;\nreturn;\n}\nif (!R) {\nNext = L;\nreturn;\n}\nif (Cmp(*R, *L)) {\nNext = R;\nmergeUseListsImpl(L, R->Next, &R->Next, Cmp);\nreturn;\n}\nNext = L;\nmergeUseListsImpl(L->Next, R, &L->Next, Cmp);\n}"
    },
