        },
        {
          "name": "Computation Options",
          "type": "unsigned int"
        }
      ],
      "returnType": "template<Derived> JacobiSVD<MatrixBase<Derived>::PlainObject> MatrixBase<Derived",
      "docs": "\\svd_module\n\\return the singular value decomposition of \\c *this computed by two-sided\nJacobi transformations.\n\\sa class JacobiSVD"
