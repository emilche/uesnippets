      "returnType": "Int",
      "docs": "Call directly the given test unit function."
    },
    {
      "id": "test-error",
      "name": "test_error__",
      "category": "cutest",
      "signature": "test_error__(Fmt)",
      "params": [
        {
          "name": "Fmt",
          "type": "char*"
        }
      ],
      "returnType": "Void",
      "docs": "Called if anything goes bad in cutest, or if the unit test ends in other\nway then by normal returning from its function (e.g. exception or some\nabnormal child process termination)."
    },
    {
      "id": "test-run",
      "name": "test_run__",
      "category": "cutest",
      "signature": "test_run__(Test)",
      "params": [
        {
          "name": "Test",
          "type": "test__*"
        }
      ],
      "returnType": "Void",
      "docs": "Trigger the unit test. If possible (and not suppressed) it starts a child\nprocess who calls test_do_run__(), otherwise it calls test_do_run__()\ndirectly."
    },
