      "returnType": "template<MatrixType,int _UpLo> template<InputType> LDLT<MatrixType,_UpLo>& LDLT<MatrixType,_UpLo",
      "docs": "Compute / recompute the LDLT decomposition A = L D L^* = U^* D U of \\a matrix"
    },
    {
      "id": "rank-update",
      "name": "rankUpdate",
      "category": "LDLT",
      "signature": "rankUpdate(Target, W, Sigma)",
      "params": [
        {
          "name": "Target",
          "type": "LDLT*"
        },
        {
          "name": "W",
          "type": "MatrixBase<Derived>&"
        },
        {
          "name": "Sigma",
          "type": "LDLT<MatrixType,_UpLo>::RealScalar&"
        }
      ],
      "returnType": "template<MatrixType,int _UpLo> template<Derived> LDLT<MatrixType,_UpLo>& LDLT<MatrixType,_UpLo",
      "docs": "Update the LDLT decomposition:  given A = L D L^T, efficiently compute the decomposition of A + sigma w w^T.\n\\param w a vector to be incorporated into the decomposition.\n\\param sigma a scalar, +1 for updates and -1 for \"downdates,\" which correspond to removing previously-added column vectors. Optional; default value is +1.\n\\sa setZero()"
    },
