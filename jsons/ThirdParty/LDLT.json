    {
      "id": "solve-in-place",
      "name": "solveInPlace",
      "category": "LDLT",
      "signature": "solveInPlace(Target, B And X)",
      "params": [
        {
          "name": "Target",
          "type": "LDLT*"
        },
        {
          "name": "B And X",
          "type": "MatrixBase<Derived>&"
        }
      ],
      "returnType": "template<MatrixType,int _UpLo> template<Derived> bool LDLT<MatrixType,_UpLo",
      "docs": "\\internal use x = ldlt_object.solve(x);\nThis is the \\em in-place version of solve().\n\\param bAndX represents both the right-hand side matrix b and result x.\n\\returns true always! If you need to check for existence of solutions, use another decomposition like LU, QR, or SVD.\nThis version avoids a copy when the right hand side matrix b is not\nneeded anymore.\n\\sa LDLT::solve(), MatrixBase::ldlt()"
    },
    {
      "id": "reconstructed-matrix",
      "name": "reconstructedMatrix",
