  "functions": [
    {
      "id": "set-default-t",
      "name": "SetDefaultT",
      "category": "fbxtexture",
      "signature": "SetDefaultT(Target, P T)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P T",
          "type": "FbxVector4&"
        }
      ],
      "returnType": "Void",
      "docs": "\\name Default Values Management By Vectors\nThis set of functions provides direct access to the default values in vector base."
    },
    {
      "id": "set-default-r",
      "name": "SetDefaultR",
      "category": "fbxtexture",
      "signature": "SetDefaultR(Target, P R)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P R",
          "type": "FbxVector4&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the default rotation vector.\n\\param pR           The first element is the texture rotation around the\nU axis in degrees. The second element is the texture rotation\naround the V axis in degrees. The third element is the texture\nrotation around the W axis in degrees.\n\\remarks            The W axis is oriented toward the result of the\nvector product of the U and V axes that is W = U x V."
    },
    {
      "id": "set-default-s",
      "name": "SetDefaultS",
      "category": "fbxtexture",
      "signature": "SetDefaultS(Target, P S)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P S",
          "type": "FbxVector4&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the default scale vector.\n\\param pS           The first element is scale applied to the texture width.\nThe second element is scale applied to the texture height. The third\nand fourth elements have no effect on the texture.\n\\remarks            A scale value less than 1 stretches the texture.\nA scale value greater than 1 compresses the texture."
    },
