    {
      "id": "homogeneous",
      "name": "homogeneous",
      "category": "Homogeneous",
      "signature": "homogeneous(Target)",
      "params": [
        {
          "name": "Target",
          "type": "Homogeneous*"
        }
      ],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC MatrixBase<Derived>::HomogeneousReturnType MatrixBase<Derived",
      "docs": "\\geometry_module \\ingroup Geometry_Module\n\\returns a vector expression that is one longer than the vector argument, with the value 1 symbolically appended as the last coefficient.\nThis can be used to convert affine coordinates to homogeneous coordinates.\n\\only_for_vectors\nExample: \\include MatrixBase_homogeneous.cpp\nOutput: \\verbinclude MatrixBase_homogeneous.out\n\\sa VectorwiseOp::homogeneous(), class Homogeneous"
    },
    {
      "id": "hnormalized",
      "name": "hnormalized",
      "category": "Homogeneous",
      "signature": "hnormalized(Target)",
      "params": [
        {
          "name": "Target",
          "type": "Homogeneous*"
        }
      ],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC MatrixBase<Derived>::HNormalizedReturnType MatrixBase<Derived",
      "docs": "\\geometry_module \\ingroup Geometry_Module\n\\brief homogeneous normalization\n\\returns a vector expression of the N-1 first coefficients of \\c *this divided by that last coefficient.\nThis can be used to convert homogeneous coordinates to affine coordinates.\nIt is essentially a shortcut for:\n\\code\nthis->head(this->size()-1)/this->coeff(this->size()-1);\n\\endcode\nExample: \\include MatrixBase_hnormalized.cpp\nOutput: \\verbinclude MatrixBase_hnormalized.out\n\\sa VectorwiseOp::hnormalized()"
    },
