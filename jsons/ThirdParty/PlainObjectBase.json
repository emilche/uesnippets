    {
      "id": "resize-72034d",
      "name": "resize",
      "category": "PlainObjectBase",
      "signature": "resize(Target, Rows, Cols)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Rows",
          "type": "Index"
        },
        {
          "name": "Cols",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes \\c *this to a \\a rows x \\a cols matrix.\nThis method is intended for dynamic-size matrices, although it is legal to call it on any\nmatrix as long as fixed dimensions are left unchanged. If you only want to change the number\nof rows and/or of columns, you can use resize(NoChange_t, Index), resize(Index, NoChange_t).\nIf the current number of coefficients of \\c *this exactly matches the\nproduct \\a rows * \\a cols, then no memory allocation is performed and\nthe current values are left unchanged. In all other cases, including\nshrinking, the data is reallocated and all previous values are lost.\nExample: \\include Matrix_resize_int_int.cpp\nOutput: \\verbinclude Matrix_resize_int_int.out\n\\sa resize(Index) for vectors, resize(NoChange_t, Index), resize(Index, NoChange_t)"
    },
    {
      "id": "resize-04387a",
      "name": "resize",
      "category": "PlainObjectBase",
      "signature": "resize(Target, Size)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Size",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC void",
      "docs": "Resizes \\c *this to a vector of length \\a size\n\\only_for_vectors. This method does not work for\npartially dynamic matrices when the static dimension is anything other\nthan 1. For example it will not work with Matrix<double, 2, Dynamic>.\nExample: \\include Matrix_resize_int.cpp\nOutput: \\verbinclude Matrix_resize_int.out\n\\sa resize(Index,Index), resize(NoChange_t, Index), resize(Index, NoChange_t)"
    },
    {
      "id": "resize-2b7032",
      "name": "resize",
      "category": "PlainObjectBase",
      "signature": "resize(Target, Cols)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Cols",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC void",
      "docs": "Resizes the matrix, changing only the number of columns. For the parameter of type NoChange_t, just pass the special value \\c NoChange\nas in the example below.\nExample: \\include Matrix_resize_NoChange_int.cpp\nOutput: \\verbinclude Matrix_resize_NoChange_int.out\n\\sa resize(Index,Index)"
    },
    {
      "id": "resize-f04f57",
      "name": "resize",
      "category": "PlainObjectBase",
      "signature": "resize(Target, Rows)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Rows",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC void",
      "docs": "Resizes the matrix, changing only the number of rows. For the parameter of type NoChange_t, just pass the special value \\c NoChange\nas in the example below.\nExample: \\include Matrix_resize_int_NoChange.cpp\nOutput: \\verbinclude Matrix_resize_int_NoChange.out\n\\sa resize(Index,Index)"
    },
    {
      "id": "resize-like",
      "name": "resizeLike",
      "category": "PlainObjectBase",
      "signature": "resizeLike(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Other",
          "type": "EigenBase<OtherDerived>&"
        }
      ],
      "returnType": "template<OtherDerived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes \\c *this to have the same dimensions as \\a other.\nTakes care of doing all the checking that's needed.\nNote that copying a row-vector into a vector (and conversely) is allowed.\nThe resizing, if any, is then done in the appropriate way so that row-vectors\nremain row-vectors and vectors remain vectors."
    },
    {
      "id": "conservative-resize-6eaec1",
      "name": "conservativeResize",
      "category": "PlainObjectBase",
      "signature": "conservativeResize(Target, Rows, Cols)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Rows",
          "type": "Index"
        },
        {
          "name": "Cols",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes the matrix to \\a rows x \\a cols while leaving old values untouched.\nThe method is intended for matrices of dynamic size. If you only want to change the number\nof rows and/or of columns, you can use conservativeResize(NoChange_t, Index) or\nconservativeResize(Index, NoChange_t).\nMatrices are resized relative to the top-left element. In case values need to be\nappended to the matrix they will be uninitialized."
    },
    {
      "id": "conservative-resize-f6fb60",
      "name": "conservativeResize",
      "category": "PlainObjectBase",
      "signature": "conservativeResize(Target, Rows)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Rows",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes the matrix to \\a rows x \\a cols while leaving old values untouched.\nAs opposed to conservativeResize(Index rows, Index cols), this version leaves\nthe number of columns unchanged.\nIn case the matrix is growing, new rows will be uninitialized."
    },
    {
      "id": "conservative-resize-62b262",
      "name": "conservativeResize",
      "category": "PlainObjectBase",
      "signature": "conservativeResize(Target, Cols)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Cols",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes the matrix to \\a rows x \\a cols while leaving old values untouched.\nAs opposed to conservativeResize(Index rows, Index cols), this version leaves\nthe number of rows unchanged.\nIn case the matrix is growing, new columns will be uninitialized."
    },
    {
      "id": "conservative-resize-0c0f49",
      "name": "conservativeResize",
      "category": "PlainObjectBase",
      "signature": "conservativeResize(Target, Size)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Size",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes the vector to \\a size while retaining old values.\n\\only_for_vectors. This method does not work for\npartially dynamic matrices when the static dimension is anything other\nthan 1. For example it will not work with Matrix<double, 2, Dynamic>.\nWhen values are appended, they will be uninitialized."
    },
    {
      "id": "conservative-resize-like",
      "name": "conservativeResizeLike",
      "category": "PlainObjectBase",
      "signature": "conservativeResizeLike(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "PlainObjectBase*"
        },
        {
          "name": "Other",
          "type": "DenseBase<OtherDerived>&"
        }
      ],
      "returnType": "template<OtherDerived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE void",
      "docs": "Resizes the matrix to \\a rows x \\a cols of \\c other, while leaving old values untouched.\nThe method is intended for matrices of dynamic size. If you only want to change the number\nof rows and/or of columns, you can use conservativeResize(NoChange_t, Index) or\nconservativeResize(Index, NoChange_t).\nMatrices are resized relative to the top-left element. In case values need to be\nappended to the matrix they will copied from \\c other."
    },
