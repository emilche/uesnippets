{
  "id": "trace-logging-minimal-win",
  "label": "trace_logging_minimal_win",
  "includepath": "trace_logging_minimal_win.h",
  "includes": [
    "stdint",
    "windows",
    "evntprov",
    "raw_ptr"
  ],
  "functions": [
    {
      "id": "write-event",
      "name": "WriteEvent",
      "category": "trace_logging_minimal_win",
      "signature": "WriteEvent(Target, Event Name, Event Descriptor, Event Fields)",
      "params": [
        {
          "name": "Target",
          "type": "TlmProvider*"
        },
        {
          "name": "Event Name",
          "type": "char*"
        },
        {
          "name": "Event Descriptor",
          "type": "EVENT_DESCRIPTOR&"
        },
        {
          "name": "Event Fields",
          "type": "FieldTys& . . ."
        }
      ],
      "returnType": "template<class . . . FieldTys> ULONG"
    },
    {
      "id": "tlm-event-descriptor",
      "name": "TlmEventDescriptor",
      "category": "trace_logging_minimal_win",
      "signature": "TlmEventDescriptor(Level, Keyword)",
      "params": [
        {
          "name": "Level",
          "type": "uint8_t"
        },
        {
          "name": "Keyword",
          "type": "uint64_t"
        }
      ],
      "returnType": "EVENT_DESCRIPTOR"
    }
  ]
}