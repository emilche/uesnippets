    {
      "id": "make-jacobi-c254d6",
      "name": "makeJacobi",
      "category": "Jacobi",
      "signature": "makeJacobi(X, Y, Z)",
      "params": [
        {
          "name": "X",
          "type": "RealScalar&"
        },
        {
          "name": "Y",
          "type": "Scalar&"
        },
        {
          "name": "Z",
          "type": "RealScalar&"
        }
      ],
      "returnType": "template<Scalar> EIGEN_DEVICE_FUNC bool JacobiRotation<Scalar",
      "docs": "Makes \\c *this as a Jacobi rotation \\a J such that applying \\a J on both the right and left sides of the selfadjoint 2x2 matrix\n\\f$ B = \\left ( \\begin{array}{cc} x & y \\\\ \\overline y & z \\end{array} \\right )\\f$ yields a diagonal matrix \\f$ A = J^* B J \\f$\n\\sa MatrixBase::makeJacobi(const MatrixBase<Derived>&, Index, Index), MatrixBase::applyOnTheLeft(), MatrixBase::applyOnTheRight()"
    },
    {
      "id": "make-jacobi-33047c",
      "name": "makeJacobi",
      "category": "Jacobi",
      "signature": "makeJacobi(M, P, Q)",
      "params": [
        {
          "name": "M",
          "type": "MatrixBase<Derived>&"
        },
        {
          "name": "P",
          "type": "Index"
        },
        {
          "name": "Q",
          "type": "Index"
        }
      ],
      "returnType": "template<Scalar> template<Derived> EIGEN_DEVICE_FUNC bool JacobiRotation<Scalar",
      "docs": "Makes \\c *this as a Jacobi rotation \\c J such that applying \\a J on both the right and left sides of the 2x2 selfadjoint matrix\n\\f$ B = \\left ( \\begin{array}{cc} \\text{this}_{pp} & \\text{this}_{pq} \\\\ (\\text{this}_{pq})^* & \\text{this}_{qq} \\end{array} \\right )\\f$ yields\na diagonal matrix \\f$ A = J^* B J \\f$\nExample: \\include Jacobi_makeJacobi.cpp\nOutput: \\verbinclude Jacobi_makeJacobi.out\n\\sa JacobiRotation::makeJacobi(RealScalar, Scalar, RealScalar), MatrixBase::applyOnTheLeft(), MatrixBase::applyOnTheRight()"
    },
    {
      "id": "make-givens-ec10e2",
      "name": "makeGivens",
      "category": "Jacobi",
      "signature": "makeGivens(P, Q, R)",
      "params": [
        {
          "name": "P",
          "type": "Scalar&"
        },
        {
          "name": "Q",
          "type": "Scalar&"
        },
        {
          "name": "R",
          "type": "Scalar*"
        }
      ],
      "returnType": "template<Scalar> EIGEN_DEVICE_FUNC void JacobiRotation<Scalar",
      "docs": "Makes \\c *this as a Givens rotation \\c G such that applying \\f$ G^* \\f$ to the left of the vector\n\\f$ V = \\left ( \\begin{array}{c} p \\\\ q \\end{array} \\right )\\f$ yields:\n\\f$ G^* V = \\left ( \\begin{array}{c} r \\\\ 0 \\end{array} \\right )\\f$.\nThe value of \\a r is returned if \\a r is not null (the default is null).\nAlso note that G is built such that the cosine is always real.\nExample: \\include Jacobi_makeGivens.cpp\nOutput: \\verbinclude Jacobi_makeGivens.out\nThis function implements the continuous Givens rotation generation algorithm\nfound in Anderson (2000), Discontinuous Plane Rotations and the Symmetric Eigenvalue Problem.\nLAPACK Working Note 150, University of Tennessee, UT-CS-00-454, December 4, 2000.\n\\sa MatrixBase::applyOnTheLeft(), MatrixBase::applyOnTheRight()"
    },
