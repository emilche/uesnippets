    {
      "id": "verse-heap-create",
      "name": "verse_heap_create",
      "category": "verse_heap_ue",
      "signature": "verse_heap_create(Min Align, Size, Alignment)",
      "params": [
        {
          "name": "Min Align",
          "type": "size_t"
        },
        {
          "name": "Size",
          "type": "size_t"
        },
        {
          "name": "Alignment",
          "type": "size_t"
        }
      ],
      "returnType": "pas_heap*",
      "docs": "Creates a heap with the requested minalign and optionally size and alignment.\nHeaps cannot be destroyed.\nIf the min_align argument is smaller than VERSE_HEAP_MIN_ALIGN then the behavior is as if it was\nVERSE_HEAP_MIN_ALIGN, but it must be at least 1.\nIf the size is 0, then:\n- Alignment is ignored.\n- This heap has no special virtual memory reservation; it just uses the global page cache.\nIf the size is not zero, then:\n- Size must be at least VERSE_HEAP_CHUNK_SIZE.\n- Alignment must be a power of 2 and at least 1.\n- Size must be aligned to alignment.\n- The heap uses a virtual memory reservation of that size and alignment."
    },
