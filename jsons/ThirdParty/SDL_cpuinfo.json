{
  "id": "sdl-cpuinfo",
  "label": "SDL_cpuinfo",
  "includepath": "SDL_cpuinfo.h",
  "includes": [
    "SDL_stdinc",
    "intrin",
    "arm_neon",
    "altivec",
    "armintr",
    "arm64intr",
    "arm64_neon",
    "mm3dnow",
    "lsxintrin",
    "lasxintrin",
    "immintrin",
    "mmintrin",
    "xmmintrin",
    "emmintrin",
    "pmmintrin",
    "begin_code",
    "close_code"
  ],
  "functions": [
    {
      "id": "attribute",
      "name": "__attribute__",
      "category": "SDL_cpuinfo",
      "signature": "__attribute__(P)",
      "params": [
        {
          "name": "P",
          "type": "( __always_inline__,__nodebug__ ) ) _m_prefetch ( void*"
        }
      ],
      "returnType": "__inline__ void",
      "docs": "As of Clang 11, '_m_prefetchw' is conflicting with the winnt.h's version,\nso we define the needed '_m_prefetch' here as a pseudo-header, until the issue is fixed."
    }
  ]
}