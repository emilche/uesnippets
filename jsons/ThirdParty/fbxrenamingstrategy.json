    {
      "id": "set-out-name-space-symbol",
      "name": "SetOutNameSpaceSymbol",
      "category": "fbxrenamingstrategy",
      "signature": "SetOutNameSpaceSymbol(Target, P Name Space Symbol)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Name Space Symbol",
          "type": "FbxString"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the wanted scene namespace symbol.\n\\param pNameSpaceSymbol     namespace symbol."
    },
    {
