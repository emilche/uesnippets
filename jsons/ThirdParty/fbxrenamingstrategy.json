      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Name Space Symbol",
          "type": "FbxString"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the current scene namespace symbol.\n\\param pNameSpaceSymbol     namespace symbol."
