      "name": "SetCaseSensibility",
      "category": "fbxrenamingstrategy",
      "signature": "SetCaseSensibility(Target, P Is Case Sensitive)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Is Case Sensitive",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets case sensitivity for name clashing.\n\\param pIsCaseSensitive     Set to \\c true to make the name clashing case sensitive."
    },
    {
      "id": "set-replace-non-alpha-num",
      "name": "SetReplaceNonAlphaNum",
      "category": "fbxrenamingstrategy",
      "signature": "SetReplaceNonAlphaNum(Target, P Replace Non Alpha Num)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Replace Non Alpha Num",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the flag for character acceptance during renaming.\n\\param pReplaceNonAlphaNum     Set to \\c true to replace illegal characters with an underscore (\"_\")."
    },
    {
      "id": "set-first-not-num",
      "name": "SetFirstNotNum",
      "category": "fbxrenamingstrategy",
      "signature": "SetFirstNotNum(Target, P First Not Num)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P First Not Num",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the flag for first character acceptance during renaming.\n\\param pFirstNotNum     Set to \\c true to add an underscore to the name if the first character is a number."
    },
    {
