{
  "id": "fbxdocument",
  "label": "fbxdocument",
  "includepath": "fbxdocument.h",
  "includes": [
    "fbxsdk_def",
    "fbxcollection",
    "fbxsdk_nsbegin",
    "fbxsdk_nsend"
  ],
  "functions": [
    {
      "id": "add-root-member",
      "name": "AddRootMember",
      "category": "fbxdocument",
      "signature": "AddRootMember(Target, P Member)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Member",
          "type": "FbxObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Add a member object and connect it to Roots.\n\\param pMember Object to add to the document."
    },
    {
      "id": "root-root-remove-member",
      "name": "RootRootRemoveMember",
      "category": "fbxdocument",
      "signature": "RootRootRemoveMember(Target, P Member)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Member",
          "type": "FbxObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a member object from the document.\n\\param pMember Object to remove from the document."
    },
    {
      "id": "find-root-member",
      "name": "FindRootMember",
      "category": "fbxdocument",
      "signature": "FindRootMember(Target, P Name)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Name",
          "type": "char*"
        }
      ],
      "returnType": "template<class T> T*",
      "docs": "Find a member object in the document, that has the given type and name.\n\\param pName Member name."
    },
    {
      "id": "get-root-member-count",
      "name": "GetRootMemberCount",
      "category": "fbxdocument",
      "signature": "GetRootMemberCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        }
      ],
      "returnType": "Int",
      "docs": "Return the number of objects of class T in the document.\n\\return The number of objects of class T in the document."
    },
    {
      "id": "get-root-member",
      "name": "GetRootMember",
      "category": "fbxdocument",
      "signature": "GetRootMember(Target, P Index)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        },
        {
          "name": "P Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "FbxObject*",
      "docs": "Return the member of the document at given index.\n\\param pIndex Selection index."
    },
    {
      "id": "is-a-root-document",
      "name": "IsARootDocument",
      "category": "fbxdocument",
      "signature": "IsARootDocument(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FBXSDK_DLL*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tells if this document is a root document.\n\\return \\c false if the current document is contained in another document, \\c true otherwise."
    }
  ]
}