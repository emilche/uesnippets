    {
      "id": "blocked-lu",
      "name": "blocked_lu",
      "category": "PartialPivLU",
      "signature": "blocked_lu(Rows, Cols, Lu Data, Lu Stride, Row Transpositions, Nb Transpositions, Max Block Size)",
      "params": [
        {
          "name": "Rows",
          "type": "Index"
        },
        {
          "name": "Cols",
          "type": "Index"
        },
        {
          "name": "Lu Data",
          "type": "Scalar*"
        },
        {
          "name": "Lu Stride",
          "type": "Index"
        },
        {
          "name": "Row Transpositions",
          "type": "PivIndex*"
        },
        {
          "name": "Nb Transpositions",
          "type": "PivIndex&"
        },
        {
          "name": "Max Block Size",
          "type": "Index",
          "default": "256"
        }
      ],
      "returnType": "Index",
      "docs": "\\internal performs the LU decomposition in-place of the matrix represented\nby the variables \\a rows, \\a cols, \\a lu_data, and \\a lu_stride using a\nrecursive, blocked algorithm.\nIn addition, this function returns the row transpositions in the\nvector \\a row_transpositions which must have a size equal to the number\nof columns of the matrix \\a lu, and an integer \\a nb_transpositions\nwhich returns the actual number of transpositions.\n\\returns The index of the first pivot which is exactly zero if any, or a negative number otherwise.\n\\note This very low level interface using pointers, etc. is to:\n1 - reduce the number of instantiations to the strict minimum\n2 - avoid infinite recursion of the instantiations with Block<Block<Block<...> > >"
    },
    {
      "id": "partial-lu-inplace",
