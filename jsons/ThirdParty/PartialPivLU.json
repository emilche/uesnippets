        },
        {
          "name": "Nb Transpositions",
          "type": "TranspositionType::StorageIndex&"
        }
      ],
      "returnType": "template<MatrixType,TranspositionType> void",
      "docs": "\\internal performs the LU decomposition with partial pivoting in-place."
    },
