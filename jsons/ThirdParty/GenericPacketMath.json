    {
      "id": "ploaddup",
      "name": "ploaddup",
      "category": "GenericPacketMath",
      "signature": "ploaddup(From)",
      "params": [
        {
          "name": "From",
          "type": "unpacket_traits<Packet>::type*"
        }
      ],
      "returnType": "template<Packet> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE Packet",
      "docs": "\\internal \\returns a packet with elements of \\a *from duplicated.\nFor instance, for a packet of 8 elements, 4 scalars will be read from \\a *from and\nduplicated to form: {from[0],from[0],from[1],from[1],from[2],from[2],from[3],from[3]}\nCurrently, this function is only used for scalar * complex products."
    },
    {
      "id": "ploadquad",
