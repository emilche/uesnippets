    {
      "id": "non-zeros",
      "name": "nonZeros",
      "category": "DenseBase",
      "signature": "nonZeros(Target)",
      "params": [
        {
          "name": "Target",
          "type": "DenseBase*"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_CONSTEXPR Index",
      "docs": "\\brief The plain matrix or array type corresponding to this expression.\nThis is not necessarily exactly the return type of eval(). In the case of plain matrices,\nthe return type of eval() is a const reference to a matrix, not a matrix! It is however guaranteed\nthat the return type of eval() is either PlainObject or const PlainObject&."
    },
    {
      "id": "outer-size",
      "name": "outerSize",
      "category": "DenseBase",
      "signature": "outerSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "DenseBase*"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_CONSTEXPR Index",
      "docs": "\\returns the outer size.\n\\note For a vector, this returns just 1. For a matrix (non-vector), this is the major dimension\nwith respect to the \\ref TopicStorageOrders \"storage order\", i.e., the number of columns for a\ncolumn-major matrix, and the number of rows for a row-major matrix."
    },
    {
      "id": "inner-size",
      "name": "innerSize",
      "category": "DenseBase",
      "signature": "innerSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "DenseBase*"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC EIGEN_CONSTEXPR Index",
      "docs": "\\returns the inner size.\n\\note For a vector, this is just the size. For a matrix (non-vector), this is the minor dimension\nwith respect to the \\ref TopicStorageOrders \"storage order\", i.e., the number of rows for a\ncolumn-major matrix, and the number of columns for a row-major matrix."
    },
    {
      "id": "resize-828bff",
      "name": "resize",
      "category": "DenseBase",
      "signature": "resize(Target, New Size)",
      "params": [
        {
          "name": "Target",
          "type": "DenseBase*"
        },
        {
          "name": "New Size",
          "type": "Index"
        }
      ],
      "returnType": "EIGEN_DEVICE_FUNC void",
      "docs": "Only plain matrices/arrays, not expressions, may be resized; therefore the only useful resize methods are\nMatrix::resize() and Array::resize(). The present method only asserts that the new size equals the old size, and does\nnothing else."
    },
