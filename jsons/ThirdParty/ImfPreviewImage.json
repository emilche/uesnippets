{
  "id": "imf-preview-image",
  "label": "ImfPreviewImage",
  "includepath": "ImfPreviewImage.h",
  "includes": [
    "ImfForward"
  ],
  "functions": [
    {
      "id": "preview-rgba",
      "name": "PreviewRgba",
      "category": "ImfPreviewImage",
      "signature": "PreviewRgba(Target, R, G, B, A, G, B, A)",
      "params": [
        {
          "name": "Target",
          "type": "IMF_EXPORT_TYPE*"
        },
        {
          "name": "R",
          "type": "unsigned char",
          "default": "0"
        },
        {
          "name": "G",
          "type": "unsigned char",
          "default": "0"
        },
        {
          "name": "B",
          "type": "unsigned char",
          "default": "0"
        },
        {
          "name": "A",
          "type": "unsigned char",
          "default": "255)\n        : r (r)"
        },
        {
          "name": "G",
          "type": "g ("
        },
        {
          "name": "B",
          "type": "b ("
        },
        {
          "name": "A",
          "type": "a ("
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "width",
      "name": "width",
      "category": "ImfPreviewImage",
      "signature": "width(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMF_EXPORT_TYPE*"
        }
      ],
      "returnType": "unsigned int"
    },
    {
      "id": "height",
      "name": "height",
      "category": "ImfPreviewImage",
      "signature": "height(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMF_EXPORT_TYPE*"
        }
      ],
      "returnType": "unsigned int"
    },
    {
      "id": "pixels",
      "name": "pixels",
      "category": "ImfPreviewImage",
      "signature": "pixels(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMF_EXPORT_TYPE*"
        }
      ],
      "returnType": "PreviewRgba*"
    },
    {
      "id": "pixel",
      "name": "pixel",
      "category": "ImfPreviewImage",
      "signature": "pixel(Target, X, Y)",
      "params": [
        {
          "name": "Target",
          "type": "IMF_EXPORT_TYPE*"
        },
        {
          "name": "X",
          "type": "unsigned int"
        },
        {
          "name": "Y",
          "type": "unsigned int"
        }
      ],
      "returnType": "PreviewRgba&"
    }
  ]
