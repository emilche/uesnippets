      "id": "map-fe3788",
      "name": "Map",
      "category": "SparseMap",
      "signature": "Map(Rows, Cols, Nnz, Outer Index Ptr, Inner Index Ptr, Value Ptr, Inner Non Zeros Ptr)",
      "params": [
        {
          "name": "Rows",
          "type": "Index"
        },
        {
          "name": "Cols",
          "type": "Index"
        },
        {
          "name": "Nnz",
          "type": "Index"
        },
        {
          "name": "Outer Index Ptr",
          "type": "StorageIndex*"
        },
        {
          "name": "Inner Index Ptr",
          "type": "StorageIndex*"
        },
        {
          "name": "Value Ptr",
          "type": "Scalar*"
        },
        {
          "name": "Inner Non Zeros Ptr",
          "type": "StorageIndex*",
          "default": "0)\n      : Base(rows, cols, nnz, outerIndexPtr, innerIndexPtr, valuePtr, innerNonZerosPtr"
        }
      ],
      "returnType": "Void",
      "docs": "Constructs a read-write Map to a sparse matrix of size \\a rows x \\a cols, containing \\a nnz non-zero coefficients,\nstored as a sparse format as defined by the pointers \\a outerIndexPtr, \\a innerIndexPtr, and \\a valuePtr.\nIf the optional parameter \\a innerNonZerosPtr is the null pointer, then a standard compressed format is assumed.\nThis constructor is available only if \\c SparseMatrixType is non-const.\nMore details on the expected storage schemes are given in the \\ref TutorialSparse \"manual pages\"."
    },
