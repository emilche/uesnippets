    {
      "id": "matrix-sqrt-quasi-triangular",
      "name": "matrix_sqrt_quasi_triangular",
      "category": "MatrixSquareRoot",
      "signature": "matrix_sqrt_quasi_triangular(Arg, Result)",
      "params": [
        {
          "name": "Arg",
          "type": "MatrixType&"
        },
        {
          "name": "Result",
          "type": "ResultType&"
        }
      ],
      "returnType": "template<MatrixType,ResultType> void",
      "docs": "\\ingroup MatrixFunctions_Module\n\\brief Compute matrix square root of quasi-triangular matrix.\n\\tparam  MatrixType  type of \\p arg, the argument of matrix square root,\nexpected to be an instantiation of the Matrix class template.\n\\tparam  ResultType  type of \\p result, where result is to be stored.\n\\param[in]  arg      argument of matrix square root.\n\\param[out] result   matrix square root of upper Hessenberg part of \\p arg.\nThis function computes the square root of the upper quasi-triangular matrix stored in the upper\nHessenberg part of \\p arg.  Only the upper Hessenberg part of \\p result is updated, the rest is\nnot touched.  See MatrixBase::sqrt() for details on how this computation is implemented.\n\\sa MatrixSquareRoot, MatrixSquareRootQuasiTriangular"
    },
    {
      "id": "matrix-sqrt-triangular",
      "name": "matrix_sqrt_triangular",
      "category": "MatrixSquareRoot",
      "signature": "matrix_sqrt_triangular(Arg, Result)",
      "params": [
        {
          "name": "Arg",
          "type": "MatrixType&"
        },
        {
          "name": "Result",
          "type": "ResultType&"
        }
      ],
      "returnType": "template<MatrixType,ResultType> void",
      "docs": "\\ingroup MatrixFunctions_Module\n\\brief Compute matrix square root of triangular matrix.\n\\tparam  MatrixType  type of \\p arg, the argument of matrix square root,\nexpected to be an instantiation of the Matrix class template.\n\\tparam  ResultType  type of \\p result, where result is to be stored.\n\\param[in]  arg      argument of matrix square root.\n\\param[out] result   matrix square root of upper triangular part of \\p arg.\nOnly the upper triangular part (including the diagonal) of \\p result is updated, the rest is not\ntouched.  See MatrixBase::sqrt() for details on how this computation is implemented.\n\\sa MatrixSquareRoot, MatrixSquareRootQuasiTriangular"
    },
    {
      "id": "run",
      "name": "run",
      "category": "MatrixSquareRoot",
