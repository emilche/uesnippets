          "type": "TINYXML2_LIB*"
        }
      ],
      "returnType": "XMLDocument*"
    },
    {
      "id": "to-declaration",
      "name": "ToDeclaration",
      "category": "tinyxml2",
      "signature": "ToDeclaration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TINYXML2_LIB*"
        }
      ],
      "returnType": "XMLDeclaration*",
      "docs": "In correct XML the declaration is the first entry in the file.\n@verbatim\n<?xml version=\"1.0\" standalone=\"yes\"?>\n@endverbatim\nTinyXML-2 will happily read or write files without a declaration,\nhowever.\nThe text of the declaration isn't interpreted. It is parsed\nand written as a string."
    },
    {
      "id": "to-unknown",
      "name": "ToUnknown",
      "category": "tinyxml2",
      "signature": "ToUnknown(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TINYXML2_LIB*"
        }
      ],
      "returnType": "XMLUnknown*",
      "docs": "Any tag that TinyXML-2 doesn't recognize is saved as an\nunknown. It is a tag of text, but should not be modified.\nIt will be written back to the XML, unchanged, when the file\nis saved.\nDTD tags get thrown into XMLUnknowns."
    },
