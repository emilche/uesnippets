    {
      "id": "solve",
      "name": "solve",
      "category": "TriangularMatrix",
      "signature": "solve(Other)",
      "params": [
        {
          "name": "Other",
          "type": "MatrixBase<Other>&"
        }
      ],
      "returnType": "template<Other> EIGEN_DEVICE_FUNC Solve<TriangularView,Other>",
      "docs": "\\returns the product of the inverse of \\c *this with \\a other, \\a *this being triangular.\nThis function computes the inverse-matrix matrix product inverse(\\c *this) * \\a other if\n\\a Side==OnTheLeft (the default), or the right-inverse-multiply  \\a other * inverse(\\c *this) if\n\\a Side==OnTheRight.\nNote that the template parameter \\c Side can be omitted, in which case \\c Side==OnTheLeft\nThe matrix \\c *this must be triangular and invertible (i.e., all the coefficients of the\ndiagonal must be non zero). It works as a forward (resp. backward) substitution if \\c *this\nis an upper (resp. lower) triangular matrix.\nExample: \\include Triangular_solve.cpp\nOutput: \\verbinclude Triangular_solve.out\nThis function returns an expression of the inverse-multiply and can works in-place if it is assigned\nto the same matrix or vector \\a other.\nFor users coming from BLAS, this function (and more specifically solveInPlace()) offer\nall the operations supported by the \\c *TRSV and \\c *TRSM BLAS routines.\n\\sa TriangularView::solveInPlace()"
    },
    {
      "id": "selfadjoint-view",
      "name": "selfadjointView",
      "category": "TriangularMatrix",
      "signature": "selfadjointView()",
      "params": [],
      "returnType": "EIGEN_DEVICE_FUNC SelfAdjointView<MatrixTypeNestedNonRef,Mode>",
      "docs": "\\returns a selfadjoint view of the referenced triangular part which must be either \\c #Upper or \\c #Lower.\nThis is a shortcut for \\code this->nestedExpression().selfadjointView<(*this)::Mode>() \\endcode\n\\sa MatrixBase::selfadjointView()"
    },
