      "id": "triangular-dense-assignment-kernel",
      "name": "triangular_dense_assignment_kernel",
      "category": "TriangularMatrix",
      "signature": "triangular_dense_assignment_kernel(Dst, Src, Func, Dst Expr)",
      "params": [
