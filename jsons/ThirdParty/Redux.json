    {
      "id": "min-coeff",
      "name": "minCoeff",
      "category": "Redux",
      "signature": "minCoeff()",
      "params": [],
      "returnType": "template<Derived> template<int NaNPropagation> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar DenseBase<Derived",
      "docs": "\\returns the minimum of all coefficients of \\c *this.\nIn case \\c *this contains NaN, NaNPropagation determines the behavior:\nNaNPropagation == PropagateFast : undefined\nNaNPropagation == PropagateNaN : result is NaN\nNaNPropagation == PropagateNumbers : result is minimum of elements that are not NaN\n\\warning the matrix must be not empty, otherwise an assertion is triggered."
    },
    {
      "id": "max-coeff",
      "name": "maxCoeff",
      "category": "Redux",
      "signature": "maxCoeff()",
      "params": [],
      "returnType": "template<Derived> template<int NaNPropagation> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar DenseBase<Derived",
      "docs": "\\returns the maximum of all coefficients of \\c *this.\nIn case \\c *this contains NaN, NaNPropagation determines the behavior:\nNaNPropagation == PropagateFast : undefined\nNaNPropagation == PropagateNaN : result is NaN\nNaNPropagation == PropagateNumbers : result is maximum of elements that are not NaN\n\\warning the matrix must be not empty, otherwise an assertion is triggered."
    },
    {
      "id": "sum",
      "name": "sum",
      "category": "Redux",
      "signature": "sum()",
      "params": [],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar DenseBase<Derived",
      "docs": "\\returns the sum of all coefficients of \\c *this\nIf \\c *this is empty, then the value 0 is returned.\n\\sa trace(), prod(), mean()"
    },
    {
      "id": "mean",
      "name": "mean",
      "category": "Redux",
      "signature": "mean()",
      "params": [],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar DenseBase<Derived",
      "docs": "\\returns the mean of all coefficients of *this\n\\sa trace(), prod(), sum()"
    },
    {
      "id": "prod",
      "name": "prod",
      "category": "Redux",
      "signature": "prod()",
      "params": [],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar DenseBase<Derived",
      "docs": "\\returns the product of all coefficients of *this\nExample: \\include MatrixBase_prod.cpp\nOutput: \\verbinclude MatrixBase_prod.out\n\\sa sum(), mean(), trace()"
    },
    {
      "id": "trace",
      "name": "trace",
      "category": "Redux",
      "signature": "trace()",
      "params": [],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC EIGEN_STRONG_INLINE internal::traits<Derived>::Scalar MatrixBase<Derived",
      "docs": "\\returns the trace of \\c *this, i.e. the sum of the coefficients on the main diagonal.\n\\c *this can be any matrix, not necessarily square.\n\\sa diagonal(), sum()"
