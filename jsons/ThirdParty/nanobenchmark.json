{
  "id": "nanobenchmark",
  "label": "nanobenchmark",
  "includepath": "nanobenchmark.h",
  "includes": [
    "stddef",
    "stdint",
    "config"
  ],
  "functions": [
    {
      "id": "call-closure",
      "name": "CallClosure",
      "category": "nanobenchmark",
      "signature": "CallClosure(F, Input)",
      "params": [
        {
          "name": "F",
          "type": "void*"
        },
        {
          "name": "Input",
          "type": "FuncInput"
        }
      ],
      "returnType": "template<class Closure> FuncOutput"
    },
    {
      "id": "measure-closure",
      "name": "MeasureClosure",
      "category": "nanobenchmark",
      "signature": "MeasureClosure(Closure, Inputs, Num Inputs, Results, P)",
      "params": [
        {
          "name": "Closure",
          "type": "Closure&"
        },
        {
          "name": "Inputs",
          "type": "FuncInput*"
        },
        {
          "name": "Num Inputs",
          "type": "size_t"
        },
        {
          "name": "Results",
          "type": "Result*"
        },
        {
          "name": "P",
          "type": "Params&",
          "default": "Params()"
        }
      ],
      "returnType": "template<class Closure> size_t"
    }
  ]
}