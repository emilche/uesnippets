        {
          "name": "K Is Explicit Flag",
          "type": "thread_policy_ ( static_cast<uint8_t> ( trait_helpers::GetEnum<ThreadPolicy,ThreadPolicy::PREFER_BACKGROUND> ( args . . . ) ) | ( trait_helpers::HasTrait<ThreadPolicy,ArgTypes . . .> ( ) ?"
        },
        {
          "name": "Arg Types",
          "type": "may_block_ ( trait_helpers::HasTrait<MayBlock,"
        },
        {
          "name": "Arg Types",
          "type": "with_base_sync_primitives_ ( trait_helpers::HasTrait<WithBaseSyncPrimitives,"
        }
      ],
      "returnType": "template<class . . . ArgTypes,class CheckArgumentsAreValid = std::enable_if_t<trait_helpers::AreValidTraits<ValidTrait,ArgTypes . . .>::value | | trait_helpers::AreValidTraitsForExtension<ArgTypes . . .>::value>>"
