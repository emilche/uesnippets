        {
          "name": "Args",
          "type": "priority_ ( trait_helpers::GetEnum<TaskPriority,TaskPriority::USER_BLOCKING> ("
        },
        {
          "name": "K Is Explicit Flag",
          "type": "shutdown_behavior_ ( static_cast<uint8_t> ( trait_helpers::GetEnum<TaskShutdownBehavior,TaskShutdownBehavior::SKIP_ON_SHUTDOWN> ( args . . . ) ) | ( trait_helpers::HasTrait<TaskShutdownBehavior,ArgTypes . . .> ( ) ?"
