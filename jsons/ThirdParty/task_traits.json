      "params": [
        {
          "name": "Target",
          "type": "BASE_EXPORT*"
        },
        {
          "name": "Args",
          "type": "ArgTypes . . . args ) : extension_ ( trait_helpers::GetTaskTraitsExtension ( trait_helpers::AreValidTraits<ValidTrait,ArgTypes . . .> { },"
