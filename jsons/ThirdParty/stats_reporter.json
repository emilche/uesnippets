      "params": [
        {
          "name": "Target",
          "type": "StatsReporter*"
        },
        {
          "name": "Id",
          "type": "internal::StatsCollector::MutatorId"
        },
        {
          "name": "Tid",
          "type": "internal::base::PlatformThreadId"
        },
        {
          "name": "Start Time Ticks Internal Value",
          "type": "int64_t"
        },
        {
          "name": "End Time Ticks Internal Value",
          "type": "int64_t"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "report-survived-quarantine-size",
      "name": "ReportSurvivedQuarantineSize",
      "category": "stats_reporter",
      "signature": "ReportSurvivedQuarantineSize(Target, Survived Size)",
      "params": [
        {
          "name": "Target",
          "type": "StatsReporter*"
        },
        {
          "name": "Survived Size",
          "type": "size_t"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "report-survived-quarantine-percent",
      "name": "ReportSurvivedQuarantinePercent",
      "category": "stats_reporter",
      "signature": "ReportSurvivedQuarantinePercent(Target, Survivied Rate)",
      "params": [
        {
          "name": "Target",
          "type": "StatsReporter*"
        },
        {
          "name": "Survivied Rate",
          "type": "Double"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "report-stats",
      "name": "ReportStats",
      "category": "stats_reporter",
      "signature": "ReportStats(Target, Stats Name, Sample In Usec)",
      "params": [
        {
          "name": "Target",
          "type": "StatsReporter*"
        },
        {
          "name": "Stats Name",
          "type": "char*"
        },
        {
          "name": "Sample In Usec",
          "type": "int64_t"
        }
      ],
      "returnType": "Void"
    }
  ]
}