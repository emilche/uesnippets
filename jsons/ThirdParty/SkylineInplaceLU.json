    {
      "id": "set-precision",
      "name": "setPrecision",
      "category": "SkylineInplaceLU",
      "signature": "setPrecision(Target, V)",
      "params": [
        {
          "name": "Target",
          "type": "SkylineInplaceLU*"
        },
        {
          "name": "V",
          "type": "RealScalar"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the relative threshold value used to prune zero coefficients during the decomposition.\nSetting a value greater than zero speeds up computation, and yields to an incomplete\nfactorization with fewer non zero coefficients. Such approximate factors are especially\nuseful to initialize an iterative solver.\nNote that the exact meaning of this parameter might depends on the actual\nbackend. Moreover, not all backends support this feature.\n\\sa precision()"
    },
    {
      "id": "precision",
      "name": "precision",
      "category": "SkylineInplaceLU",
      "signature": "precision(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SkylineInplaceLU*"
        }
      ],
      "returnType": "RealScalar",
      "docs": "\\returns the current precision.\n\\sa setPrecision()"
    },
