    {
      "id": "inverse",
      "name": "inverse",
      "category": "InverseImpl",
      "signature": "inverse()",
      "params": [],
      "returnType": "template<Derived> EIGEN_DEVICE_FUNC Inverse<Derived> MatrixBase<Derived",
      "docs": "\\lu_module\n\\returns the matrix inverse of this matrix.\nFor small fixed sizes up to 4x4, this method uses cofactors.\nIn the general case, this method uses class PartialPivLU.\n\\note This matrix must be invertible, otherwise the result is undefined. If you need an\ninvertibility check, do the following:\n\\li for fixed sizes up to 4x4, use computeInverseAndDetWithCheck().\n\\li for the general case, use class FullPivLU.\nExample: \\include MatrixBase_inverse.cpp\nOutput: \\verbinclude MatrixBase_inverse.out\n\\sa computeInverseAndDetWithCheck()"
    },
    {
      "id": "compute-inverse-and-det-with-check",
      "name": "computeInverseAndDetWithCheck",
      "category": "InverseImpl",
      "signature": "computeInverseAndDetWithCheck(Inverse, Determinant, Invertible, Abs Determinant Threshold)",
      "params": [
        {
          "name": "Inverse",
          "type": "ResultType&"
        },
        {
          "name": "Determinant",
          "type": "ResultType::Scalar&"
        },
        {
          "name": "Invertible",
          "type": "Bool&"
        },
        {
          "name": "Abs Determinant Threshold",
          "type": "RealScalar&"
        }
      ],
      "returnType": "template<Derived> template<ResultType> void MatrixBase<Derived",
      "docs": "\\lu_module\nComputation of matrix inverse and determinant, with invertibility check.\nThis is only for fixed-size square matrices of size up to 4x4.\nNotice that it will trigger a copy of input matrix when trying to do the inverse in place.\n\\param inverse Reference to the matrix in which to store the inverse.\n\\param determinant Reference to the variable in which to store the determinant.\n\\param invertible Reference to the bool variable in which to store whether the matrix is invertible.\n\\param absDeterminantThreshold Optional parameter controlling the invertibility check.\nThe matrix will be declared invertible if the absolute value of its\ndeterminant is greater than this threshold.\nExample: \\include MatrixBase_computeInverseAndDetWithCheck.cpp\nOutput: \\verbinclude MatrixBase_computeInverseAndDetWithCheck.out\n\\sa inverse(), computeInverseWithCheck()"
    },
    {
      "id": "compute-inverse-with-check",
      "name": "computeInverseWithCheck",
      "category": "InverseImpl",
      "signature": "computeInverseWithCheck(Inverse, Invertible, Abs Determinant Threshold)",
      "params": [
        {
          "name": "Inverse",
          "type": "ResultType&"
        },
        {
          "name": "Invertible",
          "type": "Bool&"
        },
        {
          "name": "Abs Determinant Threshold",
          "type": "RealScalar&"
        }
      ],
      "returnType": "template<Derived> template<ResultType> void MatrixBase<Derived",
      "docs": "\\lu_module\nComputation of matrix inverse, with invertibility check.\nThis is only for fixed-size square matrices of size up to 4x4.\nNotice that it will trigger a copy of input matrix when trying to do the inverse in place.\n\\param inverse Reference to the matrix in which to store the inverse.\n\\param invertible Reference to the bool variable in which to store whether the matrix is invertible.\n\\param absDeterminantThreshold Optional parameter controlling the invertibility check.\nThe matrix will be declared invertible if the absolute value of its\ndeterminant is greater than this threshold.\nExample: \\include MatrixBase_computeInverseWithCheck.cpp\nOutput: \\verbinclude MatrixBase_computeInverseWithCheck.out\n\\sa inverse(), computeInverseAndDetWithCheck()"
    }
