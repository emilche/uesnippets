          "type": "Abc::Argument&",
          "default": "Abc::Argument()"
        },
        {
          "name": "I Arg 3",
          "type": "Abc::Argument&",
          "default": "Abc::Argument() )\n      : OGeomBaseSchema<CurvesSchemaInfo>( iParent, iName,\n                                           iArg0, iArg1, iArg2, iArg3"
