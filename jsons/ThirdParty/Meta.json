    {
      "id": "sup-x",
      "name": "SupX",
      "category": "Meta",
      "signature": "SupX(Y, Done)",
      "params": [
        {
          "name": "Y",
          "type": "( Y = = 1 ) ? 1 :"
        },
        {
          "name": "Done",
          "type": "Bool",
          "default": "((SupX-InfX)<=1 ? true : ((SupX*SupX <= Y) && ((SupX+1)*(SupX+1) > Y))"
        }
      ],
      "returnType": "template<int Y,int InfX = 0,int",
      "docs": "\\internal In short, it computes int(sqrt(\\a Y)) with \\a Y an integer.\nUsage example: \\code meta_sqrt<1023>::ret \\endcode"
    },
    {
      "id": "done",
      "name": "Done",
      "category": "Meta",
      "signature": "Done(B, Big)",
      "params": [
        {
          "name": "B",
          "type": "( A* K ) %",
          "default": "=0"
        },
        {
          "name": "Big",
          "type": "Bool",
          "default": "(A>=B"
        }
      ],
      "returnType": "template<int A,int B,int K = 1,bool",
      "docs": "\\internal Computes the least common multiple of two positive integer A and B\nat compile-time."
