    {
      "id": "solve-in-place",
      "name": "solveInPlace",
      "category": "LLT",
      "signature": "solveInPlace(Target, B And X)",
      "params": [
        {
          "name": "Target",
          "type": "LLT*"
        },
        {
          "name": "B And X",
          "type": "MatrixBase<Derived>&"
        }
      ],
      "returnType": "template<MatrixType,int _UpLo> template<Derived> void LLT<MatrixType,_UpLo",
      "docs": "\\internal use x = llt_object.solve(x);\nThis is the \\em in-place version of solve().\n\\param bAndX represents both the right-hand side matrix b and result x.\nThis version avoids a copy when the right hand side matrix b is not needed anymore.\n\\warning The parameter is only marked 'const' to make the C++ compiler accept a temporary expression here.\nThis function will const_cast it, so constness isn't honored here.\n\\sa LLT::solve(), MatrixBase::llt()"
    },
