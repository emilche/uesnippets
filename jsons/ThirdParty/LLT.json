    {
      "id": "compute",
      "name": "compute",
      "category": "LLT",
      "signature": "compute(Target, A)",
      "params": [
        {
          "name": "Target",
          "type": "LLT*"
        },
        {
          "name": "A",
          "type": "EigenBase<InputType>&"
        }
      ],
      "returnType": "template<MatrixType,int _UpLo> template<InputType> LLT<MatrixType,_UpLo>& LLT<MatrixType,_UpLo",
      "docs": "Computes / recomputes the Cholesky decomposition A = LL^* = U^*U of \\a matrix\n\\returns a reference to *this\nExample: \\include TutorialLinAlgComputeTwice.cpp\nOutput: \\verbinclude TutorialLinAlgComputeTwice.out"
    },
    {
      "id": "rank-update-fedda8",
      "name": "rankUpdate",
      "category": "LLT",
      "signature": "rankUpdate(Target, V, Sigma)",
      "params": [
        {
          "name": "Target",
          "type": "LLT*"
        },
        {
          "name": "V",
          "type": "VectorType&"
        },
        {
          "name": "Sigma",
          "type": "RealScalar&"
        }
      ],
      "returnType": "template<_MatrixType,int _UpLo> template<VectorType> LLT<_MatrixType,_UpLo>& LLT<_MatrixType,_UpLo",
      "docs": "Performs a rank one update (or dowdate) of the current decomposition.\nIf A = LL^* before the rank one update,\nthen after it we have LL^* = A + sigma * v v^* where \\a v must be a vector\nof same dimension."
    },
