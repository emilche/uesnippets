    {
      "id": "adopt-instead-and-check-error-code",
      "name": "adoptInsteadAndCheckErrorCode",
      "category": "localpointer",
      "signature": "adoptInsteadAndCheckErrorCode(Target, P, Error Code)",
      "params": [
        {
          "name": "Target",
          "type": "LocalPointer*"
        },
        {
          "name": "P",
          "type": "T*"
        },
        {
          "name": "Error Code",
          "type": "UErrorCode&"
        }
      ],
      "returnType": "Void",
      "docs": "Deletes the object it owns,\nand adopts (takes ownership of) the one passed in.\nIf U_FAILURE(errorCode), then the current object is retained and the new one deleted.\nIf U_SUCCESS(errorCode) but the input pointer is NULL,\nthen U_MEMORY_ALLOCATION_ERROR is set,\nthe current object is deleted, and NULL is set.\n@param p simple pointer to an object that is adopted\n@param errorCode in/out UErrorCode, set to U_MEMORY_ALLOCATION_ERROR\nif p==NULL and no other failure code had been set\n@stable ICU 55",
      "supportedTargets": [
        "LocalPointer*",
        "LocalArray*"
      ]
