        },
        {
          "name": "N",
          "type": "int n ) SIMDE_REQUIRE_CONSTANT_RANGE ("
        }
      ],
      "returnType": "SIMDE_FUNCTION_ATTRIBUTES simde_int32x4_t"
    },
