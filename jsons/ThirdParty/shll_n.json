  "functions": [
    {
      "id": "simde-vshll-n-s-8",
      "name": "simde_vshll_n_s8",
      "category": "shll_n",
      "signature": "simde_vshll_n_s8(A, N)",
      "params": [
        {
          "name": "A",
          "type": "simde_int8x8_t"
        },
        {
          "name": "N",
          "type": "int n ) SIMDE_REQUIRE_CONSTANT_RANGE ("
        }
      ],
      "returnType": "HEDLEY_DIAGNOSTIC_PUSH SIMDE_DISABLE_UNWANTED_DIAGNOSTICS SIMDE_BEGIN_DECLS_ SIMDE_FUNCTION_ATTRIBUTES simde_int16x8_t",
      "docs": "The constant range requirements for the shift amount *n* looks strange.\nThe ARM Neon Intrinsics Reference states that for *_s8, 0 << n << 7. This\ndoes not match the actual instruction decoding in the ARM Reference manual,\nwhich states that the shift amount \"must be equal to the source element width\nin bits\" (ARM DDI 0487F.b C7-1959). So for *_s8 instructions, *n* must be 8,\nfor *_s16, it must be 16, and *_s32 must be 32 (similarly for unsigned)."
    },
    {
      "id": "simde-vshll-n-s-16",
      "name": "simde_vshll_n_s16",
      "category": "shll_n",
      "signature": "simde_vshll_n_s16(A, N)",
      "params": [
