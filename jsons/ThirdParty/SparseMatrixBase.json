      "params": [
        {
          "name": "Target",
          "type": "SparseMatrixBase*"
        }
      ],
      "returnType": "Index",
      "docs": "\\returns the number of coefficients, which is \\a rows()*cols().\n\\sa rows(), cols()."
    },
    {
      "id": "is-vector",
      "name": "isVector",
      "category": "SparseMatrixBase",
      "signature": "isVector(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseMatrixBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "\\returns true if either the number of rows or the number of columns is equal to 1.\nIn other words, this function returns\n\\code rows()==1 || cols()==1 \\endcode\n\\sa rows(), cols(), IsVectorAtCompileTime."
    },
    {
      "id": "outer-size",
      "name": "outerSize",
      "category": "SparseMatrixBase",
      "signature": "outerSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseMatrixBase*"
        }
      ],
      "returnType": "Index",
      "docs": "\\returns the size of the storage major dimension,\ni.e., the number of columns for a columns major matrix, and the number of rows otherwise"
    },
    {
      "id": "inner-size",
      "name": "innerSize",
      "category": "SparseMatrixBase",
      "signature": "innerSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SparseMatrixBase*"
        }
      ],
      "returnType": "Index",
      "docs": "\\returns the size of the inner dimension according to the storage order,\ni.e., the number of rows for a columns major matrix, and the number of cols otherwise"
    },
