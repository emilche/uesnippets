{
  "id": "sdl-stdinc",
  "label": "SDL_stdinc",
  "includepath": "SDL_stdinc.h",
  "includes": [
    "SDL_config",
    "types",
    "stdio",
    "stdlib",
    "stddef",
    "stdarg",
    "malloc",
    "memory",
    "string",
    "strings",
    "wchar",
    "inttypes",
    "stdint",
    "ctype",
    "math",
    "float",
    "alloca",
    "sal",
    "begin_code",
    "close_code"
  ],
  "functions": [
    {
      "id": "sdl-memset-4",
      "name": "SDL_memset4",
      "category": "SDL_stdinc",
      "signature": "SDL_memset4(Dst, Val, Dwords)",
      "params": [
        {
          "name": "Dst",
          "type": "void*"
        },
        {
          "name": "Val",
          "type": "UInt"
        },
        {
          "name": "Dwords",
          "type": "size_t"
        }
      ],
      "returnType": "SDL_FORCE_INLINE void",
      "docs": "Note that memset() is a byte assignment and this is a 32-bit assignment, so they're not directly equivalent."
    },
    {
      "id": "sdl-memcpy-4",
      "name": "SDL_memcpy4",
      "category": "SDL_stdinc",
      "signature": "SDL_memcpy4(Dst, Src, Dwords)",
      "params": [
        {
          "name": "Dst",
          "type": "SDL_OUT_BYTECAP ( dwords* 4 ) void*"
        },
        {
          "name": "Src",
          "type": "SDL_IN_BYTECAP ( dwords* 4 ) void*"
        },
        {
          "name": "Dwords",
          "type": "size_t"
        }
      ],
      "returnType": "SDL_FORCE_INLINE void*",
      "docs": "Starting LLVM 16, the analyser errors out if these functions do not have\ntheir prototype defined (clang-diagnostic-implicit-function-declaration)"
    },
    {
      "id": "sdl-size-mul-overflow",
      "name": "SDL_size_mul_overflow",
      "category": "SDL_stdinc",
      "signature": "SDL_size_mul_overflow(A, B, Ret)",
      "params": [
        {
          "name": "A",
          "type": "size_t"
        },
        {
          "name": "B",
          "type": "size_t"
        },
        {
          "name": "Ret",
          "type": "size_t*"
        }
      ],
      "returnType": "SDL_FORCE_INLINE int",
      "docs": "If a * b would overflow, return -1. Otherwise store a * b via ret\nand return 0.\n\\since This function is available since SDL 2.24.0."
    },
    {
      "id": "sdl-size-mul-overflow-builtin",
      "name": "_SDL_size_mul_overflow_builtin",
      "category": "SDL_stdinc",
      "signature": "_SDL_size_mul_overflow_builtin(A, B, Ret)",
      "params": [
        {
          "name": "A",
          "type": "size_t"
        },
        {
          "name": "B",
          "type": "size_t"
        },
        {
          "name": "Ret",
          "type": "size_t*"
        }
      ],
      "returnType": "SDL_FORCE_INLINE int",
      "docs": "This needs to be wrapped in an inline rather than being a direct #define,\nbecause __builtin_mul_overflow() is type-generic, but we want to be\nconsistent about interpreting a and b as size_t."
    },
    {
      "id": "sdl-size-add-overflow",
      "name": "SDL_size_add_overflow",
      "category": "SDL_stdinc",
      "signature": "SDL_size_add_overflow(A, B, Ret)",
      "params": [
        {
          "name": "A",
          "type": "size_t"
        },
        {
          "name": "B",
          "type": "size_t"
        },
        {
          "name": "Ret",
          "type": "size_t*"
        }
      ],
      "returnType": "SDL_FORCE_INLINE int",
      "docs": "If a + b would overflow, return -1. Otherwise store a + b via ret\nand return 0.\n\\since This function is available since SDL 2.24.0."
    },
    {
      "id": "sdl-size-add-overflow-builtin",
      "name": "_SDL_size_add_overflow_builtin",
      "category": "SDL_stdinc",
      "signature": "_SDL_size_add_overflow_builtin(A, B, Ret)",
      "params": [
        {
          "name": "A",
          "type": "size_t"
        },
        {
          "name": "B",
          "type": "size_t"
        },
        {
          "name": "Ret",
          "type": "size_t*"
        }
      ],
      "returnType": "SDL_FORCE_INLINE int",
      "docs": "This needs to be wrapped in an inline rather than being a direct #define,\nthe same as the call to __builtin_mul_overflow() above."
    }
  ]
}