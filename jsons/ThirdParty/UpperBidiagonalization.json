    {
      "id": "upperbidiagonalization-inplace-unblocked",
      "name": "upperbidiagonalization_inplace_unblocked",
      "category": "UpperBidiagonalization",
      "signature": "upperbidiagonalization_inplace_unblocked(Target, Mat, Diagonal, Upper Diagonal, Temp Data)",
      "params": [
