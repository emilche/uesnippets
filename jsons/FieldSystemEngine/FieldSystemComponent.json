      "returnType": "Void",
      "docs": "ApplyRadialForce\nThis function will dispatch a command to the physics thread to apply\na linear force that points away from a position.\n@param Enabled Is this force enabled for evaluation.\n@param Position The origin point of the force\n@param Magnitude The size of the linear force."
    },
    {
      "id": "apply-radial-vector-falloff-force",
      "name": "ApplyRadialVectorFalloffForce",
      "category": "Field",
      "signature": "ApplyRadialVectorFalloffForce(Target, Enabled, Position, Radius, Magnitude)",
      "params": [
        {
          "name": "Target",
          "type": "UFieldSystemComponent*"
        },
        {
          "name": "Enabled",
          "type": "Bool"
