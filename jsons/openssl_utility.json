{
  "id": "openssl-utility",
  "label": "openssl_utility",
  "includepath": "openssl_utility.h",
  "functions": [
    {
      "id": "parse-certificate",
      "name": "ParseCertificate",
      "category": "openssl_utility",
      "signature": "ParseCertificate(Cert Buffer, Signature Algorithm Oid, Expiration Time)",
      "params": [
        {
          "name": "Cert Buffer",
          "type": "CRYPTO_BUFFER*"
        },
        {
          "name": "Signature Algorithm Oid",
          "type": "CBS*"
        },
        {
          "name": "Expiration Time",
          "type": "int64_t*"
        }
      ],
      "returnType": "namespace rtc"
    },
    {
      "id": "verify-peer-cert-matches-host",
      "name": "VerifyPeerCertMatchesHost",
      "category": "openssl_utility",
      "signature": "VerifyPeerCertMatchesHost(Ssl, Host)",
      "params": [
        {
          "name": "Ssl",
          "type": "SSL*"
        },
        {
          "name": "Host",
          "type": "absl::string_view"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "log-ssl-errors",
      "name": "LogSSLErrors",
      "category": "openssl_utility",
      "signature": "LogSSLErrors(Prefix)",
      "params": [
        {
          "name": "Prefix",
          "type": "absl::string_view"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "load-builtin-ssl-root-certificates",
      "name": "LoadBuiltinSSLRootCertificates",
      "category": "openssl_utility",
      "signature": "LoadBuiltinSSLRootCertificates(Ssl Ctx)",
      "params": [
        {
          "name": "Ssl Ctx",
          "type": "SSL_CTX*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-buffer-pool",
      "name": "GetBufferPool",
      "category": "openssl_utility",
      "signature": "GetBufferPool()",
      "params": [],
      "returnType": "CRYPTO_BUFFER_POOL*"
    }
  ]
}