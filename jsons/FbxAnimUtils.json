          "type": "Bool"
        },
        {
          "name": "Out Export All",
          "type": "Bool&"
        },
        {
          "name": "Out Cancel Export",
          "type": "Bool&"
        }
      ],
      "returnType": "class UAnimSequence"
    },
    {
