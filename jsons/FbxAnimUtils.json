      "signature": "IsSupportedCurveDataType(In Data Type)",
      "params": [
        {
          "name": "In Data Type",
          "type": "Int"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "should-import-curve",
      "name": "ShouldImportCurve",
      "category": "FbxAnimUtils",
      "signature": "ShouldImportCurve(Curve, Do Not Import With Zero Values)",
      "params": [
        {
