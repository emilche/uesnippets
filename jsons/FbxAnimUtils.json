      "name": "ExtractNodeAttributes",
      "category": "FbxAnimUtils",
      "signature": "ExtractNodeAttributes(In Node, In Do Not Import Curve With Zero, Import All Custom Attributes, Import Function)",
      "params": [
        {
          "name": "In Node",
          "type": "fbxsdk::FbxNode*"
        },
        {
          "name": "In Do Not Import Curve With Zero",
          "type": "Bool"
        },
        {
          "name": "Import All Custom Attributes",
          "type": "Bool"
        },
        {
          "name": "Import Function",
          "type": "TFunctionRef<void ( fbxsdk::FbxProperty&,fbxsdk::FbxAnimCurve*,FString& )>"
