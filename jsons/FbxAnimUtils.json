        },
        {
          "name": "In Do Not Import Curve With Zero",
          "type": "Bool"
        },
        {
          "name": "Import Function",
          "type": "TFunctionRef<void ( fbxsdk::FbxAnimCurve*,FString& )>"
        }
      ],
      "returnType": "Void"
    },
    {
