      "name": "ImportCurveTableFromNode",
      "category": "FbxAnimUtils",
      "signature": "ImportCurveTableFromNode(In Fbx Filename, In Curve Node Name, In Out Curve Table, Out Pre Roll)",
      "params": [
        {
          "name": "In Fbx Filename",
          "type": "String&"
        },
        {
          "name": "In Curve Node Name",
          "type": "String&"
        },
        {
          "name": "In Out Curve Table",
          "type": "UCurveTable*"
        },
        {
          "name": "Out Pre Roll",
          "type": "Float&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "is-supported-curve-data-type",
