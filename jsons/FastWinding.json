      "id": "hessian",
      "name": "hessian",
      "category": "FastWinding",
      "signature": "hessian(X, Y, Z, X, Y, Z, X, Y, Z)",
      "params": [
        {
          "name": "X",
          "type": "fourPi_len3 + c* dpq . X* dpq ."
        },
        {
          "name": "Y",
          "type": "c* dpq . X* dpq ."
        },
        {
          "name": "Z",
          "type": "c* dpq . X* dpq ."
        },
        {
          "name": "X",
          "type": "c* dpq . Y* dpq ."
        },
        {
          "name": "Y",
          "type": "fourPi_len3 + c* dpq . Y* dpq ."
        },
        {
          "name": "Z",
          "type": "c* dpq . Y* dpq ."
        },
        {
          "name": "X",
          "type": "c* dpq . Z* dpq ."
        },
        {
          "name": "Y",
          "type": "c* dpq . Z* dpq ."
        },
        {
          "name": "Z",
          "type": "fourPi_len3 + c* dpq . Z* dpq ."
        }
      ],
      "returnType": "FMatrix3d"
    },
