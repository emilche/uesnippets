  "functions": [
    {
      "id": "generate-unique-name",
      "name": "GenerateUniqueName",
      "category": "DatasmithFacadeUtils",
      "signature": "GenerateUniqueName(Target, Base Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithFacadeUniqueNameProvider*"
        },
        {
          "name": "Base Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Generates a unique name\n@param BaseName Name that will be suffixed with an index to be unique\n@return TCHAR* Unique name. Calling \"Contains()\" with this name will be false.\nPointer is only valid until the next GenerateUniqueName() call."
    },
    {
      "id": "reserve",
      "name": "Reserve",
      "category": "DatasmithFacadeUtils",
      "signature": "Reserve(Target, Number Of Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithFacadeUniqueNameProvider*"
        },
        {
          "name": "Number Of Name",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Reserves space in the internal data structures to contain at least the number of name specified.\n@param NumberOfName The number of name to reserve for."
    },
    {
      "id": "add-existing-name",
      "name": "AddExistingName",
      "category": "DatasmithFacadeUtils",
      "signature": "AddExistingName(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithFacadeUniqueNameProvider*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Void",
      "docs": "Register a name as known\n@param Name name to register"
    },
    {
      "id": "remove-existing-name",
      "name": "RemoveExistingName",
      "category": "DatasmithFacadeUtils",
      "signature": "RemoveExistingName(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithFacadeUniqueNameProvider*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a name from the list of existing name\n@param Name name to unregister"
    }
  ]
