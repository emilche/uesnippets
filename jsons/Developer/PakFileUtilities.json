        },
        {
          "name": "Filename",
          "type": "String&"
        },
        {
          "name": "Offset",
          "type": "UInt64"
        }
      ],
      "returnType": "Void",
      "docs": "Add the given filename with the given Offset interpreted as Offset in bytes in the Pak File.  This version of Add is only useful when all Adds are done by offset, and are converted\ninto Sorting Indexes at the end by a call to ConvertOffsetsToOrder"
    },
    {
