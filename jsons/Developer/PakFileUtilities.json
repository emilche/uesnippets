{
  "id": "pak-file-utilities",
  "label": "PakFileUtilities",
  "includepath": "PakFileUtilities.h",
  "includes": [
    "Array",
    "Map",
    "UnrealString",
    "CoreMinimal",
    "PlatformCrt",
    "NumericLimits",
    "UnrealMathSSE",
    "Optional",
    "IEngineCrypto",
    "Tuple"
  ],
  "functions": [
    {
      "id": "process-order-file",
      "name": "ProcessOrderFile",
      "category": "PakFileUtilities",
      "signature": "ProcessOrderFile(Target, Response File, Secondary Order File, Merge Order, In Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FPakOrderMap*"
        },
        {
          "name": "Response File",
          "type": "TCHAR*"
        },
        {
          "name": "Secondary Order File",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Merge Order",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Offset",
          "type": "TOptional<uint64>",
          "default": "{}"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "merge-order-map",
      "name": "MergeOrderMap",
      "category": "PakFileUtilities",
      "signature": "MergeOrderMap(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FPakOrderMap*"
        },
        {
          "name": "Other",
          "type": "FPakOrderMap&&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-file-order",
      "name": "GetFileOrder",
      "category": "PakFileUtilities",
      "signature": "GetFileOrder(Target, Path, Allow Uexp U Bulk Fallback, Out Is Primary)",
      "params": [
        {
          "name": "Target",
          "type": "FPakOrderMap*"
        },
        {
          "name": "Path",
          "type": "String&"
        },
        {
          "name": "Allow Uexp U Bulk Fallback",
          "type": "Bool"
        },
        {
          "name": "Out Is Primary",
          "type": "Bool*",
          "default": "nullptr"
        }
      ],
      "returnType": "UInt64"
    },
    {
      "id": "write-open-order",
      "name": "WriteOpenOrder",
      "category": "PakFileUtilities",
      "signature": "WriteOpenOrder(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FPakOrderMap*"
        },
        {
          "name": "Ar",
          "type": "FArchive*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "execute-unreal-pak",
      "name": "ExecuteUnrealPak",
      "category": "PakFileUtilities",
      "signature": "ExecuteUnrealPak(Cmd Line)",
      "params": [
        {
          "name": "Cmd Line",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "write-pak-footer",
      "name": "WritePakFooter",
      "category": "PakFileUtilities",
      "signature": "WritePakFooter(Pak Handle, Footer Info)",
      "params": [
        {
          "name": "Pak Handle",
          "type": "FArchive&"
        },
        {
          "name": "Footer Info",
          "type": "FPakFooterInfo&"
        }
      ],
      "returnType": "Void",
      "docs": "Write the index and other data at the end of a pak file after all the entries"
    },
    {
      "id": "sign-pak-file",
      "name": "SignPakFile",
      "category": "PakFileUtilities",
      "signature": "SignPakFile(In Pak Filename, In Signing Key)",
      "params": [
        {
          "name": "In Pak Filename",
          "type": "String&"
        },
        {
          "name": "In Signing Key",
          "type": "FRSAKeyHandle"
        }
      ],
      "returnType": "Bool",
      "docs": "Take an existing pak file and regenerate the signature file"
    }
  ]
}