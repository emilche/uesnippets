    {
      "id": "xxh-3-hash-long-64-b-with-seed",
      "name": "XXH3_hashLong_64b_withSeed",
      "category": "xxh3",
      "signature": "XXH3_hashLong_64b_withSeed(Input, Len, Seed)",
      "params": [
