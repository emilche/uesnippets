          "name": "Acc",
          "type": "xxh_u64* XXH_RESTRICT"
        },
        {
          "name": "Input",
          "type": "xxh_u8* XXH_RESTRICT"
        },
        {
          "name": "Secret",
          "type": "xxh_u8* XXH_RESTRICT"
        },
        {
          "name": "Nb Stripes",
          "type": "size_t"
        },
        {
          "name": "Acc Width",
          "type": "XXH3_accWidth_e"
        }
      ],
      "returnType": "XXH_FORCE_INLINE void",
      "docs": "XXH3_accumulate()\nLoops over XXH3_accumulate_512().\nAssumption: nbStripes will not overflow the secret size"
    },
