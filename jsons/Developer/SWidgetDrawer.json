{
  "id": "s-widget-drawer",
  "label": "SWidgetDrawer",
  "includepath": "SWidgetDrawer.h",
  "includes": [
    "CoreMinimal",
    "WidgetDrawerConfig",
    "SCompoundWidget",
    "DeclarativeSyntaxSupport"
  ],
  "functions": [
    {
      "id": "construct",
      "name": "Construct",
      "category": "SWidgetDrawer",
      "signature": "Construct(Target, In Args, In Status Bar Name)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "In Args",
          "type": "FArguments&"
        },
        {
          "name": "In Status Bar Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "@param InArgs\n@param InStatusBarName Unique ID used to for writing to config file. Config file saves target drawer height."
    },
    {
      "id": "register-drawer",
      "name": "RegisterDrawer",
      "category": "SWidgetDrawer",
      "signature": "RegisterDrawer(Target, Drawer, Slot Index)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer",
          "type": "FWidgetDrawerConfig&&"
        },
        {
          "name": "Slot Index",
          "type": "Int",
          "default": "INDEX_NONE"
        }
      ],
      "returnType": "Void",
      "docs": "Registers a new drawer with this status bar. Registering will add a button to open and close the drawer"
    },
    {
      "id": "unregister-drawer",
      "name": "UnregisterDrawer",
      "category": "SWidgetDrawer",
      "signature": "UnregisterDrawer(Target, Drawer Id)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer Id",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Unregisters drawer with the given DrawerId.\nThis will dismiss the drawer immediately if its opened, and destroy the status bar widget that opens/closes the drawer\n@param DrawerId name of the registered drawer to unregister"
    },
    {
      "id": "open-drawer",
      "name": "OpenDrawer",
      "category": "SWidgetDrawer",
      "signature": "OpenDrawer(Target, Drawer Id)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer Id",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Opens a drawer\n@param DrawerId Name of the registered drawer to open"
    },
    {
      "id": "dismiss-drawer",
      "name": "DismissDrawer",
      "category": "SWidgetDrawer",
      "signature": "DismissDrawer(Target, Newly Focused Widget)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Newly Focused Widget",
          "type": "TSharedPtr<SWidget>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Dismisses an open drawer with an animation.  The drawer contents are removed once the animation is complete\n@param NewlyFocusedWidget Optional widget to focus\n@return true if any open drawer was dismissed"
    },
    {
      "id": "close-drawer-immediately",
      "name": "CloseDrawerImmediately",
      "category": "SWidgetDrawer",
      "signature": "CloseDrawerImmediately(Target, Drawer Id)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer Id",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Closes a drawer immediately with no closing animation. Needed for when UI is shutting down or to prevent conflicts where a drawer is open in two places at once.\n@param DrawerId The name of the drawer to close. If no name is specified all drawers are closed immediately"
    },
    {
      "id": "is-drawer-opened",
      "name": "IsDrawerOpened",
      "category": "SWidgetDrawer",
      "signature": "IsDrawerOpened(Target, Drawer Id)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer Id",
          "type": "Name"
        }
      ],
      "returnType": "Bool",
      "docs": "Is a specific registered drawer currently open"
    },
    {
      "id": "is-any-other-drawer-opened",
      "name": "IsAnyOtherDrawerOpened",
      "category": "SWidgetDrawer",
      "signature": "IsAnyOtherDrawerOpened(Target, Drawer Id)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Drawer Id",
          "type": "Name"
        }
      ],
      "returnType": "Bool",
      "docs": "Is any drawer other than the one specified by DrawerId opened"
    },
    {
      "id": "get-serializable-name",
      "name": "GetSerializableName",
      "category": "SWidgetDrawer",
      "signature": "GetSerializableName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "on-global-focus-changing",
      "name": "OnGlobalFocusChanging",
      "category": "SWidgetDrawer",
      "signature": "OnGlobalFocusChanging(Target, Focus Event, Old Focused Widget Path, Old Focused Widget, New Focused Widget Path, New Focused Widget)",
      "params": [
        {
          "name": "Target",
          "type": "SWidgetDrawer*"
        },
        {
          "name": "Focus Event",
          "type": "FFocusEvent&"
        },
        {
          "name": "Old Focused Widget Path",
          "type": "FWeakWidgetPath&"
        },
        {
          "name": "Old Focused Widget",
          "type": "TSharedPtr<SWidget>&"
        },
        {
          "name": "New Focused Widget Path",
          "type": "FWidgetPath&"
        },
        {
          "name": "New Focused Widget",
          "type": "TSharedPtr<SWidget>&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when global focus changes which is used to determine if we should close an opened content browser drawer"
    }
  ]
}