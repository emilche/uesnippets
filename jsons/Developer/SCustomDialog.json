{
  "id": "s-custom-dialog",
  "label": "SCustomDialog",
  "includepath": "Dialog/SCustomDialog.h",
  "includes": [
    "CoreMinimal",
    "AppStyle",
    "SWindow"
  ],
  "functions": [
    {
      "id": "set-is-enabled",
      "name": "SetIsEnabled",
      "category": "SCustomDialog",
      "signature": "SetIsEnabled(Target, In Button Is Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "FButton*"
        },
        {
          "name": "In Button Is Enabled",
          "type": "TAttribute<bool>"
        }
      ],
      "returnType": "FButton&",
      "docs": "Set whether this button enabled"
    },
    {
      "id": "set-tool-tip-text",
      "name": "SetToolTipText",
      "category": "SCustomDialog",
      "signature": "SetToolTipText(Target, In Button Tool Tip Text)",
      "params": [
        {
          "name": "Target",
          "type": "FButton*"
        },
        {
          "name": "In Button Tool Tip Text",
          "type": "TAttribute<FText>"
        }
      ],
      "returnType": "FButton&",
      "docs": "Set the tooltip text to use for this button"
    },
    {
      "id": "set-primary",
      "name": "SetPrimary",
      "category": "SCustomDialog",
      "signature": "SetPrimary(Target, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FButton*"
        },
        {
          "name": "Value",
          "type": "Bool"
        }
      ],
      "returnType": "FButton&",
      "docs": "Primary buttons are highlighted"
    },
    {
      "id": "set-on-clicked",
      "name": "SetOnClicked",
      "category": "SCustomDialog",
      "signature": "SetOnClicked(Target, In On Clicked)",
      "params": [
        {
          "name": "Target",
          "type": "FButton*"
        },
        {
          "name": "In On Clicked",
          "type": "FSimpleDelegate"
        }
      ],
      "returnType": "FButton&",
      "docs": "Called when the button is clicked"
    },
    {
      "id": "set-focus",
      "name": "SetFocus",
      "category": "SCustomDialog",
      "signature": "SetFocus(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FButton*"
        }
      ],
      "returnType": "FButton&",
      "docs": "Whether to focus this button. Focus rules:\n1: If a button has SetFocus(), use the last one\n2: If a button is marked primary, use the last one\n3: Otherwise, use the last button"
    },
    {
      "id": "show",
      "name": "Show",
      "category": "SCustomDialog",
      "signature": "Show(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SCustomDialog*"
        }
      ],
      "returnType": "Void",
      "docs": "Show the dialog.\nThis method will return immediately."
    },
    {
      "id": "show-modal",
      "name": "ShowModal",
      "category": "SCustomDialog",
      "signature": "ShowModal(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SCustomDialog*"
        }
      ],
      "returnType": "Int",
      "docs": "Show a modal dialog. Will block until an input is received.\nReturns the index of the button that was pressed."
    }
  ]
}