    {
      "id": "add-sub-menu-ad5bd8",
      "name": "AddSubMenu",
      "category": "ToolMenuSection",
      "signature": "AddSubMenu(Target, In Name, In Label, In Tool Tip, In Make Menu, In Action, In User Interface Action Type, In Open Sub Menu On Click, In Icon, Should Close Window After Menu Selection)",
      "params": [
        {
          "name": "Target",
          "type": "FToolMenuSection*"
        },
        {
          "name": "In Name",
          "type": "Name"
        },
        {
          "name": "In Label",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "In Tool Tip",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "In Make Menu",
          "type": "FNewToolMenuChoice&"
        },
        {
          "name": "In Action",
          "type": "FToolUIActionChoice&"
        },
        {
          "name": "In User Interface Action Type",
          "type": "EUserInterfaceActionType"
        },
        {
          "name": "In Open Sub Menu On Click",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Icon",
          "type": "TAttribute<FSlateIcon>&",
          "default": "TAttribute<FSlateIcon>()"
        },
        {
          "name": "Should Close Window After Menu Selection",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FToolMenuEntry&",
      "docs": "Add a sub-menu to this section.\n@param InName The FName to use for identifying this sub-menu. Must be unique within the section.\n@param InLabel The user-visible label to use for this sub-menu.\n@param InToolTip The user-visible tooltip to use for this sub-menu.\n@param InMakeMenu The delegate to call to construct the sub-menu. This delegate is called when the user clicks the sub-menu entry.\n@param InAction The delegates to use to make this menu entry interactive.\n@param InUserInterfaceActionType The type of user interface element (such as a checkbox) to use for this entry.\n@param bInOpenSubMenuOnClick Whether or not the sub-menu entry opens when it is hovered or only when clicked.\n@param InIcon The user-visible icon to use for this sub-menu.\n@param bShouldCloseWindowAfterMenuSelection Whether or not the sub-menu should close after one of its entries is clicked.\n@return A reference to the menu entry for the added sub-menu."
    },
