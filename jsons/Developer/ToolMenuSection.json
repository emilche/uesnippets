    {
      "id": "add-menu-entry-17e782",
      "name": "AddMenuEntry",
      "category": "ToolMenuSection",
      "signature": "AddMenuEntry(Target, In Name, In Label, In Tool Tip, In Icon, In Action, User Interface Action Type, In Tutorial Highlight Name)",
      "params": [
        {
          "name": "Target",
          "type": "FToolMenuSection*"
        },
        {
          "name": "In Name",
          "type": "Name"
        },
        {
          "name": "In Label",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "In Tool Tip",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "In Icon",
          "type": "TAttribute<FSlateIcon>&"
        },
        {
          "name": "In Action",
          "type": "FToolUIActionChoice&"
        },
        {
          "name": "User Interface Action Type",
          "type": "EUserInterfaceActionType",
          "default": "EUserInterfaceActionType::Button"
        },
        {
          "name": "In Tutorial Highlight Name",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "FToolMenuEntry&",
      "docs": "Add a menu entry to this section.\n@param InName The FName of the added entry used to identify it.\n@param InLabel The user-visible label of this entry.\n@param InToolTip The user-visible tooltip of this entry.\n@param InIcon The user-visible icon of this entry.\n@param InAction The delegates to call to make this entry interactive. Supports more than just on-click delegates. See FToolUIActionChoice for more information.\n@param UserInterfaceActionType The type of user interface element (such as a checkbox) to use for this entry. See EUserInterfaceActionType for more options.\n@return A reference to the added menu entry."
    },
