      "params": [
        {
          "name": "Target",
          "type": "FZenFileSystemManifest*"
        }
      ],
      "returnType": "TArrayView<FZenFileSystemManifestEntry>"
    },
    {
      "id": "num-entries",
      "name": "NumEntries",
      "category": "ZenFileSystemManifest",
      "signature": "NumEntries(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FZenFileSystemManifest*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "server-root-path",
      "name": "ServerRootPath",
      "category": "ZenFileSystemManifest",
      "signature": "ServerRootPath(Target)",
      "params": [
        {
          "name": "Target",
