        }
      ],
      "returnType": "String&"
    },
    {
      "id": "get-referenced-set",
      "name": "GetReferencedSet",
      "category": "ZenFileSystemManifest",
      "signature": "GetReferencedSet(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FZenFileSystemManifest*"
        }
      ],
      "returnType": "TOptional<FZenFileSystemManifestEntry>",
      "docs": "Return the ManifestEntry that was found for the ReferencedSet.txt artifact left by the cooker in the Metadata\ndirectory. The ReferencedSet reports which packages in the oplog were cooked in the most recent incremental\ncook. ZenServer needs to read it, so we report it separately to ZenServer rather than reporting it with the\nrest of the cook artifacts reported in the EndCook op."
    }
