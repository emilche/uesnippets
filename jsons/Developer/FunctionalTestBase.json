{
  "id": "functional-test-base",
  "label": "FunctionalTestBase",
  "includepath": "FunctionalTestBase.h",
  "includes": [
    "CoreMinimal",
    "AutomationTest"
  ],
  "functions": [
    {
      "id": "suppress-logs",
      "name": "SuppressLogs",
      "category": "FunctionalTestBase",
      "signature": "SuppressLogs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "If true logs will not be included in test events\n@return true to suppress logs"
    },
    {
      "id": "should-capture-log-category",
      "name": "ShouldCaptureLogCategory",
      "category": "FunctionalTestBase",
      "signature": "ShouldCaptureLogCategory(Target, Category)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        },
        {
          "name": "Category",
          "type": "Name&"
        }
      ],
      "returnType": "Bool",
      "docs": "Should the log category be captured and surfaced as part of the test.\n@return true to allow a log category through."
    },
    {
      "id": "set-log-error-and-warning-handling",
      "name": "SetLogErrorAndWarningHandling",
      "category": "FunctionalTestBase",
      "signature": "SetLogErrorAndWarningHandling(Target, In Suppress Errors, In Suppress Warnings, In Warnings Are Errors)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        },
        {
          "name": "In Suppress Errors",
          "type": "TOptional<bool>"
        },
        {
          "name": "In Suppress Warnings",
          "type": "TOptional<bool>"
        },
        {
          "name": "In Warnings Are Errors",
          "type": "TOptional<bool>"
        }
      ],
      "returnType": "Void",
      "docs": "Specify how log errors & warnings should be handled during tests. If values are not set then the project\ndefaults will be used."
    },
    {
      "id": "suppress-log-errors",
      "name": "SuppressLogErrors",
      "category": "FunctionalTestBase",
      "signature": "SuppressLogErrors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines if Error logs should be suppressed from test results"
    },
    {
      "id": "suppress-log-warnings",
      "name": "SuppressLogWarnings",
      "category": "FunctionalTestBase",
      "signature": "SuppressLogWarnings(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines if Warning logs should be suppressed from test results"
    },
    {
      "id": "elevate-log-warnings-to-errors",
      "name": "ElevateLogWarningsToErrors",
      "category": "FunctionalTestBase",
      "signature": "ElevateLogWarningsToErrors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines if Warning logs should be treated as errors"
    },
    {
      "id": "set-functional-test-running",
      "name": "SetFunctionalTestRunning",
      "category": "FunctionalTestBase",
      "signature": "SetFunctionalTestRunning(Target, In Name)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        },
        {
          "name": "In Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Marks us as actively running a functional test"
    },
    {
      "id": "set-functional-test-complete",
      "name": "SetFunctionalTestComplete",
      "category": "FunctionalTestBase",
      "signature": "SetFunctionalTestComplete(Target, In Name)",
      "params": [
        {
          "name": "Target",
          "type": "FFunctionalTestBase*"
        },
        {
          "name": "In Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Marks us as no longer running a test"
    },
    {
      "id": "get-running-test-name",
      "name": "GetRunningTestName",
      "category": "FunctionalTestBase",
      "signature": "GetRunningTestName()",
      "params": [],
      "returnType": "String",
      "docs": "Returns the name of the running functional test. Empty if no test is running"
    },
    {
      "id": "is-functional-test-running",
      "name": "IsFunctionalTestRunning",
      "category": "FunctionalTestBase",
      "signature": "IsFunctionalTestRunning()",
      "params": [],
      "returnType": "Bool",
      "docs": "Returns true if a functional test is running (does not include map setup)"
    }
  ]
}