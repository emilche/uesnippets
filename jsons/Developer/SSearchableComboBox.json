{
  "id": "s-searchable-combo-box",
  "label": "SSearchableComboBox",
  "includepath": "SSearchableComboBox.h",
  "includes": [
    "CoreMinimal",
    "Reply",
    "SWidget",
    "SComboButton",
    "SEditableTextBox",
    "SListView",
    "SComboBox"
  ],
  "functions": [
    {
      "id": "clear-selection",
      "name": "ClearSelection",
      "category": "SSearchableComboBox",
      "signature": "ClearSelection(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-selected-item",
      "name": "SetSelectedItem",
      "category": "SSearchableComboBox",
      "signature": "SetSelectedItem(Target, In Selected Item, In Select Info)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        },
        {
          "name": "In Selected Item",
          "type": "TSharedPtr<FString>"
        },
        {
          "name": "In Select Info",
          "type": "ESelectInfo::Type",
          "default": "ESelectInfo::OnNavigation"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the selected item.  By default, registers as a navigation request, which *does not*\nset the cached selected item, only updating the visually selected item.\n@param InSelectedItem Item to select\n@param InSelectInfo (optional) How the selected item is being committed (default: OnNavigation)"
    },
    {
      "id": "get-selected-item",
      "name": "GetSelectedItem",
      "category": "SSearchableComboBox",
      "signature": "GetSelectedItem(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        }
      ],
      "returnType": "TSharedPtr<FString>",
      "docs": "@return the item currently selected by the combo box."
    },
    {
      "id": "refresh-options",
      "name": "RefreshOptions",
      "category": "SSearchableComboBox",
      "signature": "RefreshOptions(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Requests a list refresh after updating options\nCall SetSelectedItem to update the selected item if required\n@see SetSelectedItem"
    },
    {
      "id": "set-options-source",
      "name": "SetOptionsSource",
      "category": "SSearchableComboBox",
      "signature": "SetOptionsSource(Target, In Options Source)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        },
        {
          "name": "In Options Source",
          "type": "TArray<TSharedPtr<FString>>*"
        }
      ],
      "returnType": "protected : void",
      "docs": "Set ths source data for this combo box"
    },
    {
      "id": "on-button-clicked",
      "name": "OnButtonClicked",
      "category": "SSearchableComboBox",
      "signature": "OnButtonClicked(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSearchableComboBox*"
        }
      ],
      "returnType": "FReply",
      "docs": "Handle clicking on the content menu"
    }
  ]
}