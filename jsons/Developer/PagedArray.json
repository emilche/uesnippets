    {
      "id": "get-element-range-overlapping-given-range",
      "name": "GetElementRangeOverlappingGivenRange",
      "category": "PagedArray",
      "signature": "GetElementRangeOverlappingGivenRange<ItemType, PageType>(Target, Paged Array, Start Time, End Time, Item Start Projection, Item End Projection)",
      "params": [
        {
          "name": "Target",
          "type": "TPagedArray*"
        },
        {
          "name": "Paged Array",
          "type": "TPagedArray<ItemType,PageType>&"
        },
        {
          "name": "Start Time",
          "type": "Double"
        },
        {
          "name": "End Time",
          "type": "Double"
        },
        {
          "name": "Item Start Projection",
          "type": "TFunctionRef<double ( ItemType& )>"
        },
        {
          "name": "Item End Projection",
          "type": "TFunctionRef<double ( ItemType& )>"
        }
      ],
      "returnType": "template<ItemType,PageType> FInt32Interval",
      "docs": "Use binary search to find the first and last element inside a TPagedArray that overlaps a given input interval.\nThis requires the elements in the array to be sorted by the value returned from the Projection.\nExample usage for Timeline events would require a projection that returns Item.StartTime and the resulting range.Min\nwill point to the last element where Item.End > StartTime and range.Max to the last element where\nItem.StartTime < EndTime."
    },
    {
      "id": "t-less",
      "name": "TLess",
      "category": "PagedArray",
      "signature": "TLess<SizeType, ItemType, PageType, ValueType, ProjectionType, SortPredicateType>(Target, Sort Predicate)",
      "params": [
        {
          "name": "Target",
          "type": "TPagedArray*"
        },
        {
          "name": "Sort Predicate",
          "type": ")> FORCEINLINE SizeType LowerBoundInternal ( TPagedArray<ItemType,PageType>& PagedArray,ValueType& Value,ProjectionType Projection,SortPredicateType"
        }
      ],
      "returnType": "template<SizeType,ItemType,PageType,ValueType,ProjectionType,SortPredicateType =",
      "docs": "Performs binary search, resulting in position of the first element with projected value >= Value.\n@param PagedArray The paged array to search through; must be already sorted by SortPredicate.\n@param Value The value to look for\n@param Projection The functor or data member pointer; called via Invoke to compare to Value.\n@param SortPredicate The predicate for sort comparison; defaults to <.\n@returns The position of the first element with projected value >= Value; may be == Num."
    },
