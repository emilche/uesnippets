    {
      "id": "new-page",
      "name": "NewPage",
      "category": "MessageLogListingModel",
      "signature": "NewPage(Target, In Title, In Max Pages)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLogListingModel*"
        },
        {
          "name": "In Title",
          "type": "Text&"
        },
        {
          "name": "In Max Pages",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Add a new page. Old pages are only kept around if they contain messages, so if the current\npage is empty, this call does nothing.\n@param\tInTitle\t\tThe title that will be displayed for this page.\n@param\tInMaxPages\tThe maximum number of pages we keep around. If the count is exceeded,\nwe discard the oldest page."
    },
    {
      "id": "set-current-page-604e26",
      "name": "SetCurrentPage",
      "category": "MessageLogListingModel",
      "signature": "SetCurrentPage(Target, In Title, In Max Pages)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLogListingModel*"
        },
        {
          "name": "In Title",
          "type": "Text&"
        },
        {
          "name": "In Max Pages",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Sets the current page to the one specified by the title. If the page does not exist, creates a new page.\n@param\tInTitle\t\tThe title of the page to search for, or create\n@param\tInMaxPages\tThe maximum number of pages we keep around. If the count is exceeded,\nwe discard the oldest page.\n@returns true if the page has changed (either switched or created a new one)."
    },
    {
      "id": "set-current-page-cb65cf",
      "name": "SetCurrentPage",
      "category": "MessageLogListingModel",
      "signature": "SetCurrentPage(Target, In Old Page Index)",
