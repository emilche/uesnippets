    {
      "id": "set-associated-development-asset-registry-hash",
      "name": "SetAssociatedDevelopmentAssetRegistryHash",
      "category": "CookMetadata",
      "signature": "SetAssociatedDevelopmentAssetRegistryHash(In Hash)",
      "params": [
        {
          "name": "In Hash",
          "type": "UInt64"
        }
      ],
      "returnType": "Void",
      "docs": "Associated DevAR Hash.\nThis is computed by reading the development asset registry file into a memory buffer and calling\nComputeHashOfDevelopmentAssetRegistry on the data.\nUse this to ensure that the files you are working with were produced by the same cook and didn't\nget out of sync somehow.\n*IMPORTANT* If asset registry writeback is enabled during staging, then the hash of the development\nasset registry changes, and you'll need to check against GetAssociatedDevelopmentAssetRegistryHashPostWriteback.\nIf you don't know which one you have, check both - they are both valid.\ne.g.\nuint64 CheckHash = GetAssociatedDevelopmentAssetRegistryHash();\nbValidDevAr = ComputeHashOfDevelopmentAssetRegistry(MakeMemoryView(SerializedAssetRegistry)) == CheckHash;"
    },
    {
      "id": "set-associated-development-asset-registry-hash-post-writeback",
