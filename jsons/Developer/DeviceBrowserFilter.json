{
  "id": "device-browser-filter",
  "label": "DeviceBrowserFilter",
  "includepath": "DeviceBrowserFilter.h",
  "includes": [
    "CoreTypes",
    "Array",
    "Map",
    "UnrealString",
    "Delegate",
    "Text",
    "ITargetDeviceService",
    "SharedPointer"
  ],
  "functions": [
    {
      "id": "get-service-count-per-platform",
      "name": "GetServiceCountPerPlatform",
      "category": "DeviceBrowserFilter",
      "signature": "GetServiceCountPerPlatform(Target, Platform Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "Int",
      "docs": "Get the number of target device services that have the specified platform.\n@param PlatformName The name of the platform.\n@return The number of matching services."
    },
    {
      "id": "get-device-search-text",
      "name": "GetDeviceSearchText",
      "category": "DeviceBrowserFilter",
      "signature": "GetDeviceSearchText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        }
      ],
      "returnType": "Text&",
      "docs": "Get the device search string.\n@return Search string."
    },
    {
      "id": "get-filtered-platforms",
      "name": "GetFilteredPlatforms",
      "category": "DeviceBrowserFilter",
      "signature": "GetFilteredPlatforms(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        }
      ],
      "returnType": "TArray<TSharedPtr<FDeviceBrowserFilterEntry>>&",
      "docs": "Return the list of filtered platforms.\n@return List of platform names."
    },
    {
      "id": "is-platform-enabled",
      "name": "IsPlatformEnabled",
      "category": "DeviceBrowserFilter",
      "signature": "IsPlatformEnabled(Target, Platform Name)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether the specified platform is enabled in the filter.\n@param PlatformName The name of the platform to check.\n@return true if the platform is enabled, false otherwise.\n@see SetPlatformEnabled"
    },
    {
      "id": "reset-filter",
      "name": "ResetFilter",
      "category": "DeviceBrowserFilter",
      "signature": "ResetFilter(Target, Device Services)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        },
        {
          "name": "Device Services",
          "type": "TArray<ITargetDeviceServicePtr>&"
        }
      ],
      "returnType": "Void",
      "docs": "Populate the filter from the given list of target device proxies.\n@param DeviceProxies The list of device proxies to populate the filter from."
    },
    {
      "id": "set-device-search-string",
      "name": "SetDeviceSearchString",
      "category": "DeviceBrowserFilter",
      "signature": "SetDeviceSearchString(Target, Search Text)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        },
        {
          "name": "Search Text",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the current device search string.\n@param SearchText The search string."
    },
    {
      "id": "set-platform-enabled",
      "name": "SetPlatformEnabled",
      "category": "DeviceBrowserFilter",
      "signature": "SetPlatformEnabled(Target, Platform Name, Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        },
        {
          "name": "Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Set the enabled state of the specified device proxy platform.\n@param PlatformName The name of the platform to enable or disable in the filter.\n@param Enabled Whether the platform is enabled.\n@see IsPlatformEnabled"
    },
    {
      "id": "on-filter-changed",
      "name": "OnFilterChanged",
      "category": "DeviceBrowserFilter",
      "signature": "OnFilterChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        }
      ],
      "returnType": "FOnDeviceBrowserFilterChanged&"
    },
    {
      "id": "on-filter-reset",
      "name": "OnFilterReset",
      "category": "DeviceBrowserFilter",
      "signature": "OnFilterReset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceBrowserFilter*"
        }
      ],
      "returnType": "FOnDeviceBrowserFilterReset&"
    }
  ]
}