          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "Uri",
          "type": "FStringView"
        }
      ],
      "returnType": "Result",
      "docs": "Query an url using the request. Queries can use either \"Head\" or \"Delete\" verbs.\n@param Uri Url to use.\n@return Result of the request"
    },
    {
      "id": "perform-blocking-post-package",
