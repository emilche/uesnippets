    {
      "id": "perform-blocking-put",
      "name": "PerformBlockingPut",
      "category": "ZenServerHttp",
      "signature": "PerformBlockingPut(Target, Uri, Buffer, Content Type)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "Uri",
          "type": "TCHAR*"
        },
        {
          "name": "Buffer",
          "type": "FCompositeBuffer&"
        },
        {
          "name": "Content Type",
          "type": "EContentType"
        }
      ],
      "returnType": "Result",
      "docs": "Convenience result type interpreted from HTTP response code."
    },
    {
      "id": "perform-blocking-download-14c165",
      "name": "PerformBlockingDownload",
      "category": "ZenServerHttp",
      "signature": "PerformBlockingDownload(Target, Uri, Buffer, Accept Type)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "Uri",
          "type": "FStringView"
        },
        {
          "name": "Buffer",
          "type": "TArray64<uint8>*"
        },
        {
          "name": "Accept Type",
          "type": "EContentType"
        }
      ],
      "returnType": "Result",
      "docs": "Download an url into a buffer using the request.\n@param Uri Url to use.\n@param Buffer Optional buffer where data should be downloaded to. If this is null then\ndownloaded data will be stored in an internal buffer and accessed via GetResponseAsString\n@param ContentType The MIME type to accept.\n@return Result of the request"
    },
    {
      "id": "perform-blocking-download-f68a9c",
      "name": "PerformBlockingDownload",
      "category": "ZenServerHttp",
      "signature": "PerformBlockingDownload(Target, Uri, Out Package)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "Uri",
          "type": "TCHAR*"
        },
        {
          "name": "Out Package",
          "type": "FCbPackage&"
        }
      ],
      "returnType": "Result",
      "docs": "Download an url into a buffer using the request.\n@param Uri Url to use.\n@param OutPackage Package instance which will receive the data\n@result Request success/failure status"
    },
    {
      "id": "perform-blocking-head",
      "name": "PerformBlockingHead",
      "category": "ZenServerHttp",
      "signature": "PerformBlockingHead(Target, Uri, Accept Type)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "Uri",
          "type": "FStringView"
        },
        {
          "name": "Accept Type",
          "type": "EContentType"
        }
      ],
      "returnType": "Result",
      "docs": "Query an url using the request. Queries can use either \"Head\" or \"Delete\" verbs.\n@param Uri Url to use.\n@param ContentType The MIME type to accept.\n@return Result of the request"
    },
    {
      "id": "perform-blocking-delete",
      "name": "PerformBlockingDelete",
