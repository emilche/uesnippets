      "id": "reset",
      "name": "Reset",
      "category": "ZenServerHttp",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets all options on the request except those that should always be set."
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "ZenServerHttp",
      "signature": "Initialize(Target, In Log Errors)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequest*"
        },
        {
          "name": "In Log Errors",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes a previously-allocated FZenHttpRequest with the options that can vary between requests"
    },
    {
      "id": "get-error",
      "name": "GetError",
