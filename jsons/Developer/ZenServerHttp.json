    {
      "id": "wait-for-free-request",
      "name": "WaitForFreeRequest",
      "category": "ZenServerHttp",
      "signature": "WaitForFreeRequest(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequestPool*"
        }
      ],
      "returnType": "FZenHttpRequest*",
      "docs": "Block until a request is free. Once a request has been returned it is\n\"owned by the caller and need to release it to the pool when work has been completed.\n@return Usable request instance."
    },
    {
      "id": "release-request-to-pool",
      "name": "ReleaseRequestToPool",
      "category": "ZenServerHttp",
      "signature": "ReleaseRequestToPool(Target, Request)",
      "params": [
        {
          "name": "Target",
          "type": "FZenHttpRequestPool*"
        },
        {
          "name": "Request",
          "type": "FZenHttpRequest*"
        }
      ],
      "returnType": "Void",
      "docs": "Release request to the pool.\n@param Request Request that should be freed. Note that any buffer owned by the request can now be reset."
    }
  ]
