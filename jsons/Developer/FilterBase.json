  "includes": [
    "FilterCollection",
    "IFilter",
    "Text",
    "Color",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "set-active",
      "name": "SetActive",
      "category": "FilterBase",
      "signature": "SetActive(Target, Active)",
      "params": [
        {
          "name": "Target",
          "type": "FFilterBase*"
        },
        {
          "name": "Active",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Set this filter as checked, and activates or deactivates it.\n@note this only works for filters registered by a widget such as SBasicFilterBar that manages them and\nshould be called by external code rather than by the managing widget itself."
    },
    {
      "id": "is-active",
      "name": "IsActive",
      "category": "FilterBase",
      "signature": "IsActive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFilterBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks whether the filter is checked/pinned and active/enabled"
    },
    {
      "id": "set-active-in-collection",
      "name": "SetActiveInCollection",
      "category": "FilterBase",
      "signature": "SetActiveInCollection(This, Active, Collection)",
      "params": [
        {
          "name": "This",
          "type": "TSharedRef<FFilterBase<FilterType>>"
        },
        {
          "name": "Active",
          "type": "Bool"
        },
        {
          "name": "Collection",
          "type": "TFilterCollection<FilterType>&"
        }
      ],
      "returnType": "Void",
      "docs": "Manage the state of a filter in a collection taking into account whether it is an inverse filter or not.\nAdds or removes the filter from the collcetion and calls ActiveStateChanged"
    },
    {
      "id": "on-changed",
      "name": "OnChanged",
      "category": "FilterBase",
      "signature": "OnChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFilterBase*"
        }
      ],
      "returnType": "FChangedEvent&"
    },
    {
      "id": "get-category",
      "name": "GetCategory",
      "category": "FilterBase",
      "signature": "GetCategory(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFilterBase*"
        }
      ],
      "returnType": "TSharedPtr<FFilterCategory>"
    }
  ]
}