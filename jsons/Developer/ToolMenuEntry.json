    {
      "id": "set-show-in-toolbar-top-level",
      "name": "SetShowInToolbarTopLevel",
      "category": "ToolMenuEntry",
      "signature": "SetShowInToolbarTopLevel(Target, In Top Level)",
      "params": [
        {
          "name": "Target",
          "type": "FToolMenuEntry*"
        },
        {
          "name": "In Top Level",
          "type": "TAttribute<bool>"
        }
      ],
      "returnType": "Void",
      "docs": "Show this menu entry in the top-level toolbar section of a toolbar.\nEntries of a toolbar submenu can be raised to the top-level of the toolbar. Such top-level entires appear in the\ntoolbar to the right of the submenu they belong to.\nThis flag only effects entries within submenus of toolbar-type ToolMenus.\nTHIS AFFECTS STYLING. When an entry is raised to the top level of a toolbar, the \".Raised\" suffix is added to\nthe style name that would otherwise have been applied.\n@param InTopLevel True shows the entry in the top-level next to its submenu, false (default) only displays it in\nthe submenu itself. Pass a delegate to drive the top-level state from code."
    },
