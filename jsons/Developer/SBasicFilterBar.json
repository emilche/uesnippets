          "name": "In Filter",
          "type": "TSharedPtr<FFilterBase<FilterType>>&"
        },
        {
          "name": "In Check State",
          "type": "ECheckBoxState"
        }
      ],
      "returnType": "Void",
      "docs": "Set the check box state of the specified filter (in the filter drop down) and pin/unpin a filter widget on/from the filter bar. When a filter is pinned (was not already pinned), it is activated and deactivated when unpinned."
    },
    {
      "id": "get-filter-check-state",
      "name": "GetFilterCheckState",
      "category": "SBasicFilterBar",
      "signature": "GetFilterCheckState(Target, In Filter)",
      "params": [
        {
          "name": "Target",
          "type": "SBasicFilterBar*"
        },
        {
          "name": "In Filter",
          "type": "TSharedPtr<FFilterBase<FilterType>>&"
        }
      ],
      "returnType": "ECheckBoxState",
      "docs": "Returns the check box state of the specified filter (in the filter drop down). This tells whether the filter is pinned or not on the filter bar, but not if filter is active or not. @see IsFilterActive()."
    },
    {
      "id": "is-filter-active",
      "name": "IsFilterActive",
      "category": "SBasicFilterBar",
