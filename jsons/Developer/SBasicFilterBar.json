          "name": "In Filter",
          "type": "TSharedPtr<FFilterBase<FilterType>>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the specified filter is both checked (pinned on the filter bar) and active (contributing to filter the result)."
