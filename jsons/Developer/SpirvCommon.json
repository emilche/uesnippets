      "category": "SpirvCommon",
      "signature": "GetWordOffset(Target, Iter, Operand Word Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirv*"
        },
        {
          "name": "Iter",
          "type": "FSpirvConstIterator&"
        },
        {
          "name": "Operand Word Offset",
          "type": "UInt",
          "default": "0"
        }
      ],
      "returnType": "UInt",
      "docs": "Returns the word offset to the instruction the specified iterator points to plus additional operand word offset."
