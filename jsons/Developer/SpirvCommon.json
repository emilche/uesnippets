      "params": [
        {
          "name": "Built In",
          "type": "SpvBuiltIn"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Returns the string representation of the specified SPIR-V built-in variable, e.g. SpvBuiltInPosition to TEXT(\"gl_Position\"). Returns nullptr for invalid value."
    },
    {
      "id": "find-offset-to-spirv-entry-point",
      "name": "FindOffsetToSpirvEntryPoint",
      "category": "SpirvCommon",
      "signature": "FindOffsetToSpirvEntryPoint(Spirv, Entry Point Name, Out Word Offset To Entry Point, Out Word Offset To Main Name)",
      "params": [
        {
          "name": "Spirv",
          "type": "FSpirv&"
        },
        {
          "name": "Entry Point Name",
          "type": "ANSICHAR*"
        },
        {
          "name": "Out Word Offset To Entry Point",
          "type": "UInt&"
        },
        {
          "name": "Out Word Offset To Main Name",
          "type": "UInt&"
        }
      ],
      "returnType": "Void",
      "docs": "Returns word offset to the entry point (OpEntryPoint) and name of the entry point (OpName). If the respective entry has not been found, the output offset is 0."
    },
    {
      "id": "find-spirv-entry-point",
      "name": "FindSpirvEntryPoint",
      "category": "SpirvCommon",
      "signature": "FindSpirvEntryPoint(Spirv)",
      "params": [
        {
          "name": "Spirv",
          "type": "FSpirv&"
        }
      ],
      "returnType": "ANSICHAR*",
      "docs": "Finds the entry point name name."
    },
    {
      "id": "patch-spirv-entry-point-with-crc",
      "name": "PatchSpirvEntryPointWithCRC",
      "category": "SpirvCommon",
      "signature": "PatchSpirvEntryPointWithCRC(Spirv, Out CRC)",
      "params": [
        {
          "name": "Spirv",
          "type": "FSpirv&"
        },
        {
          "name": "Out CRC",
          "type": "UInt&"
        }
      ],
      "returnType": "ANSICHAR*",
      "docs": "Renames the fixed-size entry point name (which must be \"main_00000000_00000000\") to the formatted name including a CRC over the module. Returns the new entry point name."
    },
    {
      "id": "parse-spirv-global-variables",
      "name": "ParseSpirvGlobalVariables",
      "category": "SpirvCommon",
      "signature": "ParseSpirvGlobalVariables(Spirv, Storage Class, Out Variable Names)",
      "params": [
        {
          "name": "Spirv",
          "type": "FSpirv&"
        },
        {
          "name": "Storage Class",
          "type": "SpvStorageClass"
        },
        {
          "name": "Out Variable Names",
          "type": "TArray<FString>&"
        }
      ],
      "returnType": "Void",
      "docs": "Parse global variables (anything but function local variables) of specified storage class from the specified SPIR-V module."
    }
