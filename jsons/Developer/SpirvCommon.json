      "params": [
        {
          "name": "Target",
          "type": "TSpirvForwardIterator*"
        }
      ],
      "returnType": "UInt",
      "docs": "Returns the word count of the current instruction. A valid SPIR-V instruction must have a word count greater zero."
    },
    {
