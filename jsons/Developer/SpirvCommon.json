        {
          "name": "Target",
          "type": "TSpirvForwardIterator*"
        }
      ],
      "returnType": "SpvOp",
      "docs": "Returns the opcode of the current instruction."
    },
    {
      "id": "word-count",
      "name": "WordCount",
