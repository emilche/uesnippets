    {
      "id": "get-byte-size",
      "name": "GetByteSize",
      "category": "SpirvCommon",
      "signature": "GetByteSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirv*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the size of this SPIR-V module in bytes."
    },
    {
