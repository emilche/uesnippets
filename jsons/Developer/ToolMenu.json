    {
      "id": "add-section-8d6310",
      "name": "AddSection",
      "category": "ToolMenu",
      "signature": "AddSection(Target, Section Name, In Label, In Position)",
      "params": [
        {
          "name": "Target",
          "type": "UToolMenu*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        },
        {
          "name": "In Label",
          "type": "TAttribute<FText>&",
          "default": "TAttribute<FText>()"
        },
        {
          "name": "In Position",
          "type": "FToolMenuInsert",
          "default": "FToolMenuInsert()"
        }
      ],
      "returnType": "FToolMenuSection&",
      "docs": "Add a section to the menu.\nWhen adding sections while registering a menu with UToolMenus::Get()->RegisterMenu(), always use this function.\nThis will ensure that sections have the right label and are presented in the intended order\nregardless of when menu extensions are performed.\n@param SectionName The name of the section.\n@param InLabel The label to set on the section.\n@param InPosition The position of the section within its parent menu.\n@return A reference to the created section."
    },
    {
      "id": "add-dynamic-section-3948f9",
      "name": "AddDynamicSection",
      "category": "ToolMenu",
      "signature": "AddDynamicSection(Target, Section Name, In Construct, In Position)",
      "params": [
        {
          "name": "Target",
          "type": "UToolMenu*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        },
        {
          "name": "In Construct",
          "type": "FNewSectionConstructChoice&"
        },
        {
          "name": "In Position",
          "type": "FToolMenuInsert",
          "default": "FToolMenuInsert()"
        }
      ],
      "returnType": "FToolMenuSection&",
      "docs": "Build a section in a callback.\nThe callback is passed a sandboxed empty menu to add as many sections as desired. Sections are merged into the final menu afterwards.\n@param SectionName The FName of the section the callback will build.\n@param InConstruct The callback that will be run to build the menu as the user opens it.\n@param InPosition The position of the section within its parent menu.\n@return A reference to the created section."
    },
    {
      "id": "find-section",
      "name": "FindSection",
      "category": "ToolMenu",
      "signature": "FindSection(Target, Section Name)",
      "params": [
        {
          "name": "Target",
          "type": "UToolMenu*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        }
      ],
      "returnType": "FToolMenuSection*",
      "docs": "Finds an existing section using the provided FName.\n@param SectionName The section name to find. Provide NAME_None to access the unnamed section of this menu.\n@return A pointer to the found section or nullptr if none was found."
    },
    {
      "id": "find-or-add-section-4d9f17",
      "name": "FindOrAddSection",
      "category": "ToolMenu",
      "signature": "FindOrAddSection(Target, Section Name)",
      "params": [
        {
          "name": "Target",
          "type": "UToolMenu*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        }
      ],
      "returnType": "FToolMenuSection&",
      "docs": "Finds an existing section using the provided FName or, if not found, creates a new one and assigns it that FName.\n@param SectionName The section name to find or add. Provide NAME_None to access the unnamed section of this menu.\n@return A reference to the found or newly created section."
    },
    {
      "id": "find-or-add-section-fa1a6f",
      "name": "FindOrAddSection",
      "category": "ToolMenu",
      "signature": "FindOrAddSection(Target, Section Name, In Label, In Position)",
      "params": [
        {
          "name": "Target",
          "type": "UToolMenu*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        },
        {
          "name": "In Label",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "In Position",
          "type": "FToolMenuInsert",
          "default": "FToolMenuInsert()"
        }
      ],
      "returnType": "FToolMenuSection&",
      "docs": "Finds an existing section using the provided FName or, if not found, creates a new one and assigns it that FName.\nIn case the the section did not exist and a new one was created, then the provided label and optional\nposition is also set on the newly created section.\n@param SectionName The section name to find or add. Provide NAME_None to access the unnamed section of this menu.\n@param InLabel The label to set on the section if a new one is created. If an existing section is returned this label is ignored.\n@param InPosition The position to set on the section if a new one is created. If an existing section is returned this position is ignored.\n@return A reference to the found or newly created section."
    },
