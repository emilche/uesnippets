{
  "id": "text-localization-resource-generator",
  "label": "TextLocalizationResourceGenerator",
  "includepath": "TextLocalizationResourceGenerator.h",
  "includes": [
    "Map",
    "UnrealString",
    "CoreMinimal",
    "Platform",
    "TextKey",
    "EnumClassFlags",
    "SharedPointer"
  ],
  "functions": [
    {
      "id": "generate-loc-res",
      "name": "GenerateLocRes",
      "category": "TextLocalizationResourceGenerator",
      "signature": "GenerateLocRes(In Loc Text Helper, In Culture To Generate, In Generate Flags, In Loc Res ID, Out Platform Agnostic Loc Res, Out Per Platform Loc Res, In Priority)",
      "params": [
        {
          "name": "In Loc Text Helper",
          "type": "FLocTextHelper&"
        },
        {
          "name": "In Culture To Generate",
          "type": "String&"
        },
        {
          "name": "In Generate Flags",
          "type": "EGenerateLocResFlags"
        },
        {
          "name": "In Loc Res ID",
          "type": "FTextKey&"
        },
        {
          "name": "Out Platform Agnostic Loc Res",
          "type": "FTextLocalizationResource&"
        },
        {
          "name": "Out Per Platform Loc Res",
          "type": "TMap<FName,TSharedRef<FTextLocalizationResource>>&"
        },
        {
          "name": "In Priority",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Bool",
      "docs": "Given a loc text helper, generate a compiled LocRes resource for the given culture."
    },
    {
      "id": "generate-loc-res-and-update-live-entries-from-config",
      "name": "GenerateLocResAndUpdateLiveEntriesFromConfig",
      "category": "TextLocalizationResourceGenerator",
      "signature": "GenerateLocResAndUpdateLiveEntriesFromConfig(In Config File Path, In Generate Flags)",
      "params": [
        {
          "name": "In Config File Path",
          "type": "String&"
        },
        {
          "name": "In Generate Flags",
          "type": "EGenerateLocResFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Given a config file, generate a compiled LocRes resource for the active culture and use it to update the live-entries in the localization manager."
    }
  ]
}