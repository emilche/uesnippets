      "returnType": "FAssemblyPartResourceRef"
    },
    {
      "id": "build",
      "name": "Build",
      "category": "NaniteBuilder",
      "signature": "Build(Target, Resources, Input Mesh Data, Out Fallback Mesh Data, Out Ray Tracing Fallback Mesh Data, Ray Tracing Fallback Build Settings, Settings, Assembly Data)",
      "params": [
        {
          "name": "Target",
          "type": "IBuilderModule*"
        },
        {
          "name": "Resources",
          "type": "FResources&"
        },
        {
          "name": "Input Mesh Data",
          "type": "FInputMeshData&"
        },
        {
