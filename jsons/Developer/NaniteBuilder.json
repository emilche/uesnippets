      "name": "IsFallbackReduced",
      "category": "NaniteBuilder",
      "signature": "IsFallbackReduced(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRayTracingFallbackBuildSettings*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "is-available",
      "name": "IsAvailable",
      "category": "NaniteBuilder",
      "signature": "IsAvailable()",
      "params": [],
      "returnType": "Bool",
      "docs": "Checks to see if this module is loaded and ready.  It is only valid to call Get() if IsAvailable() returns true.\n@return True if the module is loaded and ready to use"
