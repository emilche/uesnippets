        },
        {
          "name": "Assembly Data",
          "type": "FInputAssemblyData*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "build-material-indices",
      "name": "BuildMaterialIndices",
      "category": "NaniteBuilder",
