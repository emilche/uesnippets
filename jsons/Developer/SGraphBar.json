          "type": "FGeometry&"
        },
        {
          "name": "Mouse Event",
          "type": "FPointerEvent&"
        }
      ],
      "returnType": "FReply"
    },
    {
      "id": "on-mouse-move",
      "name": "OnMouseMove",
      "category": "SGraphBar",
      "signature": "OnMouseMove(Target, My Geometry, Mouse Event)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "Mouse Event",
          "type": "FPointerEvent&"
        }
      ],
      "returnType": "FReply"
    },
    {
      "id": "compute-desired-size",
      "name": "ComputeDesiredSize",
      "category": "SGraphBar",
      "signature": "ComputeDesiredSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        }
      ],
      "returnType": "FVector2D"
    },
    {
      "id": "set-events",
      "name": "SetEvents",
      "category": "SGraphBar",
      "signature": "SetEvents(Target, In Events, In Start Time, In Total Time)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        },
        {
          "name": "In Events",
          "type": "FVisualizerEventsArray&"
        },
        {
          "name": "In Start Time",
          "type": "Double"
        },
        {
          "name": "In Total Time",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Adds profiler events to draw as bars\n@param InEvent\tEvents to draw"
    },
    {
      "id": "set-zoom",
      "name": "SetZoom",
      "category": "SGraphBar",
      "signature": "SetZoom(Target, In Zoom)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        },
        {
          "name": "In Zoom",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the graph's zoom level\n@param NewValue\tZoom value, minimum is 1.0"
    },
    {
      "id": "set-offset",
      "name": "SetOffset",
      "category": "SGraphBar",
      "signature": "SetOffset(Target, In Offset)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        },
        {
          "name": "In Offset",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the graph's offset by which all graph bars should be moved\n@param NewValue\tOffset value"
    },
    {
      "id": "get-offset",
      "name": "GetOffset",
      "category": "SGraphBar",
      "signature": "GetOffset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the graph's offset value\n@return Offset value"
    },
    {
      "id": "get-events",
      "name": "GetEvents",
      "category": "SGraphBar",
      "signature": "GetEvents(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        }
      ],
      "returnType": "FVisualizerEventsArray&",
      "docs": "Gets all events this graph will draw\n@return List of all events to draw"
    }
  ]
}