      "name": "Tick",
      "category": "SGraphBar",
      "signature": "Tick(Target, Allotted Geometry, In Current Time, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "SGraphBar*"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
