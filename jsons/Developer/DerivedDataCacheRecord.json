      "id": "f-cache-record-builder",
      "name": "FCacheRecordBuilder",
      "category": "DerivedDataCacheRecord",
      "signature": "FCacheRecordBuilder(Key)",
      "params": [
        {
          "name": "Key",
          "type": "FCacheKey&"
        }
      ],
      "returnType": "public :",
      "docs": "A cache record builder is used to construct a cache record.\nCreate using a key that uniquely corresponds to the values for the cache record.\nThe metadata may vary between records with the same key.\n@see FCacheRecord"
    },
    {
      "id": "add-value-ebf9a0",
      "name": "AddValue",
      "category": "DerivedDataCacheRecord",
      "signature": "AddValue(Target, Id, Buffer, Block Size)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Id",
          "type": "FValueId&"
        },
        {
          "name": "Buffer",
          "type": "FCompositeBuffer&"
        },
        {
          "name": "Block Size",
          "type": "UInt64",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Add a value to the cache record.\n@param Id          An ID for the value that is unique within this cache record.\n@param Buffer      The value, which is compressed by the builder, and cloned if not owned.\n@param BlockSize   The power-of-two block size to encode raw data in. 0 is default."
    },
