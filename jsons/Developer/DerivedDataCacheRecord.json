    {
      "id": "get-meta",
      "name": "GetMeta",
      "category": "DerivedDataCacheRecord",
      "signature": "GetMeta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecord*"
        }
      ],
      "returnType": "FCbObject&",
      "docs": "Returns the metadata. Null when requested with ECachePolicy::SkipMeta."
    },
    {
      "id": "get-value",
      "name": "GetValue",
      "category": "DerivedDataCacheRecord",
      "signature": "GetValue(Target, Id)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecord*"
        },
        {
          "name": "Id",
          "type": "FValueId&"
        }
      ],
      "returnType": "FValueWithId&",
      "docs": "Returns the value matching the ID. Null if no match. Data is null if skipped."
    },
    {
      "id": "get-values",
      "name": "GetValues",
      "category": "DerivedDataCacheRecord",
      "signature": "GetValues(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecord*"
        }
      ],
      "returnType": "TConstArrayView<FValueWithId>",
      "docs": "Returns a view of the values ordered by ID. Data is null if skipped."
    },
    {
      "id": "save-beca23",
      "name": "Save",
      "category": "DerivedDataCacheRecord",
      "signature": "Save(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecord*"
        }
      ],
