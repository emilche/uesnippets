      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Meta",
          "type": "FCbObject&&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the metadata for the cache record.\n@param Meta   The metadata, which is cloned if not owned."
    },
    {
      "id": "add-value-ebf9a0",
      "name": "AddValue",
      "category": "DerivedDataCacheRecord",
      "signature": "AddValue(Target, Id, Buffer, Block Size)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Id",
          "type": "FValueId&"
        },
        {
          "name": "Buffer",
          "type": "FCompositeBuffer&"
        },
        {
          "name": "Block Size",
          "type": "UInt64",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Add a value to the cache record.\n@param Id          An ID for the value that is unique within this cache record.\n@param Buffer      The value, which is compressed by the builder, and cloned if not owned.\n@param BlockSize   The power-of-two block size to encode raw data in. 0 is default."
    },
    {
      "id": "add-value-7cd064",
      "name": "AddValue",
      "category": "DerivedDataCacheRecord",
      "signature": "AddValue(Target, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Value",
          "type": "FValueWithId&"
        }
      ],
      "returnType": "Void",
      "docs": "Add a value to the cache record.\n@note The ID for the value must be unique within this cache record."
    },
    {
      "id": "add-value-60fd71",
      "name": "AddValue",
      "category": "DerivedDataCacheRecord",
      "signature": "AddValue(Target, Id, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Id",
          "type": "FValueId&"
        },
        {
          "name": "Value",
          "type": "FValue&"
        }
      ],
      "returnType": "Void",
      "docs": "Add a value to the cache record.\n@param Id   An ID for the value that is unique within this cache record."
    },
    {
      "id": "build",
      "name": "Build",
      "category": "DerivedDataCacheRecord",
      "signature": "Build(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        }
      ],
      "returnType": "FCacheRecord",
      "docs": "Build a cache record, which makes this builder subsequently unusable.\nPrefer BuildAsync() when the values are added from raw buffers, which requires compressing\nthose buffers before constructing the cache record."
    },
    {
      "id": "build-async",
      "name": "BuildAsync",
      "category": "DerivedDataCacheRecord",
      "signature": "BuildAsync(Target, Owner, On Complete)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheRecordBuilder*"
        },
        {
          "name": "Owner",
          "type": "IRequestOwner&"
        },
        {
          "name": "On Complete",
          "type": "FOnCacheRecordComplete&&"
        }
      ],
      "returnType": "Void",
      "docs": "Build a cache record asynchronously, which makes this builder subsequently unusable.\nPrefer Build() when the values are added from compressed buffers as compression is already\ncomplete and BuildAsync() will complete immediately in that case."
    },
