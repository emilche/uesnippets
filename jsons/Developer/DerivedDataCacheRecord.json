          "type": "FCbPackage&"
        },
        {
          "name": "Writer",
          "type": "FCbWriter&"
        }
      ],
      "returnType": "Void",
      "docs": "Append the cache record to an existing package and writer for e.g. a batch of records."
    },
    {
      "id": "load-505840",
