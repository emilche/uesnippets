{
  "id": "spirv-reflect-common",
  "label": "SpirvReflectCommon",
  "includepath": "SpirvReflectCommon.h",
  "includes": [
    "Array",
    "Set",
    "CoreMinimal",
    "Platform",
    "spirv",
    "spirv_reflect"
  ],
  "functions": [
    {
      "id": "add-descriptor-binding",
      "name": "AddDescriptorBinding",
      "category": "SpirvReflectCommon",
      "signature": "AddDescriptorBinding(Target, In Binding)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirvReflectBindings*"
        },
        {
          "name": "In Binding",
          "type": "SpvReflectDescriptorBinding*"
        }
      ],
      "returnType": "Void",
      "docs": "Container structure for all SPIR-V reflection resources and in/out attributes."
    },
    {
      "id": "gather-descriptor-bindings",
      "name": "GatherDescriptorBindings",
      "category": "SpirvReflectCommon",
      "signature": "GatherDescriptorBindings(Target, Spirv Reflection)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirvReflectBindings*"
        },
        {
          "name": "Spirv Reflection",
          "type": "spv_reflect::ShaderModule&"
        }
      ],
      "returnType": "Void",
      "docs": "Gathers all descriptor bindings from the specified SPIRV-Reflect module."
    },
    {
      "id": "gather-input-attributes",
      "name": "GatherInputAttributes",
      "category": "SpirvReflectCommon",
      "signature": "GatherInputAttributes(Target, Spirv Reflection)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirvReflectBindings*"
        },
        {
          "name": "Spirv Reflection",
          "type": "spv_reflect::ShaderModule&"
        }
      ],
      "returnType": "Void",
      "docs": "Gathers all input interface variables from the specified SPIRV-Reflect module."
    },
    {
      "id": "gather-output-attributes",
      "name": "GatherOutputAttributes",
      "category": "SpirvReflectCommon",
      "signature": "GatherOutputAttributes(Target, Spirv Reflection)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirvReflectBindings*"
        },
        {
          "name": "Spirv Reflection",
          "type": "spv_reflect::ShaderModule&"
        }
      ],
      "returnType": "Void",
      "docs": "Gathers all output interface variables from the specified SPIRV-Reflect module."
    },
    {
      "id": "assign-input-attribute-locations-by-semantic-index",
      "name": "AssignInputAttributeLocationsBySemanticIndex",
      "category": "SpirvReflectCommon",
      "signature": "AssignInputAttributeLocationsBySemanticIndex(Target, Spirv Reflection, Semantic Name)",
      "params": [
        {
          "name": "Target",
          "type": "FSpirvReflectBindings*"
        },
        {
          "name": "Spirv Reflection",
          "type": "spv_reflect::ShaderModule&"
        },
        {
          "name": "Semantic Name",
          "type": "ANSICHAR*"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns the binding location for all input attributes by its semantic index if their name is equal to 'SemanticName'. Used for vertex shaders where all input attributes have the \"ATTRIBUTE\" semantic."
    }
  ]
}