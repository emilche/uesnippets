        },
        {
          "name": "Params",
          "type": "FHttpRequestParams&"
        }
      ],
      "returnType": "nodiscard ] ] THttpUniquePtr<IHttpRequest>",
      "docs": "Blocks until a request can be created on the underlying client."
    }
