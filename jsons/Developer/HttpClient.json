      "category": "HttpClient",
      "signature": "AddAcceptType(Target, Type, Weight)",
      "params": [
        {
          "name": "Target",
          "type": "IHttpRequest*"
        },
        {
          "name": "Type",
          "type": "EHttpMediaType"
        },
        {
          "name": "Weight",
          "type": "Float",
          "default": "1.0"
        }
      ],
      "returnType": "Void",
      "docs": "Add an Accept header with a known media type. Use AddHeader() for other types."
    },
    {
      "id": "get-header",
      "name": "GetHeader",
      "category": "HttpClient",
      "signature": "GetHeader(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "IHttpResponse*"
        },
        {
          "name": "Name",
          "type": "FAnsiStringView"
        }
      ],
      "returnType": "nodiscard ] ] FAnsiStringView",
      "docs": "Returns the value of the first header matching the name, or empty if there was no matching header."
    },
    {
      "id": "get-headers",
      "name": "GetHeaders",
      "category": "HttpClient",
      "signature": "GetHeaders(Target, Name, Out Values)",
      "params": [
        {
          "name": "Target",
          "type": "IHttpResponse*"
        },
        {
          "name": "Name",
          "type": "FAnsiStringView"
        },
        {
          "name": "Out Values",
          "type": "TArrayView<FAnsiStringView>"
        }
      ],
      "returnType": "nodiscard ] ] int32",
      "docs": "Fills the array of header values and returns the total number of headers matching the name.\nThe return value can be greater than the array size if there are more matching headers than the array can hold."
    },
    {
      "id": "get-content-type",
      "name": "GetContentType",
      "category": "HttpClient",
      "signature": "GetContentType(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IHttpResponse*"
        }
      ],
      "returnType": "nodiscard ] ] EHttpMediaType",
      "docs": "Returns the content type of the response, or Any if there was no matching header."
    },
    {
      "id": "get-content-length",
      "name": "GetContentLength",
      "category": "HttpClient",
      "signature": "GetContentLength(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IHttpResponse*"
        }
      ],
      "returnType": "nodiscard ] ] uint64",
      "docs": "Returns the content length of the response, or MAX_uint64 if there was no matching header."
    },
    {
      "id": "on-body",
      "name": "OnBody",
      "category": "HttpClient",
      "signature": "OnBody(Target, Response, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FHttpByteArrayReceiver*"
        },
        {
          "name": "Response",
          "type": "IHttpResponse&"
        },
        {
          "name": "Data",
          "type": "FMemoryView&"
        }
      ],
      "returnType": "IHttpReceiver*",
      "docs": "Invoked when a part of the body has been received.\nThe Data parameter can be reassigned to point to the tail of the view that is not consumed\nby this receiver, and will be passed to the receiver that is returned.\nReturns the receiver to use for the next part of the response and can return itself."
    },
