{
  "id": "static-mesh-builder",
  "label": "StaticMeshBuilder",
  "includepath": "StaticMeshBuilder.h",
  "includes": [
    "CoreMinimal",
    "MeshBuilder"
  ],
  "functions": [
    {
      "id": "build",
      "name": "Build",
      "category": "StaticMeshBuilder",
      "signature": "Build(Target, Out Render Data, Skeletal Mesh Build Parameters)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshBuilder*"
        },
        {
          "name": "Out Render Data",
          "type": "FSkeletalMeshRenderData&"
        },
        {
          "name": "Skeletal Mesh Build Parameters",
          "type": "FSkeletalMeshBuildParameters&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "build-vertex-buffer",
      "name": "BuildVertexBuffer",
      "category": "StaticMeshBuilder",
      "signature": "BuildVertexBuffer(Static Mesh, Mesh Description, Build Settings, Out Wedge Map, Out Sections, Out Per Section Indices, Build Vertex Data, Overlapping Corners, Remap Verts, Mesh Bounds, Need Tangents, Need Wedge Map)",
      "params": [
        {
          "name": "Static Mesh",
          "type": "UStaticMesh*"
        },
        {
          "name": "Mesh Description",
          "type": "FMeshDescription&"
        },
        {
          "name": "Build Settings",
          "type": "FMeshBuildSettings&"
        },
        {
          "name": "Out Wedge Map",
          "type": "TArray<int32>&"
        },
        {
          "name": "Out Sections",
          "type": "FStaticMeshSectionArray&"
        },
        {
          "name": "Out Per Section Indices",
          "type": "TArray<TArray<uint32>>&"
        },
        {
          "name": "Build Vertex Data",
          "type": "FMeshBuildVertexData&"
        },
        {
          "name": "Overlapping Corners",
          "type": "FOverlappingCorners&"
        },
        {
          "name": "Remap Verts",
          "type": "TArray<int32>&"
        },
        {
          "name": "Mesh Bounds",
          "type": "FBoxSphereBounds&"
        },
        {
          "name": "Need Tangents",
          "type": "Bool"
        },
        {
          "name": "Need Wedge Map",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Used to refresh all components in the scene that may be using a mesh we're editing"
    },
    {
      "id": "build-combined-section-indices",
      "name": "BuildCombinedSectionIndices",
      "category": "StaticMeshBuilder",
      "signature": "BuildCombinedSectionIndices(Per Section Indices, Sections Out, Combined Indices Out, Needs 32 Bit Indices Out)",
      "params": [
        {
          "name": "Per Section Indices",
          "type": "TArray<TArray<uint32>>&"
        },
        {
          "name": "Sections Out",
          "type": "FStaticMeshSectionArray&"
        },
        {
          "name": "Combined Indices Out",
          "type": "TArray<uint32>&"
        },
        {
          "name": "Needs 32 Bit Indices Out",
          "type": "Bool&"
        }
      ],
      "returnType": "Void"
    }
  ]
}