      "name": "ParseCrashDump",
      "category": "CrashDebugHelper",
      "signature": "ParseCrashDump(Target, In Crash Dump Name, Out Crash Debug Info)",
      "params": [
        {
          "name": "Target",
          "type": "ICrashDebugHelper*"
        },
        {
          "name": "In Crash Dump Name",
          "type": "String&"
        },
        {
          "name": "Out Crash Debug Info",
          "type": "FCrashDebugInfo&"
        }
      ],
      "returnType": "Bool",
      "docs": "Parse the given crash dump, determining EngineVersion of the build that produced it - if possible.\n@param\tInCrashDumpName\t\tThe crash dump file to process\n@param\tOutCrashDebugInfo\tThe crash dump info extracted from the file\n@return\tbool\t\t\t\ttrue if successful, false if not\nOnly used by Mac, to be removed."
    },
