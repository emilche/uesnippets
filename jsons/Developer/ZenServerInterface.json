    {
      "id": "f-scope-zen-service-74218f",
      "name": "FScopeZenService",
      "category": "ZenServerInterface",
      "signature": "FScopeZenService()",
      "params": [],
      "returnType": "public :",
      "docs": "Type used to declare usage of a Zen server instance whether the shared default instance or a unique non-default instance.\nUsed to help manage launch, and optionally in the future, shutdown a shared default instance.  Use the default constructor\nto reference the default instance (which may be launched on demand), or use the non-default constructors with a specific\nURL or HostName/Port pair which is required to pre-exist (will not be auto-launched)."
    },
    {
      "id": "f-scope-zen-service-c0113b",
      "name": "FScopeZenService",
