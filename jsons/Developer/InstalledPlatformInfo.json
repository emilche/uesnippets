    {
      "id": "is-valid",
      "name": "IsValid",
      "category": "InstalledPlatformInfo",
      "signature": "IsValid(Target, Target Type, Platform, Configuration, Project Type, State)",
      "params": [
        {
          "name": "Target",
          "type": "FInstalledPlatformInfo*"
        },
        {
          "name": "Target Type",
          "type": "TOptional<EBuildTargetType>"
        },
        {
          "name": "Platform",
          "type": "TOptional<FString>"
        },
        {
          "name": "Configuration",
          "type": "TOptional<EBuildConfiguration>"
        },
        {
          "name": "Project Type",
          "type": "EProjectType"
        },
        {
          "name": "State",
          "type": "EInstalledPlatformState"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines whether the given target type is supported\n@param TargetType The target type being built\n@param Platform The platform being built\n@param Configuration The configuration being built\n@param ProjectType The project type required\n@param State State of the given platform support\n@return True if the target can be built"
    },
    {
      "id": "is-valid-platform-architecture",
      "name": "IsValidPlatformArchitecture",
      "category": "InstalledPlatformInfo",
      "signature": "IsValidPlatformArchitecture(Target, Platform Name, Architecture)",
      "params": [
        {
          "name": "Target",
          "type": "FInstalledPlatformInfo*"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        },
        {
          "name": "Architecture",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Queries whether a platform architecture is valid for any configuration\n@param PlatformName Name of the platform's binary folder (eg. Win64, Android)\n@param Architecture Either a full architecture name or a partial substring for CPU/GPU combinations (eg. \"-armv7\", \"-es2\")"
    },
    {
