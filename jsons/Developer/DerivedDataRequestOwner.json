  "functions": [
    {
      "id": "launch-task",
      "name": "LaunchTask",
      "category": "DerivedDataRequestOwner",
      "signature": "LaunchTask(Target, Debug Name, Task Body)",
      "params": [
        {
          "name": "Target",
          "type": "IRequestOwner*"
        },
        {
          "name": "Debug Name",
          "type": "TCHAR*"
        },
        {
          "name": "Task Body",
          "type": "TUniqueFunction<void ( )>&&"
        }
      ],
      "returnType": "Void",
      "docs": "Launches a task that executes the task body when scheduled.\nThe task inherits the current priority of this request owner.\nThe task is launched as a new request within this request owner.\n@note The debug name is not copied and must remain valid for the duration of the task."
    },
    {
      "id": "f-request-owner",
      "name": "FRequestOwner",
      "category": "DerivedDataRequestOwner",
      "signature": "FRequestOwner(Priority)",
      "params": [
        {
          "name": "Priority",
          "type": "EPriority"
        }
      ],
      "returnType": "public :",
      "docs": "A concrete request owner that also presents as a request.\nRequest owners may be moved but not copied, and cancel any outstanding requests on destruction\nunless KeepAlive has been called.\n@see IRequestOwner"
    },
    {
      "id": "keep-alive",
      "name": "KeepAlive",
      "category": "DerivedDataRequestOwner",
      "signature": "KeepAlive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRequestOwner*"
        }
      ],
      "returnType": "Void",
      "docs": "Keep requests in the owner alive until complete, even after destruction of the owner."
    },
    {
      "id": "get-priority",
      "name": "GetPriority",
      "category": "DerivedDataRequestOwner",
      "signature": "GetPriority(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRequestOwner*"
        }
      ],
      "returnType": "EPriority",
      "docs": "Returns the priority that new requests are expected to inherit."
    },
    {
