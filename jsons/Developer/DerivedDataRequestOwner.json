        },
        {
          "name": "Priority",
          "type": "EPriority"
        }
      ],
      "returnType": "Void",
      "docs": "Set the priority of active and future requests in the owner."
    },
    {
      "id": "cancel",
      "name": "Cancel",
      "category": "DerivedDataRequestOwner",
      "signature": "Cancel(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRequestOwner*"
        }
      ],
      "returnType": "Void",
      "docs": "Cancel any active and future requests in the owner."
    },
    {
      "id": "wait",
      "name": "Wait",
      "category": "DerivedDataRequestOwner",
      "signature": "Wait(Target)",
      "params": [
