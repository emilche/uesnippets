    {
      "id": "f-request-barrier-7229fa",
      "name": "FRequestBarrier",
      "category": "DerivedDataRequestOwner",
      "signature": "FRequestBarrier(Owner, Flags)",
      "params": [
        {
          "name": "Owner",
          "type": "IRequestOwner&"
        },
        {
          "name": "Flags",
          "type": "ERequestBarrierFlags",
          "default": "ERequestBarrierFlags::None"
        }
      ],
      "returnType": "public :",
      "docs": "A request barrier is expected to be used when an owner may have new requests added to it.\nAn owner may not consider its execution to be complete in the presence of a barrier, and needs\nto take note of priority changes that occur while within a barrier, since newly-added requests\nmay have been created with the previous priority value."
    },
