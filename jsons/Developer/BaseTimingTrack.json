    {
      "id": "init-tooltip",
      "name": "InitTooltip",
      "category": "BaseTimingTrack",
      "signature": "InitTooltip(In Out Tooltip, In Tooltip Event)",
      "params": [
        {
          "name": "In Out Tooltip",
          "type": "FTooltipDrawState&"
        },
        {
          "name": "In Tooltip Event",
          "type": "ITimingEvent&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to initialize the tooltip's content with info from a timing event.\n@note In most cases, this should begin by calling `InOutTooltip.ResetContent()` before adding\nany content to the tooltip. However, in case the track may be used as a child track,\nthe tooltip content should not be reset, and instead should only be appended to\n(because the parent track will reset the tooltip's content.)\nThis is because other child tracks may want to append to the tooltip's content,\nand their appended content should not be reset."
    },
