    {
      "id": "get-event",
      "name": "GetEvent",
      "category": "BaseTimingTrack",
      "signature": "GetEvent(In Pos X, In Pos Y, Viewport)",
      "params": [
        {
          "name": "In Pos X",
          "type": "Float"
        },
        {
          "name": "In Pos Y",
          "type": "Float"
        },
        {
          "name": "Viewport",
          "type": "FTimingTrackViewport&"
        }
      ],
      "returnType": "TSharedPtr<ITimingEvent>",
      "docs": "Gets the event at a specified position. Leaves the InOutEvent unchanged if no event is found at specified position.\n@param X The horizontal coordinate of the point tested; in Slate pixels (viewport coordinates).\n@param Y The vertical coordinate of the point tested; in Slate pixels (viewport coordinates).\n@param Viewport The timing viewport used to transform time in viewport coordinates.\n@return The event located at (PosX, PosY) coordinates, if any; nullptr otherwise."
    },
