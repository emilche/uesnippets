    {
      "id": "set-category-button-label-visibility-375a80",
      "name": "SetCategoryButtonLabelVisibility",
      "category": "CategoryDrivenContentBuilderBase",
      "signature": "SetCategoryButtonLabelVisibility(Target, Visibility)",
      "params": [
        {
          "name": "Target",
          "type": "FCategoryDrivenContentBuilderBase*"
        },
        {
          "name": "Visibility",
          "type": "EVisibility"
        }
      ],
      "returnType": "Void",
      "docs": "Sets category button label visibility to Visibility. It also reinitializes the\ncategory toolbar data, as the toolbar's LabelVisibility member is now stale.\n@param Visibility If Visibility == EVisibility::Collapsed, the category button labels\nwill be shown, else they will not be shown."
    },
    {
      "id": "set-category-button-label-visibility-541ade",
      "name": "SetCategoryButtonLabelVisibility",
      "category": "CategoryDrivenContentBuilderBase",
      "signature": "SetCategoryButtonLabelVisibility(Target, Is Category Button Label Visible)",
      "params": [
        {
          "name": "Target",
          "type": "FCategoryDrivenContentBuilderBase*"
        },
        {
          "name": "Is Category Button Label Visible",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets category button label visibility to Visibility. It also reinitializes the\ncategory toolbar data, as the toolbar's LabelVisibility member is now stale.\n@param bIsCategoryButtonLabelVisible If bIsCategoryButtonLabelVisible == true,\nthe category button labels will be shown, else they will not be shown."
