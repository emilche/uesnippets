      "id": "deserialize-archive",
      "name": "DeserializeArchive",
      "category": "JsonInternationalizationArchiveSerializer",
      "signature": "DeserializeArchive(In Json Obj, In Archive, In Manifest, In Native Archive)",
      "params": [
        {
          "name": "In Json Obj",
          "type": "TSharedRef<FJsonObject>"
        },
        {
          "name": "In Archive",
          "type": "TSharedRef<FInternationalizationArchive>"
        },
        {
          "name": "In Manifest",
          "type": "TSharedPtr<FInternationalizationManifest>"
        },
        {
          "name": "In Native Archive",
          "type": "TSharedPtr<FInternationalizationArchive>"
        }
      ],
      "returnType": "Bool",
      "docs": "Deserializes an archive from a JSON object.\n@param InJsonObj\t\t\tThe JSON object to serialize from.\n@param InArchive\t\t\tThe archive to populate from the JSON data.\n@param InManifest\t\tThe manifest associated with the archive. May be null, but you won't be able to load archives with a version < FInternationalizationArchive::EFormatVersion::AddedKeys.\n@param InNativeArchive\tThe native archive associated with the archive. May be null.\n@return true if deserialization was successful, false otherwise."
    },
    {
      "id": "deserialize-archive-from-file",
      "name": "DeserializeArchiveFromFile",
      "category": "JsonInternationalizationArchiveSerializer",
      "signature": "DeserializeArchiveFromFile(In Json File, In Archive, In Manifest, In Native Archive)",
      "params": [
        {
          "name": "In Json File",
          "type": "String&"
        },
        {
          "name": "In Archive",
          "type": "TSharedRef<FInternationalizationArchive>"
        },
        {
          "name": "In Manifest",
          "type": "TSharedPtr<FInternationalizationManifest>"
        },
        {
          "name": "In Native Archive",
          "type": "TSharedPtr<FInternationalizationArchive>"
        }
      ],
      "returnType": "Bool",
      "docs": "Deserializes an archive from a JSON file.\n@param InJsonFile\t\tThe path to the JSON file to serialize from.\n@param InArchive\t\t\tThe archive to populate from the JSON data.\n@param InManifest\t\tThe manifest associated with the archive. May be null, but you won't be able to load archives with a version < FInternationalizationArchive::EFormatVersion::AddedKeys.\n@param InNativeArchive\tThe native archive associated with the archive. May be null.\n@return true if deserialization was successful, false otherwise."
    },
