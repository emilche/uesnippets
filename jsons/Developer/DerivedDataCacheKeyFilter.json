{
  "id": "derived-data-cache-key-filter",
  "label": "DerivedDataCacheKeyFilter",
  "includepath": "DerivedDataCacheKeyFilter.h",
  "includes": [
    "CoreTypes",
    "PimplPtr"
  ],
  "functions": [
    {
      "id": "set-salt",
      "name": "SetSalt",
      "category": "DerivedDataCacheKeyFilter",
      "signature": "SetSalt(Target, Salt)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheKeyFilter*"
        },
        {
          "name": "Salt",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Accesses the salt that is combined with the cache key for filtering.\nThe filter will always produce the same output for a fixed pair of salt and key. To change\nthe behavior of the filter between sessions, the salt is assigned randomly by default."
    },
    {
      "id": "get-salt",
      "name": "GetSalt",
      "category": "DerivedDataCacheKeyFilter",
      "signature": "GetSalt(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheKeyFilter*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "is-match",
      "name": "IsMatch",
      "category": "DerivedDataCacheKeyFilter",
      "signature": "IsMatch(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "FCacheKeyFilter*"
        },
        {
          "name": "Key",
          "type": "FCacheKey&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the filter matches the key. The output is the same until the salt changes."
    }
  ]
}