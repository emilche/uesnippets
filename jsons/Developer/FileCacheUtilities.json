{
  "id": "file-cache-utilities",
  "label": "FileCacheUtilities",
  "includepath": "FileCacheUtilities.h",
  "includes": [
    "Array",
    "EnumAsByte",
    "UnrealString",
    "CoreMinimal",
    "Platform",
    "PlatformTime",
    "Optional",
    "Archive",
    "SharedPointer",
    "UnrealTemplate"
  ],
  "functions": [
    {
      "id": "add-wildcard-rule",
      "name": "AddWildcardRule",
      "category": "FileCacheUtilities",
      "signature": "AddWildcardRule(Target, Wildcard String, Include)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchRules*"
        },
        {
          "name": "Wildcard String",
          "type": "FWildcardString&"
        },
        {
          "name": "Include",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Specify a wildcard match to include or exclude"
    },
    {
      "id": "set-applicable-extensions",
      "name": "SetApplicableExtensions",
      "category": "FileCacheUtilities",
      "signature": "SetApplicableExtensions(Target, In Extensions)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchRules*"
        },
        {
          "name": "In Extensions",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Specify a set of applicable extensions, ; separated. Provided as an optimization to early-out on files we're not interested in."
    },
    {
      "id": "is-file-applicable",
      "name": "IsFileApplicable",
      "category": "FileCacheUtilities",
      "signature": "IsFileApplicable(Target, Filename)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchRules*"
        },
        {
          "name": "Filename",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Bool",
      "docs": "Test to see if a file is applicable based on this rule. Returns true if so, false of not, or empty if the file doesn't match this rule."
    }
  ]
}