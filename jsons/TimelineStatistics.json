s . MaxExclusiveTime,FrameStats . TotalExclusiveTime ) ; if ( bComputeMedian ) { GlobalResultIterator -> Value . FrameInclusiveTimes [ FrameIndex ] = FrameStats . TotalInclusiveTime ; GlobalResultIterator -> Value . FrameExclusiveTimes [ FrameIndex ] = FrameStats . TotalExclusiveTime ; } FrameStats = FAggregatedTimingStats ( ) ; + + FrameResultIterator ; + + TaskResultIterator ; + + GlobalResultIterator ; } } FrameResultsQueue . Enqueue ( MoveTemp ("
