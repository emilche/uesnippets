    {
      "id": "path",
      "name": "path",
      "category": "vertexEdit",
      "signature": "path(Target, Edit)",
      "params": [
        {
          "name": "Target",
          "type": "T*"
        },
        {
          "name": "Edit",
          "type": "\"<<path . faceid<<' ' ; for ( int i = 0 ; i<path . nsubfaces ; + + i ) { out<<static_cast<int> ( path . subfaces [ i ] )<<' ' ; } return out<<static_cast<int> ( path . vertexid )<<\" ),edit = ( \"<<path . edit [ 0 ]<<','<<path . edit [ 1 ]<<','<<path ."
        }
      ],
      "returnType": "out<<\" vertex"
    },
