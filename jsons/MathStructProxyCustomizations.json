    {
      "id": "f-matrix-struct-customization",
      "name": "FMatrixStructCustomization",
      "category": "MathStructProxyCustomizations",
      "signature": "FMatrixStructCustomization(Zero Rotator, Yaw, Pitch, Roll, Zero Vector, X, Y, Z, Zero Vector, X, Y, Z, False)",
      "params": [
        {
          "name": "Zero Rotator",
          "type": ") : CachedRotation ( MakeShareable ( new TProxyValue<UE::Math::TRotator<T>> ( UE::Math::TRotator<T>::"
        },
        {
          "name": "Yaw",
          "type": "CachedRotationYaw ( MakeShareable ( new TProxyProperty<UE::Math::TRotator<T>,T> ( CachedRotation,CachedRotation -> Get ( ) ."
        },
        {
          "name": "Pitch",
          "type": "CachedRotationPitch ( MakeShareable ( new TProxyProperty<UE::Math::TRotator<T>,T> ( CachedRotation,CachedRotation -> Get ( ) ."
        },
        {
          "name": "Roll",
          "type": "CachedRotationRoll ( MakeShareable ( new TProxyProperty<UE::Math::TRotator<T>,T> ( CachedRotation,CachedRotation -> Get ( ) ."
        },
        {
          "name": "Zero Vector",
          "type": "CachedTranslation ( MakeShareable ( new TProxyValue<UE::Math::TVector<T>> ( UE::Math::TVector<T>::"
        },
        {
          "name": "X",
          "type": "CachedTranslationX ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedTranslation,CachedTranslation -> Get ( ) ."
        },
        {
          "name": "Y",
          "type": "CachedTranslationY ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedTranslation,CachedTranslation -> Get ( ) ."
        },
        {
          "name": "Z",
          "type": "CachedTranslationZ ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedTranslation,CachedTranslation -> Get ( ) ."
        },
        {
          "name": "Zero Vector",
          "type": "CachedScale ( MakeShareable ( new TProxyValue<UE::Math::TVector<T>> ( UE::Math::TVector<T>::"
        },
        {
          "name": "X",
          "type": "CachedScaleX ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedScale,CachedScale -> Get ( ) ."
        },
        {
          "name": "Y",
          "type": "CachedScaleY ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedScale,CachedScale -> Get ( ) ."
        },
        {
          "name": "Z",
          "type": "CachedScaleZ ( MakeShareable ( new TProxyProperty<UE::Math::TVector<T>,T> ( CachedScale,CachedScale -> Get ( ) ."
        },
        {
          "name": "False",
          "type": "bUseLeftUpForwardAxisDisplayCoordinateSystem ("
        }
      ],
      "returnType": "public :"
    },
