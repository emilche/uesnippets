      "params": [
        {
          "name": "Target",
          "type": "FDatasmithUtils*"
        },
        {
          "name": "X",
          "type": "- 2* Normal . Z* Normal ."
        },
        {
          "name": "Y",
          "type": "- 2* Normal . Z* Normal ."
        },
        {
          "name": "Normal X Sqr",
          "type": "- NormalZSqr + NormalYSqr +"
        }
      ],
      "returnType": "TVector<Type>"
    },
