      "params": [
        {
          "name": "Target",
          "type": "FDatasmithUtils*"
        },
        {
          "name": "X",
          "type": "- 2* Normal . Y* Normal ."
        },
        {
          "name": "Normal Z Sqr",
          "type": "- NormalYSqr + NormalXSqr +"
        },
        {
          "name": "Z",
          "type": "- 2* Normal . Y* Normal ."
        }
      ],
      "returnType": "TVector<Type>"
    },
    {
      "id": "axis-2",
      "name": "Axis2",
      "category": "DatasmithUtils",
