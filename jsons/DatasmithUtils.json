      "id": "axis-0",
      "name": "Axis0",
      "category": "DatasmithUtils",
      "signature": "Axis0(Target, Normal Y Sqr, Y, Z)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithUtils*"
        },
        {
          "name": "Normal Y Sqr",
          "type": "- NormalXSqr + NormalZSqr +"
        },
        {
          "name": "Y",
          "type": "- 2* Normal . X* Normal ."
        },
        {
          "name": "Z",
          "type": "- 2* Normal . X* Normal ."
        }
      ],
      "returnType": "TVector<Type>"
    },
    {
      "id": "axis-1",
      "name": "Axis1",
      "category": "DatasmithUtils",
