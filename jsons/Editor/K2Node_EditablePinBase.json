    {
      "id": "can-create-user-defined-pin",
      "name": "CanCreateUserDefinedPin",
      "category": "K2Node_EditablePinBase",
      "signature": "CanCreateUserDefinedPin(Target, In Pin Type, In Desired Direction, Out Error Message)",
      "params": [
        {
          "name": "Target",
          "type": "UK2Node_EditablePinBase*"
        },
        {
          "name": "In Pin Type",
          "type": "FEdGraphPinType&"
        },
        {
          "name": "In Desired Direction",
          "type": "EEdGraphPinDirection"
        },
        {
          "name": "Out Error Message",
          "type": "Text&"
        }
      ],
      "returnType": "Bool",
      "docs": "Queries if a user defined pin of the passed type can be constructed on this node. Node will return false by default and must opt into this functionality\n@param\t\t\tInPinType\t\t\tThe type info for the pin to create\n@param\t\t\tOutErrorMessage\t\tOnly filled with an error if there is pin add support but there is an error with the pin type\n@return\t\t\tTRUE if a user defined pin can be constructed"
    },
    {
      "id": "create-user-defined-pin",
      "name": "CreateUserDefinedPin",
      "category": "K2Node_EditablePinBase",
      "signature": "CreateUserDefinedPin(Target, In Pin Name, In Pin Type, In Desired Direction, Use Unique Name)",
      "params": [
        {
          "name": "Target",
          "type": "UK2Node_EditablePinBase*"
        },
        {
          "name": "In Pin Name",
          "type": "Name"
        },
        {
          "name": "In Pin Type",
          "type": "FEdGraphPinType&"
        },
        {
          "name": "In Desired Direction",
          "type": "EEdGraphPinDirection"
        },
        {
          "name": "Use Unique Name",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "UEdGraphPin*",
      "docs": "Creates a UserPinInfo from the specified information, and also adds a pin based on that description to the node\n@param\tInPinName\t\t\t\tName of the pin to create\n@param\tInPinType\t\t\t\tThe type info for the pin to create\n@param\tInDesiredDirection\t\tDesired direction of the pin, will auto-correct if the direction is not allowed on the pin."
    },
