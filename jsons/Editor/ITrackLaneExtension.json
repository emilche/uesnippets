{
  "id": "i-track-lane-extension",
  "label": "ITrackLaneExtension",
  "includepath": "MVVM/Extensions/ITrackLaneExtension.h",
  "includes": [
    "Platform",
    "ViewModelTypeID",
    "Range",
    "FrameNumber",
    "Optional",
    "SharedPointer",
    "SlateEnums"
  ],
  "functions": [
    {
      "id": "is-visible",
      "name": "IsVisible",
      "category": "ITrackLaneExtension",
      "signature": "IsVisible(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTrackLaneVirtualAlignment*"
        }
      ],
      "returnType": "Bool",
      "supportedTargets": [
        "FTrackLaneVirtualAlignment*",
        "FTrackLaneScreenAlignment*"
      ]
    },
    {
      "id": "fixed",
      "name": "Fixed",
      "category": "ITrackLaneExtension",
      "signature": "Fixed(In Range, In Fixed Height, In V Align, In View Space ID)",
      "params": [
        {
          "name": "In Range",
          "type": "TRange<FFrameNumber>&"
        },
        {
          "name": "In Fixed Height",
          "type": "Float"
        },
        {
          "name": "In V Align",
          "type": "EVerticalAlignment",
          "default": "VAlign_Center"
        },
        {
          "name": "In View Space ID",
          "type": "FGuid&",
          "default": "FGuid()"
        }
      ],
      "returnType": "FTrackLaneVirtualAlignment"
    },
    {
      "id": "proportional",
      "name": "Proportional",
      "category": "ITrackLaneExtension",
      "signature": "Proportional(In Range, In Stretch Factor, In V Align, In View Space ID)",
      "params": [
        {
          "name": "In Range",
          "type": "TRange<FFrameNumber>&"
        },
        {
          "name": "In Stretch Factor",
          "type": "Float"
        },
        {
          "name": "In V Align",
          "type": "EVerticalAlignment",
          "default": "VAlign_Center"
        },
        {
          "name": "In View Space ID",
          "type": "FGuid&",
          "default": "FGuid()"
        }
      ],
      "returnType": "FTrackLaneVirtualAlignment"
    },
    {
      "id": "as-widget",
      "name": "AsWidget",
      "category": "ITrackLaneExtension",
      "signature": "AsWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Base interface for track-area lanes"
    },
    {
      "id": "get-alignment",
      "name": "GetAlignment",
      "category": "ITrackLaneExtension",
      "signature": "GetAlignment(Target, Time To Pixel, In Parent Geometry)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        },
        {
          "name": "Time To Pixel",
          "type": "FTimeToPixel&"
        },
        {
          "name": "In Parent Geometry",
          "type": "FGeometry&"
        }
      ],
      "returnType": "FTrackLaneScreenAlignment",
      "docs": "Arrange this widget within its parent slot"
    },
    {
      "id": "get-overlap-priority",
      "name": "GetOverlapPriority",
      "category": "ITrackLaneExtension",
      "signature": "GetOverlapPriority(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        }
      ],
      "returnType": "Int",
      "docs": "Gets this widget's overlap priority"
    },
    {
      "id": "report-parent-geometry",
      "name": "ReportParentGeometry",
      "category": "ITrackLaneExtension",
      "signature": "ReportParentGeometry(Target, In Desktop Space Parent Geometry)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        },
        {
          "name": "In Desktop Space Parent Geometry",
          "type": "FGeometry&"
        }
      ],
      "returnType": "Void",
      "docs": "Receive parent geometry for this lane in Desktop space"
    },
    {
      "id": "accepts-children",
      "name": "AcceptsChildren",
      "category": "ITrackLaneExtension",
      "signature": "AcceptsChildren(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether this track lane accepts child widgets"
    },
    {
      "id": "add-child-view",
      "name": "AddChildView",
      "category": "ITrackLaneExtension",
      "signature": "AddChildView(Target, Child Widget, In Weak Owning Lane)",
      "params": [
        {
          "name": "Target",
          "type": "ITrackLaneWidget*"
        },
        {
          "name": "Child Widget",
          "type": "TSharedPtr<ITrackLaneWidget>"
        },
        {
          "name": "In Weak Owning Lane",
          "type": "TWeakPtr<STrackLane>"
        }
      ],
      "returnType": "Void",
      "docs": "Add a new child to this lane"
    }
  ]
}