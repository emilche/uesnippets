{
  "id": "anim-preview-instance",
  "label": "AnimPreviewInstance",
  "includepath": "AnimPreviewInstance.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "BonePose",
    "AnimNode_ModifyBone",
    "AnimSingleNodeInstance",
    "AnimSingleNodeInstanceProxy",
    "AnimNode_CurveSource",
    "AnimNode_PoseBlendNode",
    "AnimNode_CopyPoseFromMesh",
    "AnimPreviewInstance.generated"
  ],
  "functions": [
    {
      "id": "enable-controllers",
      "name": "EnableControllers",
      "category": "AnimPreviewInstance",
      "signature": "EnableControllers(Target, Enable)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        },
        {
          "name": "Enable",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enable Controllers\nThis is used by when editing, when controller has to be disabled"
    },
    {
      "id": "set-skeletal-control-alpha",
      "name": "SetSkeletalControlAlpha",
      "category": "AnimPreviewInstance",
      "signature": "SetSkeletalControlAlpha(Target, In Skeletal Control Alpha)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        },
        {
          "name": "In Skeletal Control Alpha",
          "type": "Float"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-key",
      "name": "SetKey",
      "category": "AnimPreviewInstance",
      "signature": "SetKey(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Convert current modified bone transforms (BoneControllers) to transform curves (CurveControllers)\nit does based on CurrentTime. This function does not set key directly here.\nIt does wait until next update, and it gets the delta of transform before applying curves, and\ncreates curves from it, so you'll need delegate if you'd like to do something after (set with SetKeyCompleteDelegate)"
    },
    {
      "id": "add-key-complete-delegate",
      "name": "AddKeyCompleteDelegate",
      "category": "AnimPreviewInstance",
      "signature": "AddKeyCompleteDelegate(Target, In On Set Key Complete Delegate)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        },
        {
          "name": "In On Set Key Complete Delegate",
          "type": "FSimpleMulticastDelegate::FDelegate"
        }
      ],
      "returnType": "FDelegateHandle",
      "docs": "Add the delegate to be called when a key is set.\n@param Delegate To be called once set key is completed"
    },
    {
      "id": "remove-key-complete-delegate",
      "name": "RemoveKeyCompleteDelegate",
      "category": "AnimPreviewInstance",
      "signature": "RemoveKeyCompleteDelegate(Target, In Delegate Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        },
        {
          "name": "In Delegate Handle",
          "type": "FDelegateHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Add the delegate to be called when a key is set.\n@param Delegate To be called once set key is completed"
    },
    {
      "id": "get-bone-controllers",
      "name": "GetBoneControllers",
      "category": "AnimPreviewInstance",
      "signature": "GetBoneControllers(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        }
      ],
      "returnType": "TArray<FAnimNode_ModifyBone>&",
      "docs": "Returns all currently active bone controllers on this instance's proxy"
    },
    {
      "id": "get-curve-bone-controllers",
      "name": "GetCurveBoneControllers",
      "category": "AnimPreviewInstance",
      "signature": "GetCurveBoneControllers(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        }
      ],
      "returnType": "TArray<FAnimNode_ModifyBone>&"
    },
    {
      "id": "add-impulse-at-location",
      "name": "AddImpulseAtLocation",
      "category": "AnimPreviewInstance",
      "signature": "AddImpulseAtLocation(Target, Impulse, Location, Bone Name)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimPreviewInstanceProxy*"
        },
        {
          "name": "Impulse",
          "type": "FVector"
        },
        {
          "name": "Location",
          "type": "FVector"
        },
        {
          "name": "Bone Name",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Preview physics interaction"
    },
    {
      "id": "is-playing-montage",
      "name": "IsPlayingMontage",
      "category": "AnimPreviewInstance",
      "signature": "IsPlayingMontage(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimPreviewInstance*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}