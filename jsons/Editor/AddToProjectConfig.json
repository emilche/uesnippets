{
  "id": "add-to-project-config",
  "label": "AddToProjectConfig",
  "includepath": "AddToProjectConfig.h",
  "includes": [
    "CoreMinimal",
    "Object",
    "Interface"
  ],
  "functions": [
    {
      "id": "is-set",
      "name": "IsSet",
      "category": "AddToProjectConfig",
      "signature": "IsSet(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNewClassInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check to see if this struct is set to something that could be used to create a new class"
    },
    {
      "id": "parent-class",
      "name": "ParentClass",
      "category": "AddToProjectConfig",
      "signature": "ParentClass(Target, In Class)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Class",
          "type": "UClass*"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Force the add to project dialog to use the specified parent class. Skips the first step (choose a parent class) as a result."
    },
    {
      "id": "allowable-parents",
      "name": "AllowableParents",
      "category": "AddToProjectConfig",
      "signature": "AllowableParents(Target, In)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In",
          "type": "TSharedPtr<IClassViewerFilter>&"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Limits the allowable parent classes by the specified filter."
    },
    {
      "id": "initial-path",
      "name": "InitialPath",
      "category": "AddToProjectConfig",
      "signature": "InitialPath(Target, In Initial Path)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Initial Path",
          "type": "String"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "The initial path we should use as the destination for the new file, or an empty string to choose a suitable default based upon the module path."
    },
    {
      "id": "default-class-name",
      "name": "DefaultClassName",
      "category": "AddToProjectConfig",
      "signature": "DefaultClassName(Target, In Default Class Name)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Default Class Name",
          "type": "String"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Optional argument that specifies the default name for the new class being added.  The user will be able to type their own name if they don't like this name.  If empty, defaults to the name of the inherited class."
    },
    {
      "id": "default-class-prefix",
      "name": "DefaultClassPrefix",
      "category": "AddToProjectConfig",
      "signature": "DefaultClassPrefix(Target, In Default Class Prefix)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Default Class Prefix",
          "type": "String"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Optional argument that specifies the prefix for the new class name.  The user will be able to type their own name if they don't like this name.  Defaults to \"My\" if not specified or empty."
    },
    {
      "id": "window-title",
      "name": "WindowTitle",
      "category": "AddToProjectConfig",
      "signature": "WindowTitle(Target, In Text)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Text",
          "type": "Text"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "The title text to display on the window"
    },
    {
      "id": "parent-window",
      "name": "ParentWindow",
      "category": "AddToProjectConfig",
      "signature": "ParentWindow(Target, In Parent Window)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Parent Window",
          "type": "TSharedPtr<SWindow>&"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "The parent window the dialog should use, or null to choose a suitable default parent window (the main frame, if available)."
    },
    {
      "id": "modal",
      "name": "Modal",
      "category": "AddToProjectConfig",
      "signature": "Modal(Target, Modal)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "Modal",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Make the window modal to force the user to make a decision before continuing."
    },
    {
      "id": "on-added-to-project",
      "name": "OnAddedToProject",
      "category": "AddToProjectConfig",
      "signature": "OnAddedToProject(Target, In Delegate)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Delegate",
          "type": "FOnAddedToProject&"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Callback for when the object is successfully added to the project"
    },
    {
      "id": "feature-all-native-classes",
      "name": "FeatureAllNativeClasses",
      "category": "AddToProjectConfig",
      "signature": "FeatureAllNativeClasses(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Set the add to project dialog to show component types on the initial 'featured' classes list"
    },
    {
      "id": "feature-actor-classes",
      "name": "FeatureActorClasses",
      "category": "AddToProjectConfig",
      "signature": "FeatureActorClasses(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Set the add to project dialog to show component types on the initial 'featured' classes list"
    },
    {
      "id": "feature-component-classes",
      "name": "FeatureComponentClasses",
      "category": "AddToProjectConfig",
      "signature": "FeatureComponentClasses(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Set the add to project dialog to show component types on the initial 'featured' classes list"
    },
    {
      "id": "sync-content-browser-to-new-class",
      "name": "SyncContentBrowserToNewClass",
      "category": "AddToProjectConfig",
      "signature": "SyncContentBrowserToNewClass(Target, In Sync Content Browser)",
      "params": [
        {
          "name": "Target",
          "type": "FAddToProjectConfig*"
        },
        {
          "name": "In Sync Content Browser",
          "type": "Bool"
        }
      ],
      "returnType": "FAddToProjectConfig&",
      "docs": "Set whether the content browser will be synced to view the newly created class"
    }
  ]
}