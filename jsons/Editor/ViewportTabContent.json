{
  "id": "viewport-tab-content",
  "label": "ViewportTabContent",
  "includepath": "ViewportTabContent.h",
  "includes": [
    "Map",
    "UnrealString",
    "Delegate",
    "DelegateCombinations",
    "EditorViewportLayout",
    "Optional",
    "Function",
    "SharedPointer",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "set-viewport-configuration",
      "name": "SetViewportConfiguration",
      "category": "ViewportTabContent",
      "signature": "SetViewportConfiguration(Target, Configuration Name)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTabContent*"
        },
        {
          "name": "Configuration Name",
          "type": "Name&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "bind-viewport-layout-commands",
      "name": "BindViewportLayoutCommands",
      "category": "ViewportTabContent",
      "signature": "BindViewportLayoutCommands(Target, In Out Command List, Viewport Config Key)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTabContent*"
        },
        {
          "name": "In Out Command List",
          "type": "FUICommandList&"
        },
        {
          "name": "Viewport Config Key",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Maps the common commands into the given command list for this layout to the given viewport based on the config key.\nThis call is only additive to the command list, and does not clear or erase already mapped actions."
    },
    {
      "id": "on-viewport-tab-content-layout-changed",
      "name": "OnViewportTabContentLayoutChanged",
      "category": "ViewportTabContent",
      "signature": "OnViewportTabContentLayoutChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTabContent*"
        }
      ],
      "returnType": "FViewportTabContentLayoutChangedEvent&"
    },
    {
      "id": "on-viewport-tab-content-layout-start-change",
      "name": "OnViewportTabContentLayoutStartChange",
      "category": "ViewportTabContent",
      "signature": "OnViewportTabContentLayoutStartChange(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTabContent*"
        }
      ],
      "returnType": "FViewportTabContentLayoutStartChangeEvent&"
    }
  ]
}