      "id": "initialize-from-t-3-d-texture-data-text",
      "name": "InitializeFromT3DTextureDataText",
      "category": "TextureFactory",
      "signature": "InitializeFromT3DTextureDataText(Target, In Texture, Text, Warn)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureFactory*"
        },
        {
          "name": "In Texture",
          "type": "UTexture*"
        },
        {
          "name": "Text",
          "type": "String&"
        },
        {
          "name": "Warn",
          "type": "FFeedbackContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "Initializes the given texture from the TextureData text block supplied.\nThe TextureData text block is assumed to have been generated by the UTextureExporterT3D.\n@param\tInTexture\tThe texture to initialize\n@param\tText\t\tThe texture data text generated by the TextureExporterT3D\n@param\tWarn\t\tWhere to send warnings/errors\n@return\tbool\t\ttrue if successful, false if not"
    },
