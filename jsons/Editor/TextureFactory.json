    {
      "id": "make-udim-virtual-texture-from-texture-2-ds",
      "name": "MakeUDIMVirtualTextureFromTexture2Ds",
      "category": "Utilities",
      "signature": "MakeUDIMVirtualTextureFromTexture2Ds(Output Path Name, Source Textures, Block Coords, Keep Existing Settings, Check Out And Save)",
      "params": [
        {
          "name": "Output Path Name",
          "type": "String"
        },
        {
          "name": "Source Textures",
          "type": "TArray<UTexture2D*>&"
        },
        {
          "name": "Block Coords",
          "type": "TArray<FIntPoint>&"
        },
        {
          "name": "Keep Existing Settings",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Check Out And Save",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "UTexture2D*",
      "docs": "Make a UDIM virtual texture from a list of regular 2D textures\n@param OutputPathName\t\t\tPath name of the UDIM texture (e.g. /Game/MyTexture)\n@param SourceTextures\t\t\tList of regular 2D textures to be packed into the atlas\n@param BlockCoords\t\t\tCoordinates of the corresponding texture in the atlas\n@param bKeepExistingSettings\tWhether to keep existing settings if a texture with the same path name exists. Otherwise, settings will be copied from the first source texture\n@param bCheckOutAndSave\t\tWhether to check out and save the UDIM texture\n@return UTexture2D*\t\t\tPointer to the UDIM texture or null if failed"
    },
