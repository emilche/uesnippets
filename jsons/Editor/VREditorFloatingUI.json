{
  "id": "vr-editor-floating-ui",
  "label": "VREditorFloatingUI",
  "includepath": "UI/VREditorFloatingUI.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SWidget",
    "VREditorBaseActor",
    "UserWidget",
    "VREditorFloatingUI.generated"
  ],
  "functions": [
    {
      "id": "show-ui",
      "name": "ShowUI",
      "category": "VREditorFloatingUI",
      "signature": "ShowUI(Target, Show, Allow Fading, Init Fade Delay, In Clear Widget On Hide)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorFloatingUI*"
        },
        {
          "name": "Show",
          "type": "Bool"
        },
        {
          "name": "Allow Fading",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Init Fade Delay",
          "type": "Float",
          "default": "0.0f"
        },
        {
          "name": "In Clear Widget On Hide",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Shows or hides the UI (also enables collision, and performs a transition effect)"
    },
    {
      "id": "get-user-widget",
      "name": "GetUserWidget",
      "category": "VREditorFloatingUI",
      "signature": "GetUserWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "T*"
        }
      ],
      "returnType": "UUserWidget*",
      "docs": "Returns casted userwidget"
    }
  ]
}