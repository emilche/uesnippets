{
  "id": "landscape-import-helper",
  "label": "LandscapeImportHelper",
  "includepath": "LandscapeImportHelper.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "LandscapeFileFormatInterface",
    "UnrealTypeTraits",
    "EnableIf",
    "LandscapeImportHelper.generated"
  ],
  "functions": [
    {
      "id": "reset",
      "name": "Reset",
      "category": "LandscapeImportHelper",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FLandscapeImportDescriptor*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "find-descriptor-index",
      "name": "FindDescriptorIndex",
      "category": "LandscapeImportHelper",
      "signature": "FindDescriptorIndex(Target, Import Width, Import Height)",
      "params": [
        {
          "name": "Target",
          "type": "FLandscapeImportDescriptor*"
        },
        {
          "name": "Import Width",
          "type": "Int"
        },
        {
          "name": "Import Height",
          "type": "Int"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-import-descriptor",
      "name": "GetImportDescriptor",
      "category": "LandscapeImportHelper",
      "signature": "GetImportDescriptor<T>(File Path, Single File, Flip Y Axis, Layer Name, Out Import Descriptor, Out Message)",
      "params": [
        {
          "name": "File Path",
          "type": "String&"
        },
        {
          "name": "Single File",
          "type": "Bool"
        },
        {
          "name": "Flip Y Axis",
          "type": "Bool"
        },
        {
          "name": "Layer Name",
          "type": "Name"
        },
        {
          "name": "Out Import Descriptor",
          "type": "FLandscapeImportDescriptor&"
        },
        {
          "name": "Out Message",
          "type": "Text&"
        }
      ],
      "returnType": "template<T> TEnableIf<std::is_same_v<T,uint16>,ELandscapeImportResult>::Type"
    },
    {
      "id": "get-import-data",
      "name": "GetImportData",
      "category": "LandscapeImportHelper",
      "signature": "GetImportData<T>(Import Descriptor, Descriptor Index, Layer Name, Out Data, Out Message)",
      "params": [
        {
          "name": "Import Descriptor",
          "type": "FLandscapeImportDescriptor&"
        },
        {
          "name": "Descriptor Index",
          "type": "Int"
        },
        {
          "name": "Layer Name",
          "type": "Name"
        },
        {
          "name": "Out Data",
          "type": "TArray<T>&"
        },
        {
          "name": "Out Message",
          "type": "Text&"
        }
      ],
      "returnType": "template<T> TEnableIf<std::is_same_v<T,uint16>,ELandscapeImportResult>::Type"
    },
    {
      "id": "transform-import-data",
      "name": "TransformImportData",
      "category": "LandscapeImportHelper",
      "signature": "TransformImportData<T>(In Data, Out Data, Current Resolution, Required Resolution, Transform Type, Offset)",
      "params": [
        {
          "name": "In Data",
          "type": "TArray<T>&"
        },
        {
          "name": "Out Data",
          "type": "TArray<T>&"
        },
        {
          "name": "Current Resolution",
          "type": "FLandscapeImportResolution&"
        },
        {
          "name": "Required Resolution",
          "type": "FLandscapeImportResolution&"
        },
        {
          "name": "Transform Type",
          "type": "ELandscapeImportTransformType",
          "default": "ELandscapeImportTransformType::ExpandCentered"
        },
        {
          "name": "Offset",
          "type": "FIntPoint",
          "default": "FIntPoint(0, 0)"
        }
      ],
      "returnType": "template<T> TEnableIf<std::is_same_v<T,uint16>,void>::Type"
    }
  ]
}