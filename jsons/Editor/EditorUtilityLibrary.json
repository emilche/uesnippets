      "category": "Editor Scripting ",
      "signature": "AddSourceWidget(Widget Blueprint, Widget Class, Widget Name, Widget Parent Name)",
      "params": [
        {
          "name": "Widget Blueprint",
          "type": "UWidgetBlueprint*"
        },
        {
          "name": "Widget Class",
          "type": "TSubclassOf<UWidget>"
