        },
        {
          "name": "Widget Parent Name",
          "type": "Name"
        }
      ],
      "returnType": "UWidget*",
      "docs": "Create a new widget and add to the specific widget blueprint's widget tree\n@param WidgetBlueprint The widget blueprint to add a widget to\n@param WidgetClass The widget class to add to the widget blueprint\n@param WidgetName The name to give the new widget\n@param WidgetParentName The name of the existing widget that will hold the new widget. Must be an existing Panel Widget or none of if the widget tree is empty and the new widget will become the RootWidget.\n@return The widget that was created and added to the widget blueprint"
    },
