  ],
  "functions": [
    {
      "id": "show-toggle-environment",
      "name": "ShowToggleEnvironment",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "ShowToggleEnvironment(Target, In Show Toggle Environment)",
      "params": [
        {
          "name": "Target",
          "type": "FSettingsOptions*"
        },
        {
          "name": "In Show Toggle Environment",
          "type": "Bool"
        }
      ],
      "returnType": "FSettingsOptions&"
    },
    {
      "id": "show-toggle-grid",
      "name": "ShowToggleGrid",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "ShowToggleGrid(Target, In Show Toggle Grid)",
      "params": [
        {
          "name": "Target",
          "type": "FSettingsOptions*"
        },
        {
          "name": "In Show Toggle Grid",
          "type": "Bool"
        }
      ],
      "returnType": "FSettingsOptions&"
    },
    {
      "id": "show-toggle-floor",
      "name": "ShowToggleFloor",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "ShowToggleFloor(Target, In Show Toggle Floor)",
      "params": [
        {
          "name": "Target",
          "type": "FSettingsOptions*"
        },
        {
          "name": "In Show Toggle Floor",
          "type": "Bool"
        }
      ],
      "returnType": "FSettingsOptions&"
    },
    {
      "id": "show-toggle-post-processing",
      "name": "ShowTogglePostProcessing",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "ShowTogglePostProcessing(Target, In Show Toggle Post Processing)",
      "params": [
        {
          "name": "Target",
          "type": "FSettingsOptions*"
        },
        {
          "name": "In Show Toggle Post Processing",
          "type": "Bool"
        }
      ],
      "returnType": "FSettingsOptions&"
    },
    {
      "id": "extend-advanced-preview-scene-settings",
      "name": "ExtendAdvancedPreviewSceneSettings",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "ExtendAdvancedPreviewSceneSettings(In Asset Viewer Profile Submenu Name, In Settings Options)",
      "params": [
        {
          "name": "In Asset Viewer Profile Submenu Name",
          "type": "Name"
        },
        {
          "name": "In Settings Options",
          "type": "FSettingsOptions&",
          "default": "{}"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "default-on-settings-changed-handler",
      "name": "DefaultOnSettingsChangedHandler",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "DefaultOnSettingsChangedHandler(Profile, Property Name, Client)",
      "params": [
        {
          "name": "Profile",
          "type": "FPreviewSceneProfile&"
        },
        {
          "name": "Property Name",
          "type": "Name"
        },
        {
          "name": "Client",
          "type": "TWeakPtr<FEditorViewportClient>"
        }
      ],
      "returnType": "Void",
      "docs": "A default handler for `FAdvancedPreviewScene::OnProfileChanged()`. Syncs the profile to the provided client's show flags and other settings."
    },
    {
      "id": "bind-default-on-settings-changed-handler",
      "name": "BindDefaultOnSettingsChangedHandler",
      "category": "AdvancedPreviewSceneMenus",
      "signature": "BindDefaultOnSettingsChangedHandler(Scene, Client)",
      "params": [
        {
          "name": "Scene",
          "type": "TSharedPtr<FAdvancedPreviewScene>&"
        },
        {
          "name": "Client",
          "type": "TSharedPtr<FEditorViewportClient>&"
        }
      ],
      "returnType": "Void",
      "docs": "Attaches `DefaultOnSettingsChangedHandler()` to the provided scene's `OnProfileChanged` delegate & calls the function with the current profile to syncronize the client.\nThis is a convenience that alleviates the annoyance of having to manually downcast subtypes of FEditorViewporClient."
    }
  ]
}