{
  "id": "i-plugins-editor-feature",
  "label": "IPluginsEditorFeature",
  "includepath": "Features/IPluginsEditorFeature.h",
  "includes": [
    "CoreMinimal",
    "IModularFeature",
    "ModuleDescriptor"
  ],
  "functions": [
    {
      "id": "customize-descriptor-before-creation",
      "name": "CustomizeDescriptorBeforeCreation",
      "category": "IPluginsEditorFeature",
      "signature": "CustomizeDescriptorBeforeCreation(Target, Descriptor)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "Descriptor",
          "type": "FPluginDescriptor&"
        }
      ],
      "returnType": "Void",
      "docs": "Description of a plugin template"
    },
    {
      "id": "on-plugin-created",
      "name": "OnPluginCreated",
      "category": "IPluginsEditorFeature",
      "signature": "OnPluginCreated(Target, New Plugin)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "New Plugin",
          "type": "TSharedPtr<IPlugin>"
        }
      ],
      "returnType": "Void",
      "docs": "Called after the plugin has been created"
    },
    {
      "id": "validate-path-for-plugin",
      "name": "ValidatePathForPlugin",
      "category": "IPluginsEditorFeature",
      "signature": "ValidatePathForPlugin(Target, Proposed Absolute Plugin Path, Out Error Message)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "Proposed Absolute Plugin Path",
          "type": "String&"
        },
        {
          "name": "Out Error Message",
          "type": "Text&"
        }
      ],
      "returnType": "Bool",
      "docs": "Called to perform *additional* path validation when the path is modified (the bCanBePlacedInEngine validation will have already occurred and passed by this point)"
    },
    {
      "id": "update-path-when-template-selected",
      "name": "UpdatePathWhenTemplateSelected",
      "category": "IPluginsEditorFeature",
      "signature": "UpdatePathWhenTemplateSelected(Target, In Out Path)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "In Out Path",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to enforce any restrictions this template has on paths when it is first selected (so it doesn't generate an error unnecessarily)"
    },
    {
      "id": "update-path-when-template-unselected",
      "name": "UpdatePathWhenTemplateUnselected",
      "category": "IPluginsEditorFeature",
      "signature": "UpdatePathWhenTemplateUnselected(Target, In Out Path)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "In Out Path",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to change away from special folders if needed"
    },
    {
      "id": "update-plugin-name-text-when-template-selected",
      "name": "UpdatePluginNameTextWhenTemplateSelected",
      "category": "IPluginsEditorFeature",
      "signature": "UpdatePluginNameTextWhenTemplateSelected(Target, Out Plugin Name Text)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "Out Plugin Name Text",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to optionally set the default plugin name text"
    },
    {
      "id": "update-plugin-name-text-when-template-unselected",
      "name": "UpdatePluginNameTextWhenTemplateUnselected",
      "category": "IPluginsEditorFeature",
      "signature": "UpdatePluginNameTextWhenTemplateUnselected(Target, Out Plugin Name Text)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginTemplateDescription*"
        },
        {
          "name": "Out Plugin Name Text",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to optionally unset the default plugin name text"
    }
  ]
}