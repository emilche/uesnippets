      "docs": "Looks up a child of this node by key. Note: the key is not hashed. This is O(n)"
    },
    {
      "id": "find-or-cache-child-node",
      "name": "FindOrCacheChildNode",
      "category": "BlueprintActionFilterResultCache",
      "signature": "FindOrCacheChildNode<TKeyType>(Target, Key, In Debug Name, Comparison, Out Found Without Caching)",
      "params": [
        {
          "name": "Target",
          "type": "FActionFilterCacheNode*"
        },
        {
          "name": "Key",
          "type": "TKeyType&"
        },
        {
          "name": "In Debug Name",
          "type": "String&",
          "default": "FString()"
        },
        {
          "name": "Comparison",
          "type": "TDelegate<bool ( TKeyType&,TKeyType& )>",
          "default": "nullptr"
        },
        {
          "name": "Out Found Without Caching",
          "type": "Bool*",
          "default": "nullptr"
        }
      ],
      "returnType": "template<TKeyType> TSharedKeyNode<TKeyType>",
      "docs": "Looks up a child of this node by key and creates one if one doesnt exist.\nThe node that is created will be a TActionFilterCacheKeyNode. Use FindOrCacheChildLeaf if you need it to be a\nTActionFilterCacheLeaf\nNote: the key is not hashed. This is O(n)"
    },
