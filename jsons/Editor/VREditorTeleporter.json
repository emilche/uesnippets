{
  "id": "vr-editor-teleporter",
  "label": "VREditorTeleporter",
  "includepath": "Teleporter/VREditorTeleporter.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "Actor",
    "EngineBaseTypes",
    "VREditorTeleporter.generated"
  ],
  "functions": [
    {
      "id": "init",
      "name": "Init",
      "category": "Teleporter",
      "signature": "Init(Target, In Mode)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        },
        {
          "name": "In Mode",
          "type": "UVREditorMode*"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes the teleporter"
    },
    {
      "id": "shutdown",
      "name": "Shutdown",
      "category": "Teleporter",
      "signature": "Shutdown(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Void",
      "docs": "Shuts down the teleporter"
    },
    {
      "id": "is-aiming",
      "name": "IsAiming",
      "category": "Teleporter",
      "signature": "IsAiming(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether we are currently aiming to teleport."
    },
    {
      "id": "is-teleporting",
      "name": "IsTeleporting",
      "category": "Teleporter",
      "signature": "IsTeleporting(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-vr-mode",
      "name": "GetVRMode",
      "category": "Teleporter",
      "signature": "GetVRMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "class UVREditorMode*"
    },
    {
      "id": "start-teleport",
      "name": "StartTeleport",
      "category": "Teleporter",
      "signature": "StartTeleport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Void",
      "docs": "Start teleporting, does a ray trace with the hand passed and calculates the locations for lerp movement in Teleport"
    },
    {
      "id": "teleport-done",
      "name": "TeleportDone",
      "category": "Teleporter",
      "signature": "TeleportDone(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Void",
      "docs": "Called when teleport is done for cleanup"
    },
    {
      "id": "set-visibility",
      "name": "SetVisibility",
      "category": "Teleporter",
      "signature": "SetVisibility(Target, Visible)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        },
        {
          "name": "Visible",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Hide or show the teleporter visuals"
    },
    {
      "id": "set-color",
      "name": "SetColor",
      "category": "Teleporter",
      "signature": "SetColor(Target, Color)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        },
        {
          "name": "Color",
          "type": "FLinearColor&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the color for the teleporter visuals"
    },
    {
      "id": "get-slide-delta",
      "name": "GetSlideDelta",
      "category": "Teleporter",
      "signature": "GetSlideDelta(Target, Interactor, Axis)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        },
        {
          "name": "Interactor",
          "type": "UVREditorInteractor*"
        },
        {
          "name": "Axis",
          "type": "Bool"
        }
      ],
      "returnType": "Float",
      "docs": "Get slide delta to push/pull or scale the teleporter"
    },
    {
      "id": "stop-aiming",
      "name": "StopAiming",
      "category": "Teleporter",
      "signature": "StopAiming(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Void",
      "docs": "Cancel teleport aiming mode without doing the teleport"
    },
    {
      "id": "do-teleport",
      "name": "DoTeleport",
      "category": "Teleporter",
      "signature": "DoTeleport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "Void",
      "docs": "Do and finalize teleport."
    },
    {
      "id": "get-interactor-trying-teleport",
      "name": "GetInteractorTryingTeleport",
      "category": "Teleporter",
      "signature": "GetInteractorTryingTeleport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AVREditorTeleporter*"
        }
      ],
      "returnType": "UViewportInteractor*",
      "docs": "Get the actor we're currently trying to teleport with.\nValid during aiming and teleporting."
    }
  ]
}