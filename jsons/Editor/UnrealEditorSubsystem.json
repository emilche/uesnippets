      "signature": "GetEditorWorld(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UUnrealEditorSubsystem*"
        }
      ],
      "returnType": "UWorld*",
      "docs": "Find the World in the world editor. It can then be used as WorldContext by other libraries like GameplayStatics.\n@return\tThe World used by the world editor."
    },
    {
