{
  "id": "persona-utils",
  "label": "PersonaUtils",
  "includepath": "PersonaUtils.h",
  "includes": [
    "CoreMinimal",
    "SlateDelegates",
    "ClassViewerModule"
  ],
  "functions": [
    {
      "id": "get-component-for-attached-object",
      "name": "GetComponentForAttachedObject",
      "category": "PersonaUtils",
      "signature": "GetComponentForAttachedObject(Preview Component, Object, Attached To)",
      "params": [
        {
          "name": "Preview Component",
          "type": "USceneComponent*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Attached To",
          "type": "Name&"
        }
      ],
      "returnType": "USceneComponent*",
      "docs": "Get the viewport scene component for the specified attached asset"
    },
    {
      "id": "copy-properties-to-cdo",
      "name": "CopyPropertiesToCDO",
      "category": "PersonaUtils",
      "signature": "CopyPropertiesToCDO(In Anim Instance, Options)",
      "params": [
        {
          "name": "In Anim Instance",
          "type": "UAnimInstance*"
        },
        {
          "name": "Options",
          "type": "FCopyOptions&",
          "default": "FCopyOptions(ECopyOptions::Default)"
        }
      ],
      "returnType": "Int",
      "docs": "Copy modified properties from the specified anim instance back to its CDO"
    },
    {
      "id": "set-object-being-debugged",
      "name": "SetObjectBeingDebugged",
      "category": "PersonaUtils",
      "signature": "SetObjectBeingDebugged(In Anim Blueprint, In Anim Instance)",
      "params": [
        {
          "name": "In Anim Blueprint",
          "type": "UAnimBlueprint*"
        },
        {
          "name": "In Anim Instance",
          "type": "UAnimInstance*"
        }
      ],
      "returnType": "Void",
      "docs": "Set the correct object to debug depending on whether we are running a sub-layer etc."
    },
    {
      "id": "make-track-button",
      "name": "MakeTrackButton",
      "category": "PersonaUtils",
      "signature": "MakeTrackButton(Hover Text, Menu Content, Hover State)",
      "params": [
        {
          "name": "Hover Text",
          "type": "Text"
        },
        {
          "name": "Menu Content",
          "type": "FOnGetContent"
        },
        {
          "name": "Hover State",
          "type": "TAttribute<bool>&"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Make an add button widget, as seen in the animation timeline"
    },
    {
      "id": "make-anim-notify-picker",
      "name": "MakeAnimNotifyPicker",
      "category": "PersonaUtils",
      "signature": "MakeAnimNotifyPicker(Sequence, On Class Picked)",
      "params": [
        {
          "name": "Sequence",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "On Class Picked",
          "type": "FOnClassPicked&"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Make AnimNotify class picker widget"
    },
    {
      "id": "make-anim-notify-state-picker",
      "name": "MakeAnimNotifyStatePicker",
      "category": "PersonaUtils",
      "signature": "MakeAnimNotifyStatePicker(Sequence, On Class Picked)",
      "params": [
        {
          "name": "Sequence",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "On Class Picked",
          "type": "FOnClassPicked&"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Make AnimNotifyState class picker widget"
    }
  ]
}