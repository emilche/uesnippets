    {
      "id": "get-root-for-actor",
      "name": "GetRootForActor",
      "category": "GroupActor",
      "signature": "GetRootForActor(In Actor, Must Be Locked, Must Be Selected, Must Be Unlocked, Must Be Unselected)",
      "params": [
        {
          "name": "In Actor",
          "type": "AActor*"
        },
        {
          "name": "Must Be Locked",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Must Be Selected",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Must Be Unlocked",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Must Be Unselected",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "AGroupActor*",
      "docs": "Returns the highest found root for the given actor or null if one is not found. Qualifications of root can be specified via optional parameters.\n@param\tInActor\t\t\tActor to find a group root for.\n@param\tbMustBeLocked\tFlag designating to only return the topmost locked group.\n@param\tbMustBeSelected\tFlag designating to only return the topmost selected group.\n@param\tbMustBeUnlocked\t\tFlag designating to only return the topmost unlocked group.\n@param\tbMustBeUnselected\tFlag designating to only return the topmost unselected group.\n@return\tThe topmost group actor for this actor. Returns null if none exists using the given conditions."
    },
