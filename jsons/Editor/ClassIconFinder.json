{
  "id": "class-icon-finder",
  "label": "ClassIconFinder",
  "includepath": "ClassIconFinder.h",
  "includes": [
    "Array",
    "CoreMinimal",
    "Platform",
    "SlateIconFinder",
    "SlateIcon",
    "Class",
    "NameTypes",
    "WeakObjectPtrTemplates"
  ],
  "functions": [
    {
      "id": "find-icon-for-actor",
      "name": "FindIconForActor",
      "category": "ClassIconFinder",
      "signature": "FindIconForActor(In Actor)",
      "params": [
        {
          "name": "In Actor",
          "type": "TWeakObjectPtr<AActor>&"
        }
      ],
      "returnType": "FSlateBrush*",
      "docs": "Find the small icon to use for the supplied actor"
    },
    {
      "id": "find-slate-icon-for-actor",
      "name": "FindSlateIconForActor",
      "category": "ClassIconFinder",
      "signature": "FindSlateIconForActor(In Actor)",
      "params": [
        {
          "name": "In Actor",
          "type": "TWeakObjectPtr<AActor>&"
        }
      ],
      "returnType": "FSlateIcon",
      "docs": "Find the small icon to use for the supplied actor"
    },
    {
      "id": "get-icon-class-for-blueprint",
      "name": "GetIconClassForBlueprint",
      "category": "ClassIconFinder",
      "signature": "GetIconClassForBlueprint(In Blueprint)",
      "params": [
        {
          "name": "In Blueprint",
          "type": "UBlueprint*"
        }
      ],
      "returnType": "UClass*",
      "docs": "Utility function to convert a Blueprint into the most suitable class possible for use by the icon finder"
    },
    {
      "id": "get-icon-class-for-asset-data",
      "name": "GetIconClassForAssetData",
      "category": "ClassIconFinder",
      "signature": "GetIconClassForAssetData(In Asset Data, Out Is Class Type)",
      "params": [
        {
          "name": "In Asset Data",
          "type": "FAssetData&"
        },
        {
          "name": "Out Is Class Type",
          "type": "Bool*",
          "default": "nullptr"
        }
      ],
      "returnType": "UClass*",
      "docs": "Utility function to convert an asset into the most suitable class possible for use by the icon finder"
    },
    {
      "id": "lookup-brush",
      "name": "LookupBrush",
      "category": "ClassIconFinder",
      "signature": "LookupBrush(Icon Name)",
      "params": [
        {
          "name": "Icon Name",
          "type": "Name"
        }
      ],
      "returnType": "FSlateBrush*"
    }
  ]
}