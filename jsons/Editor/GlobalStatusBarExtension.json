{
  "id": "global-status-bar-extension",
  "label": "GlobalStatusBarExtension",
  "includepath": "GlobalStatusBarExtension.h",
  "includes": [
    "SharedPointer"
  ],
  "functions": [
    {
      "id": "extend-content-browser-drawer",
      "name": "ExtendContentBrowserDrawer",
      "category": "GlobalStatusBarExtension",
      "signature": "ExtendContentBrowserDrawer(Target, Widget Drawer Config)",
      "params": [
        {
          "name": "Target",
          "type": "IGlobalStatusBarExtension*"
        },
        {
          "name": "Widget Drawer Config",
          "type": "FWidgetDrawerConfig&"
        }
      ],
      "returnType": "Void",
      "docs": "Called before the content browser drawer is registered in the status bar."
    },
    {
      "id": "extend-output-log-drawer",
      "name": "ExtendOutputLogDrawer",
      "category": "GlobalStatusBarExtension",
      "signature": "ExtendOutputLogDrawer(Target, Widget Drawer Config)",
      "params": [
        {
          "name": "Target",
          "type": "IGlobalStatusBarExtension*"
        },
        {
          "name": "Widget Drawer Config",
          "type": "FWidgetDrawerConfig&"
        }
      ],
      "returnType": "Void",
      "docs": "Called before the output log drawer is registered in the status bar."
    }
  ]
}