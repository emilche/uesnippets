{
  "id": "i-snappable-extension",
  "label": "ISnappableExtension",
  "includepath": "MVVM/Extensions/ISnappableExtension.h",
  "includes": [
    "SequencerCoreFwd",
    "ViewModelTypeID",
    "KeyHandle",
    "MemoryOps"
  ],
  "functions": [
    {
      "id": "get-capabilities",
      "name": "GetCapabilities",
      "category": "ISnappableExtension",
      "signature": "GetCapabilities(Target, Out Default Applicability, Out Capabilities)",
      "params": [
        {
          "name": "Target",
          "type": "ISnapCandidate*"
        },
        {
          "name": "Out Default Applicability",
          "type": "EDefaultApplicability&"
        },
        {
          "name": "Out Capabilities",
          "type": "ESnapCapabilities&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieve the capabilities of this snap candidate instance as a bitmask. Zero bits will prevent virtual functions being called as an optimziation"
    },
    {
      "id": "is-key-applicable",
      "name": "IsKeyApplicable",
      "category": "ISnappableExtension",
      "signature": "IsKeyApplicable(Target, Key Handle, Owner)",
      "params": [
        {
          "name": "Target",
          "type": "ISnapCandidate*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        },
        {
          "name": "Owner",
          "type": "UE::Sequencer::FViewModelPtr&"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true to include the specified key in the snap field"
    },
    {
      "id": "are-section-bounds-applicable",
      "name": "AreSectionBoundsApplicable",
      "category": "ISnappableExtension",
      "signature": "AreSectionBoundsApplicable(Target, Section)",
      "params": [
        {
          "name": "Target",
          "type": "ISnapCandidate*"
        },
        {
          "name": "Section",
          "type": "UMovieSceneSection*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true to include the specified section's bounds in the snap field"
    },
    {
      "id": "are-section-custom-snaps-applicable",
      "name": "AreSectionCustomSnapsApplicable",
      "category": "ISnappableExtension",
      "signature": "AreSectionCustomSnapsApplicable(Target, Section)",
      "params": [
        {
          "name": "Target",
          "type": "ISnapCandidate*"
        },
        {
          "name": "Section",
          "type": "UMovieSceneSection*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true to include the specified section's custom snap points in the snap field"
    }
  ]
}