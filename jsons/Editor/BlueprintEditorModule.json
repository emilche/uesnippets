      "id": "paste-nodes-here",
      "name": "PasteNodesHere",
      "category": "BlueprintEditorModule",
      "signature": "PasteNodesHere(Target, Graph, Location)",
      "params": [
        {
          "name": "Target",
          "type": "IBlueprintEditor*"
        },
        {
          "name": "Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Location",
          "type": "FVector2D&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-imported-class-viewer-filter",
      "name": "GetImportedClassViewerFilter",
      "category": "BlueprintEditorModule",
      "signature": "GetImportedClassViewerFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IBlueprintEditor*"
        }
      ],
      "returnType": "TSharedPtr<class IClassViewerFilter>",
      "docs": "Return the class viewer filter associated with the current set of imported namespaces within this editor context. Default is NULL (no filter)."
    },
    {
      "id": "get-imported-pin-type-selector-filter",
      "name": "GetImportedPinTypeSelectorFilter",
      "category": "BlueprintEditorModule",
      "signature": "GetImportedPinTypeSelectorFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IBlueprintEditor*"
        }
      ],
      "returnType": "TSharedPtr<class IPinTypeSelectorFilter>",
      "docs": "Return the pin type selector filter associated with the current set of imported namespaces within this editor context. Default is NULL (no filter)."
    },
    {
      "id": "get-pin-type-selector-filters",
      "name": "GetPinTypeSelectorFilters",
      "category": "BlueprintEditorModule",
      "signature": "GetPinTypeSelectorFilters(Target, Out Filters)",
      "params": [
        {
          "name": "Target",
          "type": "IBlueprintEditor*"
        },
        {
          "name": "Out Filters",
          "type": "TArray<TSharedPtr<IPinTypeSelectorFilter>>&"
        }
      ],
      "returnType": "Void",
      "docs": "Get all the the pin type selector filters within this editor context."
    },
    {
      "id": "is-non-imported-object",
      "name": "IsNonImportedObject",
      "category": "BlueprintEditorModule",
      "signature": "IsNonImportedObject(Target, In Object)",
      "params": [
        {
          "name": "Target",
          "type": "IBlueprintEditor*"
        },
        {
          "name": "In Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return whether the given object falls outside the scope of the current set of imported namespaces within this editor context. Default is FALSE (imported)."
    },
    {
      "id": "get-menu-extensibility-manager",
      "name": "GetMenuExtensibilityManager",
      "category": "BlueprintEditorModule",
      "signature": "GetMenuExtensibilityManager(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FBlueprintEditorModule*"
        }
      ],
      "returnType": "TSharedPtr<FExtensibilityManager>",
      "docs": "Gets the extensibility managers for outside entities to extend blueprint editor's menus and toolbars"
    },
