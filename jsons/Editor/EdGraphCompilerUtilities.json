{
  "id": "ed-graph-compiler-utilities",
  "label": "EdGraphCompilerUtilities",
  "includepath": "EdGraphCompilerUtilities.h",
  "includes": [
    "CoreMinimal",
    "SubclassOf",
    "EdGraphNode",
    "EdGraphPin"
  ],
  "functions": [
    {
      "id": "validate-link",
      "name": "ValidateLink",
      "category": "EdGraphCompilerUtilities",
      "signature": "ValidateLink(Target, Pin A, Pin B)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Pin A",
          "type": "UEdGraphPin*"
        },
        {
          "name": "Pin B",
          "type": "UEdGraphPin*"
        }
      ],
      "returnType": "protected : void",
      "docs": "Validates that the interconnection between two pins is schema compatible"
    },
    {
      "id": "validate-pin",
      "name": "ValidatePin",
      "category": "EdGraphCompilerUtilities",
      "signature": "ValidatePin(Target, Pin)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Pin",
          "type": "UEdGraphPin*"
        }
      ],
      "returnType": "Void",
      "docs": "Validate that the wiring for a single pin is schema compatible"
    },
    {
      "id": "validate-node",
      "name": "ValidateNode",
      "category": "EdGraphCompilerUtilities",
      "signature": "ValidateNode(Target, Node)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Node",
          "type": "UEdGraphNode*"
        }
      ],
      "returnType": "Void",
      "docs": "Validates that the node is schema compatible"
    },
    {
      "id": "validate-graph-is-well-formed",
      "name": "ValidateGraphIsWellFormed",
      "category": "EdGraphCompilerUtilities",
      "signature": "ValidateGraphIsWellFormed(Target, Graph)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Graph",
          "type": "UEdGraph*"
        }
      ],
      "returnType": "Bool",
      "docs": "Performs standard validation on the graph (outputs point to inputs, no more than one connection to each input, types match on both ends, etc...)"
    },
    {
      "id": "find-node-by-class",
      "name": "FindNodeByClass",
      "category": "EdGraphCompilerUtilities",
      "signature": "FindNodeByClass(Target, Graph, Node Class, Expected Unique)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Node Class",
          "type": "TSubclassOf<UEdGraphNode>"
        },
        {
          "name": "Expected Unique",
          "type": "Bool"
        }
      ],
      "returnType": "UEdGraphNode*",
      "docs": "Scans a graph for a node of the specified class.  Can optionally continue scanning and print errors if additional nodes of the same category are found."
    },
    {
      "id": "prune-isolated-nodes",
      "name": "PruneIsolatedNodes",
      "category": "EdGraphCompilerUtilities",
      "signature": "PruneIsolatedNodes(Target, Root Set, Graph Nodes)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Root Set",
          "type": "TArray<UEdGraphNode*>&"
        },
        {
          "name": "Graph Nodes",
          "type": "TArray<UEdGraphNode*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Prunes any nodes that weren't visited from the graph, printing out a warning"
    },
    {
      "id": "create-execution-schedule",
      "name": "CreateExecutionSchedule",
      "category": "EdGraphCompilerUtilities",
      "signature": "CreateExecutionSchedule(Target, Graph Nodes, Linear Execution Schedule)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphCompilerContext*"
        },
        {
          "name": "Graph Nodes",
          "type": "TArray<UEdGraphNode*>&"
        },
        {
          "name": "Linear Execution Schedule",
          "type": "TArray<UEdGraphNode*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Performs a topological sort on the graph of nodes passed in (which is expected to form a DAG), scheduling them.\nIf there are cycles or unconnected nodes present in the graph, an error will be output for each node that failed to be scheduled."
    }
  ]
}