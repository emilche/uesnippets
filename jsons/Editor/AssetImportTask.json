      "id": "get-objects",
      "name": "GetObjects",
      "category": "Asset Import Task",
      "signature": "GetObjects(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAssetImportTask*"
        }
      ],
      "returnType": "TArray<UObject*>&",
      "docs": "Get the list of imported objects.\nNote that if the import was asynchronous, this will block until the results are ready.\nTo test whether asynchronous results are ready or not, use IsAsyncImportComplete()."
    },
