{
  "id": "vr-editor-mode-base",
  "label": "VREditorModeBase",
  "includepath": "VREditorModeBase.h",
  "includes": [
    "UnrealEdTypes",
    "EditorWorldExtension",
    "HeadMountedDisplayTypes",
    "ShowFlags",
    "VREditorModeBase.generated"
  ],
  "functions": [
    {
      "id": "set-actually-using-vr",
      "name": "SetActuallyUsingVR",
      "category": "VREditorModeBase",
      "signature": "SetActuallyUsingVR(Target, Should Actually Use VR)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        },
        {
          "name": "Should Actually Use VR",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether we should actually use an HMD. Call this before activating VR mode"
    },
    {
      "id": "is-actually-using-vr",
      "name": "IsActuallyUsingVR",
      "category": "VREditorModeBase",
      "signature": "IsActuallyUsingVR(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if we're actually using VR, or false if we're faking it"
    },
    {
      "id": "wants-to-exit-mode",
      "name": "WantsToExitMode",
      "category": "VREditorModeBase",
      "signature": "WantsToExitMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the user wants to exit this mode"
    },
    {
      "id": "get-room-transform",
      "name": "GetRoomTransform",
      "category": "VREditorModeBase",
      "signature": "GetRoomTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Returns the transform which takes poses from XR tracking space (\"room\" space) to world space."
    },
    {
      "id": "get-head-transform",
      "name": "GetHeadTransform",
      "category": "VREditorModeBase",
      "signature": "GetHeadTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Returns the user's head pose in world space."
    },
    {
      "id": "get-laser-for-hand",
      "name": "GetLaserForHand",
      "category": "VREditorModeBase",
      "signature": "GetLaserForHand(Target, In Hand, Out Laser Start, Out Laser End)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        },
        {
          "name": "In Hand",
          "type": "EControllerHand"
        },
        {
          "name": "Out Laser Start",
          "type": "FVector&"
        },
        {
          "name": "Out Laser End",
          "type": "FVector&"
        }
      ],
      "returnType": "Bool",
      "docs": "Gives start and end points in world space for an active laser, or returns false if there is no active laser for the specified hand."
    },
    {
      "id": "on-vr-mode-entry-complete",
      "name": "OnVRModeEntryComplete",
      "category": "VREditorModeBase",
      "signature": "OnVRModeEntryComplete(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "FOnVRModeEntryComplete&"
    },
    {
      "id": "get-vr-level-viewport",
      "name": "GetVrLevelViewport",
      "category": "VREditorModeBase",
      "signature": "GetVrLevelViewport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVREditorModeBase*"
        }
      ],
      "returnType": "TSharedPtr<SLevelViewport>"
    }
  ]
}