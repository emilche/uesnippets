{
  "id": "s-morph-target-viewer",
  "label": "SMorphTargetViewer",
  "includepath": "SMorphTargetViewer.h",
  "includes": [
    "CoreMinimal",
    "IMorphTargetViewer",
    "SlateFwd",
    "DeclarativeSyntaxSupport",
    "SCompoundWidget",
    "IPersonaPreviewScene",
    "STableViewBase",
    "STableRow",
    "SListView"
  ],
  "functions": [
    {
      "id": "make",
      "name": "Make",
      "category": "SMorphTargetViewer",
      "signature": "Make(Source, In Number Of Verts, In Morph Lod Infos)",
      "params": [
        {
          "name": "Source",
          "type": "Name&"
        },
        {
          "name": "In Number Of Verts",
          "type": "Int"
        },
        {
          "name": "In Morph Lod Infos",
          "type": "TArray<FMorphLodInfo>&"
        }
      ],
      "returnType": "TSharedRef<FDisplayedMorphTargetInfo>",
      "docs": "Static function for creating a new item, but ensures that you can only have a TSharedRef to one"
    },
    {
      "id": "get-filter-text",
      "name": "GetFilterText",
      "category": "SMorphTargetViewer",
      "signature": "GetFilterText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SMorphTargetViewer*"
        }
      ],
      "returnType": "Text&",
      "docs": "Accessor so our rows can grab the filtertext for highlighting"
    }
  ]
}