      "signature": "GetAllocatedSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDebugSkelMeshSceneProxy*"
        }
      ],
      "returnType": "SIZE_T"
    },
    {
      "id": "get-memory-footprint",
      "name": "GetMemoryFootprint",
      "category": "DebugSkelMeshComponent",
      "signature": "GetMemoryFootprint(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDebugSkelMeshSceneProxy*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "toggle-cloth-sections-visibility",
      "name": "ToggleClothSectionsVisibility",
      "category": "DebugSkelMeshComponent",
      "signature": "ToggleClothSectionsVisibility(Target, Show Only Cloth Sections)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "Show Only Cloth Sections",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "toggle visibility between cloth sections and non-cloth sections for all LODs\nif bShowOnlyClothSections is true, shows only cloth sections. On the other hand,\nif bShowOnlyClothSections is false, hides only cloth sections."
    },
    {
      "id": "restore-cloth-sections-visibility",
      "name": "RestoreClothSectionsVisibility",
      "category": "DebugSkelMeshComponent",
      "signature": "RestoreClothSectionsVisibility(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Restore all section visibilities to original states for all LODs"
    },
    {
      "id": "get-mutable-clothing-simulation",
      "name": "GetMutableClothingSimulation",
      "category": "DebugSkelMeshComponent",
      "signature": "GetMutableClothingSimulation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "IClothingSimulation*",
      "docs": "To normal game/runtime code we don't want to expose a non-const pointer to the simulation, so we can only get\none from this editor-only component. Intended for debug options/visualisations/editor-only code to poke the sim"
    },
    {
      "id": "check-cloth-teleport",
      "name": "CheckClothTeleport",
      "category": "DebugSkelMeshComponent",
      "signature": "CheckClothTeleport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "to avoid clothing reset while modifying properties in Persona"
    },
    {
      "id": "set-mesh-section-visibility-for-cloth",
      "name": "SetMeshSectionVisibilityForCloth",
      "category": "DebugSkelMeshComponent",
      "signature": "SetMeshSectionVisibilityForCloth(Target, In Cloth Guid, Visibility)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "In Cloth Guid",
          "type": "FGuid"
        },
        {
          "name": "Visibility",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "The currently selected asset guid if we're painting, used to build dynamic mesh to paint sim parameters"
    },
    {
