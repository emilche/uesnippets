      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSelectedSocketInfo*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-allocated-size",
      "name": "GetAllocatedSize",
