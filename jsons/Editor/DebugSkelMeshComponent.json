{
  "id": "debug-skel-mesh-component",
  "label": "DebugSkelMeshComponent",
  "includepath": "Animation/DebugSkelMeshComponent.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SkeletalMesh",
    "EngineDefines",
    "SkeletalMeshComponent",
    "DelegateCombinations",
    "SkeletalMeshSceneProxy",
    "DebugSkelMeshComponent.generated"
  ],
  "functions": [
    {
      "id": "toggle-cloth-sections-visibility",
      "name": "ToggleClothSectionsVisibility",
      "category": "DebugSkelMeshComponent",
      "signature": "ToggleClothSectionsVisibility(Target, Show Only Cloth Sections)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "Show Only Cloth Sections",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "toggle visibility between cloth sections and non-cloth sections for all LODs\nif bShowOnlyClothSections is true, shows only cloth sections. On the other hand,\nif bShowOnlyClothSections is false, hides only cloth sections."
    },
    {
      "id": "restore-cloth-sections-visibility",
      "name": "RestoreClothSectionsVisibility",
      "category": "DebugSkelMeshComponent",
      "signature": "RestoreClothSectionsVisibility(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Restore all section visibilities to original states for all LODs"
    },
    {
      "id": "get-mutable-clothing-simulation",
      "name": "GetMutableClothingSimulation",
      "category": "DebugSkelMeshComponent",
      "signature": "GetMutableClothingSimulation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "IClothingSimulation*",
      "docs": "To normal game/runtime code we don't want to expose a non-const pointer to the simulation, so we can only get\none from this editor-only component. Intended for debug options/visualisations/editor-only code to poke the sim"
    },
    {
      "id": "check-cloth-teleport",
      "name": "CheckClothTeleport",
      "category": "DebugSkelMeshComponent",
      "signature": "CheckClothTeleport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "to avoid clothing reset while modifying properties in Persona"
    },
    {
      "id": "set-mesh-section-visibility-for-cloth",
      "name": "SetMeshSectionVisibilityForCloth",
      "category": "DebugSkelMeshComponent",
      "signature": "SetMeshSectionVisibilityForCloth(Target, In Cloth Guid, Visibility)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "In Cloth Guid",
          "type": "FGuid"
        },
        {
          "name": "Visibility",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "The currently selected asset guid if we're painting, used to build dynamic mesh to paint sim parameters"
    },
    {
      "id": "reset-mesh-section-visibility",
      "name": "ResetMeshSectionVisibility",
      "category": "DebugSkelMeshComponent",
      "signature": "ResetMeshSectionVisibility(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "rebuild-clothing-sections-fixed-verts",
      "name": "RebuildClothingSectionsFixedVerts",
      "category": "DebugSkelMeshComponent",
      "signature": "RebuildClothingSectionsFixedVerts(Target, Invalidate Derived Data Cache)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "Invalidate Derived Data Cache",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "rebuild-clothing-section-fixed-verts",
      "name": "RebuildClothingSectionFixedVerts",
      "category": "DebugSkelMeshComponent",
      "signature": "RebuildClothingSectionFixedVerts(Target, LOD Index, Section Index)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "LOD Index",
          "type": "Int"
        },
        {
          "name": "Section Index",
          "type": "Int"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "tick-component",
      "name": "TickComponent",
      "category": "DebugSkelMeshComponent",
      "signature": "TickComponent(Target, Delta Time, Tick Type, This Tick Function)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Tick Type",
          "type": "ELevelTick"
        },
        {
          "name": "This Tick Function",
          "type": "FActorComponentTickFunction*"
        }
      ],
      "returnType": "Void",
      "docs": "Current turn table mode"
    },
    {
      "id": "refresh-selected-clothing-skinned-positions",
      "name": "RefreshSelectedClothingSkinnedPositions",
      "category": "DebugSkelMeshComponent",
      "signature": "RefreshSelectedClothingSkinnedPositions(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-used-materials",
      "name": "GetUsedMaterials",
      "category": "DebugSkelMeshComponent",
      "signature": "GetUsedMaterials(Target, Out Materials, Get Debug Materials)",
      "params": [
        {
          "name": "Target",
          "type": "UDebugSkelMeshComponent*"
        },
        {
          "name": "Out Materials",
          "type": "TArray<UMaterialInterface*>&"
        },
        {
          "name": "Get Debug Materials",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void"
    }
  ]
}