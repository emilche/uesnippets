{
  "id": "animation-modifier-helpers",
  "label": "AnimationModifierHelpers",
  "includepath": "AnimationModifierHelpers.h",
  "includes": [
    "ClassViewerModule",
    "SWidget",
    "SBox",
    "SBoxPanel",
    "ModuleManager",
    "SharedPointer",
    "ClassViewerFilter",
    "AnimationModifier",
    "AnimationModifiersAssetUserData"
  ],
  "functions": [
    {
      "id": "is-unloaded-class-allowed",
      "name": "IsUnloadedClassAllowed",
      "category": "AnimationModifierHelpers",
      "signature": "IsUnloadedClassAllowed(Target, In Init Options, In Class, In Filter Funcs)",
      "params": [
        {
          "name": "Target",
          "type": "FModifierClassFilter*"
        },
        {
          "name": "In Init Options",
          "type": "FClassViewerInitializationOptions&"
        },
        {
          "name": "In Class",
          "type": "TSharedRef<IUnloadedBlueprintData>"
        },
        {
          "name": "In Filter Funcs",
          "type": "TSharedRef<FClassViewerFilterFuncs>"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-modifier-picker",
      "name": "GetModifierPicker",
      "category": "AnimationModifierHelpers",
      "signature": "GetModifierPicker(On Class Picked)",
      "params": [
        {
          "name": "On Class Picked",
          "type": "FOnClassPicked&"
        }
      ],
      "returnType": "TSharedRef<SWidget>"
    },
    {
      "id": "create-modifier-instance",
      "name": "CreateModifierInstance",
      "category": "AnimationModifierHelpers",
      "signature": "CreateModifierInstance(Outer, In Class, Template)",
      "params": [
        {
          "name": "Outer",
          "type": "UObject*"
        },
        {
          "name": "In Class",
          "type": "UClass*"
        },
        {
          "name": "Template",
          "type": "UObject*",
          "default": "nullptr"
        }
      ],
      "returnType": "UAnimationModifier*",
      "docs": "Creates a new Modifier instance to store with the current asset"
    },
    {
      "id": "retrieve-or-create-modifier-user-data",
      "name": "RetrieveOrCreateModifierUserData",
      "category": "AnimationModifierHelpers",
      "signature": "RetrieveOrCreateModifierUserData(Asset User Data Interface)",
      "params": [
        {
          "name": "Asset User Data Interface",
          "type": "TScriptInterface<IInterface_AssetUserData>"
        }
      ],
      "returnType": "UAnimationModifiersAssetUserData*"
    },
    {
      "id": "enumerate-animation-modifier-tags",
      "name": "EnumerateAnimationModifierTags",
      "category": "AnimationModifierHelpers",
      "signature": "EnumerateAnimationModifierTags(Tag, Callback)",
      "params": [
        {
          "name": "Tag",
          "type": "FStringView"
        },
        {
          "name": "Callback",
          "type": "Func&&"
        }
      ],
      "returnType": "template<Func> void"
    }
  ]
}