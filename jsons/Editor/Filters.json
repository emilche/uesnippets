{
  "id": "filters",
  "label": "Filters",
  "includepath": "Filters.h",
  "includes": [
    "IContentBrowserSingleton",
    "FilterBase",
    "GenericFilter",
    "FrontendFilterBase",
    "TextFilterExpressionEvaluator",
    "SharedPointer"
  ],
  "functions": [
    {
      "id": "get-name",
      "name": "GetName",
      "category": "Filters",
      "signature": "GetName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFilter_ShowRedirectors*"
        }
      ],
      "returnType": "String",
      "docs": "Returns the system name for this filter",
      "supportedTargets": [
        "FFilter_ShowRedirectors*",
        "FFilter_HideOtherDevelopers*"
      ]
    },
    {
      "id": "is-inverse-filter",
      "name": "IsInverseFilter",
      "category": "Filters",
      "signature": "IsInverseFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFilter_ShowRedirectors*"
        }
      ],
      "returnType": "Bool",
      "docs": "If true, the filter will be active in the FilterBar when it is inactive in the UI (i.e the filter pill is grayed out)"
    },
    {
      "id": "passes-filter",
      "name": "PassesFilter",
      "category": "Filters",
      "signature": "PassesFilter(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "FFilter_ShowRedirectors*"
        },
        {
          "name": "In Item",
          "type": "FAssetFilterType"
        }
      ],
      "returnType": "Bool",
      "docs": "Pass all objects - filter is just used to set backend query state.",
      "supportedTargets": [
        "FFilter_ShowRedirectors*",
        "FFilter_HideOtherDevelopers*"
      ]
    },
    {
      "id": "modify-context-menu",
      "name": "ModifyContextMenu",
      "category": "Filters",
      "signature": "ModifyContextMenu(Target, Menu Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FFilter_HideOtherDevelopers*"
        },
        {
          "name": "Menu Builder",
          "type": "FMenuBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the right-click context menu is being built for this filter"
    }
  ]
}