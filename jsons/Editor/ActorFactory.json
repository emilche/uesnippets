    {
      "id": "get-asset-from-actor-instance",
      "name": "GetAssetFromActorInstance",
      "category": "ActorFactory",
      "signature": "GetAssetFromActorInstance(Target, Actor Instance)",
      "params": [
        {
          "name": "Target",
          "type": "UActorFactory*"
        },
        {
          "name": "Actor Instance",
          "type": "AActor*"
        }
      ],
      "returnType": "UObject*",
      "docs": "Given an instance of an actor, find the wrapped asset object which can be used to create a valid FAssetData.\nReturns nullptr if the given ActorInstance is not valid for this factory.\nOverride this function if the factory actor is a different class than the asset data's class which this factory operates on.\nFor example, if this is the static mesh actor factory, the class of the asset data is UStaticMesh, but the actor factory's class is AStaticMeshActor"
    },
