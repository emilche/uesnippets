      "id": "create-actor",
      "name": "CreateActor",
      "category": "ActorFactory",
      "signature": "CreateActor(Target, In Asset, In Level, In Transform, In Spawn Params)",
      "params": [
        {
          "name": "Target",
          "type": "UActorFactory*"
        },
        {
          "name": "In Asset",
          "type": "UObject*"
        },
        {
          "name": "In Level",
          "type": "ULevel*"
        },
        {
          "name": "In Transform",
          "type": "FTransform&"
        },
        {
          "name": "In Spawn Params",
          "type": "FActorSpawnParameters&",
          "default": "FActorSpawnParameters()"
        }
      ],
      "returnType": "AActor*",
      "docs": "Called to actual create an actor with the supplied transform (scale is ignored), using the properties in the ActorFactory"
    },
