{
  "id": "sound-factory-utility",
  "label": "SoundFactoryUtility",
  "includepath": "SoundFactoryUtility.h",
  "includes": [
    "CoreMinimal",
    "EngineDefines",
    "ClassViewerFilter"
  ],
  "functions": [
    {
      "id": "is-class-allowed",
      "name": "IsClassAllowed",
      "category": "SoundFactoryUtility",
      "signature": "IsClassAllowed(Target, In Init Options, In Class, In Filter Funcs)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetClassParentFilter*"
        },
        {
          "name": "In Init Options",
          "type": "FClassViewerInitializationOptions&"
        },
        {
          "name": "In Class",
          "type": "UClass*"
        },
        {
          "name": "In Filter Funcs",
          "type": "TSharedRef<FClassViewerFilterFuncs>"
        }
      ],
      "returnType": "Bool",
      "docs": "All children of these classes will be included unless filtered out by another setting."
    },
    {
      "id": "is-unloaded-class-allowed",
      "name": "IsUnloadedClassAllowed",
      "category": "SoundFactoryUtility",
      "signature": "IsUnloadedClassAllowed(Target, In Init Options, In Unloaded Class Data, In Filter Funcs)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetClassParentFilter*"
        },
        {
          "name": "In Init Options",
          "type": "FClassViewerInitializationOptions&"
        },
        {
          "name": "In Unloaded Class Data",
          "type": "TSharedRef<IUnloadedBlueprintData>"
        },
        {
          "name": "In Filter Funcs",
          "type": "TSharedRef<FClassViewerFilterFuncs>"
        }
      ],
      "returnType": "Bool"
    }
  ]
}