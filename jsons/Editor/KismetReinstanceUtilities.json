          "type": "TMap<UClass*,UClass*>&"
        },
        {
          "name": "Old To New Name Map",
          "type": "TMap<UObject*,FName>&"
        },
        {
          "name": "Old Obj Index",
          "type": "Int"
        },
        {
          "name": "Objects To Replace",
          "type": "TArray<UObject*>&"
        },
        {
          "name": "Potential Editors For Refreshing",
          "type": "TArray<UObject*>&"
        },
        {
          "name": "Owners To Rerun Construction Script",
          "type": "TSet<AActor*>&"
        },
        {
          "name": "Get Attach Children Array",
          "type": "TFunctionRef<TArray<TObjectPtr<USceneComponent>>& ( USceneComponent* )>"
        },
        {
          "name": "Is Component",
          "type": "Bool"
        },
        {
          "name": "Archetypes Are Up To Date",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Helper to replace an instance of an object"
