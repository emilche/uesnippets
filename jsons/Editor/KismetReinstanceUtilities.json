    {
      "id": "move-cdo-to-new-class",
      "name": "MoveCDOToNewClass",
      "category": "KismetReinstanceUtilities",
      "signature": "MoveCDOToNewClass(Owner Class, Old To New Map, Avoid CDO Duplication)",
      "params": [
        {
          "name": "Owner Class",
          "type": "UClass*"
        },
        {
          "name": "Old To New Map",
          "type": "TMap<UClass*,UClass*>&"
        },
        {
          "name": "Avoid CDO Duplication",
          "type": "Bool"
        }
      ],
      "returnType": "UClass*",
      "docs": "Function used to safely discard a CDO, so that the class can have its layout changed, callers must move parent CDOs aside before moving child CDOs aside:"
    },
    {
      "id": "move-dependent-skel-to-reinst",
      "name": "MoveDependentSkelToReinst",
      "category": "KismetReinstanceUtilities",
      "signature": "MoveDependentSkelToReinst(Owner Class, Old To New Map)",
      "params": [
        {
          "name": "Owner Class",
          "type": "UClass*"
        },
        {
          "name": "Old To New Map",
          "type": "TMap<UClass*,UClass*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Moves CDOs aside to immutable versions of classes(`REINST`) so that the CDO's can safely be GC'd.\nThese `REINST` classes will be re-parented to a native parent that we know will not be churning\nthrough this function again later, so we avoid O(N^2) processing of REINST classes.\nMaps each given `SKEL` class to its appropriate `REINST` version of itself"
    },
    {
      "id": "get-sorted-class-hierarchy",
      "name": "GetSortedClassHierarchy",
      "category": "KismetReinstanceUtilities",
      "signature": "GetSortedClassHierarchy(Class To Search, Out Hierarchy, Out Native Parent)",
      "params": [
        {
          "name": "Class To Search",
          "type": "UClass*"
        },
        {
          "name": "Out Hierarchy",
          "type": "TArray<UClass*>&"
        },
        {
          "name": "Out Native Parent",
          "type": "UClass**"
        }
      ],
      "returnType": "Void",
      "docs": "Gathers the full class Hierarchy of the ClassToSearch, sorted top down (0 index being UObject, n being the subclasses)"
    },
