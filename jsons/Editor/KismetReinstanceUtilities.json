      "name": "ReplaceObjectHelper",
      "category": "KismetReinstanceUtilities",
      "signature": "ReplaceObjectHelper(Old Object, Old Class, New U Object, New Class, Old To New Instance Map, Old To New Class Map, Old To New Name Map, Old Obj Index, Objects To Replace, Potential Editors For Refreshing, Owners To Rerun Construction Script, Get Attach Children Array, Is Component, Archetypes Are Up To Date)",
      "params": [
        {
          "name": "Old Object",
          "type": "UObject*&"
        },
        {
          "name": "Old Class",
          "type": "UClass*"
        },
        {
          "name": "New U Object",
          "type": "UObject*&"
        },
        {
          "name": "New Class",
          "type": "UClass*"
        },
        {
          "name": "Old To New Instance Map",
          "type": "TMap<UObject*,UObject*>&"
        },
        {
