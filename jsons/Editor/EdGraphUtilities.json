    {
      "id": "clone-graph",
      "name": "CloneGraph",
      "category": "EdGraphUtilities",
      "signature": "CloneGraph(Source, New Outer, Message Log, Cloning For Compile)",
      "params": [
        {
          "name": "Source",
          "type": "UEdGraph*"
        },
        {
          "name": "New Outer",
          "type": "UObject*"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog*",
          "default": "NULL"
        },
        {
          "name": "Cloning For Compile",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "UEdGraph*",
      "docs": "Clones (deep copies) a UEdGraph, including all of it's nodes and pins and their links, maintaining a mapping from the clone to the source nodes (even across multiple clonings)\nA NewOuter of NULL indicates the transient package"
    },
    {
      "id": "clone-and-merge-graph-in",
      "name": "CloneAndMergeGraphIn",
      "category": "EdGraphUtilities",
      "signature": "CloneAndMergeGraphIn(Merge Target, Source Graph, Message Log, Require Schema Match, In Is Compiling, Out Cloned Nodes)",
      "params": [
        {
          "name": "Merge Target",
          "type": "UEdGraph*"
        },
        {
          "name": "Source Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog&"
        },
        {
          "name": "Require Schema Match",
          "type": "Bool"
        },
        {
          "name": "In Is Compiling",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Out Cloned Nodes",
          "type": "TArray<UEdGraphNode*>*",
          "default": "NULL"
        }
      ],
      "returnType": "Void",
      "docs": "Clones the content from SourceGraph and merges it into MergeTarget;\nincluding merging/flattening all of the children from the SourceGraph into MergeTarget\nAlso optionally populates *OutClonedNodes with the list of cloned objects.\n@param MergeTarget\t\t\t\tThe graph to merge the source graph into\n@param SourceGraph\t\t\t\tGraph to merge from\n@param MessageLog\t\t\t\tMessageLog to report errors and warnings to\n@param bRequireSchemaMatch\t\tTRUE if the graphs must have the same schema for the merge to occur\n@param OutClonedNodes\t\t\tWill populate with a full list of cloned nodes if provided\n@param bInIsCompiling\t\t\tTRUE if the function is being called during compilation, this will eliminate some nodes that will not be compiled"
    },
    {
      "id": "merge-children-graphs-in",
      "name": "MergeChildrenGraphsIn",
      "category": "EdGraphUtilities",
      "signature": "MergeChildrenGraphsIn(Merge Target, Parent Graph, Require Schema Match, In Is Compiling, Message Log)",
      "params": [
        {
          "name": "Merge Target",
          "type": "UEdGraph*"
        },
        {
          "name": "Parent Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Require Schema Match",
          "type": "Bool"
        },
        {
          "name": "In Is Compiling",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Moves the contents of all of the children graphs of ParentGraph (recursively) into the MergeTarget graph.\nThis does not clone, it's destructive to the ParentGraph"
    },
