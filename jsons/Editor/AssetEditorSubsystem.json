{
  "id": "asset-editor-subsystem",
  "label": "AssetEditorSubsystem",
  "includepath": "Subsystems/AssetEditorSubsystem.h",
  "includes": [
    "EditorSubsystem",
    "IToolkit",
    "Ticker",
    "Modes",
    "NamePermissionList",
    "AssetTypeActivationOpenedMethod",
    "MRUFavoritesList",
    "AssetDefinition",
    "AssetEditorSubsystem.generated"
  ],
  "functions": [
    {
      "id": "open-editor-for-assets",
      "name": "OpenEditorForAssets",
      "category": "Editor Scripting ",
      "signature": "OpenEditorForAssets(Target, Assets, Opened Method)",
      "params": [
        {
          "name": "Target",
          "type": "UAssetEditorSubsystem*"
        },
        {
          "name": "Assets",
          "type": "TArray<UObject*>&"
        },
        {
          "name": "Opened Method",
          "type": "EAssetTypeActivationOpenedMethod",
          "default": "EAssetTypeActivationOpenedMethod::Edit"
        }
      ],
      "returnType": "Bool",
      "docs": "Tries to open an editor for all of the specified assets.\nIf any of the assets are already open, it will not create a new editor for them.\nIf all assets are of the same type, the supporting AssetTypeAction (if it exists) is responsible for the details of how to handle opening multiple assets at once."
    },
    {
      "id": "close-all-editors-for-asset",
      "name": "CloseAllEditorsForAsset",
      "category": "Editor Scripting ",
      "signature": "CloseAllEditorsForAsset(Target, Asset)",
      "params": [
        {
          "name": "Target",
          "type": "UAssetEditorSubsystem*"
        },
        {
          "name": "Asset",
          "type": "UObject*"
        }
      ],
      "returnType": "Int",
      "docs": "Close all active editors for the supplied asset and return the number of asset editors that were closed"
    }
  ]
}