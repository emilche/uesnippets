    {
      "id": "f-package-source",
      "name": "FPackageSource",
      "category": "EditorDomain",
      "signature": "FPackageSource(Target, False, False, False, False, False)",
      "params": [
        {
          "name": "Target",
          "type": "FEditorDomain*"
        },
        {
          "name": "False",
          "type": ") : bHasSaved ("
        },
        {
          "name": "False",
          "type": "bHasLoaded ("
        },
        {
          "name": "False",
          "type": "bHasQueriedCatalog ("
