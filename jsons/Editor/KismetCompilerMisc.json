    {
      "id": "do-signatures-have-convertible-float-types",
      "name": "DoSignaturesHaveConvertibleFloatTypes",
      "category": "KismetCompilerMisc",
      "signature": "DoSignaturesHaveConvertibleFloatTypes(Source Function, Other Function)",
      "params": [
        {
          "name": "Source Function",
          "type": "UFunction*"
        },
        {
          "name": "Other Function",
          "type": "UFunction*"
        }
      ],
      "returnType": "ConvertibleSignatureMatchResult",
      "docs": "Similar to UFunction::IsSignatureCompatibleWith, but also checks if the function signatures are convertible.\nFor example, if a parameter in SourceFunction is of type float, but its corresponding type in OtherFunction is double, then the function is deemed \"convertible\".\nThis is primarily used for binding Blueprint functions with native delegate signatures that use float types."
    },
