    {
      "id": "is-type-compatible-with-property",
      "name": "IsTypeCompatibleWithProperty",
      "category": "KismetCompilerMisc",
      "signature": "IsTypeCompatibleWithProperty(Source Pin, Property, Message Log, Schema, Self Class)",
      "params": [
        {
          "name": "Source Pin",
          "type": "UEdGraphPin*"
        },
        {
          "name": "Property",
          "type": "FProperty*"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog&"
        },
        {
          "name": "Schema",
          "type": "UEdGraphSchema_K2*"
        },
        {
          "name": "Self Class",
          "type": "UClass*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tests to see if a pin is schema compatible with a property.\n@param\tSourcePin\t\tIf non-null, source object.\n@param\tProperty\t\tThe property to check.\n@param\tMessageLog  \tThe message log.\n@param\tSchema\t\t\tSchema.\n@param\tSelfClass   \tSelf class (needed for pins marked Self).\n@return\ttrue if the pin type/direction is compatible with the property."
    },
