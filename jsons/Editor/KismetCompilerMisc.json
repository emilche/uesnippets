    {
      "id": "create-property-on-scope",
      "name": "CreatePropertyOnScope",
      "category": "KismetCompilerMisc",
      "signature": "CreatePropertyOnScope(Scope, Property Name, Type, Self Class, Property Flags, Schema, Message Log, Source Pin)",
