{
  "id": "asset-registry-generator",
  "label": "AssetRegistryGenerator",
  "includepath": "Commandlets/AssetRegistryGenerator.h",
  "includes": [
    "AssetData",
    "AssetRegistryState",
    "Array",
    "Map",
    "Set",
    "UnrealString",
    "MPCollector",
    "AssetRegistryInterface",
    "Optional",
    "SharedPointer",
    "UniquePtr",
    "NameTypes",
    "Object",
    "SoftObjectPath",
    "UObjectHash"
  ],
  "functions": [
    {
      "id": "get-target-platform",
      "name": "GetTargetPlatform",
      "category": "AssetRegistryGenerator",
      "signature": "GetTargetPlatform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetRegistryGenerator*"
        }
      ],
      "returnType": "ITargetPlatform*"
    },
    {
      "id": "has-cloned-global-asset-registry",
      "name": "HasClonedGlobalAssetRegistry",
      "category": "AssetRegistryGenerator",
      "signature": "HasClonedGlobalAssetRegistry(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetRegistryGenerator*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether *this cloned the global the AssetRegistry during its construction.\nIf false, package data must be copied during UpdataAssetRegistryData."
    },
    {
      "id": "add-chunk-id-string-override",
      "name": "AddChunkIdStringOverride",
      "category": "AssetRegistryGenerator",
      "signature": "AddChunkIdStringOverride(Chunk Id, Override Name)",
      "params": [
        {
          "name": "Chunk Id",
          "type": "Int"
        },
        {
          "name": "Override Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the generated pak chunk to be named the given OverrideName rather than the chunkId. This does not update the internal asset registry number only the generated pak chunk file name."
    },
    {
      "id": "clear-chunk-id-override",
      "name": "ClearChunkIdOverride",
      "category": "AssetRegistryGenerator",
      "signature": "ClearChunkIdOverride(Chunk Id)",
      "params": [
        {
          "name": "Chunk Id",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "Removes the String Override for the given ChunkId. Returns true if an override was removed."
    },
    {
      "id": "update-asset-registry-data",
      "name": "UpdateAssetRegistryData",
      "category": "AssetRegistryGenerator",
      "signature": "UpdateAssetRegistryData(Target, Package Name, Package, Cook Result, Save Package Result, Asset Datas From Save, Override Asset Package Data, Override Package Dependencies, COTFS)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetRegistryReporterLocal*"
        },
        {
          "name": "Package Name",
          "type": "Name"
        },
        {
          "name": "Package",
          "type": "UPackage*"
        },
        {
          "name": "Cook Result",
          "type": "UE::Cook::ECookResult"
        },
        {
          "name": "Save Package Result",
          "type": "FSavePackageResultStruct*"
        },
        {
          "name": "Asset Datas From Save",
          "type": "TOptional<TArray<FAssetData>>&&"
        },
        {
          "name": "Override Asset Package Data",
          "type": "TOptional<FAssetPackageData>&&"
        },
        {
          "name": "Override Package Dependencies",
          "type": "TOptional<TArray<FAssetDependency>>&&"
        },
        {
          "name": "COTFS",
          "type": "UCookOnTheFlyServer&"
        }
      ],
      "returnType": "Void",
      "docs": "Attempts to update the metadata for a package in an asset registry generator.\nThis is only called for CookByTheBook.\n@param Package The package to update info on\n@param SavePackageResult The metadata to associate with the given package name\n@param bIncludeOnlyDiskAssets Include only disk assets or else also enumerate memory assets"
    },
    {
      "id": "get-message-type",
      "name": "GetMessageType",
      "category": "AssetRegistryGenerator",
      "signature": "GetMessageType(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetRegistryPackageMessage*"
        }
      ],
      "returnType": "FGuid",
      "supportedTargets": [
        "FAssetRegistryPackageMessage*",
        "FAssetRegistryMPCollector*"
      ]
    },
    {
      "id": "get-debug-name",
      "name": "GetDebugName",
      "category": "AssetRegistryGenerator",
      "signature": "GetDebugName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetRegistryPackageMessage*"
        }
      ],
      "returnType": "TCHAR*",
      "supportedTargets": [
        "FAssetRegistryPackageMessage*",
        "FAssetRegistryMPCollector*"
      ]
    }
  ]
}