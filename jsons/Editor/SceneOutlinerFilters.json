          "type": "TSceneOutlinerFilter*"
        },
        {
          "name": "In Item",
          "type": "T&"
        }
      ],
      "returnType": "Bool",
      "supportedTargets": [
        "TSceneOutlinerFilter*",
        "TSceneOutlinerPredicateFilter*"
      ]
    },
    {
      "id": "get-interactive-state",
      "name": "GetInteractiveState",
      "category": "SceneOutlinerFilters",
      "signature": "GetInteractiveState(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "TSceneOutlinerFilter*"
        },
        {
          "name": "In Item",
          "type": "ISceneOutlinerTreeItem&"
        }
      ],
      "returnType": "Bool",
