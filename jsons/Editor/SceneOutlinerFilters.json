        "TSceneOutlinerFilter*",
        "FSceneOutlinerFilters*"
      ]
    },
    {
      "id": "get-interactive-state-impl",
      "name": "GetInteractiveStateImpl",
      "category": "SceneOutlinerFilters",
      "signature": "GetInteractiveStateImpl(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "TSceneOutlinerFilter*"
        },
        {
          "name": "In Item",
          "type": "T&"
        }
      ],
      "returnType": "Bool",
      "supportedTargets": [
        "TSceneOutlinerFilter*",
        "TSceneOutlinerPredicateFilter*"
      ]
    },
    {
      "id": "add",
      "name": "Add",
      "category": "SceneOutlinerFilters",
      "signature": "Add(Target, Filter)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneOutlinerFilters*"
        },
        {
          "name": "Filter",
          "type": "TSharedPtr<FSceneOutlinerFilter>&"
        }
      ],
      "returnType": "Int",
      "docs": "Scene outliner filters class. This class wraps a collection of filters and allows items of any type to be tested against the entire set."
    },
    {
      "id": "add-filter-predicate",
      "name": "AddFilterPredicate",
      "category": "SceneOutlinerFilters",
      "signature": "AddFilterPredicate<T>(Target, In Filter Pred, In Default Behaviour, In Interactive Pred)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneOutlinerFilters*"
        },
        {
          "name": "In Filter Pred",
          "type": "T::FFilterPredicate"
        },
        {
          "name": "In Default Behaviour",
          "type": "FSceneOutlinerFilter::EDefaultBehaviour",
          "default": "FSceneOutlinerFilter::EDefaultBehaviour::Pass"
        },
        {
          "name": "In Interactive Pred",
          "type": "T::FInteractivePredicate",
          "default": "typename T::FInteractivePredicate()"
        }
      ],
      "returnType": "template<T> void",
      "docs": "Add a filter predicate to this filter collection"
    }
