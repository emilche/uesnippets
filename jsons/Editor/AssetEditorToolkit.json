    {
      "id": "init-asset-editor-72cfd2",
      "name": "InitAssetEditor",
      "category": "AssetEditorToolkit",
      "signature": "InitAssetEditor(Target, Mode, Init Toolkit Host, App Identifier, Standalone Default Layout, Create Default Standalone Menu, Create Default Toolbar, Objects To Edit, In Is Toolbar Focusable, In Use Small Toolbar Icons, In Open Method)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetEditorToolkit*"
        },
        {
          "name": "Mode",
          "type": "EToolkitMode::Type"
        },
        {
          "name": "Init Toolkit Host",
          "type": "TSharedPtr<IToolkitHost>&"
        },
        {
          "name": "App Identifier",
          "type": "Name"
        },
        {
          "name": "Standalone Default Layout",
          "type": "TSharedRef<FTabManager::FLayout>&"
        },
        {
          "name": "Create Default Standalone Menu",
          "type": "Bool"
        },
        {
          "name": "Create Default Toolbar",
          "type": "Bool"
        },
        {
          "name": "Objects To Edit",
          "type": "TArray<UObject*>&"
        },
        {
          "name": "In Is Toolbar Focusable",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Use Small Toolbar Icons",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Open Method",
          "type": "TOptional<EAssetOpenMethod>&",
          "default": "TOptional<EAssetOpenMethod>()"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes this asset editor.  Called immediately after construction.\nOverride PostInitAssetEditor if you need to do additional initialization\n@param\tMode\t\t\t\t\tAsset editing mode for this editor (standalone or world-centric)\n@param\tInitToolkitHost\t\t\tWhen Mode is WorldCentric, this is the level editor instance to spawn this editor within\n@param\tAppIdentifier\t\t\tWhen Mode is Standalone, this is the app identifier of the app that should host this toolkit\n@param\tStandaloneDefaultLayout\tThe default layout for a standalone asset editor\n@param\tbCreateDefaultToolbar\tThe default toolbar, which can be extended\n@param\tbCreateDefaultStandaloneMenu\tTrue if in standalone mode, the asset editor should automatically generate a default \"asset\" menu, or false if you're going to do this yourself in your derived asset editor's implementation\n@param\tObjectToEdit\t\t\tThe object to edit\n@param\tbInIsToolbarFocusable\tWhether the buttons on the default toolbar can receive keyboard focus\n@param\tbUseSmallToolbarIcons\tWhether the buttons on the default toolbar use the small icons\n@param\tInOpenMethod\t\t\tOverride whether the Asset Editor is being opened in read only or edit mode (otherwise automatically set by the asset editor subsytem for any asset editors opened through it)"
    },
