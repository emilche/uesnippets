{
  "id": "i-static-mesh-editor",
  "label": "IStaticMeshEditor",
  "includepath": "IStaticMeshEditor.h",
  "includes": [
    "CoreMinimal",
    "EngineBaseTypes",
    "AssetEditorToolkit",
    "ShapeElem"
  ],
  "functions": [
    {
      "id": "get-custom-data",
      "name": "GetCustomData",
      "category": "IStaticMeshEditor",
      "signature": "GetCustomData(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "IStaticMeshEditor*"
        },
        {
          "name": "Key",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Retrieve editor custom data. Return INDEX_NONE if the key is invalid"
    },
    {
      "id": "set-custom-data",
      "name": "SetCustomData",
      "category": "IStaticMeshEditor",
      "signature": "SetCustomData(Target, Key, Custom Data)",
      "params": [
        {
          "name": "Target",
          "type": "IStaticMeshEditor*"
        },
        {
          "name": "Key",
          "type": "Int"
        },
        {
          "name": "Custom Data",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Store the custom data using the key.\nRemark:\nThe custom data memory should be clear when the editor is close by the user, this is not persistent data.\nCurrently we use it to store the state of the editor UI to restore it properly when a refresh happen."
    },
    {
      "id": "on-static-mesh-editor-closed",
      "name": "OnStaticMeshEditorClosed",
      "category": "IStaticMeshEditor",
      "signature": "OnStaticMeshEditorClosed(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IStaticMeshEditor*"
        }
      ],
      "returnType": "FStaticMeshEditorClosedEvent&"
    },
    {
      "id": "on-register-tab-spawners",
      "name": "OnRegisterTabSpawners",
      "category": "IStaticMeshEditor",
      "signature": "OnRegisterTabSpawners(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IStaticMeshEditor*"
        }
      ],
      "returnType": "FRegisterTabSpawnersEvent&"
    },
    {
      "id": "on-unregister-tab-spawners",
      "name": "OnUnregisterTabSpawners",
      "category": "IStaticMeshEditor",
      "signature": "OnUnregisterTabSpawners(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IStaticMeshEditor*"
        }
      ],
      "returnType": "FUnregisterTabSpawnersEvent&"
    }
  ]
}