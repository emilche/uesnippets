          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Include Subclasses",
          "type": "EIncludeSubclasses",
          "default": "EIncludeSubclasses::Yes"
        }
      ],
      "returnType": "template<ExpectedAssetType> TArray<TSoftObjectPtr<ExpectedAssetType>>",
      "docs": "Get the selected assets as an array of SoftObjectPtr<T>'s."
    },
    {
