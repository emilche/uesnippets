  "functions": [
    {
      "id": "get-selected-objects",
      "name": "GetSelectedObjects",
      "category": "Tool Menus",
      "signature": "GetSelectedObjects()",
      "params": [],
      "returnType": "class FAssetViewSortManager"
    },
    {
      "id": "load-selected-objects-if-needed",
      "name": "LoadSelectedObjectsIfNeeded",
      "category": "Tool Menus",
      "signature": "LoadSelectedObjectsIfNeeded(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        }
      ],
      "returnType": "return Result",
      "docs": "Loads the selected assets (if needed) which is based on AssetViewUtils::LoadAssetsIfNeeded, this exists primarily\nfor backwards compatability.  Reliance on a black box to determine 'neededness' is not recommended, this function\nwill likely be deprecated a few versions after GetSelectedObjects."
    },
    {
      "id": "load-selected-objects",
      "name": "LoadSelectedObjects",
      "category": "Tool Menus",
      "signature": "LoadSelectedObjects(Target, Load Tags)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Load Tags",
          "type": "TSet<FName>"
        }
      ],
      "returnType": "TArray<UObject*>",
      "docs": "Loads all the selected assets and returns an array of the objects."
    }
  ]
}