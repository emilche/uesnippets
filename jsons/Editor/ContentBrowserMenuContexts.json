      "category": "Tool Menus",
      "signature": "GetSelectedObjects(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        }
      ],
      "returnType": "TArray<UObject*>"
    },
    {
      "id": "get-selected-objects-in-memory",
      "name": "GetSelectedObjectsInMemory",
      "category": "ContentBrowserMenuContexts",
      "signature": "GetSelectedObjectsInMemory(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        }
      ],
      "returnType": "template<ExpectedAssetType> TArray<ExpectedAssetType*>"
    },
    {
      "id": "load-selected-objects-if-needed",
      "name": "LoadSelectedObjectsIfNeeded",
      "category": "Tool Menus",
      "signature": "LoadSelectedObjectsIfNeeded(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        }
      ],
      "returnType": "TArray<UObject*>",
      "docs": "Loads the selected assets (if needed) which is based on AssetViewUtils::LoadAssetsIfNeeded, this exists primarily\nfor backwards compatability.  Reliance on a black box to determine 'neededness' is not recommended, this function\nwill likely be deprecated a few versions after GetSelectedObjects."
    },
    {
      "id": "load-selected-objects",
      "name": "LoadSelectedObjects",
      "category": "Tool Menus",
      "signature": "LoadSelectedObjects(Target, Load Tags)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Load Tags",
          "type": "TSet<FName>"
        }
      ],
      "returnType": "TArray<UObject*>",
      "docs": "Loads all the selected assets and returns an array of the objects."
    },
    {
      "id": "load-selected-objects-if-9ff971",
      "name": "LoadSelectedObjectsIf",
      "category": "ContentBrowserMenuContexts",
      "signature": "LoadSelectedObjectsIf(Target, Predicate Filter)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Predicate Filter",
          "type": "TFunctionRef<bool ( FAssetData& AssetData )>"
        }
      ],
      "returnType": "template<ExpectedAssetType> TArray<ExpectedAssetType*>",
      "docs": "Loads the selected assets if the PredicateFilter returns true, and returns an array of the objects."
    },
    {
      "id": "load-selected-objects-if-96541b",
      "name": "LoadSelectedObjectsIf",
      "category": "ContentBrowserMenuContexts",
      "signature": "LoadSelectedObjectsIf(Target, Load Tags, Predicate Filter)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Load Tags",
          "type": "TSet<FName>"
        },
        {
          "name": "Predicate Filter",
          "type": "TFunctionRef<bool ( FAssetData& AssetData )>"
        }
      ],
      "returnType": "template<ExpectedAssetType> TArray<ExpectedAssetType*>",
      "docs": "Loads the selected assets if the PredicateFilter returns true, and returns an array of the objects."
    },
    {
      "id": "load-first-selected-object",
      "name": "LoadFirstSelectedObject",
      "category": "ContentBrowserMenuContexts",
      "signature": "LoadFirstSelectedObject(Target, Load Tags)",
      "params": [
        {
          "name": "Target",
          "type": "UContentBrowserAssetContextMenuContext*"
        },
        {
          "name": "Load Tags",
          "type": "TSet<FName>&",
          "default": "{}"
        }
      ],
      "returnType": "template<ExpectedAssetType> ExpectedAssetType*",
      "docs": "Loads the first selected valid asset and returns it."
    },
    {
      "id": "get-selected-asset-soft-objects",
      "name": "GetSelectedAssetSoftObjects",
      "category": "ContentBrowserMenuContexts",
      "signature": "GetSelectedAssetSoftObjects(Target, Include Subclasses)",
