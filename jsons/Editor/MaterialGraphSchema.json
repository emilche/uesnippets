{
  "id": "material-graph-schema",
  "label": "MaterialGraphSchema",
  "includepath": "MaterialGraph/MaterialGraphSchema.h",
  "includes": [
    "CoreMinimal",
    "Delegate",
    "ObjectMacros",
    "EdGraphSchema",
    "MaterialGraphSchema.generated"
  ],
  "functions": [
    {
      "id": "static-get-type-id",
      "name": "StaticGetTypeId",
      "category": "MaterialGraphSchema",
      "signature": "StaticGetTypeId()",
      "params": [],
      "returnType": "Name"
    },
    {
      "id": "get-type-id",
      "name": "GetTypeId",
      "category": "MaterialGraphSchema",
      "signature": "GetTypeId(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialGraphSchemaAction_NewNode*"
        }
      ],
      "returnType": "Name",
      "supportedTargets": [
        "FMaterialGraphSchemaAction_NewNode*",
        "FMaterialGraphSchemaAction_NewFunctionCall*",
        "FMaterialGraphSchemaAction_NewComposite*",
        "FMaterialGraphSchemaAction_NewComment*",
        "FMaterialGraphSchemaAction_NewNamedRerouteUsage*",
        "FMaterialGraphSchemaAction_Paste*"
      ]
    },
    {
      "id": "perform-action",
      "name": "PerformAction",
      "category": "MaterialGraphSchema",
      "signature": "PerformAction(Target, Parent Graph, From Pin, Location, Select New Node)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialGraphSchemaAction_NewNode*"
        },
        {
          "name": "Parent Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "From Pin",
          "type": "UEdGraphPin*"
        },
        {
          "name": "Location",
          "type": "FVector2f&"
        },
        {
          "name": "Select New Node",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "UEdGraphNode*",
      "supportedTargets": [
        "FMaterialGraphSchemaAction_NewNode*",
        "FMaterialGraphSchemaAction_NewFunctionCall*",
        "FMaterialGraphSchemaAction_NewComposite*",
        "FMaterialGraphSchemaAction_NewComment*",
        "FMaterialGraphSchemaAction_NewNamedRerouteUsage*",
        "FMaterialGraphSchemaAction_Paste*"
      ]
    },
    {
      "id": "set-function-input-type",
      "name": "SetFunctionInputType",
      "category": "MaterialGraphSchema",
      "signature": "SetFunctionInputType(Target, Function Input, Material Value Type)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialGraphSchemaAction_NewNode*"
        },
        {
          "name": "Function Input",
          "type": "UMaterialExpressionFunctionInput*"
        },
        {
          "name": "Material Value Type",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the type of a Function input based on an EMaterialValueType value.\n@param\tFunctionInput\t\tThe function input to set.\n@param\tMaterialValueType\tValue type we want input to accept."
    },
    {
      "id": "spawn-node",
      "name": "SpawnNode",
      "category": "MaterialGraphSchema",
      "signature": "SpawnNode(Parent Graph, Location)",
      "params": [
        {
          "name": "Parent Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Location",
          "type": "UE::Slate::FDeprecateVector2DParameter&"
        }
      ],
      "returnType": "UEdGraphNode*"
    }
  ]
}