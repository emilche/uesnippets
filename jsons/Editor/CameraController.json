    {
      "id": "update-simulation",
      "name": "UpdateSimulation",
      "category": "CameraController",
      "signature": "UpdateSimulation(Target, User Impulse Data, Delta Time, Allow Recoil If No Impulse, Movement Speed Scale, In Out Camera Position, In Out Camera Euler, In Out Camera FOV)",
      "params": [
        {
          "name": "Target",
          "type": "FEditorCameraController*"
        },
        {
          "name": "User Impulse Data",
          "type": "FCameraControllerUserImpulseData&"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Allow Recoil If No Impulse",
          "type": "Bool"
        },
        {
          "name": "Movement Speed Scale",
          "type": "Float"
        },
        {
          "name": "In Out Camera Position",
          "type": "FVector&"
        },
        {
          "name": "In Out Camera Euler",
          "type": "FVector&"
        },
        {
          "name": "In Out Camera FOV",
          "type": "Float&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the position and orientation of the camera as well as other state (like velocity.)  Should be\ncalled every frame.\n@param\tUserImpulseData\t\t\tInput data from the user this frame\n@param\tDeltaTime\t\t\t\tTime interval since last update\n@param\tbAllowRecoilIfNoImpulse\tTrue if we should recoil FOV if needed\n@param\tMovementSpeedScale\t\tScales the speed of movement\n@param\tInOutCameraPosition\t\t[in, out] Camera position\n@param\tInOutCameraEuler\t\t[in, out] Camera orientation\n@param\tInOutCameraFOV\t\t\t[in, out] Camera field of view"
    },
