{
  "id": "sequencer-context-menus",
  "label": "SequencerContextMenus",
  "includepath": "SequencerContextMenus.h",
  "includes": [
    "CoreMinimal",
    "SequencerHotspots",
    "Sequencer",
    "SequencerClipboardReconciler",
    "ScopedTransaction",
    "MovieSceneChannelHandle",
    "RealCurve",
    "ViewModelPtr",
    "IOutlinerExtension"
  ],
  "functions": [
    {
      "id": "paste-into",
      "name": "PasteInto",
      "category": "SequencerContextMenus",
      "signature": "PasteInto(In Nodes, In Time, In Clipboard)",
      "params": [
        {
          "name": "In Nodes",
          "type": "TArray<UE::Sequencer::TViewModelPtr<UE::Sequencer::IOutlinerExtension>>"
        },
        {
          "name": "In Time",
          "type": "FFrameNumber"
        },
        {
          "name": "In Clipboard",
          "type": "TSharedPtr<FMovieSceneClipboard>",
          "default": "nullptr"
        }
      ],
      "returnType": "FPasteContextMenuArgs",
      "docs": "The sequencer"
    },
    {
      "id": "paste-at",
      "name": "PasteAt",
      "category": "SequencerContextMenus",
      "signature": "PasteAt(In Time, In Clipboard)",
      "params": [
        {
          "name": "In Time",
          "type": "FFrameNumber"
        },
        {
          "name": "In Clipboard",
          "type": "TSharedPtr<FMovieSceneClipboard>",
          "default": "nullptr"
        }
      ],
      "returnType": "FPasteContextMenuArgs",
      "docs": "Paste the clipboard at the given time, using the sequencer selection states to determine paste destinations"
    }
  ]
}