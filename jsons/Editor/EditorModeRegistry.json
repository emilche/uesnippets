      "name": "UnregisterMode",
      "category": "EditorModeRegistry",
      "signature": "UnregisterMode(Target, Mode ID)",
      "params": [
        {
          "name": "Target",
          "type": "FEditorModeRegistry*"
        },
        {
          "name": "Mode ID",
          "type": "FEditorModeID"
        }
      ],
      "returnType": "Void",
      "docs": "Unregisters an editor mode. Typically called from a module's ShutdownModule() routine.\nNote: will exit the edit mode if it is currently active.\n@param ModeID\tID of the mode to unregister"
    },
    {
