    {
      "id": "register-mode-1f4464",
      "name": "RegisterMode",
      "category": "EditorModeRegistry",
      "signature": "RegisterMode(Target, Mode ID, Factory)",
      "params": [
        {
          "name": "Target",
          "type": "FEditorModeRegistry*"
        },
        {
          "name": "Mode ID",
