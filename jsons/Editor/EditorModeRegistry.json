    },
    {
      "id": "register-mode-958f5d",
      "name": "RegisterMode",
      "category": "EditorModeRegistry",
      "signature": "RegisterMode<T>(Target, Mode ID, Name, Icon Brush, Visible, Priority Order)",
      "params": [
        {
          "name": "Target",
          "type": "FEditorModeRegistry*"
        },
        {
          "name": "Mode ID",
          "type": "FEditorModeID"
        },
        {
          "name": "Name",
          "type": "Text",
          "default": "FText()"
        },
        {
          "name": "Icon Brush",
          "type": "FSlateIcon",
          "default": "FSlateIcon()"
        },
        {
          "name": "Visible",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Priority Order",
          "type": "Int",
          "default": "MAX_int32"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "Registers an editor mode type. Typically called from a module's StartupModule() routine.\n@param ModeID\tID of the mode to register"
