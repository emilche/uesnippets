{
  "id": "asset-filter",
  "label": "AssetFilter",
  "includepath": "Filters/AssetFilter.h",
  "includes": [
    "AssetData",
    "FilterBase",
    "Text",
    "Color",
    "NameTypes",
    "ARFilter",
    "IAssetRegistry"
  ],
  "functions": [
    {
      "id": "set-backend-filter",
      "name": "SetBackendFilter",
      "category": "AssetFilter",
      "signature": "SetBackendFilter(Target, In Backend Filter)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "In Backend Filter",
          "type": "FARFilter&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-comparison-function",
      "name": "SetComparisonFunction",
      "category": "AssetFilter",
      "signature": "SetComparisonFunction(Target, In On Compare Item)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "In On Compare Item",
          "type": "FCompareItemWithClassNames"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-conversion-function",
      "name": "SetConversionFunction",
      "category": "AssetFilter",
      "signature": "SetConversionFunction(Target, In On Convert Item)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "In On Convert Item",
          "type": "FConvertItemToAssetData"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-name",
      "name": "GetName",
      "category": "AssetFilter",
      "signature": "GetName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "String",
      "docs": "Returns the system name for this filter"
    },
    {
      "id": "get-display-name",
      "name": "GetDisplayName",
      "category": "AssetFilter",
      "signature": "GetDisplayName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "Text",
      "docs": "Returns the human readable name for this filter"
    },
    {
      "id": "get-tool-tip-text",
      "name": "GetToolTipText",
      "category": "AssetFilter",
      "signature": "GetToolTipText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "Text",
      "docs": "Returns the tooltip for this filter, shown in the filters menu"
    },
    {
      "id": "get-color",
      "name": "GetColor",
      "category": "AssetFilter",
      "signature": "GetColor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "FLinearColor",
      "docs": "Returns the color this filter button will be when displayed as a button"
    },
    {
      "id": "get-icon-name",
      "name": "GetIconName",
      "category": "AssetFilter",
      "signature": "GetIconName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "Name",
      "docs": "Returns the name of the icon to use in menu entries"
    },
    {
      "id": "is-inverse-filter",
      "name": "IsInverseFilter",
      "category": "AssetFilter",
      "signature": "IsInverseFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the filter should be in the list when disabled and not in the list when enabled"
    },
    {
      "id": "passes-filter",
      "name": "PassesFilter",
      "category": "AssetFilter",
      "signature": "PassesFilter(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "In Item",
          "type": "FilterType"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "active-state-changed",
      "name": "ActiveStateChanged",
      "category": "AssetFilter",
      "signature": "ActiveStateChanged(Target, Active)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "Active",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Notification that the filter became active or inactive"
    },
    {
      "id": "modify-context-menu",
      "name": "ModifyContextMenu",
      "category": "AssetFilter",
      "signature": "ModifyContextMenu(Target, Menu Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "Menu Builder",
          "type": "FMenuBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the right-click context menu is being built for this filter"
    },
    {
      "id": "save-settings",
      "name": "SaveSettings",
      "category": "AssetFilter",
      "signature": "SaveSettings(Target, Ini Filename, Ini Section, Settings String)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "Ini Filename",
          "type": "String&"
        },
        {
          "name": "Ini Section",
          "type": "String&"
        },
        {
          "name": "Settings String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Can be overriden for custom FilterBar subclasses to save settings, currently not implemented in any gneeric Filter Bar"
    },
    {
      "id": "load-settings",
      "name": "LoadSettings",
      "category": "AssetFilter",
      "signature": "LoadSettings(Target, Ini Filename, Ini Section, Settings String)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetFilter*"
        },
        {
          "name": "Ini Filename",
          "type": "String&"
        },
        {
          "name": "Ini Section",
          "type": "String&"
        },
        {
          "name": "Settings String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Can be overriden for custom FilterBar subclasses to load settings, currently not implemented in any gneeric Filter Bar"
    }
  ]
}