      "params": [],
      "returnType": "template<FromType,ToType> int16",
      "docs": "Compute the ptr offset from one class to another in an inheritance hierarchy.\n@note: This can be negative for situations where multiple inheritance would put\nthe FromType class after the ToType in memory."
    },
    {
      "id": "compute-start-offset",
