  ],
  "functions": [
    {
      "id": "add-interactor",
      "name": "AddInteractor",
      "category": "ViewportWorldInteraction",
      "signature": "AddInteractor(Target, Interactor)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "Interactor",
          "type": "UViewportInteractor*"
        }
      ],
      "returnType": "Void",
      "docs": "Adds interactor to the worldinteraction"
    },
    {
      "id": "remove-interactor",
      "name": "RemoveInteractor",
      "category": "ViewportWorldInteraction",
      "signature": "RemoveInteractor(Target, Interactor)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "Interactor",
          "type": "UViewportInteractor*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes interactor from the worldinteraction and removes the interactor from its paired interactor if any"
    },
    {
      "id": "add-actor-to-exclude-from-hit-tests",
      "name": "AddActorToExcludeFromHitTests",
      "category": "ViewportWorldInteraction",
      "signature": "AddActorToExcludeFromHitTests(Target, Actor To Exclude From Hit Tests)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "Actor To Exclude From Hit Tests",
          "type": "AActor*"
        }
      ],
      "returnType": "Void",
      "docs": "Adds an actor to the list of actors to never allow an interactor to hit in the scene.  No selection.  No hover.\nThere's no need to remove actors from this list.  They'll expire from it automatically when destroyed.\n@param\tActorToExcludeFromHitTests\tThe actor that should be forever excluded from hit tests"
    },
    {
      "id": "get-room-transform",
      "name": "GetRoomTransform",
      "category": "ViewportWorldInteraction",
      "signature": "GetRoomTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Gets the world space transform of the calibrated VR room origin.  When using a seated VR device, this will feel like the\ncamera's world transform (before any HMD positional or rotation adjustments are applied.)"
    },
    {
      "id": "get-room-space-head-transform",
      "name": "GetRoomSpaceHeadTransform",
      "category": "ViewportWorldInteraction",
      "signature": "GetRoomSpaceHeadTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Gets the transform of the viewport / user's HMD in room space"
    },
    {
      "id": "get-head-transform",
      "name": "GetHeadTransform",
      "category": "ViewportWorldInteraction",
      "signature": "GetHeadTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Gets the transform of the viewport / user's HMD in world space"
    },
    {
      "id": "set-head-transform",
      "name": "SetHeadTransform",
      "category": "ViewportWorldInteraction",
      "signature": "SetHeadTransform(Target, New Head Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "New Head Transform",
          "type": "FTransform&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets a new transform for the room so that the HMD is aligned to the new transform.\nThe Head is kept level to the ground and only rotated on the yaw"
    },
    {
      "id": "set-room-transform-for-next-frame",
      "name": "SetRoomTransformForNextFrame",
      "category": "ViewportWorldInteraction",
      "signature": "SetRoomTransformForNextFrame(Target, New Room Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "New Room Transform",
          "type": "FTransform&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-world-scale-factor",
      "name": "GetWorldScaleFactor",
      "category": "ViewportWorldInteraction",
      "signature": "GetWorldScaleFactor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the world scale factor, which can be multiplied by a scale vector to convert to room space"
    },
    {
      "id": "set-world-to-meters-scale",
      "name": "SetWorldToMetersScale",
      "category": "ViewportWorldInteraction",
      "signature": "SetWorldToMetersScale(Target, New World To Meters Scale, Compensate Room World Scale)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        },
        {
          "name": "New World To Meters Scale",
          "type": "Float"
        },
        {
          "name": "Compensate Room World Scale",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Sets GNewWorldToMetersScale"
    },
    {
      "id": "get-transform-gizmo-actor",
      "name": "GetTransformGizmoActor",
      "category": "ViewportWorldInteraction",
      "signature": "GetTransformGizmoActor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "class ABaseTransformGizmo*",
      "docs": "Gets the transform gizmo actor, or returns null if we currently don't have one"
    },
    {
      "id": "get-interactors",
      "name": "GetInteractors",
      "category": "ViewportWorldInteraction",
      "signature": "GetInteractors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UViewportWorldInteraction*"
        }
      ],
      "returnType": "TArray<UViewportInteractor*>&",
      "docs": "Gets all the interactors"
    }
  ]
