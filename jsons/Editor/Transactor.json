    {
      "id": "begin",
      "name": "Begin",
      "category": "Transactor",
      "signature": "Begin(Target, Session Context, Return)",
      "params": [
        {
          "name": "Target",
          "type": "UTransactor*"
        },
        {
          "name": "Session Context",
          "type": "TCHAR*"
        },
        {
          "name": "Return",
          "type": "FText& Description ) PURE_VIRTUAL ( UTransactor::Begin,"
        }
      ],
      "returnType": "Int",
      "docs": "Begins a new undo transaction.  An undo transaction is defined as all actions\nwhich take place when the user selects \"undo\" a single time.\nIf there is already an active transaction in progress, increments that transaction's\naction counter instead of beginning a new transaction.\n@param\tSessionContext\tthe context for the undo session; typically the tool/editor that cause the undo operation\n@param\tDescription\t\tthe description for the undo session;  this is the text that\nwill appear in the \"Edit\" menu next to the Undo item\n@return\tNumber of active actions when Begin() was called;  values greater than\n0 indicate that there was already an existing undo transaction in progress."
    },
    {
      "id": "end",
      "name": "End",
      "category": "Transactor",
      "signature": "End(Target, Return)",
      "params": [
        {
          "name": "Target",
          "type": "UTransactor*"
        },
        {
          "name": "Return",
          "type": ") PURE_VIRTUAL ( UTransactor::End,"
        }
      ],
      "returnType": "Int",
      "docs": "Attempts to close an undo transaction.  Only successful if the transaction's action\ncounter is 1.\n@return\tNumber of active actions when End() was called; a value of 1 indicates that the\ntransaction was successfully closed"
    },
