{
  "id": "curve-editor-tree-filter",
  "label": "CurveEditorTreeFilter",
  "includepath": "Tree/CurveEditorTreeFilter.h",
  "includes": [
    "Array",
    "ArrayView",
    "ContainerAllocationPolicies",
    "ContainersFwd",
    "UnrealString",
    "Platform",
    "Text",
    "CString",
    "EnumClassFlags",
    "SharedPointer",
    "UnrealTemplate"
  ],
  "functions": [
    {
      "id": "get-type",
      "name": "GetType",
      "category": "CurveEditorTreeFilter",
      "signature": "GetType(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeFilter*"
        }
      ],
      "returnType": "ECurveEditorTreeFilterType",
      "docs": "@return The type of this filter as registered by RegisterFilterType"
    },
    {
      "id": "get-filter-pass",
      "name": "GetFilterPass",
      "category": "CurveEditorTreeFilter",
      "signature": "GetFilterPass(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeFilter*"
        }
      ],
      "returnType": "Int",
      "docs": "@return The pass index that should be used when applying this filter"
    },
    {
      "id": "should-expand-on-match",
      "name": "ShouldExpandOnMatch",
      "category": "CurveEditorTreeFilter",
      "signature": "ShouldExpandOnMatch(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return If tree paths should be expanded down to matched items"
    },
    {
      "id": "match",
      "name": "Match",
      "category": "CurveEditorTreeFilter",
      "signature": "Match(Target, In String)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeTextFilterToken*"
        },
        {
          "name": "In String",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Bool",
      "docs": "The static type of this filter as retrieved by RegisterFilterType"
    },
    {
      "id": "is-any-match",
      "name": "IsAnyMatch",
      "category": "CurveEditorTreeFilter",
      "signature": "IsAnyMatch(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchResult*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether this result is a partial or total match. Returns false if any match has failed."
    },
    {
      "id": "is-partial-match",
      "name": "IsPartialMatch",
      "category": "CurveEditorTreeFilter",
      "signature": "IsPartialMatch(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchResult*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether this result matched, but still has tokens left to match"
    },
    {
      "id": "is-total-match",
      "name": "IsTotalMatch",
      "category": "CurveEditorTreeFilter",
      "signature": "IsTotalMatch(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMatchResult*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether this result has completely matched all tokens"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "CurveEditorTreeFilter",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeTextFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether this filter is empty (ie, has no filter terms)"
    },
    {
      "id": "get-terms",
      "name": "GetTerms",
      "category": "CurveEditorTreeFilter",
      "signature": "GetTerms(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCurveEditorTreeTextFilter*"
        }
      ],
      "returnType": "TArrayView<FCurveEditorTreeTextFilterTerm>",
      "docs": "Access all the filter terms contained within this filter. Each term comprises an array of text tokens that must match from child to parent.\nValid to call if IsEmpty() == true, but the resulting array view will be empty."
    }
  ]
}