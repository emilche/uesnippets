      "name": "Make",
      "category": "SSkeletonAnimNotifies",
      "signature": "Make(Notify Name, In Is Sync Marker, In Item Flags)",
      "params": [
        {
          "name": "Notify Name",
          "type": "Name&"
        },
        {
          "name": "In Is Sync Marker",
          "type": "Bool"
        },
        {
          "name": "In Item Flags",
          "type": "EAnimNotifyFilterFlags"
        }
      ],
