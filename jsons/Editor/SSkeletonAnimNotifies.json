      "docs": "Handle to editable text block for rename"
    },
    {
      "id": "get-filter-text",
      "name": "GetFilterText",
      "category": "SSkeletonAnimNotifies",
      "signature": "GetFilterText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSkeletonAnimNotifies*"
        }
      ],
      "returnType": "Text&",
      "docs": "Accessor so our rows can grab the filter text for highlighting"
    },
    {
      "id": "get-referencer-name",
      "name": "GetReferencerName",
      "category": "SSkeletonAnimNotifies",
      "signature": "GetReferencerName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSkeletonAnimNotifies*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "is-selected",
      "name": "IsSelected",
      "category": "SSkeletonAnimNotifies",
      "signature": "IsSelected(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSkeletonAnimNotifies*"
        }
      ],
      "returnType": "Bool",
      "docs": "Dummy handler to stop editable text boxes swallowing our list selected events"
    }
  ]
