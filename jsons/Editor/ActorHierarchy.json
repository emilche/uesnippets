{
  "id": "actor-hierarchy",
  "label": "ActorHierarchy",
  "includepath": "ActorHierarchy.h",
  "includes": [
    "CoreMinimal",
    "ISceneOutlinerHierarchy",
    "Folder"
  ],
  "functions": [
    {
      "id": "create-items",
      "name": "CreateItems",
      "category": "ActorHierarchy",
      "signature": "CreateItems(Target, Out Items)",
      "params": [
        {
          "name": "Target",
          "type": "FActorHierarchy*"
        },
        {
          "name": "Out Items",
          "type": "TArray<FSceneOutlinerTreeItemPtr>&"
        }
      ],
      "returnType": "Void",
      "docs": "Create a linearization of all applicable items in the hierarchy"
    },
    {
      "id": "create-children",
      "name": "CreateChildren",
      "category": "ActorHierarchy",
      "signature": "CreateChildren(Target, Item, Out Children)",
      "params": [
        {
          "name": "Target",
          "type": "FActorHierarchy*"
        },
        {
          "name": "Item",
          "type": "FSceneOutlinerTreeItemPtr&"
        },
        {
          "name": "Out Children",
          "type": "TArray<FSceneOutlinerTreeItemPtr>&"
        }
      ],
      "returnType": "Void",
      "docs": "Create a linearization of all direct and indirect children of a given item in the hierarchy"
    },
    {
      "id": "find-or-create-parent-item",
      "name": "FindOrCreateParentItem",
      "category": "ActorHierarchy",
      "signature": "FindOrCreateParentItem(Target, Item, Items, Create)",
      "params": [
        {
          "name": "Target",
          "type": "FActorHierarchy*"
        },
        {
          "name": "Item",
          "type": "ISceneOutlinerTreeItem&"
        },
        {
          "name": "Items",
          "type": "TMap<FSceneOutlinerTreeItemID,FSceneOutlinerTreeItemPtr>&"
        },
        {
          "name": "Create",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "FSceneOutlinerTreeItemPtr",
      "docs": "Forcibly create a parent item for a given tree item"
    }
  ]
}