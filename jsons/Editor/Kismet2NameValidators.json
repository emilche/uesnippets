          "type": "EValidatorResult"
        }
      ],
      "returnType": "Text",
      "docs": "@return A text string describing the type of error in ErrorCode for Name"
    },
    {
      "id": "find-valid-string",
      "name": "FindValidString",
      "category": "Kismet2NameValidators",
      "signature": "FindValidString(Target, In Out Name)",
      "params": [
        {
          "name": "Target",
          "type": "INameValidatorInterface*"
        },
        {
          "name": "In Out Name",
          "type": "String&"
        }
      ],
      "returnType": "EValidatorResult",
      "docs": "@return Ok if was valid and doesn't require anything, AlreadyInUse if was already in use and is replaced with new one"
    },
    {
      "id": "blueprint-object-name-is-unique",
      "name": "BlueprintObjectNameIsUnique",
      "category": "Kismet2NameValidators",
      "signature": "BlueprintObjectNameIsUnique(Blueprint, Name)",
      "params": [
        {
          "name": "Blueprint",
          "type": "UBlueprint*"
        },
        {
          "name": "Name",
          "type": "Name&"
        }
      ],
      "returnType": "Bool",
      "docs": "Helper method to see if object exists with this name in the blueprint. Useful for\ntesting for name conflicts with objects create with Blueprint as their outer\n@param Blueprint\tThe blueprint to check\n@param Name\t\tThe name to check for conflicts\n@return True if name is not used by object in the blueprint, False otherwise"
    },
    {
