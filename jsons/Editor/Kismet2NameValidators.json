      "name": "GetMaximumNameLength",
      "category": "Kismet2NameValidators",
      "signature": "GetMaximumNameLength()",
      "params": [],
      "returnType": "Int",
      "docs": "Return the name validator maximum string length"
    },
    {
      "id": "is-valid",
      "name": "IsValid",
      "category": "Kismet2NameValidators",
      "signature": "IsValid(Target, Name, Original)",
      "params": [
        {
          "name": "Target",
          "type": "FKismetNameValidator*"
        },
        {
          "name": "Name",
          "type": "String&"
        },
        {
          "name": "Original",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "EValidatorResult",
      "docs": "@return true if FString is valid, false otherwise"
