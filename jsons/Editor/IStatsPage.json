{
  "id": "i-stats-page",
  "label": "IStatsPage",
  "includepath": "IStatsPage.h",
  "includes": [
    "CoreMinimal",
    "IStatsViewer"
  ],
  "functions": [
    {
      "id": "add-entry",
      "name": "AddEntry",
      "category": "IStatsPage",
      "signature": "AddEntry(Target, In Entry)",
      "params": [
        {
          "name": "Target",
          "type": "IStatsPage*"
        },
        {
          "name": "In Entry",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a stats entry to the page\nNot all pages have to override this - only ones that accept transient data output\nfrom processes that do not persist in the editor"
    },
    {
      "id": "on-show",
      "name": "OnShow",
      "category": "IStatsPage",
      "signature": "OnShow(Target, In Parent Stats Viewer)",
      "params": [
        {
          "name": "Target",
          "type": "IStatsPage*"
        },
        {
          "name": "In Parent Stats Viewer",
          "type": "TWeakPtr<IStatsViewer>"
        }
      ],
      "returnType": "Void",
      "docs": "Called back each time the page is shown\n@param\tInParentStatsViewer\tThe parent stats viewer"
    },
    {
      "id": "on-hide",
      "name": "OnHide",
      "category": "IStatsPage",
      "signature": "OnHide(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IStatsPage*"
        }
      ],
      "returnType": "Void",
      "docs": "Called back each time the page is hidden"
    }
  ]
}