          "name": "Tool Identifier",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Subclasses can override this to add additional checks on whether a tool should be allowed to start.\nBy default the check disallows starting tools during play/simulate in editor."
    },
