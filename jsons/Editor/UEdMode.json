    {
      "id": "register-tool",
      "name": "RegisterTool",
      "category": "UEdMode",
      "signature": "RegisterTool(Target, UI Command, Tool Identifier, Builder, Tool Scope)",
      "params": [
        {
          "name": "Target",
          "type": "UEdMode*"
        },
        {
          "name": "UI Command",
          "type": "TSharedPtr<FUICommandInfo>"
        },
        {
          "name": "Tool Identifier",
          "type": "String"
        },
        {
          "name": "Builder",
          "type": "UInteractiveToolBuilder*"
        },
        {
          "name": "Tool Scope",
          "type": "EToolsContextScope",
          "default": "EToolsContextScope::Default"
        }
      ],
      "returnType": "Void",
      "docs": "Registers and maps the provided UI command to actions that start / stop a given tool.\nLater on this UI command can be referenced to add the tool to a toolbar.\n@param\tUICommand\t\tCommand to map tool start / stop actions to\n@param\tToolIdentifier\tUnique string identifier for the tool, used to check if tool is active\n@param\tBuilder\t\t\tBuilder for tool to be used by actions\n@param\tToolScope\t\tScope to determine lifetime of tool (Editor, Mode, etc)"
    },
    {
      "id": "should-tool-start-be-allowed",
      "name": "ShouldToolStartBeAllowed",
      "category": "UEdMode",
      "signature": "ShouldToolStartBeAllowed(Target, Tool Identifier)",
      "params": [
