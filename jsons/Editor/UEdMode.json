    {
      "id": "compute-bounding-box-for-viewport-focus",
      "name": "ComputeBoundingBoxForViewportFocus",
      "category": "UEdMode",
      "signature": "ComputeBoundingBoxForViewportFocus(Target, Actor, Primitive Component, In Out Box)",
      "params": [
        {
          "name": "Target",
          "type": "UEdMode*"
        },
        {
          "name": "Actor",
          "type": "AActor*"
        },
        {
          "name": "Primitive Component",
          "type": "UPrimitiveComponent*"
        },
        {
          "name": "In Out Box",
          "type": "FBox&"
        }
      ],
      "returnType": "Bool",
      "docs": "Allows an editor mode to override the bounding box used to focus the viewport on an editor selection.\nNote: Not used when HasCustomViewportFocus() returns true.\n@param Actor\t\t\tThe selected actor that is being considered for focus\n@param PrimitiveComponent\tThe component in the actor being considered for focus\n@param InOutBox\t\tThe box that should be computed for the actor and component\n@return bool\t\t\ttrue if the mode overrides the box and populated InOutBox, false if it did not populate InOutBox"
    },
