    {
      "id": "get-component-template",
      "name": "GetComponentTemplate",
      "category": "SSCSEditor",
      "signature": "GetComponentTemplate(Target, Even If Pending Kill)",
      "params": [
        {
          "name": "Target",
          "type": "FSCSEditorTreeNode*"
        },
        {
          "name": "Even If Pending Kill",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "UActorComponent*",
      "docs": "@param\tbEvenIfPendingKill\tIf false, nullptr will be returned if the cached component template is pending kill.\nIf true, it will be returned regardless (this is used for recaching the component template if the objects\nhave been reinstanced following construction script execution).\n@note\tDeliberately non-virtual, for performance reasons.\n@warning This will not return the right component for components overridden by the inherited component handler, you need to call GetOrCreateEditableComponentTemplate instead\n@return\tThe component template or instance represented by this node, if it's a component node."
    },
    {
      "id": "get-object",
      "name": "GetObject",
      "category": "SSCSEditor",
      "signature": "GetObject(Target, Even If Pending Kill)",
      "params": [
        {
          "name": "Target",
          "type": "FSCSEditorTreeNode*"
        },
        {
          "name": "Even If Pending Kill",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "template<class T> T*",
      "docs": "@param\tbEvenIfPendingKill\tIf false, nullptr will be returned if the cached object instance is pending kill.\nIf true, it will be returned regardless (this is used for recaching the object if the objects\nhave been reinstanced following construction script execution).\n@note\tDeliberately non-virtual, for performance reasons.\n@return\tA read-only reference to the object represented by this node."
    },
