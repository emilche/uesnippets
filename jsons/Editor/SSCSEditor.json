      "id": "get-or-create-editable-component-template",
      "name": "GetOrCreateEditableComponentTemplate",
      "category": "SSCSEditor",
      "signature": "GetOrCreateEditableComponentTemplate(Target, Actual Edited Blueprint)",
      "params": [
        {
          "name": "Target",
          "type": "FSCSEditorTreeNode*"
        },
        {
          "name": "Actual Edited Blueprint",
          "type": "UBlueprint*"
        }
      ],
      "returnType": "UActorComponent*",
      "docs": "@param ActualEditedBlueprint currently edited blueprint\n@note Derived classes should override GetOrCreateEditableObjectForBlueprint().\n@return The component template that can be editable for actual class."
    },
