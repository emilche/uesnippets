    "SCompoundWidget",
    "SBoxPanel"
  ],
  "functions": [
    {
      "id": "tick",
      "name": "Tick",
      "category": "SDocumentationToolTip",
      "signature": "Tick(Target, Allotted Geometry, In Current Time, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "SDocumentationToolTip*"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "In Current Time",
          "type": "Double"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "is-interactive",
      "name": "IsInteractive",
      "category": "SDocumentationToolTip",
      "signature": "IsInteractive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDocumentationToolTip*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "add-documentation",
      "name": "AddDocumentation",
      "category": "SDocumentationToolTip",
      "signature": "AddDocumentation(Target, Vertical Box)",
      "params": [
        {
          "name": "Target",
          "type": "SDocumentationToolTip*"
        },
        {
          "name": "Vertical Box",
          "type": "TSharedPtr<SVerticalBox>"
        }
      ],
      "returnType": "Void",
      "docs": "Adds slots to the provided Vertical Box containing the documentation information.\nIf you specify not to add it (AddDocumentation = false) you may call this externally to do custom tooltip layout\n@param\tVerticalBox\tThe vertical box to add it to"
    },
    {
      "id": "compute-desired-size",
      "name": "ComputeDesiredSize",
      "category": "SDocumentationToolTip",
      "signature": "ComputeDesiredSize(Target, Layout Scale Multiplier)",
      "params": [
        {
          "name": "Target",
          "type": "SDocumentationToolTip*"
        },
        {
          "name": "Layout Scale Multiplier",
          "type": "Float"
        }
      ],
      "returnType": "FVector2D"
    },
    {
      "id": "get-overridden-full-tool-tip-visibility",
      "name": "GetOverriddenFullToolTipVisibility",
      "category": "SDocumentationToolTip",
      "signature": "GetOverriddenFullToolTipVisibility(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDocumentationToolTip*"
        }
      ],
      "returnType": "EVisibility"
    }
  ]
