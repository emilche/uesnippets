{
  "id": "component-type-registry",
  "label": "ComponentTypeRegistry",
  "includepath": "ComponentTypeRegistry.h",
  "includes": [
    "CoreMinimal",
    "SubclassOf",
    "ActorComponent"
  ],
  "functions": [
    {
      "id": "get",
      "name": "Get",
      "category": "ComponentTypeRegistry",
      "signature": "Get()",
      "params": [],
      "returnType": "FComponentTypeRegistry&",
      "docs": "Name of the component, as typed by the user"
    },
    {
      "id": "subscribe-to-component-list",
      "name": "SubscribeToComponentList",
      "category": "ComponentTypeRegistry",
      "signature": "SubscribeToComponentList(Target, Out Component List)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentTypeRegistry*"
        },
        {
          "name": "Out Component List",
          "type": "TArray<FComponentClassComboEntryPtr>*&"
        }
      ],
      "returnType": "FOnComponentTypeListChanged&",
      "docs": "Called when the user changes the text in the search box.\n@OutComponentList Pointer that will be set to the (globally shared) component type list\n@return Deleate that can be used to handle change notifications. change notifications are raised when entries are\nadded or removed from the component type list"
    },
    {
      "id": "get-on-component-type-list-changed",
      "name": "GetOnComponentTypeListChanged",
      "category": "ComponentTypeRegistry",
      "signature": "GetOnComponentTypeListChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentTypeRegistry*"
        }
      ],
      "returnType": "FOnComponentTypeListChanged&"
    },
    {
      "id": "invalidate-class",
      "name": "InvalidateClass",
      "category": "ComponentTypeRegistry",
      "signature": "InvalidateClass(Target, Class To Update)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentTypeRegistry*"
        },
        {
          "name": "Class To Update",
          "type": "TSubclassOf<UActorComponent>"
        }
      ],
      "returnType": "Void",
      "docs": "Called when a specific class has been updated and should force the component type registry to update as well"
    },
    {
      "id": "invalidate",
      "name": "Invalidate",
      "category": "ComponentTypeRegistry",
      "signature": "Invalidate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentTypeRegistry*"
        }
      ],
      "returnType": "Void",
      "docs": "Schedules a full update of the component type registry on the next frame"
    },
    {
      "id": "find-class-entry-for-object-path",
      "name": "FindClassEntryForObjectPath",
      "category": "ComponentTypeRegistry",
      "signature": "FindClassEntryForObjectPath(Target, In Object Path)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentTypeRegistry*"
        },
        {
          "name": "In Object Path",
          "type": "FTopLevelAssetPath"
        }
      ],
      "returnType": "FComponentClassComboEntryPtr",
      "docs": "Attempts to locate the class entry corresponding to the given object path."
    }
