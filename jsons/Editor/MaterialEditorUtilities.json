      "id": "create-new-material-expression",
      "name": "CreateNewMaterialExpression",
      "category": "MaterialEditorUtilities",
      "signature": "CreateNewMaterialExpression<MaterialExpressionClass>(Graph, Node Pos, Auto Select, Auto Assign Resource)",
      "params": [
        {
          "name": "Graph",
          "type": "UEdGraph*"
        },
        {
          "name": "Node Pos",
          "type": "UE::Slate::FDeprecateVector2DParameter&"
        },
        {
          "name": "Auto Select",
          "type": "Bool"
        },
        {
          "name": "Auto Assign Resource",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "template<MaterialExpressionClass> MaterialExpressionClass*",
      "docs": "Creates a new material expression of the specified class on the material represented by a graph.\n@param\tGraph\t\t\t\t\tGraph representing a material.\n@param\tNodePos\t\t\t\t\tPosition of the new node.\n@param\tbAutoSelect\t\t\t\tIf true, deselect all expressions and select the newly created one.\n@param\tbAutoAssignResource\t\tIf true, assign resources to new expression."
    },
