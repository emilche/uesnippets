      "id": "fill-export-options",
      "name": "FillExportOptions",
      "category": "FbxExporter",
      "signature": "FillExportOptions(Target, Batch Mode, Show Option Dialog, Full Path, Out Operation Canceled, Out Export All)",
      "params": [
        {
          "name": "Target",
          "type": "FFbxExporter*"
        },
        {
          "name": "Batch Mode",
          "type": "Bool"
