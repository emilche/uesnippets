      "id": "process-key-operation",
      "name": "ProcessKeyOperation",
      "category": "ISequencerTrackEditor",
      "signature": "ProcessKeyOperation(Target, In Key Time, Operation, In Sequencer, Out Results)",
      "params": [
        {
          "name": "Target",
          "type": "ISequencerTrackEditor*"
        },
        {
          "name": "In Key Time",
          "type": "FFrameNumber"
        },
        {
          "name": "Operation",
          "type": "UE::Sequencer::FKeyOperation&"
        },
        {
          "name": "In Sequencer",
          "type": "ISequencer&"
        },
        {
          "name": "Out Results",
          "type": "TArray<UE::Sequencer::FAddKeyResult>*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Add keys for the following sections based on an external value if possible\n@param InKeyTime   The time at which to add keys\n@param Operation   Structure containing all the sections and channels to key\n@param InSequencer The sequencer UI that is applying the key operation\n@param OutResults  The key handles that were added with this operation"
    },
