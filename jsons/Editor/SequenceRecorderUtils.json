{
  "id": "sequence-recorder-utils",
  "label": "SequenceRecorderUtils",
  "includepath": "SequenceRecorderUtils.h",
  "includes": [
    "CoreMinimal",
    "EngineLogs",
    "MovieScene",
    "ModuleManager",
    "PackageName",
    "AssetData",
    "AssetRegistryModule",
    "ObjectTools"
  ],
  "functions": [
    {
      "id": "make-new-group-name",
      "name": "MakeNewGroupName",
      "category": "SequenceRecorderUtils",
      "signature": "MakeNewGroupName(Base Asset Path, Base Asset Name, Existing Group Names)",
      "params": [
        {
          "name": "Base Asset Path",
          "type": "String&"
        },
        {
          "name": "Base Asset Name",
          "type": "String&"
        },
        {
          "name": "Existing Group Names",
          "type": "TArray<FName>&"
        }
      ],
      "returnType": "String",
      "docs": "Make an actor recording group name that is unique to the parent and to level sequence assets"
    },
    {
      "id": "parse-take-name",
      "name": "ParseTakeName",
      "category": "SequenceRecorderUtils",
      "signature": "ParseTakeName(In Take Name, Out Actor Name, Out Session Name, Out Take Number, In Session Name)",
      "params": [
        {
          "name": "In Take Name",
          "type": "String&"
        },
        {
          "name": "Out Actor Name",
          "type": "String&"
        },
        {
          "name": "Out Session Name",
          "type": "String&"
        },
        {
          "name": "Out Take Number",
          "type": "UInt&"
        },
        {
          "name": "In Session Name",
          "type": "String&",
          "default": "FString()"
        }
      ],
      "returnType": "Bool",
      "docs": "Parse the take number into its multiple parts"
    },
    {
      "id": "create-camera-cut-track",
      "name": "CreateCameraCutTrack",
      "category": "SequenceRecorderUtils",
      "signature": "CreateCameraCutTrack(Level Sequence, Recorded Camera Guid, Sequence ID)",
      "params": [
        {
          "name": "Level Sequence",
          "type": "ULevelSequence*"
        },
        {
          "name": "Recorded Camera Guid",
          "type": "FGuid&"
        },
        {
          "name": "Sequence ID",
          "type": "FMovieSceneSequenceID&"
        }
      ],
      "returnType": "Void",
      "docs": "Create a camera cut track for the recorded camera"
    },
    {
      "id": "extend-sequence-playback-range",
      "name": "ExtendSequencePlaybackRange",
      "category": "SequenceRecorderUtils",
      "signature": "ExtendSequencePlaybackRange(Level Sequence)",
      "params": [
        {
          "name": "Level Sequence",
          "type": "ULevelSequence*"
        }
      ],
      "returnType": "Void",
      "docs": "Extend the level sequence playback range to encompass the section ranges"
    },
    {
      "id": "save-asset",
      "name": "SaveAsset",
      "category": "SequenceRecorderUtils",
      "signature": "SaveAsset(In Object)",
      "params": [
        {
          "name": "In Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Save the asset"
    },
    {
      "id": "gather-take-info",
      "name": "GatherTakeInfo",
      "category": "SequenceRecorderUtils",
      "signature": "GatherTakeInfo(Level Sequence, Take Infos)",
      "params": [
        {
          "name": "Level Sequence",
          "type": "ULevelSequence*"
        },
        {
          "name": "Take Infos",
          "type": "TArray<FTakeInfo>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-attachment",
      "name": "GetAttachment",
      "category": "SequenceRecorderUtils",
      "signature": "GetAttachment(In Actor, Socket Name, Component Name)",
      "params": [
        {
          "name": "In Actor",
          "type": "AActor*"
        },
        {
          "name": "Socket Name",
          "type": "Name&"
        },
        {
          "name": "Component Name",
          "type": "Name&"
        }
      ],
      "returnType": "AActor*",
      "docs": "Helper function - check whether our component hierarchy has some attachment outside of its owned components"
    },
    {
      "id": "record-single-node-instance-to-animation",
      "name": "RecordSingleNodeInstanceToAnimation",
      "category": "SequenceRecorderUtils",
      "signature": "RecordSingleNodeInstanceToAnimation(Preview Component, New Asset, Show Message)",
      "params": [
        {
          "name": "Preview Component",
          "type": "USkeletalMeshComponent*"
        },
        {
          "name": "New Asset",
          "type": "UAnimSequence*"
        },
        {
          "name": "Show Message",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Play the current single node instance on the PreviewComponent from time [0, GetLength()], and record to NewAsset\n@param: PreviewComponent - this component should contains SingleNodeInstance with time-line based asset, currently support AnimSequence or AnimComposite\n@param: NewAsset - this is the asset that should be recorded. This will reset all animation data internally\n@param: bShowMessage - show a notification of new asset creation"
    },
    {
      "id": "get-timecode-source",
      "name": "GetTimecodeSource",
      "category": "SequenceRecorderUtils",
      "signature": "GetTimecodeSource()",
      "params": [],
      "returnType": "FMovieSceneTimecodeSource",
      "docs": "Get timecode source"
    }
  ]
}