          "name": "To Input Name",
          "type": "String"
        }
      ],
      "returnType": "Bool",
      "docs": "Create connection between two material expressions\n@param\tFromExpression\t\tExpression to make connection from\n@param\tFromOutputName\t\tName of output of FromExpression to make connection from. Leave empty to use first output.\n@param\tToExpression\t\tExpression to make connection to\n@param\tToInputName\t\t\tName of input of ToExpression to make connection to. Leave empty to use first input."
