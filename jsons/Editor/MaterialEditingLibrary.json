      "name": "CreateMaterialExpression",
      "category": "MaterialEditing",
      "signature": "CreateMaterialExpression(Material, Expression Class, Node Pos X, Node Pos Y)",
      "params": [
        {
          "name": "Material",
          "type": "UMaterial*"
        },
        {
          "name": "Expression Class",
          "type": "TSubclassOf<UMaterialExpression>"
        },
        {
          "name": "Node Pos X",
          "type": "Int",
          "default": "0"
        },
        {
          "name": "Node Pos Y",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "UMaterialExpression*",
      "docs": "Create a new material expression node within the supplied material\n@param\tMaterial\t\t\tMaterial asset to add an expression to\n@param\tExpressionClass\t\tClass of expression to add\n@param\tNodePosX\t\t\tX position of new expression node\n@param\tNodePosY\t\t\tY position of new expression node"
    },
    {
      "id": "duplicate-material-expression",
      "name": "DuplicateMaterialExpression",
      "category": "MaterialEditing",
      "signature": "DuplicateMaterialExpression(Material, Material Function, Expression)",
      "params": [
        {
          "name": "Material",
          "type": "UMaterial*"
        },
        {
          "name": "Material Function",
          "type": "UMaterialFunction*"
        },
        {
          "name": "Expression",
          "type": "UMaterialExpression*"
        }
      ],
      "returnType": "UMaterialExpression*",
      "docs": "Duplicates the provided material expression adding it to the same material / material function, and copying parameters.\nNote: Does not duplicate transient properties (Ex: GraphNode).\n@param\tMaterial\t\t\tMaterial asset to add an expression to\n@param\tMaterialFunction\tSpecified if adding an expression to a MaterialFunction, used as Outer for new expression object\n@param\tSourceExpression\tExpression to be duplicated"
    },
    {
