      "category": "StaticMeshImportUtils",
      "signature": "DecomposeUCXMesh(Collision Vertices, Collision Face Idx, Body Setup)",
      "params": [
        {
          "name": "Collision Vertices",
          "type": "TArray<FVector3f>&"
        },
        {
