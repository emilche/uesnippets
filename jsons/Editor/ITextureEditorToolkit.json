{
  "id": "i-texture-editor-toolkit",
  "label": "ITextureEditorToolkit",
  "includepath": "Interfaces/ITextureEditorToolkit.h",
  "includes": [
    "CoreMinimal",
    "SceneTypes",
    "AssetEditorToolkit",
    "TextureEditorSettings"
  ],
  "functions": [
    {
      "id": "toggle-fit-to-viewport",
      "name": "ToggleFitToViewport",
      "category": "ITextureEditorToolkit",
      "signature": "ToggleFitToViewport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ITextureEditorToolkit*"
        }
      ],
      "returnType": "Void",
      "docs": "Toggles the fit-to-viewport mode. If already on, will return to the last custom zoom level."
    },
    {
      "id": "is-current-zoom-mode",
      "name": "IsCurrentZoomMode",
      "category": "ITextureEditorToolkit",
      "signature": "IsCurrentZoomMode(Target, Zoom Mode)",
      "params": [
        {
          "name": "Target",
          "type": "ITextureEditorToolkit*"
        },
        {
          "name": "Zoom Mode",
          "type": "ETextureEditorZoomMode"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this is the current zoom mode. Useful for Slate bindings."
    }
  ]
}