{
  "id": "s-class-picker-dialog",
  "label": "SClassPickerDialog",
  "includepath": "Kismet2/SClassPickerDialog.h",
  "includes": [
    "CoreMinimal",
    "Visibility",
    "Reply",
    "ClassViewerModule",
    "DeclarativeSyntaxSupport",
    "SCompoundWidget",
    "UnrealEdOptions"
  ],
  "functions": [
    {
      "id": "pick-class",
      "name": "PickClass",
      "category": "SClassPickerDialog",
      "signature": "PickClass(Title Text, Class Viewer Options, Out Chosen Class, Asset Type)",
      "params": [
        {
          "name": "Title Text",
          "type": "Text&"
        },
        {
          "name": "Class Viewer Options",
          "type": "FClassViewerInitializationOptions&"
        },
        {
          "name": "Out Chosen Class",
          "type": "UClass*&"
        },
        {
          "name": "Asset Type",
          "type": "UClass*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}