    {
      "id": "load-settings",
      "name": "LoadSettings",
      "category": "ContentBrowserPluginFilters",
      "signature": "LoadSettings(Target, Ini Filename, Ini Section, Settings String)",
      "params": [
        {
          "name": "Target",
          "type": "FContentBrowserPluginFilter*"
        },
        {
          "name": "Ini Filename",
          "type": "String&"
        },
        {
          "name": "Ini Section",
          "type": "String&"
        },
        {
          "name": "Settings String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the state of a particular Content Browser is being loaded from INI"
