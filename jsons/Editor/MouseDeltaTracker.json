{
  "id": "mouse-delta-tracker",
  "label": "MouseDeltaTracker",
  "includepath": "MouseDeltaTracker.h",
  "includes": [
    "CoreMinimal",
    "InputCoreTypes",
    "UnrealWidgetFwd"
  ],
  "functions": [
    {
      "id": "start-tracking",
      "name": "StartTracking",
      "category": "MouseDeltaTracker",
      "signature": "StartTracking(Target, In Viewport Client, In X, In Y, In Input State, Nudge, Reset Drag Tool State)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "In X",
          "type": "Int"
        },
        {
          "name": "In Y",
          "type": "Int"
        },
        {
          "name": "In Input State",
          "type": "FInputEventState&"
        },
        {
          "name": "Nudge",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Reset Drag Tool State",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Begin tracking at the specified location for the specified viewport."
    },
    {
      "id": "end-tracking",
      "name": "EndTracking",
      "category": "MouseDeltaTracker",
      "signature": "EndTracking(Target, In Viewport Client)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        }
      ],
      "returnType": "Bool",
      "docs": "Called when a mouse button has been released.  If there are no other\nmouse buttons being held down, the internal information is reset."
    },
    {
      "id": "add-delta",
      "name": "AddDelta",
      "category": "MouseDeltaTracker",
      "signature": "AddDelta(Target, In Viewport Client, In Key, In Delta, In Nudge)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "In Key",
          "type": "FKey"
        },
        {
          "name": "In Delta",
          "type": "Int"
        },
        {
          "name": "In Nudge",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Adds delta movement into the tracker."
    },
    {
      "id": "get-delta",
      "name": "GetDelta",
      "category": "MouseDeltaTracker",
      "signature": "GetDelta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the current delta."
    },
    {
      "id": "get-delta-snapped",
      "name": "GetDeltaSnapped",
      "category": "MouseDeltaTracker",
      "signature": "GetDeltaSnapped(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the current snapped delta."
    },
    {
      "id": "get-absolute-delta",
      "name": "GetAbsoluteDelta",
      "category": "MouseDeltaTracker",
      "signature": "GetAbsoluteDelta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the absolute delta since dragging started."
    },
    {
      "id": "get-absolute-delta-snapped",
      "name": "GetAbsoluteDeltaSnapped",
      "category": "MouseDeltaTracker",
      "signature": "GetAbsoluteDeltaSnapped(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the absolute snapped delta since dragging started."
    },
    {
      "id": "get-screen-delta",
      "name": "GetScreenDelta",
      "category": "MouseDeltaTracker",
      "signature": "GetScreenDelta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the screen space delta since dragging started."
    },
    {
      "id": "get-raw-delta",
      "name": "GetRawDelta",
      "category": "MouseDeltaTracker",
      "signature": "GetRawDelta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the raw mouse delta in pixels since dragging started."
    },
    {
      "id": "get-drag-start-pos",
      "name": "GetDragStartPos",
      "category": "MouseDeltaTracker",
      "signature": "GetDragStartPos(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the unsnapped start position of the current mouse drag. (This will be zero if there is no drag in progress)"
    },
    {
      "id": "get-used-drag-modifier",
      "name": "GetUsedDragModifier",
      "category": "MouseDeltaTracker",
      "signature": "GetUsedDragModifier(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns if the user used a modifier to drag a selected item. (Rather than using a widget handle)"
    },
    {
      "id": "reset-used-drag-modifier",
      "name": "ResetUsedDragModifier",
      "category": "MouseDeltaTracker",
      "signature": "ResetUsedDragModifier(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets the UsedDragModifier flag"
    },
    {
      "id": "convert-movement-delta-to-drag-rot",
      "name": "ConvertMovementDeltaToDragRot",
      "category": "MouseDeltaTracker",
      "signature": "ConvertMovementDeltaToDragRot(Target, In View, In Viewport Client, In Drag Delta, Out Drag, Out Rotation, Out Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In View",
          "type": "FSceneView*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "In Drag Delta",
          "type": "FVector&"
        },
        {
          "name": "Out Drag",
          "type": "FVector&"
        },
        {
          "name": "Out Rotation",
          "type": "FRotator&"
        },
        {
          "name": "Out Scale",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Converts the delta movement to drag/rotation/scale based on the viewport type or widget axis."
    },
    {
      "id": "absolute-translation-convert-mouse-to-drag-rot",
      "name": "AbsoluteTranslationConvertMouseToDragRot",
      "category": "MouseDeltaTracker",
      "signature": "AbsoluteTranslationConvertMouseToDragRot(Target, In View, In Viewport Client, Out Drag, Out Rotation, Out Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In View",
          "type": "FSceneView*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "Out Drag",
          "type": "FVector&"
        },
        {
          "name": "Out Rotation",
          "type": "FRotator&"
        },
        {
          "name": "Out Scale",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Absolute Translation conversion from mouse position on the screen to widget axis movement/rotation."
    },
    {
      "id": "reduce-by",
      "name": "ReduceBy",
      "category": "MouseDeltaTracker",
      "signature": "ReduceBy(Target, In)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Subtracts the specified value from End and EndSnapped."
    },
    {
      "id": "using-drag-tool",
      "name": "UsingDragTool",
      "category": "MouseDeltaTracker",
      "signature": "UsingDragTool(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return\t\ttrue if a drag tool is being used by the tracker, false otherwise."
    },
    {
      "id": "has-received-delta",
      "name": "HasReceivedDelta",
      "category": "MouseDeltaTracker",
      "signature": "HasReceivedDelta(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return True if any mouse movement has happened since tracking started"
    },
    {
      "id": "set-external-movement",
      "name": "SetExternalMovement",
      "category": "MouseDeltaTracker",
      "signature": "SetExternalMovement(Target, In External Movement)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "In External Movement",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Marks that something caused the equivalent of mouse dragging, but with other means (keyboard short cut, mouse wheel).  Allows suppression of context menus with flight camera, etc"
    },
    {
      "id": "was-external-movement",
      "name": "WasExternalMovement",
      "category": "MouseDeltaTracker",
      "signature": "WasExternalMovement(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return\t\ttrue if something caused external movement of the mouse (keyboard, mouse wheel)"
    },
    {
      "id": "render-3-d-drag-tool",
      "name": "Render3DDragTool",
      "category": "MouseDeltaTracker",
      "signature": "Render3DDragTool(Target, View, PDI)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        }
      ],
      "returnType": "Void",
      "docs": "Renders the drag tool.  Does nothing if no drag tool exists."
    },
    {
      "id": "render-drag-tool",
      "name": "RenderDragTool",
      "category": "MouseDeltaTracker",
      "signature": "RenderDragTool(Target, View, Canvas)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        },
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "Canvas",
          "type": "FCanvas*"
        }
      ],
      "returnType": "Void",
      "docs": "Renders the drag tool.  Does nothing if no drag tool exists."
    },
    {
      "id": "get-tracking-widget-mode",
      "name": "GetTrackingWidgetMode",
      "category": "MouseDeltaTracker",
      "signature": "GetTrackingWidgetMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMouseDeltaTracker*"
        }
      ],
      "returnType": "UE::Widget::EWidgetMode",
      "docs": "@return \t\tthe widget mode last time this tracker object started tracking"
    }
  ]
}