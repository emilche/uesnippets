{
  "id": "drag-tool-box-select",
  "label": "DragTool_BoxSelect",
  "includepath": "DragTool_BoxSelect.h",
  "includes": [
    "CoreMinimal",
    "LevelEditorViewport",
    "EditorDragTools"
  ],
  "functions": [
    {
      "id": "start-drag",
      "name": "StartDrag",
      "category": "DragTool_BoxSelect",
      "signature": "StartDrag(Target, In Viewport Client, In Start, In Start Screen)",
      "params": [
        {
          "name": "Target",
          "type": "FDragTool_ActorBoxSelect*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "In Start",
          "type": "FVector&"
        },
        {
          "name": "In Start Screen",
          "type": "FVector2D&"
        }
      ],
      "returnType": "Void",
      "docs": "Starts a mouse drag behavior.  The start location is snapped to the editor constraints if bUseSnapping is true.\n@param\tInViewportClient\tThe viewport client in which the drag event occurred.\n@param\tInStart\t\t\t\tWhere the mouse was when the drag started."
    },
    {
      "id": "add-delta",
      "name": "AddDelta",
      "category": "DragTool_BoxSelect",
      "signature": "AddDelta(Target, In Delta)",
      "params": [
        {
          "name": "Target",
          "type": "FDragTool_ActorBoxSelect*"
        },
        {
          "name": "In Delta",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the drag tool's end location with the specified delta.  The end location is\nsnapped to the editor constraints if bUseSnapping is true.\n@param\tInDelta\t\tA delta of mouse movement."
    },
    {
      "id": "end-drag",
      "name": "EndDrag",
      "category": "DragTool_BoxSelect",
      "signature": "EndDrag(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDragTool_ActorBoxSelect*"
        }
      ],
      "returnType": "Void",
      "docs": "Ends a mouse drag behavior (the user has let go of the mouse button)."
    },
    {
      "id": "render",
      "name": "Render",
      "category": "DragTool_BoxSelect",
      "signature": "Render(Target, View, Canvas)",
      "params": [
        {
          "name": "Target",
          "type": "FDragTool_ActorBoxSelect*"
        },
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "Canvas",
          "type": "FCanvas*"
        }
      ],
      "returnType": "Void"
    }
  ]
}