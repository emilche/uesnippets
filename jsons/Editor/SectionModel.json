{
  "id": "section-model",
  "label": "SectionModel",
  "includepath": "MVVM/ViewModels/SectionModel.h",
  "includes": [
    "MovieSceneChannelHandle",
    "MovieSceneSection",
    "ViewModel",
    "ViewModelHierarchy",
    "ILayerBarExtension",
    "ITrackLaneExtension",
    "IGeometryExtension",
    "IObjectModelExtension",
    "ISelectableExtension",
    "ISnappableExtension",
    "IDraggableTrackAreaExtension",
    "IStretchableExtension",
    "LinkedOutlinerExtension",
    "IConditionableExtension",
    "DelegateCombinations",
    "ISignedObjectEventHandler",
    "ISectionEventHandler"
  ],
  "functions": [
    {
      "id": "needs-layout",
      "name": "NeedsLayout",
      "category": "SectionModel",
      "signature": "NeedsLayout(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSectionModel*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether this section model needs to be rebuilt, ie. the channel proxy is no longer valid"
    },
    {
      "id": "set-layout-channel-proxy",
      "name": "SetLayoutChannelProxy",
      "category": "SectionModel",
      "signature": "SetLayoutChannelProxy(Target, In Previous Layout Channel Proxy)",
      "params": [
        {
          "name": "Target",
          "type": "FSectionModel*"
        },
        {
          "name": "In Previous Layout Channel Proxy",
          "type": "TWeakPtr<FMovieSceneChannelProxy>"
        }
      ],
      "returnType": "Void",
      "docs": "Set the channel proxy that was most recently used to layout this section model"
    },
    {
      "id": "set-layout-row-index",
      "name": "SetLayoutRowIndex",
      "category": "SectionModel",
      "signature": "SetLayoutRowIndex(Target, In Row Index)",
      "params": [
        {
          "name": "Target",
          "type": "FSectionModel*"
        },
        {
          "name": "In Row Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the row index that was most recently used to layout this section model"
    }
  ]
}