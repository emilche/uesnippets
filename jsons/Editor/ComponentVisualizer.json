{
  "id": "component-visualizer",
  "label": "ComponentVisualizer",
  "includepath": "ComponentVisualizer.h",
  "includes": [
    "ActorComponent",
    "Array",
    "ConvexVolume",
    "CoreMinimal",
    "CoreTypes",
    "EngineBaseTypes",
    "Actor",
    "ICursor",
    "HitProxies",
    "InputCoreTypes",
    "Box",
    "MathFwd",
    "Matrix",
    "Rotator",
    "SharedPointer",
    "NameTypes",
    "ObjectMacros",
    "UnrealNames",
    "UnrealType",
    "WeakObjectPtr",
    "WeakObjectPtrTemplates",
    "EngineElementsLibrary",
    "TypedElementHandle",
    "ComponentVisualizer.generated"
  ],
  "functions": [
    {
      "id": "get-component",
      "name": "GetComponent",
      "category": "ComponentVisualizer",
      "signature": "GetComponent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentPropertyPath*"
        }
      ],
      "returnType": "UActorComponent*",
      "docs": "Gets a pointer to the component, or nullptr if it is not valid"
    },
    {
      "id": "is-valid",
      "name": "IsValid",
      "category": "ComponentVisualizer",
      "signature": "IsValid(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentPropertyPath*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines whether the property path is valid or not"
    },
    {
      "id": "set",
      "name": "Set",
      "category": "ComponentVisualizer",
      "signature": "Set(Target, Component)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentPropertyPath*"
        },
        {
          "name": "Component",
          "type": "UActorComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the component referred to by the object"
    },
    {
      "id": "should-auto-select-element-on-handle-click",
      "name": "ShouldAutoSelectElementOnHandleClick",
      "category": "ComponentVisualizer",
      "signature": "ShouldAutoSelectElementOnHandleClick(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FComponentVisualizer*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines whether, if the visualizer returns true from VisProxyHandleClick, the hitproxy element should\nbe automatically selected. By default, uses the value of Editor.ComponentVisualizer.AutoSelectComponent."
    },
    {
      "id": "notify-property-modified",
      "name": "NotifyPropertyModified",
      "category": "ComponentVisualizer",
      "signature": "NotifyPropertyModified(Component, Property, Property Change Type)",
      "params": [
        {
          "name": "Component",
          "type": "UActorComponent*"
        },
        {
          "name": "Property",
          "type": "FProperty*"
        },
        {
          "name": "Property Change Type",
          "type": "EPropertyChangeType::Type",
          "default": "EPropertyChangeType::Unspecified"
        }
      ],
      "returnType": "Void",
      "docs": "Notify that a component property has been modified"
    },
    {
      "id": "notify-properties-modified",
      "name": "NotifyPropertiesModified",
      "category": "ComponentVisualizer",
      "signature": "NotifyPropertiesModified(Component, Properties, Property Change Type)",
      "params": [
        {
          "name": "Component",
          "type": "UActorComponent*"
        },
        {
          "name": "Properties",
          "type": "TArray<FProperty*>&"
        },
        {
          "name": "Property Change Type",
          "type": "EPropertyChangeType::Type",
          "default": "EPropertyChangeType::Unspecified"
        }
      ],
      "returnType": "Void",
      "docs": "Notify that many component properties have been modified"
    }
  ]
}