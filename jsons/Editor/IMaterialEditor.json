      "category": "IMaterialEditor",
      "signature": "AddToSelection(Target, Expression)",
      "params": [
        {
          "name": "Target",
          "type": "IMaterialEditor*"
        },
        {
          "name": "Expression",
          "type": "UMaterialExpression*"
        }
      ],
      "returnType": "Void",
      "docs": "Add the specified material expression's graph node to the list of selected nodes"
    },
    {
