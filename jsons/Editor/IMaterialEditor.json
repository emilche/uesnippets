    },
    {
      "id": "mark-material-dirty",
      "name": "MarkMaterialDirty",
      "category": "IMaterialEditor",
      "signature": "MarkMaterialDirty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMaterialEditor*"
        }
