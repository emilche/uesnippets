      "params": [
        {
          "name": "Target",
          "type": "IMaterialEditor*"
        },
        {
          "name": "Expression",
          "type": "UMaterialExpression*"
        }
      ],
      "returnType": "Void",
      "docs": "Jumps to the node for this expression, if possible"
    },
    {
      "id": "delete-selected-nodes",
      "name": "DeleteSelectedNodes",
      "category": "IMaterialEditor",
      "signature": "DeleteSelectedNodes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMaterialEditor*"
        }
      ],
      "returnType": "Void",
      "docs": "Disconnects and removes the selected material graph nodes."
    },
    {
      "id": "delete-nodes",
      "name": "DeleteNodes",
      "category": "IMaterialEditor",
      "signature": "DeleteNodes(Target, Nodes To Delete)",
