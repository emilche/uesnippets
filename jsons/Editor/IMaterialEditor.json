      "signature": "GetSelectedNodes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMaterialEditor*"
        }
      ],
      "returnType": "TSet<UObject*>",
      "docs": "Get the currently selected set of nodes"
    },
