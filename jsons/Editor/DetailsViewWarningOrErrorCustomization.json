{
  "id": "details-view-warning-or-error-customization",
  "label": "DetailsViewWarningOrErrorCustomization",
  "includepath": "DetailsViewWarningOrErrorCustomization.h",
  "includes": [
    "DetailLayoutBuilder",
    "IDetailCustomization",
    "SWarningOrErrorBox"
  ],
  "functions": [
    {
      "id": "make-instance",
      "name": "MakeInstance",
      "category": "DetailsViewWarningOrErrorCustomization",
      "signature": "MakeInstance(In Category For Insertion, In Row Tag, In Warning Or Error Label, In Message Style, In Category Priority)",
      "params": [
        {
          "name": "In Category For Insertion",
          "type": "Name&"
        },
        {
          "name": "In Row Tag",
          "type": "Name&"
        },
        {
          "name": "In Warning Or Error Label",
          "type": "Text&"
        },
        {
          "name": "In Message Style",
          "type": "EMessageStyle",
          "default": "EMessageStyle::Warning"
        },
        {
          "name": "In Category Priority",
          "type": "ECategoryPriority::Type",
          "default": "ECategoryPriority::Uncommon"
        }
      ],
      "returnType": "public : TSharedRef<IDetailCustomization>",
      "docs": "Used to insert an SWarningOrErrorBox into a Details View at the top of a specified category"
    }
  ]
}