{
  "id": "frontend-filter-base",
  "label": "FrontendFilterBase",
  "includepath": "FrontendFilterBase.h",
  "includes": [
    "CoreMinimal",
    "IFilter",
    "IContentBrowserSingleton",
    "FilterBase"
  ],
  "functions": [
    {
      "id": "set-current-filter",
      "name": "SetCurrentFilter",
      "category": "FrontendFilterBase",
      "signature": "SetCurrentFilter(Target, In Source Paths, In Base Filter)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        },
        {
          "name": "In Source Paths",
          "type": "TArrayView<FName>"
        },
        {
          "name": "In Base Filter",
          "type": "FContentBrowserDataFilter&"
        }
      ],
      "returnType": "Void",
      "docs": "Invoke to set the source filter that is currently used to filter assets in the asset view"
    },
    {
      "id": "get-as-custom-text-filter",
      "name": "GetAsCustomTextFilter",
      "category": "FrontendFilterBase",
      "signature": "GetAsCustomTextFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        }
      ],
      "returnType": "TOptional<FText>",
      "docs": "If this filter is a saved custom text filter, return the text query it represents."
    },
    {
      "id": "get-color",
      "name": "GetColor",
      "category": "FrontendFilterBase",
      "signature": "GetColor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        }
      ],
      "returnType": "FLinearColor",
      "docs": "Returns the color this filter button will be when displayed as a button"
    },
    {
      "id": "get-icon-name",
      "name": "GetIconName",
      "category": "FrontendFilterBase",
      "signature": "GetIconName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        }
      ],
      "returnType": "Name",
      "docs": "Returns the name of the icon to use in menu entries"
    },
    {
      "id": "is-inverse-filter",
      "name": "IsInverseFilter",
      "category": "FrontendFilterBase",
      "signature": "IsInverseFilter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the filter should be in the list when disabled and not in the list when enabled"
    },
    {
      "id": "active-state-changed",
      "name": "ActiveStateChanged",
      "category": "FrontendFilterBase",
      "signature": "ActiveStateChanged(Target, Active)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        },
        {
          "name": "Active",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Notification that the filter became active or inactive"
    },
    {
      "id": "modify-context-menu",
      "name": "ModifyContextMenu",
      "category": "FrontendFilterBase",
      "signature": "ModifyContextMenu(Target, Menu Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        },
        {
          "name": "Menu Builder",
          "type": "FMenuBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the right-click context menu is being built for this filter"
    },
    {
      "id": "save-settings",
      "name": "SaveSettings",
      "category": "FrontendFilterBase",
      "signature": "SaveSettings(Target, Ini Filename, Ini Section, Settings String)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        },
        {
          "name": "Ini Filename",
          "type": "String&"
        },
        {
          "name": "Ini Section",
          "type": "String&"
        },
        {
          "name": "Settings String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the state of a particular Content Browser is being saved to INI"
    },
    {
      "id": "load-settings",
      "name": "LoadSettings",
      "category": "FrontendFilterBase",
      "signature": "LoadSettings(Target, Ini Filename, Ini Section, Settings String)",
      "params": [
        {
          "name": "Target",
          "type": "FFrontendFilter*"
        },
        {
          "name": "Ini Filename",
          "type": "String&"
        },
        {
          "name": "Ini Section",
          "type": "String&"
        },
        {
          "name": "Settings String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the state of a particular Content Browser is being loaded from INI"
    }
  ]
}