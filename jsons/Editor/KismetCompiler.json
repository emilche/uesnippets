    {
      "id": "move-pin-links-to-intermediate",
      "name": "MovePinLinksToIntermediate",
      "category": "KismetCompiler",
      "signature": "MovePinLinksToIntermediate(Target, Source Pin, Intermediate Pin)",
      "params": [
        {
          "name": "Target",
          "type": "FKismetCompilerContext*"
        },
        {
          "name": "Source Pin",
          "type": "UEdGraphPin&"
        },
        {
          "name": "Intermediate Pin",
          "type": "UEdGraphPin&"
        }
      ],
      "returnType": "FPinConnectionResponse",
      "docs": "Moves pin links over from the source-pin to the specified intermediate,\nand validates the result (additionally logs a redirect from the\nintermediate-pin back to the source so we can back trace for debugging, etc.)\n@param  SourcePin\t\tThe pin you want disconnected.\n@param  IntermediatePin\tThe pin you want the SourcePin's links moved to.\n@return The result from calling the schema's MovePinLinks()."
    },
    {
      "id": "copy-pin-links-to-intermediate",
      "name": "CopyPinLinksToIntermediate",
      "category": "KismetCompiler",
      "signature": "CopyPinLinksToIntermediate(Target, Source Pin, Intermediate Pin)",
      "params": [
        {
          "name": "Target",
          "type": "FKismetCompilerContext*"
        },
        {
          "name": "Source Pin",
          "type": "UEdGraphPin&"
        },
        {
          "name": "Intermediate Pin",
          "type": "UEdGraphPin&"
        }
      ],
      "returnType": "FPinConnectionResponse",
      "docs": "Copies pin links over from the source-pin to the specified intermediate,\nand validates the result (additionally logs a redirect from the\nintermediate-pin back to the source so we can back trace for debugging, etc.)\n@param  SourcePin\t\tThe pin whose links you want copied.\n@param  IntermediatePin\tThe pin you want the SourcePin's links copied to.\n@return The result from calling the schema's CopyPinLinks()."
    },
