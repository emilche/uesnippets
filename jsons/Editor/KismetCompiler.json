      "id": "spawn-intermediate-function-graph",
      "name": "SpawnIntermediateFunctionGraph",
      "category": "KismetCompiler",
      "signature": "SpawnIntermediateFunctionGraph(Target, In Desired Function Name, In Signature, Use Unique Name)",
      "params": [
        {
          "name": "Target",
          "type": "FKismetCompilerContext*"
        },
        {
          "name": "In Desired Function Name",
