{
  "id": "viewport-transformable",
  "label": "ViewportTransformable",
  "includepath": "ViewportTransformable.h",
  "includes": [
    "Array",
    "CoreMinimal",
    "Box",
    "MathFwd",
    "Transform",
    "Vector"
  ],
  "functions": [
    {
      "id": "is-unoriented-point",
      "name": "IsUnorientedPoint",
      "category": "ViewportTransformable",
      "signature": "IsUnorientedPoint(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this transformable is a single, unoriented point in space, thus never\nsupports being rotated or scaled when only a single transformable is selected."
    },
    {
      "id": "is-physically-simulated",
      "name": "IsPhysicallySimulated",
      "category": "ViewportTransformable",
      "signature": "IsPhysicallySimulated(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this transformable is a physically simulated kinematic object"
    },
    {
      "id": "should-be-carried",
      "name": "ShouldBeCarried",
      "category": "ViewportTransformable",
      "signature": "ShouldBeCarried(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this transformable should be 'carried' (moved and rotated) when dragged, if possible, instead of only translated"
    },
    {
      "id": "set-linear-velocity",
      "name": "SetLinearVelocity",
      "category": "ViewportTransformable",
      "signature": "SetLinearVelocity(Target, New Velocity)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        },
        {
          "name": "New Velocity",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "For physically simulated objects, sets the new velocity of the object"
    },
    {
      "id": "get-linear-velocity",
      "name": "GetLinearVelocity",
      "category": "ViewportTransformable",
      "signature": "GetLinearVelocity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        }
      ],
      "returnType": "FVector",
      "docs": "Get the velocity of the object"
    },
    {
      "id": "update-ignored-actor-list",
      "name": "UpdateIgnoredActorList",
      "category": "ViewportTransformable",
      "signature": "UpdateIgnoredActorList(Target, Ignored Actors)",
      "params": [
        {
          "name": "Target",
          "type": "FViewportTransformable*"
        },
        {
          "name": "Ignored Actors",
          "type": "TArray<AActor*>&"
        }
      ],
      "returnType": "Void",
      "docs": "For actor transformables, this will add it's actor to the incoming list"
