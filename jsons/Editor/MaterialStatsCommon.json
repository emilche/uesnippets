{
  "id": "material-stats-common",
  "label": "MaterialStatsCommon",
  "includepath": "MaterialStatsCommon.h",
  "includes": [
    "SceneTypes",
    "RHIDefinitions",
    "MaterialShared",
    "SlateColor"
  ],
  "functions": [
    {
      "id": "get-material",
      "name": "GetMaterial",
      "category": "MaterialStatsCommon",
      "signature": "GetMaterial(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialResourceStats*"
        }
      ],
      "returnType": "UMaterial*"
    },
    {
      "id": "is-persistent",
      "name": "IsPersistent",
      "category": "MaterialStatsCommon",
      "signature": "IsPersistent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialResourceStats*"
        }
      ],
      "returnType": "Bool",
      "docs": "Should shaders compiled for this material be saved to disk?"
    },
    {
      "id": "is-preview",
      "name": "IsPreview",
      "category": "MaterialStatsCommon",
      "signature": "IsPreview(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialResourceStats*"
        }
      ],
      "returnType": "Bool",
      "docs": "Use preview settings when compiling material. Used to avoid culling nodes behind landscape weights."
    },
    {
      "id": "requires-synchronous-compilation",
      "name": "RequiresSynchronousCompilation",
      "category": "MaterialStatsCommon",
      "signature": "RequiresSynchronousCompilation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialResourceStats*"
        }
      ],
      "returnType": "Bool",
      "docs": "Material resource stats never requires a synchronous compilation, otherwise opening up empty (newly created) material instance will block compiling default mat's shaders."
    },
    {
      "id": "get-representative-shader-types-and-descriptions",
      "name": "GetRepresentativeShaderTypesAndDescriptions",
      "category": "MaterialStatsCommon",
      "signature": "GetRepresentativeShaderTypesAndDescriptions(Out Shader Type Name And Descriptions, Target Material)",
      "params": [
        {
          "name": "Out Shader Type Name And Descriptions",
          "type": "TMap<FName,TArray<FRepresentativeShaderInfo>>&"
        },
        {
          "name": "Target Material",
          "type": "FMaterial*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "extract-matertial-stats-info",
      "name": "ExtractMatertialStatsInfo",
      "category": "MaterialStatsCommon",
      "signature": "ExtractMatertialStatsInfo(Shader Platform, Out Info, Target)",
      "params": [
        {
          "name": "Shader Platform",
          "type": "EShaderPlatform"
        },
        {
          "name": "Out Info",
          "type": "FShaderStatsInfo&"
        },
        {
          "name": "Target",
          "type": "FMaterialResource*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "is-platform-offline-compiler-available",
      "name": "IsPlatformOfflineCompilerAvailable",
      "category": "MaterialStatsCommon",
      "signature": "IsPlatformOfflineCompilerAvailable(Shader Platform)",
      "params": [
        {
          "name": "Shader Platform",
          "type": "EShaderPlatform"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-platform-offline-compiler-path",
      "name": "GetPlatformOfflineCompilerPath",
      "category": "MaterialStatsCommon",
      "signature": "GetPlatformOfflineCompilerPath(Shader Platform)",
      "params": [
        {
          "name": "Shader Platform",
          "type": "EShaderPlatform"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "get-platform-offline-compiler-settings",
      "name": "GetPlatformOfflineCompilerSettings",
      "category": "MaterialStatsCommon",
      "signature": "GetPlatformOfflineCompilerSettings(Shader Platform, SC Settings)",
      "params": [
        {
          "name": "Shader Platform",
          "type": "EShaderPlatform"
        },
        {
          "name": "SC Settings",
          "type": "FExtraShaderCompilerSettings&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "platform-needs-offline-compiler",
      "name": "PlatformNeedsOfflineCompiler",
      "category": "MaterialStatsCommon",
      "signature": "PlatformNeedsOfflineCompiler(Shader Platform)",
