    {
      "id": "get-points-within-widget-range",
      "name": "GetPointsWithinWidgetRange",
      "category": "SCurveEditorView",
      "signature": "GetPointsWithinWidgetRange(Target, Widget Rectangle, Out Points)",
      "params": [
        {
          "name": "Target",
          "type": "SCurveEditorView*"
        },
        {
          "name": "Widget Rectangle",
          "type": "FSlateRect&"
        },
        {
          "name": "Out Points",
          "type": "TArray<FCurvePointHandle>*"
        }
      ],
      "returnType": "Bool",
      "docs": "Retrieve all the curve points that overlap the specified rectangle in widget space\n@param WidgetRectangle  The rectangle to hit test against. May not hit points that would exist outside of the view's visible bounds.\n@param OutPoints        (required) pointer to an array to populate with overlapping points\n@return Whether any points were within the widget range"
    },
    {
      "id": "get-curve-within-widget-range",
      "name": "GetCurveWithinWidgetRange",
      "category": "SCurveEditorView",
      "signature": "GetCurveWithinWidgetRange(Target, Widget Rectangle, Out Points)",
      "params": [
        {
          "name": "Target",
          "type": "SCurveEditorView*"
        },
        {
          "name": "Widget Rectangle",
          "type": "FSlateRect&"
        },
        {
          "name": "Out Points",
          "type": "TArray<FCurvePointHandle>*"
        }
      ],
      "returnType": "Bool",
      "docs": "Retrieve all the curve points, if any of the interpolating points overlap the specified rectangle in widget space\n@param WidgetRectangle  The rectangle to hit test against. May not hit points that would exist outside of the view's visible bounds.\n@param OutPoints        (required) pointer to an array to populate with overlapping points\n@return Whether any points were within the widget range"
    },
    {
      "id": "get-points-then-curve-within-widget-range",
      "name": "GetPointsThenCurveWithinWidgetRange",
      "category": "SCurveEditorView",
      "signature": "GetPointsThenCurveWithinWidgetRange(Target, Widget Rectangle, Out Points)",
      "params": [
        {
          "name": "Target",
          "type": "SCurveEditorView*"
        },
        {
          "name": "Widget Rectangle",
          "type": "FSlateRect&"
        },
        {
          "name": "Out Points",
          "type": "TArray<FCurvePointHandle>*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tries to retrieve all curve points that overlap the rectangle.\nIf no points are found, selects the overlapping curves instead.\n@param WidgetRectangle  The rectangle to hit test against. May not hit points that would exist outside of the view's visible bounds.\n@param OutPoints        (required) pointer to an array to populate with overlapping points\n@return Whether anything was selected."
    },
