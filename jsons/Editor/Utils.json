{
  "id": "utils",
  "label": "Utils",
  "includepath": "Utils.h",
  "includes": [
    "CoreMinimal",
    "HitProxies",
    "Factory"
  ],
  "functions": [
    {
      "id": "draw-widget",
      "name": "DrawWidget",
      "category": "Utils",
      "signature": "DrawWidget(View, PDI, Widget Matrix, In Info 1, In Info 2, Highlight Axis, B In Mode, Hit Testing)",
      "params": [
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "Widget Matrix",
          "type": "FMatrix&"
        },
        {
          "name": "In Info 1",
          "type": "Int"
        },
        {
          "name": "In Info 2",
          "type": "Int"
        },
        {
          "name": "Highlight Axis",
          "type": "EAxisList::Type"
        },
        {
          "name": "B In Mode",
          "type": "EWidgetMovementMode"
        },
        {
          "name": "Hit Testing",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "import-object",
      "name": "ImportObject",
      "category": "Utils",
      "signature": "ImportObject<T>(Target, Outer, Name, Flags, Filename, Context, Factory, Parms, Warn)",
      "params": [
        {
          "name": "Target",
          "type": "FUnrealEdUtils*"
        },
        {
          "name": "Outer",
          "type": "UObject*"
        },
        {
          "name": "Name",
          "type": "Name"
        },
        {
          "name": "Flags",
          "type": "EObjectFlags"
        },
        {
          "name": "Filename",
          "type": "TCHAR*",
          "default": "TEXT(\"\")"
        },
        {
          "name": "Context",
          "type": "UObject*",
          "default": "NULL"
        },
        {
          "name": "Factory",
          "type": "UFactory*",
          "default": "NULL"
        },
        {
          "name": "Parms",
          "type": "TCHAR*",
          "default": "NULL"
        },
        {
          "name": "Warn",
          "type": "FFeedbackContext*",
          "default": "GWarn"
        }
      ],
      "returnType": "template<class T> T*",
      "docs": "Import an object using a UFactory."
    }
  ]
}