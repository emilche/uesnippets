    {
      "id": "new-level",
      "name": "NewLevel",
      "category": "Editor Scripting ",
      "signature": "NewLevel(Target, Asset Path, Is Partitioned World)",
      "params": [
        {
          "name": "Target",
          "type": "ULevelEditorSubsystem*"
        },
        {
          "name": "Asset Path",
          "type": "String&"
        },
        {
          "name": "Is Partitioned World",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Close the current Persistent Level (without saving it). Create a new blank Level and save it. Load the new created level.\n@param\tAssetPath\t\tAsset Path of where the level will be saved.\nie. /Game/MyFolder/MyAsset\n@param   bIsPartitionedWorld\tIf true, new map is partitioned.\n@return\tTrue if the operation succeeds."
    },
