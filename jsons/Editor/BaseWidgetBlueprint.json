      "name": "ForEachSourceWidget",
      "category": "BaseWidgetBlueprint",
      "signature": "ForEachSourceWidget(Target, Fn)",
      "params": [
        {
          "name": "Target",
          "type": "UBaseWidgetBlueprint*"
        },
        {
          "name": "Fn",
          "type": "TFunctionRef<void ( UWidget* )>"
        }
      ],
      "returnType": "Void",
      "docs": "Identical to GetAllSourceWidgets, but as an algorithm"
    }
  ]
