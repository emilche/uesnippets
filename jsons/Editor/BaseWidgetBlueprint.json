      "signature": "GetAllSourceWidgets(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UBaseWidgetBlueprint*"
        }
      ],
      "returnType": "TArray<class UWidget*>",
      "docs": "Returns collection of widgets that represent the 'source' (user edited) widgets for this\nblueprint - avoids calling virtual functions on instances and is therefore safe to use\nthroughout compilation."
    },
    {
