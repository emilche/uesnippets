{
  "id": "cloth-paint-tool-base",
  "label": "ClothPaintToolBase",
  "includepath": "ClothPaintToolBase.h",
  "includes": [
    "MeshPaintHelpers",
    "ClothPainter"
  ],
  "functions": [
    {
      "id": "get-paint-action",
      "name": "GetPaintAction",
      "category": "ClothPaintToolBase",
      "signature": "GetPaintAction(Target, In Paint Params, In Painter Settings)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "In Paint Params",
          "type": "FMeshPaintParameters&"
        },
        {
          "name": "In Painter Settings",
          "type": "UClothPainterSettings*"
        }
      ],
      "returnType": "FPerVertexPaintAction",
      "docs": "Used by the painter to request a delegate to call to apply this tool to the current mesh"
    },
    {
      "id": "input-key",
      "name": "InputKey",
      "category": "ClothPaintToolBase",
      "signature": "InputKey(Target, Adapter, In Viewport Client, In Viewport, In Key, In Event)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "Adapter",
          "type": "IMeshPaintGeometryAdapter*"
        },
        {
          "name": "In Viewport Client",
          "type": "FEditorViewportClient*"
        },
        {
          "name": "In Viewport",
          "type": "FViewport*"
        },
        {
          "name": "In Key",
          "type": "FKey"
        },
        {
          "name": "In Event",
          "type": "EInputEvent"
        }
      ],
      "returnType": "Bool",
      "docs": "Called when the user presses a key when this tool is selected"
    },
    {
      "id": "should-render-interactors",
      "name": "ShouldRenderInteractors",
      "category": "ClothPaintToolBase",
      "signature": "ShouldRenderInteractors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether or not the brush interactor should be drawn"
    },
    {
      "id": "is-per-vertex",
      "name": "IsPerVertex",
      "category": "ClothPaintToolBase",
      "signature": "IsPerVertex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether this action should be executed once for each vertex in the brush or just once per operation"
    },
    {
      "id": "render",
      "name": "Render",
      "category": "ClothPaintToolBase",
      "signature": "Render(Target, In Component, In Adapter, View, Viewport, PDI)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "In Component",
          "type": "USkeletalMeshComponent*"
        },
        {
          "name": "In Adapter",
          "type": "IMeshPaintGeometryAdapter*"
        },
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "Viewport",
          "type": "FViewport*"
        },
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        }
      ],
      "returnType": "Void",
      "docs": "Optionally render extra data to the viewport"
    },
    {
      "id": "activate",
      "name": "Activate",
      "category": "ClothPaintToolBase",
      "signature": "Activate(Target, In Commands)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "In Commands",
          "type": "TWeakPtr<FUICommandList>"
        }
      ],
      "returnType": "Void",
      "docs": "Called as tool is selected, can be used to initialize and bind actions"
    },
    {
      "id": "deactivate",
      "name": "Deactivate",
      "category": "ClothPaintToolBase",
      "signature": "Deactivate(Target, In Commands)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "In Commands",
          "type": "TWeakPtr<FUICommandList>"
        }
      ],
      "returnType": "Void",
      "docs": "Called as tool is deselected, can be used to shutdown and unbind actions"
    },
    {
      "id": "on-mesh-changed",
      "name": "OnMeshChanged",
      "category": "ClothPaintToolBase",
      "signature": "OnMeshChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Called as a change in the target geometry changes, to clear anything the tool may have cached"
    },
    {
      "id": "has-value-range",
      "name": "HasValueRange",
      "category": "ClothPaintToolBase",
      "signature": "HasValueRange(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "If true, the tool must provide the range of values used in GetValueRange, used to modify auto calculated view ranges"
    },
    {
      "id": "get-value-range",
      "name": "GetValueRange",
      "category": "ClothPaintToolBase",
      "signature": "GetValueRange(Target, Out Range Min, Out Range Max)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "Out Range Min",
          "type": "Float&"
        },
        {
          "name": "Out Range Max",
          "type": "Float&"
        }
      ],
      "returnType": "Void",
      "docs": "If HasValueRange returns true, this should specify the range of values the tool is currently covering"
    },
    {
      "id": "get-settings-object",
      "name": "GetSettingsObject",
      "category": "ClothPaintToolBase",
      "signature": "GetSettingsObject(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        }
      ],
      "returnType": "UObject*",
      "docs": "Optionally return a UObject that will be displayed in the details panel when the tool is selected.\nThis is intended for settings unique to the tool, common settings (brush size etc) are available from\nthe brush settings in the Painter."
    },
    {
      "id": "register-settings-object-customizations",
      "name": "RegisterSettingsObjectCustomizations",
      "category": "ClothPaintToolBase",
      "signature": "RegisterSettingsObjectCustomizations(Target, In Details View)",
      "params": [
        {
          "name": "Target",
          "type": "FClothPaintToolBase*"
        },
        {
          "name": "In Details View",
          "type": "IDetailsView*"
        }
      ],
      "returnType": "Void",
      "docs": "Optionally register any applicable customizations for the settings object"
    }
  ]
}