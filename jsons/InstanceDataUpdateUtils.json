      "params": [
        {
          "name": "Instance Index",
          "type": "[ ] ( FSortedInstanceItem& A,FSortedInstanceItem& B ) -> bool { if ( A . InstanceLoc . Level ! = B . InstanceLoc . Level ) { return A . InstanceLoc . Level<B . InstanceLoc . Level ; } if ( A . InstanceLoc . Coord . X ! = B . InstanceLoc . Coord . X ) { return A . InstanceLoc . Coord . X<B . InstanceLoc . Coord . X ; } if ( A . InstanceLoc . Coord . Y ! = B . InstanceLoc . Coord . Y ) { return A . InstanceLoc . Coord . Y<B . InstanceLoc . Coord . Y ; } if ( A . InstanceLoc . Coord . Z ! = B . InstanceLoc . Coord . Z ) { return A . InstanceLoc . Coord . Z<B . InstanceLoc . Coord . Z ; } return A . InstanceIndex<B ."
        }
