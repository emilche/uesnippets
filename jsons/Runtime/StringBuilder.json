    {
      "id": "join",
      "name": "Join",
      "category": "StringBuilder",
      "signature": "Join(Target, In Range, In Delimiter)",
      "params": [
        {
          "name": "Target",
          "type": "TStringBuilderBase*"
        },
        {
          "name": "In Range",
          "type": "RangeType&&"
        },
        {
          "name": "In Delimiter",
          "type": "DelimiterType&&"
        }
      ],
      "returnType": "template<RangeType,DelimiterType,std::enable_if_t<TCanAppendRange_V<RangeType&&>&& TCanAppend_V<DelimiterType&&>>* = nullptr> BuilderType&",
      "docs": "Append every element of the range to the builder, separating the elements by the delimiter.\nThis function is only available when the elements of the range and the delimiter can both be\nwritten to the builder using the append operator.\n@param InRange The range of elements to join and append.\n@param InDelimiter The delimiter to append as a separator for the elements.\n@return The builder, to allow additional operations to be composed with this one."
    },
    {
      "id": "join-quoted",
      "name": "JoinQuoted",
      "category": "StringBuilder",
      "signature": "JoinQuoted(Target, In Range, In Delimiter, In Quote)",
      "params": [
        {
          "name": "Target",
          "type": "TStringBuilderBase*"
        },
        {
          "name": "In Range",
          "type": "RangeType&&"
        },
        {
          "name": "In Delimiter",
          "type": "DelimiterType&&"
        },
        {
          "name": "In Quote",
          "type": "QuoteType&&"
        }
      ],
      "returnType": "template<RangeType,DelimiterType,QuoteType,std::enable_if_t<TCanAppendRange_V<RangeType>&& TCanAppend_V<DelimiterType&&>&& TCanAppend_V<QuoteType&&>>* = nullptr> BuilderType&",
      "docs": "Append every element of the range to the builder, separating the elements by the delimiter, and\nsurrounding every element on each side with the given quote.\nThis function is only available when the elements of the range, the delimiter, and the quote can be\nwritten to the builder using the append operator.\n@param InRange The range of elements to join and append.\n@param InDelimiter The delimiter to append as a separator for the elements.\n@param InQuote The quote to append on both sides of each element.\n@return The builder, to allow additional operations to be composed with this one."
    },
