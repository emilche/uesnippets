          "type": "TStringBuilderBase*"
        },
        {
          "name": "In Count",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Adds a given number of uninitialized characters into the string builder.\n@param InCount The number of uninitialized characters to add.\n@return The number of characters in the string builder before adding the new characters."
    },
    {
      "id": "reserve",
      "name": "Reserve",
      "category": "StringBuilder",
      "signature": "Reserve(Target, In New Capacity)",
      "params": [
        {
          "name": "Target",
          "type": "TStringBuilderBase*"
        },
        {
          "name": "In New Capacity",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Reserves memory such that the string builder can contain at least the given number of characters.\n@note: Unlike AddUninitialized, this will not advance CurPos, and thus the various Append calls\nwill start at the end of the string builder (from prior to this Reserve call).\n@param InNewCapacity The total number of characters the string builder can contain."
    },
