{
  "id": "midi-note-quantizer",
  "label": "MidiNoteQuantizer",
  "includepath": "DSP/MidiNoteQuantizer.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "get-scale-degree-set",
      "name": "GetScaleDegreeSet",
      "category": "MidiNoteQuantizer",
      "signature": "GetScaleDegreeSet(Target, Chord Tones Only If Applicable)",
      "params": [
        {
          "name": "Target",
          "type": "ScaleDegreeSet*"
        },
        {
          "name": "Chord Tones Only If Applicable",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "TArrayView<float>"
    },
    {
      "id": "quantize-midi-note",
      "name": "QuantizeMidiNote",
      "category": "MidiNoteQuantizer",
      "signature": "QuantizeMidiNote(In Note, In Root, In Scale Degrees, In Semitone Scale Range)",
      "params": [
        {
          "name": "In Note",
          "type": "Float"
        },
        {
          "name": "In Root",
          "type": "Float"
        },
        {
          "name": "In Scale Degrees",
          "type": "TArrayView<float>"
        },
        {
          "name": "In Semitone Scale Range",
          "type": "Float",
          "default": "12.0f"
        }
      ],
      "returnType": "Float"
    }
  ]
}