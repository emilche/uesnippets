      "signature": "RHIMultiDrawIndexedPrimitiveIndirect(Target, Index Buffer, Argument Buffer, Argument Offset, Count Buffer, Count Buffe Offset, Max Draw Arguments)",
      "params": [
        {
          "name": "Target",
          "type": "IRHICommandContext*"
        },
        {
          "name": "Index Buffer",
          "type": "FRHIBuffer*"
        },
        {
          "name": "Argument Buffer",
          "type": "FRHIBuffer*"
        },
        {
          "name": "Argument Offset",
          "type": "UInt"
        },
        {
          "name": "Count Buffer",
