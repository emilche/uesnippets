    {
      "id": "get-root-motion-extraction-steps-for-track-range",
      "name": "GetRootMotionExtractionStepsForTrackRange",
      "category": "AnimCompositeBase",
      "signature": "GetRootMotionExtractionStepsForTrackRange(Target, Root Motion Extraction Steps, Start Track Position, End Track Position)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimTrack*"
        },
        {
          "name": "Root Motion Extraction Steps",
          "type": "TArray<FRootMotionExtractionStep>&"
        },
        {
          "name": "Start Track Position",
          "type": "Float"
        },
        {
          "name": "End Track Position",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Given a Track delta position [StartTrackPosition, EndTrackPosition]\nSee if any AnimSegment overlaps any of it, and if it does, break it up into RootMotionExtractionPieces.\nSupports animation playing forward and backward. Track segment should be a contiguous range, not wrapping over due to looping."
    },
    {
      "id": "is-valid-to-add",
      "name": "IsValidToAdd",
      "category": "AnimCompositeBase",
