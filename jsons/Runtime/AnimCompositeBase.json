    {
      "id": "convert-track-pos-to-anim-pos",
      "name": "ConvertTrackPosToAnimPos",
      "category": "AnimCompositeBase",
      "signature": "ConvertTrackPosToAnimPos(Target, Track Position)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimSegment*"
        },
        {
          "name": "Track Position",
          "type": "Float&"
        }
      ],
      "returnType": "Float",
      "docs": "Converts 'Track Position' to position on AnimSequence.\nNote: doesn't check that position is in valid range, must do that before calling this function!"
    },
    {
      "id": "get-anim-notifies-from-track-positions",
      "name": "GetAnimNotifiesFromTrackPositions",
      "category": "AnimCompositeBase",
      "signature": "GetAnimNotifiesFromTrackPositions(Target, Previous Track Position, Current Track Position, Notify Context)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimSegment*"
        },
        {
          "name": "Previous Track Position",
          "type": "Float&"
        },
        {
          "name": "Current Track Position",
          "type": "Float&"
        },
        {
          "name": "Notify Context",
          "type": "FAnimNotifyContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieves AnimNotifies between two Track time positions. ]PreviousTrackPosition, CurrentTrackPosition]\nBetween PreviousTrackPosition (exclusive) and CurrentTrackPosition (inclusive).\nSupports playing backwards (CurrentTrackPosition<PreviousTrackPosition).\nOnly supports contiguous range, does NOT support looping and wrapping over."
    },
    {
      "id": "get-length",
      "name": "GetLength",
      "category": "AnimCompositeBase",
      "signature": "GetLength(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimTrack*"
        }
      ],
      "returnType": "Float"
    },
