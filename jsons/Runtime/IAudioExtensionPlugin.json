      "id": "is-external-send",
      "name": "IsExternalSend",
      "category": "IAudioExtensionPlugin",
      "signature": "IsExternalSend(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IAudioPluginFactory*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether this plugin sends audio to an external renderer.\nif this returns true, the audio engine will not mix the result of the audio process callback\nfrom the plugin into the audio output.\n@return true only if the plugin will handle sending audio to the DAC itself."
    },
