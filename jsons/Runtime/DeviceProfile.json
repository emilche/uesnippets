        },
        {
          "name": "C Var Information",
          "type": "OUT TMap<FString,FString>&"
        }
      ],
      "returnType": "Void",
      "docs": "Get the collection of Console Variables that this profile inherits from its' parents\n@param CVarInformation - The list of inherited CVars in the format of<key:CVarName,value:CVarCompleteString>"
