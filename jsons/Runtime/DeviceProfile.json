    {
      "id": "get-consolidated-c-vars",
      "name": "GetConsolidatedCVars",
      "category": "DeviceProfile",
      "signature": "GetConsolidatedCVars(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeviceProfile*"
        }
      ],
      "returnType": "TMap<FString,FString>&",
      "docs": "Lazily generate a consolidated list of CVars, recursing up the device profile hierarchy\nThis will not include any cvars from the device's selected fragments.\nThis is _not_ thread-safe (for thread-safety use ForEachConsolidatedCVar or GetConsolidatedCVarValue API instead)"
    },
    {
      "id": "for-each-consolidated-c-var",
      "name": "ForEachConsolidatedCVar",
      "category": "DeviceProfile",
      "signature": "ForEachConsolidatedCVar(Target, Func Ref)",
      "params": [
        {
          "name": "Target",
          "type": "UDeviceProfile*"
        },
        {
          "name": "Func Ref",
          "type": "TFunctionRef<bool ( FString&,FString& )>&"
        }
      ],
      "returnType": "Void",
      "docs": "Iterates over all consolidated string key-value CVar pairs held in this device profile, or in any parent device profile.\n@param\tFuncRef\t\tIteration function (returning false will early out and stop subsequent calls)"
    },
    {
      "id": "get-consolidated-c-var-value-5e69b2",
      "name": "GetConsolidatedCVarValue",
      "category": "DeviceProfile",
      "signature": "GetConsolidatedCVarValue(Target, C Var Name, Out String, Check Defaults)",
      "params": [
        {
          "name": "Target",
          "type": "UDeviceProfile*"
        },
        {
          "name": "C Var Name",
          "type": "TCHAR*"
        },
        {
          "name": "Out String",
          "type": "String&"
        },
        {
          "name": "Check Defaults",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Get the string value of a CVar that is held in this device profile, or in any parent device profile.\n@param\tCVarName\t\tThe name of the CVar to find\n@param\tOutString\t\tThe string value of the CVar, if found\n@param\tbCheckDefaults\tWhether to also check the IConsoleManager for the global default value for the CVar\n@return true if the CVar was found in this device profile"
    },
    {
      "id": "get-consolidated-c-var-value-f8d5d1",
      "name": "GetConsolidatedCVarValue",
      "category": "DeviceProfile",
      "signature": "GetConsolidatedCVarValue(Target, C Var Name, Out Value, Check Defaults)",
      "params": [
        {
          "name": "Target",
          "type": "UDeviceProfile*"
        },
        {
          "name": "C Var Name",
          "type": "TCHAR*"
        },
        {
          "name": "Out Value",
          "type": "Int&"
        },
        {
          "name": "Check Defaults",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Get the int32 value of a CVar that is held in this device profile, or in any parent device profile.\n@param\tCVarName\t\tThe name of the CVar to find\n@param\tOutString\t\tThe int32 value of the CVar, if found\n@param\tbCheckDefaults\tWhether to also check the IConsoleManager for the global default value for the CVar\n@return true if the CVar was found in this device profile"
    },
