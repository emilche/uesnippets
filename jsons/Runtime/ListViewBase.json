    {
      "id": "set-is-pointer-scrolling-enabled",
      "name": "SetIsPointerScrollingEnabled",
      "category": "ListViewBase",
      "signature": "SetIsPointerScrollingEnabled(Target, In Is Pointer Scrolling Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "UListViewBase*"
        },
        {
          "name": "In Is Pointer Scrolling Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enable/Disable the ability of the list to scroll. This should be use as a temporary disable."
    },
    {
      "id": "set-is-gamepad-scrolling-enabled",
      "name": "SetIsGamepadScrollingEnabled",
      "category": "ListViewBase",
      "signature": "SetIsGamepadScrollingEnabled(Target, In Is Gamepad Scrolling Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "UListViewBase*"
        },
        {
          "name": "In Is Gamepad Scrolling Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enable/Disable the ability of the list to scroll via gamepad."
    },
    {
      "id": "request-refresh",
      "name": "RequestRefresh",
      "category": "ListViewBase",
      "signature": "RequestRefresh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UListViewBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the list to refresh on the next tick.\nNote that refreshing, from a list perspective, is limited to accounting for discrepancies between items and entries.\nIn other words, it will only release entries that no longer have items and generate entries for new items (or newly visible items).\nIt does NOT account for changes within existing items - that is up to the item to announce and an entry to listen to as needed.\nThis can be onerous to set up for simple cases, so it's also reasonable (though not ideal) to call RegenerateAllEntries when changes within N list items need to be reflected."
    }
  ]
}