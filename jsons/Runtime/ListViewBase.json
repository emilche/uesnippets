          "type": "Float"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-scrollbar-visibility",
      "name": "SetScrollbarVisibility",
      "category": "ListViewBase",
      "signature": "SetScrollbarVisibility(Target, In Visibility)",
      "params": [
        {
