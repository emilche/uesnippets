{
  "id": "name-token-store",
  "label": "NameTokenStore",
  "includepath": "Iris/ReplicationSystem/NameTokenStore.h",
  "includes": [
    "CoreTypes",
    "Map",
    "NetTokenStore"
  ],
  "functions": [
    {
      "id": "get-or-create-token",
      "name": "GetOrCreateToken",
      "category": "NameTokenStore",
      "signature": "GetOrCreateToken(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "FNameTokenStore*"
        },
        {
          "name": "Name",
          "type": "Name"
        }
      ],
      "returnType": "FNetToken"
    },
    {
      "id": "resolve-token",
      "name": "ResolveToken",
      "category": "NameTokenStore",
      "signature": "ResolveToken(Target, Token, Remote Token Store State)",
      "params": [
        {
          "name": "Target",
          "type": "FNameTokenStore*"
        },
        {
          "name": "Token",
          "type": "FNetToken"
        },
        {
          "name": "Remote Token Store State",
          "type": "FNetTokenStoreState*",
          "default": "nullptr"
        }
      ],
      "returnType": "Name"
    },
    {
      "id": "write-token-data",
      "name": "WriteTokenData",
      "category": "NameTokenStore",
      "signature": "WriteTokenData(Target, Context, Token Store Key)",
      "params": [
        {
          "name": "Target",
          "type": "FNameTokenStore*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Token Store Key",
          "type": "FNetTokenStoreKey"
        }
      ],
      "returnType": "Void"
    }
  ]
}