    {
      "id": "flush",
      "name": "Flush",
      "category": "AnalyticsPropertyStore",
      "signature": "Flush(Target, Async, Timeout)",
      "params": [
        {
          "name": "Target",
          "type": "FAnalyticsPropertyStore*"
        },
        {
          "name": "Async",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Timeout",
          "type": "FTimespan&",
          "default": "FTimespan::MaxValue()"
        }
      ],
      "returnType": "Bool",
      "docs": "Flushes cached values to disk. Only one thread can flush at a time, causing possible latency if a flush is alreary happenning.\n@param bAsync Whether the data in flushed in a background thread or in the calling thread.\n@param Timeout Maximum time to wait before the flush starts (synchronous) or get scheduled (asynchronous). FTimespan::Zero() means no waiting.\n@return True if the flush was executed (synchronous) or scheduled (asynchronous), false if the operation timed out.\n@code\nStore.Flush(); // Flush in the calling thread, block until all threads has finished flushing.\nStore.Flush(false, FTimespan::Zero()); // Flush in the calling thread if possible, return immediatedly if another thread is already flushing.\nStore.Flush(true, FTimespan::Zero()); // Flush in a backgroud thread if no other thread is flushing, return immediatedly if another flushing task is running.\nStore.Flush(true);  // Flush in a background thread, might block if a thread is already flushing. (It doesn't queue several tasks).\n@endcode"
    }
