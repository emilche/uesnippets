        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>",
      "docs": "Clone this message.\n@note The message tokens are shared between the original and the clone."
    },
    {
      "id": "to-text",
      "name": "ToText",
      "category": "TokenizedMessage",
      "signature": "ToText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "Text",
      "docs": "Get a string representation of this token\n@returns a string representing this token"
    },
    {
      "id": "add-token",
      "name": "AddToken",
      "category": "TokenizedMessage",
      "signature": "AddToken(Target, In Token)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        },
        {
          "name": "In Token",
          "type": "TSharedRef<IMessageToken>&"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>",
      "docs": "Adds a token to a message.\n@param\tInMessage\tThe message to insert a token into\n@param\tInToken\t\tThe token to insert\n@returns this message, for chaining calls."
    },
    {
      "id": "add-text",
      "name": "AddText",
      "category": "TokenizedMessage",
      "signature": "AddText(Target, In Text)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        },
        {
          "name": "In Text",
          "type": "Text&"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>",
      "docs": "Adds a text token to a message.\n@param\tInMessage\tThe message to insert a token into\n@param\tInText\t\tThe text to insert as a token\n@returns this message, for chaining calls."
    },
    {
      "id": "set-severity",
      "name": "SetSeverity",
      "category": "TokenizedMessage",
      "signature": "SetSeverity(Target, In Severity)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        },
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the severity of this message\n@param\tInSeverity\tThe severity to set this message to"
    },
    {
      "id": "get-severity",
      "name": "GetSeverity",
      "category": "TokenizedMessage",
      "signature": "GetSeverity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "EMessageSeverity::Type",
      "docs": "Gets the severity of this message\n@returns the severity of this message"
    },
    {
      "id": "get-message-tokens",
      "name": "GetMessageTokens",
      "category": "TokenizedMessage",
      "signature": "GetMessageTokens(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "TArray<TSharedRef<IMessageToken>>&",
      "docs": "Get the tokens in this message\n@returns an array of tokens"
    },
    {
      "id": "set-message-link",
      "name": "SetMessageLink",
      "category": "TokenizedMessage",
      "signature": "SetMessageLink(Target, In Token)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        },
        {
          "name": "In Token",
          "type": "TSharedRef<IMessageToken>&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets up a token action for the message as a whole (not to be displayed...\nintended to be invoked from a double click).\n@param  InToken\tA token for the entire message to link to."
    },
    {
      "id": "get-message-link",
      "name": "GetMessageLink",
      "category": "TokenizedMessage",
      "signature": "GetMessageLink(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "TSharedPtr<IMessageToken>",
      "docs": "Gets the token action associated with this messages as a whole. Should\nlink to an associated element.\n@return A token action that was set via SetMessageLink()."
    },
    {
      "id": "get-severity-text",
      "name": "GetSeverityText",
      "category": "TokenizedMessage",
      "signature": "GetSeverityText(In Severity)",
      "params": [
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "Text",
      "docs": "Helper function for getting a severity as text\n@param\tInSeverity\tthe severity to use\n@returns a string representation of the severity"
    },
    {
      "id": "get-severity-icon-name",
      "name": "GetSeverityIconName",
      "category": "TokenizedMessage",
      "signature": "GetSeverityIconName(In Severity)",
      "params": [
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "Name",
      "docs": "Helper function for getting a severity as an icon name\n@param\tInSeverity\tthe severity to use\n@returns the name of the icon for the severity"
    },
    {
      "id": "get-identifier",
      "name": "GetIdentifier",
      "category": "TokenizedMessage",
      "signature": "GetIdentifier(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        }
      ],
      "returnType": "Name",
      "docs": "@returns Identifier for the message, if set, else NAME_None"
    },
    {
      "id": "set-identifier",
      "name": "SetIdentifier",
      "category": "TokenizedMessage",
      "signature": "SetIdentifier(Target, In Identifier)",
      "params": [
        {
          "name": "Target",
          "type": "FTokenizedMessage*"
        },
        {
          "name": "In Identifier",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns Identifier for the message to the provided name"
    },
    {
      "id": "create",
      "name": "Create",
      "category": "TokenizedMessage",
      "signature": "Create(In Action Name, In Action Description, In Action, In Can Execute Action, In Single Use)",
      "params": [
        {
          "name": "In Action Name",
          "type": "Text&"
        },
        {
          "name": "In Action Description",
          "type": "Text&"
        },
        {
          "name": "In Action",
          "type": "FOnActionTokenExecuted&"
        },
        {
          "name": "In Can Execute Action",
          "type": "FCanExecuteActionToken&"
        },
        {
          "name": "In Single Use",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "TSharedRef<FActionToken>"
    }
  ]
}