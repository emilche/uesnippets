          "type": "ArgTypes&& . . ."
        }
      ],
      "returnType": "template<T,U,. . . ArgTypes> T&",
      "docs": "As per AsCapability, but with an explicit capability ID. This is useful when the first template\nparameter doesn't have a single static member called ID providing the capability ID."
