      "category": "MovieScenePlaybackCapabilities",
      "signature": "AddCapability(In Args)",
      "params": [
        {
          "name": "In Args",
          "type": "ArgTypes&& . . ."
        }
      ],
      "returnType": "template<T,. . . ArgTypes> T&",
      "docs": "Adds the specified capability to the container, using the supplied arguments to construct it.\nThe capability object will be stored inline and owned by this container. It will be destroyed when the\ncontainer itself is destroyed.\nIf the template parameter is a sub-class of the playback capability class, that sub-class will be\ncreated and stored inline."
    },
