    {
      "id": "safe-set-cs-bone-transforms",
      "name": "SafeSetCSBoneTransforms",
      "category": "BonePose",
      "signature": "SafeSetCSBoneTransforms<PoseType>(Bone Transforms)",
      "params": [
        {
          "name": "Bone Transforms",
          "type": "TConstArrayView<FBoneTransform>"
        }
      ],
      "returnType": "template<class PoseType> void FCSPose<PoseType",
      "docs": "Set a bunch of Component Space Bone Transforms.\nDo this safely by insuring that Parents are already in Component Space,\nand any Component Space children are converted back to Local Space before hand."
    },
    {
      "id": "local-blend-cs-bone-transforms",
      "name": "LocalBlendCSBoneTransforms",
      "category": "BonePose",
      "signature": "LocalBlendCSBoneTransforms<PoseType>(Bone Transforms, Alpha)",
      "params": [
        {
          "name": "Bone Transforms",
          "type": "TConstArrayView<FBoneTransform>"
        },
        {
          "name": "Alpha",
          "type": "Float"
        }
      ],
      "returnType": "template<class PoseType> void FCSPose<PoseType",
      "docs": "Blends Component Space transforms to MeshPose in Local Space.\nUsed by SkelControls to apply their transforms.\nThe tricky bit is that SkelControls deliver their transforms in Component Space,\nBut the blending is done in Local Space. Also we need to refresh any Children they have\nthat has been previously converted to Component Space."
    },
    {
      "id": "convert-component-poses-to-local-poses",
      "name": "ConvertComponentPosesToLocalPoses",
      "category": "BonePose",
      "signature": "ConvertComponentPosesToLocalPoses<PoseType>(In Pose, Out Pose)",
      "params": [
        {
          "name": "In Pose",
          "type": "FCSPose<PoseType>&"
        },
        {
          "name": "Out Pose",
          "type": "PoseType&"
        }
      ],
      "returnType": "template<class PoseType> void FCSPose<PoseType",
      "docs": "This function convert component space to local space to OutPose\nThis has been optimized with an assumption of\nall parents are calculated in component space for those who have been converted to component space\nIf a part of chain hasn't been converted, it will trigger ensure."
    },
    {
      "id": "convert-component-poses-to-local-poses-safe",
      "name": "ConvertComponentPosesToLocalPosesSafe",
      "category": "BonePose",
      "signature": "ConvertComponentPosesToLocalPosesSafe<PoseType>(In Pose, Out Pose)",
      "params": [
        {
          "name": "In Pose",
          "type": "FCSPose<PoseType>&"
        },
        {
          "name": "Out Pose",
          "type": "PoseType&"
        }
      ],
      "returnType": "template<class PoseType> void FCSPose<PoseType",
      "docs": "This function convert component space to local space to OutPose\nContrast to ConvertComponentPosesToLocalPoses,\nthis allows some parts of chain to stay in local space before conversion\nAnd it will calculate back to component space correctly before converting back to new local space\nThis is issue when child is in component space, but the parent is not.\nThen we have to convert parents to be in the component space before converting back to local\nHowever it is more expensive as a result."
    },
