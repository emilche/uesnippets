    {
      "id": "net-serialize",
      "name": "NetSerialize",
      "category": "NetSerialization",
      "signature": "NetSerialize(Ar, Map, Out Success)",
      "params": [
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Map",
          "type": "UPackageMap*"
        },
        {
          "name": "Out Success",
          "type": "Bool&"
        }
      ],
      "returnType": "Bool",
      "docs": "@param Ar\t\t\tFArchive to read or write from.\n@param Map\t\t\tPackageMap used to resolve references to UObject*\n@param bOutSuccess\treturn value to signify if the serialization was succesfull (if false, an error will be logged by the calling function)\n@return return true if the serialization was fully mapped. If false, the property will be considered 'dirty' and will replicate again on the next update.\nThis is needed for UActor* properties. If an actor's Actorchannel is not fully mapped, properties referencing it must stay dirty.\nNote that UPackageMap::SerializeObject returns false if an object is unmapped. Generally, you will want to return false from your ::NetSerialize\nif you make any calls to ::SerializeObject that return false."
    },
