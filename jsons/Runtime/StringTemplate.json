      "params": [
        {
          "name": "Target",
          "type": "FStringTemplate*"
        }
      ],
      "returnType": "String&",
      "docs": "Returns the template string."
    },
    {
      "id": "get-num-named-parameters",
      "name": "GetNumNamedParameters",
      "category": "StringTemplate",
      "signature": "GetNumNamedParameters(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStringTemplate*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the number of named parameters in this template string, useful to reserve\nenough capacity in your parameters map."
    },
    {
      "id": "get-template",
      "name": "GetTemplate",
      "category": "StringTemplate",
      "signature": "GetTemplate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStringTemplateResolver*"
        }
      ],
      "returnType": "FStringTemplate&",
      "docs": "Returns the template this resolver is using."
    },
    {
      "id": "set-parameter-map",
      "name": "SetParameterMap",
      "category": "StringTemplate",
      "signature": "SetParameterMap(Target, Parameters)",
      "params": [
        {
          "name": "Target",
          "type": "FStringTemplateResolver*"
        },
        {
          "name": "Parameters",
          "type": "TMap<FString,FString>*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the map of named parameters.\nNote: make sure all named parameters are set before calling Advance() or Finalize() otherwise\nyou may get an incorrect resolved string."
