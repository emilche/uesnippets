{
  "id": "change",
  "label": "Change",
  "includepath": "Misc/Change.h",
  "includes": [
    "Array",
    "UnrealString",
    "Platform",
    "PlatformCrt",
    "AssertionMacros",
    "UniquePtr",
    "UnrealTemplate"
  ],
  "functions": [
    {
      "id": "print-to-log",
      "name": "PrintToLog",
      "category": "Change",
      "signature": "PrintToLog(Target, Feedback Context, Indent Level)",
      "params": [
        {
          "name": "Target",
          "type": "FChange*"
        },
        {
          "name": "Feedback Context",
          "type": "FFeedbackContext&"
        },
        {
          "name": "Indent Level",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Prints this change to the log, including sub-changes if there are any.  For compound changes, there might be multiple lines.  You should not need to override this function."
    },
    {
      "id": "execute",
      "name": "Execute",
      "category": "Change",
      "signature": "Execute(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FCompoundChange*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "TUniquePtr<FChange>",
      "docs": "Makes the change to the object, returning a new change that can be used to perfectly roll back this change"
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "Change",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCompoundChange*"
        }
      ],
      "returnType": "String",
      "docs": "Describes this change (for debugging)"
    }
  ]
}