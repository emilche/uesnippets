{
  "id": "change",
  "label": "Change",
  "includepath": "Misc/Change.h",
  "includes": [
    "Array",
    "UnrealString",
    "Platform",
    "PlatformCrt",
    "AssertionMacros",
    "UniquePtr",
    "UnrealTemplate"
  ],
  "functions": [
    {
      "id": "has-expired",
      "name": "HasExpired",
      "category": "Change",
      "signature": "HasExpired(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FChange*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if this Change has Expired, ie it will no longer have any effect and could be skipped by undo/redo"
    },
    {
      "id": "print-to-log",
      "name": "PrintToLog",
      "category": "Change",
      "signature": "PrintToLog(Target, Feedback Context, Indent Level)",
      "params": [
        {
          "name": "Target",
          "type": "FChange*"
        },
        {
          "name": "Feedback Context",
          "type": "FFeedbackContext&"
        },
        {
          "name": "Indent Level",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Prints this change to the log, including sub-changes if there are any.  For compound changes, there might be multiple lines.  You should not need to override this function.",
      "supportedTargets": [
        "FChange*",
        "FCompoundChange*"
      ]
    },
    {
      "id": "apply",
      "name": "Apply",
      "category": "Change",
      "signature": "Apply(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FSwapChange*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Makes the change to the object"
    },
    {
      "id": "revert",
      "name": "Revert",
      "category": "Change",
      "signature": "Revert(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FSwapChange*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Reverts change to the object"
    },
    {
      "id": "execute",
      "name": "Execute",
      "category": "Change",
      "signature": "Execute(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FCommandChange*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "TUniquePtr<FChange>",
      "docs": "Makes the change to the object, returning a new change that can be used to perfectly roll back this change",
      "supportedTargets": [
        "FCommandChange*",
        "FCompoundChange*"
      ]
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "Change",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCompoundChange*"
        }
      ],
      "returnType": "String",
      "docs": "Describes this change (for debugging)"
    }
  ]
}