      "id": "compute-cost-limit-from-heuristic",
      "name": "ComputeCostLimitFromHeuristic",
      "category": "NavigationSystemTypes",
      "signature": "ComputeCostLimitFromHeuristic(Start Pos, End Pos, Heuristic Scale, Cost Limit Factor, Minimum Cost Limit)",
      "params": [
        {
          "name": "Start Pos",
          "type": "FVector&"
        },
        {
          "name": "End Pos",
          "type": "FVector&"
        },
        {
          "name": "Heuristic Scale",
          "type": "FVector::FReal"
        },
        {
          "name": "Cost Limit Factor",
          "type": "FVector::FReal"
        },
        {
          "name": "Minimum Cost Limit",
          "type": "FVector::FReal"
        }
      ],
      "returnType": "FVector::FReal",
      "docs": "utility function to compute a cost limit using an Euclidean heuristic, an heuristic scale and a cost limit factor\nCostLimitFactor: multiplier used to compute the cost limit value from the initial heuristic\nMinimumCostLimit: minimum clamping value used to prevent low cost limit for short path query"
