    {
      "id": "is-virtual-textured-with-single-physical-space",
      "name": "IsVirtualTexturedWithSinglePhysicalSpace",
      "category": "Texture2D",
      "signature": "IsVirtualTexturedWithSinglePhysicalSpace(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this virtual texture uses a single physical space all of its texture layers.\nThis can reduce page table overhead but potentially increase the number of physical pools allocated."
    },
    {
      "id": "is-virtual-textured-with-single-physical-pool",
      "name": "IsVirtualTexturedWithSinglePhysicalPool",
      "category": "Texture2D",
      "signature": "IsVirtualTexturedWithSinglePhysicalPool(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this virtual texture requires that it's physical pool is never split by the r.VT.SplitPhysicalPoolSize setting.\nThis is necessary if the texture is part of a system that assumes that all textures in the system are in the same physical pool.\nNote that textures with this setting will necessarily be put in different physical spaces to those without the setting."
    },
