    {
      "id": "update-texture-regions",
      "name": "UpdateTextureRegions",
      "category": "Texture2D",
      "signature": "UpdateTextureRegions(Target, Mip Index, Num Regions, Regions, Src Pitch, Src Bpp, Src Data, Data Cleanup Func)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        },
        {
          "name": "Mip Index",
          "type": "Int"
        },
        {
          "name": "Num Regions",
          "type": "UInt"
        },
        {
          "name": "Regions",
          "type": "FUpdateTextureRegion2D*"
        },
        {
          "name": "Src Pitch",
          "type": "UInt"
        },
        {
          "name": "Src Bpp",
          "type": "UInt"
        },
        {
          "name": "Src Data",
          "type": "Byte*"
        },
        {
          "name": "Data Cleanup Func",
          "type": "TFunction<void ( uint8* SrcData,FUpdateTextureRegion2D* Regions )>",
          "default": "[](uint8*, const FUpdateTextureRegion2D*){}"
        }
      ],
      "returnType": "Void",
      "docs": "Asynchronously update a set of regions of a texture with new data.\n@param MipIndex - the mip number to update\n@param NumRegions - number of regions to update\n@param Regions - regions to update\n@param SrcPitch - the pitch of the source data in bytes\n@param SrcBpp - the size one pixel data in bytes\n@param SrcData - the source data\n@param DataCleanupFunc - a function that will be called to clean up the SrcData and Regions after the update."
    },
    {
      "id": "temporarily-disable-streaming",
      "name": "TemporarilyDisableStreaming",
      "category": "Texture2D",
      "signature": "TemporarilyDisableStreaming(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        }
      ],
      "returnType": "Void",
      "docs": "Temporarily disable streaming so we update subregions of this texture without streaming clobbering it."
    },
    {
      "id": "get-cpu-copy-texture",
      "name": "GetCPUCopyTexture",
      "category": "Texture2D",
      "signature": "GetCPUCopyTexture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        }
      ],
      "returnType": "UTexture2D*",
      "docs": "Creates and returns a 2d texture that holds the CPU copy. This is just so that we have something to show\nin the editor for the cpu texture and should never be used at runtime or for game data. This function\nstalls while the texture is encoding due to GetPlatformData, and will return nullptr if the texture\nis not cpu accessible.\nFor game code access to the cpu copy image, use GetCPUCopy()."
    },
    {
      "id": "are-downscale-properties-editable",
