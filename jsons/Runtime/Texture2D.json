    {
      "id": "get-num-mips-allowed",
      "name": "GetNumMipsAllowed",
      "category": "Texture2D",
      "signature": "GetNumMipsAllowed(Target, Ignore Min Residency)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        },
        {
          "name": "Ignore Min Residency",
          "type": "Bool"
        }
      ],
      "returnType": "Int",
      "docs": "Calculates the maximum number of mips that will be in this texture after cooking\n(eg. after the \"drop mip\" lod bias is applied).\nThis function is not correct and should not be used.\nThe cinematic mips will be considered as loadable, streaming enabled or not.\nNote that in the cooking process, mips smaller than the min residency count\ncan be stripped out by the cooker.\n@param bIgnoreMinResidency - Whether to ignore min residency limitations.\n@return The maximum allowed number mips for this texture."
    },
    {
      "id": "get-min-texture-resident-mip-count",
      "name": "GetMinTextureResidentMipCount",
      "category": "Texture2D",
      "signature": "GetMinTextureResidentMipCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the minimum number of mips that must be resident in memory (cannot be streamed).\nThis does not correctly account for NonStreaming mips and other constraints.\nThis function is not correct and should not be used."
    },
    {
      "id": "get-mip-data",
      "name": "GetMipData",
      "category": "Texture2D",
      "signature": "GetMipData(Target, First Mip To Load, Out Mip Data)",
      "params": [
        {
          "name": "Target",
          "type": "UTexture2D*"
        },
        {
          "name": "First Mip To Load",
          "type": "Int"
        },
        {
          "name": "Out Mip Data",
          "type": "void**"
        }
      ],
      "returnType": "Void",
      "docs": "Get the PlatformData mip data starting with the specified mip index.\n@param FirstMipToLoad - The first mip index to cache.\n@param OutMipData -\tMust point to an array of pointers with at least\nMips.Num() - FirstMipToLoad + 1 entries. Upon\nreturn those pointers will contain mip data.\nprefer TryLoadMipsWithSizes\ntodo: deprecate this API when possible\nthis API is also duplicated in Texture2DArray and TextureCube\nunify and fix them all\nalso don't use \"GetMipData\" as that is the name used for TextureSource"
    },
    {
      "id": "get-source-art-crc",
      "name": "GetSourceArtCRC",
