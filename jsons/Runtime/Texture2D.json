          "type": "UTexture2D*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the Downscale and DownscaleOptions properties should be editable in the UI.\nCurrently downscaling is only supported for 2d textures without mipmaps."
    },
