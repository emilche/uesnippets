    {
      "id": "on-node-activation",
      "name": "OnNodeActivation",
      "category": "BTDecorator",
      "signature": "OnNodeActivation(Target, Search Data)",
      "params": [
        {
          "name": "Target",
          "type": "UBTDecorator*"
        },
        {
          "name": "Search Data",
          "type": "FBehaviorTreeSearchData&"
        }
      ],
      "returnType": "Void",
      "docs": "called when underlying node is activated\nthis function should be considered as const (don't modify state of object) if node is not instanced!\nbNotifyActivation must be set to true for this function to be called\nCalling INIT_DECORATOR_NODE_NOTIFY_FLAGS in the constructor of the decorator will set this flag automatically"
    },
    {
      "id": "on-node-deactivation",
      "name": "OnNodeDeactivation",
      "category": "BTDecorator",
      "signature": "OnNodeDeactivation(Target, Search Data, Node Result)",
      "params": [
        {
          "name": "Target",
          "type": "UBTDecorator*"
        },
        {
          "name": "Search Data",
          "type": "FBehaviorTreeSearchData&"
        },
        {
          "name": "Node Result",
          "type": "EBTNodeResult::Type"
        }
      ],
      "returnType": "Void",
      "docs": "called when underlying node has finished\nthis function should be considered as const (don't modify state of object) if node is not instanced!\nbNotifyDeactivation must be set to true for this function to be called\nCalling INIT_DECORATOR_NODE_NOTIFY_FLAGS in the constructor of the decorator will set this flag automatically"
    },
    {
      "id": "on-node-processed",
      "name": "OnNodeProcessed",
      "category": "BTDecorator",
      "signature": "OnNodeProcessed(Target, Search Data, Node Result)",
      "params": [
        {
          "name": "Target",
          "type": "UBTDecorator*"
        },
        {
          "name": "Search Data",
          "type": "FBehaviorTreeSearchData&"
        },
        {
          "name": "Node Result",
          "type": "EBTNodeResult::Type&"
        }
      ],
      "returnType": "Void",
      "docs": "called when underlying node was processed (deactivated or failed to activate)\nthis function should be considered as const (don't modify state of object) if node is not instanced!\nbNotifyProcessed must be set to true for this function to be called\nCalling INIT_DECORATOR_NODE_NOTIFY_FLAGS in the constructor of the decorator will set this flag automatically"
    },
