      "id": "index",
      "name": "Index",
      "category": "SemanticFunction",
      "signature": "Index(Target)",
      "params": [
        {
          "name": "Target",
          "type": "CFunction*"
        }
      ],
      "returnType": "int32_t"
    },
    {
      "id": "set-signature",
      "name": "SetSignature",
      "category": "SemanticFunction",
      "signature": "SetSignature(Target, Signature, Next Revision)",
      "params": [
        {
          "name": "Target",
          "type": "CFunction*"
        },
        {
          "name": "Signature",
          "type": "SSignature&&"
        },
        {
          "name": "Next Revision",
          "type": "SemanticRevision"
        }
      ],
      "returnType": "Void"
    },
