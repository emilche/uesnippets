    {
      "id": "get-maybe-class-scope",
      "name": "GetMaybeClassScope",
      "category": "SemanticFunction",
      "signature": "GetMaybeClassScope(Target)",
      "params": [
        {
          "name": "Target",
          "type": "CFunction*"
        }
      ],
      "returnType": "TOptional<CClass*>",
      "docs": "This is a holdover from old semantics, where functions were assumed to be a member of a class.\nTHIS IS NO LONGER THE CASE, and we should forgo continued use of this function (we use it\nin the few places where this assumption still holds true).\n@TODO: SOL-1567, we should never need to explicitly query for a function's class, when\nfunctions could belong to a module, interface, other function etc."
    },
    {
      "id": "get-maybe-module-scope",
      "name": "GetMaybeModuleScope",
      "category": "SemanticFunction",
      "signature": "GetMaybeModuleScope(Target)",
      "params": [
