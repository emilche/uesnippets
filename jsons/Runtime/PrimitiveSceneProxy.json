    {
      "id": "create-hit-proxies-c4abcb",
      "name": "CreateHitProxies",
      "category": "PrimitiveSceneProxy",
      "signature": "CreateHitProxies(Target, Component, Out Hit Proxies)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimitiveSceneProxy*"
        },
        {
          "name": "Component",
          "type": "UPrimitiveComponent*"
        },
        {
          "name": "Out Hit Proxies",
          "type": "TArray<TRefCountPtr<HHitProxy>>&"
        }
      ],
      "returnType": "HHitProxy*",
      "docs": "All FPrimitiveSceneProxy derived classes can decide to fully override the HHitProxy\ncreation, or add their own and call any of their base classes to add theirs.\nClasses deriving from FPrimitiveSceneProxy which are meant to be used with\nIPrimitiveComponent should override both CreateHitProxies(UPrimitiveComponent*, ...)\nand CreateHitProxies(IPrimitiveComponent*, ...) and make the UPrimitiveComponent\nversion call into the IPrimitiveComponent one. This allows their derived classes that\nare exclusive to UPrimitiveComponent to call into them and to reroute the proxy\ncreation to the IPrimitiveComponent path."
    },
    {
      "id": "create-hit-proxies-53fd22",
      "name": "CreateHitProxies",
      "category": "PrimitiveSceneProxy",
      "signature": "CreateHitProxies(Target, Component Interface, Out Hit Proxies)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimitiveSceneProxy*"
        },
        {
          "name": "Component Interface",
          "type": "IPrimitiveComponent*"
        },
        {
          "name": "Out Hit Proxies",
          "type": "TArray<TRefCountPtr<HHitProxy>>&"
        }
      ],
      "returnType": "HHitProxy*",
      "docs": "Creates the hit proxies are used when DrawDynamicElements is called.\nCalled in the game thread.\n@param OutHitProxies - Hit proxes which are created should be added to this array.\n@return The hit proxy to use by default for elements drawn by DrawDynamicElements."
    },
