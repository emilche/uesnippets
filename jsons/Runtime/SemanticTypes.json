    {
      "id": "as-code",
      "name": "AsCode",
      "category": "SemanticTypes",
      "signature": "AsCode(Target, Outer Precedence, Flag)",
      "params": [
        {
          "name": "Target",
          "type": "CTypeBase*"
        },
        {
          "name": "Outer Precedence",
          "type": "ETypeSyntaxPrecedence",
          "default": "ETypeSyntaxPrecedence::Min"
        },
        {
          "name": "Flag",
          "type": "ETypeStringFlag",
          "default": "ETypeStringFlag::Simple"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Converts this class into its source code string equivalent, for use in error messages.\nThis is essentially a disassembly of the internal language data-structures into source code.\n@Notes: The code generated may not round-trip to an equivalent CTypeBase."
    },
