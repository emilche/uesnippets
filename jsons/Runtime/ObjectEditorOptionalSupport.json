{
  "id": "object-editor-optional-support",
  "label": "ObjectEditorOptionalSupport",
  "includepath": "UObject/ObjectEditorOptionalSupport.h",
  "includes": [
    "CoreTypes",
    "NotNull"
  ],
  "functions": [
    {
      "id": "conditional-upgrade-object",
      "name": "ConditionalUpgradeObject",
      "category": "ObjectEditorOptionalSupport",
      "signature": "ConditionalUpgradeObject(Ar, Secondary Object, Version Guid, Version)",
      "params": [
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Secondary Object",
          "type": "TNotNull<UObject*>"
        },
        {
          "name": "Version Guid",
          "type": "FGuid&"
        },
        {
          "name": "Version",
          "type": "Int"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "upgrade-object",
      "name": "UpgradeObject",
      "category": "ObjectEditorOptionalSupport",
      "signature": "UpgradeObject(Ar, Secondary Object)",
      "params": [
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Secondary Object",
          "type": "TNotNull<UObject*>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-editor-optional-object",
      "name": "CreateEditorOptionalObject",
      "category": "ObjectEditorOptionalSupport",
      "signature": "CreateEditorOptionalObject(Main Object, Editor Optional Class, Override Name)",
      "params": [
        {
          "name": "Main Object",
          "type": "TNotNull<UObject*>"
        },
        {
          "name": "Editor Optional Class",
          "type": "TNotNull<UClass*>"
        },
        {
          "name": "Override Name",
          "type": "TCHAR*",
          "default": "nullptr"
        }
      ],
      "returnType": "UObject*"
    }
  ]
}