      "returnType": "Void",
      "docs": "Generate the HMAC (Hash-based Message Authentication Code) for a block of data.\nhttps://en.wikipedia.org/wiki/Hash-based_message_authentication_code\n@param Key\t\tThe secret key to be used when generating the HMAC\n@param KeySize\tThe size of the key\n@param Data\t\tInput data to hash\n@param DataSize\tSize of the Data block\n@param OutHash\tResulting hash value (20 byte buffer)"
    },
    {
      "id": "initialize-file-hashes-from-buffer",
      "name": "InitializeFileHashesFromBuffer",
      "category": "SecureHash",
      "signature": "InitializeFileHashesFromBuffer(Buffer, Buffer Size, Duplicate Key Memory)",
      "params": [
        {
          "name": "Buffer",
          "type": "Byte*"
        },
        {
          "name": "Buffer Size",
          "type": "UInt64"
        },
        {
          "name": "Duplicate Key Memory",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Shared hashes.sha reading code (each platform gets a buffer to the data,\nthen passes it to this function for processing)\n@param Buffer Contents of hashes.sha (probably loaded from an a section in the executable)\n@param BufferSize Size of Buffer\n@param bDuplicateKeyMemory If Buffer is not always loaded, pass true so that the 20 byte hashes are duplicated"
    },
    {
      "id": "get-file-sha-hash",
      "name": "GetFileSHAHash",
      "category": "SecureHash",
      "signature": "GetFileSHAHash(Pathname, Hash, Is Full Package Hash)",
      "params": [
        {
          "name": "Pathname",
          "type": "TCHAR*"
        },
        {
          "name": "Hash",
          "type": "Byte"
        },
        {
          "name": "Is Full Package Hash",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Gets the stored SHA hash from the platform, if it exists. This function\nmust be able to be called from any thread.\n@param Pathname Pathname to the file to get the SHA for\n@param Hash 20 byte array that receives the hash\n@param bIsFullPackageHash true if we are looking for a full package hash, instead of a script code only hash\n@return true if the hash was found, false otherwise"
    },
