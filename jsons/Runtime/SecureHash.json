    {
      "id": "update-598b41",
      "name": "Update",
      "category": "SecureHash",
      "signature": "Update(Target, Input, Input Len)",
      "params": [
        {
          "name": "Target",
          "type": "FMD5*"
        },
        {
          "name": "Input",
          "type": "Byte*"
        },
        {
          "name": "Input Len",
          "type": "UInt64"
        }
      ],
      "returnType": "Void",
      "docs": "MD5 block update operation.  Continues an MD5 message-digest operation,\nprocessing another message block, and updating the context.\n@param input\t\tinput data\n@param inputLen\tlength of the input data in bytes"
    },
    {
      "id": "final-869424",
      "name": "Final",
      "category": "SecureHash",
      "signature": "Final(Target, Digest)",
      "params": [
        {
          "name": "Target",
          "type": "FMD5*"
        },
        {
          "name": "Digest",
          "type": "Byte*"
        }
      ],
      "returnType": "Void",
      "docs": "MD5 finalization. Ends an MD5 message-digest operation, writing the\nthe message digest and zeroizing the context.\nDigest is 16 BYTEs.\n@param digest\tpointer to a buffer where the digest should be stored ( must have at least 16 bytes )"
    },
