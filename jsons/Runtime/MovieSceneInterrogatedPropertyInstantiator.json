    {
      "id": "recompose-blend-channel",
      "name": "RecomposeBlendChannel",
      "category": "MovieSceneInterrogatedPropertyInstantiator",
      "signature": "RecomposeBlendChannel(Target, Property Definition, Channel Composite Index, In Query, In Current Value)",
      "params": [
        {
          "name": "Target",
          "type": "UMovieSceneInterrogatedPropertyInstantiatorSystem*"
        },
        {
          "name": "Property Definition",
          "type": "UE::MovieScene::FPropertyDefinition&"
        },
        {
          "name": "Channel Composite Index",
          "type": "Int"
        },
        {
          "name": "In Query",
          "type": "UE::MovieScene::FDecompositionQuery&"
        },
        {
          "name": "In Current Value",
          "type": "Double"
        }
      ],
      "returnType": "FValueRecompositionResult",
      "docs": "Recompose a value from the constituent parts specified in InQuery, taking into accounts the wieghtings of the specific channel defined by ChannelCompositeIndex.\n@param PropertyDefinition  The property that this float channel is bound to\n@param ChannelCompositeIndex  The index of the composite that this float channel represents, if it is part of a composite value (for instance when keying/recomposing Translation.Z)\n@param InQuery        The query defining the entities and object to recompose\n@param InCurrentValue The value of the property to recompose\n@return A result containing the recomposed value for each of the entities specified in InQuery"
    },
    {
      "id": "recompose-blend",
      "name": "RecomposeBlend",
      "category": "MovieSceneInterrogatedPropertyInstantiator",
      "signature": "RecomposeBlend(Target, In Components, In Query, In Current Value)",
      "params": [
        {
          "name": "Target",
          "type": "UMovieSceneInterrogatedPropertyInstantiatorSystem*"
        },
        {
          "name": "In Components",
          "type": "UE::MovieScene::TPropertyComponents<PropertyTraits>&"
        },
        {
          "name": "In Query",
          "type": "UE::MovieScene::FDecompositionQuery&"
        },
        {
          "name": "In Current Value",
          "type": "ValueType&"
        }
      ],
      "returnType": "template<PropertyTraits,ValueType> UE::MovieScene::TRecompositionResult<ValueType>",
      "docs": "Recompose a value from the constituent parts specified in InQuery, taking into account the weightings of each channel.\nFor instance, if a property comprises 3 additive values (a:1, b:2, c:3), and we recompose 'a' with an InCurrentValue of 10, the result for a would be 5.\n@note: ValueType must be either copy assignable to/from the storage type of the property, or must have a ConvertOperationalProperty overload\n@param InComponents   The components that define the property to decompose\n@param InQuery        The query defining the entities and object to recompose\n@param InCurrentValue The value of the property to recompose\n@return A result matching the storage type of the components, containing recomposed values for each of the entities specified in InQuery"
    },
