    {
      "id": "strncat-truncate-src",
      "name": "StrncatTruncateSrc",
      "category": "CString",
      "signature": "StrncatTruncateSrc(Dest, Src, Src Len)",
      "params": [
        {
          "name": "Dest",
          "type": "CharType*"
        },
        {
          "name": "Src",
          "type": "CharType*"
        },
        {
          "name": "Src Len",
          "type": "Int"
        }
      ],
      "returnType": "CharType*",
      "docs": "Append at most SrcLen characters from Src to Dest. Append a null terminator after the last character from Src.\nThis version matches the behavior of CRT strncat: the size given is the maximum number to append from the Src str.\nIf you instead want to specify the length of the destination buffer, call StrncatTruncateDest.\n@param Dest - destination buffer to append to\n@param Src - source buffer to copy from\n@param SrcLen - maximum number of characters to copy from Src. If Src length is less than SrcLen,\nall characters up to the null terminator, and the null terminator, will be copied into Dest.\n@return pointer to resulting string buffer"
    },
    {
      "id": "strncat-truncate-dest",
      "name": "StrncatTruncateDest",
      "category": "CString",
      "signature": "StrncatTruncateDest(Dest, Dest Size, Src)",
      "params": [
        {
          "name": "Dest",
          "type": "CharType*"
        },
        {
          "name": "Dest Size",
          "type": "Int"
        },
        {
          "name": "Src",
          "type": "CharType*"
        }
      ],
      "returnType": "CharType*",
      "docs": "Concatenate a string with length checking. Unlike the CRT strncat, the size argument is interpreted\nas the size of the Dest buffer (which must include space for the null terminator) rather than the max\nnumber of Src characters to append.\n@param Dest - destination buffer to append to\n@param Src - source buffer to copy from\n@param DestSize - max size of the dest buffer, including null terminator. Max number of non-terminating\ncharacters written into Dest is DestSize - 1.\n@return pointer to resulting string buffer"
    },
