      "id": "add-key",
      "name": "AddKey",
      "category": "SimpleCurve",
      "signature": "AddKey(Target, In Time, In Value, Unwind Rotation, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FSimpleCurve*"
        },
