  "functions": [
    {
      "id": "queue-subtitles",
      "name": "QueueSubtitles",
      "category": "SubtitleManager",
      "signature": "QueueSubtitles(Target, Subtitle ID, Priority, Manual Word Wrap, Single Line, Sound Duration, Subtitles, In Start Time, In Current Time)",
      "params": [
        {
          "name": "Target",
          "type": "FSubtitleManager*"
        },
        {
          "name": "Subtitle ID",
          "type": "PTRINT"
        },
        {
          "name": "Priority",
          "type": "Float"
        },
        {
          "name": "Manual Word Wrap",
          "type": "Bool"
        },
        {
          "name": "Single Line",
          "type": "Bool"
        },
        {
          "name": "Sound Duration",
          "type": "Float"
        },
        {
          "name": "Subtitles",
          "type": "TArray<FSubtitleCue>&"
        },
        {
          "name": "In Start Time",
          "type": "Float"
        },
        {
          "name": "In Current Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Add an array of subtitles to the active list\n@param SubTitleID The controlling id that groups sets of subtitles together.\n@param Priority Used to prioritize subtitles; higher values have higher priority.  Subtitles with a priority 0.0f are not displayed.\n@param StartTime Time at which the subtitles start (in seconds).\n@param SoundDuration Time  after which the subtitles do not display (in seconds).\n@param Subtitles Collection of lines of subtitle and time offset to play them."
    },
    {
      "id": "display-subtitles",
      "name": "DisplaySubtitles",
      "category": "SubtitleManager",
      "signature": "DisplaySubtitles(Target, In Canvas, Subtitle Region, In Audio Time Seconds)",
      "params": [
        {
          "name": "Target",
          "type": "FSubtitleManager*"
        },
        {
          "name": "In Canvas",
          "type": "FCanvas*"
        },
        {
          "name": "Subtitle Region",
          "type": "FIntRect&"
        },
        {
          "name": "In Audio Time Seconds",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Display the currently queued subtitles and cleanup after they have finished rendering.\n@param Canvas Where to render the subtitles.\n@param CurrentTime Current world time."
    },
