      "id": "capture-stack-trace",
      "name": "CaptureStackTrace",
      "category": "StackTracker",
      "signature": "CaptureStackTrace(Target, Entries To Ignore, User Data, Stack Len, Lookup Strings For Alias Removal)",
      "params": [
        {
          "name": "Target",
          "type": "FStackTracker*"
        },
        {
          "name": "Entries To Ignore",
          "type": "Int",
          "default": "2"
        },
        {
          "name": "User Data",
          "type": "void*",
          "default": "nullptr"
        },
        {
          "name": "Stack Len",
          "type": "Int",
          "default": "MAX_int32"
        },
        {
          "name": "Lookup Strings For Alias Removal",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Captures the current stack and updates stack tracking information.\noptionally stores a user data pointer that the tracker will take ownership of and delete upon reset\nyou must allocate the memory with FMemory::Malloc() or provide a custom delete function\nEntriesToIgnore are removed from the top of then stack, then we keep at most StackLen of the remaining entries."
    },
