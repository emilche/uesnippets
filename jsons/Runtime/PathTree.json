{
  "id": "path-tree",
  "label": "PathTree",
  "includepath": "AssetRegistry/PathTree.h",
  "includes": [
    "Map",
    "Set",
    "Platform",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "ensure-additional-capacity",
      "name": "EnsureAdditionalCapacity",
      "category": "PathTree",
      "signature": "EnsureAdditionalCapacity(Target, Num New Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Num New Paths",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Reserve extra space for the expected number of paths that will be added in future.\nCount is added to the current number of stored paths and not any previous reservation."
    },
    {
      "id": "cache-path",
      "name": "CachePath",
      "category": "PathTree",
      "signature": "CachePath(Target, Path, On Path Added)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Path",
          "type": "Name"
        },
        {
          "name": "On Path Added",
          "type": "TFunctionRef<void ( FName )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Adds the specified path to the tree, creating nodes as needed and calling OnPathAdded for any new paths added. Returns true if the specified path was actually added (as opposed to already existed)"
    },
    {
      "id": "remove-path",
      "name": "RemovePath",
      "category": "PathTree",
      "signature": "RemovePath(Target, Path, On Path Removed)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Path",
          "type": "Name"
        },
        {
          "name": "On Path Removed",
          "type": "TFunctionRef<void ( FName )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Removes the specified path from the tree, calling OnPathRemoved for any existing paths removed. Returns true if the path was found and removed."
    },
    {
      "id": "path-exists",
      "name": "PathExists",
      "category": "PathTree",
      "signature": "PathExists(Target, Path)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Path",
          "type": "Name"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks whether the given path is one that we know about"
    },
    {
      "id": "get-all-paths",
      "name": "GetAllPaths",
      "category": "PathTree",
      "signature": "GetAllPaths(Target, Out Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Out Paths",
          "type": "TSet<FName>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Get all of the paths we know about"
    },
    {
      "id": "enumerate-all-paths",
      "name": "EnumerateAllPaths",
      "category": "PathTree",
      "signature": "EnumerateAllPaths(Target, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Callback",
          "type": "TFunctionRef<bool ( FName )>"
        }
      ],
      "returnType": "Void",
      "docs": "Enumerate all of the paths we know about"
    },
    {
      "id": "get-sub-paths",
      "name": "GetSubPaths",
      "category": "PathTree",
      "signature": "GetSubPaths(Target, Base Path, Out Paths, Recurse)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Base Path",
          "type": "Name"
        },
        {
          "name": "Out Paths",
          "type": "TSet<FName>&"
        },
        {
          "name": "Recurse",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Recursively gathers all child paths from the specified base path relative to this node"
    },
    {
      "id": "enumerate-sub-paths",
      "name": "EnumerateSubPaths",
      "category": "PathTree",
      "signature": "EnumerateSubPaths(Target, Base Path, Callback, Recurse)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        },
        {
          "name": "Base Path",
          "type": "Name"
        },
        {
          "name": "Callback",
          "type": "TFunctionRef<bool ( FName )>"
        },
        {
          "name": "Recurse",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Recursively enumerates all child paths from the specified base path relative to this node"
    },
    {
      "id": "num-paths",
      "name": "NumPaths",
      "category": "PathTree",
      "signature": "NumPaths(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-allocated-size",
      "name": "GetAllocatedSize",
      "category": "PathTree",
      "signature": "GetAllocatedSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPathTree*"
        }
      ],
      "returnType": "SIZE_T"
    },
    {
      "id": "normalize-package-path",
      "name": "NormalizePackagePath",
      "category": "PathTree",
      "signature": "NormalizePackagePath(In)",
      "params": [
        {
          "name": "In",
          "type": "Name"
        }
      ],
      "returnType": "Name",
      "docs": "Normalize the given PackagePath (/Game/SubDir) by removing a trailing slash if it exists."
    }
  ]
}