    {
      "id": "get-function-definition-location",
      "name": "GetFunctionDefinitionLocation",
      "category": "WindowsPlatformStackWalk",
      "signature": "GetFunctionDefinitionLocation(Function Symbol Name, Function Module Name, Out Pathname, Out Line Number, Out Column Number)",
      "params": [
        {
          "name": "Function Symbol Name",
          "type": "String&"
        },
        {
          "name": "Function Module Name",
          "type": "String&"
        },
        {
          "name": "Out Pathname",
          "type": "String&"
        },
        {
          "name": "Out Line Number",
          "type": "UInt&"
        },
        {
          "name": "Out Column Number",
          "type": "UInt&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns the source file pathname, line and column where the specified function is defined.\nThe implementation extracts the information from the debug engine and the debug symbols and\ntakes care of loading the debug symbols if the debug engine was configured to load symbols\non demand. This function can be expensive if the debug symbols needs to be loaded.\nFMovieSceneEventParameters*\n@param FunctionSymbolName The function name to lookup.\n@param FunctionModuleName The module name containing the function to lookup.\n@param OutPathname The source file pathname.\n@param OutLineNumber The line at which the function is defined in the source file.\n@param OutColumnNumber The offset on the line at which the function is defined in the source file.\n@return True if the the function location is found, false otherwise."
    },
