    {
      "id": "initialize-any-thread",
      "name": "Initialize_AnyThread",
      "category": "AnimNodeBase",
      "signature": "Initialize_AnyThread(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "Context",
          "type": "FAnimationInitializeContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the node first runs. If the node is inside a state machine or cached pose branch then this can be called multiple times.\nThis can be called on any thread.\n@param\tContext\t\tContext structure providing access to relevant data"
    },
    {
      "id": "cache-bones-any-thread",
      "name": "CacheBones_AnyThread",
      "category": "AnimNodeBase",
      "signature": "CacheBones_AnyThread(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "Context",
          "type": "FAnimationCacheBonesContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to cache any bones that this node needs to track (e.g. in a FBoneReference).\nThis is usually called at startup when LOD switches occur.\nThis can be called on any thread.\n@param\tContext\t\tContext structure providing access to relevant data"
    },
    {
      "id": "update-any-thread",
      "name": "Update_AnyThread",
      "category": "AnimNodeBase",
      "signature": "Update_AnyThread(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "Context",
          "type": "FAnimationUpdateContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to update the state of the graph relative to this node.\nGenerally this should configure any weights (etc.) that could affect the poses that\nwill need to be evaluated. This function is what usually executes EvaluateGraphExposedInputs.\nThis can be called on any thread.\n@param\tContext\t\tContext structure providing access to relevant data"
    },
    {
      "id": "evaluate-any-thread",
      "name": "Evaluate_AnyThread",
      "category": "AnimNodeBase",
      "signature": "Evaluate_AnyThread(Target, Output)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "Output",
          "type": "FPoseContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to evaluate local-space bones transforms according to the weights set up in Update().\nYou should implement either Evaluate or EvaluateComponentSpace, but not both of these.\nThis can be called on any thread.\n@param\tOutput\t\tOutput structure to write pose or curve data to. Also provides access to relevant data as a context."
    },
    {
      "id": "evaluate-component-space-any-thread",
      "name": "EvaluateComponentSpace_AnyThread",
      "category": "AnimNodeBase",
      "signature": "EvaluateComponentSpace_AnyThread(Target, Output)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "Output",
          "type": "FComponentSpacePoseContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to evaluate component-space bone transforms according to the weights set up in Update().\nYou should implement either Evaluate or EvaluateComponentSpace, but not both of these.\nThis can be called on any thread.\n@param\tOutput\t\tOutput structure to write pose or curve data to. Also provides access to relevant data as a context."
    },
    {
      "id": "reset-dynamics",
      "name": "ResetDynamics",
      "category": "AnimNodeBase",
      "signature": "ResetDynamics(Target, In Teleport Type)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimNode_Base*"
        },
        {
          "name": "In Teleport Type",
          "type": "ETeleportType"
        }
      ],
      "returnType": "Void",
      "docs": "Called to help dynamics-based updates to recover correctly from large movements/teleports"
    }
