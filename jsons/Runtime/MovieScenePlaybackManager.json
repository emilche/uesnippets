  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "MovieScenePlaybackManager",
      "signature": "Initialize(Target, In Sequence)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieScenePlaybackManager*"
        },
        {
          "name": "In Sequence",
          "type": "UMovieSceneSequence*"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes the playback manager for the given sequence.\nThis resets all playback settings (play rate, start/end offsets, etc.) to their default\nvalues."
    },
    {
      "id": "update",
      "name": "Update",
      "category": "MovieScenePlaybackManager",
      "signature": "Update(Target, In Delta Seconds, Out Contexts)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieScenePlaybackManager*"
        },
        {
          "name": "In Delta Seconds",
          "type": "Float"
        },
        {
          "name": "Out Contexts",
          "type": "FContexts&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the playback state and returns the evaluation contexts to use for evaluating\nthe sequence. More than one context may be returned if the sequence loops once or more,\nand \"looping dissection\" is enabled.\n@param InDeltaSeconds  The delta-time to update with\n@param OutContexts     One or more update contexts to evaluate the sequence"
    },
    {
      "id": "update-to",
      "name": "UpdateTo",
      "category": "MovieScenePlaybackManager",
      "signature": "UpdateTo(Target, Next Time, Out Contexts)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieScenePlaybackManager*"
        },
        {
          "name": "Next Time",
          "type": "FFrameTime"
        },
        {
          "name": "Out Contexts",
          "type": "FContexts&"
        }
      ],
      "returnType": "Void",
      "docs": "As per the other Update method, but takes a time (in display rate) instead of seconds."
    },
