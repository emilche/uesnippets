      "docs": "Converts the FDebugName to a string buffer, avoiding dynamic allocations.\nReturns the length of the string, excluding the null terminator."
    },
    {
      "id": "to-string-truncate",
      "name": "ToStringTruncate",
      "category": "RHIDefinitions",
      "signature": "ToStringTruncate<T>(N)",
      "params": [
        {
          "name": "N",
          "type": "TCHAR (& Out ) ["
        }
      ],
      "returnType": "template<uint32 N> uint32",
      "docs": "Converts the FDebugName to a string buffer, avoiding dynamic allocations. Truncates the name if it does not fit in the specified output buffer.\nUse a buffer size of at least FDebugName::StringBufferSize to avoid truncation.\nReturns the length of the (possibly truncated) string, excluding the null terminator."
