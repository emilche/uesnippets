    {
      "id": "f-debug-name-3dd7c6",
      "name": "FDebugName",
      "category": "RHIDefinitions",
      "signature": "FDebugName()",
      "params": [],
      "returnType": "Void",
      "docs": "A type used only for printing a string for debugging/profiling.\nAdds Number as a suffix to the printed string even if the base name includes a number, so may prints a string like: Base_1_1\nThis type will always store a numeric suffix explicitly inside itself and never in the name table so it will always be at least 12 bytes\nregardless of the value of UE_FNAME_OUTLINE_NUMBER.\nIt is not comparable or convertible to other name types to encourage its use only for debugging and avoid using more storage than necessary\nfor the primary use cases of FName (names of objects, assets etc which are widely used and therefor deduped in the name table)."
    },
    {
