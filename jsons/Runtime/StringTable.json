    "Object",
    "StringTable.generated"
  ],
  "functions": [
    {
      "id": "gather-for-localization",
      "name": "GatherForLocalization",
      "category": "StringTable",
      "signature": "GatherForLocalization(Target, Source Location, String Table, Property Localization Data Gatherer, Gather Text Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UStringTable*"
        },
        {
          "name": "Source Location",
          "type": "String&"
        },
        {
          "name": "String Table",
          "type": "FStringTableConstRef&"
        },
        {
          "name": "Property Localization Data Gatherer",
          "type": "FPropertyLocalizationDataGatherer&"
        },
        {
          "name": "Gather Text Flags",
          "type": "EPropertyLocalizationGathererTextFlags"
        }
      ],
      "returnType": "Void",
      "docs": "Utility to gather the string table data stored within an asset.\n@note Primarily used internally by UStringTable, but may be used by any other assets that host a FStringTable and need to handle gathering it for localization via a FPropertyLocalizationDataGatherer."
    },
