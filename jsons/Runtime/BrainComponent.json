      "signature": "RequestLogicRestartOnUnlock(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UBrainComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "To be called in case we want to restart AI logic while it's still being locked.\nOn subsequent ResumeLogic instead RestartLogic will be called.\n@note this call does nothing if logic is not locked at the moment of call"
