{
  "id": "click-drag-tool",
  "label": "ClickDragTool",
  "includepath": "BaseTools/ClickDragTool.h",
  "includes": [
    "BehaviorTargetInterfaces",
    "CoreMinimal",
    "InputState",
    "InteractiveTool",
    "InteractiveToolBuilder",
    "ObjectMacros",
    "UObjectGlobals",
    "ClickDragTool.generated"
  ],
  "functions": [
    {
      "id": "build-tool",
      "name": "BuildTool",
      "category": "ClickDragTool",
      "signature": "BuildTool(Target, Scene State)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragToolBuilder*"
        },
        {
          "name": "Scene State",
          "type": "FToolBuilderState&"
        }
      ],
      "returnType": "UInteractiveTool*"
    },
    {
      "id": "can-begin-click-drag-sequence",
      "name": "CanBeginClickDragSequence",
      "category": "ClickDragTool",
      "signature": "CanBeginClickDragSequence(Target, Press Pos)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragTool*"
        },
        {
          "name": "Press Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "FInputRayHit",
      "docs": "Test if target can begin click-drag interaction at this point\n@param ClickPos device position/ray at click point\n@return true if target wants to begin sequence"
    },
    {
      "id": "on-click-press",
      "name": "OnClickPress",
      "category": "ClickDragTool",
      "signature": "OnClickPress(Target, Press Pos)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragTool*"
        },
        {
          "name": "Press Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target that click press ocurred\n@param ClickPos device position/ray at click point"
    },
    {
      "id": "on-click-drag",
      "name": "OnClickDrag",
      "category": "ClickDragTool",
      "signature": "OnClickDrag(Target, Drag Pos)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragTool*"
        },
        {
          "name": "Drag Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target that input position has changed\n@param ClickPos device position/ray at click point"
    },
    {
      "id": "on-click-release",
      "name": "OnClickRelease",
      "category": "ClickDragTool",
      "signature": "OnClickRelease(Target, Release Pos)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragTool*"
        },
        {
          "name": "Release Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target that click release occurred\n@param ClickPos device position/ray at click point"
    },
    {
      "id": "on-terminate-drag-sequence",
      "name": "OnTerminateDragSequence",
      "category": "ClickDragTool",
      "signature": "OnTerminateDragSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UClickDragTool*"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target that click-drag sequence has been explicitly terminated (eg by escape key)"
    }
  ]
}