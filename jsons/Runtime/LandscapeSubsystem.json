    {
      "id": "regenerate-grass",
      "name": "RegenerateGrass",
      "category": "LandscapeSubsystem",
      "signature": "RegenerateGrass(Target, In Flush Grass, In Force Sync, In Optional Camera Locations)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeSubsystem*"
        },
        {
          "name": "In Flush Grass",
          "type": "Bool"
        },
        {
          "name": "In Force Sync",
          "type": "Bool"
        },
        {
          "name": "In Optional Camera Locations",
          "type": "TOptional<TArrayView<FVector>>",
          "default": "TOptional<TArrayView<FVector>>()"
        }
      ],
      "returnType": "Void",
      "docs": "Can be called at runtime : (optionally) flushes grass on all landscape components and updates them\n@param bInFlushGrass : flushes all grass from landscape components prior to updating them\n@param bInForceSync : synchronously updates grass on all landscape components\n@param InOptionalCameraLocations : (optional) camera locations that should be used when updating the grass. If not specified, the usual (streaming manager-based) view locations will be used"
    },
    {
      "id": "build-nanite-ff3e30",
      "name": "BuildNanite",
      "category": "LandscapeSubsystem",
      "signature": "BuildNanite(Target, In Proxies To Build, Force Rebuild)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeSubsystem*"
        },
        {
          "name": "In Proxies To Build",
          "type": "TArrayView<ALandscapeProxy*>",
          "default": "TArrayView<ALandscapeProxy*>()"
        },
        {
          "name": "Force Rebuild",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "build-nanite-995e16",
      "name": "BuildNanite",
      "category": "LandscapeSubsystem",
      "signature": "BuildNanite(Target, In Build Flags, In Proxies To Build)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeSubsystem*"
        },
        {
          "name": "In Build Flags",
          "type": "UE::Landscape::EBuildFlags"
        },
        {
          "name": "In Proxies To Build",
          "type": "TArrayView<ALandscapeProxy*>",
          "default": "TArrayView<ALandscapeProxy*>()"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the Nanite mesh on all landscape actors whose mesh is not up to date.\n@param InProxiesToBuild - If specified, only the Nanite meshes of the specified landscape actors (recursively for all streaming proxies, in the case of a 1 ALandscape / N ALandscapeStreamingProxy setup) will be built\n@param bForceRebuild - If true, forces the Nanite meshes to be rebuilt, no matter if they're up to date or not"
    },
