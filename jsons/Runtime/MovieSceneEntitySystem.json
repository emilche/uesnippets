      "id": "define-implicit-prerequisite",
      "name": "DefineImplicitPrerequisite",
      "category": "MovieSceneEntitySystem",
      "signature": "DefineImplicitPrerequisite(Upstream System Type, Downstream System Type)",
      "params": [
        {
          "name": "Upstream System Type",
          "type": "TSubclassOf<UMovieSceneEntitySystem>"
        },
        {
          "name": "Downstream System Type",
          "type": "TSubclassOf<UMovieSceneEntitySystem>"
        }
      ],
      "returnType": "Void",
      "docs": "Creates a relationship between the two system types that ensures any systems of type UpstreamSystemType always execute before DownstreamSystemType if they are both present\n@param UpstreamSystemType     The UClass of the system that should always be a prerequisite of DownstreamSystemType (ie, runs first)\n@param DownstreamSystemType   The UClass of the system that should always run after UpstreamSystemType"
    },
    {
      "id": "define-component-producer",
      "name": "DefineComponentProducer",
      "category": "MovieSceneEntitySystem",
      "signature": "DefineComponentProducer(Class Type, Component Type)",
      "params": [
        {
          "name": "Class Type",
          "type": "TSubclassOf<UMovieSceneEntitySystem>"
        },
        {
          "name": "Component Type",
          "type": "FComponentTypeID"
        }
      ],
      "returnType": "Void",
      "docs": "Informs the dependency graph that the specified class type produces components of the specified type.\nAny systems set up as consumers of this component type will always be run after\n@param ClassType         The UClass of the system that produces the component type\n@param ComponentType     The type of the component produced by the system"
    },
    {
      "id": "define-component-consumer",
      "name": "DefineComponentConsumer",
      "category": "MovieSceneEntitySystem",
      "signature": "DefineComponentConsumer(Class Type, Component Type)",
      "params": [
        {
          "name": "Class Type",
          "type": "TSubclassOf<UMovieSceneEntitySystem>"
        },
        {
          "name": "Component Type",
          "type": "FComponentTypeID"
        }
      ],
      "returnType": "Void",
      "docs": "Informs the dependency graph that the specified class type consumes components of the specified type, and as such should always execute after any producers of that component type.\n@param ClassType         The UClass of the system that consumes the component type\n@param ComponentType     The type of the component consumed by the system"
    },
