      "category": "MovieSceneDoubleChannel",
      "signature": "PopulateCurvePoints(Target, Start Time Seconds, End Time Seconds, Time Threshold, Value Threshold, Tick Resolution, In Out Points)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneDoubleChannel*"
        },
        {
          "name": "Start Time Seconds",
          "type": "Double"
