          "type": "FFrameTime"
        }
      ],
      "returnType": "UE::MovieScene::Interpolation::FInterpolationExtents",
      "docs": "Compute the value extents of this curve within the specified limits\n@param StartTime     The start of the range within which to compute extents\n@param EndTime       The end of the range within which to compute extents\n@return The extents of this channel"
    },
    {
      "id": "inverse-evaluate",
      "name": "InverseEvaluate",
      "category": "MovieSceneDoubleChannel",
      "signature": "InverseEvaluate(Target, Value, Time Hint, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneDoubleChannel*"
        },
        {
          "name": "Value",
          "type": "Double"
        },
        {
          "name": "Time Hint",
          "type": "FFrameTime"
        },
        {
          "name": "Flags",
          "type": "UE::MovieScene::EInverseEvaluateFlags"
        }
      ],
      "returnType": "TOptional<FFrameTime>",
      "docs": "Solve this curve for a given (y). Where more than one solution exists, TimeHint will be used to find the solution closest to the hint.\n@param Value         The result to solve for\n@param TimeHint      Predicate time to use for locating the most relevant solution\n@param Flags         Flag structure used to control how to solve the curve\n@return The solution if one exists, false otherwise"
    },
    {
      "id": "inverse-evaluate-between",
      "name": "InverseEvaluateBetween",
      "category": "MovieSceneDoubleChannel",
      "signature": "InverseEvaluateBetween(Target, Value, Start Time, End Time, Visitor)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneDoubleChannel*"
        },
        {
          "name": "Value",
          "type": "Double"
        },
        {
          "name": "Start Time",
          "type": "FFrameTime"
        },
        {
          "name": "End Time",
          "type": "FFrameTime"
        },
        {
          "name": "Visitor",
          "type": "TFunctionRef<bool ( FFrameTime )>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Solve this curve for a given (y), only considering solutions that lie within a certain range.\n@param Value         The result to solve for\n@param StartTime     Start time before which solutions will not be considered\n@param EndTime       End time after which solutions will not be considered\n@param Visitor       Callback that is invoked for each solution. Returning true allows the algorithm to continue, false will terminate the algorithm.\n@return False if any invocation of Visitor returned false, true otherwise."
    },
