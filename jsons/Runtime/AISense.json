{
  "id": "ai-sense",
  "label": "AISense",
  "includepath": "Perception/AISense.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "SubclassOf",
    "AIPerceptionTypes",
    "AISense.generated"
  ],
  "functions": [
    {
      "id": "get-world",
      "name": "GetWorld",
      "category": "AISense",
      "signature": "GetWorld(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        }
      ],
      "returnType": "public : UWorld*",
      "docs": "then this count reaches 0 sense will be updated"
    },
    {
      "id": "hardcode-sense-id",
      "name": "HardcodeSenseID",
      "category": "AISense",
      "signature": "HardcodeSenseID(Sense Class, Hardcoded ID)",
      "params": [
        {
          "name": "Sense Class",
          "type": "TSubclassOf<UAISense>"
        },
        {
          "name": "Hardcoded ID",
          "type": "FAISenseID"
        }
      ],
      "returnType": "Void",
      "docs": "use with caution! Needs to be called before any senses get instantiated or listeners registered. DOES NOT update any perceptions system instances"
    },
    {
      "id": "post-init-properties",
      "name": "PostInitProperties",
      "category": "AISense",
      "signature": "PostInitProperties(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "register-wrapped-event",
      "name": "RegisterWrappedEvent",
      "category": "AISense",
      "signature": "RegisterWrappedEvent(Target, Perception Event)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        },
        {
          "name": "Perception Event",
          "type": "UAISenseEvent&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "update-sense-id",
      "name": "UpdateSenseID",
      "category": "AISense",
      "signature": "UpdateSenseID(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        }
      ],
      "returnType": "FAISenseID"
    },
    {
      "id": "describe-self-to-gameplay-debugger",
      "name": "DescribeSelfToGameplayDebugger",
      "category": "AISense",
      "signature": "DescribeSelfToGameplayDebugger(Target, Perception System, Debugger Category)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        },
        {
          "name": "Perception System",
          "type": "UAIPerceptionSystem&"
        },
        {
          "name": "Debugger Category",
          "type": "FGameplayDebuggerCategory&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-new-pawn",
      "name": "OnNewPawn",
      "category": "AISense",
      "signature": "OnNewPawn(Target, New Pawn)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        },
        {
          "name": "New Pawn",
          "type": "APawn&"
        }
      ],
      "returnType": "Void",
      "docs": "gets called when perception system gets notified about new spawned pawn.\n@Note: do not call super implementation. It's used to detect when subclasses don't override it"
    },
    {
      "id": "set-sense-id",
      "name": "SetSenseID",
      "category": "AISense",
      "signature": "SetSenseID(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        },
        {
          "name": "Index",
          "type": "FAISenseID"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-listeners",
      "name": "GetListeners",
      "category": "AISense",
      "signature": "GetListeners(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        }
      ],
      "returnType": "AIPerception::FListenerMap*",
      "docs": "returning pointer rather then a reference to prevent users from\naccidentally creating copies by creating non-reference local vars"
    },
    {
      "id": "force-sense-id",
      "name": "ForceSenseID",
      "category": "AISense",
      "signature": "ForceSenseID(Target, Sense ID)",
      "params": [
        {
          "name": "Target",
          "type": "UAISense*"
        },
        {
          "name": "Sense ID",
          "type": "FAISenseID"
        }
      ],
      "returnType": "Void",
      "docs": "To be called only for BP-generated classes"
    }
  ]
}