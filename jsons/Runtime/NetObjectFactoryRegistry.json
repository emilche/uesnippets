    {
      "id": "set-factory-registration-allowed",
      "name": "SetFactoryRegistrationAllowed",
      "category": "NetObjectFactoryRegistry",
      "signature": "SetFactoryRegistrationAllowed(Allowed)",
      "params": [
        {
          "name": "Allowed",
