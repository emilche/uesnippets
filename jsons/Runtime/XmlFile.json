  "functions": [
    {
      "id": "f-xml-file",
      "name": "FXmlFile",
      "category": "XmlFile",
      "signature": "FXmlFile(In File, Construct Method)",
      "params": [
        {
          "name": "In File",
          "type": "String&"
        },
        {
          "name": "Construct Method",
          "type": "EConstructMethod::Type",
          "default": "EConstructMethod::ConstructFromFile"
        }
      ],
      "returnType": "Void",
      "docs": "Constructs the file with the passed path. InFile is either treated as a filename to open, or as a text\nbuffer to load.\n@param\tInFile\t\t\t\tThe path/text to use\n@param\tConstructMethod\t\tWhether to load a file of use the string as a buffer of xml data"
    },
    {
      "id": "load-file",
      "name": "LoadFile",
      "category": "XmlFile",
      "signature": "LoadFile(Target, Path, Construct Method)",
      "params": [
        {
          "name": "Target",
          "type": "FXmlFile*"
        },
        {
          "name": "Path",
          "type": "String&"
        },
        {
          "name": "Construct Method",
          "type": "EConstructMethod::Type",
          "default": "EConstructMethod::ConstructFromFile"
        }
      ],
      "returnType": "Bool",
      "docs": "Loads the file with the passed path. Path is either treated as a filename to open, or as a text\nbuffer to load.\n@param\tPath\t\t\t\tThe path/text to use\n@param\tConstructMethod\t\tWhether to load a file of use the string as a buffer of xml data"
    },
