    },
    {
      "id": "get-linear-velocity",
      "name": "GetLinearVelocity",
      "category": "Motion Controller Update",
      "signature": "GetLinearVelocity(Target, Out Linear Velocity)",
      "params": [
        {
          "name": "Target",
          "type": "UMotionControllerComponent*"
        },
        {
          "name": "Out Linear Velocity",
          "type": "FVector&"
        }
      ],
      "returnType": "Bool",
      "docs": "If the motion tracking system provides linear velocity at this time the vector will be that velocity in cm/s in unreal world space and the function will return true.  If velocity is unavailable it will return false."
    },
    {
      "id": "get-angular-velocity",
      "name": "GetAngularVelocity",
      "category": "Motion Controller Update",
      "signature": "GetAngularVelocity(Target, Out Angular Velocity)",
      "params": [
        {
          "name": "Target",
          "type": "UMotionControllerComponent*"
        },
        {
          "name": "Out Angular Velocity",
          "type": "FRotator&"
        }
      ],
      "returnType": "Bool",
      "docs": "If the motion tracking system provides angular velocity at this time OutAngularVelocity will be that velocity in deg/s in unreal world space and the function will return true. Note that it is not difficult to rotate a controller at more than 0.5 or 1 rotation per second briefly and some mathmatical operations(such as conversion to quaternion) lose rotations beyond 180 degrees or 360 degrees..  In some cases that is OK becuase the resulting final rotation is the same, but in some cases it would generate incorrect results.   If angular velocity is unavailable it will return false."
    },
    {
      "id": "get-linear-acceleration",
      "name": "GetLinearAcceleration",
      "category": "Motion Controller Update",
      "signature": "GetLinearAcceleration(Target, Out Linear Acceleration)",
      "params": [
        {
          "name": "Target",
          "type": "UMotionControllerComponent*"
        },
        {
          "name": "Out Linear Acceleration",
          "type": "FVector&"
        }
      ],
      "returnType": "Bool",
      "docs": "If the motion tracking system provides linear acceleration at this time the vector will be that acceleration in cm/(s^2) in unreal world space and the function will return true.  If acceleration is unavailable it will return false."
    }
  ]
}