{
  "id": "physics-thread-library",
  "label": "PhysicsThreadLibrary",
  "includepath": "Physics/Experimental/PhysicsThreadLibrary.h",
  "functions": [
    {
      "id": "add-force-cad703",
      "name": "AddForce",
      "category": "Utilities",
      "signature": "AddForce(Handle, Force, Accel Change)",
      "params": [
        {
          "name": "Handle",
          "type": "FBodyInstanceAsyncPhysicsTickHandle"
        },
        {
          "name": "Force",
          "type": "FVector"
        },
        {
          "name": "Accel Change",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "class UPhysicsThreadLibrary : public UBlueprintFunctionLibrary",
      "docs": "Add a force to a single rigid body.\nThis is like a 'thruster'. Good for adding a burst over some (non zero) time. Should be called every frame for the duration of the force.\n@param\tForce\t\t Force vector to apply. Magnitude indicates strength of force.\n@param  bAccelChange If true, Force is taken as a change in acceleration instead of a physical force (i.e. mass will have no effect)."
    },
    {
      "id": "add-force-c9314b",
      "name": "AddForce",
      "category": "Utilities",
      "signature": "AddForce(Target, M)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicsThreadLibrary*"
        },
        {
          "name": "M",
          "type": "Force* Handle ->"
        }
      ],
      "returnType": "Handle ->"
    },
    {
      "id": "add-force-862a74",
      "name": "AddForce",
      "category": "Utilities",
      "signature": "AddForce(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicsThreadLibrary*"
        }
      ],
      "returnType": "else"
    }
  ]
