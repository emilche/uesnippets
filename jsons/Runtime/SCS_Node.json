    {
      "id": "execute-node-on-actor",
      "name": "ExecuteNodeOnActor",
      "category": "SCS_Node",
      "signature": "ExecuteNodeOnActor(Target, Actor, Parent Component, Root Transform, Root Relative Rotation Cache, Is Default Transform, Transform Scale Method)",
      "params": [
        {
          "name": "Target",
          "type": "USCS_Node*"
        },
        {
          "name": "Actor",
          "type": "AActor*"
        },
        {
          "name": "Parent Component",
          "type": "USceneComponent*"
        },
        {
          "name": "Root Transform",
          "type": "FTransform*"
        },
        {
          "name": "Root Relative Rotation Cache",
          "type": "FRotationConversionCache*"
        },
        {
          "name": "Is Default Transform",
          "type": "Bool"
        },
        {
          "name": "Transform Scale Method",
          "type": "ESpawnActorScaleMethod",
          "default": "ESpawnActorScaleMethod::OverrideRootScale"
        }
      ],
      "returnType": "UActorComponent*",
      "docs": "Create the specified component on the actor, then call action on children\n@param Actor\t\t\t\t\tThe actor instance for which to create a new component based on the template encapsulated by this node.\n@param ParentComponent\t\tIf non-NULL, the component to which the new component should be attached as a child. If NULL, the new component will not be attached to anything.\n@param RootTransform\t\t\tThe transform to apply if this node turns out to be the root component of the actor instance.\n@param RootRelativeRotationCache Optional rotation cache to use if this node turns out to be the root component of the actor instance.\n@param bIsDefaultTransform\tIndicates whether or not the given transform is a \"default\" transform, in which case it can be overridden by template defaults.\n@return The new component instance that was created, or NULL on failure."
    },
    {
      "id": "get-actual-component-template",
      "name": "GetActualComponentTemplate",
      "category": "SCS_Node",
      "signature": "GetActualComponentTemplate(Target, Actual BPGC)",
