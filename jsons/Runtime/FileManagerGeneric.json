    {
      "id": "find-files-9b1bad",
      "name": "FindFiles",
      "category": "FileManagerGeneric",
      "signature": "FindFiles(Target, Found Files, Directory, File Extension)",
      "params": [
        {
          "name": "Target",
          "type": "FFileManagerGeneric*"
        },
        {
          "name": "Found Files",
          "type": "TArray<FString>&"
        },
        {
          "name": "Directory",
          "type": "TCHAR*"
        },
        {
          "name": "File Extension",
          "type": "TCHAR*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Finds all the files within the given directory, with optional file extension filter.\n@param Directory, the absolute path to the directory to search. Ex: \"C:\\UE4\\Pictures\"\n@param FileExtension, If FileExtension is NULL, or an empty string \"\" then all files are found.\nOtherwise FileExtension can be of the form .EXT or just EXT and only files with that extension will be returned.\n@return FoundFiles, All the files that matched the optional FileExtension filter, or all files if none was specified."
    },
    {
      "id": "iterate-directory",
      "name": "IterateDirectory",
      "category": "FileManagerGeneric",
      "signature": "IterateDirectory(Target, Directory, Visitor)",
      "params": [
        {
          "name": "Target",
          "type": "FFileManagerGeneric*"
        },
        {
          "name": "Directory",
          "type": "TCHAR*"
        },
        {
          "name": "Visitor",
          "type": "IPlatformFile::FDirectoryVisitor&"
        }
      ],
      "returnType": "Bool",
      "docs": "Call the Visit function of the visitor once for each file or directory in a single directory. This function does not explore subdirectories.\n@param Directory\t\tThe directory to iterate the contents of.\n@param Visitor\t\tVisitor to call for each element of the directory\n@return\t\t\t\tfalse if the directory did not exist or if the visitor returned false."
    },
    {
      "id": "iterate-directory-recursively",
      "name": "IterateDirectoryRecursively",
      "category": "FileManagerGeneric",
      "signature": "IterateDirectoryRecursively(Target, Directory, Visitor)",
      "params": [
        {
