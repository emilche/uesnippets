    {
      "id": "suggest-toss-velocity",
      "name": "SuggestTossVelocity",
      "category": "AIController",
      "signature": "SuggestTossVelocity(Target, Out Toss Velocity, Start, End, Toss Speed, Prefer High Arc, Collision Radius, Only Trace Up)",
      "params": [
        {
          "name": "Target",
          "type": "AAIController*"
        },
        {
          "name": "Out Toss Velocity",
          "type": "FVector&"
        },
        {
          "name": "Start",
          "type": "FVector"
        },
        {
          "name": "End",
          "type": "FVector"
        },
        {
          "name": "Toss Speed",
          "type": "Float"
        },
        {
          "name": "Prefer High Arc",
          "type": "Bool"
        },
        {
          "name": "Collision Radius",
          "type": "Float",
          "default": "0"
        },
        {
          "name": "Only Trace Up",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Computes a launch velocity vector to toss a projectile and hit the given destination.\nPerformance note: Potentially expensive. Nonzero CollisionRadius and bOnlyTraceUp=false are the more expensive options.\n@param OutTossVelocity - out param stuffed with the computed velocity to use\n@param Start - desired start point of arc\n@param End - desired end point of arc\n@param TossSpeed - Initial speed of the theoretical projectile. Assumed to only change due to gravity for the entire lifetime of the projectile\n@param CollisionSize (optional) - is the size of bounding box of the tossed actor (defaults to (0,0,0)\n@param bOnlyTraceUp  (optional) - when true collision checks verifying the arc will only be done along the upward portion of the arc\n@return - true if a valid arc was computed, false if no valid solution could be found"
    },
