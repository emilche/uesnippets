        {
          "name": "Blackboard Asset",
          "type": "UBlackboardData*"
        },
        {
          "name": "Blackboard Component",
          "type": "UBlackboardComponent*&"
        }
      ],
      "returnType": "public : bool",
      "docs": "Makes AI use the specified Blackboard asset & creates a Blackboard Component if one does not already exist.\n@param\tBlackboardAsset\t\t\tThe Blackboard asset to use.\n@param\tBlackboardComponent\t\tThe Blackboard component that was used or created to work with the passed-in Blackboard Asset.\n@return true if we successfully linked the blackboard asset to the blackboard component."
    },
