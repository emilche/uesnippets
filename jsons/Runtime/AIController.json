  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "UObjectGlobals",
    "SubclassOf",
    "EngineDefines",
    "NavigationQueryFilter",
    "AITypes",
    "GameplayTaskOwnerInterface",
    "GameplayTask",
