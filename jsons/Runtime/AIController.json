    "Controller",
    "AIPerceptionListenerInterface",
    "GenericTeamAgentInterface",
    "VisualLoggerDebugSnapshotInterface",
    "AIController.generated"
  ],
  "functions": [
    {
      "id": "move-to-actor",
      "name": "MoveToActor",
      "category": "AI",
      "signature": "MoveToActor(Target, Goal, Acceptance Radius, Stop On Overlap, Use Pathfinding, Can Strafe, Filter Class, Allow Partial Path)",
      "params": [
        {
          "name": "Target",
          "type": "AAIController*"
        },
        {
          "name": "Goal",
          "type": "AActor*"
        },
        {
          "name": "Acceptance Radius",
          "type": "Float",
          "default": "-1"
        },
        {
          "name": "Stop On Overlap",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Use Pathfinding",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Can Strafe",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Filter Class",
          "type": "TSubclassOf<UNavigationQueryFilter>",
          "default": "NULL"
        },
        {
          "name": "Allow Partial Path",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "EPathFollowingRequestResult::Type",
      "docs": "Makes AI go toward specified Goal actor (destination will be continuously updated), aborts any active path following\n@param AcceptanceRadius - finish move if pawn gets close enough\n@param bStopOnOverlap - add pawn's radius to AcceptanceRadius\n@param bUsePathfinding - use navigation data to calculate path (otherwise it will go in straight line)\n@param bCanStrafe - set focus related flag: bAllowStrafe\n@param FilterClass - navigation filter for pathfinding adjustments. If none specified DefaultNavigationFilterClass will be used\n@param bAllowPartialPath - use incomplete path when goal can't be reached\n@note AcceptanceRadius has default value or -1 due to Header Parser not being able to recognize UPathFollowingComponent::DefaultAcceptanceRadius"
    },
    {
      "id": "move-to-location",
      "name": "MoveToLocation",
      "category": "AI",
      "signature": "MoveToLocation(Target, Dest, Acceptance Radius, Stop On Overlap, Use Pathfinding, Project Destination To Navigation, Can Strafe, Filter Class, Allow Partial Path)",
      "params": [
        {
          "name": "Target",
          "type": "AAIController*"
        },
        {
          "name": "Dest",
          "type": "FVector&"
        },
        {
          "name": "Acceptance Radius",
          "type": "Float",
          "default": "-1"
        },
        {
          "name": "Stop On Overlap",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Use Pathfinding",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Project Destination To Navigation",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Can Strafe",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Filter Class",
          "type": "TSubclassOf<UNavigationQueryFilter>",
          "default": "NULL"
        },
        {
          "name": "Allow Partial Path",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "EPathFollowingRequestResult::Type",
      "docs": "Makes AI go toward specified Dest location, aborts any active path following\n@param AcceptanceRadius - finish move if pawn gets close enough\n@param bStopOnOverlap - add pawn's radius to AcceptanceRadius\n@param bUsePathfinding - use navigation data to calculate path (otherwise it will go in straight line)\n@param bProjectDestinationToNavigation - project location on navigation data before using it\n@param bCanStrafe - set focus related flag: bAllowStrafe\n@param FilterClass - navigation filter for pathfinding adjustments. If none specified DefaultNavigationFilterClass will be used\n@param bAllowPartialPath - use incomplete path when goal can't be reached\n@note AcceptanceRadius has default value or -1 due to Header Parser not being able to recognize UPathFollowingComponent::DefaultAcceptanceRadius"
    },
    {
      "id": "has-partial-path",
      "name": "HasPartialPath",
      "category": "AI",
      "signature": "HasPartialPath(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AAIController*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the current PathFollowingComponent's path is partial (does not reach desired destination)."
    },
    {
      "id": "get-immediate-move-destination",
