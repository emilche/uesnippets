        {
          "name": "Target",
          "type": "FRayTracingShaderBindingTable*"
        },
        {
          "name": "Segment Count",
          "type": "UInt"
        },
        {
          "name": "Geometry",
          "type": "FRHIRayTracingGeometry*"
        },
        {
          "name": "Flags",
          "type": "FRayTracingCachedMeshCommandFlags"
        }
      ],
      "returnType": "FRayTracingSBTAllocation*",
      "docs": "Allocate or share static allocation range - sharing can happen if geometry and cached RT MDC flags are the same (will result in exactly the same binding data written in the SBT)"
    },
    {
      "id": "free-static-range",
      "name": "FreeStaticRange",
      "category": "RayTracingShaderBindingTable",
      "signature": "FreeStaticRange(Target, Allocation)",
      "params": [
        {
          "name": "Target",
          "type": "FRayTracingShaderBindingTable*"
        },
        {
          "name": "Allocation",
          "type": "FRayTracingSBTAllocation*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "allocate-dynamic-range",
      "name": "AllocateDynamicRange",
      "category": "RayTracingShaderBindingTable",
      "signature": "AllocateDynamicRange(Target, Allocated Layers, Segment Count)",
      "params": [
        {
          "name": "Target",
          "type": "FRayTracingShaderBindingTable*"
        },
        {
          "name": "Allocated Layers",
          "type": "ERayTracingShaderBindingLayerMask"
        },
        {
          "name": "Segment Count",
          "type": "UInt"
        }
      ],
      "returnType": "FRayTracingSBTAllocation*",
      "docs": "Allocate dynamic SBT range which can be reused again when ResetDynamicAllocationData is called"
    },
    {
      "id": "reset-dynamic-allocation-data",
      "name": "ResetDynamicAllocationData",
      "category": "RayTracingShaderBindingTable",
      "signature": "ResetDynamicAllocationData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRayTracingShaderBindingTable*"
        }
      ],
      "returnType": "Void",
      "docs": "Mark all currently allocated dynamic ranges as free again so they can be allocated"
    },
    {
      "id": "allocate-static-range-internal",
      "name": "AllocateStaticRangeInternal",
      "category": "RayTracingShaderBindingTable",
      "signature": "AllocateStaticRangeInternal(Target, Allocated Layers, Segment Count, Geometry, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FRayTracingShaderBindingTable*"
        },
        {
          "name": "Allocated Layers",
          "type": "ERayTracingShaderBindingLayerMask"
        },
        {
          "name": "Segment Count",
          "type": "UInt"
        },
        {
          "name": "Geometry",
          "type": "FRHIRayTracingGeometry*"
        },
        {
          "name": "Flags",
          "type": "FRayTracingCachedMeshCommandFlags"
        }
      ],
      "returnType": "FRayTracingSBTAllocation*",
      "docs": "Allocate single static range of records for the given SegmentCount for all layers in the AllocatedLayersMask"
    }
  ]
}