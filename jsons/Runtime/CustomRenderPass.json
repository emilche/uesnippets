{
  "id": "custom-render-pass",
  "label": "CustomRenderPass",
  "includepath": "Rendering/CustomRenderPass.h",
  "includes": [
    "CoreMinimal",
    "RenderGraphFwd",
    "EngineTypes"
  ],
  "functions": [
    {
      "id": "begin-pass",
      "name": "BeginPass",
      "category": "CustomRenderPass",
      "signature": "BeginPass(Target, Graph Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called before PreRender on render thread (only really useful for properly scoping render capture names)"
    },
    {
      "id": "pre-render",
      "name": "PreRender",
      "category": "CustomRenderPass",
      "signature": "PreRender(Target, Graph Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called before the pass is rendered on render thread, use it for prep tasks such as allocating render target."
    },
    {
      "id": "post-render",
      "name": "PostRender",
      "category": "CustomRenderPass",
      "signature": "PostRender(Target, Graph Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called after the pass is rendered on render thread, use it for post processing tasks such as applying additional shader effects to the render target."
    },
    {
      "id": "end-pass",
      "name": "EndPass",
      "category": "CustomRenderPass",
      "signature": "EndPass(Target, Graph Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        }
      ],
      "returnType": "Void",
      "docs": "Called after PostRender on render thread (only really useful for properly scoping render capture names)"
    },
    {
      "id": "get-scene-capture-source",
      "name": "GetSceneCaptureSource",
      "category": "CustomRenderPass",
      "signature": "GetSceneCaptureSource(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "ESceneCaptureSource",
      "docs": "Convert output type into corresponding scene capture source type. This is because we use CopySceneCaptureComponentToTarget helper function\nto copy the custom render pass render result from scene texture into the pass's render target."
    },
    {
      "id": "perform-render-capture",
      "name": "PerformRenderCapture",
      "category": "CustomRenderPass",
      "signature": "PerformRenderCapture(Target, In Render Capture Type, In File Name)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "In Render Capture Type",
          "type": "ERenderCaptureType"
        },
        {
          "name": "In File Name",
          "type": "String&",
          "default": "FString()"
        }
      ],
      "returnType": "Void",
      "docs": "Perform a render capture when this pass runs if a render capture interface is registered"
    },
    {
      "id": "get-debug-name",
      "name": "GetDebugName",
      "category": "CustomRenderPass",
      "signature": "GetDebugName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "String&"
    },
    {
      "id": "get-render-mode",
      "name": "GetRenderMode",
      "category": "CustomRenderPass",
      "signature": "GetRenderMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "ERenderMode"
    },
    {
      "id": "get-render-output",
      "name": "GetRenderOutput",
      "category": "CustomRenderPass",
      "signature": "GetRenderOutput(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "ERenderOutput"
    },
    {
      "id": "get-render-target-texture",
      "name": "GetRenderTargetTexture",
      "category": "CustomRenderPass",
      "signature": "GetRenderTargetTexture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "FRDGTextureRef"
    },
    {
      "id": "get-render-target-size",
      "name": "GetRenderTargetSize",
      "category": "CustomRenderPass",
      "signature": "GetRenderTargetSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "FIntPoint&"
    },
    {
      "id": "is-translucent-included",
      "name": "IsTranslucentIncluded",
      "category": "CustomRenderPass",
      "signature": "IsTranslucentIncluded(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if translucency is enabled AND an output uses SceneColor.  We can skip translucency if SceneColor (where translucency is written) is unused."
    },
    {
      "id": "set-user-data",
      "name": "SetUserData",
      "category": "CustomRenderPass",
      "signature": "SetUserData(Target, In User Data)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "In User Data",
          "type": "TUniquePtr<ICustomRenderPassUserData>&&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-user-data",
      "name": "GetUserData",
      "category": "CustomRenderPass",
      "signature": "GetUserData(Target, In Type Name)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        },
        {
          "name": "In Type Name",
          "type": "Name&"
        }
      ],
      "returnType": "ICustomRenderPassUserData*"
    },
    {
      "id": "get-user-data-typed",
      "name": "GetUserDataTyped",
      "category": "CustomRenderPass",
      "signature": "GetUserDataTyped<UserDataType>(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCustomRenderPassBase*"
        }
      ],
      "returnType": "template<UserDataType> TEnableIf<TPointerIsConvertibleFromTo<UserDataType,ICustomRenderPassUserData>::Value,UserDataType>::Type*"
    }
  ]
}