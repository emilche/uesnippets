    {
      "id": "set-size-to-stretch",
      "name": "SetSizeToStretch",
      "category": "BasicLayoutWidgetSlot",
      "signature": "SetSizeToStretch(Target, In Stretch Coefficient)",
      "params": [
        {
          "name": "Target",
          "type": "TResizingWidgetSlotMixin*"
        },
        {
          "name": "In Stretch Coefficient",
          "type": "TAttribute<float>"
        }
      ],
      "returnType": "Void",
      "docs": "The available space will be distributed proportionately to each slots stretch coefficient.\nA slot with coefficient of 2 will get assigned twice as much available space as slot with coefficient 1.\n@param InStretchCoefficient Stretch coefficient for this slot."
    },
    {
      "id": "set-size-to-stretch-content",
      "name": "SetSizeToStretchContent",
      "category": "BasicLayoutWidgetSlot",
      "signature": "SetSizeToStretchContent(Target, In Stretch Coefficient, In Shrink Stretch Coefficient)",
      "params": [
        {
          "name": "Target",
          "type": "TResizingWidgetSlotMixin*"
        },
        {
          "name": "In Stretch Coefficient",
          "type": "TAttribute<float>"
        },
        {
          "name": "In Shrink Stretch Coefficient",
          "type": "TAttribute<float>",
          "default": "TAttribute<float>()"
        }
      ],
      "returnType": "Void",
      "docs": "The widget's content size is adjusted proportionally to fit the available space.\nThe slots size starts at DesiredSize, and a slot with coefficient of 2 will get adjusted twice as much as slot with coefficient 1 to fit the available space.\n@param InStretchCoefficient Stretch coefficient for this slot.\n@param InShrinkStretchCoefficient If specified, this stretch coefficient is used when the slots is shrinking below desired size. Otherwise InStretchCoefficient is used for both shrink and grow."
    },
