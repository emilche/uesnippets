      "category": "Utilities",
      "signature": "Reset(Instanced Struct, Struct Type)",
      "params": [
        {
          "name": "Instanced Struct",
          "type": "FInstancedStruct&"
        },
        {
          "name": "Struct Type",
          "type": "UScriptStruct*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Resets an InstancedStruct."
    },
    {
      "id": "is-instanced-struct-valid",
      "name": "IsInstancedStructValid",
      "category": "Utilities",
      "signature": "IsInstancedStructValid(Instanced Struct)",
      "params": [
        {
          "name": "Instanced Struct",
          "type": "FInstancedStruct&"
        }
      ],
      "returnType": "EStructUtilsResult",
      "docs": "Checks whether an InstancedStruct contains value."
    },
    {
      "id": "equal-equal-instanced-struct",
      "name": "EqualEqual_InstancedStruct",
      "category": "Utilities",
      "signature": "EqualEqual_InstancedStruct(A, B)",
      "params": [
