      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModule*"
        },
        {
          "name": "Block System",
          "type": "FSimModuleTree&"
        },
        {
          "name": "Pushed Torque",
          "type": "Float"
        },
        {
          "name": "Brake Torque",
          "type": "Float",
          "default": "0.f"
        },
        {
          "name": "Gearing Ratio",
          "type": "Float",
          "default": "1.0f"
        },
        {
          "name": "Clutch Slip",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Transmit torque between this module and its Parent and Children. DriveTorque passed down to children, LoadTorque passed from child to parent"
    },
