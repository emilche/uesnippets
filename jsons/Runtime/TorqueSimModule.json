{
  "id": "torque-sim-module",
  "label": "TorqueSimModule",
  "includepath": "SimModule/TorqueSimModule.h",
  "includes": [
    "SimulationModuleBase",
    "VehicleUtility"
  ],
  "functions": [
    {
      "id": "fill-sim-state",
      "name": "FillSimState",
      "category": "TorqueSimModule",
      "signature": "FillSimState(Target, Sim Module)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModuleData*"
        },
        {
          "name": "Sim Module",
          "type": "ISimulationModuleBase*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "fill-net-state",
      "name": "FillNetState",
      "category": "TorqueSimModule",
      "signature": "FillNetState(Target, Sim Module)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModuleData*"
        },
        {
          "name": "Sim Module",
          "type": "ISimulationModuleBase*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "lerp",
      "name": "Lerp",
      "category": "TorqueSimModule",
      "signature": "Lerp(Target, Lerp Factor, Min, Max)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModuleData*"
        },
        {
          "name": "Lerp Factor",
          "type": "Float"
        },
        {
          "name": "Min",
          "type": "FModuleNetData&"
        },
        {
          "name": "Max",
          "type": "FModuleNetData&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "TorqueSimModule",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModuleData*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "transmit-torque",
      "name": "TransmitTorque",
      "category": "TorqueSimModule",
      "signature": "TransmitTorque(Target, Block System, Pushed Torque, Brake Torque, Gearing Ratio, Clutch Slip)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModule*"
        },
        {
          "name": "Block System",
          "type": "FSimModuleTree&"
        },
        {
          "name": "Pushed Torque",
          "type": "Float"
        },
        {
          "name": "Brake Torque",
          "type": "Float",
          "default": "0.f"
        },
        {
          "name": "Gearing Ratio",
          "type": "Float",
          "default": "1.0f"
        },
        {
          "name": "Clutch Slip",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Transmit torque between this module and its Parent and Children. DriveTorque passed down to children, LoadTorque passed from child to parent"
    },
    {
      "id": "integrate-angular-velocity",
      "name": "IntegrateAngularVelocity",
      "category": "TorqueSimModule",
      "signature": "IntegrateAngularVelocity(Target, Delta Time, Inertia, Max Rotation Vel)",
      "params": [
        {
          "name": "Target",
          "type": "FTorqueSimModule*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Inertia",
          "type": "Float"
        },
        {
          "name": "Max Rotation Vel",
          "type": "Float",
          "default": "MAX_FLT"
        }
      ],
      "returnType": "Void",
      "docs": "Integrate angular velocity using specified DeltaTime & Inertia value, Note the inertia should be the combined inertia of all the connected pieces otherwise things will rotate at different rates"
    }
  ]
}