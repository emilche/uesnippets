        {
          "name": "Inertia",
          "type": "Float"
        },
        {
          "name": "Max Rotation Vel",
          "type": "Float",
          "default": "MAX_FLT"
        }
      ],
      "returnType": "Void",
      "docs": "Integrate angular velocity using specified DeltaTime & Inertia value, Note the inertia should be the combined inertia of all the connected pieces otherwise things will rotate at different rates"
