{
  "id": "lazy-object-ptr",
  "label": "LazyObjectPtr",
  "includepath": "UObject/LazyObjectPtr.h",
  "includes": [
    "UnrealString",
    "CoreGlobals",
    "Platform",
    "ThreadSafeCounter",
    "Guid",
    "Archive",
    "StructuredArchive",
    "Casts",
    "Requires",
    "UnrealTemplate",
    "Object",
    "PersistentObjectPtr",
    "type_traits"
  ],
  "functions": [
    {
      "id": "to-string",
      "name": "ToString",
      "category": "LazyObjectPtr",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUniqueObjectGuid*"
        }
      ],
      "returnType": "String",
      "docs": "Converts into a string"
    },
    {
      "id": "from-string",
      "name": "FromString",
      "category": "LazyObjectPtr",
      "signature": "FromString(Target, From)",
      "params": [
        {
          "name": "Target",
          "type": "FUniqueObjectGuid*"
        },
        {
          "name": "From",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Converts from a string"
    },
    {
      "id": "fixup-for-pie",
      "name": "FixupForPIE",
      "category": "LazyObjectPtr",
      "signature": "FixupForPIE(Target, Play In Editor ID)",
      "params": [
        {
          "name": "Target",
          "type": "FUniqueObjectGuid*"
        },
        {
          "name": "Play In Editor ID",
          "type": "Int",
          "default": "UE::GetPlayInEditorID()"
        }
      ],
      "returnType": "FUniqueObjectGuid",
      "docs": "Fixes up this UniqueObjectID to add or remove the PIE prefix depending on what is currently active"
    },
    {
      "id": "resolve-object",
      "name": "ResolveObject",
      "category": "LazyObjectPtr",
      "signature": "ResolveObject(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUniqueObjectGuid*"
        }
      ],
      "returnType": "UObject*",
      "docs": "Attempts to find a currently loaded object that matches this object ID\n@return Found UObject, or nullptr if not currently loaded"
    },
    {
      "id": "get-or-create-id-for-object",
      "name": "GetOrCreateIDForObject",
      "category": "LazyObjectPtr",
      "signature": "GetOrCreateIDForObject(Object)",
      "params": [
        {
          "name": "Object",
          "type": "FObjectPtr"
        }
      ],
      "returnType": "FUniqueObjectGuid"
    },
    {
      "id": "possibly-serialize-object-guid",
      "name": "PossiblySerializeObjectGuid",
      "category": "LazyObjectPtr",
      "signature": "PossiblySerializeObjectGuid(Object, Record)",
      "params": [
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Record",
          "type": "FStructuredArchive::FRecord"
        }
      ],
      "returnType": "Void",
      "docs": "Called by UObject::Serialize so that we can save / load the Guid possibly associated with an object"
    },
    {
      "id": "reset-pie-fixups",
      "name": "ResetPIEFixups",
      "category": "LazyObjectPtr",
      "signature": "ResetPIEFixups()",
      "params": [],
      "returnType": "Void",
      "docs": "Called when entering PIE to prepare it for PIE-specific fixups"
    }
  ]
}