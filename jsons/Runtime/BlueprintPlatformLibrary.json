      "name": "SetAllowedDeviceOrientation",
      "category": "Platform",
      "signature": "SetAllowedDeviceOrientation(New Allowed Device Orientation)",
      "params": [
        {
          "name": "New Allowed Device Orientation",
          "type": "EScreenOrientation::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Set the allowed orientation of the device."
    },
