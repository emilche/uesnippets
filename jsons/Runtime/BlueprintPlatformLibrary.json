    {
      "id": "get-launch-notification",
      "name": "GetLaunchNotification",
      "category": "Platform",
      "signature": "GetLaunchNotification(Notification Launched App, Activation Event, Fire Date)",
      "params": [
        {
          "name": "Notification Launched App",
          "type": "Bool&"
        },
