{
  "id": "simple-construction-script",
  "label": "SimpleConstructionScript",
  "includepath": "Engine/SimpleConstructionScript.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "Guid",
    "Actor",
    "SimpleConstructionScript.generated"
  ],
  "functions": [
    {
      "id": "create-node",
      "name": "CreateNode",
      "category": "SimpleConstructionScript",
      "signature": "CreateNode(Target, New Component Class, New Component Variable Name)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        },
        {
          "name": "New Component Class",
          "type": "UClass*"
        },
        {
          "name": "New Component Variable Name",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "USCS_Node*",
      "docs": "Creates a new SCS node using the given class to create the component template"
    },
    {
      "id": "create-node-and-rename-component",
      "name": "CreateNodeAndRenameComponent",
      "category": "SimpleConstructionScript",
      "signature": "CreateNodeAndRenameComponent(Target, Existing Template)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        },
        {
          "name": "Existing Template",
          "type": "UActorComponent*"
        }
      ],
      "returnType": "USCS_Node*",
      "docs": "Creates a new SCS node using the given component template instance"
    },
    {
      "id": "validate-node-variable-names",
      "name": "ValidateNodeVariableNames",
      "category": "SimpleConstructionScript",
      "signature": "ValidateNodeVariableNames(Target, Message Log)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog&"
        }
      ],
      "returnType": "Void",
      "docs": "Ensures that all nodes in the SCS have valid names for compilation/replication"
    },
    {
      "id": "validate-node-templates",
      "name": "ValidateNodeTemplates",
      "category": "SimpleConstructionScript",
      "signature": "ValidateNodeTemplates(Target, Message Log)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        },
        {
          "name": "Message Log",
          "type": "FCompilerResultsLog&"
        }
      ],
      "returnType": "Void",
      "docs": "Ensures that all nodes in the SCS have valid templates"
    },
    {
      "id": "clear-editor-component-references",
      "name": "ClearEditorComponentReferences",
      "category": "SimpleConstructionScript",
      "signature": "ClearEditorComponentReferences(Target)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        }
      ],
      "returnType": "Void",
      "docs": "Called by the SCS editor to clear all SCS editor component references"
    },
    {
      "id": "begin-editor-component-construction",
      "name": "BeginEditorComponentConstruction",
      "category": "SimpleConstructionScript",
      "signature": "BeginEditorComponentConstruction(Target)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        }
      ],
      "returnType": "Void",
      "docs": "Called by the SCS editor to prepare for constructing editable components"
    },
    {
      "id": "end-editor-component-construction",
      "name": "EndEditorComponentConstruction",
      "category": "SimpleConstructionScript",
      "signature": "EndEditorComponentConstruction(Target)",
      "params": [
        {
          "name": "Target",
          "type": "USimpleConstructionScript*"
        }
      ],
      "returnType": "Void",
      "docs": "Called by the SCS editor to clean up after constructing editable components"
    }
  ]
}