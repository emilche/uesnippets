    {
      "id": "is-constraint-expired",
      "name": "IsConstraintExpired",
      "category": "CollisionConstraintAllocator",
      "signature": "IsConstraintExpired(Target, Constraint)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionConstraintAllocator*"
        },
        {
          "name": "Constraint",
          "type": "FPBDCollisionConstraint&"
        }
      ],
      "returnType": "Bool",
      "docs": "Has the constraint expired. An expired constraint is one that was not refreshed this tick.\n@note Sleeping constrainst will report they are expired, but they should not be deleted until awoken.\nWe deliberately don't check the sleeping flag here because it adds a cache miss. This function\nshould be called only when you already know the sleep state (or you must also check IsSleeping())"
    },
