    {
      "id": "get-mid-phase",
      "name": "GetMidPhase",
      "category": "CollisionConstraintAllocator",
      "signature": "GetMidPhase(Target, Particle 0, Particle 1, Search Particle Performance Hint, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionContextAllocator*"
        },
        {
          "name": "Particle 0",
          "type": "FGeometryParticleHandle*"
