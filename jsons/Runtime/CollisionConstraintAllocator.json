{
  "id": "collision-constraint-allocator",
  "label": "CollisionConstraintAllocator",
  "includepath": "Chaos/Collision/CollisionConstraintAllocator.h",
  "includes": [
    "CoreMinimal",
    "Core",
    "CollisionResolutionTypes",
    "CollisionContext",
    "CollisionKeys",
    "ParticlePairMidPhase",
    "ObjectPool",
    "ParticleHandle",
    "ChaosStats"
  ],
  "functions": [
    {
      "id": "create-constraint",
      "name": "CreateConstraint",
      "category": "CollisionConstraintAllocator",
      "signature": "CreateConstraint(Target, Particle 0, Implicit 0, Shape 0, Simplicial 0, Shape Relative Transform 0, Particle 1, Implicit 1, Shape 1, Simplicial 1, Shape Relative Transform 1, Cull Distance, Use Manifold, Shape Pair Type)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionContextAllocator*"
        },
        {
          "name": "Particle 0",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 0",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 0",
          "type": "FPerShapeData*"
        },
        {
          "name": "Simplicial 0",
          "type": "FBVHParticles*"
        },
        {
          "name": "Shape Relative Transform 0",
          "type": "FRigidTransform3&"
        },
        {
          "name": "Particle 1",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 1",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 1",
          "type": "FPerShapeData*"
        },
        {
          "name": "Simplicial 1",
          "type": "FBVHParticles*"
        },
        {
          "name": "Shape Relative Transform 1",
          "type": "FRigidTransform3&"
        },
        {
          "name": "Cull Distance",
          "type": "FReal"
        },
        {
          "name": "Use Manifold",
          "type": "Bool"
        },
        {
          "name": "Shape Pair Type",
          "type": "EContactShapesType"
        }
      ],
      "returnType": "FPBDCollisionConstraintPtr",
      "docs": "Create a constraint (called by the MidPhase)"
    },
    {
      "id": "end-detect-collisions",
      "name": "EndDetectCollisions",
      "category": "CollisionConstraintAllocator",
      "signature": "EndDetectCollisions(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionConstraintAllocator*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Called after collision detection to clean up\nPrunes unused contacts"
    },
    {
      "id": "process-new-mid-phases",
      "name": "ProcessNewMidPhases",
      "category": "CollisionConstraintAllocator",
      "signature": "ProcessNewMidPhases(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionConstraintAllocator*"
        }
      ],
      "returnType": "Void",
      "docs": "Collect all the midphases created on the context allocators (probably on multiple threads) and register them"
    },
    {
      "id": "remove-particle",
      "name": "RemoveParticle",
      "category": "CollisionConstraintAllocator",
      "signature": "RemoveParticle(Target, Particle)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionConstraintAllocator*"
        },
        {
          "name": "Particle",
          "type": "FGeometryParticleHandle*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Destroy all collision and caches involving the particle\nCalled when a particle is destroyed or disabled (not sleeping)."
    }
  ]
}