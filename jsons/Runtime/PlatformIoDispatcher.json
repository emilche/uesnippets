        },
        {
          "name": "In File Handle",
          "type": "FIoFileHandle"
        },
        {
          "name": "In Destination",
          "type": "FIoBuffer&"
        },
        {
          "name": "In Destination Size",
          "type": "UInt64"
        },
        {
