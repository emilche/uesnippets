    {
      "id": "scatter",
      "name": "Scatter",
      "category": "PlatformIoDispatcher",
      "signature": "Scatter(Target, Block File Offset, Block Index, Block Compressed Size, Block Uncompresed Size, Scatter Offset, Scatter Size, Destination Offset, Compression Method, Encryption Key, Block Hash)",
      "params": [
        {
          "name": "Target",
