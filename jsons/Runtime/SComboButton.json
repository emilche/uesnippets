          "name": "Target",
          "type": "SComboButton*"
        }
      ],
      "returnType": "protected : FReply",
      "docs": "Handle the button being clicked by summoning the ComboButton."
    },
    {
      "id": "on-key-down",
      "name": "OnKeyDown",
      "category": "SComboButton",
      "signature": "OnKeyDown(Target, My Geometry, In Key Event)",
      "params": [
        {
          "name": "Target",
          "type": "SComboButton*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "In Key Event",
          "type": "FKeyEvent&"
        }
      ],
      "returnType": "FReply"
    },
    {
      "id": "get-filtered-tool-tip-text",
      "name": "GetFilteredToolTipText",
      "category": "SComboButton",
      "signature": "GetFilteredToolTipText(Target, Tool Tip Text)",
      "params": [
        {
          "name": "Target",
          "type": "SComboButton*"
        },
        {
          "name": "Tool Tip Text",
          "type": "TAttribute<FText>"
        }
      ],
      "returnType": "Text",
      "docs": "Called to query the tool tip text for this widget, but will return an empty text when the menu is already open\n@param\tToolTipText\tTool tip text to display, if possible\n@return\tTool tip text, or an empty text if filtered out"
