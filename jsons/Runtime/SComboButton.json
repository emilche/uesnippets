          "type": "FOnGetContent"
        }
      ],
      "returnType": "Void",
      "docs": "See the OnGetMenuContent event"
    },
    {
      "id": "construct",
      "name": "Construct",
      "category": "SComboButton",
      "signature": "Construct(Target, In Args)",
      "params": [
        {
          "name": "Target",
          "type": "SComboButton*"
        },
        {
          "name": "In Args",
          "type": "FArguments&"
        }
      ],
      "returnType": "Void",
      "docs": "Construct the widget from a declaration\n@param InArgs  The declaration from which to construct"
    },
    {
      "id": "set-button-content-padding",
      "name": "SetButtonContentPadding",
      "category": "SComboButton",
      "signature": "SetButtonContentPadding(Target, In Padding)",
      "params": [
        {
          "name": "Target",
          "type": "SComboButton*"
        },
        {
          "name": "In Padding",
          "type": "FMargin"
        }
      ],
      "returnType": "Void",
      "docs": "See the padding for button content."
    },
    {
