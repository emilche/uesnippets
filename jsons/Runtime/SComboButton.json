      "name": "SetHasDownArrow",
      "category": "SComboButton",
      "signature": "SetHasDownArrow(Target, In Has Arrow Down)",
      "params": [
        {
          "name": "Target",
          "type": "SComboButton*"
        },
        {
          "name": "In Has Arrow Down",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "add/remove the expanding arrow."
    },
    {
      "id": "on-button-clicked",
      "name": "OnButtonClicked",
      "category": "SComboButton",
      "signature": "OnButtonClicked(Target)",
      "params": [
