    {
      "id": "begin-row",
      "name": "BeginRow",
      "category": "TextRange",
      "signature": "BeginRow(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextRange*"
        }
      ],
      "returnType": "uint32_t",
      "docs": "A range in a text document/string expressed as (zero-based) begin and end row/column.\nA range is comparable to a selection in an editor. Therefore the end position is\nexclusive. Columns are byte offsets into the UTF-8 encoded line.\nTo specify a range that contains a line including the line ending character(s), use an\nend position denoting the start of the next line (or) same row and the column just\npast the last character on the row.\nOften used with CUTF8StringView and SIdxRange.\nCUTF8StringView should do the converting to and from SIdxRange and STextRange.\nSimilar to a LSP Range - https://microsoft.github.io/language-server-protocol/specifications/specification-3-14/#range\nAlso similar to UE `FIntRect`"
    },
