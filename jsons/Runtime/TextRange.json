      "id": "invalidate",
      "name": "Invalidate",
      "category": "TextRange",
      "signature": "Invalidate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextPosition*"
        }
      ],
      "returnType": "ULANG_FORCEINLINE void",
      "docs": "Position in a text document/string expressed as zero-based row/line and zero-based\ncolumn/character offset. A position is between two characters like an \u2018insert\u2019 cursor\nin an editor.  The column is a byte offset into the UTF-8 encoded line.\nSimilar to a LSP Position - https://microsoft.github.io/language-server-protocol/specifications/specification-3-14/#position\nAlso similar to UE `FIntPoint`",
      "supportedTargets": [
        "STextPosition*",
        "STextRange*"
      ]
    },
