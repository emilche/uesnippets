      "id": "get-samples-from-blend-input",
      "name": "GetSamplesFromBlendInput",
      "category": "BlendSpace",
      "signature": "GetSamplesFromBlendInput(Target, Blend Input, Out Sample Data List, In Out Cached Triangulation Index, Combine Animations)",
      "params": [
        {
          "name": "Target",
          "type": "UBlendSpace*"
        },
        {
          "name": "Blend Input",
          "type": "FVector&"
        },
