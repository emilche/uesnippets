    {
      "id": "update-blend-samples",
      "name": "UpdateBlendSamples",
      "category": "BlendSpace",
      "signature": "UpdateBlendSamples(Target, In Blend Space Position, In Delta Time, In Out Sample Data Cache, In Out Cached Triangulation Index)",
      "params": [
        {
          "name": "Target",
          "type": "UBlendSpace*"
        },
        {
          "name": "In Blend Space Position",
          "type": "FVector&"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        },
        {
          "name": "In Out Sample Data Cache",
          "type": "TArray<FBlendSampleData>&"
        },
        {
          "name": "In Out Cached Triangulation Index",
          "type": "Int&"
        }
      ],
      "returnType": "Bool",
      "docs": "Updates a cached set of blend samples according to internal parameters, blendspace position and a delta time. Used internally to GetAnimationPose().\nNote that this function does not perform any filtering internally.\n@param\tInBlendSpacePosition\tThe current position parameter of the blendspace\n@param\tInOutSampleDataCache\tThe sample data cache. Previous frames samples are re-used in the case of target weight interpolation\n@param\tInDeltaTime\t\t\t\tThe tick time for this update"
    },
    {
      "id": "reset-blend-samples",
      "name": "ResetBlendSamples",
      "category": "BlendSpace",
      "signature": "ResetBlendSamples(Target, In Out Sample Data Cache, In Normalized Current Time, Looping, Match Sync Phases)",
      "params": [
        {
          "name": "Target",
          "type": "UBlendSpace*"
        },
        {
          "name": "In Out Sample Data Cache",
          "type": "TArray<FBlendSampleData>&"
        },
        {
          "name": "In Normalized Current Time",
          "type": "Float"
        },
        {
          "name": "Looping",
          "type": "Bool"
        },
        {
          "name": "Match Sync Phases",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Resets a cached set of blend samples to match a given input time. All samples will be advanced using sync marker if possible, otherwise, their time will just be set match the input normalized time.\n@param\tInOutSampleDataCache\t\t\tThe sample data cache to use.\n@param\tInNormalizedCurrentTime\t\t\tThe time to match when advancing samples.\n@param\tbLooping\t\t\t\t\t\tIf true, advance samples as a looping blend space would.\n@param\tbMatchSyncPhases\t\t\t\tIf true, all follower samples will pass the same amount of markers the leader sample has passed to match its sync phase. Otherwise, followers samples will only match their next valid sync position."
    },
