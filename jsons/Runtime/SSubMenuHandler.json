{
  "id": "s-sub-menu-handler",
  "label": "SSubMenuHandler",
  "includepath": "Widgets/Input/SSubMenuHandler.h",
  "includes": [
    "CoreMinimal",
    "DeclarativeSyntaxSupport",
    "SCompoundWidget",
    "SMenuOwner"
  ],
  "functions": [
    {
      "id": "on-mouse-enter",
      "name": "OnMouseEnter",
      "category": "SSubMenuHandler",
      "signature": "OnMouseEnter(Target, My Geometry, Mouse Event)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "Mouse Event",
          "type": "FPointerEvent&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-mouse-leave",
      "name": "OnMouseLeave",
      "category": "SSubMenuHandler",
      "signature": "OnMouseLeave(Target, Mouse Event)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        },
        {
          "name": "Mouse Event",
          "type": "FPointerEvent&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "should-sub-menu-appear-hovered",
      "name": "ShouldSubMenuAppearHovered",
      "category": "SSubMenuHandler",
      "signature": "ShouldSubMenuAppearHovered(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether or the sub-menu entry should appear hovered.  If the sub-menu is open we will always show the menu as hovered to indicate which sub-menu is open\nIn the case that the user is interacting in this menu we do not show the menu as hovered because we need to show what the user is actually selecting"
    },
    {
      "id": "request-sub-menu-toggle",
      "name": "RequestSubMenuToggle",
      "category": "SSubMenuHandler",
      "signature": "RequestSubMenuToggle(Target, Open Menu, Clobber, Immediate)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        },
        {
          "name": "Open Menu",
          "type": "Bool"
        },
        {
          "name": "Clobber",
          "type": "Bool"
        },
        {
          "name": "Immediate",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Requests that the sub-menu associated with this widget be toggled on or off.\nIt does not immediately toggle the menu.  After a set amount of time is passed the menu will toggle\n@param bOpenMenu\t\t\t\t\ttrue to open the menu, false to close the menu if one is currently open\n@param bClobber\t\t\t\t\ttrue if we want to open a menu when another menu is already open\n@param const bool bImmediate\t\tDefault false, when true the menu will open immediately"
    },
    {
      "id": "cancel-pending-sub-menu",
      "name": "CancelPendingSubMenu",
      "category": "SSubMenuHandler",
      "signature": "CancelPendingSubMenu(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Cancels any open requests to toggle a sub-menu"
    },
    {
      "id": "has-sub-menu",
      "name": "HasSubMenu",
      "category": "SSubMenuHandler",
      "signature": "HasSubMenu(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns TRUE if there is a sub-menu available for this item"
    },
    {
      "id": "is-sub-menu-open",
      "name": "IsSubMenuOpen",
      "category": "SSubMenuHandler",
      "signature": "IsSubMenuOpen(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSubMenuHandler*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns TRUE if the sub-menu is open"
    }
  ]
}