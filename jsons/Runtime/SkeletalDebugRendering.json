{
  "id": "skeletal-debug-rendering",
  "label": "SkeletalDebugRendering",
  "includepath": "SkeletalDebugRendering.h",
  "includes": [
    "CoreMinimal",
    "EngineTypes",
    "BoneIndices"
  ],
  "functions": [
    {
      "id": "draw-wire-bone",
      "name": "DrawWireBone",
      "category": "SkeletalDebugRendering",
      "signature": "DrawWireBone(PDI, In Start, In End, In Color, In Depth Priority, Sphere Radius)",
      "params": [
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "In Start",
          "type": "FVector&"
        },
        {
          "name": "In End",
          "type": "FVector&"
        },
        {
          "name": "In Color",
          "type": "FLinearColor&"
        },
        {
          "name": "In Depth Priority",
          "type": "ESceneDepthPriorityGroup"
        },
        {
          "name": "Sphere Radius",
          "type": "Float",
          "default": "1.f"
        }
      ],
      "returnType": "Void",
      "docs": "Draw a wireframe bone from InStart to InEnd\n@param\tPDI\t\t\t\t\tPrimitive draw interface to use\n@param\tInStart\t\t\t\tThe start location of the bone\n@param\tInEnd\t\t\t\tThe end location of the bone\n@param\tInColor\t\t\t\tThe color to draw the bone with\n@param\tInDepthPriority\t\tThe scene depth priority group to use\n@param\tSphereRadius\t\tSphereRadius"
    },
    {
      "id": "draw-axes",
      "name": "DrawAxes",
      "category": "SkeletalDebugRendering",
      "signature": "DrawAxes(PDI, In Transform, In Depth Priority, Thickness, Axis Length)",
      "params": [
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "In Transform",
          "type": "FTransform&"
        },
        {
          "name": "In Depth Priority",
          "type": "ESceneDepthPriorityGroup"
        },
        {
          "name": "Thickness",
          "type": "Float",
          "default": "0.f"
        },
        {
          "name": "Axis Length",
          "type": "Float",
          "default": "4.f"
        }
      ],
      "returnType": "Void",
      "docs": "Draw a set of axes to represent a transform\n@param\tPDI\t\t\t\t\tPrimitive draw interface to use\n@param\tInTransform\t\t\tThe transform to represent\n@param\tInDepthPriority\t\tThe scene depth priority group to use\n@param\tThickness\t\t\tThickness of Axes\n@param\tAxisLength\t\t\tAxisLength"
    },
    {
      "id": "draw-wire-bone-advanced",
      "name": "DrawWireBoneAdvanced",
      "category": "SkeletalDebugRendering",
      "signature": "DrawWireBoneAdvanced(PDI, In Bone Transform, In Child Locations, In Child Colors, In Color, In Depth Priority, Sphere Radius, In Axis Config)",
      "params": [
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "In Bone Transform",
          "type": "FTransform&"
        },
        {
          "name": "In Child Locations",
          "type": "TArray<FVector>&"
        },
        {
          "name": "In Child Colors",
          "type": "TArray<FLinearColor>&"
        },
        {
          "name": "In Color",
          "type": "FLinearColor&"
        },
        {
          "name": "In Depth Priority",
          "type": "ESceneDepthPriorityGroup"
        },
        {
          "name": "Sphere Radius",
          "type": "Float"
        },
        {
          "name": "In Axis Config",
          "type": "FBoneAxisDrawConfig&"
        }
      ],
      "returnType": "Void",
      "docs": "Draw a set of axes to represent a transform\n@param\tPDI\t\t\t\t\tPrimitive draw interface to use\n@param\tInBoneTransform\t\tThe bone transform\n@param\tInChildLocations\tThe positions of all the children of the bone\n@param   InChildColors\t\tThe colors to use when drawing the cone to each child\n@param\tInColor\t\t\t\tThe color to use for the bone\n@param\tInDepthPriority\t\tThe scene depth priority group to use\n@param\tSphereRadius\t\tRadius of the ball drawn at the bone location\n@param\tInAxisConfig\t\tDraw configuration for small coordinate axes inside the joint sphere"
    },
    {
      "id": "draw-cone-connection",
      "name": "DrawConeConnection",
      "category": "SkeletalDebugRendering",
      "signature": "DrawConeConnection(PDI, Start, End, Sphere Radius, Color)",
      "params": [
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "Start",
          "type": "FVector&"
        },
        {
          "name": "End",
          "type": "FVector&"
        },
        {
          "name": "Sphere Radius",
          "type": "Float"
        },
        {
          "name": "Color",
          "type": "FLinearColor&"
        }
      ],
      "returnType": "Void",
      "docs": "Draw a cone showing offset from origin position to a given bone transform\nUsed to draw the root cone (always in red)\n@param\tPDI\t\t\t\tPrimitive draw interface to use\n@param\tStart\t\t\tThe position in world space of the start of the cone\n@param\tEnd\t\t\t\tThe position in world space of the tapered end of the cone\n@param\tSphereRadius\tThe radius of the root bone\n@param\tColor\t\t\tThe color to use for the cone"
    },
