      "name": "InitCustomFormat",
      "category": "TextureRenderTarget2D",
      "signature": "InitCustomFormat(Target, In Size X, In Size Y, In Override Format, In Force Linear Gamma)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureRenderTarget2D*"
        },
        {
          "name": "In Size X",
          "type": "UInt"
        },
        {
