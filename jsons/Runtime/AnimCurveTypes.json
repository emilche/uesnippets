          "name": "In Value",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Set value of curve named InName to InValue. Inserts a new value if an element for InName does not already exist.\nNote that this performs a binary search per-call and can potentially cause a re-sort. Consider using a combiner\noperation to set multiple element's values.\n@param\tInName\tthe name of the curve to set\n@param\tInValue\tthe value of the curve to set"
    },
    {
      "id": "set-flags",
      "name": "SetFlags",
      "category": "AnimCurveTypes",
      "signature": "SetFlags(Target, In Name, In Flags)",
      "params": [
        {
          "name": "Target",
          "type": "TBaseBlendedCurve*"
        },
        {
          "name": "In Name",
          "type": "Name"
        },
        {
          "name": "In Flags",
          "type": "UE::Anim::ECurveElementFlags"
        }
      ],
      "returnType": "Void",
      "docs": "Set flags of curve named InName to InFlags.  Inserts a new default value if an element for InName does not\nalready exist and then sets its flags to InFlags.\nNote that this performs a binary search per-call and can potentially cause a re-sort. Consider using a combiner\noperation to set multiple element's flags.\n@param\tInName\tthe name of the curve to set\n@param\tInFlags\tthe flags of the curve to set"
    },
