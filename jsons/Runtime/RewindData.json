      "returnType": "Int",
      "docs": "Find the first previous valid frame having received physics target from the server"
    },
    {
      "id": "request-resimulation",
      "name": "RequestResimulation",
      "category": "RewindData",
      "signature": "RequestResimulation(Target, Requested Frame, Particle)",
      "params": [
        {
          "name": "Target",
          "type": "FRewindData*"
        },
        {
          "name": "Requested Frame",
          "type": "Int"
        },
        {
          "name": "Particle",
          "type": "Chaos::FGeometryParticleHandle*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Request a resimulation by setting a requested frame to rewind to\n@param Particle can be used to mark a specific particle as the one triggering the resimulation"
    },
    {
      "id": "compare-targets-to-last-frame",
      "name": "CompareTargetsToLastFrame",
      "category": "RewindData",
      "signature": "CompareTargetsToLastFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRewindData*"
        }
      ],
      "returnType": "Int",
      "docs": "Check if we have received targets already for the last frame simulated,\nif so compare those with the result of the simulation and if they desync return the frame value to request a rewind for to correct the desync\nNOTE: This only happens when the client has desynced and is behind the server, so we receive server states for frames not yet simulated"
    },
