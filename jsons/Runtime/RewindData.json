      "params": [
        {
          "name": "Target",
          "type": "FRewindData*"
        },
        {
          "name": "Handle",
          "type": "FGeometryParticleHandle&"
        }
      ],
      "returnType": "Void",
      "docs": "Call this to mark specific particle as dirty and cache its current data, expected to be called at the start of OnPreSimulate_Internal, it caches data in FFrameAndPhase::PostPushData"
    },
