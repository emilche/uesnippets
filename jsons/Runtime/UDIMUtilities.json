{
  "id": "udim-utilities",
  "label": "UDIMUtilities",
  "includepath": "UDIMUtilities.h",
  "includes": [
    "Map",
    "CoreMinimal",
    "Platform"
  ],
  "functions": [
    {
      "id": "parse-udim-name",
      "name": "ParseUDIMName",
      "category": "UDIMUtilities",
      "signature": "ParseUDIMName(Name, Udim Regex Pattern, Out Prefix Name, Out Postfix Name)",
      "params": [
        {
          "name": "Name",
          "type": "String&"
        },
        {
          "name": "Udim Regex Pattern",
          "type": "String&"
        },
        {
          "name": "Out Prefix Name",
          "type": "String&"
        },
        {
          "name": "Out Postfix Name",
          "type": "String&"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-udim-index",
      "name": "GetUDIMIndex",
      "category": "UDIMUtilities",
      "signature": "GetUDIMIndex(Block X, Block Y)",
      "params": [
        {
          "name": "Block X",
          "type": "Int"
        },
        {
          "name": "Block Y",
          "type": "Int"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-udim-blocks-from-source-file",
      "name": "GetUDIMBlocksFromSourceFile",
      "category": "UDIMUtilities",
      "signature": "GetUDIMBlocksFromSourceFile(File, Udim Regex Pattern, Out Filename Without Udim Pattern And Extension)",
      "params": [
        {
          "name": "File",
          "type": "String&"
        },
        {
          "name": "Udim Regex Pattern",
          "type": "String&"
        },
        {
          "name": "Out Filename Without Udim Pattern And Extension",
          "type": "String*",
          "default": "nullptr"
        }
      ],
      "returnType": "TMap<int32,FString>",
      "docs": "Parse the file for the UDIM pattern\nIf the pattern is found search in the folder of the file for the others blocks"
    },
    {
      "id": "extract-udim-coordinates",
      "name": "ExtractUDIMCoordinates",
      "category": "UDIMUtilities",
      "signature": "ExtractUDIMCoordinates(UDIM Index, Out Block X, Out Block Y)",
      "params": [
        {
          "name": "UDIM Index",
          "type": "Int"
        },
        {
          "name": "Out Block X",
          "type": "Int&"
        },
        {
          "name": "Out Block Y",
          "type": "Int&"
        }
      ],
      "returnType": "Void"
    }
  ]
}