  "includepath": "TextureLayout.h",
  "includes": [
    "CoreMinimal",
    "RHIDefinitions"
  ],
  "functions": [
    {
      "id": "add-element",
      "name": "AddElement",
      "category": "TextureLayout",
      "signature": "AddElement(Target, Element Size, Out Element Min)",
      "params": [
        {
          "name": "Target",
          "type": "FBinnedTextureLayout*"
        },
        {
          "name": "Element Size",
          "type": "FIntPoint"
        },
        {
          "name": "Out Element Min",
          "type": "FIntPoint&"
        }
      ],
      "returnType": "Bool",
      "docs": "Allocates an element from the atlas layout.  Returns true if allocation succeeds.\nNote: Sort allocations by descending size for best packing."
    },
    {
      "id": "remove-element",
      "name": "RemoveElement",
      "category": "TextureLayout",
      "signature": "RemoveElement(Target, Element)",
      "params": [
        {
          "name": "Target",
          "type": "FBinnedTextureLayout*"
        },
        {
          "name": "Element",
          "type": "FIntRect"
        }
      ],
      "returnType": "Void",
      "docs": "Removes an element which was previously added."
    }
  ]
