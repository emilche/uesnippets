    {
      "id": "add-element-50e331",
      "name": "AddElement",
      "category": "TextureLayout",
      "signature": "AddElement(Target, Out Base X, Out Base Y, Element Size X, Element Size Y)",
      "params": [
        {
          "name": "Target",
          "type": "FTextureLayout*"
        },
        {
          "name": "Out Base X",
          "type": "UInt&"
        },
        {
          "name": "Out Base Y",
          "type": "UInt&"
        },
        {
          "name": "Element Size X",
          "type": "UInt"
        },
        {
          "name": "Element Size Y",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Finds a free area in the texture large enough to contain a surface with the given size.\nIf a large enough area is found, it is marked as in use, the output parameters OutBaseX and OutBaseY are\nset to the coordinates of the upper left corner of the free area and the function return true.\nOtherwise, the function returns false and OutBaseX and OutBaseY remain uninitialized.\n@param\tOutBaseX - If the function succeeds, contains the X coordinate of the upper left corner of the free area on return.\n@param\tOutBaseY - If the function succeeds, contains the Y coordinate of the upper left corner of the free area on return.\n@param\tElementSizeX - The size of the surface to allocate in horizontal pixels.\n@param\tElementSizeY - The size of the surface to allocate in vertical pixels.\n@return\tTrue if succeeded, false otherwise."
    },
    {
      "id": "remove-element-a4ab47",
      "name": "RemoveElement",
      "category": "TextureLayout",
      "signature": "RemoveElement(Target, Element Base X, Element Base Y, Element Size X, Element Size Y)",
      "params": [
        {
          "name": "Target",
          "type": "FTextureLayout*"
        },
        {
          "name": "Element Base X",
          "type": "UInt"
        },
        {
          "name": "Element Base Y",
          "type": "UInt"
        },
        {
          "name": "Element Size X",
          "type": "UInt"
        },
        {
          "name": "Element Size Y",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Removes a previously allocated element from the layout and collapses the tree as much as possible,\nIn order to create the largest free block possible and return the tree to its state before the element was added.\n@return\tTrue if the element specified by the input parameters existed in the layout."
    },
