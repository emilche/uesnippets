    {
      "id": "interpolate-data",
      "name": "InterpolateData",
      "category": "NetworkPhysicsComponent",
      "signature": "InterpolateData(Target, Min Data, Max Data)",
      "params": [
        {
          "name": "Target",
          "type": "UNetworkPhysicsComponent*"
        },
        {
          "name": "Min Data",
          "type": "FNetworkPhysicsData&"
        },
        {
          "name": "Max Data",
          "type": "FNetworkPhysicsData&"
        }
      ],
      "returnType": "Void",
      "docs": "Define how to interpolate between two data points if we have a gap between known data.\n@param MinData is data from a previous frame.\n@param MaxData is data from a future frame.\nEXAMPLE: We have input data for frame 1 and 4 and we need to interpolate data for frame 2 and 3 based on frame 1 as MinData and frame 4 as MaxData."
    },
    {
      "id": "decay-data",
      "name": "DecayData",
      "category": "NetworkPhysicsComponent",
      "signature": "DecayData(Target, Decay Amount)",
      "params": [
        {
          "name": "Target",
          "type": "UNetworkPhysicsComponent*"
        },
        {
          "name": "Decay Amount",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Use to decay desired data during resimulation if data is forward predicted.\n@param DecayAmount = Total amount of decay as a multiplier. 10% decay = 0.1.\nNOTE: Decay is not accumulated, the data will be in its original state each time DecayData is called. DecayAmount will increase each time the input is predicted (reused).\nEXAMPLE: Use to decay steering inputs to make resimulation not predict too much with a high steering value. Use DecayAmount of 0.1 to turn a steering value of 0.5 into 0.45 for example."
    },
    {
      "id": "merge-data",
      "name": "MergeData",
      "category": "NetworkPhysicsComponent",
      "signature": "MergeData(Target, From Data)",
      "params": [
        {
          "name": "Target",
          "type": "UNetworkPhysicsComponent*"
        },
        {
          "name": "From Data",
          "type": "FNetworkPhysicsData&"
        }
      ],
      "returnType": "Void",
      "docs": "Define how to merge data together\n@param FromData is data from a previous frame that is getting merged into the current data.\nEXAMPLE: Simulated proxies might receive two inputs at the same time after having used the same input twice, to not miss any important inputs we need to take both inputs into account\nand to not get behind in simulation we need to apply them both at the same simulation tick meaning we merge the two new inputs to one input."
    },
    {
      "id": "validate-data",
      "name": "ValidateData",
      "category": "NetworkPhysicsComponent",
      "signature": "ValidateData(Target, Network Component)",
      "params": [
        {
          "name": "Target",
          "type": "UNetworkPhysicsComponent*"
        },
        {
          "name": "Network Component",
          "type": "UActorComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Validate data received on the server from clients\nEXAMPLE: Validate incoming inputs from clients and correct any invalid input commands.\nNOTE: Changes to the data in this callback will be sent from server to clients."
    },
    {
      "id": "compare-data",
      "name": "CompareData",
      "category": "NetworkPhysicsComponent",
      "signature": "CompareData(Target, Predicted Data)",
      "params": [
        {
          "name": "Target",
          "type": "UNetworkPhysicsComponent*"
        },
        {
          "name": "Predicted Data",
          "type": "FNetworkPhysicsData&"
        }
      ],
      "returnType": "Bool",
      "docs": "Define how to compare client and server data for the same frame, returning false means the data differ enough to trigger a resimulation.\n@param PredictedData is data predicted on the client to compare with the current data received from the server.\nNOTE: To use this function, CVars np2.Resim.CompareStateToTriggerRewind and/or np2.Resim.CompareInputToTriggerRewind needs to be set to true\nor the equivalent settings overridden on the actor via UNetworkPhysicsSettingsComponent."
    },
