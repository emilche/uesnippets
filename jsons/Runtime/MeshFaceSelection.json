        {
          "name": "Target",
          "type": "FMeshFaceSelection*"
        },
        {
          "name": "Filter F",
          "type": "TUniqueFunction<bool ( int )>&",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Add all triangles in vertex one-rings of current selection to set.\nOn a large selection this is quite expensive as we don't know the boundary,\nso we have to iterate over all selected triangles.\nReturn false from FilterF to prevent triangles from being included."
    },
    {
      "id": "expand-to-one-ring-neighbours-3cc66b",
      "name": "ExpandToOneRingNeighbours",
      "category": "MeshFaceSelection",
      "signature": "ExpandToOneRingNeighbours(Target, N Rings, Filter F)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshFaceSelection*"
        },
        {
          "name": "N Rings",
          "type": "Int"
        },
        {
          "name": "Filter F",
          "type": "TUniqueFunction<bool ( int )>&",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Expand selection by N vertex one-rings. This is *significantly* faster\nthan calling ExpandToOnering() multiple times, because we can track\nthe growing front and only check the new triangles.\nReturn false from FilterF to prevent triangles from being included."
    },
