{
  "id": "runtime-asset-cache-builders",
  "label": "RuntimeAssetCacheBuilders",
  "includepath": "RuntimeAssetCacheBuilders.h",
  "includes": [
    "CoreMinimal",
    "UnrealString",
    "Delegate",
    "ScriptMacros",
    "ObjectMacros",
    "Object",
    "Stack",
    "RuntimeAssetCacheInterface",
    "RuntimeAssetCachePluginInterface",
    "RuntimeAssetCacheBuilders.generated"
  ],
  "functions": [
    {
      "id": "get-from-cache-async",
      "name": "GetFromCacheAsync",
      "category": "RuntimeAssetCache",
      "signature": "GetFromCacheAsync(Target, On Complete)",
      "params": [
        {
          "name": "Target",
          "type": "URuntimeAssetCacheBuilder_ObjectBase*"
        },
        {
          "name": "On Complete",
          "type": "FOnAssetCacheComplete&"
        }
      ],
      "returnType": "Void",
      "docs": "Call this to get the asset named AssetName from the runtime asset cache.\nIf the asset does not exist on disk, then OnAssetCacheMiss will be called.\nImplement OnAssetCacheMiss in order to create the asset that you want cached."
    },
    {
      "id": "get-from-cache-async-complete",
      "name": "GetFromCacheAsyncComplete",
      "category": "RuntimeAssetCacheBuilders",
      "signature": "GetFromCacheAsyncComplete(Target, Handle, Data Ptr)",
      "params": [
        {
          "name": "Target",
          "type": "URuntimeAssetCacheBuilder_ObjectBase*"
        },
        {
          "name": "Handle",
          "type": "Int"
        },
        {
          "name": "Data Ptr",
          "type": "FVoidPtrParam"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-asset-cache-miss",
      "name": "OnAssetCacheMiss",
      "category": "RuntimeAssetCache",
      "signature": "OnAssetCacheMiss(Target)",
      "params": [
        {
          "name": "Target",
          "type": "URuntimeAssetCacheBuilder_ObjectBase*"
        }
      ],
      "returnType": "Void",
      "docs": "When you get OnAssetCacheMiss you need to load/create the asset that is missing.\nCall SaveNewAssetToCache after you're finished creating the asset to save it back into the cache for next time.\nThis will then trigger OnAssetCacheComplete like normal, so you don't need additional code to handle it."
    },
    {
      "id": "save-new-asset-to-cache",
      "name": "SaveNewAssetToCache",
      "category": "RuntimeAssetCache",
      "signature": "SaveNewAssetToCache(Target, New Asset)",
      "params": [
        {
          "name": "Target",
          "type": "URuntimeAssetCacheBuilder_ObjectBase*"
        },
        {
          "name": "New Asset",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Call SaveNewAssetToCache to save an asset back into the cache for next time.\nThis will then trigger OnAssetCacheComplete like normal, so you don't need additional code to handle it."
    }
  ]
}