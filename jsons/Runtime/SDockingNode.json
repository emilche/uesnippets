{
  "id": "s-docking-node",
  "label": "SDockingNode",
  "includepath": "SDockingNode.h",
  "includes": [
    "CoreMinimal",
    "Reply",
    "SCompoundWidget",
    "TabManager",
    "SSplitter"
  ],
  "functions": [
    {
      "id": "set-parent-node",
      "name": "SetParentNode",
      "category": "SDockingNode",
      "signature": "SetParentNode(Target, In Parent)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        },
        {
          "name": "In Parent",
          "type": "TSharedRef<SDockingSplitter>"
        }
      ],
      "returnType": "Void",
      "docs": "All DockNodes are aware of their parent DockNode (unless they are a root node; a.k.a DockArea)\nThe parent is set whenever a node is inserted into a docking hierarchy.\n@param InParent      Set this node's parent."
    },
    {
      "id": "get-dock-area",
      "name": "GetDockArea",
      "category": "SDockingNode",
      "signature": "GetDockArea(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "TSharedPtr<SDockingArea>",
      "docs": "A tab can be removed from a stack when a uset drags it away or when the user closes it"
    },
    {
      "id": "get-all-child-tabs",
      "name": "GetAllChildTabs",
      "category": "SDockingNode",
      "signature": "GetAllChildTabs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "TArray<TSharedRef<SDockTab>>",
      "docs": "Recursively searches through all children looking for child tabs"
    },
    {
      "id": "get-num-tabs",
      "name": "GetNumTabs",
      "category": "SDockingNode",
      "signature": "GetNumTabs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "Int",
      "docs": "Gets the number of tabs in all children recursively"
    },
    {
      "id": "on-user-attempting-dock",
      "name": "OnUserAttemptingDock",
      "category": "SDockingNode",
      "signature": "OnUserAttemptingDock(Target, Direction, Drag Drop Event)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        },
        {
          "name": "Direction",
          "type": "SDockingNode::RelativeDirection"
        },
        {
          "name": "Drag Drop Event",
          "type": "FDragDropEvent&"
        }
      ],
      "returnType": "FReply",
      "docs": "Attempt to dock the TabWidget from the DragDropEvent next to this node.\n@param Direction       Where relative to this direction to dock the node: e.g. to the right\n@param DragDropEvent   DragAndDrop event that potentially carries\n@return An FReply::Handled() if we successfully docked the content; FReply::Unhandled() otherwise."
    },
    {
      "id": "get-size-rule",
      "name": "GetSizeRule",
      "category": "SDockingNode",
      "signature": "GetSizeRule(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "SSplitter::ESizeRule",
      "docs": "Should this node auto-size or be a percentage of its parent size; this setting is usually determined by users"
    },
    {
      "id": "get-size-coefficient",
      "name": "GetSizeCoefficient",
      "category": "SDockingNode",
      "signature": "GetSizeCoefficient(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "Float",
      "docs": "@return the numerator for the fraction of available space that this dock node should occupy."
    },
    {
      "id": "set-size-coefficient",
      "name": "SetSizeCoefficient",
      "category": "SDockingNode",
      "signature": "SetSizeCoefficient(Target, In Size Coefficient)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        },
        {
          "name": "In Size Coefficient",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Set the coefficient size"
    },
    {
      "id": "clean-up-nodes",
      "name": "CleanUpNodes",
      "category": "SDockingNode",
      "signature": "CleanUpNodes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingNode*"
        }
      ],
      "returnType": "SDockingNode::ECleanupRetVal"
    }
  ]
}