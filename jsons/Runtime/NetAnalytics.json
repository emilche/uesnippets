    {
      "id": "register-analytics-data-internal",
      "name": "RegisterAnalyticsData_Internal",
      "category": "NetAnalytics",
      "signature": "RegisterAnalyticsData_Internal(Target, In Data, In Data Name, In Type Name)",
      "params": [
