      "id": "set-num-ignored-components",
      "name": "SetNumIgnoredComponents",
      "category": "CollisionQueryParams",
      "signature": "SetNumIgnoredComponents(Target, New Num)",
      "params": [
        {
          "name": "Target",
          "type": "FCollisionQueryParams*"
        },
        {
          "name": "New Num",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the number of ignored components in the list. Uniqueness is not changed, it operates on the current state (unique or not).\nUseful for temporarily adding some, then restoring to a previous size. NewNum must be <= number of current components for there to be any effect."
