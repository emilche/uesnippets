    {
      "id": "f-mass-processing-phase-manager",
      "name": "FMassProcessingPhaseManager",
      "category": "MassProcessingPhaseManager",
      "signature": "FMassProcessingPhaseManager(In Processor Execution Flags)",
      "params": [
        {
          "name": "In Processor Execution Flags",
          "type": "EProcessorExecutionFlags",
          "default": "EProcessorExecutionFlags::None"
        }
      ],
      "returnType": "public :",
      "docs": "MassProcessingPhaseManager owns separate FMassProcessingPhase instances for every ETickingGroup. When activated\nvia Start function it registers and enables the FMassProcessingPhase instances which themselves are tick functions\nthat host UMassCompositeProcessor which they trigger as part of their Tick function.\nMassProcessingPhaseManager serves as an interface to said FMassProcessingPhase instances and allows initialization\nwith collections of processors (via Initialize function) as well as registering arbitrary functions to be called\nwhen a particular phase starts or ends (via GetOnPhaseStart and GetOnPhaseEnd functions)."
    },
    {
      "id": "initialize-a5f3c6",
      "name": "Initialize",
      "category": "MassProcessingPhaseManager",
      "signature": "Initialize(Target, In Owner, Processing Phases Config, Dependency Graph File Name)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "In Owner",
          "type": "UObject&"
        },
        {
          "name": "Processing Phases Config",
          "type": "TConstArrayView<FMassProcessingPhaseConfig>"
        },
        {
          "name": "Dependency Graph File Name",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "Void",
      "docs": "Populates hosted FMassProcessingPhase instances with Processors read from MassEntitySettings configuration.\nCalling this function overrides previous configuration of Phases."
    },
