{
  "id": "mass-processing-phase-manager",
  "label": "MassProcessingPhaseManager",
  "includepath": "MassProcessingPhaseManager.h",
  "includes": [
    "CoreMinimal",
    "UObjectGlobals",
    "Object",
    "GCObject",
    "MpscQueue",
    "EngineBaseTypes",
    "MassProcessingTypes",
    "MassProcessor",
    "MassProcessorDependencySolver",
    "MassProcessingPhaseManager.generated"
  ],
  "functions": [
    {
      "id": "execute-tick",
      "name": "ExecuteTick",
      "category": "MassProcessingPhaseManager",
      "signature": "ExecuteTick(Target, Delta Time, Tick Type, Current Thread, My Completion Graph Event)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhase*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Tick Type",
          "type": "ELevelTick"
        },
        {
          "name": "Current Thread",
          "type": "ENamedThreads::Type"
        },
        {
          "name": "My Completion Graph Event",
          "type": "FGraphEventRef&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "configure-9d29c1",
      "name": "Configure",
      "category": "MassProcessingPhaseManager",
      "signature": "Configure(Target, Dynamic Processors, In Out Removed Dynamic Processors, In World Execution Flags, Entity Manager, In Out Optional Result)",
      "params": [
        {
          "name": "Target",
          "type": "FMassPhaseProcessorConfigurationHelper*"
        },
        {
          "name": "Dynamic Processors",
          "type": "TArrayView<UMassProcessor*>"
        },
        {
          "name": "In Out Removed Dynamic Processors",
          "type": "TArray<TWeakObjectPtr<UMassProcessor>>&"
        },
        {
          "name": "In World Execution Flags",
          "type": "EProcessorExecutionFlags"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        },
        {
          "name": "In Out Optional Result",
          "type": "FMassProcessorDependencySolver::FResult&"
        }
      ],
      "returnType": "Void",
      "docs": "@param InWorldExecutionFlags - provide EProcessorExecutionFlags::None to let underlying code decide"
    },
    {
      "id": "configure-553fc0",
      "name": "Configure",
      "category": "MassProcessingPhaseManager",
      "signature": "Configure(Target, Dynamic Processors, In World Execution Flags, Entity Manager, Out Optional Result)",
      "params": [
        {
          "name": "Target",
          "type": "FMassPhaseProcessorConfigurationHelper*"
        },
        {
          "name": "Dynamic Processors",
          "type": "TArrayView<UMassProcessor*>"
        },
        {
          "name": "In World Execution Flags",
          "type": "EProcessorExecutionFlags"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedPtr<FMassEntityManager>&",
          "default": "TSharedPtr<FMassEntityManager>()"
        },
        {
          "name": "Out Optional Result",
          "type": "FMassProcessorDependencySolver::FResult*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "MassProcessingPhaseManager",
      "signature": "Initialize(Target, In Owner, Processing Phases Config, Dependency Graph File Name)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "In Owner",
          "type": "UObject&"
        },
        {
          "name": "Processing Phases Config",
          "type": "TConstArrayView<FMassProcessingPhaseConfig>"
        },
        {
          "name": "Dependency Graph File Name",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "Void",
      "docs": "Populates hosted FMassProcessingPhase instances with Processors read from MassEntitySettings configuration.\nCalling this function overrides previous configuration of Phases."
    },
    {
      "id": "deinitialize",
      "name": "Deinitialize",
      "category": "MassProcessingPhaseManager",
      "signature": "Deinitialize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        }
      ],
      "returnType": "Void",
      "docs": "Needs to be called before destruction, ideally before owner's BeginDestroy (a FGCObject's limitation)"
    },
    {
      "id": "trigger-phase",
      "name": "TriggerPhase",
      "category": "MassProcessingPhaseManager",
      "signature": "TriggerPhase(Target, Phase, Delta Time, My Completion Graph Event, Current Thread)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "Phase",
          "type": "EMassProcessingPhase"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "My Completion Graph Event",
          "type": "FGraphEventRef&"
        },
        {
          "name": "Current Thread",
          "type": "ENamedThreads::Type",
          "default": "ENamedThreads::GameThread"
        }
      ],
      "returnType": "FGraphEventRef&"
    },
    {
      "id": "start-3657bc",
      "name": "Start",
      "category": "MassProcessingPhaseManager",
      "signature": "Start(Target, World)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "World",
          "type": "UWorld&"
        }
      ],
      "returnType": "Void",
      "docs": "Stores EntityManager associated with given world's MassEntitySubsystem and kicks off phase ticking."
    },
    {
      "id": "start-8cf9c5",
      "name": "Start",
      "category": "MassProcessingPhaseManager",
      "signature": "Start(Target, In Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "In Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void",
      "docs": "Stores InEntityManager as the entity manager. It also kicks off phase ticking if the given InEntityManager is tied to a UWorld."
    },
    {
      "id": "stop",
      "name": "Stop",
      "category": "MassProcessingPhaseManager",
      "signature": "Stop(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "pause",
      "name": "Pause",
      "category": "MassProcessingPhaseManager",
      "signature": "Pause(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        }
      ],
      "returnType": "Void",
      "docs": "Pause this phase manager at the earliest opportunity (on next FrameEnd phase end).\nThis allows the current phase cycle to complete before the pause takes effect."
    },
    {
      "id": "resume",
      "name": "Resume",
      "category": "MassProcessingPhaseManager",
      "signature": "Resume(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        }
      ],
      "returnType": "Void",
      "docs": "Unpause this phase manager at the earliest opportunity (on next PrePhysics phase start)."
    },
    {
      "id": "get-name",
      "name": "GetName",
      "category": "MassProcessingPhaseManager",
      "signature": "GetName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "register-dynamic-processor",
      "name": "RegisterDynamicProcessor",
      "category": "MassProcessingPhaseManager",
      "signature": "RegisterDynamicProcessor(Target, Processor)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "Processor",
          "type": "UMassProcessor&"
        }
      ],
      "returnType": "Void",
      "docs": "Registers a dynamic processor. This needs to be a fully formed processor and will be slotted in during the next tick."
    },
    {
      "id": "unregister-dynamic-processor",
      "name": "UnregisterDynamicProcessor",
      "category": "MassProcessingPhaseManager",
      "signature": "UnregisterDynamicProcessor(Target, Processor)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "Processor",
          "type": "UMassProcessor&"
        }
      ],
      "returnType": "Void",
      "docs": "Removes a previously registered dynamic processor of throws an assert if not found."
    },
    {
      "id": "add-referenced-objects",
      "name": "AddReferencedObjects",
      "category": "MassProcessingPhaseManager",
      "signature": "AddReferencedObjects(Target, Collector)",
      "params": [
        {
          "name": "Target",
          "type": "FMassProcessingPhaseManager*"
        },
        {
          "name": "Collector",
          "type": "FReferenceCollector&"
        }
      ],
      "returnType": "Void"
    }
  ]
}