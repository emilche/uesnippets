{
  "id": "u-dynamic-mesh",
  "label": "UDynamicMesh",
  "includepath": "UDynamicMesh.h",
  "includes": [
    "CoreMinimal",
    "DynamicMesh3",
    "MeshVertexChange",
    "MeshChange",
    "MeshReplacementChange",
    "UDynamicMesh.generated"
  ],
  "functions": [
    {
      "id": "initialize-mesh",
      "name": "InitializeMesh",
      "category": "UDynamicMesh",
      "signature": "InitializeMesh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Reset the internal mesh data and then optionally run the MeshGenerator"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "Dynamic Mesh",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if the mesh has no triangles"
    },
    {
      "id": "get-mesh-ref",
      "name": "GetMeshRef",
      "category": "UDynamicMesh",
      "signature": "GetMeshRef(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "UE::Geometry::FDynamicMesh3&",
      "docs": "@return Const reference to the internal FDynamicMesh3.\n@warning Calling ProcessMesh() is preferred! This interface may be  removed in the future"
    },
    {
      "id": "get-mesh-ptr",
      "name": "GetMeshPtr",
      "category": "UDynamicMesh",
      "signature": "GetMeshPtr(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "UE::Geometry::FDynamicMesh3*",
      "docs": "@return Const pointer to the internal FDynamicMesh3.\n@warning Calling ProcessMesh() is preferred! This interface may be  removed in the future"
    },
    {
      "id": "set-mesh",
      "name": "SetMesh",
      "category": "UDynamicMesh",
      "signature": "SetMesh(Target, Move Mesh)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Move Mesh",
          "type": "UE::Geometry::FDynamicMesh3&"
        }
      ],
      "returnType": "Void",
      "docs": "Replace the internal mesh with a copy of MoveMesh"
    },
    {
      "id": "process-mesh",
      "name": "ProcessMesh",
      "category": "UDynamicMesh",
      "signature": "ProcessMesh(Target, Process Func)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Process Func",
          "type": "TFunctionRef<void ( UE::Geometry::FDynamicMesh3& )>"
        }
      ],
      "returnType": "Void",
      "docs": "Apply ProcessFunc to the internal Mesh"
    },
    {
      "id": "edit-mesh",
      "name": "EditMesh",
      "category": "UDynamicMesh",
      "signature": "EditMesh(Target, Edit Func, Change Type, Change Flags, Defer Change Events)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Edit Func",
          "type": "TFunctionRef<void ( UE::Geometry::FDynamicMesh3& )>"
        },
        {
          "name": "Change Type",
          "type": "EDynamicMeshChangeType",
          "default": "EDynamicMeshChangeType::GeneralEdit"
        },
        {
          "name": "Change Flags",
          "type": "EDynamicMeshAttributeChangeFlags",
          "default": "EDynamicMeshAttributeChangeFlags::Unknown"
        },
        {
          "name": "Defer Change Events",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Apply EditFunc to the internal mesh.\nThis will broadcast PreMeshChangedEvent, then call EditFunc(), then broadcast MeshChangedEvent and MeshModifiedBPEvent"
    },
    {
      "id": "extract-mesh",
      "name": "ExtractMesh",
      "category": "UDynamicMesh",
      "signature": "ExtractMesh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "TUniquePtr<UE::Geometry::FDynamicMesh3>",
      "docs": "Take ownership of the internal Mesh, and have it replaced with a new mesh"
    },
    {
      "id": "apply-change",
      "name": "ApplyChange",
      "category": "UDynamicMesh",
      "signature": "ApplyChange(Target, Change, Revert)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Change",
          "type": "FMeshVertexChange*"
        },
        {
          "name": "Revert",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-pre-mesh-changed",
      "name": "OnPreMeshChanged",
      "category": "UDynamicMesh",
      "signature": "OnPreMeshChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "FOnDynamicMeshChanged&",
      "docs": "Broadcast before the internal mesh is modified by Reset funcs, SetMesh(), EditMesh(), and ApplyChange()'s above"
    },
    {
      "id": "on-mesh-changed",
      "name": "OnMeshChanged",
      "category": "UDynamicMesh",
      "signature": "OnMeshChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "FOnDynamicMeshChanged&",
      "docs": "Broadcast after the internal mesh is modified, in the same cases as OnPreMeshChanged"
    },
    {
      "id": "on-mesh-realtime-update",
      "name": "OnMeshRealtimeUpdate",
      "category": "UDynamicMesh",
      "signature": "OnMeshRealtimeUpdate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "FOnMeshRealtimeUpdate&",
      "docs": "Multicast delegate that is broadcast whenever PostRealtimeUpdate() is called"
    },
    {
      "id": "post-realtime-update",
      "name": "PostRealtimeUpdate",
      "category": "UDynamicMesh",
      "signature": "PostRealtimeUpdate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Broadcasts FOnMeshRealtimeUpdate"
    },
    {
      "id": "initialize-new-mesh",
      "name": "InitializeNewMesh",
      "category": "UDynamicMesh",
      "signature": "InitializeNewMesh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Mesh data, owned by this object.\nBy default will have Attributes enabled and MaterialID enabled."
    },
    {
      "id": "edit-mesh-internal",
      "name": "EditMeshInternal",
      "category": "UDynamicMesh",
      "signature": "EditMeshInternal(Target, Edit Func, Change Info, Defer Change Events)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Edit Func",
          "type": "TFunctionRef<void ( UE::Geometry::FDynamicMesh3& )>"
        },
        {
          "name": "Change Info",
          "type": "FDynamicMeshChangeInfo&"
        },
        {
          "name": "Defer Change Events",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Internal function that edits the Mesh, but broadcasts PreMeshChangedEvent and MeshChangedEvent, and then MeshModifiedBPEvent"
    },
    {
      "id": "export-custom-properties",
      "name": "ExportCustomProperties",
      "category": "UDynamicMesh",
      "signature": "ExportCustomProperties(Target, Out, Indent)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Out",
          "type": "FOutputDevice&"
        },
        {
          "name": "Indent",
          "type": "UInt"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "import-custom-properties",
      "name": "ImportCustomProperties",
      "category": "UDynamicMesh",
      "signature": "ImportCustomProperties(Target, Source Text, Warn)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Source Text",
          "type": "TCHAR*"
        },
        {
          "name": "Warn",
          "type": "FFeedbackContext*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-mesh-generator",
      "name": "SetMeshGenerator",
      "category": "UDynamicMesh",
      "signature": "SetMeshGenerator(Target, New Generator)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "New Generator",
          "type": "TObjectPtr<UDynamicMeshGenerator>"
        }
      ],
      "returnType": "Void",
      "docs": "Set the active mesh generator. Clears if nullptr"
    },
    {
      "id": "clear-mesh-generator",
      "name": "ClearMeshGenerator",
      "category": "UDynamicMesh",
      "signature": "ClearMeshGenerator(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Set the active mesh generator. Clears if nullptr"
    },
    {
      "id": "regenerate",
      "name": "Regenerate",
      "category": "UDynamicMesh",
      "signature": "Regenerate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Reset() the mesh, which will re-run the active MeshGenerator, if bEnableMeshGenerator"
    },
    {
      "id": "request-mesh",
      "name": "RequestMesh",
      "category": "Dynamic Mesh",
      "signature": "RequestMesh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "UDynamicMesh*",
      "docs": "@return an available UDynamicMesh from the pool (possibly allocating a new mesh)"
    },
    {
      "id": "return-mesh",
      "name": "ReturnMesh",
      "category": "Dynamic Mesh",
      "signature": "ReturnMesh(Target, Mesh)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        },
        {
          "name": "Mesh",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Release a UDynamicMesh returned by RequestMesh() back to the pool"
    },
    {
      "id": "return-all-meshes",
      "name": "ReturnAllMeshes",
      "category": "Dynamic Mesh",
      "signature": "ReturnAllMeshes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Release all GeneratedMeshes back to the pool"
    },
    {
      "id": "free-all-meshes",
      "name": "FreeAllMeshes",
      "category": "Dynamic Mesh",
      "signature": "FreeAllMeshes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDynamicMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Release all GeneratedMeshes back to the pool and allow them to be garbage collected"
    }
  ]
}