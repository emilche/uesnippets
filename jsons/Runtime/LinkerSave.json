        {
          "name": "Target",
          "type": "FLinkerSave*"
        },
        {
          "name": "In Alignment",
          "type": "Int64"
        }
      ],
      "returnType": "Void",
      "docs": "Set target platform memory map alignment. A negative value disables memory mapped bulk data."
    },
    {
