      "params": [
        {
          "name": "Target",
          "type": "FLinkerSave*"
        },
        {
          "name": "Value",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether saving bulk data by reference, i.e. leaving the bulk data payload in the original .uasset file when using EditorDomain."
    },
    {
      "id": "set-save-bulk-data-to-separate-files",
      "name": "SetSaveBulkDataToSeparateFiles",
      "category": "LinkerSave",
      "signature": "SetSaveBulkDataToSeparateFiles(Target, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FLinkerSave*"
        },
        {
          "name": "Value",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether bulk data will be stored in the Linker archive (.uasset) or in sepearate files (.ubulk, .m.ubulk, .opt.ubulk) ."
    },
