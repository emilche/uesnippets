          "name": "Target",
          "type": "FPackageLocalizationCultureCache*"
        },
        {
          "name": "In Package Name",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Add a package (potentially source or localized) to this cache.\n@param InPackageName\t\tThe name of the package to add.\n@return TRUE if the supplied package is a localized asset and was added to the culture cache, FALSE otherwise"
    },
    {
      "id": "remove-package",
      "name": "RemovePackage",
      "category": "PackageLocalizationCache",
      "signature": "RemovePackage(Target, In Package Name)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageLocalizationCultureCache*"
        },
        {
          "name": "In Package Name",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove a package (potentially source or localized) from this cache.\n@param InPackageName\t\tThe name of the package to remove.\n@return TRUE if the supplied package is a localized asset and was removed from the culture cache, FALSE otherwise"
    },
