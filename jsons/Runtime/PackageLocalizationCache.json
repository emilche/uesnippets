      "params": [
        {
          "name": "Target",
          "type": "FPackageLocalizationCultureCache*"
        },
        {
          "name": "In Root Path",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a source path. This will remove it from the pending list, as well as immediately remove any localized package entries mapped from this source root.\n@param InRootPath\t\tThe root source path to remove."
    },
    {
