        {
          "name": "Target",
          "type": "FPackageLocalizationCultureCache*"
        },
        {
          "name": "In Root Path",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Add a source path to be scanned the next time ConditionalUpdateCache is called.\n@param InRootPath\t\tThe root source path to add."
    },
