    {
      "id": "append-or-override-runtime-processor-copies",
      "name": "AppendOrOverrideRuntimeProcessorCopies",
      "category": "MassProcessingTypes",
      "signature": "AppendOrOverrideRuntimeProcessorCopies(In Processors, In Owner)",
      "params": [
        {
          "name": "In Processors",
          "type": "TConstArrayView<UMassProcessor*>"
        },
        {
          "name": "In Owner",
          "type": "UObject&"
        }
      ],
      "returnType": "Void",
      "docs": "Creates a runtime instance of every processors in the given InProcessors array. If a processor of that class\nalready exists in Processors array it gets overridden. Otherwise it gets added to the end of the collection."
    },
    {
      "id": "append-unique-runtime-processor-copies-67aa18",
      "name": "AppendUniqueRuntimeProcessorCopies",
      "category": "MassProcessingTypes",
      "signature": "AppendUniqueRuntimeProcessorCopies(In Processors, In Owner, Entity Manager)",
      "params": [
        {
          "name": "In Processors",
          "type": "TConstArrayView<UMassProcessor*>"
        },
        {
          "name": "In Owner",
          "type": "UObject&"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void",
      "docs": "Creates a runtime instance of every processors in the given array if there's no processor of that class in Processors already.\nCall this function when adding processors to an already configured FMassRuntimePipeline instance. If you're creating\none from scratch calling any of the InitializeFrom* methods will be more efficient (and will produce same results)\nor call AppendOrOverrideRuntimeProcessorCopies.\nNOTE: there's a change in functionality since 5.6 - the function will no longer create duplicates for processors returning true from ShouldAllowMultipleInstances"
    },
