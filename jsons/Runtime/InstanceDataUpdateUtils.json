    {
      "id": "scatter-467a6c",
      "name": "Scatter",
      "category": "InstanceDataUpdateUtils",
      "signature": "Scatter<DeltaType, ValueType, IndexRemapType>(Delta, Out Dest, Dest Num Elements, In Source, Index Remap, Element Stride)",
      "params": [
        {
          "name": "Delta",
          "type": "DeltaType&"
        },
        {
          "name": "Out Dest",
          "type": "TArray<ValueType>&"
        },
        {
          "name": "Dest Num Elements",
          "type": "Int"
        },
        {
          "name": "In Source",
          "type": "TArray<ValueType>&&"
        },
        {
          "name": "Index Remap",
          "type": "IndexRemapType&"
        },
        {
          "name": "Element Stride",
          "type": "Int",
          "default": "1"
        }
      ],
      "returnType": "template<DeltaType,ValueType,IndexRemapType> void",
      "docs": "Write InSource that was previously gathered using the above methods to the final destination array OutDest\nusing the same delta information.\nIf there is no delta and the index remap is identity, it performs a move of the source data to the final array, saving a malloc & copy."
    },
