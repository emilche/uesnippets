{
  "id": "ar-pin",
  "label": "ARPin",
  "includepath": "ARPin.h",
  "includes": [
    "ARTypes",
    "ARPin.generated"
  ],
  "functions": [
    {
      "id": "get-local-to-tracking-transform",
      "name": "GetLocalToTrackingTransform",
      "category": "AR AugmentedReality",
      "signature": "GetLocalToTrackingTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Maps from a Pin's Local Space to the Tracking Space.\nMapping the origin from the Pin's Local Space to Tracking Space\nyield the Pin's position in Tracking Space."
    },
    {
      "id": "get-local-to-world-transform",
      "name": "GetLocalToWorldTransform",
      "category": "AR AugmentedReality",
      "signature": "GetLocalToWorldTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "FTransform",
      "docs": "Convenience function. Same as LocalToTrackingTransform, but\nappends the TrackingToWorld Transform."
    },
    {
      "id": "get-tracking-state",
      "name": "GetTrackingState",
      "category": "AR AugmentedReality",
      "signature": "GetTrackingState(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "EARTrackingState",
      "docs": "Return the current tracking state of this Pin."
    },
    {
      "id": "get-tracked-geometry",
      "name": "GetTrackedGeometry",
      "category": "AR AugmentedReality",
      "signature": "GetTrackedGeometry(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "UARTrackedGeometry*",
      "docs": "The TrackedGeometry (if any) that this this pin is being \"stuck\" into."
    },
    {
      "id": "get-pinned-component",
      "name": "GetPinnedComponent",
      "category": "AR AugmentedReality",
      "signature": "GetPinnedComponent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "USceneComponent*",
      "docs": "@return the PinnedComponent that this UARPin is pinning to the TrackedGeometry"
    },
    {
      "id": "debug-draw",
      "name": "DebugDraw",
      "category": "ARPin",
      "signature": "DebugDraw(Target, World, Color, Scale, Persist For Seconds)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        },
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Color",
          "type": "FLinearColor&"
        },
        {
          "name": "Scale",
          "type": "Float",
          "default": "5.0f"
        },
        {
          "name": "Persist For Seconds",
          "type": "Float",
          "default": "0.0f"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-debug-name",
      "name": "GetDebugName",
      "category": "AR AugmentedReality",
      "signature": "GetDebugName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UARPin*"
        }
      ],
      "returnType": "Name"
    }
  ]
}