{
  "id": "ip-address-bsd",
  "label": "IPAddressBSD",
  "includepath": "IPAddressBSD.h",
  "includes": [
    "CoreMinimal",
    "SocketSubsystemBSDPrivate",
    "IPAddress",
    "SocketTypes",
    "SocketSubsystemPackage"
  ],
  "functions": [
    {
      "id": "get-ip",
      "name": "GetIp",
      "category": "IPAddressBSD",
      "signature": "GetIp(Target, Out Addr)",
      "params": [
        {
          "name": "Target",
          "type": "FInternetAddrBSD*"
        },
        {
          "name": "Out Addr",
          "type": "in6_addr&"
        }
      ],
      "returnType": "Void",
      "docs": "Copies the network byte order ip address\n@param OutAddr the out param receiving the ip address"
    },
    {
      "id": "get-raw-addr",
      "name": "GetRawAddr",
      "category": "IPAddressBSD",
      "signature": "GetRawAddr(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInternetAddrBSD*"
        }
      ],
      "returnType": "sockaddr_storage*"
    }
  ]
}