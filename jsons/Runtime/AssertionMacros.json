    {
      "id": "log-formatted-message-with-callstack",
      "name": "LogFormattedMessageWithCallstack",
      "category": "AssertionMacros",
      "signature": "LogFormattedMessageWithCallstack(Log Name, File, Line, Heading, Message, Verbosity)",
      "params": [
        {
          "name": "Log Name",
          "type": "Name&"
        },
        {
          "name": "File",
          "type": "ANSICHAR*"
        },
        {
          "name": "Line",
          "type": "Int"
