        },
        {
          "name": "Key",
          "type": "KeyType&"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether an entry with the specified key is in the cache.\n@param Key The key of the entry to check.\n@return true if the entry is in the cache, false otherwise.\n@see Add, ContainsByPredicate, Empty, FilterByPredicate, Find, GetKeys, Remove"
    },
