    {
      "id": "rebuild",
      "name": "Rebuild",
      "category": "RefCountVector",
      "signature": "Rebuild<IterateFunc, AllocateRefCountFunc, IncrementRefCountFunc>(Target, Num, Iterate, Allocate Ref Count, Increment Ref Count)",
      "params": [
        {
          "name": "Target",
          "type": "FRefCountVector*"
        },
        {
          "name": "Num",
          "type": "unsigned int"
        },
        {
          "name": "Iterate",
          "type": "IterateFunc&&"
        },
        {
          "name": "Allocate Ref Count",
          "type": "AllocateRefCountFunc&&"
        },
        {
          "name": "Increment Ref Count",
          "type": "IncrementRefCountFunc&&"
        }
      ],
      "returnType": "template<IterateFunc,AllocateRefCountFunc,IncrementRefCountFunc> void",
      "docs": "Rebuilds all reference counts from external source data via callables.\nFor example, we could rebuild ref counts for vertices by iterating over all triangles via the Iterate callable, and in the process any vertex we\nencounter for the first time gets a ref count of 1 via the AllocateRefCount callable, and any vertex we encounter repeatedly has its ref count\nincremented by one via the IncrementRefCount callable.\n@param Num Number of items that get referenced.\n@param Iterate Callable that iterates over all referenced items in the external source data.\n@param AllocateRefCount Callable for allocating an item, i.e. an item that is referenced for the first time.\n@param IncrementRefCount Callable for incrementing an item, i.e. an item that has been referenced before."
    },
