    {
      "id": "i-virtual-texture",
      "name": "IVirtualTexture",
      "category": "VirtualTexturing",
      "signature": "IVirtualTexture()",
      "params": [],
      "returnType": "Void",
      "docs": "This is the interface that can produce tiles of virtual texture data\nThis can be extended to represent different ways of generating VT, such as disk streaming, runtime compositing, or whatever\nIt's provided to the renderer module"
    },
    {
      "id": "get-local-mip-bias",
      "name": "GetLocalMipBias",
      "category": "VirtualTexturing",
      "signature": "GetLocalMipBias(V Level, V Address)",
      "params": [
        {
          "name": "V Level",
          "type": "Byte"
        },
        {
          "name": "V Address",
          "type": "UInt"
        }
      ],
      "returnType": "UInt",
      "docs": "Gives a localized mip bias for the given local vAddress.\nThis is used to implement sparse VTs, the bias is number of mip levels to add to reach a resident page\nMust be thread-safe, may be called from any thread\n@param vLevel The mipmap level to check\n@param vAddress Virtual address to check\n@return Mip bias to be added to vLevel to reach a resident page at the given address"
    },
