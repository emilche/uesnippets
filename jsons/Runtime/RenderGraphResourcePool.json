{
  "id": "render-graph-resource-pool",
  "label": "RenderGraphResourcePool",
  "includepath": "RenderGraphResourcePool.h",
  "includes": [
    "RenderResource",
    "RendererInterface",
    "RenderGraphResources",
    "RecursiveMutex"
  ],
  "functions": [
    {
      "id": "tick-pool-elements",
      "name": "TickPoolElements",
      "category": "RenderGraphResourcePool",
      "signature": "TickPoolElements(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBufferPool*"
        }
      ],
      "returnType": "Void",
      "docs": "Call once per frame to trim elements from the pool."
    },
    {
      "id": "find-free-buffer",
      "name": "FindFreeBuffer",
      "category": "RenderGraphResourcePool",
      "signature": "FindFreeBuffer(Target, RHI Cmd List, Desc, In Debug Name, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBufferPool*"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandListBase&"
        },
        {
          "name": "Desc",
          "type": "FRDGBufferDesc&"
        },
        {
          "name": "In Debug Name",
          "type": "TCHAR*"
        },
        {
          "name": "Alignment",
          "type": "ERDGPooledBufferAlignment",
          "default": "ERDGPooledBufferAlignment::Page"
        }
      ],
      "returnType": "TRefCountPtr<FRDGPooledBuffer>"
    },
    {
      "id": "dump-memory-usage",
      "name": "DumpMemoryUsage",
      "category": "RenderGraphResourcePool",
      "signature": "DumpMemoryUsage(Target, Output Device)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBufferPool*"
        },
        {
          "name": "Output Device",
          "type": "FOutputDevice&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "release-rhi",
      "name": "ReleaseRHI",
      "category": "RenderGraphResourcePool",
      "signature": "ReleaseRHI(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBufferPool*"
        }
      ],
      "returnType": "Void"
    }
  ]
}