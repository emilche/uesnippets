    {
      "id": "f-thread-heart-beat-clock",
      "name": "FThreadHeartBeatClock",
      "category": "ThreadHeartBeat",
      "signature": "FThreadHeartBeatClock(In Max Time Step)",
      "params": [
        {
          "name": "In Max Time Step",
          "type": "Double"
        }
      ],
      "returnType": "public :",
      "docs": "Our own local clock.\nPlatforms that support suspend/resume have problems where a suspended title acts like\na long hitch, causing the hang detector to fire incorrectly when the title is resumed.\nTo solve this, we accumulate our own time on the hang detector thread.\nWhen the title is suspended, this thread is also suspended, and the local clock stops.\nThe delta is clamped so if we are resumed, the clock continues from where it left off."
    },
