      "id": "add-draw-texture-pass-1fa886",
      "name": "AddDrawTexturePass",
      "category": "ScreenPass",
      "signature": "AddDrawTexturePass(Graph Builder, View Info, Input Texture, Output Texture, Input Position, Output Position, Size)",
      "params": [
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        },
        {
          "name": "View Info",
          "type": "FScreenPassViewInfo"
        },
        {
          "name": "Input Texture",
          "type": "FRDGTextureRef"
        },
        {
          "name": "Output Texture",
          "type": "FRDGTextureRef"
        },
        {
          "name": "Input Position",
          "type": "FIntPoint",
          "default": "FIntPoint::ZeroValue"
        },
        {
          "name": "Output Position",
          "type": "FIntPoint",
          "default": "FIntPoint::ZeroValue"
        },
        {
          "name": "Size",
          "type": "FIntPoint",
          "default": "FIntPoint::ZeroValue"
        }
      ],
      "returnType": "Void",
      "docs": "Helper function which copies a region of an input texture to a region of the output texture,\nwith support for format conversion. If formats match, the method falls back to a simple DMA\n(CopyTexture); otherwise, it rasterizes using a pixel shader. Use this method if the two\ntextures may have different formats."
    },
