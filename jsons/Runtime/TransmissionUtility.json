{
  "id": "transmission-utility",
  "label": "TransmissionUtility",
  "includepath": "TransmissionUtility.h",
  "includes": [
    "Array",
    "SimpleVehicle",
    "TransmissionSystem",
    "WheelSystem"
  ],
  "functions": [
    {
      "id": "is-wheel-powered",
      "name": "IsWheelPowered",
      "category": "TransmissionUtility",
      "signature": "IsWheelPowered(Differential Type, Axle Type, Engine Enabled)",
      "params": [
        {
          "name": "Differential Type",
          "type": "EDifferentialType"
        },
        {
          "name": "Axle Type",
          "type": "FSimpleWheelConfig::EAxleType"
        },
        {
          "name": "Engine Enabled",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-num-wheels-on-axle",
      "name": "GetNumWheelsOnAxle",
      "category": "TransmissionUtility",
      "signature": "GetNumWheelsOnAxle(Axle Type, Wheels)",
      "params": [
        {
          "name": "Axle Type",
          "type": "FSimpleWheelConfig::EAxleType"
        },
        {
          "name": "Wheels",
          "type": "TArray<FSimpleWheelSim>&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-num-driven-wheels",
      "name": "GetNumDrivenWheels",
      "category": "TransmissionUtility",
      "signature": "GetNumDrivenWheels(Wheels)",
      "params": [
        {
          "name": "Wheels",
          "type": "TArray<FSimpleWheelSim>&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-torque-ratio-for-wheel",
      "name": "GetTorqueRatioForWheel",
      "category": "TransmissionUtility",
      "signature": "GetTorqueRatioForWheel(P Differential, Wheel Index, Wheels)",
      "params": [
        {
          "name": "P Differential",
          "type": "FSimpleDifferentialSim&"
        },
        {
          "name": "Wheel Index",
          "type": "Int"
        },
        {
          "name": "Wheels",
          "type": "TArray<FSimpleWheelSim>&"
        }
      ],
      "returnType": "Float"
    }
  ]
}