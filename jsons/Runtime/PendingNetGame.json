          "default": "FObjectInitializer::Get()"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "init-net-driver",
      "name": "InitNetDriver",
      "category": "PendingNetGame",
      "signature": "InitNetDriver(Target, In Net Driver)",
      "params": [
        {
          "name": "Target",
          "type": "UPendingNetGame*"
        },
        {
          "name": "In Net Driver",
          "type": "UNetDriver*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Inititalize the NetDriver to be used for the server connection handshake.\nIf InNetDriver is null then a new NetDriver will be created in the world using the\nNAME_GameNetDriver driver definition.\nIf InNetDriver is not null then it's expected that the NetDriver passed in has only\nbeen created and has not begun listening for connections or connecting to a remote\nserver."
    },
    {
      "id": "begin-handshake",
      "name": "BeginHandshake",
      "category": "PendingNetGame",
      "signature": "BeginHandshake(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UPendingNetGame*"
        }
      ],
      "returnType": "Void",
      "docs": "Begin initial handshake if needed, or call SendInitialJoin."
    },
