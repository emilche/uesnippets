{
  "id": "pending-net-game",
  "label": "PendingNetGame",
  "includepath": "Engine/PendingNetGame.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "UObjectGlobals",
    "Object",
    "EngineBaseTypes",
    "NetworkDelegates",
    "PendingNetGame.generated"
  ],
  "functions": [
    {
      "id": "finalize-encrypted-connection",
      "name": "FinalizeEncryptedConnection",
      "category": "PendingNetGame",
      "signature": "FinalizeEncryptedConnection(Target, Response, Weak Connection)",
      "params": [
        {
          "name": "Target",
          "type": "UPendingNetGame*"
        },
        {
          "name": "Response",
          "type": "FEncryptionKeyResponse&"
        },
        {
          "name": "Weak Connection",
          "type": "TWeakObjectPtr<UNetConnection>"
        }
      ],
      "returnType": "Void",
      "docs": "Setup the connection for encryption with a given key\nAll future packets are expected to be encrypted\n@param Response response from the game containing its encryption key or an error message\n@param WeakConnection the connection related to the encryption request"
    },
    {
      "id": "set-encryption-key",
      "name": "SetEncryptionKey",
      "category": "PendingNetGame",
      "signature": "SetEncryptionKey(Target, Response)",
      "params": [
        {
          "name": "Target",
          "type": "UPendingNetGame*"
        },
        {
          "name": "Response",
          "type": "FEncryptionKeyResponse&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the encryption key for the connection. This doesn't cause outgoing packets to be encrypted,\nbut it allows the connection to decrypt any incoming packets if needed.\n@param Response response from the game containing its encryption key or an error message"
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "PendingNetGame",
      "signature": "Initialize(Target, In URL)",
      "params": [
        {
          "name": "Target",
          "type": "UPendingNetGame*"
        },
        {
          "name": "In URL",
          "type": "FURL&"
        }
      ],
      "returnType": "Void",
      "docs": "URL associated with this level."
    },
    {
      "id": "u-pending-net-game",
      "name": "UPendingNetGame",
      "category": "PendingNetGame",
      "signature": "UPendingNetGame(Object Initializer)",
      "params": [
        {
          "name": "Object Initializer",
