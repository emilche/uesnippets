    {
      "id": "frhi-commit-resource-info",
      "name": "FRHICommitResourceInfo",
      "category": "RHITransition",
      "signature": "FRHICommitResourceInfo(Target, In Size In Bytes)",
      "params": [
        {
          "name": "Target",
          "type": "FRHITransition*"
        },
        {
          "name": "In Size In Bytes",
          "type": "uint64 InSizeInBytes ) : SizeInBytes ("
        }
      ],
      "returnType": "Void",
      "docs": "Represents a change in physical memory allocation for a resource that was created with TexCreate/BUF_ReservedResource flag.\nPhysical memory is allocated in tiles/pages and mapped to the tail of the currently committed region of the resource.\nThis API may be used to grow or shrink reserved resources without moving the bulk of the data or re-creating SRVs/UAVs.\nThe contents of the newly committed region of the resource is undefined and must be overwritten by the application before use.\nReserved resources must be created with maximum expected size, which will not cost any memory until committed.\nCommit size must be smaller or equal to the maximum resource size specified at creation.\nCheck GRHIGlobals.ReservedResources.Supported before using this API or TexCreate/BUF_ReservedResource flag."
    },
