{
  "id": "vector-set-analysis",
  "label": "VectorSetAnalysis",
  "includepath": "Sampling/VectorSetAnalysis.h",
  "includes": [
    "CoreMinimal",
    "VectorTypes"
  ],
  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "VectorSetAnalysis",
      "signature": "Initialize(Target, Enumerable I Ds, Get Vector Func, Num Vectors Hint, Is Normalized Hint)",
      "params": [
        {
          "name": "Target",
          "type": "TVectorSetAnalysis3*"
        },
        {
          "name": "Enumerable I Ds",
          "type": "EnumerableIDType"
        },
        {
          "name": "Get Vector Func",
          "type": "TFunctionRef<TVector<RealType> ( int32 )>"
        },
        {
          "name": "Num Vectors Hint",
          "type": "Int",
          "default": "0"
        },
        {
          "name": "Is Normalized Hint",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "template<EnumerableIDType> void",
      "docs": "TVectorSetAnalysis3 computes various analyses of a set of input Vectors (currently mainly clustering."
    },
    {
      "id": "num-vectors",
      "name": "NumVectors",
      "category": "VectorSetAnalysis",
      "signature": "NumVectors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TVectorSetAnalysis3*"
        }
      ],
      "returnType": "Int",
      "docs": "@return number of input vectors"
    },
    {
      "id": "num-clusters",
      "name": "NumClusters",
      "category": "VectorSetAnalysis",
      "signature": "NumClusters(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TVectorSetAnalysis3*"
        }
      ],
      "returnType": "Int",
      "docs": "@return number of clusters found by last clustering algorithm (may be zero if not initialized)"
    },
    {
      "id": "greedy-cluster-vectors",
      "name": "GreedyClusterVectors",
      "category": "VectorSetAnalysis",
      "signature": "GreedyClusterVectors(Target, Angle Tolerance Deg)",
      "params": [
        {
          "name": "Target",
          "type": "TVectorSetAnalysis3*"
        },
        {
          "name": "Angle Tolerance Deg",
          "type": "RealType"
        }
      ],
      "returnType": "Void",
      "docs": "Run simple greedy clustering algorithm on input ClusterVectors.\nDone in a single pass over vectors, each successive Vector is either grouped with one of the\nexisting clusters if it's direction is within AngleToleranceDeg, or creates a new cluster."
    }
  ]
}