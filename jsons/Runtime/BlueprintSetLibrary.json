    {
      "id": "set-get-item-by-index",
      "name": "Set_GetItemByIndex",
      "category": "Utilities",
      "signature": "Set_GetItemByIndex(Target Set, Index, Item)",
      "params": [
        {
          "name": "Target Set",
          "type": "TSet<int32>&"
        },
        {
          "name": "Index",
          "type": "Int"
        },
        {
          "name": "Item",
          "type": "Int&"
        }
      ],
      "returnType": "Void",
      "docs": "Given a set and an index, returns a copy of the item found at that index.\nIndex may differ from the order in which they were added. This function is implemented\nfor the purpose of iterating sets by index.\n@param\tTargetSet\t\tThe set to get an item from\n@param\tIndex\t\t\tThe index in the set to get an item from\n@return\tA copy of the item stored at the index"
    },
