      "id": "set-add-items",
      "name": "Set_AddItems",
      "category": "Utilities",
      "signature": "Set_AddItems(Target Set, New Items)",
      "params": [
        {
          "name": "Target Set",
          "type": "TSet<int32>&"
        },
        {
          "name": "New Items",
          "type": "TArray<int32>&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds all elements from an Array to a Set\n@param\tTargetSet\t\tThe set to search for the item\n@param\tNewItems\t\tThe items to add to the set"
    },
    {
      "id": "set-remove",
      "name": "Set_Remove",
      "category": "Utilities",
      "signature": "Set_Remove(Target Set, Item)",
      "params": [
        {
          "name": "Target Set",
          "type": "TSet<int32>&"
        },
        {
          "name": "Item",
          "type": "Int&"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove item from set. Output value indicates if something was actually removed. False\nindicates no equivalent item was found.\n@param\tTargetSet\t\tThe set to remove from\n@param\tItem\t\t\tThe item to remove from the set\n@return\tTrue if an item was removed (False indicates no equivalent item was present)"
    },
