    },
    {
      "id": "set-contains",
      "name": "Set_Contains",
      "category": "Utilities",
      "signature": "Set_Contains(Target Set, Item To Find)",
      "params": [
        {
          "name": "Target Set",
          "type": "TSet<int32>&"
        },
        {
          "name": "Item To Find",
          "type": "Int&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the set contains the given item.\n@param\tTargetSet\t\tThe set to search for the item\n@param\tItemToFind\t\tThe item to look for\n@return\tTrue if the item was found within the set"
    },
    {
      "id": "set-intersection",
      "name": "Set_Intersection",
      "category": "Utilities",
      "signature": "Set_Intersection(A, B, Result)",
      "params": [
        {
          "name": "A",
          "type": "TSet<int32>&"
        },
        {
          "name": "B",
          "type": "TSet<int32>&"
        },
        {
          "name": "Result",
          "type": "TSet<int32>&"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns Result to the intersection of Set A and Set B. That is, Result will contain\nall elements that are in both Set A and Set B. To intersect with the empty set use\nClear.\n@param\t\tA\t\tOne set to intersect\n@param\t\tB\t\tAnother set to intersect\n@param\t\tResult\tSet to store results in"
    },
    {
      "id": "set-union",
      "name": "Set_Union",
      "category": "Utilities",
      "signature": "Set_Union(A, B, Result)",
      "params": [
        {
          "name": "A",
          "type": "TSet<int32>&"
        },
        {
          "name": "B",
          "type": "TSet<int32>&"
        },
        {
          "name": "Result",
          "type": "TSet<int32>&"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns Result to the union of two sets, A and B. That is, Result will contain\nall elements that are in Set A and in addition all elements in Set B. Note that\na Set is a collection of unique elements, so duplicates will be eliminated.\n@param\t\tA\t\tOne set to union\n@param\t\tB\t\tAnother set to union\n@param\t\tResult\tSet to store results in"
    },
    {
      "id": "set-difference",
      "name": "Set_Difference",
      "category": "Utilities",
      "signature": "Set_Difference(A, B, Result)",
      "params": [
        {
          "name": "A",
          "type": "TSet<int32>&"
        },
        {
          "name": "B",
          "type": "TSet<int32>&"
        },
        {
          "name": "Result",
          "type": "TSet<int32>&"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns Result to the relative difference of two sets, A and B. That is, Result will\ncontain  all elements that are in Set A but are not found in Set B. Note that the\ndifference between two sets  is not commutative. The Set whose elements you wish to\npreserve should be the first (top) parameter. Also called the relative complement.\n@param\t\tA\t\tStarting set\n@param\t\tB\t\tSet of elements to remove from set A\n@param\t\tResult\tSet containing all elements in A that are not found in B"
    },
    {
