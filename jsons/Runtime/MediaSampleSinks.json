{
  "id": "media-sample-sinks",
  "label": "MediaSampleSinks",
  "includepath": "MediaSampleSinks.h",
  "includes": [
    "CoreTypes",
    "Array",
    "SharedPointer",
    "MediaSampleSink"
  ],
  "functions": [
    {
      "id": "enqueue",
      "name": "Enqueue",
      "category": "MediaSampleSinks",
      "signature": "Enqueue(Target, Sample)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        },
        {
          "name": "Sample",
          "type": "TSharedRef<SampleType,ESPMode::ThreadSafe>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Enqueue the given media samples to the registered sinks.\nThis method will also remove expired sinks that haven't been removed yet.\n@param Sample The media sample to enqueue.\n@param MaxQueueDepth The maximum depth of the sink queues before overflow.\n@return true if the sample was enqueued to all sinks, false if one or more sinks overflowed.\n@see Flush"
    },
    {
      "id": "flush",
      "name": "Flush",
      "category": "MediaSampleSinks",
      "signature": "Flush(Target, Media Player)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        },
        {
          "name": "Media Player",
          "type": "UMediaPlayer*"
        }
      ],
      "returnType": "Void",
      "docs": "Flush all registered sinks.\nThis method will also remove expired sinks that haven't been removed yet.\n@see Enqueue"
    },
    {
      "id": "num",
      "name": "Num",
      "category": "MediaSampleSinks",
      "signature": "Num(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        }
      ],
      "returnType": "Int",
      "docs": "Get the number of sinks in this collection.\n@return Number of sinks.\n@see Add, Remove"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "MediaSampleSinks",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if any sinks are inserted\n@return True if empty, false otherwise"
    },
    {
      "id": "remove",
      "name": "Remove",
      "category": "MediaSampleSinks",
      "signature": "Remove(Target, Sample Sink, Player)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        },
        {
          "name": "Sample Sink",
          "type": "TSharedRef<SinkType,ESPMode::ThreadSafe>&"
        },
        {
          "name": "Player",
          "type": "UMediaPlayer*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the given media sample sink from the collection.\n@param SampleSink The sink to remove.\n@see Add, Num"
    },
    {
      "id": "cleanup",
      "name": "Cleanup",
      "category": "MediaSampleSinks",
      "signature": "Cleanup(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TMediaSampleSinks*"
        }
      ],
      "returnType": "Void",
      "docs": "Remove any invalid sinks"
    }
  ]
