{
  "id": "integral-curve",
  "label": "IntegralCurve",
  "includepath": "Curves/IntegralCurve.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "KeyHandle",
    "IndexedCurve",
    "IntegralCurve.generated"
  ],
  "functions": [
    {
      "id": "evaluate",
      "name": "Evaluate",
      "category": "IntegralCurve",
      "signature": "Evaluate(Target, Time, In Default Value)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Time",
          "type": "Float"
        },
        {
          "name": "In Default Value",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Int",
      "docs": "Evaluates the value of an array of keys at a time"
    },
    {
      "id": "get-key-iterator",
      "name": "GetKeyIterator",
      "category": "IntegralCurve",
      "signature": "GetKeyIterator(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        }
      ],
      "returnType": "TArray<FIntegralKey>::TConstIterator",
      "docs": "Const iterator for the keys, so the indices and handles stay valid"
    },
    {
      "id": "add-key",
      "name": "AddKey",
      "category": "IntegralCurve",
      "signature": "AddKey(Target, In Time, In Value, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "In Value",
          "type": "Int"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle",
          "default": "FKeyHandle()"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Add a new key to the curve with the supplied Time and Value.\n@param KeyHandle Optionally can specify what handle this new key should have, otherwise, it'll make a new one\n@return The handle of the new key"
    },
    {
      "id": "delete-key",
      "name": "DeleteKey",
      "category": "IntegralCurve",
      "signature": "DeleteKey(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the specified key from the curve."
    },
    {
      "id": "update-or-add-key",
      "name": "UpdateOrAddKey",
      "category": "IntegralCurve",
      "signature": "UpdateOrAddKey(Target, In Time, Value, Key Time Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "Value",
          "type": "Int"
        },
        {
          "name": "Key Time Tolerance",
          "type": "Float",
          "default": "UE_KINDA_SMALL_NUMBER"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Finds the key at InTime, and updates its value. If it can't find the key within the KeyTimeTolerance, it adds one at that time"
    },
    {
      "id": "set-key-time",
      "name": "SetKeyTime",
      "category": "IntegralCurve",
      "signature": "SetKeyTime(Target, Key Handle, New Time)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        },
        {
          "name": "New Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Move a key to a new time."
    },
    {
      "id": "get-key-time",
      "name": "GetKeyTime",
      "category": "IntegralCurve",
      "signature": "GetKeyTime(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "Float",
      "docs": "Get the time for the Key with the specified index."
    },
    {
      "id": "set-key-value",
      "name": "SetKeyValue",
      "category": "IntegralCurve",
      "signature": "SetKeyValue(Target, Key Handle, New Value)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        },
        {
          "name": "New Value",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the value of the key with the specified index."
    },
    {
      "id": "get-key-value",
      "name": "GetKeyValue",
      "category": "IntegralCurve",
      "signature": "GetKeyValue(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "Int",
      "docs": "Get the value for the Key with the specified index."
    },
    {
      "id": "get-key",
      "name": "GetKey",
      "category": "IntegralCurve",
      "signature": "GetKey(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "FIntegralKey&",
      "docs": "Functions for getting keys based on handles"
    },
    {
      "id": "find-key",
      "name": "FindKey",
      "category": "IntegralCurve",
      "signature": "FindKey(Target, Key Time, Key Time Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Time",
          "type": "Float"
        },
        {
          "name": "Key Time Tolerance",
          "type": "Float",
          "default": "UE_KINDA_SMALL_NUMBER"
        }
      ],
      "returnType": "FKeyHandle"
    },
    {
      "id": "find-key-before-or-at",
      "name": "FindKeyBeforeOrAt",
      "category": "IntegralCurve",
      "signature": "FindKeyBeforeOrAt(Target, Key Time)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        },
        {
          "name": "Key Time",
          "type": "Float"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Gets the handle for the last key which is at or before the time requested.  If there are no keys at or before the requested time, an invalid handle is returned."
    },
    {
      "id": "remove-redundant-keys",
      "name": "RemoveRedundantKeys",
      "category": "IntegralCurve",
      "signature": "RemoveRedundantKeys(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIntegralCurve*"
        }
      ],
      "returnType": "Void",
      "docs": "Tries to reduce the number of keys required for accurate evaluation (zero error threshold)"
    }
  ]
}