      "name": "GetConsumerInput_Internal",
      "category": "SimCallbackObject",
      "signature": "GetConsumerInput_Internal(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ISimCallbackObject*"
        }
      ],
      "returnType": "TInputType*",
      "docs": "Get the input associated with the current sim step. This input was provided by the external thread. Note the data could be from a few frames ago"
    },
    {
      "id": "pop-output-data-external",
      "name": "PopOutputData_External",
      "category": "SimCallbackObject",
      "signature": "PopOutputData_External(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ISimCallbackObject*"
        }
      ],
      "returnType": "TSimCallbackOutputHandle<TOutputType>",
      "docs": "Gets the output data produced in order up to and including SimTime. Typical usage is:\nwhile(auto Output = PopOutputData_External(ExternalTime)) { //process output }"
    },
    {
      "id": "pop-future-output-data-external",
      "name": "PopFutureOutputData_External",
      "category": "SimCallbackObject",
      "signature": "PopFutureOutputData_External(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ISimCallbackObject*"
        }
      ],
      "returnType": "TSimCallbackOutputHandle<TOutputType>",
      "docs": "Pop up to the latest output, even if it is in the future.\nNOTE: It's up to the user to check the internal time of the outputs\nthat this produces. See GetSolver()->GetPhysicsResultsTime_External()\nfor the interpolation time.\nA typical example is to pop all of these into a queue, and to\ninterpolate them manually."
    },
    {
      "id": "is-output-queue-empty-external",
      "name": "IsOutputQueueEmpty_External",
      "category": "SimCallbackObject",
      "signature": "IsOutputQueueEmpty_External(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ISimCallbackObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if the output queue is empty of data\nCan be used while iterating the queue through PopOutputData_External and PopFutureOutputData_External to check if the current data is the last data."
    },
    {
