    {
      "id": "write-bytes",
      "name": "WriteBytes",
      "category": "NetBitStreamUtil",
      "signature": "WriteBytes(Writer, Src, Bytes To Write)",
      "params": [
        {
          "name": "Writer",
          "type": "FNetBitStreamWriter*"
        },
        {
          "name": "Src",
          "type": "Byte*"
        },
        {
          "name": "Bytes To Write",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Write bytes\nNote: The purpose of this method is for cases when we cannot guarantee that the buffer is word aligned. If buffer is known to be word aligned, it is faster to use NetBitStreamReader::WriteBitStream directly.\nDoes not write the size."
    },
    {
      "id": "read-bytes",
      "name": "ReadBytes",
      "category": "NetBitStreamUtil",
      "signature": "ReadBytes(Reader, Destination, Bytes To Read)",
