        },
        {
          "name": "Destination",
          "type": "Byte*"
        },
        {
          "name": "Bytes To Read",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Read bytes into preallocated buffer\nNote: The purpose of this method is for cases when we cannot guarantee that the buffer is word aligned. If buffer is known to be word aligned, it is faster to use NetBitStreamReader::ReadBitStream directly."
    }
