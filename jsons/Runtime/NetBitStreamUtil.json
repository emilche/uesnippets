        {
          "name": "Out Data",
          "type": "UInt*"
        },
        {
          "name": "Bit Count",
          "type": "UInt"
        },
        {
          "name": "Hint",
          "type": "ESparseBitArraySerializationHint",
          "default": "ESparseBitArraySerializationHint::None"
        }
      ],
      "returnType": "Void",
      "docs": "Read sparse BitArray which is expected to contain mostly 0`s, if the array contains mostly 1`s passing the hint ESparseBitArraySerializationHint::ContainsMostlyOnes can be provided to flip the read data"
    },
