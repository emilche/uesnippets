        },
        {
          "name": "Version",
          "type": "FAssetRegistryVersion::Type&"
        }
      ],
      "returnType": "Bool",
      "docs": "Version used for serializing asset registry caches, both runtime and editor"
    },
    {
      "id": "split-into-outer-path-and-asset-name",
      "name": "SplitIntoOuterPathAndAssetName",
      "category": "AssetData",
      "signature": "SplitIntoOuterPathAndAssetName(Target, In Object Path)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetData*"
        },
        {
          "name": "In Object Path",
          "type": "FStringView"
        }
      ],
      "returnType": "FAssetPathParts",
      "docs": "Split a full object path into the path of the innermost object's outer and the name of that object.\nE.g. splits /Path/To/PackageName.AssetName:SubObject.Innermost into /Path/To/PackageName.AssetName:SubObject and Innermost"
    },
    {
      "id": "concatenate-outer-path-and-object-name",
      "name": "ConcatenateOuterPathAndObjectName",
      "category": "AssetData",
      "signature": "ConcatenateOuterPathAndObjectName(Target, Builder, Outer Path, Object Name)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetData*"
        },
        {
          "name": "Builder",
          "type": "FStringBuilderBase&"
        },
        {
          "name": "Outer Path",
          "type": "Name"
        },
        {
          "name": "Object Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Concatenates an existing object path with an inner object with the correct separator ('.' or ':'). Assumes the outer path already contains correct separators."
    },
