    {
      "id": "get-soft-object-path",
      "name": "GetSoftObjectPath",
      "category": "AssetData",
      "signature": "GetSoftObjectPath(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetData*"
        }
      ],
      "returnType": "FSoftObjectPath",
      "docs": "Convert to a SoftObjectPath. PackageName.AssetName for ToplevelAssets. OptionalOuterName and AssetName joined by : or . for sub-object assets"
    },
    {
      "id": "is-u-asset",
      "name": "IsUAsset",
      "category": "AssetData",
      "signature": "IsUAsset(Object)",
      "params": [
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the given UObject is the main asset in a package, true for maps and assets but false for secondary objects like class redirectors\nEvery UAsset is also a TopLevelAsset."
    },
    {
      "id": "is-top-level-asset-4672ba",
      "name": "IsTopLevelAsset",
      "category": "AssetData",
      "signature": "IsTopLevelAsset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetData*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true iff the Asset is a TopLevelAsset (not a subobject, its outer is a UPackage).\nOnly TopLevelAssets can be PrimaryAssets in the AssetManager.\nA TopLevelAsset is not necessarily the main asset in a package; see IsUAsset.\nNote that this is distinct from UObject::IsAsset because IsAsset can be overloaded (see e.g. AActor::IsAsset)"
    },
    {
      "id": "is-top-level-asset-3c2c8c",
      "name": "IsTopLevelAsset",
      "category": "AssetData",
      "signature": "IsTopLevelAsset(Object)",
      "params": [
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true iff the given Object, assumed to be an Asset, is a TopLevelAsset (not a subobject, its outer is a UPackage).\nOnly TopLevelAssets can be PrimaryAssets in the AssetManager.\nA TopLevelAsset is not necessarily the main asset in a package; see IsUAsset."
    },
