{
  "id": "reflection-capture-component",
  "label": "ReflectionCaptureComponent",
  "includepath": "Components/ReflectionCaptureComponent.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Guid",
    "CoreStats",
    "RefCounting",
    "SceneComponent",
    "RenderCommandFence",
    "ReflectionCaptureComponent.generated"
  ],
  "functions": [
    {
      "id": "create-scene-proxy",
      "name": "CreateSceneProxy",
      "category": "ReflectionCaptureComponent",
      "signature": "CreateSceneProxy(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UReflectionCaptureComponent*"
        }
      ],
      "returnType": "FReflectionCaptureProxy*",
      "docs": "Cubemap texture resource used for rendering with the encoded HDR values."
    },
    {
      "id": "mark-dirty-for-recapture-or-upload",
      "name": "MarkDirtyForRecaptureOrUpload",
      "category": "ReflectionCaptureComponent",
      "signature": "MarkDirtyForRecaptureOrUpload(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UReflectionCaptureComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Adds the capture to the capture queue processed by UpdateReflectionCaptureContents."
    },
    {
      "id": "mark-dirty-for-recapture",
      "name": "MarkDirtyForRecapture",
      "category": "ReflectionCaptureComponent",
      "signature": "MarkDirtyForRecapture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UReflectionCaptureComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Generates a new MapBuildDataId and adds the capture to the capture queue processed by UpdateReflectionCaptureContents."
    },
    {
      "id": "update-reflection-capture-contents",
      "name": "UpdateReflectionCaptureContents",
      "category": "ReflectionCaptureComponent",
      "signature": "UpdateReflectionCaptureContents(World To Update, Capture Reason, Verify Only Capturing, Capturing For Mobile, Inside Tick)",
      "params": [
        {
          "name": "World To Update",
          "type": "UWorld*"
        },
        {
          "name": "Capture Reason",
          "type": "TCHAR*",
          "default": "nullptr"
        },
        {
          "name": "Verify Only Capturing",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Capturing For Mobile",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Inside Tick",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Generally called each tick to recapture any queued reflection captures.  In some cases, it's also called from Editor utility functions or commands.\nSet \"bInsideTick\" to true if called from inside a Tick function, indicating a render frame is already active, and the capture doesn't need to start one."
    },
    {
      "id": "get-map-build-data",
      "name": "GetMapBuildData",
      "category": "ReflectionCaptureComponent",
      "signature": "GetMapBuildData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UReflectionCaptureComponent*"
        }
      ],
      "returnType": "class FReflectionCaptureMapBuildData*"
    },
    {
      "id": "get-reflection-capture-size",
      "name": "GetReflectionCaptureSize",
      "category": "ReflectionCaptureComponent",
      "signature": "GetReflectionCaptureSize()",
      "params": [],
      "returnType": "Int"
    },
    {
      "id": "generate-encoded-hdr-data",
      "name": "GenerateEncodedHDRData",
      "category": "ReflectionCaptureComponent",
      "signature": "GenerateEncodedHDRData(Target, Full HDR Data, Cubemap Size, Out Encoded HDR Data)",
      "params": [
        {
          "name": "Target",
          "type": "UReflectionCaptureComponent*"
        },
        {
          "name": "Full HDR Data",
          "type": "TArray<uint8>&"
        },
        {
          "name": "Cubemap Size",
          "type": "Int"
        },
        {
          "name": "Out Encoded HDR Data",
          "type": "TArray<uint8>&"
        }
      ],
      "returnType": "Void"
    }
  ]
}