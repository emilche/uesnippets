      "docs": "Releases as much memory as possible. Must be called from the main thread."
    },
    {
      "id": "setup-tls-caches-on-current-thread",
      "name": "SetupTLSCachesOnCurrentThread",
      "category": "MallocCallstackHandler",
      "signature": "SetupTLSCachesOnCurrentThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMallocCallstackHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Set up TLS caches on the current thread. These are the threads that we can trim."
    },
    {
      "id": "mark-tls-caches-as-used-on-current-thread",
      "name": "MarkTLSCachesAsUsedOnCurrentThread",
      "category": "MallocCallstackHandler",
      "signature": "MarkTLSCachesAsUsedOnCurrentThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMallocCallstackHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Mark TLS caches for the current thread as used. Thread has woken up to do some processing and needs its TLS caches back."
    },
    {
      "id": "mark-tls-caches-as-unused-on-current-thread",
      "name": "MarkTLSCachesAsUnusedOnCurrentThread",
      "category": "MallocCallstackHandler",
      "signature": "MarkTLSCachesAsUnusedOnCurrentThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMallocCallstackHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Mark TLS caches for current thread as unused. Typically before going to sleep. These are the threads that we can trim without waking them up."
    },
    {
      "id": "clear-and-disable-tls-caches-on-current-thread",
      "name": "ClearAndDisableTLSCachesOnCurrentThread",
