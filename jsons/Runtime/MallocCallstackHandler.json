    {
      "id": "quantize-size",
      "name": "QuantizeSize",
      "category": "MallocCallstackHandler",
      "signature": "QuantizeSize(Target, Count, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FMallocCallstackHandler*"
        },
        {
          "name": "Count",
          "type": "SIZE_T"
        },
        {
          "name": "Alignment",
          "type": "UInt"
        }
      ],
      "returnType": "SIZE_T",
      "docs": "For some allocators this will return the actual size that should be requested to eliminate\ninternal fragmentation. The return value will always be >= Count. This can be used to grow\nand shrink containers to optimal sizes.\nThis call is always fast and thread safe with no locking."
    },
    {
      "id": "get-allocation-size",
      "name": "GetAllocationSize",
      "category": "MallocCallstackHandler",
      "signature": "GetAllocationSize(Target, Original, Size Out)",
      "params": [
        {
          "name": "Target",
          "type": "FMallocCallstackHandler*"
        },
        {
          "name": "Original",
          "type": "void*"
        },
        {
          "name": "Size Out",
          "type": "SIZE_T&"
        }
      ],
      "returnType": "Bool",
      "docs": "If possible determine the size of the memory allocated at the given address\n@param Original - Pointer to memory we are checking the size of\n@param SizeOut - If possible, this value is set to the size of the passed in pointer\n@return true if succeeded"
    },
    {
      "id": "trim",
