    {
      "id": "set-fade-out",
      "name": "SetFadeOut",
      "category": "Rendering",
      "signature": "SetFadeOut(Target, Start Delay, Duration, Destroy Owner After Fade)",
      "params": [
        {
          "name": "Target",
          "type": "UDecalComponent*"
        },
        {
          "name": "Start Delay",
          "type": "Float"
        },
        {
          "name": "Duration",
          "type": "Float"
        },
        {
          "name": "Destroy Owner After Fade",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FVector DecalSize",
      "docs": "Sets the decal's fade start time, duration and if the owning actor should be destroyed after the decal is fully faded out.\nThe default value of 0 for FadeStartDelay and FadeDuration makes the decal persistent. See DecalLifetimeOpacity material\nnode to control the look of \"fading out.\"\n@param StartDelay - Time in seconds to wait before beginning to fade out the decal.\n@param Duration - Time in second for the decal to fade out.\n@param DestroyOwnerAfterFade - Should the owning actor automatically be destroyed after it is completely faded out."
    },
