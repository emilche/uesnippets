    {
      "id": "register-blackboard-component",
      "name": "RegisterBlackboardComponent",
      "category": "AISystem",
      "signature": "RegisterBlackboardComponent(Target, Blackboard Asset, Blackboard Comp)",
      "params": [
        {
          "name": "Target",
          "type": "UAISystem*"
        },
        {
          "name": "Blackboard Asset",
          "type": "UBlackboardData&"
        },
        {
          "name": "Blackboard Comp",
          "type": "UBlackboardComponent&"
        }
      ],
      "returnType": "Void",
      "docs": "Registers a UBlackboardComponent instance with this blackboard data asset.\nThis will also register the component for each parent UBlackboardData\nasset. This should be called after the component has been initialized\n(i.e. InitializeComponent). The user is responsible for calling\nUnregisterBlackboardComponent (i.e. UninitializeComponent)."
    },
