        },
        {
          "name": "Blackboard Comp",
          "type": "UBlackboardComponent&"
        }
      ],
      "returnType": "Void",
      "docs": "Unregisters a UBlackboardComponent instance with this blackboard data\nasset. This should be called before the component has been uninitialized\n(i.e. UninitializeComponent)."
    },
