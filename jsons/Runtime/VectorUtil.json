    {
      "id": "vector-tan-half-angle",
      "name": "VectorTanHalfAngle",
      "category": "VectorUtil",
      "signature": "VectorTanHalfAngle<RealType>(A, B)",
      "params": [
        {
          "name": "A",
          "type": "TVector<RealType>&"
        },
        {
          "name": "B",
          "type": "TVector<RealType>&"
        }
      ],
      "returnType": "template<RealType> RealType",
      "docs": "tan(theta/2) = +/- sqrt( (1-cos(theta)) / (1+cos(theta)) )\n@return positive value of tan(theta/2) where theta is angle between normalized vectors A and B"
    },
    {
      "id": "vector-cot",
      "name": "VectorCot",
      "category": "VectorUtil",
      "signature": "VectorCot<RealType>(V 1, V 2)",
      "params": [
        {
          "name": "V 1",
          "type": "TVector<RealType>&"
        },
        {
          "name": "V 2",
          "type": "TVector<RealType>&"
        }
      ],
      "returnType": "template<RealType> RealType",
      "docs": "Fast cotangent of angle between two vectors (*do not have to be normalized unit vectors*).\ncot = cos/sin, both of which can be computed from vector identities\n@return cotangent of angle between V1 and V2, or zero if result would be unstable (eg infinity)"
    },
    {
      "id": "barycentric-coords",
      "name": "BarycentricCoords",
      "category": "VectorUtil",
      "signature": "BarycentricCoords<RealType>(Point, V 0, V 1, V 2)",
      "params": [
        {
          "name": "Point",
          "type": "TVector<RealType>&"
        },
        {
          "name": "V 0",
          "type": "TVector<RealType>&"
        },
        {
          "name": "V 1",
          "type": "TVector<RealType>&"
        },
        {
          "name": "V 2",
          "type": "TVector<RealType>&"
        }
      ],
      "returnType": "template<RealType> TVector<RealType>",
      "docs": "Compute barycentric coordinates/weights of vPoint inside 3D triangle (V0,V1,V2).\nIf point is in triangle plane and inside triangle, coords will be positive and sum to 1.\nie if result is a, then vPoint = a.x*V0 + a.y*V1 + a.z*V2.\nTODO: make robust to degenerate triangles?"
    },
    {
      "id": "uniform-sample-triangle-barycentric-coords",
      "name": "UniformSampleTriangleBarycentricCoords",
      "category": "VectorUtil",
      "signature": "UniformSampleTriangleBarycentricCoords<RealType>(R 1, R 2)",
      "params": [
        {
          "name": "R 1",
          "type": "RealType"
        },
        {
          "name": "R 2",
          "type": "RealType"
        }
      ],
      "returnType": "template<RealType> TVector<RealType>",
      "docs": "Sample uniform random barycentric coordinates on a triangle\nThe inputs should be two random floating point numbers in the [0,1] range\n(See eq. 1 of 'Shape Distributions' by Osada, Funkhouser, Chazelle and Dobkin)\nNote the sample positions will not match those of UniformSampleTrianglePoint for the same R1, R2 values"
    },
    {
      "id": "uniform-sample-triangle-point",
      "name": "UniformSampleTrianglePoint",
      "category": "VectorUtil",
      "signature": "UniformSampleTrianglePoint<RealType>(R 1, R 2, A, B, C)",
      "params": [
        {
          "name": "R 1",
          "type": "RealType"
        },
        {
          "name": "R 2",
          "type": "RealType"
        },
        {
          "name": "A",
          "type": "TVector<RealType>&"
        },
        {
          "name": "B",
          "type": "TVector<RealType>&"
        },
        {
          "name": "C",
          "type": "TVector<RealType>&"
        }
      ],
      "returnType": "template<RealType> TVector<RealType>",
      "docs": "Sample a uniform random point on a triangle\nThe inputs should be two random floating point numbers in the [0,1] range, and the triangle coordinates\nref: http://mathworld.wolfram.com/TrianglePointPicking.html\nNote the sample positions will not match those of UniformSampleTriangleBarycentricCoords for the same R1, R2 values"
    },
