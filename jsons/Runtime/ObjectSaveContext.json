    {
      "id": "is-harvesting-cook-dependencies",
      "name": "IsHarvestingCookDependencies",
      "category": "ObjectSaveContext",
      "signature": "IsHarvestingCookDependencies(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectSavePackageSerializeContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true if the archive is listening to AddCookBuildDependency and AddCookRuntimeDependency\ncalls. If it returns true, objects must add their dependencies, failing to do so will cause\nfalse positive incremental skips."
    },
    {
      "id": "add-cook-load-dependency",
      "name": "AddCookLoadDependency",
      "category": "ObjectSaveContext",
      "signature": "AddCookLoadDependency(Target, Build Dependency)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectSavePackageSerializeContext*"
        },
        {
          "name": "Build Dependency",
          "type": "UE::Cook::FCookDependency"
        }
      ],
      "returnType": "Void",
      "docs": "Add the given FCookDependency to the build dependencies for the package being cook-saved. Incremental cooks will\ninvalidate the package and recook it if the CookDependency changes. Other packages that incorporate the loaded\ndata of the package into their own cooked results will also be recooked if this build dependency changes.\nCalling this function during editor save (rather than cook save) has another meaning. It is ignored for\nFCookDependency of type other than FCookDependency::Package, but for FCookDependency::Package it identifies\na reference that propagates chunk management in the AssetRegistry, but does not cause its target to be cooked."
    },
