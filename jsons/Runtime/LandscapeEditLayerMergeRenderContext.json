    {
      "id": "generic-blend-layer",
      "name": "GenericBlendLayer",
      "category": "LandscapeEditLayerMergeRenderContext",
      "signature": "GenericBlendLayer(In Blend Params, Render Params, RDG Builder Recorder)",
      "params": [
        {
          "name": "In Blend Params",
          "type": "FBlendParams&"
        },
        {
          "name": "Render Params",
          "type": "FRenderParams&"
        },
        {
          "name": "RDG Builder Recorder",
          "type": "UE::Landscape::FRDGBuilderRecorder&"
        }
      ],
      "returnType": "LANDSCAPE_EDIT_LAYERS_BATCHED_MERGE_EXPERIMENTAL void",
      "docs": "Performs a generic blend assuming GetBlendRenderTargetWrite() is the RT that contains the layer to blend and GetBlendRenderTargetRead() the one that contains the result of the merge up until this layer.\nIt will cycle the RTs such as after this call, GetBlendRenderTargetWrite() will contain the merge result\n@param InBlendParams defines how heightmaps/weightmaps should be blended. In the case of weightmaps, there must be as may entries in WeightmapBlendParams as there are layers in the target layers group\n@param RDGBuilderRecorder recorder to append operations to a single FRDGBuilder, if the the recorder in \"recording\" mode. In \"immediate\" mode, a render command will be enqueued immediately"
    },
