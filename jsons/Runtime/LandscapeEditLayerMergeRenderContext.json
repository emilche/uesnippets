    {
      "id": "cycle-blend-render-targets",
      "name": "CycleBlendRenderTargets",
      "category": "LandscapeEditLayerMergeRenderContext",
      "signature": "CycleBlendRenderTargets(RDG Builder Recorder)",
      "params": [
        {
          "name": "RDG Builder Recorder",
          "type": "UE::Landscape::FRDGBuilderRecorder&"
        }
      ],
      "returnType": "LANDSCAPE_EDIT_LAYERS_BATCHED_MERGE_EXPERIMENTAL void",
      "docs": "Cycle between the 3 render targets used for blending:\nWrite becomes Read -> Read becomes ReadPrevious -> ReadPrevious becomes Write\nThe new Write RT will be transitioned to state == InDesiredWriteAccess (if != ERHIAccess::None)\nThe new Read RT will be transitioned to state ERHIAccess::SRVMask\nThe new ReadPrevious RT will stay in state ERHIAccess::SRVMask\n@param InDesiredWriteAccess RHI state of the write RT after the operation (if InDesiredWriteAccess != ERHIAccess::None)\n@param RDGBuilderRecorder recorder to append operations to a single FRDGBuilder, if the the recorder in \"recording\" mode. In \"immediate\" mode, a render command will be enqueued immediately"
    },
