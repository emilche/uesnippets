{
  "id": "i-live-link-source",
  "label": "ILiveLinkSource",
  "includepath": "ILiveLinkSource.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Guid",
    "LiveLinkSourceSettings",
    "LiveLinkTypes",
    "ILiveLinkSource.generated"
  ],
  "functions": [
    {
      "id": "initialize-settings",
      "name": "InitializeSettings",
      "category": "ILiveLinkSource",
      "signature": "InitializeSettings(Target, Settings)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        },
        {
          "name": "Settings",
          "type": "ULiveLinkSourceSettings*"
        }
      ],
      "returnType": "Void",
      "docs": "The setting class has been created. Called after ReceiveClient.\n@see GetSettingsClass"
    },
    {
      "id": "update",
      "name": "Update",
      "category": "ILiveLinkSource",
      "signature": "Update(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        }
      ],
      "returnType": "Void",
      "docs": "Update the source.\nThis is called in a critical path on the game thread. The user is expected to return quickly."
    },
    {
      "id": "can-be-displayed-in-ui",
      "name": "CanBeDisplayedInUI",
      "category": "ILiveLinkSource",
      "signature": "CanBeDisplayedInUI(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        }
      ],
      "returnType": "Bool",
      "docs": "Can this source be displayed in the Source UI list"
    },
    {
      "id": "get-source-tool-tip",
      "name": "GetSourceToolTip",
      "category": "ILiveLinkSource",
      "signature": "GetSourceToolTip(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        }
      ],
      "returnType": "Text",
      "docs": "For UI, what should be shown in the source list when hovering this source."
    },
    {
      "id": "get-settings-class",
      "name": "GetSettingsClass",
      "category": "ILiveLinkSource",
      "signature": "GetSettingsClass(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        }
      ],
      "returnType": "TSubclassOf<ULiveLinkSourceSettings>",
      "docs": "Setting class to display and used by the Source.\nAn instance of that class will be constructed when the source is added to the Client. Then InitializeSettings will be called."
    },
    {
      "id": "get-custom-settings-class",
      "name": "GetCustomSettingsClass",
      "category": "ILiveLinkSource",
      "signature": "GetCustomSettingsClass(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        }
      ],
      "returnType": "UClass*"
    },
    {
      "id": "on-settings-changed",
      "name": "OnSettingsChanged",
      "category": "ILiveLinkSource",
      "signature": "OnSettingsChanged(Target, Settings, Property Changed Event)",
      "params": [
        {
          "name": "Target",
          "type": "ILiveLinkSource*"
        },
        {
          "name": "Settings",
          "type": "ULiveLinkSourceSettings*"
        },
        {
          "name": "Property Changed Event",
          "type": "FPropertyChangedEvent&"
        }
      ],
      "returnType": "Void",
      "docs": "Notification when a setting value has changed via the UI."
    },
    {
      "id": "set-source-pointer",
      "name": "SetSourcePointer",
      "category": "ILiveLinkSource",
      "signature": "SetSourcePointer(Target, In Source Pointer)",
      "params": [
        {
          "name": "Target",
          "type": "FLiveLinkSourceHandle*"
        },
        {
          "name": "In Source Pointer",
          "type": "TSharedPtr<ILiveLinkSource>"
        }
      ],
      "returnType": "Void"
    }
  ]
}