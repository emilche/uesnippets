      "category": "AnimLinkableElement",
      "signature": "ChangeLinkMethod(Target, New Link Method)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "New Link Method",
          "type": "EAnimLinkMethod::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Changes the way this element is linked to its segment\n@param NewLinkMethod The new linking method to use"
    },
    {
      "id": "change-slot-index",
      "name": "ChangeSlotIndex",
      "category": "AnimLinkableElement",
      "signature": "ChangeSlotIndex(Target, New Slot Index)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "New Slot Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Change the montage slot that this element is linked to\n@param NewSlotIndex The new slot to link to"
    },
    {
      "id": "get-link-method",
      "name": "GetLinkMethod",
      "category": "AnimLinkableElement",
      "signature": "GetLinkMethod(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
      "returnType": "EAnimLinkMethod::Type",
