      "docs": "Directly sets segment index\n@param NewSegmentIndex New segment index"
    },
    {
      "id": "conditional-relink",
      "name": "ConditionalRelink",
      "category": "AnimLinkableElement",
      "signature": "ConditionalRelink(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
      "returnType": "Bool",
      "docs": "Relinks this element if internal state requires relinking"
    },
    {
      "id": "refresh-segment-on-load",
      "name": "RefreshSegmentOnLoad",
      "category": "AnimLinkableElement",
      "signature": "RefreshSegmentOnLoad(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
