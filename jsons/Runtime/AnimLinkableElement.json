        }
      ],
      "returnType": "UAnimSequenceBase*",
      "docs": "Gets the sequence this element is linked to"
    },
    {
      "id": "get-linked-montage",
      "name": "GetLinkedMontage",
      "category": "AnimLinkableElement",
      "signature": "GetLinkedMontage(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
      "returnType": "UAnimMontage*",
      "docs": "Gets the Montage this element is linked to, if any"
    },
