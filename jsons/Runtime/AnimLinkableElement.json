{
  "id": "anim-linkable-element",
  "label": "AnimLinkableElement",
  "includepath": "Animation/AnimLinkableElement.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "AnimLinkableElement.generated"
  ],
  "functions": [
    {
      "id": "update",
      "name": "Update",
      "category": "AnimLinkableElement",
      "signature": "Update(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
      "returnType": "Void",
      "docs": "Update the timing information for this element. Will not search for a new segment unless this element does not have one"
    },
    {
      "id": "link",
      "name": "Link",
      "category": "AnimLinkableElement",
      "signature": "Link(Target, Anim Sequence Base, Abs Time, In Slot Index)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "Anim Sequence Base",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "Abs Time",
          "type": "Float"
        },
        {
          "name": "In Slot Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Link this element to an animation object (Sequence or Montage)\n@param AnimSequenceBase The object to link to\n@param AbsTime The absolute time to place this element\n@param InSlotIndex Slot index for montages (ignored otherwise)"
    },
    {
      "id": "link-montage",
      "name": "LinkMontage",
      "category": "AnimLinkableElement",
      "signature": "LinkMontage(Target, Montage, Abs Montage Time, In Slot Index)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "Montage",
          "type": "UAnimMontage*"
        },
        {
          "name": "Abs Montage Time",
          "type": "Float"
        },
        {
          "name": "In Slot Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Link this element to a montage\n@param Montage The montage to link to\n@param AbsMontageTime The time in the montage that this element should be placed at\n@param InSlotIndex The slot in the montage to detect segments in"
    },
    {
      "id": "link-sequence",
      "name": "LinkSequence",
      "category": "AnimLinkableElement",
      "signature": "LinkSequence(Target, Sequence, Abs Sequence Time)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "Sequence",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "Abs Sequence Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Link this element to a Sequence, Just setting basic data as sequences don't need full linking\n@param Sequence The sequence to link to\n@param AbsSequenceTime The time in the sequence that this element should be placed at"
    },
    {
      "id": "clear",
      "name": "Clear",
      "category": "AnimLinkableElement",
      "signature": "Clear(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        }
      ],
      "returnType": "Void",
      "docs": "Clear the linking information from this element, leaves montage link intact"
    },
