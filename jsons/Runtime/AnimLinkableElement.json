    {
      "id": "set-segment-index",
      "name": "SetSegmentIndex",
      "category": "AnimLinkableElement",
      "signature": "SetSegmentIndex(Target, New Segment Index)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "New Segment Index",
          "type": "Int"
        }
      ],
