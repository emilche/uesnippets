          "default": "EAnimLinkMethod::Absolute"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the current time for this element\n@param ReferenceFrame What kind of time to return"
    },
    {
      "id": "set-time",
      "name": "SetTime",
      "category": "AnimLinkableElement",
      "signature": "SetTime(Target, New Time, Reference Frame)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimLinkableElement*"
        },
        {
          "name": "New Time",
          "type": "Float"
        },
        {
          "name": "Reference Frame",
          "type": "EAnimLinkMethod::Type",
          "default": "EAnimLinkMethod::Absolute"
        }
      ],
