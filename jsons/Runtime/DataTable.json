      "id": "on-post-data-import",
      "name": "OnPostDataImport",
      "category": "DataTable",
      "signature": "OnPostDataImport(Target, In Data Table, In Row Name, Out Collected Import Problems)",
      "params": [
        {
          "name": "Target",
          "type": "FTableRowBase*"
        },
        {
          "name": "In Data Table",
          "type": "UDataTable*"
        },
        {
          "name": "In Row Name",
          "type": "Name"
        },
        {
          "name": "Out Collected Import Problems",
          "type": "TArray<FString>&"
        }
      ],
      "returnType": "Void",
      "docs": "Can be overridden by subclasses; Called whenever the owning data table is imported or re-imported.\nAllows for custom fix-ups, parsing, etc. after initial data is read in.\n@param InDataTable\t\t\t\t\tThe data table that owns this row\n@param InRowName\t\t\t\t\t\tThe name of the row we're performing fix-up on\n@param OutCollectedImportProblems\tList of problems accumulated during import; Can be added to via this method"
    },
    {
      "id": "on-data-table-changed",
      "name": "OnDataTableChanged",
      "category": "DataTable",
      "signature": "OnDataTableChanged(Target, In Data Table, In Row Name)",
      "params": [
        {
          "name": "Target",
          "type": "FTableRowBase*"
        },
        {
          "name": "In Data Table",
          "type": "UDataTable*"
        },
        {
          "name": "In Row Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Can be overridden by subclasses; Called on every row when the owning data table is modified\nAllows for custom fix-ups, parsing, etc for user changes\nThis will be called in addition to OnPostDataImport when importing\n@param InDataTable\t\t\t\t\tThe data table that owns this row\n@param InRowName\t\t\t\t\t\tThe name of the row we're performing fix-up on"
    },
    {
