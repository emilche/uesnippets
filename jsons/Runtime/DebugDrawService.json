{
  "id": "debug-draw-service",
  "label": "DebugDrawService",
  "includepath": "Debug/DebugDrawService.h",
  "includes": [
    "ShowFlags",
    "BlueprintFunctionLibrary",
    "TransactionallySafeCriticalSection",
    "DebugDrawService.generated"
  ],
  "functions": [
    {
      "id": "register",
      "name": "Register",
      "category": "DebugDrawService",
      "signature": "Register(Name, New Delegate)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "New Delegate",
          "type": "FDebugDrawDelegate&"
        }
      ],
      "returnType": "FDelegateHandle"
    },
    {
      "id": "unregister",
      "name": "Unregister",
      "category": "DebugDrawService",
      "signature": "Unregister(Handle To Remove)",
      "params": [
        {
          "name": "Handle To Remove",
          "type": "FDelegateHandle"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "draw-d0c094",
      "name": "Draw",
      "category": "DebugDrawService",
      "signature": "Draw(Flags, Canvas)",
      "params": [
        {
          "name": "Flags",
          "type": "FEngineShowFlags"
        },
        {
          "name": "Canvas",
          "type": "UCanvas*"
        }
      ],
      "returnType": "Void",
      "docs": "Draws debug canvas that has already been initialized to a viewport"
    },
    {
      "id": "draw-9d59b8",
      "name": "Draw",
      "category": "DebugDrawService",
      "signature": "Draw(Flags, Viewport, View, Canvas, Canvas Object)",
      "params": [
        {
          "name": "Flags",
          "type": "FEngineShowFlags"
        },
        {
          "name": "Viewport",
          "type": "FViewport*"
        },
        {
          "name": "View",
          "type": "FSceneView*"
        },
        {
          "name": "Canvas",
          "type": "FCanvas*"
        },
        {
          "name": "Canvas Object",
          "type": "UCanvas*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize a debug canvas object then calls above draw. If CanvasObject is null it will find/create it for you"
    }
  ]
}