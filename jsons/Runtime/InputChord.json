{
  "id": "input-chord",
  "label": "InputChord",
  "includepath": "Framework/Commands/InputChord.h",
  "includes": [
    "CoreMinimal",
    "CoreTypes",
    "GenericApplication",
    "InputCoreTypes",
    "Text",
    "Optional",
    "ObjectMacros",
    "InputChord.generated"
  ],
  "functions": [
    {
      "id": "get-relationship",
      "name": "GetRelationship",
      "category": "InputChord",
      "signature": "GetRelationship(Target, Other Chord)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Other Chord",
          "type": "FInputChord&"
        }
      ],
      "returnType": "ERelationshipType",
      "docs": "The ways two chords can be related to each other. A chord is considered masking\nwhen it has all the same modifier keys as another chord plus more."
    },
    {
      "id": "needs-control",
      "name": "NeedsControl",
      "category": "InputChord",
      "signature": "NeedsControl(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "needs-command",
      "name": "NeedsCommand",
      "category": "InputChord",
      "signature": "NeedsCommand(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "needs-alt",
      "name": "NeedsAlt",
      "category": "InputChord",
      "signature": "NeedsAlt(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "needs-shift",
      "name": "NeedsShift",
      "category": "InputChord",
      "signature": "NeedsShift(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-input-text",
      "name": "GetInputText",
      "category": "InputChord",
      "signature": "GetInputText(Target, Long Display Name)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Long Display Name",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Text",
      "docs": "Gets a localized string that represents the chord.\n@return A localized string."
    },
    {
      "id": "get-key-text",
      "name": "GetKeyText",
      "category": "InputChord",
      "signature": "GetKeyText(Target, Long Display Name)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Long Display Name",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the key represented as a localized string.\n@return A localized string."
    },
    {
      "id": "get-modifier-text",
      "name": "GetModifierText",
      "category": "InputChord",
      "signature": "GetModifierText(Target, Modifier Appender)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Modifier Appender",
          "type": "TOptional<FText>",
          "default": "TOptional<FText>()"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the localized string for the modifier portion of the coord.\n@param ModifierAppender. Text to append between each modifier and the key. If this is not specified a '+' character will be used"
    },
    {
      "id": "has-any-modifier-keys",
      "name": "HasAnyModifierKeys",
      "category": "InputChord",
      "signature": "HasAnyModifierKeys(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks whether this chord requires an modifier keys to be pressed.\n@return true if modifier keys must be pressed, false otherwise."
    },
    {
      "id": "is-valid-chord",
      "name": "IsValidChord",
      "category": "InputChord",
      "signature": "IsValidChord(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines if this chord is valid.  A chord is valid if it has a non modifier key that must be pressed\nand zero or more modifier keys that must be pressed\n@return true if the chord is valid"
    },
    {
      "id": "set",
      "name": "Set",
      "category": "InputChord",
      "signature": "Set(Target, In Template)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "In Template",
          "type": "FInputChord&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets this chord to a new key and modifier state based on the provided template\nShould not be called directly.  Only used by the key binding editor to set user defined keys"
    },
    {
      "id": "get-type-hash",
      "name": "GetTypeHash",
      "category": "InputChord",
      "signature": "GetTypeHash(Target, Chord)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Chord",
          "type": "FInputChord&"
        }
      ],
      "returnType": "UInt",
      "docs": "Gets a type hash value for the specified chord.\n@param Chord The input chord to get the hash value for.\n@return The hash value."
    }
  ]
}