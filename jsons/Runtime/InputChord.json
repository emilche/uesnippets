{
  "id": "input-chord",
  "label": "InputChord",
  "includepath": "Framework/Commands/InputChord.h",
  "includes": [
    "CoreMinimal",
    "CoreTypes",
    "GenericApplication",
    "InputCoreTypes",
    "Text",
    "Optional",
    "ObjectMacros",
    "InputChord.generated"
  ],
  "functions": [
    {
      "id": "get-relationship",
      "name": "GetRelationship",
      "category": "InputChord",
      "signature": "GetRelationship(Target, Other Chord)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Other Chord",
          "type": "FInputChord&"
        }
      ],
      "returnType": "ERelationshipType",
      "docs": "The ways two chords can be related to each other. A chord is considered masking\nwhen it has all the same modifier keys as another chord plus more."
    },
    {
      "id": "get-input-text",
      "name": "GetInputText",
      "category": "InputChord",
      "signature": "GetInputText(Target, Long Display Name)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Long Display Name",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Text",
      "docs": "Gets a localized string that represents the chord.\n@return A localized string."
    },
    {
      "id": "get-key-text",
      "name": "GetKeyText",
      "category": "InputChord",
      "signature": "GetKeyText(Target, Long Display Name)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Long Display Name",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the key represented as a localized string.\n@return A localized string."
    },
    {
      "id": "get-modifier-text",
      "name": "GetModifierText",
      "category": "InputChord",
      "signature": "GetModifierText(Target, Modifier Appender)",
      "params": [
        {
          "name": "Target",
          "type": "FInputChord*"
        },
        {
          "name": "Modifier Appender",
          "type": "TOptional<FText>",
          "default": "TOptional<FText>()"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the localized string for the modifier portion of the coord.\n@param ModifierAppender. Text to append between each modifier and the key. If this is not specified a '+' character will be used"
    }
  ]
}