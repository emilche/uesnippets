      "returnType": "FRootMotionSource*",
      "docs": "@return newly allocated copy of this FRootMotionSource. Must be overridden by child classes.",
      "supportedTargets": [
        "FRootMotionSource*",
        "FRootMotionSource_ConstantForce*",
