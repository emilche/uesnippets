        },
        {
          "name": "Source To Take State From",
          "type": "FRootMotionSource*"
        },
        {
          "name": "Mark For Simulated Catchup",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Mainly for server correction purposes - update this Source's state from\nanother's, usually the authoritative state from the server's version of the Source\n@param bMarkForSimulatedCatchup sets the source for needing to \"catch up\" to current state next Prepare\n@return Whether the update was sucessful or not. Note that failure to update\ndenotes a complete failure, and the Source will then be marked for removal.\nWe need to remove since we don't have a way of reverting partial updates\ndepending on where the update failed.",
      "supportedTargets": [
        "FRootMotionSource*",
        "FRootMotionSource_ConstantForce*",
        "FRootMotionSource_RadialForce*",
        "FRootMotionSource_MoveToForce*",
        "FRootMotionSource_MoveToDynamicForce*",
