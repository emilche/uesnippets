      ]
    },
    {
      "id": "update-state-from-aaf756",
      "name": "UpdateStateFrom",
      "category": "RootMotionSource",
      "signature": "UpdateStateFrom(Target, Source To Take State From, Mark For Simulated Catchup)",
      "params": [
        {
