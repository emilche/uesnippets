    {
      "id": "matches",
      "name": "Matches",
      "category": "RootMotionSource",
      "signature": "Matches(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FRootMotionSource*"
        },
        {
          "name": "Other",
          "type": "FRootMotionSource*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return Whether this is the same RootMotionSource as Other.\nThis is used for networking when clients receive RootMotionSource data from the server and need\nto decide which local RootMotionSource to compare and apply the corrections to.\nThis is required due to RootMotionSources in general being added independently on server and\nclients, not needing to know about each other by default.\nFor well-networked RootMotionSources, any given FRootMotionSource child class could implement\ntheir own unique ID and simply use that in the Matches check. This \"heuristic-style\" default\nwas chosen to simplify addition of new RootMotionSources, and assumes that in a networked setting\na given RootMotionSource won't be applied many times in a given frame by the same instigator\nto the same target with the exact same parameters.\nGuaranteed uniqueness would also require a strict application order (\"RootMotionSources can only\nbe added on Authority\") or a prediction-based setup (\"Apply on Autonomous and Simulated predictively,\nthen apply on Authority and confirm, and if Authority doesn't confirm remove them\"). We avoid\nthat synchronization complexity for now.\nSee UCharacterMovementComponent::ConvertRootMotionServerIDsToLocalIDs\nShould be overridden by child classes, as default implementation only contains basic equivalency checks",
      "supportedTargets": [
        "FRootMotionSource*",
        "FRootMotionSource_ConstantForce*",
        "FRootMotionSource_RadialForce*",
        "FRootMotionSource_MoveToForce*",
        "FRootMotionSource_MoveToDynamicForce*",
        "FRootMotionSource_JumpForce*"
      ]
    },
