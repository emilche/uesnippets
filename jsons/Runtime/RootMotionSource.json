    {
      "id": "prepare-root-motion-768ddb",
      "name": "PrepareRootMotion",
      "category": "RootMotionSource",
      "signature": "PrepareRootMotion(Target, Simulation Time, Movement Tick Time, Character, Move Component)",
      "params": [
        {
          "name": "Target",
          "type": "FRootMotionSource*"
        },
        {
          "name": "Simulation Time",
          "type": "Float"
        },
        {
          "name": "Movement Tick Time",
          "type": "Float"
        },
        {
          "name": "Character",
          "type": "ACharacter&"
        },
        {
          "name": "Move Component",
          "type": "UCharacterMovementComponent&"
        }
      ],
      "returnType": "Void",
      "docs": "Generates the RootMotion for this Source, can be used for both \"live\" generation\nor for playback (client prediction correction, simulated proxies, etc.)\nExamples:\n- Animation RootMotionSources use Time as track time into AnimMontage and\nextract the root motion from AnimMontage chunk of time (Position,Position+DeltaTime)\n- ConstantForce source uses Time as the time into the application\nso if its duration ends halfway through the frame it knows how much root\nmotion it should have applied\n- Spline/curve-based sources use Time for knowing where on spline/curve to extract\nfrom\n@param SimulationTime How far forward in time to simulate root motion\n@param MovementTickTime How much time the movement is going to take that this is being prepared for",
      "supportedTargets": [
        "FRootMotionSource*",
        "FRootMotionSource_ConstantForce*",
        "FRootMotionSource_RadialForce*",
        "FRootMotionSource_MoveToForce*",
        "FRootMotionSource_MoveToDynamicForce*",
        "FRootMotionSource_JumpForce*"
      ]
    },
