    {
      "id": "allocate-instanced-shadow-map",
      "name": "AllocateInstancedShadowMap",
      "category": "ShadowMap",
      "signature": "AllocateInstancedShadowMap(Light Map Outer, Component, Instanced Shadow Map Data, Registry, Map Build Data Id, Bounds, Padding Type, Shadowmap Flags)",
      "params": [
        {
          "name": "Light Map Outer",
          "type": "UObject*"
        },
        {
          "name": "Component",
          "type": "UInstancedStaticMeshComponent*"
        },
        {
          "name": "Instanced Shadow Map Data",
          "type": "TArray<TMap<ULightComponent*,TUniquePtr<FShadowMapData2D>>>&&"
        },
        {
          "name": "Registry",
          "type": "UMapBuildDataRegistry*"
        },
        {
          "name": "Map Build Data Id",
          "type": "FGuid"
        },
        {
          "name": "Bounds",
          "type": "FBoxSphereBounds&"
        },
        {
          "name": "Padding Type",
          "type": "ELightMapPaddingType"
        },
        {
          "name": "Shadowmap Flags",
          "type": "EShadowMapFlags"
        }
      ],
      "returnType": "TRefCountPtr<FShadowMap2D>",
      "docs": "Allocates texture space for the shadow-map and stores the shadow-map's raw data for deferred encoding.\nIf the shadow-map has no shadows in it, it will return NULL.\n@param\tComponent - The component that owns this shadowmap\n@param\tInstancedShadowMapData - The raw shadow-map data to fill the texture with.\n@param\tBounds - The bounds of the primitive the shadow-map will be rendered on.  Used as a hint to pack shadow-maps on nearby primitives in the same texture.\n@param\tInPaddingType - the method for padding the shadowmap.\n@param\tShadowmapFlags - flags that determine how the shadowmap is stored (e.g. streamed or not)"
    },
