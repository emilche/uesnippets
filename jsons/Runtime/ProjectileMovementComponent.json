      "id": "compute-velocity",
      "name": "ComputeVelocity",
      "category": "ProjectileMovementComponent",
      "signature": "ComputeVelocity(Target, Initial Velocity, Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "UProjectileMovementComponent*"
        },
        {
