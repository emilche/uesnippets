    {
      "id": "get-simulation-time-step",
      "name": "GetSimulationTimeStep",
      "category": "ProjectileMovementComponent",
      "signature": "GetSimulationTimeStep(Target, Remaining Time, Iterations)",
      "params": [
        {
          "name": "Target",
          "type": "UProjectileMovementComponent*"
        },
        {
          "name": "Remaining Time",
          "type": "Float"
        },
        {
          "name": "Iterations",
          "type": "Int"
        }
      ],
      "returnType": "Float",
      "docs": "Compute remaining time step given remaining time and current iterations.\nThe last iteration (limited by MaxSimulationIterations) always returns the remaining time, which may violate MaxSimulationTimeStep.\n@param RemainingTime\t\tRemaining time in the tick.\n@param Iterations\t\tCurrent iteration of the tick (starting at 1).\n@return The remaining time step to use for the next sub-step of iteration.\n@see MaxSimulationTimeStep, MaxSimulationIterations\n@see ShouldUseSubStepping()"
    },
    {
      "id": "should-use-sub-stepping",
      "name": "ShouldUseSubStepping",
      "category": "ProjectileMovementComponent",
      "signature": "ShouldUseSubStepping(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProjectileMovementComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Determine whether or not to use substepping in the projectile motion update.\nIf true, GetSimulationTimeStep() will be used to time-slice the update. If false, all remaining time will be used during the tick.\n@return Whether or not to use substepping in the projectile motion update.\n@see GetSimulationTimeStep()"
    },
    {
      "id": "set-interpolated-component",
      "name": "SetInterpolatedComponent",
      "category": "Game",
      "signature": "SetInterpolatedComponent(Target, Component)",
      "params": [
        {
          "name": "Target",
          "type": "UProjectileMovementComponent*"
        },
        {
          "name": "Component",
          "type": "USceneComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns the component that will be used for network interpolation/smoothing. It is expected that this is a component attached somewhere below the UpdatedComponent.\nWhen network updates use MoveInterpolationTarget() to move the UpdatedComponent, the interpolated component's relative offset will be maintained and smoothed over\nthe course of future component ticks. The current relative location and rotation of the component is saved as the target offset for future interpolation.\n@see MoveInterpolationTarget(), bInterpMovement, bInterpRotation"
    },
    {
      "id": "get-interpolated-component",
      "name": "GetInterpolatedComponent",
