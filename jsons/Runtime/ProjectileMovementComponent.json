    },
    {
      "id": "move-interpolation-target",
      "name": "MoveInterpolationTarget",
      "category": "Game",
      "signature": "MoveInterpolationTarget(Target, New Location, New Rotation)",
      "params": [
        {
          "name": "Target",
          "type": "UProjectileMovementComponent*"
        },
        {
          "name": "New Location",
          "type": "FVector&"
        },
        {
          "name": "New Rotation",
          "type": "FRotator&"
        }
      ],
      "returnType": "Void",
      "docs": "Moves the UpdatedComponent, which is also the interpolation target for the interpolated component. If there is not interpolated component, this simply moves UpdatedComponent.\nUse this typically from PostNetReceiveLocationAndRotation() or similar from an Actor."
    },
