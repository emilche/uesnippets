        {
          "name": "Target",
          "type": "FSkeletalMeshObjectStatic*"
        },
        {
          "name": "In Mesh Desc",
          "type": "FSkinnedMeshSceneProxyDesc&"
        }
      ],
      "returnType": "Void"
    },
