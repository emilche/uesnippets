    {
      "id": "is-updating-loaded-path",
      "name": "IsUpdatingLoadedPath",
      "category": "SavePackage",
      "signature": "IsUpdatingLoadedPath(Is Cooking, Target Package Path, Save Flags)",
      "params": [
        {
          "name": "Is Cooking",
          "type": "Bool"
        },
        {
          "name": "Target Package Path",
          "type": "FPackagePath&"
        },
        {
          "name": "Save Flags",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Return whether the given save parameters indicate the LoadedPath of the package being saved should be updated.\nThis allows us to update the in-memory package when it is saved in editor to match its new save file."
    },
    {
      "id": "is-procedural-save",
      "name": "IsProceduralSave",
      "category": "SavePackage",
      "signature": "IsProceduralSave(Is Cooking, Target Package Path, Save Flags)",
      "params": [
        {
          "name": "Is Cooking",
          "type": "Bool"
        },
        {
          "name": "Target Package Path",
          "type": "FPackagePath&"
        },
        {
          "name": "Save Flags",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Return whether the given save parameters indicate the package is a procedural save.\nAny save without the the possibility of user-generated edits to the package is a procedural save (Cooking, EditorDomain).\nThis allows us to execute transforms that only need to be executed in response to new user data."
    },
