    },
    {
      "id": "vector-dot-3-fast-x",
      "name": "VectorDot3FastX",
      "category": "VectorUtility",
      "signature": "VectorDot3FastX(Vec 1, Vec 2)",
      "params": [
        {
          "name": "Vec 1",
          "type": "VectorRegister4Float&"
        },
        {
          "name": "Vec 2",
          "type": "VectorRegister4Float&"
        }
      ],
      "returnType": "VectorRegister4Float",
      "docs": "Calculates the dot product of two vectors and returns a vector with the result in the first component.\nW values should be set to 0 on the vector input. This function should be used with caution. Only the returned X should be read.\n@param Vec1\t1st vector set with W equal to 0\n@param Vec2\t2nd vector set with W equal to 0\n@return\t\td = dot3X(Vec1.xyz0, Vec2.xyz0), VectorRegister4Float( d, ?, ?, ? )"
    },
