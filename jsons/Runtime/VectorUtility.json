    {
      "id": "vector-cross-no-fma",
      "name": "VectorCrossNoFMA",
      "category": "VectorUtility",
      "signature": "VectorCrossNoFMA(Vec 1, Vec 2)",
      "params": [
        {
          "name": "Vec 1",
          "type": "VectorRegister4Float&"
        },
        {
          "name": "Vec 2",
          "type": "VectorRegister4Float&"
        }
      ],
      "returnType": "VectorRegister4Float",
      "docs": "Calculates the cross product of two vectors (XYZ components). W of the input should be 0, and will remain 0.\nThis function is not using FMA for stability reason, rounding with FMA could cause numerical instability.\n@param Vec1\t1st vector\n@param Vec2\t2nd vector\n@return\t\tcross(Vec1.xyz, Vec2.xyz). W of the input should be 0, and will remain 0."
    },
