  "functions": [
    {
      "id": "get-action-index",
      "name": "GetActionIndex",
      "category": "ObservableArray",
      "signature": "GetActionIndex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TObservableArrayChangedArgs*"
        }
      ],
      "returnType": "SizeType",
      "docs": "Valid for the Add, Remove, RemoveSwap action.\nUse GetItems.Num() to know how many elements were added/removed.\nAdd: The array index where we added the elements.\nRemove: The old array index before it removed the elements. The index is not valid anymore.\nRemoveSwap: The old array index before it removed the elements. The index is valid if the array is not empty.\n@return The index the action started."
    },
    {
      "id": "get-removed-swap-indexes",
      "name": "GetRemovedSwapIndexes",
      "category": "ObservableArray",
      "signature": "GetRemovedSwapIndexes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TObservableArrayChangedArgs*"
        }
      ],
      "returnType": "FRemoveSwapIndex",
      "docs": "The index of the removed elements before their removal.\nThe index can now be out of bound.\nThe swapped elements (if any) are now at that location."
    },
    {
      "id": "get-swap-index",
      "name": "GetSwapIndex",
      "category": "ObservableArray",
      "signature": "GetSwapIndex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TObservableArrayChangedArgs*"
        }
      ],
      "returnType": "FSwapIndex",
      "docs": "Valid for the Swap action.\n@return The indexes of the 2 swapped elements."
    },
    {
      "id": "get-items",
      "name": "GetItems",
      "category": "ObservableArray",
      "signature": "GetItems(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TObservableArrayChangedArgs*"
        }
      ],
      "returnType": "ArrayViewType",
      "docs": "@return The items added to the array or removed from the array. Valid for the Add, Remove and RemoveSwap action."
    },
