      "id": "calculate-multiplicative-inverse-of-exponent",
      "name": "CalculateMultiplicativeInverseOfExponent",
      "category": "BigInt",
      "signature": "CalculateMultiplicativeInverseOfExponent<IntType>(Target, Exponent, Totient)",
      "params": [
        {
          "name": "Target",
          "type": "TBigInt*"
        },
        {
          "name": "Exponent",
          "type": "IntType"
        },
        {
          "name": "Totient",
          "type": "IntType"
        }
      ],
      "returnType": "template<IntType> IntType",
      "docs": "Multiplicative inverse of exponent using extended GCD algorithm.\nExtended gcd: ax + by = gcd(a, b), where a = exponent, b = fi(n), gcd(a, b) = gcd(e, fi(n)) = 1, fi(n) is the Euler's totient function of n\nWe only care to find d = x, which is our multiplicatve inverse of e (a)."
    },
