{
  "id": "file-encoder",
  "label": "FileEncoder",
  "includepath": "DSP/FileEncoder.h",
  "includes": [
    "CoreMinimal",
    "IAudioEncoder",
    "IAudioFormat"
  ],
  "functions": [
    {
      "id": "get-file-info",
      "name": "GetFileInfo",
      "category": "FileEncoder",
      "signature": "GetFileInfo(Target, Out Info)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioFileWriter*"
        },
        {
          "name": "Out Info",
          "type": "FSoundQualityInfo&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "push-audio",
      "name": "PushAudio",
      "category": "FileEncoder",
      "signature": "PushAudio(Target, In Audio, Num Samples, Encode If Possible)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioFileWriter*"
        },
        {
          "name": "In Audio",
          "type": "Float*"
        },
        {
          "name": "Num Samples",
          "type": "Int"
        },
        {
          "name": "Encode If Possible",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "encode-if-possible",
      "name": "EncodeIfPossible",
      "category": "FileEncoder",
      "signature": "EncodeIfPossible(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioFileWriter*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}