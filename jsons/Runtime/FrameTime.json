      "id": "get-frame",
      "name": "GetFrame",
      "category": "FrameTime",
      "signature": "GetFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "FFrameNumber",
      "docs": "Access this time's frame number"
    },
    {
      "id": "get-sub-frame",
      "name": "GetSubFrame",
      "category": "FrameTime",
      "signature": "GetSubFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "Float",
      "docs": "Access this time's sub frame"
    },
    {
      "id": "floor-to-frame",
      "name": "FloorToFrame",
      "category": "FrameTime",
      "signature": "FloorToFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "FFrameNumber",
      "docs": "Return the first frame number less than or equal to this frame time"
    },
    {
      "id": "ceil-to-frame",
      "name": "CeilToFrame",
      "category": "FrameTime",
      "signature": "CeilToFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "FFrameNumber",
      "docs": "Return the next frame number greater than or equal to this frame time"
    },
    {
      "id": "round-to-frame",
      "name": "RoundToFrame",
      "category": "FrameTime",
      "signature": "RoundToFrame(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "FFrameNumber",
      "docs": "Round to the nearest frame number"
    },
    {
      "id": "as-decimal",
      "name": "AsDecimal",
      "category": "FrameTime",
      "signature": "AsDecimal(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        }
      ],
      "returnType": "Double",
      "docs": "Retrieve a decimal representation of this frame time\nSub frames are always added to the current frame number, so for negative frame times, a time of -10 [sub frame 0.25] will yield a decimal value of -9.75."
    },
    {
      "id": "from-decimal",
      "name": "FromDecimal",
      "category": "FrameTime",
      "signature": "FromDecimal(Target, In Decimal Frame)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        },
        {
          "name": "In Decimal Frame",
          "type": "Double"
        }
      ],
      "returnType": "FFrameTime",
      "docs": "Convert a decimal representation to a frame time\nNote that sub frames are always positive, so negative decimal representations result in an inverted sub frame and floored frame number"
    },
    {
      "id": "lex-to-string",
      "name": "LexToString",
      "category": "FrameTime",
      "signature": "LexToString(Target, In Time)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameTime*"
        },
        {
          "name": "In Time",
          "type": "FFrameTime"
        }
      ],
      "returnType": "String",
      "docs": "Convert a FFrameTime into a string"
    }
  ]
