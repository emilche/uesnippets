    {
      "id": "f-mesh-attribute-array-set-base",
      "name": "FMeshAttributeArraySetBase",
      "category": "MeshAttributeArray",
      "signature": "FMeshAttributeArraySetBase(In Type, In Flags, In Number Of Elements, In Type, In Extent, In Number Of Elements, In Flags)",
      "params": [
        {
          "name": "In Type",
          "type": "UInt"
        },
        {
          "name": "In Flags",
          "type": "EMeshAttributeFlags"
        },
        {
          "name": "In Number Of Elements",
          "type": "Int"
        },
        {
          "name": "In Type",
          "type": "uint32 InExtent ) : Type ("
        },
        {
          "name": "In Extent",
          "type": "Extent ("
        },
        {
          "name": "In Number Of Elements",
          "type": "NumElements ("
        },
        {
          "name": "In Flags",
          "type": "Flags ("
        }
      ],
      "returnType": "Void",
      "docs": "This is the base class for an attribute array set.\nAn attribute array set is a container which holds attribute arrays, one per attribute index.\nMany attributes have only one index, while others (such as texture coordinates) may want to define many.\nAll attribute array set instances will be of derived types; this type exists for polymorphism purposes,\nso that they can be managed by a generic TUniquePtr<FMeshAttributeArraySetBase>.\nIn general, we avoid accessing them via virtual dispatch by insisting that their type be passed as\na template parameter in the accessor. This can be checked against the Type field to ensure that we are\naccessing an instance by its correct type."
    },
