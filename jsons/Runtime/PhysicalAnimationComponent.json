      "id": "set-skeletal-mesh-component",
      "name": "SetSkeletalMeshComponent",
      "category": "PhysicalAnimation",
      "signature": "SetSkeletalMeshComponent(Target, In Skeletal Mesh Component)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "In Skeletal Mesh Component",
          "type": "USkeletalMeshComponent*"
        }
      ],
      "returnType": "public : void",
      "docs": "Sets the skeletal mesh we are driving through physical animation. Will erase any existing physical animation data."
    },
    {
      "id": "apply-physical-animation-settings",
      "name": "ApplyPhysicalAnimationSettings",
      "category": "PhysicalAnimation",
      "signature": "ApplyPhysicalAnimationSettings(Target, Body Name, Physical Animation Data)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "Body Name",
          "type": "Name"
        },
        {
          "name": "Physical Animation Data",
          "type": "FPhysicalAnimationData&"
        }
      ],
      "returnType": "Void",
      "docs": "Applies the physical animation settings to the body given."
    },
    {
      "id": "apply-physical-animation-settings-below",
      "name": "ApplyPhysicalAnimationSettingsBelow",
      "category": "PhysicalAnimation",
      "signature": "ApplyPhysicalAnimationSettingsBelow(Target, Body Name, Physical Animation Data, Include Self)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "Body Name",
          "type": "Name"
        },
        {
          "name": "Physical Animation Data",
          "type": "FPhysicalAnimationData&"
        },
        {
          "name": "Include Self",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Applies the physical animation settings to the body given and all bodies below."
    },
    {
      "id": "set-strength-multiplyer",
      "name": "SetStrengthMultiplyer",
      "category": "PhysicalAnimation",
      "signature": "SetStrengthMultiplyer(Target, In Strength Multiplyer)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "In Strength Multiplyer",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Updates strength multiplyer and any active motors"
    },
    {
      "id": "apply-physical-animation-profile-below",
      "name": "ApplyPhysicalAnimationProfileBelow",
      "category": "PhysicalAnimation",
      "signature": "ApplyPhysicalAnimationProfileBelow(Target, Body Name, Profile Name, Include Self, Clear Not Found)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "Body Name",
          "type": "Name"
        },
        {
          "name": "Profile Name",
          "type": "Name"
        },
        {
          "name": "Include Self",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Clear Not Found",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Applies the physical animation profile to the body given and all bodies below.\n@param  BodyName\t\t\tThe body from which we'd like to start applying the physical animation profile. Finds all bodies below in the skeleton hierarchy. None implies all bodies\n@param  ProfileName\t\tThe physical animation profile we'd like to apply. For each body in the physics asset we search for physical animation settings with this name.\n@param  bIncludeSelf\t\tWhether to include the provided body name in the list of bodies we act on (useful to ignore for cases where a root has multiple children)\n@param  bClearNotFound\tIf true, bodies without the given profile name will have any existing physical animation settings cleared. If false, bodies without the given profile name are left untouched."
    },
    {
      "id": "get-body-target-transform",
      "name": "GetBodyTargetTransform",
      "category": "PhysicalAnimation",
      "signature": "GetBodyTargetTransform(Target, Body Name)",
      "params": [
        {
          "name": "Target",
          "type": "UPhysicalAnimationComponent*"
        },
        {
          "name": "Body Name",
          "type": "Name"
        }
      ],
      "returnType": "FTransform",
      "docs": "Returns the target transform for the given body. If physical animation component is not controlling this body, returns its current transform."
    },
