        }
      ],
      "returnType": "FMovieSceneBindingReferences*",
      "docs": "Retrieve core UOL-based binding references for this sequence type."
    },
    {
      "id": "locate-bound-objects-99db8f",
      "name": "LocateBoundObjects",
      "category": "MovieSceneSequence",
      "signature": "LocateBoundObjects(Target, Object Id, Resolve Params, Out Objects)",
      "params": [
        {
          "name": "Target",
          "type": "UMovieSceneSequence*"
        },
        {
          "name": "Object Id",
          "type": "FGuid&"
        },
        {
          "name": "Resolve Params",
          "type": "UE::UniversalObjectLocator::FResolveParams&"
        },
        {
          "name": "Out Objects",
          "type": "TArray<UObject*,TInlineAllocator<1>>&"
        }
      ],
      "returnType": "Void",
      "docs": "Locate all the objects that correspond to the specified object ID, using the specified parameters.\nCalling this directly instead of IMovieScenePlayer::ResolveBoundObjects means that you won't be able to locate Spawnable objects or objects from Custom Bindings.\n@param ObjectId\t\t\t\tThe unique identifier of the object.\n@param Params\t\t\t\tResolve parameters specifying the context and fragment-specific parameters\n@param OutObjects\t\t\tDestination array to add found objects to"
    },
    {
      "id": "locate-bound-objects-84995d",
      "name": "LocateBoundObjects",
      "category": "MovieSceneSequence",
      "signature": "LocateBoundObjects(Target, Object Id, Resolve Params, Shared Playback State, Out Objects)",
      "params": [
        {
