      "id": "assemble-program",
      "name": "AssembleProgram",
      "category": "Toolchain",
      "signature": "AssembleProgram(Target, Program, Build Context, Program Context)",
      "params": [
        {
          "name": "Target",
          "type": "CToolchain*"
        },
