        {
          "name": "Program Context",
          "type": "SProgramContext&"
        }
      ],
      "returnType": "ECompilerResult",
      "docs": "Run semantic analysis and code generation on a given Vst snippet\nSteps:\n1. Pre translate injections\n2. Assembler (code generation)"
