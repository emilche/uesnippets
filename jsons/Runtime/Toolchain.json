    {
      "id": "set-project-vst",
      "name": "SetProjectVst",
      "category": "Toolchain",
      "signature": "SetProjectVst(Target, New Project)",
      "params": [
        {
          "name": "Target",
          "type": "CToolchain*"
        },
        {
          "name": "New Project",
          "type": "TSRef<Verse::Vst::Project>&"
        }
      ],
      "returnType": "Void",
      "docs": "Directly sets the cached VST project to the new project specified.\nWarning: doing this will cause the previously cached VST project's destructor to be called,\nwhich means that any AST nodes that still hold references to the VST nodes within will now\nhave those references be invalidated. The only time you should use this is if you don't care\nabout the previous VST project anymore and its accompanying AST either.\n@param NewProject    The new project to store."
    },
