    {
      "id": "parse-snippet",
      "name": "ParseSnippet",
      "category": "Toolchain",
      "signature": "ParseSnippet(Target, Out Vst, Text Snippet, Build Context, Verse Version, Uploaded At FN Version)",
      "params": [
        {
          "name": "Target",
          "type": "CToolchain*"
        },
        {
          "name": "Out Vst",
          "type": "uLang::TSRef<Verse::Vst::Snippet>&"
        },
        {
          "name": "Text Snippet",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Build Context",
          "type": "SBuildContext&"
        },
        {
          "name": "Verse Version",
          "type": "uint32_t",
          "default": "Verse::Version::Default"
        },
        {
          "name": "Uploaded At FN Version",
          "type": "uint32_t",
          "default": "VerseFN::UploadedAtFNVersion::Latest"
        }
      ],
      "returnType": "ECompilerResult",
      "docs": "Parse a snippet of text and return the resulting Vst snippet\nSteps:\n1. Pre parse injections (from both toolchain and build context)\n2. Parse\n3. Post Vst filters\n4. Post parse injections (from both toolchain and build context)"
    },
    {
      "id": "compile-vst",
      "name": "CompileVst",
      "category": "Toolchain",
      "signature": "CompileVst(Target, Vst, Build Context, Program Context)",
