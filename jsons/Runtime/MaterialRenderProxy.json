      "id": "evaluate-uniform-expressions",
      "name": "EvaluateUniformExpressions",
      "category": "MaterialRenderProxy",
      "signature": "EvaluateUniformExpressions(Target, RHI Cmd List, Out Uniform Expression Cache, Context, Updater)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialRenderProxy*"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandListBase&"
        },
        {
          "name": "Out Uniform Expression Cache",
          "type": "FUniformExpressionCache&"
        },
        {
          "name": "Context",
          "type": "FMaterialRenderContext&"
        },
        {
          "name": "Updater",
          "type": "FUniformExpressionCacheAsyncUpdater*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Evaluates uniform expressions and stores them in OutUniformExpressionCache.\n@param OutUniformExpressionCache - The uniform expression cache to build.\n@param MaterialRenderContext - The context for which to cache expressions."
    },
    {
      "id": "cache-uniform-expressions",
      "name": "CacheUniformExpressions",
      "category": "MaterialRenderProxy",
      "signature": "CacheUniformExpressions(Target, RHI Cmd List, Recreate Uniform Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialRenderProxy*"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandListBase&"
        },
        {
          "name": "Recreate Uniform Buffer",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Caches uniform expressions for efficient runtime evaluation."
    },
    {
      "id": "cancel-cache-uniform-expressions",
