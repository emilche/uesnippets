    },
    {
      "id": "cache-uniform-expressions-game-thread",
      "name": "CacheUniformExpressions_GameThread",
      "category": "MaterialRenderProxy",
      "signature": "CacheUniformExpressions_GameThread(Target, Recreate Uniform Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialRenderProxy*"
        },
        {
          "name": "Recreate Uniform Buffer",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enqueues a rendering command to cache uniform expressions for efficient runtime evaluation.\nbRecreateUniformBuffer - whether to recreate the material uniform buffer.\nThis is required if the FMaterial is being recompiled (the uniform buffer layout will change).\nThis should only be done if the calling code is using FMaterialUpdateContext to recreate the rendering state of primitives using this material, since cached mesh commands also cache uniform buffer pointers."
    },
    {
