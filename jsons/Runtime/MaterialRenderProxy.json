    {
      "id": "get-material-with-fallback",
      "name": "GetMaterialWithFallback",
      "category": "MaterialRenderProxy",
      "signature": "GetMaterialWithFallback(Target, In Feature Level, Out Fallback Material Render Proxy)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialRenderProxy*"
        },
        {
          "name": "In Feature Level",
          "type": "ERHIFeatureLevel::Type"
        },
        {
          "name": "Out Fallback Material Render Proxy",
          "type": "FMaterialRenderProxy*&"
        }
      ],
      "returnType": "FMaterial&",
      "docs": "Finds the FMaterial to use for rendering this FMaterialRenderProxy.  Will fall back to a default material if needed due to a content error, or async compilation.\nThe returned FMaterial is guaranteed to have a complete shader map, so all relevant shaders should be available\nOutFallbackMaterialRenderProxy - The proxy that corresponds to the returned FMaterial, should be used for further rendering.  May be a fallback material, or 'this' if no fallback was needed"
    },
