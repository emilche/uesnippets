    {
      "id": "ai-move-to",
      "name": "AIMoveTo",
      "category": "AI",
      "signature": "AIMoveTo(Controller, Goal Location, Goal Actor, Acceptance Radius, Stop On Overlap, Accept Partial Path, Use Pathfinding, Lock AI Logic, Use Continuous Goal Tracking, Project Goal On Navigation, Require Navigable End Location)",
      "params": [
        {
          "name": "Controller",
          "type": "AAIController*"
        },
        {
          "name": "Goal Location",
          "type": "FVector"
        },
        {
          "name": "Goal Actor",
          "type": "AActor*",
          "default": "nullptr"
        },
        {
          "name": "Acceptance Radius",
          "type": "Float",
          "default": "-1.f"
        },
        {
          "name": "Stop On Overlap",
          "type": "EAIOptionFlag::Type",
          "default": "EAIOptionFlag::Default"
        },
        {
          "name": "Accept Partial Path",
          "type": "EAIOptionFlag::Type",
          "default": "EAIOptionFlag::Default"
        },
        {
          "name": "Use Pathfinding",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Lock AI Logic",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Use Continuous Goal Tracking",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Project Goal On Navigation",
          "type": "EAIOptionFlag::Type",
          "default": "EAIOptionFlag::Default"
        },
        {
          "name": "Require Navigable End Location",
          "type": "EAIOptionFlag::Type",
          "default": "EAIOptionFlag::Default"
        }
      ],
      "returnType": "UAITask_MoveTo*",
      "docs": "Move to a location or an actor\n@param ProjectGoalOnNavigation Try to move the goal to the navigation surface before requesting the move, fails if it can't.\n@param RequireNavigableEndLocation Set to No to allow pursuing the request even if no navigation surface is found at the goal location."
    },
