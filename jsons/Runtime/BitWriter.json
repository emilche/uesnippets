          "name": "Target",
          "type": "FBitWriter*"
        },
        {
          "name": "Value",
          "type": "UInt&"
        },
        {
          "name": "Max",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Serializes a compressed integer - Value must be < Max\n@param Value\t\tThe value to serialize, must be < Max\n@param Max\t\tThe maximum allowed value - good to aim for power-of-two"
    },
    {
      "id": "serialize-int-packed",
