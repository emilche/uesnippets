    },
    {
      "id": "write-int-wrapped",
      "name": "WriteIntWrapped",
      "category": "BitWriter",
      "signature": "WriteIntWrapped(Target, Value, Value Max)",
      "params": [
        {
          "name": "Target",
          "type": "FBitWriter*"
        },
        {
          "name": "Value",
          "type": "UInt"
        },
        {
          "name": "Value Max",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Serializes the specified Value, but does not bounds check against ValueMax;\ninstead, it will wrap around if the value exceeds ValueMax (this differs from SerializeInt, which clamps)\n@param Value\t\tThe value to serialize\n@param ValueMax\tThe maximum value to write; wraps Value if it exceeds this"
    },
