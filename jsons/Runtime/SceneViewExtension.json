    {
      "id": "subscribe-to-post-processing-pass-8632ef",
      "name": "SubscribeToPostProcessingPass",
      "category": "SceneViewExtension",
      "signature": "SubscribeToPostProcessingPass(Target, Pass, In View, In Out Pass Callbacks, Is Pass Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "ISceneViewExtension*"
        },
        {
          "name": "Pass",
          "type": "EPostProcessingPass"
        },
        {
          "name": "In View",
          "type": "FSceneView&"
        },
        {
          "name": "In Out Pass Callbacks",
          "type": "FPostProcessingPassDelegateArray&"
        },
        {
          "name": "Is Pass Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "This will be called at the beginning of post processing to make sure that each view extension gets a chance to subscribe to a post-processing pass event.\n- The pass MUST write to the override output texture if it is active (this occurs when the pass is the last in the post processing chain writing to the back buffer).\nFor performance reasons it is recommended to only subscribe to a pass when the pass will produce a GPU resource."
    },
