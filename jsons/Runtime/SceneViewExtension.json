{
  "id": "scene-view-extension",
  "label": "SceneViewExtension",
  "includepath": "SceneViewExtension.h",
  "includes": [
    "CoreMinimal",
    "DelegateCombinations",
    "RendererInterface",
    "SceneViewExtensionContext",
    "SceneTexturesConfig"
  ],
  "functions": [
    {
      "id": "f-scene-view-extension-base",
      "name": "FSceneViewExtensionBase",
      "category": "SceneViewExtension",
      "signature": "FSceneViewExtensionBase()",
      "params": [],
      "returnType": "public :",
      "docs": "Inherit from this class to make a view extension."
    },
    {
      "id": "is-active-this-frame",
      "name": "IsActiveThisFrame",
      "category": "SceneViewExtension",
      "signature": "IsActiveThisFrame(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneViewExtensionBase*"
        },
        {
          "name": "Context",
          "type": "FSceneViewExtensionContext&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returning false disables the extension for the current frame in the given context. This will be queried each frame to determine if the extension wants to run."
    },
    {
      "id": "f-world-scene-view-extension",
      "name": "FWorldSceneViewExtension",
      "category": "SceneViewExtension",
      "signature": "FWorldSceneViewExtension(Auto Reg, In World)",
      "params": [
        {
          "name": "Auto Reg",
          "type": "FAutoRegister&"
        },
        {
          "name": "In World",
          "type": "UWorld*"
        }
      ],
      "returnType": "public :",
      "docs": "Scene View Extension which is enabled for all Viewports/Scenes which have the same world."
    },
    {
      "id": "is-active-this-frame-internal",
      "name": "IsActiveThisFrame_Internal",
      "category": "SceneViewExtension",
      "signature": "IsActiveThisFrame_Internal(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FWorldSceneViewExtension*"
        },
        {
          "name": "Context",
          "type": "FSceneViewExtensionContext&"
        }
      ],
      "returnType": "protected : bool",
      "docs": "Called if no IsActive functors returned a definitive answer to whether this extension should be active this frame."
    },
    {
      "id": "for-each-active-view-extension",
      "name": "ForEachActiveViewExtension",
      "category": "SceneViewExtension",
      "signature": "ForEachActiveViewExtension(In Extensions, In Context, Func)",
      "params": [
        {
          "name": "In Extensions",
          "type": "TArray<TWeakPtr<ISceneViewExtension,ESPMode::ThreadSafe>>&"
        },
        {
          "name": "In Context",
          "type": "FSceneViewExtensionContext&"
        },
        {
          "name": "Func",
          "type": "TFunctionRef<void ( FSceneViewExtensionRef& )>&"
        }
      ],
      "returnType": "Void",
      "docs": "Executes a function on each view extension which is active in a given context."
    },
    {
      "id": "gather-active-extensions",
      "name": "GatherActiveExtensions",
      "category": "SceneViewExtension",
      "signature": "GatherActiveExtensions(Target, In Context)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneViewExtensions*"
        },
        {
          "name": "In Context",
          "type": "FSceneViewExtensionContext&"
        }
      ],
      "returnType": "TArray<FSceneViewExtensionRef>",
      "docs": "Gathers all ViewExtensions that want to be active in a given context (@see ISceneViewExtension::IsActiveThisFrame()).\nThe list is sorted by priority (@see ISceneViewExtension::GetPriority())"
    },
    {
      "id": "register-extension",
      "name": "RegisterExtension",
      "category": "SceneViewExtension",
      "signature": "RegisterExtension(Register Me)",
      "params": [
        {
          "name": "Register Me",
          "type": "FSceneViewExtensionRef&"
        }
      ],
      "returnType": "private : void"
    }
  ]
}