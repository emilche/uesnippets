    {
      "id": "get-local-network-version",
      "name": "GetLocalNetworkVersion",
      "category": "NetworkVersion",
      "signature": "GetLocalNetworkVersion(Allow Override Delegate)",
      "params": [
        {
          "name": "Allow Override Delegate",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "UInt",
      "docs": "Generates a version number, that by default, is based on a checksum of the engine version + project name + project version string\nGame/project code can completely override what this value returns through the GetLocalNetworkVersionOverride delegate\nIf called with AllowOverrideDelegate=false, we will not call the game project override. (This allows projects to call base implementation in their project implementation)"
    },
    {
      "id": "is-network-compatible",
      "name": "IsNetworkCompatible",
      "category": "NetworkVersion",
      "signature": "IsNetworkCompatible(Local Network Version, Remote Network Version)",
      "params": [
        {
          "name": "Local Network Version",
          "type": "UInt"
        },
        {
          "name": "Remote Network Version",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Determine if a connection is compatible with this instance\n@param bRequireEngineVersionMatch should the engine versions match exactly\n@param LocalNetworkVersion current version of the local machine\n@param RemoteNetworkVersion current version of the remote machine\n@return true if the two instances can communicate, false otherwise"
    },
