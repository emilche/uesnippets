{
  "id": "s-docking-splitter",
  "label": "SDockingSplitter",
  "includepath": "SDockingSplitter.h",
  "includes": [
    "CoreMinimal",
    "DeclarativeSyntaxSupport",
    "TabManager",
    "SDockingNode"
  ],
  "functions": [
    {
      "id": "add-child-node",
      "name": "AddChildNode",
      "category": "SDockingSplitter",
      "signature": "AddChildNode(Target, In Child, In Location)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "In Child",
          "type": "TSharedRef<SDockingNode>&"
        },
        {
          "name": "In Location",
          "type": "Int",
          "default": "INDEX_NONE"
        }
      ],
      "returnType": "Void",
      "docs": "Add a new child dock node at the desired location.\nAssumes this DockNode is a splitter.\n@param InChild      The DockNode child to add.\n@param InLocation   Index at which to add; INDEX_NONE (default) adds to the end of the list"
    },
    {
      "id": "replace-child",
      "name": "ReplaceChild",
      "category": "SDockingSplitter",
      "signature": "ReplaceChild(Target, In Child To Replace, Replacement)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "In Child To Replace",
          "type": "TSharedRef<SDockingNode>&"
        },
        {
          "name": "Replacement",
          "type": "TSharedRef<SDockingNode>&"
        }
      ],
      "returnType": "Void",
      "docs": "Replace the child InChildToReplace with Replacement\n@param InChildToReplace     The child of this node to replace\n@param Replacement          What to replace with"
    },
    {
      "id": "remove-child",
      "name": "RemoveChild",
      "category": "SDockingSplitter",
      "signature": "RemoveChild(Target, Child To Remove)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "Child To Remove",
          "type": "TSharedRef<SDockingNode>&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a child node from the splitter\n@param ChildToRemove    The child node to remove from this splitter"
    },
    {
      "id": "remove-child-at",
      "name": "RemoveChildAt",
      "category": "SDockingSplitter",
      "signature": "RemoveChildAt(Target, Index Of Child To Remove)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "Index Of Child To Remove",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a child at this index\n@param IndexOfChildToRemove    Remove a child at this index"
    },
    {
      "id": "place-node",
      "name": "PlaceNode",
      "category": "SDockingSplitter",
      "signature": "PlaceNode(Target, Node To Place, Direction, Relative To Me)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "Node To Place",
          "type": "TSharedRef<SDockingNode>&"
        },
        {
          "name": "Direction",
          "type": "SDockingNode::RelativeDirection"
        },
        {
          "name": "Relative To Me",
          "type": "TSharedRef<SDockingNode>&"
        }
      ],
      "returnType": "Void",
      "docs": "Inserts NodeToPlace next to RelativeToMe.\nNext to means above, below, left or right of RelativeToMe.\n@param NodeToPlace        The node to insert.\n@param Direction          Where to insert relative to the other node\n@param RelativeToMove     Insert relative to this node."
    },
    {
      "id": "set-orientation",
      "name": "SetOrientation",
      "category": "SDockingSplitter",
      "signature": "SetOrientation(Target, New Orientation)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "New Orientation",
          "type": "EOrientation"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the orientation of this splitter"
    },
    {
      "id": "get-child-nodes",
      "name": "GetChildNodes",
      "category": "SDockingSplitter",
      "signature": "GetChildNodes(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TArray<TSharedRef<SDockingNode>>&",
      "docs": "Gets an array of all child dock nodes"
    },
    {
      "id": "get-child-nodes-recursively",
      "name": "GetChildNodesRecursively",
      "category": "SDockingSplitter",
      "signature": "GetChildNodesRecursively(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TArray<TSharedRef<SDockingNode>>",
      "docs": "Gets an array of all child dock nodes and all of their child dock nodes and so on"
    },
    {
      "id": "get-all-child-tabs",
      "name": "GetAllChildTabs",
      "category": "SDockingSplitter",
      "signature": "GetAllChildTabs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TArray<TSharedRef<SDockTab>>",
      "docs": "Recursively searches through all children looking for child tabs"
    },
    {
      "id": "get-num-tabs",
      "name": "GetNumTabs",
      "category": "SDockingSplitter",
      "signature": "GetNumTabs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "Int",
      "docs": "Gets the number of tabs in all children recursively"
    },
    {
      "id": "get-size-rule",
      "name": "GetSizeRule",
      "category": "SDockingSplitter",
      "signature": "GetSizeRule(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "SSplitter::ESizeRule",
      "docs": "Should this node auto-size or be a percentage of its parent size"
    },
    {
      "id": "get-size-coefficient-for-slot",
      "name": "GetSizeCoefficientForSlot",
      "category": "SDockingSplitter",
      "signature": "GetSizeCoefficientForSlot(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the size coefficient of a given child dock node"
    },
    {
      "id": "get-orientation",
      "name": "GetOrientation",
      "category": "SDockingSplitter",
      "signature": "GetOrientation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "EOrientation",
      "docs": "Gets the orientation of this splitter"
    },
    {
      "id": "gather-persistent-layout",
      "name": "GatherPersistentLayout",
      "category": "SDockingSplitter",
      "signature": "GatherPersistentLayout(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TSharedPtr<FTabManager::FLayoutNode>"
    },
    {
      "id": "find-tab-stack-to-house-window-controls",
      "name": "FindTabStackToHouseWindowControls",
      "category": "SDockingSplitter",
      "signature": "FindTabStackToHouseWindowControls(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TSharedRef<SDockingTabStack>",
      "docs": "The tab stack which would be appropriate to use for showing the minimize/maximize/close buttons.\nOn Windows it is the upper right most. On Mac the upper left most."
    },
    {
      "id": "find-tab-stack-to-house-window-icon",
      "name": "FindTabStackToHouseWindowIcon",
      "category": "SDockingSplitter",
      "signature": "FindTabStackToHouseWindowIcon(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SDockingSplitter*"
        }
      ],
      "returnType": "TSharedRef<SDockingTabStack>",
      "docs": "Which tab stack is appropriate for showing the app icon."
    },
    {
      "id": "does-direction-match-orientation",
      "name": "DoesDirectionMatchOrientation",
      "category": "SDockingSplitter",
      "signature": "DoesDirectionMatchOrientation(In Direction, In Orientation)",
      "params": [
        {
          "name": "In Direction",
          "type": "SDockingNode::RelativeDirection"
        },
        {
          "name": "In Orientation",
          "type": "EOrientation"
        }
      ],
      "returnType": "Bool",
      "docs": "Is the docking direction (left, right, above, below) match the orientation (horizontal vs. vertical)"
    }
  ]
}