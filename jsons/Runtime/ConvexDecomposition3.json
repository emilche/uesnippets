    {
      "id": "initialize-from-hulls",
      "name": "InitializeFromHulls",
      "category": "ConvexDecomposition3",
      "signature": "InitializeFromHulls(Target, Num Hulls, Hull Volumes, Hull Num Vertices, Hull Vertices, Proximity)",
      "params": [
        {
          "name": "Target",
          "type": "FConvexDecomposition3*"
        },
        {
          "name": "Num Hulls",
          "type": "Int"
        },
        {
          "name": "Hull Volumes",
          "type": "TFunctionRef<double ( int32 )>"
        },
        {
          "name": "Hull Num Vertices",
          "type": "TFunctionRef<int32 ( int32 )>"
        },
        {
          "name": "Hull Vertices",
          "type": "TFunctionRef<FVector3d ( int32,int32 )>"
        },
        {
          "name": "Proximity",
          "type": "TArrayView<TPair<int32,int32>>"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize from convex hulls allows the caller to only use the hull merging phase of the algorithm\n@param NumHulls\t\t\tNumber of convex hulls in the initial decomposition\n@param HullVolumes\t\tFunction from Hull Index -> Hull Volume\n@param HullNumVertices\tFunction from Hull Index -> Hull Vertex Count\n@param HullVertices\t\tFunction from Hull Index, Vertex Index -> Hull Vertex Position\n@param Proximity\t\t\tAll the local proximities for the hulls. Hulls will not be merged unless they are connected by this proximity graph."
    },
    {
      "id": "initialize-proximity-from-decomposition-bounding-box-overlaps",
      "name": "InitializeProximityFromDecompositionBoundingBoxOverlaps",
      "category": "ConvexDecomposition3",
      "signature": "InitializeProximityFromDecompositionBoundingBoxOverlaps(Target, Bounds Expand By Min Dim Factor, Bounds Expand By Max Dim Factor, Min Bounds Expand)",
      "params": [
        {
          "name": "Target",
          "type": "FConvexDecomposition3*"
        },
        {
          "name": "Bounds Expand By Min Dim Factor",
          "type": "Double"
        },
        {
          "name": "Bounds Expand By Max Dim Factor",
          "type": "Double"
        },
        {
          "name": "Min Bounds Expand",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Create the proximity graph from the current decomposition, using bounding box overlaps. To consider non-overlapping proximity, the bounding boxes can be expanded by a factor of their own size or by an absolute amount.\n@param BoundsExpandByMinDimFactor\t\tPart bounds will be expanded by at least this factor of their own min dimension, before finding overlaps\n@param BoundsExpandByMaxDimFactor\t\tPart bounds will be expanded by at least this factor of their own max dimension, before finding overlaps\n@param MinBoundsExpand\t\t\t\t\tPart bounds will be expanded by at least this fixed amount, before finding overlaps"
    },
