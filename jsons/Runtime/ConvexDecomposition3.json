    {
      "id": "initialize-from-index-mesh-bc42bf",
      "name": "InitializeFromIndexMesh",
      "category": "ConvexDecomposition3",
      "signature": "InitializeFromIndexMesh(Target, Vertices, Faces, Merge Edges, Face Vertex Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FConvexDecomposition3*"
        },
        {
          "name": "Vertices",
          "type": "TArrayView<FVector3f>"
        },
        {
          "name": "Faces",
          "type": "TArrayView<FIntVector>"
        },
        {
          "name": "Merge Edges",
          "type": "Bool"
        },
        {
          "name": "Face Vertex Offset",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize convex decomposition with a triangle index mesh\n@param Vertices\t\t\tVertex buffer for mesh to decompose\n@param Faces\t\t\t\tTriangle buffer for mesh to decompose\n@param bMergeEdges\t\tWhether to attempt to weld matching edges before computing the convex hull; this can help the convex decomposition find better cutting planes for meshes that have boundaries e.g. due to seams\n@param FaceVertexOffset\tIndices from the Faces array are optionally offset by this value.  Useful e.g. to take slices of the multi-geometry vertex and face buffers of FGeometryCollection."
    },
    {
      "id": "initialize-from-index-mesh-96bdd4",
      "name": "InitializeFromIndexMesh",
      "category": "ConvexDecomposition3",
      "signature": "InitializeFromIndexMesh(Target, Vertices, Faces, Options, Face Vertex Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FConvexDecomposition3*"
        },
        {
          "name": "Vertices",
          "type": "TArrayView<FVector3f>"
        },
        {
          "name": "Faces",
          "type": "TArrayView<FIntVector>"
        },
        {
          "name": "Options",
          "type": "FPreprocessMeshOptions&"
        },
        {
          "name": "Face Vertex Offset",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize convex decomposition with a triangle index mesh\n@param Vertices\t\t\tVertex buffer for mesh to decompose\n@param Faces\t\t\t\tTriangle buffer for mesh to decompose\n@param Options\t\t\tOptions for pre-processing the mesh before decomposition (e.g., to weld matching edges, thicken degenerate inputs, or to run a general pre-process lambda function)\n@param FaceVertexOffset\tIndices from the Faces array are optionally offset by this value.  Useful e.g. to take slices of the multi-geometry vertex and face buffers of FGeometryCollection."
    },
    {
      "id": "initialize-negative-space",
      "name": "InitializeNegativeSpace",
      "category": "ConvexDecomposition3",
      "signature": "InitializeNegativeSpace(Target, Settings, Requested Samples)",
      "params": [
        {
          "name": "Target",
          "type": "FConvexDecomposition3*"
        },
        {
          "name": "Settings",
          "type": "FNegativeSpaceSampleSettings&"
