      "signature": "CheckIds(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if node ordering is correct (for debugging/testing)"
    }
  ]
}