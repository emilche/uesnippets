{
  "id": "index-priority-queue",
  "label": "IndexPriorityQueue",
  "includepath": "Util/IndexPriorityQueue.h",
  "includes": [
    "MathUtil",
    "DynamicVector"
  ],
  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "IndexPriorityQueue",
      "signature": "Initialize(Target, Max Node ID)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Max Node ID",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize internal data structures. Internally a fixed-size array is used to track mapping\nfrom IDs to internal node indices, so maxID must be provided up-front.\nIf this seems problematic or inefficient, this is not the Priority Queue for you.\n@param MaxNodeID maximum external ID that will be passed to any public functions"
    },
    {
      "id": "clear",
      "name": "Clear",
      "category": "IndexPriorityQueue",
      "signature": "Clear(Target, Free Memory)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Free Memory",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Reset the queue to empty state.\nif bFreeMemory is false, we don't discard internal data structures, so there will be less allocation next time"
    },
    {
      "id": "get-count",
      "name": "GetCount",
      "category": "IndexPriorityQueue",
      "signature": "GetCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        }
      ],
      "returnType": "Int",
      "docs": "@return current size of queue"
    },
    {
      "id": "get-first-node-id",
