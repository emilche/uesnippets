      "signature": "GetFirstNodeID(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        }
      ],
      "returnType": "Int",
      "docs": "@return id of node at head of queue"
    },
    {
      "id": "get-first-node-priority",
      "name": "GetFirstNodePriority",
      "category": "IndexPriorityQueue",
      "signature": "GetFirstNodePriority(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        }
      ],
      "returnType": "Float",
      "docs": "@return  id of node at head of queue"
    },
    {
      "id": "contains",
      "name": "Contains",
      "category": "IndexPriorityQueue",
      "signature": "Contains(Target, Node ID)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Node ID",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if id is already in queue"
    },
    {
      "id": "insert",
      "name": "Insert",
      "category": "IndexPriorityQueue",
      "signature": "Insert(Target, Node ID, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Node ID",
          "type": "Int"
        },
        {
          "name": "Priority",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Add id to list w/ given priority. Do not call with same id twice!"
    },
    {
      "id": "dequeue",
      "name": "Dequeue",
      "category": "IndexPriorityQueue",
      "signature": "Dequeue(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        }
      ],
      "returnType": "Int",
      "docs": "Remove node at head of queue, update queue, and return id for that node\n@return ID of node at head of queue"
    },
    {
      "id": "remove",
      "name": "Remove",
      "category": "IndexPriorityQueue",
      "signature": "Remove(Target, Node ID)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Node ID",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Remove node associated with given ID from queue. Behavior is undefined if you call w/ id that is not in queue"
    },
    {
      "id": "update",
      "name": "Update",
      "category": "IndexPriorityQueue",
      "signature": "Update(Target, Node ID, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Node ID",
          "type": "Int"
        },
        {
          "name": "Priority",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Update priority at node id, and then move it to correct position in queue. Behavior is undefined if you call w/ id that is not in queue"
    },
    {
      "id": "get-priority",
      "name": "GetPriority",
      "category": "IndexPriorityQueue",
      "signature": "GetPriority(Target, Id)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexPriorityQueue*"
        },
        {
          "name": "Id",
          "type": "Int"
        }
      ],
      "returnType": "Float",
      "docs": "Query the priority at node id, assuming it exists in queue. Behavior is undefined if you call w/ id that is not in queue\n@return priority for node"
    },
    {
      "id": "check-ids",
      "name": "CheckIds",
