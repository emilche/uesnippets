    {
      "id": "get-anim-notifies",
      "name": "GetAnimNotifies",
      "category": "AnimSequenceBase",
      "signature": "GetAnimNotifies(Target, Start Time, Delta Time, Notify Context)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "Start Time",
          "type": "Float&"
        },
        {
          "name": "Delta Time",
          "type": "Float&"
        },
        {
          "name": "Notify Context",
          "type": "FAnimNotifyContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieves AnimNotifies given a StartTime and a DeltaTime.\nTime will be advanced and support looping if bAllowLooping is true.\nSupports playing backwards (DeltaTime<0).\nReturns notifies between StartTime (exclusive) and StartTime+DeltaTime (inclusive)"
    },
    {
      "id": "get-anim-notifies-from-delta-positions",
      "name": "GetAnimNotifiesFromDeltaPositions",
      "category": "AnimSequenceBase",
      "signature": "GetAnimNotifiesFromDeltaPositions(Target, Previous Position, Current Position, Notify Context)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimSequenceBase*"
        },
        {
          "name": "Previous Position",
          "type": "Float&"
        },
        {
          "name": "Current Position",
          "type": "Float&"
        },
        {
          "name": "Notify Context",
          "type": "FAnimNotifyContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieves AnimNotifies between two time positions. ]PreviousPosition, CurrentPosition]\nBetween PreviousPosition (exclusive) and CurrentPosition (inclusive).\nSupports playing backwards (CurrentPosition<PreviousPosition).\nOnly supports contiguous range, does NOT support looping and wrapping over."
    },
