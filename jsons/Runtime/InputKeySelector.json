      "signature": "GetIsSelectingKey(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputKeySelector*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the widget is currently selecting a key, otherwise returns false."
    },
    {
      "id": "set-text-block-visibility",
      "name": "SetTextBlockVisibility",
