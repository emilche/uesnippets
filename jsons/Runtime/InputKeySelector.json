    "CoreMinimal",
    "ObjectMacros",
    "InputChord",
    "SlateFontInfo",
    "Margin",
    "SWidget",
    "Widget",
    "SlateTypes",
    "Visibility",
    "InputKeySelector.generated"
  ],
  "functions": [
    {
      "id": "set-selected-key",
      "name": "SetSelectedKey",
      "category": "Widget",
      "signature": "SetSelectedKey(Target, In Selected Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputKeySelector*"
