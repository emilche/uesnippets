        {
          "name": "In Selected Key",
          "type": "FInputChord&"
        }
      ],
      "returnType": "public : FButtonStyle WidgetStyle",
      "docs": "Sets the currently selected key."
    },
    {
      "id": "set-key-selection-text",
      "name": "SetKeySelectionText",
      "category": "Widget",
      "signature": "SetKeySelectionText(Target, In Key Selection Text)",
      "params": [
        {
          "name": "Target",
          "type": "UInputKeySelector*"
        },
        {
          "name": "In Key Selection Text",
          "type": "Text"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the text which is displayed while selecting keys."
