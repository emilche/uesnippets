    {
      "id": "set-allow-modifier-keys",
      "name": "SetAllowModifierKeys",
      "category": "Widget",
      "signature": "SetAllowModifierKeys(Target, In Allow Modifier Keys)",
      "params": [
        {
          "name": "Target",
          "type": "UInputKeySelector*"
        },
        {
          "name": "In Allow Modifier Keys",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether or not modifier keys are allowed in the selected key."
