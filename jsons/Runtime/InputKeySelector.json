    {
      "id": "set-allow-gamepad-keys",
      "name": "SetAllowGamepadKeys",
      "category": "Widget",
      "signature": "SetAllowGamepadKeys(Target, In Allow Gamepad Keys)",
      "params": [
        {
          "name": "Target",
          "type": "UInputKeySelector*"
        },
        {
          "name": "In Allow Gamepad Keys",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether or not gamepad keys are allowed in the selected key."
