{
  "id": "mesh-element-collector",
  "label": "MeshElementCollector",
  "includepath": "MeshElementCollector.h",
  "includes": [
    "MeshBatch",
    "RendererInterface"
  ],
  "functions": [
    {
      "id": "get-debug-pdi",
      "name": "GetDebugPDI",
      "category": "MeshElementCollector",
      "signature": "GetDebugPDI(Target, View Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementCollector*"
        },
        {
          "name": "View Index",
          "type": "Int"
        }
      ],
      "returnType": "FPrimitiveDrawInterface*"
    },
    {
      "id": "add-mesh",
      "name": "AddMesh",
      "category": "MeshElementCollector",
      "signature": "AddMesh(Target, View Index, Mesh Batch)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementCollector*"
        },
        {
          "name": "View Index",
          "type": "Int"
        },
        {
          "name": "Mesh Batch",
          "type": "FMeshBatch&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a mesh batch to the collector for the specified view so that it can be rendered."
    },
    {
      "id": "register-one-frame-material-proxy",
      "name": "RegisterOneFrameMaterialProxy",
      "category": "MeshElementCollector",
      "signature": "RegisterOneFrameMaterialProxy(Target, Proxy)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementCollector*"
        },
        {
          "name": "Proxy",
          "type": "FMaterialRenderProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Add a material render proxy that will be cleaned up automatically"
    },
    {
      "id": "cache-uniform-expressions",
      "name": "CacheUniformExpressions",
      "category": "MeshElementCollector",
      "signature": "CacheUniformExpressions(Target, Proxy, Recreate Uniform Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementCollector*"
        },
        {
          "name": "Proxy",
          "type": "FMaterialRenderProxy*"
        },
        {
          "name": "Recreate Uniform Buffer",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a request to force caching of uniform expressions for a material render proxy."
    }
  ]
}