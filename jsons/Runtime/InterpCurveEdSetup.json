{
  "id": "interp-curve-ed-setup",
  "label": "InterpCurveEdSetup",
  "includepath": "Engine/InterpCurveEdSetup.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "InterpCurveEdSetup.generated"
  ],
  "functions": [
    {
      "id": "get-curve-ed-interface-pointer",
      "name": "GetCurveEdInterfacePointer",
      "category": "InterpCurveEdSetup",
      "signature": "GetCurveEdInterfacePointer(Entry)",
      "params": [
        {
          "name": "Entry",
          "type": "FCurveEdEntry&"
        }
      ],
      "returnType": "FCurveEdInterface*"
    },
    {
      "id": "add-curve-to-current-tab",
      "name": "AddCurveToCurrentTab",
      "category": "InterpCurveEdSetup",
      "signature": "AddCurveToCurrentTab(Target, In Curve, Curve Name, Curve Color, Out Curve Entry, In Color Curve, In Floating Point Color, In Clamp, In Clamp Low, In Clamp High)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Curve",
          "type": "UObject*"
        },
        {
          "name": "Curve Name",
          "type": "String&"
        },
        {
          "name": "Curve Color",
          "type": "FColor&"
        },
        {
          "name": "Out Curve Entry",
          "type": "FCurveEdEntry**",
          "default": "NULL"
        },
        {
          "name": "In Color Curve",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Floating Point Color",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Clamp",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Clamp Low",
          "type": "Float",
          "default": "0.f"
        },
        {
          "name": "In Clamp High",
          "type": "Float",
          "default": "0.f"
        }
      ],
      "returnType": "Bool",
      "docs": "Add a new curve property to the current tab.\n@param\tOutCurveEntry\tThe curves which are for this graph node\n@return\ttrue, if new curves were added to the graph, otherwise they were already present"
    },
    {
      "id": "remove-curve",
      "name": "RemoveCurve",
      "category": "InterpCurveEdSetup",
      "signature": "RemoveCurve(Target, In Curve)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Curve",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a particuclar curve from all tabs."
    },
    {
      "id": "replace-curve",
      "name": "ReplaceCurve",
      "category": "InterpCurveEdSetup",
      "signature": "ReplaceCurve(Target, Remove Curve, Add Curve)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "Remove Curve",
          "type": "UObject*"
        },
        {
          "name": "Add Curve",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Replace a particuclar curve"
    },
    {
      "id": "create-new-tab",
      "name": "CreateNewTab",
      "category": "InterpCurveEdSetup",
      "signature": "CreateNewTab(Target, In Tab Name)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Tab Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Create a new tab in the CurveEdSetup."
    },
    {
      "id": "remove-tab",
      "name": "RemoveTab",
      "category": "InterpCurveEdSetup",
      "signature": "RemoveTab(Target, In Tab Name)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Tab Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the tab of the given name from the CurveEdSetup."
    },
    {
      "id": "showing-curve",
      "name": "ShowingCurve",
      "category": "InterpCurveEdSetup",
      "signature": "ShowingCurve(Target, In Curve)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Curve",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Look through CurveEdSetup and see if any properties of selected object is being shown."
    },
    {
      "id": "change-curve-color",
      "name": "ChangeCurveColor",
      "category": "InterpCurveEdSetup",
      "signature": "ChangeCurveColor(Target, In Curve, Curve Color)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Curve",
          "type": "UObject*"
        },
        {
          "name": "Curve Color",
          "type": "FColor&"
        }
      ],
      "returnType": "Void",
      "docs": "Change the color of the given curve"
    },
    {
      "id": "change-curve-name",
      "name": "ChangeCurveName",
      "category": "InterpCurveEdSetup",
      "signature": "ChangeCurveName(Target, In Curve, New Curve Name)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpCurveEdSetup*"
        },
        {
          "name": "In Curve",
          "type": "UObject*"
        },
        {
          "name": "New Curve Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Change the displayed name for a curve in the curve editor."
    }
  ]
