      "id": "get-reference-count",
      "name": "GetReferenceCount",
      "category": "FindReferencersArchive",
      "signature": "GetReferenceCount(Target, Target Object, Out Referencing Properties)",
      "params": [
        {
          "name": "Target",
          "type": "FFindReferencersArchive*"
        },
        {
          "name": "Target Object",
          "type": "UObject*"
        },
        {
          "name": "Out Referencing Properties",
          "type": "TArray<FProperty*>*",
          "default": "NULL"
        }
      ],
      "returnType": "Int",
      "docs": "Retrieves the number of references from PotentialReferencer to the object specified.\n@param\tTargetObject\tthe object to might be referenced\n@param\tout_ReferencingProperties\nreceives the list of properties which were holding references to TargetObject\n@return\tthe number of references to TargetObject which were encountered when PotentialReferencer\nwas serialized."
    },
