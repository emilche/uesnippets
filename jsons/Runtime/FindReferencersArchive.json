      "signature": "GetReferenceCounts(Target, Out Reference Counts)",
      "params": [
        {
          "name": "Target",
          "type": "FFindReferencersArchive*"
        },
        {
          "name": "Out Reference Counts",
          "type": "TMap<UObject*,int32>&"
        }
      ],
      "returnType": "Int",
      "docs": "Retrieves the number of references from PotentialReferencer list of TargetObjects\n@param\tout_ReferenceCounts\t\treceives the number of references to each of the TargetObjects\n@return\tthe number of objects which were referenced by PotentialReferencer."
    },
