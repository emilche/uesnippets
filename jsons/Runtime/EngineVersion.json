    },
    {
      "id": "compatible-with",
      "name": "CompatibleWith",
      "category": "EngineVersion",
      "signature": "CompatibleWith()",
      "params": [],
      "returnType": "FEngineVersion&",
      "docs": "Gets the earliest version which this engine maintains strict API and package compatibility with"
    },
    {
      "id": "tear-down",
      "name": "TearDown",
      "category": "EngineVersion",
      "signature": "TearDown()",
      "params": [],
