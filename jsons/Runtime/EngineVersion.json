      "signature": "ToString(Target, Last Component)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineVersion*"
        },
        {
          "name": "Last Component",
          "type": "EVersionComponent",
          "default": "EVersionComponent::Branch"
        }
      ],
      "returnType": "String",
      "docs": "Generates a version string"
    },
    {
      "id": "parse",
      "name": "Parse",
      "category": "EngineVersion",
      "signature": "Parse(Text, Out Version)",
      "params": [
        {
          "name": "Text",
          "type": "String&"
        },
        {
          "name": "Out Version",
          "type": "FEngineVersion&"
        }
      ],
      "returnType": "Bool",
      "docs": "Parses a version object from a string. Returns true on success."
    },
    {
