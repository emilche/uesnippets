      "params": [
        {
          "name": "Target",
          "type": "FEngineVersion*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the object."
    },
    {
      "id": "exact-match",
      "name": "ExactMatch",
      "category": "EngineVersion",
      "signature": "ExactMatch(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineVersion*"
        },
        {
          "name": "Other",
          "type": "FEngineVersion&"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks whether this engine version is an exact match for another engine version"
    },
    {
      "id": "is-compatible-with",
      "name": "IsCompatibleWith",
      "category": "EngineVersion",
      "signature": "IsCompatibleWith(Target, Other)",
      "params": [
