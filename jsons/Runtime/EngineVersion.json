          "name": "Target",
          "type": "FEngineVersion*"
        },
        {
          "name": "Other",
          "type": "FEngineVersionBase&"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks compatibility with another version object."
    },
    {
