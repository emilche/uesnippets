{
  "id": "object-ref",
  "label": "ObjectRef",
  "includepath": "UObject/ObjectRef.h",
  "includes": [
    "StringBuilder",
    "ObjectHandleDefines",
    "ObjectFwd",
    "ObjectMacros"
  ],
  "functions": [
    {
      "id": "append-class-path-name",
      "name": "AppendClassPathName",
      "category": "ObjectRef",
      "signature": "AppendClassPathName(Target, Out Class Path Name Builder, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectRef*"
        },
        {
          "name": "Out Class Path Name Builder",
          "type": "FStringBuilderBase&"
        },
        {
          "name": "Flags",
          "type": "EObjectFullNameFlags",
          "default": "EObjectFullNameFlags::IncludeClassPackage"
        }
      ],
      "returnType": "Void",
      "docs": "Appends the path to the class for this object to the builder, does not reset builder."
    },
    {
      "id": "get-f-name",
      "name": "GetFName",
      "category": "ObjectRef",
      "signature": "GetFName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectRef*"
        }
      ],
      "returnType": "Name",
      "docs": "Returns the name of the object in the form: ObjectName"
    },
    {
      "id": "append-path-name",
      "name": "AppendPathName",
      "category": "ObjectRef",
      "signature": "AppendPathName(Target, Out Path Name Builder)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectRef*"
        },
        {
          "name": "Out Path Name Builder",
          "type": "FStringBuilderBase&"
        }
      ],
      "returnType": "Void",
      "docs": "Appends the path to the object to the builder, does not reset builder."
    },
    {
      "id": "resolve-object-ref-class",
      "name": "ResolveObjectRefClass",
      "category": "ObjectRef",
      "signature": "ResolveObjectRefClass(Target, Load Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectRef*"
        },
        {
          "name": "Load Flags",
          "type": "UInt",
          "default": "LOAD_None"
        }
      ],
      "returnType": "UClass*"
    },
    {
      "id": "resolve",
      "name": "Resolve",
      "category": "ObjectRef",
      "signature": "Resolve(Target, Load Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FObjectRef*"
        },
        {
          "name": "Load Flags",
          "type": "UInt",
          "default": "LOAD_None"
        }
      ],
      "returnType": "UObject*"
    }
  ]
}