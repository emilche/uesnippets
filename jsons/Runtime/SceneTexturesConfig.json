{
  "id": "scene-textures-config",
  "label": "SceneTexturesConfig",
  "includepath": "SceneTexturesConfig.h",
  "includes": [
    "RenderGraphDefinitions",
    "ShaderParameterMacros",
    "GBufferInfo",
    "SceneUtils"
  ],
  "functions": [
    {
      "id": "get-scene-texture-shader-parameters",
      "name": "GetSceneTextureShaderParameters",
      "category": "SceneTexturesConfig",
      "signature": "GetSceneTextureShaderParameters(Target, Uniform Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        },
        {
          "name": "Uniform Buffer",
          "type": "TRDGUniformBufferRef<FMobileSceneTextureUniformParameters>"
        }
      ],
      "returnType": "FSceneTextureShaderParameters"
    },
    {
      "id": "get-scene-color-format-and-create-flags",
      "name": "GetSceneColorFormatAndCreateFlags",
      "category": "SceneTexturesConfig",
      "signature": "GetSceneColorFormatAndCreateFlags(Target, Feature Level, Requires Alpha Channel, Extra Scene Color Create Flags, Num Samples, Memoryless MSAA, Scene Color Format, Scene Color Create Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        },
        {
          "name": "Feature Level",
          "type": "ERHIFeatureLevel::Type"
        },
        {
          "name": "Requires Alpha Channel",
          "type": "Bool"
        },
        {
          "name": "Extra Scene Color Create Flags",
          "type": "ETextureCreateFlags"
        },
        {
          "name": "Num Samples",
          "type": "UInt"
        },
        {
          "name": "Memoryless MSAA",
          "type": "Bool"
        },
        {
          "name": "Scene Color Format",
          "type": "EPixelFormat&"
        },
        {
          "name": "Scene Color Create Flags",
          "type": "ETextureCreateFlags&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "init",
      "name": "Init",
      "category": "SceneTexturesConfig",
      "signature": "Init(Target, Init Settings)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        },
        {
          "name": "Init Settings",
          "type": "FSceneTexturesConfigInitSettings&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "build-scene-color-and-depth-flags",
      "name": "BuildSceneColorAndDepthFlags",
      "category": "SceneTexturesConfig",
      "signature": "BuildSceneColorAndDepthFlags(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-g-buffer-render-targets-info",
      "name": "GetGBufferRenderTargetsInfo",
      "category": "SceneTexturesConfig",
      "signature": "GetGBufferRenderTargetsInfo(Target, Render Targets Info, Layout)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        },
        {
          "name": "Render Targets Info",
          "type": "FGraphicsPipelineRenderTargetsInfo&"
        },
        {
          "name": "Layout",
          "type": "EGBufferLayout",
          "default": "GBL_Default"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "setup-mobile-g-buffer-flags",
      "name": "SetupMobileGBufferFlags",
      "category": "SceneTexturesConfig",
      "signature": "SetupMobileGBufferFlags(Target, Requires Multi Pass)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneTexturesConfig*"
        },
        {
          "name": "Requires Multi Pass",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-editor-primitive-num-samples",
      "name": "GetEditorPrimitiveNumSamples",
      "category": "SceneTexturesConfig",
      "signature": "GetEditorPrimitiveNumSamples(Feature Level)",
      "params": [
        {
          "name": "Feature Level",
          "type": "ERHIFeatureLevel::Type"
        }
      ],
      "returnType": "UInt"
    }
  ]
}