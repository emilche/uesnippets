{
  "id": "unix-feedback-context",
  "label": "UnixFeedbackContext",
  "includepath": "Unix/UnixFeedbackContext.h",
  "includes": [
    "CoreTypes",
    "AssertionMacros",
    "UnrealString",
    "CoreGlobals",
    "OutputDeviceRedirector",
    "OutputDeviceHelper",
    "App",
    "OutputDeviceConsole",
    "FeedbackContext",
    "syslog"
  ],
  "functions": [
    {
      "id": "begin-slow-task",
      "name": "BeginSlowTask",
      "category": "UnixFeedbackContext",
      "signature": "BeginSlowTask(Target, Task, Show Progress Dialog, Show Cancel Button)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixFeedbackContext*"
        },
        {
          "name": "Task",
          "type": "Text&"
        },
        {
          "name": "Show Progress Dialog",
          "type": "Bool"
        },
        {
          "name": "Show Cancel Button",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "end-slow-task",
      "name": "EndSlowTask",
      "category": "UnixFeedbackContext",
      "signature": "EndSlowTask(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixFeedbackContext*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "status-update",
      "name": "StatusUpdate",
      "category": "UnixFeedbackContext",
      "signature": "StatusUpdate(Target, Numerator, Denominator, Status Text)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixFeedbackContext*"
        },
        {
          "name": "Numerator",
          "type": "Int"
        },
        {
          "name": "Denominator",
          "type": "Int"
        },
        {
          "name": "Status Text",
          "type": "Text&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-context",
      "name": "GetContext",
      "category": "UnixFeedbackContext",
      "signature": "GetContext(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixFeedbackContext*"
        }
      ],
      "returnType": "FContextSupplier*"
    },
    {
      "id": "set-context",
      "name": "SetContext",
      "category": "UnixFeedbackContext",
      "signature": "SetContext(Target, In Supplier)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixFeedbackContext*"
        },
        {
          "name": "In Supplier",
          "type": "FContextSupplier*"
        }
      ],
      "returnType": "Void"
    }
  ]
}