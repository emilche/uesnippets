{
  "id": "build-patch-message",
  "label": "BuildPatchMessage",
  "includepath": "BuildPatchMessage.h",
  "includes": [
    "Map",
    "UnrealString",
    "Guid",
    "Function"
  ],
  "functions": [
    {
      "id": "handle-message",
      "name": "HandleMessage",
      "category": "BuildPatchMessage",
      "signature": "HandleMessage(Target, Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageHandler*"
        },
        {
          "name": "Message",
          "type": "FGenericMessage&"
        }
      ],
      "returnType": "Void",
      "docs": "Handle generic information posting. This can be called from any thread and should not\ntake appreciable time as it blocks further installation.\nSee FGenericMessage for payload contents and types"
    },
    {
      "id": "handle-request",
      "name": "HandleRequest",
      "category": "BuildPatchMessage",
      "signature": "HandleRequest(Target, Request, On Response)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageHandler*"
        },
        {
          "name": "Request",
          "type": "FChunkUriRequest&"
        },
        {
          "name": "On Response",
          "type": "TFunction<void ( FChunkUriResponse )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Handles responding to a chunk Uri request\n@param Request   The request for a chunk\n@param OnResponse   The function to callback once the chunk has been found",
      "supportedTargets": [
        "FMessageHandler*",
        "FDefaultMessageHandler*"
      ]
    },
    {
      "id": "get-message-requests",
      "name": "GetMessageRequests",
      "category": "BuildPatchMessage",
      "signature": "GetMessageRequests(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageHandler*"
        }
      ],
      "returnType": "EMessageRequests",
      "docs": "@return the message request flags."
    }
  ]
}