  "functions": [
    {
      "id": "pause",
      "name": "Pause",
      "category": "QueuedThreadPoolWrapper",
      "signature": "Pause(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        }
      ],
      "returnType": "Void",
      "docs": "Queued task are not scheduled against the wrapped thread-pool until resumed"
    },
    {
      "id": "resume",
      "name": "Resume",
      "category": "QueuedThreadPoolWrapper",
      "signature": "Resume(Target, In Num Queued Work)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        },
        {
          "name": "In Num Queued Work",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "Void",
      "docs": "Resume a specified amount of queued work, or -1 to unpause."
    },
    {
      "id": "set-max-concurrency",
      "name": "SetMaxConcurrency",
      "category": "QueuedThreadPoolWrapper",
      "signature": "SetMaxConcurrency(Target, Max Concurrency)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        },
        {
          "name": "Max Concurrency",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "Void",
      "docs": "Dynamically adjust the maximum number of concurrent tasks, -1 for unlimited."
    },
    {
      "id": "add-queued-work",
      "name": "AddQueuedWork",
      "category": "QueuedThreadPoolWrapper",
      "signature": "AddQueuedWork(Target, In Queued Work, In Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        },
        {
          "name": "In Queued Work",
          "type": "IQueuedWork*"
        },
        {
          "name": "In Priority",
          "type": "EQueuedWorkPriority",
          "default": "EQueuedWorkPriority::Normal"
        }
      ],
      "returnType": "Void"
    },
    {
