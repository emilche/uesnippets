      "name": "RetractQueuedWork",
      "category": "QueuedThreadPoolWrapper",
      "signature": "RetractQueuedWork(Target, In Queued Work)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        },
        {
          "name": "In Queued Work",
          "type": "IQueuedWork*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-num-threads",
      "name": "GetNumThreads",
      "category": "QueuedThreadPoolWrapper",
      "signature": "GetNumThreads(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FQueuedThreadPoolWrapper*"
        }
      ],
      "returnType": "Int"
    }
