      "category": "WindowsApplication",
      "signature": "RemoveForceMaxTouchpadSensitivity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWindowsApplication*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-force-max-touchpad-sensitivity-restoration-value",
      "name": "GetForceMaxTouchpadSensitivityRestorationValue",
      "category": "WindowsApplication",
      "signature": "GetForceMaxTouchpadSensitivityRestorationValue(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWindowsApplication*"
        }
      ],
      "returnType": "EForceMaxTouchpadSensitivityRestorationValues",
      "docs": "If we are using the system wide setting it is possible that we could crash and fail to set it back.  Call this function to\nfind out if we have a system setting value we would like to restore after a crash.\nIf this information was passed to a separate process (perhaps by writing it to a file) that process might be able to restore the setting\nafter a crash."
    }
