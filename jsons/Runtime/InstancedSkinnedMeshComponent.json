{
  "id": "instanced-skinned-mesh-component",
  "label": "InstancedSkinnedMeshComponent",
  "includepath": "Components/InstancedSkinnedMeshComponent.h",
  "includes": [
    "StaticMeshComponent",
    "SkeletalMeshComponent",
    "NaniteInterface",
    "AnimBank",
    "InstanceDataSceneProxy",
    "InstanceDataManager",
    "InstancedSkinnedMeshSceneProxyDesc",
    "InstancedSkinnedMeshComponent.generated"
  ],
  "functions": [
    {
      "id": "build-scene-desc",
      "name": "BuildSceneDesc",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "BuildSceneDesc(Target, In Scene Proxy Desc, Out Primitive Scene Desc)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "In Scene Proxy Desc",
          "type": "FPrimitiveSceneProxyDesc*"
        },
        {
          "name": "Out Primitive Scene Desc",
          "type": "FPrimitiveSceneDesc&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "add-instance",
      "name": "AddInstance",
      "category": "Components",
      "signature": "AddInstance(Target, Instance Transform, Bank Index, World Space)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Transform",
          "type": "FTransform&"
        },
        {
          "name": "Bank Index",
          "type": "Int"
        },
        {
          "name": "World Space",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "FPrimitiveInstanceId",
      "docs": "Add an instance to this component. Transform is given in local space of this component unless bWorldSpace is set."
    },
    {
      "id": "add-instances",
      "name": "AddInstances",
      "category": "Components",
      "signature": "AddInstances(Target, Transforms, Bank Indices, Should Return Ids, World Space)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Transforms",
          "type": "TArray<FTransform>&"
        },
        {
          "name": "Bank Indices",
          "type": "TArray<int32>&"
        },
        {
          "name": "Should Return Ids",
          "type": "Bool"
        },
        {
          "name": "World Space",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "TArray<FPrimitiveInstanceId>",
      "docs": "Add multiple instances to this component. Transform is given in local space of this component unless bWorldSpace is set."
    },
    {
      "id": "set-custom-data-value",
      "name": "SetCustomDataValue",
      "category": "Components",
      "signature": "SetCustomDataValue(Target, Instance Id, Custom Data Index, Custom Data Value)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        },
        {
          "name": "Custom Data Index",
          "type": "Int"
        },
        {
          "name": "Custom Data Value",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Update custom data for specific instance"
    },
    {
      "id": "set-custom-data",
      "name": "SetCustomData",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "SetCustomData(Target, Instance Id, Custom Data Floats)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        },
        {
          "name": "Custom Data Floats",
          "type": "TArrayView<float>"
        }
      ],
      "returnType": "Bool",
      "docs": "Update all custom data values for specific instance, the size of the array view must match the NumCustomDataFloats. Returns True on success."
    },
    {
      "id": "get-custom-data",
      "name": "GetCustomData",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "GetCustomData(Target, Instance Id, Custom Data Floats)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        },
        {
          "name": "Custom Data Floats",
          "type": "TArrayView<float>"
        }
      ],
      "returnType": "Bool",
      "docs": "Get all custom data values for specific instance, the size of the array view must match the NumCustomDataFloats. Returns True on success."
    },
    {
      "id": "set-num-custom-data-floats",
      "name": "SetNumCustomDataFloats",
      "category": "Components",
      "signature": "SetNumCustomDataFloats(Target, In Num Custom Data Floats)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "In Num Custom Data Floats",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Update number of custom data entries per instance. This applies to all instances and will reallocate the full custom data buffer and reset all values to 0"
    },
    {
      "id": "get-instance-transform",
      "name": "GetInstanceTransform",
      "category": "Components",
      "signature": "GetInstanceTransform(Target, Instance Id, Out Instance Transform, World Space)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        },
        {
          "name": "Out Instance Transform",
          "type": "FTransform&"
        },
        {
          "name": "World Space",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Get the transform for the instance specified. Instance is returned in local space of this component unless bWorldSpace is set. Returns True on success."
    },
    {
      "id": "get-instance-bank-index",
      "name": "GetInstanceBankIndex",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "GetInstanceBankIndex(Target, Instance Id, Out Bank Index)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        },
        {
          "name": "Out Bank Index",
          "type": "Int&"
        }
      ],
      "returnType": "Bool",
      "docs": "Get the bank index for the instance specified. Returns True on success."
    },
    {
      "id": "remove-instance",
      "name": "RemoveInstance",
      "category": "Components",
      "signature": "RemoveInstance(Target, Instance Id)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instance Id",
          "type": "FPrimitiveInstanceId"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove the instance specified. Returns True on success."
    },
    {
      "id": "remove-instances",
      "name": "RemoveInstances",
      "category": "Components",
      "signature": "RemoveInstances(Target, Instances To Remove)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Instances To Remove",
          "type": "TArray<FPrimitiveInstanceId>&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the instances specified. Returns True on success."
    },
    {
      "id": "clear-instances",
      "name": "ClearInstances",
      "category": "Components",
      "signature": "ClearInstances(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Clear all instances being rendered by this component."
    },
    {
      "id": "add-anim-bank-item",
      "name": "AddAnimBankItem",
      "category": "Components",
      "signature": "AddAnimBankItem(Target, Bank Item)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Bank Item",
          "type": "FAnimBankItem&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "optimize-instance-data",
      "name": "OptimizeInstanceData",
      "category": "Components",
      "signature": "OptimizeInstanceData(Target, Should Retain Id Map)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Should Retain Id Map",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Optimize the instance data by performing sorting according to spatial hash on the _source_ data.\nNote that this reorders the instances and thus any indexing will change. By default resets the ID mapping to identity.\n@param bShouldRetainIdMap\tIf true, the id mapping is updated instead of reset to identity, this retains the validity of the IDs but adds some memory and storage cost (for the ID mapping)."
    },
    {
      "id": "is-enabled",
      "name": "IsEnabled",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "IsEnabled(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-instance-count",
      "name": "GetInstanceCount",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "GetInstanceCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-anim-bank-items",
      "name": "GetAnimBankItems",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "GetAnimBankItems(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        }
      ],
      "returnType": "TArrayView<struct FAnimBankItem>"
    },
    {
      "id": "set-anim-bank-items",
      "name": "SetAnimBankItems",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "SetAnimBankItems(Target, In Anim Bank Items)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "In Anim Bank Items",
          "type": "TArrayView<FAnimBankItem>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-cull-distances",
      "name": "SetCullDistances",
      "category": "InstancedSkinnedMeshComponent",
      "signature": "SetCullDistances(Target, Start Cull Distance, End Cull Distance)",
      "params": [
        {
          "name": "Target",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Start Cull Distance",
          "type": "Int"
        },
        {
          "name": "End Cull Distance",
          "type": "Int"
        }
      ],
      "returnType": "Void"
    }
  ]
}