{
  "id": "message-log",
  "label": "MessageLog",
  "includepath": "Logging/MessageLog.h",
  "includes": [
    "Array",
    "SortedMap",
    "CoreTypes",
    "Delegate",
    "Text",
    "LogVerbosity",
    "TokenizedMessage",
    "SharedPointer",
    "NameTypes",
    "LowLevelMemTracker"
  ],
  "functions": [
    {
      "id": "flush",
      "name": "Flush",
      "category": "MessageLog",
      "signature": "Flush(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        }
      ],
      "returnType": "Void",
      "docs": "Send the currently buffered messages to the log & clear the buffer"
    },
    {
      "id": "add-message",
      "name": "AddMessage",
      "category": "MessageLog",
      "signature": "AddMessage(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "TSharedRef<FTokenizedMessage>&"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>&",
      "docs": "Add a message to the log.\n@param\tInMessage\tThe message to add\n@return The message for chaining calls"
    },
    {
      "id": "add-messages",
      "name": "AddMessages",
      "category": "MessageLog",
      "signature": "AddMessages(Target, In Messages)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Messages",
          "type": "TArray<TSharedRef<FTokenizedMessage>>&"
        }
      ],
      "returnType": "Void",
      "docs": "Add an array of messages to the message log\n@param\tInMessages\tThe messages to add"
    },
    {
      "id": "message",
      "name": "Message",
      "category": "MessageLog",
      "signature": "Message(Target, In Severity, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>",
      "docs": "Helper functions to allow easy adding of messages to the log. Each one will add a token\nfor the severity (if valid) and the textual message (if any). Messages are buffered.\n@param\tInSeverity\tThe severity of the message\n@param\tInMessage\tThe message to use\n@return the message for chaining calls."
    },
    {
      "id": "critical-error",
      "name": "CriticalError",
      "category": "MessageLog",
      "signature": "CriticalError(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>"
    },
    {
      "id": "error",
      "name": "Error",
      "category": "MessageLog",
      "signature": "Error(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>"
    },
    {
      "id": "performance-warning",
      "name": "PerformanceWarning",
      "category": "MessageLog",
      "signature": "PerformanceWarning(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>"
    },
    {
      "id": "warning",
      "name": "Warning",
      "category": "MessageLog",
      "signature": "Warning(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>"
    },
    {
      "id": "info",
      "name": "Info",
      "category": "MessageLog",
      "signature": "Info(Target, In Message)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "TSharedRef<FTokenizedMessage>"
    },
    {
      "id": "num-messages",
      "name": "NumMessages",
      "category": "MessageLog",
      "signature": "NumMessages(Target, In Severity Filter)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Severity Filter",
          "type": "EMessageSeverity::Type",
          "default": "EMessageSeverity::Info"
        }
      ],
      "returnType": "Int",
      "docs": "Check whether there are any messages present for this log.\nIf the log is paged, this will check if there are any messages on the current page.\nThis call will cause a flush so that the logs state is properly reflected.\n@param\tInSeverityFilter\tOnly messages of higher severity than this filter will be considered when checking.\n@return The number of messages that pass our filter"
    },
    {
      "id": "open",
      "name": "Open",
      "category": "MessageLog",
      "signature": "Open(Target, In Severity Filter, Open Even If Empty)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Severity Filter",
          "type": "EMessageSeverity::Type",
          "default": "EMessageSeverity::Info"
        },
        {
          "name": "Open Even If Empty",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Opens the log for display to the user given certain conditions.\nThis call will cause a flush so that the logs state is properly reflected.\n@param\tInSeverityFilter\tOnly messages of higher severity than this filter will be considered when checking.\n@param\tbOpenEvenIfEmpty\tOverride the filter & log status & force the log to open."
    },
    {
      "id": "notify",
      "name": "Notify",
      "category": "MessageLog",
      "signature": "Notify(Target, In Message, In Severity Filter, Force)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Message",
          "type": "Text&",
          "default": "FText()"
        },
        {
          "name": "In Severity Filter",
          "type": "EMessageSeverity::Type",
          "default": "EMessageSeverity::Info"
        },
        {
          "name": "Force",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Notify the user with a message if there are messages present.\nThis call will cause a flush so that the logs state is properly reflected.\n@param\tInMessage\t\t\tThe notification message.\n@param\tInSeverityFilter\tOnly messages of higher severity than this filter will be considered when checking.\n@param\tbForce\t\t\t\tNotify anyway, even if the filters gives us no messages."
    },
    {
      "id": "new-page",
      "name": "NewPage",
      "category": "MessageLog",
      "signature": "NewPage(Target, In Label)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Label",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Add a new page to the log.\nPages will not be created until messages are added to them, so we dont generate lots of empty pages.\nThis call will cause a flush so that the logs state is properly reflected.\n@param\tInLabel\t\tThe label for the page."
    },
    {
      "id": "set-current-page",
      "name": "SetCurrentPage",
      "category": "MessageLog",
      "signature": "SetCurrentPage(Target, In Label)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "In Label",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the current page to the one specified by the label.\nThis call will cause a flush so that the logs state is properly reflected.\n@param\tInLabel\t\tThe label for the page."
    },
    {
      "id": "suppress-logging-to-output-log",
      "name": "SuppressLoggingToOutputLog",
      "category": "MessageLog",
      "signature": "SuppressLoggingToOutputLog(Target, Should Suppress)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLog*"
        },
        {
          "name": "Should Suppress",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FMessageLog&",
      "docs": "Should we mirror message log messages from this instance to the output log during flush?",
      "supportedTargets": [
        "FMessageLog*",
        "FMessageLogScopedOverride*"
      ]
    },
    {
      "id": "on-get-log",
      "name": "OnGetLog",
      "category": "MessageLog",
      "signature": "OnGetLog()",
      "params": [],
      "returnType": "FGetLog&"
    },
    {
      "id": "on-message-selection-changed",
      "name": "OnMessageSelectionChanged",
      "category": "MessageLog",
      "signature": "OnMessageSelectionChanged()",
      "params": [],
      "returnType": "FMessageSelectionChanged&"
    },
    {
      "id": "get-log-verbosity",
      "name": "GetLogVerbosity",
      "category": "MessageLog",
      "signature": "GetLogVerbosity(In Severity)",
      "params": [
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "ELogVerbosity::Type",
      "docs": "Helper function to convert message log severity to log verbosity"
    },
    {
      "id": "get-log-color",
      "name": "GetLogColor",
      "category": "MessageLog",
      "signature": "GetLogColor(In Severity)",
      "params": [
        {
          "name": "In Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Helper function to retrieve a log color for a specified message severity"
    },
    {
      "id": "remap-message-severity",
      "name": "RemapMessageSeverity",
      "category": "MessageLog",
      "signature": "RemapMessageSeverity(Target, Src Severity, Dest Severity)",
      "params": [
        {
          "name": "Target",
          "type": "FMessageLogScopedOverride*"
        },
        {
          "name": "Src Severity",
          "type": "EMessageSeverity::Type"
        },
        {
          "name": "Dest Severity",
          "type": "EMessageSeverity::Type"
        }
      ],
      "returnType": "FMessageLogScopedOverride&",
      "docs": "Map category X to category Y when adding messages to this log"
    }
  ]
}