      "params": [
        {
          "name": "Target",
          "type": "IGizmoAxisSource*"
        }
      ],
      "returnType": "FVector",
      "docs": "@return Direction Vector of axis"
    },
    {
      "id": "has-tangent-vectors",
      "name": "HasTangentVectors",
      "category": "GizmoInterfaces",
      "signature": "HasTangentVectors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IGizmoAxisSource*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if this AxisSource has tangent vectors orthogonal to the Direction vector"
    },
    {
      "id": "get-tangent-vectors",
      "name": "GetTangentVectors",
      "category": "GizmoInterfaces",
      "signature": "GetTangentVectors(Target, Tangent X Out, Tangent Y Out)",
      "params": [
        {
          "name": "Target",
          "type": "IGizmoAxisSource*"
        },
        {
          "name": "Tangent X Out",
          "type": "FVector&"
        },
        {
          "name": "Tangent Y Out",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Get the two tangent vectors that are orthogonal to the Direction vector.\n@warning Only valid if HasTangentVectors() returns true"
    },
    {
      "id": "get-axis-frame",
      "name": "GetAxisFrame",
      "category": "GizmoInterfaces",
      "signature": "GetAxisFrame(Target, Plane Normal Out, Plane Axis 1 Out, Plane Axis 2 Out)",
      "params": [
        {
          "name": "Target",
          "type": "IGizmoAxisSource*"
        },
        {
          "name": "Plane Normal Out",
          "type": "FVector&"
        },
        {
          "name": "Plane Axis 1 Out",
          "type": "FVector&"
        },
        {
          "name": "Plane Axis 2 Out",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "Utility function that always returns a 3D coordinate system (ie plane normal and perpendicular axes).\nInternally calls GetTangentVectors() if available, otherwise constructs arbitrary mutually perpendicular vectors."
    },
    {
      "id": "update-hover-state-bbbd88",
      "name": "UpdateHoverState",
      "category": "GizmoInterfaces",
      "signature": "UpdateHoverState(Target, Hovering)",
      "params": [
        {
          "name": "Target",
          "type": "IGizmoClickTarget*"
        },
        {
          "name": "Hovering",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the hover state indicating whether the input device is currently hovering over the Standard gizmo.\nThis should be be set to false once interaction with the gizmo commences."
    },
    {
