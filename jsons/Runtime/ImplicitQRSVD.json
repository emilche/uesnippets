    {
      "id": "zero-chase",
      "name": "ZeroChase",
      "category": "ImplicitQRSVD",
      "signature": "ZeroChase<T>(H, U, V)",
      "params": [
        {
          "name": "H",
          "type": "PMatrix<T,3,3>&"
        },
        {
          "name": "U",
          "type": "PMatrix<T,3,3>&"
        },
        {
          "name": "V",
          "type": "PMatrix<T,3,3>&"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "\\brief zero chasing the 3X3 matrix to bidiagonal form\noriginal form of H:   x x 0\nx x x\n0 0 x\nafter zero chase:\nx x 0\n0 x x\n0 0 x"
    },
    {
      "id": "make-upper-bidiag",
      "name": "MakeUpperBidiag",
      "category": "ImplicitQRSVD",
      "signature": "MakeUpperBidiag<T>(H, U, V)",
      "params": [
        {
          "name": "H",
          "type": "PMatrix<T,3,3>&"
        },
        {
          "name": "U",
