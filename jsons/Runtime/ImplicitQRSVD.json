        {
          "name": "V",
          "type": "PMatrix<T,3,3>&"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "\\brief make a 3X3 matrix to upper bidiagonal form\noriginal form of H:   x x x\nx x x\nx x x\nafter zero chase:\nx x 0\n0 x x\n0 0 x"
    },
    {
      "id": "make-lambda-shape",
      "name": "MakeLambdaShape",
      "category": "ImplicitQRSVD",
      "signature": "MakeLambdaShape<T>(H, U, V)",
      "params": [
        {
          "name": "H",
          "type": "PMatrix<T,3,3>&"
        },
        {
          "name": "U",
          "type": "PMatrix<T,3,3>&"
        },
        {
          "name": "V",
          "type": "PMatrix<T,3,3>&"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "\\brief make a 3X3 matrix to lambda shape\noriginal form of H:   x x x\nx x x\nx x x\nafter :\nx 0 0\nx x 0\nx 0 x"
    },
    {
      "id": "polar-decomposition",
      "name": "PolarDecomposition",
      "category": "ImplicitQRSVD",
      "signature": "PolarDecomposition<T>(A, R, S Sym)",
      "params": [
        {
          "name": "A",
          "type": "PMatrix<T,2,2>&"
        },
        {
          "name": "R",
          "type": "GivensRotation<T>&"
        },
        {
          "name": "S Sym",
          "type": "PMatrix<T,2,2>&"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "\\brief 2x2 polar decomposition.\n\\param[in] A matrix.\n\\param[out] R Robustly a rotation matrix in givens form\n\\param[out] S_Sym Symmetric. Whole matrix is stored\nWhole matrix S is stored since its faster to calculate due to simd vectorization\nPolar guarantees negative sign is on the small magnitude singular value.\nS is guaranteed to be the closest one to identity.\nR is guaranteed to be the closest rotation to A."
    },
    {
      "id": "singular-value-decomposition",
      "name": "SingularValueDecomposition",
      "category": "ImplicitQRSVD",
      "signature": "SingularValueDecomposition<T>(A, U, Sigma, V, Tol)",
      "params": [
        {
          "name": "A",
          "type": "PMatrix<T,2,2>&"
        },
        {
          "name": "U",
          "type": "GivensRotation<T>&"
        },
        {
          "name": "Sigma",
          "type": "TVector<T,2>&"
        },
        {
          "name": "V",
          "type": "GivensRotation<T>&"
        },
        {
          "name": "Tol",
          "type": "T",
          "default": "std::numeric_limits<T>::epsilon()"
        }
      ],
      "returnType": "template<class T> void",
      "docs": "\\brief 2x2 SVD (singular value decomposition) A=USV'\n\\param[in] A Input matrix.\n\\param[out] U Robustly a rotation matrix in Givens form\n\\param[out] Sigma Vector of singular values sorted with decreasing magnitude. The second one can be negative.\n\\param[out] V Robustly a rotation matrix in Givens form"
    },
    {
      "id": "wilkinson-shift",
      "name": "WilkinsonShift",
      "category": "ImplicitQRSVD",
      "signature": "WilkinsonShift<T>(A 1, B 1, A 2)",
      "params": [
        {
          "name": "A 1",
          "type": "T"
        },
        {
          "name": "B 1",
          "type": "T"
        },
        {
          "name": "A 2",
          "type": "T"
        }
      ],
      "returnType": "template<class T> T",
      "docs": "\\brief Compute WilkinsonShift of the block\na1     b1\nb1     a2\nbased on the WilkinsonShift formula\nmu = c + d - sign (d) \\ sqrt (d*d + b*b), where d = (a-c)/2"
    },
