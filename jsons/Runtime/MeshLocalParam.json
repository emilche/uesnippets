    {
      "id": "compute-to-max-distance-fedbf0",
      "name": "ComputeToMaxDistance",
      "category": "MeshLocalParam",
      "signature": "ComputeToMaxDistance(Target, Seed Frame In, Seed Nbrs, Compute To Max Distance In)",
      "params": [
        {
          "name": "Target",
          "type": "TMeshLocalParam*"
        },
        {
          "name": "Seed Frame In",
          "type": "FFrame3d&"
        },
        {
          "name": "Seed Nbrs",
          "type": "FIndex3i&"
        },
        {
          "name": "Compute To Max Distance In",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Computes UVs outwards from seed frame/nbrs to all points that are less/equal to ComputeToMaxDistance from the seed.\n@param SeedFrameIn 3D frame on surface of point set, parameterization is computed \"in\" this frame (eg will align u/v to x/y axes, at origin)\n@param SeedNbrs 3 points that will be planar-projected into the SeedFrame, to initialize the region-growing (kind of triangle-mesh-specific)\n@param ComputeToMaxDistanceIn target radius for parameterization, will not set UVs on points with graph-distance larger than this"
    },
    {
      "id": "compute-to-max-distance-e1106b",
      "name": "ComputeToMaxDistance",
      "category": "MeshLocalParam",
      "signature": "ComputeToMaxDistance(Target, Center Point Vtx ID, Center Point Frame, Compute To Max Distance In)",
      "params": [
        {
          "name": "Target",
          "type": "TMeshLocalParam*"
        },
        {
          "name": "Center Point Vtx ID",
          "type": "Int"
        },
        {
          "name": "Center Point Frame",
          "type": "FFrame3d&"
        },
        {
          "name": "Compute To Max Distance In",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Computes UVs outwards from seed vertex to all points that are less/equal to ComputeToMaxDistance from the seed.\n@param CenterPointVtxID ID of seed vertex\n@param CenterPointFrame 3D frame on surface of point set, parameterization is computed \"in\" this frame (eg will align u/v to x/y axes, at origin)\n@param ComputeToMaxDistanceIn target radius for parameterization, will not set UVs on points with graph-distance larger than this"
    },
