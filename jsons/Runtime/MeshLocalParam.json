    {
      "id": "get-all-computed-u-vs",
      "name": "GetAllComputedUVs",
      "category": "MeshLocalParam",
      "signature": "GetAllComputedUVs(Target, Point I Ds Out, Point U Vs Out, Max UV Magnitude, Max Graph Dist)",
      "params": [
        {
          "name": "Target",
          "type": "TMeshLocalParam*"
        },
        {
          "name": "Point I Ds Out",
          "type": "TArray<int32>&"
        },
        {
          "name": "Point U Vs Out",
          "type": "TArray<FVector2d>&"
        },
        {
          "name": "Max UV Magnitude",
          "type": "Double",
          "default": "TNumericLimits<float>::Max()"
        },
        {
          "name": "Max Graph Dist",
          "type": "Double",
          "default": "TNumericLimits<float>::Max()"
        }
      ],
      "returnType": "Void",
      "docs": "Find all computed UVs within the specified distances\n@param PointIDsOut PointID corresponding to each computed UV is returned here\n@param PointUVsOut UV value corresponding to each PointID is returned here\n@param MaxUVMagnitude computed UVs will only be included if their magnitude is smaller than this value (eg, this is the UV-space radius)\n@param MaxGraphDistance computed UVs will only be included if their graph distance is smaller than this value. Graph distance is generally always be larger than UV distance. This can be used to avoid problematic UVs that might result from algorithm failures."
    },
