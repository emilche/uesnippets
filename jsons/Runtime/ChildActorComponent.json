    {
      "id": "set-child-actor-class-6924de",
      "name": "SetChildActorClass",
      "category": "ChildActorComponent",
      "signature": "SetChildActorClass(Target, In Class)",
      "params": [
        {
          "name": "Target",
          "type": "UChildActorComponent*"
        },
        {
          "name": "In Class",
          "type": "TSubclassOf<AActor>"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the class to use for the child actor.\nIf called on a template component (owned by a CDO), the properties of any existing child actor template will be copied as best possible to the template.\nIf called on a component instance in a world (and the class is changing), the created ChildActor will use the class defaults as template.\n@param InClass The Actor subclass to spawn as a child actor"
    },
    {
      "id": "set-child-actor-class-03bad0",
      "name": "SetChildActorClass",
      "category": "ChildActorComponent",
      "signature": "SetChildActorClass(Target, In Class, New Child Actor Template)",
      "params": [
        {
          "name": "Target",
          "type": "UChildActorComponent*"
        },
        {
          "name": "In Class",
          "type": "TSubclassOf<AActor>"
        },
        {
          "name": "New Child Actor Template",
          "type": "AActor*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets then class to use for the child actor providing an optional Actor to use as the template.\nIf called on a template component (owned by a CDO) and NewChildActorTemplate is not null, the new child actor template will be created using the supplied Actor as template.\nIf called on a template component and NewChildActorTemplate is null, the properties of any existing child actor template will be copied as best possible to the template.\nIf called on a component instance in a world with NewChildActorTemplate not null, then if registered a new child actor will be created using the supplied Actor as template,\notherwise if not registered it will ensure. If the class also changed, then future ChildActors created by this component the class defaults will be used.\nIf called on a component instance in a world with NewChildActorTemplate null and the class is changing, the created ChildActor will use the class defaults as template.\n@param InClass                 The Actor subclass to spawn as a child actor\n@param NewChildActorTemplate   An Actor to use as the template when spawning a child actor using this component (per the rules listed above)"
    },
