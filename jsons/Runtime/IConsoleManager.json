    {
      "id": "visit-platform-c-vars-for-emulation",
      "name": "VisitPlatformCVarsForEmulation",
      "category": "IConsoleManager",
      "signature": "VisitPlatformCVarsForEmulation(Platform Name, Device Profile Name, Visit)",
      "params": [
        {
          "name": "Platform Name",
          "type": "Name"
        },
        {
          "name": "Device Profile Name",
          "type": "String&"
        },
        {
          "name": "Visit",
          "type": "TFunctionRef<void ( FString& CVarName,FString& CVarValue,EConsoleVariableFlags SetBy )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Walks over the best set of ini sections for another platform that can be used to emulate cvars as the platform\nwill have set\nIt also won't include any UserSettings\n@param PlatformName The platform name (the ini name, so Windows, not Win64)\n@param DeviceProfileName If this is non-empty, the given deviceprofile will be loaded from the platform's inis and inserted into the CVars\n@param Visit the callback to run for each CVar found"
    },
