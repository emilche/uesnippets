    {
      "id": "f-auto-console-variable-shadow",
      "name": "FAutoConsoleVariableShadow",
      "category": "IConsoleManager",
      "signature": "FAutoConsoleVariableShadow(Name, C Var To Shadow, Lookup Failure Behavior)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "C Var To Shadow",
          "type": "TCHAR*"
        },
        {
          "name": "Lookup Failure Behavior",
          "type": "EShadowCVarBehavior",
          "default": "EShadowCVarBehavior::Ensure"
        }
      ],
      "returnType": "public :",
      "docs": "A class that can be used to shadow (alias) a CVar, where both names are valid to use.\nTo deprecate a CVar, use FAutoConsoleVariableDeprecated.\nTo deprecate a CCmd, use FAutoConsoleCommandDeprecated.\nFAutoConsoleVariableShadow ShadowCVar(TEXT(\"r.oldname\"), TEXT(\"r.newname\"));"
    },
    {
      "id": "f-auto-console-variable-deprecated",
      "name": "FAutoConsoleVariableDeprecated",
      "category": "IConsoleManager",
      "signature": "FAutoConsoleVariableDeprecated(Name, C Var To Shadow, Deprecated At Version, Usage Behavior, Lookup Failure Behavior, Deprecation Message)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "C Var To Shadow",
          "type": "TCHAR*"
        },
        {
          "name": "Deprecated At Version",
          "type": "TCHAR*"
        },
        {
          "name": "Usage Behavior",
          "type": "EShadowCVarBehavior",
          "default": "EShadowCVarBehavior::Ensure"
        },
        {
          "name": "Lookup Failure Behavior",
          "type": "EShadowCVarBehavior",
          "default": "EShadowCVarBehavior::Ensure"
        },
        {
          "name": "Deprecation Message",
          "type": "TCHAR*",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "public :",
      "docs": "A class that can be used to deprecate a CVar - rename your existing CVar to the new name, then\ncreate a shadow of it with the old name with something like this:\nFAutoConsoleVariableDeprecated ShadowCVar(TEXT(\"r.oldname\"), TEXT(\"r.newname\"), TEXT(\"5.5\"));\nFAutoConsoleVariableDeprecated ShadowCVar(TEXT(\"r.oldname\"), TEXT(\"r.newname\"), TEXT(\"5.5\"), EShadowCVarBehavior::Assert);"
    },
    {
      "id": "f-auto-console-command-deprecated",
      "name": "FAutoConsoleCommandDeprecated",
      "category": "IConsoleManager",
      "signature": "FAutoConsoleCommandDeprecated(Name, C Var To Shadow, Deprecated At Version, Usage Behavior, Lookup Failure Behavior, Deprecation Message)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "C Var To Shadow",
          "type": "TCHAR*"
        },
        {
          "name": "Deprecated At Version",
          "type": "TCHAR*"
        },
        {
          "name": "Usage Behavior",
          "type": "EShadowCVarBehavior",
          "default": "EShadowCVarBehavior::Ensure"
        },
        {
          "name": "Lookup Failure Behavior",
          "type": "EShadowCVarBehavior",
          "default": "EShadowCVarBehavior::Ensure"
        },
        {
          "name": "Deprecation Message",
          "type": "TCHAR*",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "public :",
      "docs": "A class that can be used to deprecate a ConsoleCommand - use just like FAutoConsoleVariableDeprecated"
    },
    {
      "id": "t-auto-ranged-console-variable",
      "name": "TAutoRangedConsoleVariable",
      "category": "IConsoleManager",
      "signature": "TAutoRangedConsoleVariable(Name, Default Value, Min Value, Max Value, Help, Flags, Parent)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Default Value",
          "type": "T"
        },
        {
          "name": "Min Value",
          "type": "T"
        },
        {
          "name": "Max Value",
          "type": "T"
        },
        {
          "name": "Help",
          "type": "TCHAR*"
        },
        {
          "name": "Flags",
          "type": "UInt",
          "default": "ECVF_Default"
        },
        {
          "name": "Parent",
          "type": "IConsoleVariable*",
          "default": "nullptr"
        }
      ],
      "returnType": "public :",
      "docs": "A class to create a ranged console variable. The min and max can be changed with <name>.min and <name.max>"
    }
  ]
