{
  "id": "slate-font-info",
  "label": "SlateFontInfo",
  "includepath": "Fonts/SlateFontInfo.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Class",
    "CompositeFont",
    "IConsoleManager",
    "SlateFontInfo.generated"
  ],
  "functions": [
    {
      "id": "has-valid-font",
      "name": "HasValidFont",
      "category": "SlateFontInfo",
      "signature": "HasValidFont(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check to see whether this font info has a valid composite font pointer set (either directly or via a UFont)"
    },
    {
      "id": "get-composite-font",
      "name": "GetCompositeFont",
      "category": "SlateFontInfo",
      "signature": "GetCompositeFont(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        }
      ],
      "returnType": "FCompositeFont*",
      "docs": "Get the composite font pointer associated with this font info (either directly or via a UFont)\n@note This function will return the fallback font if this font info itself does not contain a valid font. If you want to test whether this font info is empty, use HasValidFont"
    },
    {
      "id": "get-clamp-size",
      "name": "GetClampSize",
      "category": "SlateFontInfo",
      "signature": "GetClampSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        }
      ],
      "returnType": "Float",
      "docs": "Get the font size clamp for the font renderer (on 16bits)"
    },
    {
      "id": "get-clamp-skew",
      "name": "GetClampSkew",
      "category": "SlateFontInfo",
      "signature": "GetClampSkew(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        }
      ],
      "returnType": "Float",
      "docs": "Get the skew amount clamp for the text shaper"
    },
    {
      "id": "post-serialize",
      "name": "PostSerialize",
      "category": "SlateFontInfo",
      "signature": "PostSerialize(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Used to upgrade legacy font into so that it uses composite fonts"
    },
    {
      "id": "add-referenced-objects",
      "name": "AddReferencedObjects",
      "category": "SlateFontInfo",
      "signature": "AddReferencedObjects(Target, Collector)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateFontInfo*"
        },
        {
          "name": "Collector",
          "type": "FReferenceCollector&"
        }
      ],
      "returnType": "Void"
    }
  ]
}