      "docs": "Evaluate this curve at the specified time\n@param Time          The time (x-value) to evaluate at\n@param OutResult     Value to receieve the evaluated result\n@return true if the curve was evaluated successfully and OutResult was written to, false otherwise."
    },
    {
      "id": "inverse-evaluate",
      "name": "InverseEvaluate",
      "category": "MovieScenePiecewiseCurve",
      "signature": "InverseEvaluate(Target, Value, Time Hint, Flags)",
      "params": [
