    {
      "id": "prime-child-wave-players",
      "name": "PrimeChildWavePlayers",
      "category": "SoundNode",
      "signature": "PrimeChildWavePlayers(Target, Recurse)",
      "params": [
        {
          "name": "Target",
          "type": "USoundNode*"
        },
        {
          "name": "Recurse",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "When this is called and stream caching is enabled,\nany wave player sound nodes childed off of this node\nwill have their audio loaded into the cache.\n@param bRecurse when true, this will cause all children of child nodes to be primed as well."
    },
    {
      "id": "retain-child-wave-players",
      "name": "RetainChildWavePlayers",
      "category": "SoundNode",
      "signature": "RetainChildWavePlayers(Target, Recurse)",
      "params": [
        {
          "name": "Target",
          "type": "USoundNode*"
        },
        {
          "name": "Recurse",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "When this is called and stream caching is enabled,\nany wave player sound nodes childed off of this node\nwill have their audio retained into the cache.\n@param bRecurse when true, this will cause all children of child nodes to be primed as well."
    },
    {
      "id": "override-loading-behavior-on-child-waves",
      "name": "OverrideLoadingBehaviorOnChildWaves",
      "category": "SoundNode",
      "signature": "OverrideLoadingBehaviorOnChildWaves(Target, Recurse, In Loading Behavior)",
      "params": [
        {
          "name": "Target",
          "type": "USoundNode*"
        },
        {
          "name": "Recurse",
          "type": "Bool"
        },
        {
          "name": "In Loading Behavior",
          "type": "ESoundWaveLoadingBehavior"
        }
      ],
      "returnType": "Void",
      "docs": "When this is called and stream caching is enabled,\nany wave player sound nodes childed off of this node\nwith loading behavior set to \"Inherited\"\nwill have their loading behavior updated and\ntheir bLoadingBehaviorOverridden flag raised\n@param bRecurse when true, this will cause all children of child nodes to be overridden as well."
    },
    {
      "id": "release-retainer-on-child-wave-players",
      "name": "ReleaseRetainerOnChildWavePlayers",
      "category": "SoundNode",
      "signature": "ReleaseRetainerOnChildWavePlayers(Target, Recurse)",
