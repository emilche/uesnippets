      "returnType": "Void"
    },
    {
      "id": "remove-sound-wave-on-child-wave-players",
      "name": "RemoveSoundWaveOnChildWavePlayers",
      "category": "SoundNode",
      "signature": "RemoveSoundWaveOnChildWavePlayers(Target)",
      "params": [
        {
          "name": "Target",
          "type": "USoundNode*"
        }
      ],
      "returnType": "Void",
      "docs": "When called, this will find any child wave players connected to this node\nand null out their associated USoundWave, allowing the USoundWave to be garbage collected.\nThis should only be called by USoundNodeQualityLevel::PostLoad when au.CullSoundWaveHardReferences is 1."
    },
    {
      "id": "load-child-wave-player-assets",
      "name": "LoadChildWavePlayerAssets",
      "category": "SoundNode",
      "signature": "LoadChildWavePlayerAssets(Target, Add To Root, Recurse)",
      "params": [
        {
          "name": "Target",
          "type": "USoundNode*"
        },
        {
          "name": "Add To Root",
          "type": "Bool"
        },
        {
          "name": "Recurse",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Load wave assets for any wave player sound nodes\nchilded off of this node, taking into account quality nodes\n@param bRecurse when true, this will cause all children of child nodes to be loaded as well."
    }
