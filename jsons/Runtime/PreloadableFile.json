    {
      "id": "f-preloadable-file",
      "name": "FPreloadableFile",
      "category": "PreloadableFile",
      "signature": "FPreloadableFile(File Name)",
      "params": [
        {
          "name": "File Name",
          "type": "FStringView"
        }
      ],
      "returnType": "public :",
      "docs": "An FPreloadableArchive that is customized for reading files from IFileManager.\nThis class also supports registration of instances of this class by filename, which other systems in the engine can use to request\nan FArchive for the preload file, if it exists, replacing a call they would otherwise make to IFileManager::Get().CreateFileReader.\nAs with the base class, the preloading can work in either PreloadBytes or PreloadHandle mode.\nActivate PreloadBytes mode by passing Flags::PreloadBytes to InitializeAsync.\nActivate PreloadHandle mode by passing Flags::PreloadHandle to InitializeAsync, optionally or'd with Flags::Prime."
    },
    {
      "id": "initialize-async-429dc7",
      "name": "InitializeAsync",
      "category": "PreloadableFile",
      "signature": "InitializeAsync(Target, In Flags, Prime Size)",
      "params": [
        {
          "name": "Target",
          "type": "FPreloadableFile*"
        },
        {
          "name": "In Flags",
          "type": "UInt",
          "default": "Flags::None"
        },
        {
          "name": "Prime Size",
          "type": "Int64",
          "default": "DefaultPrimeSize"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize the FPreloadableFile asynchronously, performing FileOpen operations on another thread. Use IsInitialized or WaitForInitialization to check progress."
    },
    {
      "id": "try-register",
      "name": "TryRegister",
      "category": "PreloadableFile",
      "signature": "TryRegister(Preloadable File)",
      "params": [
        {
          "name": "Preloadable File",
          "type": "TSharedPtr<FPreloadableFile>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Try to register the given FPreloadableFile instance to handle the next call to TryTakeArchive for its FileName.\nWill fail if the instance has not been initialized or if another instance has already registered for the Filename.\nReturn whether the instance is currently registered. Returns true if the instance was already registered.\nRegistered files are referenced-counted, and the reference will not be dropped until (1) (TryTakeArchive or UnRegister is called) and (2) (PreloadBytes mode only) the archive returned from TryTakeArchive is deleted."
    },
    {
      "id": "try-take-archive",
      "name": "TryTakeArchive",
      "category": "PreloadableFile",
      "signature": "TryTakeArchive(File Name)",
      "params": [
        {
          "name": "File Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "FArchive*",
      "docs": "Look up an FPreloadableFile instance registered for the given FileName, and return an FArchive from it.\nIf found, removes the registration so no future call to TryTakeArchive can sue the same FArchive.\nIf the instance is in PreloadHandle mode, the Lower-Level FArchive will be detached from the FPreloadableFile and returned using DetachLowerLevel.\nIf the instance is in PreloadBytes mode, a ProxyArchive will be returned that forwards call to the FPreloadableFile instance."
    },
    {
      "id": "un-register",
      "name": "UnRegister",
      "category": "PreloadableFile",
      "signature": "UnRegister(Preloadable File)",
      "params": [
        {
          "name": "Preloadable File",
          "type": "TSharedPtr<FPreloadableFile>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove the FPreloadableFile instance if it is registered for its FileName. Returns whether the instance was registered."
    }
