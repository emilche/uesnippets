    {
      "id": "add-navigation-system-to-world",
      "name": "AddNavigationSystemToWorld",
      "category": "NavigationSystemBase",
      "signature": "AddNavigationSystemToWorld(Target, World Owner, Run Mode, Navigation System Config, Initialize For World, Override Previous Nav Sys)",
      "params": [
        {
          "name": "Target",
          "type": "UNavigationSystemBase*"
        },
        {
          "name": "World Owner",
          "type": "UWorld&"
        },
        {
          "name": "Run Mode",
          "type": "FNavigationSystemRunMode",
          "default": "FNavigationSystemRunMode::InvalidMode"
        },
        {
          "name": "Navigation System Config",
          "type": "UNavigationSystemConfig*",
          "default": "nullptr"
        },
        {
          "name": "Initialize For World",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Override Previous Nav Sys",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Creates an instance of NavigationSystem (class being specified by WorldSetting's NavigationSystemConfig)\nA new instance will be created only if given WorldOwner doesn't have one yet.\nThe new instance will be assigned to the given WorldOwner (via SetNavigationSystem\ncall) and depending on value of bInitializeForWorld the InitializeForWorld\nfunction will be called on the new NavigationSystem instance.\n(@see UWorld.NavigationSystem)\n@param RunMode if set to a valid value (other than FNavigationSystemRunMode::InvalidMode)\nwill also configure the created NavigationSystem instance for that mode\n@param NavigationSystemConfig is used to pick the navigation system's class and set it up. If null\nthen WorldOwner.WorldSettings.NavigationSystemConfig will be used"
    },
