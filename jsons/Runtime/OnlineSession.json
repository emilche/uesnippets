{
  "id": "online-session",
  "label": "OnlineSession",
  "includepath": "GameFramework/OnlineSession.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "CoreOnline",
    "OnlineSession.generated"
  ],
  "functions": [
    {
      "id": "clear-online-delegates",
      "name": "ClearOnlineDelegates",
      "category": "OnlineSession",
      "signature": "ClearOnlineDelegates(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UOnlineSession*"
        }
      ],
      "returnType": "Void",
      "docs": "Tear down all delegates used to manage online sessions."
    },
    {
      "id": "handle-disconnect",
      "name": "HandleDisconnect",
      "category": "OnlineSession",
      "signature": "HandleDisconnect(Target, World, Net Driver)",
      "params": [
        {
          "name": "Target",
          "type": "UOnlineSession*"
        },
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Net Driver",
          "type": "UNetDriver*"
        }
      ],
      "returnType": "Void",
      "docs": "Called to tear down any online sessions and return to main menu"
    },
    {
      "id": "start-online-session",
      "name": "StartOnlineSession",
      "category": "OnlineSession",
      "signature": "StartOnlineSession(Target, Session Name)",
      "params": [
        {
          "name": "Target",
          "type": "UOnlineSession*"
        },
        {
          "name": "Session Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Start the online session specified"
    },
    {
      "id": "end-online-session",
      "name": "EndOnlineSession",
      "category": "OnlineSession",
      "signature": "EndOnlineSession(Target, Session Name)",
      "params": [
        {
          "name": "Target",
          "type": "UOnlineSession*"
        },
        {
          "name": "Session Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "End the online session specified"
    },
    {
      "id": "on-session-user-invite-accepted",
      "name": "OnSessionUserInviteAccepted",
      "category": "OnlineSession",
      "signature": "OnSessionUserInviteAccepted(Target, Was Success, Controller Id, User Id, Invite Result)",
      "params": [
        {
          "name": "Target",
          "type": "UOnlineSession*"
        },
        {
          "name": "Was Success",
          "type": "Bool"
        },
        {
          "name": "Controller Id",
          "type": "Int"
        },
        {
          "name": "User Id",
          "type": "FUniqueNetIdPtr"
        },
        {
          "name": "Invite Result",
          "type": "FOnlineSessionSearchResult&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when a user accepts an invite"
    }
  ]
}