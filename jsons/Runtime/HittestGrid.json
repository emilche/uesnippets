      "id": "find-next-focusable-widget",
      "name": "FindNextFocusableWidget",
      "category": "HittestGrid",
      "signature": "FindNextFocusableWidget(Target, Starting Widget, Direction, Navigation Reply, Rule Widget, User Index)",
      "params": [
        {
          "name": "Target",
          "type": "FHittestGrid*"
        },
        {
          "name": "Starting Widget",
          "type": "FArrangedWidget&"
        },
        {
          "name": "Direction",
          "type": "EUINavigation"
        },
        {
          "name": "Navigation Reply",
          "type": "FNavigationReply&"
        },
        {
          "name": "Rule Widget",
          "type": "FArrangedWidget&"
        },
        {
          "name": "User Index",
          "type": "Int"
        }
      ],
      "returnType": "TSharedPtr<SWidget>",
      "docs": "Finds the next focusable widget by searching through the hit test grid\n@param StartingWidget  This is the widget we are starting at, and navigating from.\n@param Direction       The direction we should search in.\n@param NavigationReply The Navigation Reply to specify a boundary rule for the search.\n@param RuleWidget      The Widget that is applying the boundary rule, used to get the bounds of the Rule."
    },
