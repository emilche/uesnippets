  "functions": [
    {
      "id": "get-bubble-path",
      "name": "GetBubblePath",
      "category": "HittestGrid",
      "signature": "GetBubblePath(Target, Desktop Space Coordinate, Cursor Radius, Ignore Enabled Status, User Index)",
      "params": [
        {
          "name": "Target",
          "type": "FHittestGrid*"
        },
        {
          "name": "Desktop Space Coordinate",
          "type": "UE::Slate::FDeprecateVector2DParameter"
        },
        {
          "name": "Cursor Radius",
          "type": "Float"
        },
        {
          "name": "Ignore Enabled Status",
          "type": "Bool"
        },
        {
          "name": "User Index",
          "type": "Int",
          "default": "INDEX_NONE"
        }
      ],
      "returnType": "TArray<FWidgetAndPointer>",
      "docs": "Given a Slate Units coordinate in virtual desktop space, perform a hittest\nand return the path along which the corresponding event would be bubbled."
    },
    {
      "id": "set-hittest-area",
      "name": "SetHittestArea",
      "category": "HittestGrid",
      "signature": "SetHittestArea(Target, Hittest Position In Desktop, Hittest Dimensions, Hitest Offset In Window)",
      "params": [
        {
          "name": "Target",
          "type": "FHittestGrid*"
        },
        {
          "name": "Hittest Position In Desktop",
          "type": "UE::Slate::FDeprecateVector2DParameter&"
        },
        {
          "name": "Hittest Dimensions",
          "type": "UE::Slate::FDeprecateVector2DParameter&"
        },
        {
          "name": "Hitest Offset In Window",
          "type": "UE::Slate::FDeprecateVector2DParameter&",
          "default": "FVector2f::ZeroVector"
        }
      ],
      "returnType": "Bool",
      "docs": "Set the position and size of the hittest area in desktop coordinates\n@param HittestPositionInDesktop\tThe position of this hit testing area in desktop coordinates.\n@param HittestDimensions\t\t\tThe dimensions of this hit testing area.\n@return      Returns true if a clear of the hittest grid was required."
    },
