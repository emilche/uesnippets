    {
      "id": "interlocked-compare-exchange-128",
      "name": "InterlockedCompareExchange128",
      "category": "WindowsPlatformAtomics",
      "signature": "InterlockedCompareExchange128(Dest, Exchange, Comparand)",
      "params": [
        {
          "name": "Dest",
          "type": "FInt128*"
        },
        {
          "name": "Exchange",
          "type": "FInt128&"
        },
        {
          "name": "Comparand",
          "type": "FInt128*"
        }
      ],
      "returnType": "Bool",
      "docs": "The function compares the Destination value with the Comparand value:\n- If the Destination value is equal to the Comparand value, the Exchange value is stored in the address specified by Destination,\n- Otherwise, the initial value of the Destination parameter is stored in the address specified specified by Comparand.\n@return true if Comparand equals the original value of the Destination parameter, or false if Comparand does not equal the original value of the Destination parameter.\nEarly AMD64 processors lacked the CMPXCHG16B instruction.\nTo determine whether the processor supports this operation, call the IsProcessorFeaturePresent function with PF_COMPARE64_EXCHANGE128."
    },
