        {
          "name": "In Verts",
          "type": "TArray<FVector>&"
        },
        {
          "name": "Out Data",
          "type": "FNavigationRelevantData&"
        }
      ],
      "returnType": "Void",
      "docs": "Convert a list of vertices into the navigation format and store it into the FNavigationRelevantData's CollisionData.\n@param InVerts Array of triangles vertices position. Each triangle will be created from 3 consecutive vertices in the array. Its size must be a multiple a 3."
    },
    {
      "id": "export-rigid-body-geometry-921b02",
      "name": "ExportRigidBodyGeometry",
      "category": "RecastGeometryExport",
      "signature": "ExportRigidBodyGeometry(In Out Body Setup, Out Vertex Buffer, Out Index Buffer, Out Bounds, Local To World)",
      "params": [
        {
          "name": "In Out Body Setup",
          "type": "UBodySetup&"
        },
        {
          "name": "Out Vertex Buffer",
          "type": "TNavStatArray<FVector>&"
        },
        {
          "name": "Out Index Buffer",
          "type": "TNavStatArray<int32>&"
        },
        {
          "name": "Out Bounds",
          "type": "FBox&"
        },
        {
          "name": "Local To World",
          "type": "FTransform&",
          "default": "FTransform::Identity"
        }
      ],
      "returnType": "Void",
      "docs": "Collect the collision information of a BodySetup as a triangle mesh."
    },
    {
      "id": "export-rigid-body-geometry-d31a11",
      "name": "ExportRigidBodyGeometry",
      "category": "RecastGeometryExport",
      "signature": "ExportRigidBodyGeometry(In Out Body Setup, Out Tri Mesh Vertex Buffer, Out Tri Mesh Index Buffer, Out Convex Vertex Buffer, Out Convex Index Buffer, Out Shape Buffer, Out Bounds, Local To World)",
