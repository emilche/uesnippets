        {
          "name": "In Out Body Setup",
          "type": "UBodySetup&"
        },
        {
          "name": "Out Tri Mesh Vertex Buffer",
          "type": "TNavStatArray<FVector>&"
        },
        {
          "name": "Out Tri Mesh Index Buffer",
          "type": "TNavStatArray<int32>&"
        },
        {
          "name": "Out Convex Vertex Buffer",
