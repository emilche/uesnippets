        },
        {
          "name": "Out Convex Index Buffer",
          "type": "TNavStatArray<int32>&"
        },
        {
          "name": "Out Shape Buffer",
          "type": "TNavStatArray<int32>&"
        },
        {
          "name": "Out Bounds",
          "type": "FBox&"
        },
        {
          "name": "Local To World",
          "type": "FTransform&",
          "default": "FTransform::Identity"
        }
      ],
      "returnType": "Void",
      "docs": "Collect the collision information of a BodySetup as a triangle mesh and a series of convex shapes."
