{
  "id": "interp-to-movement-component",
  "label": "InterpToMovementComponent",
  "includepath": "Components/InterpToMovementComponent.h",
  "includes": [
    "CoreMinimal",
    "HitResult",
    "MovementComponent",
    "ObjectMacros",
    "InterpToMovementComponent.generated"
  ],
  "functions": [
    {
      "id": "stop-simulating",
      "name": "StopSimulating",
      "category": "Game",
      "signature": "StopSimulating(Target, Hit Result)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpToMovementComponent*"
        },
        {
          "name": "Hit Result",
          "type": "FHitResult&"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the reference to UpdatedComponent, fires stop event, and stops ticking."
    },
    {
      "id": "add-control-point-position",
      "name": "AddControlPointPosition",
      "category": "Control",
      "signature": "AddControlPointPosition(Target, Pos, Position Is Relative)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpToMovementComponent*"
        },
        {
          "name": "Pos",
          "type": "FVector"
        },
        {
          "name": "Position Is Relative",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "float MaxSimulationTimeStep",
      "docs": "Add a control point that represents a position."
    },
    {
      "id": "restart-movement",
      "name": "RestartMovement",
      "category": "Control",
      "signature": "RestartMovement(Target, Initial Direction)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpToMovementComponent*"
        },
        {
          "name": "Initial Direction",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Reset to start. Sets time to zero and direction to 1."
    },
    {
      "id": "finalise-control-points",
      "name": "FinaliseControlPoints",
      "category": "Control",
      "signature": "FinaliseControlPoints(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpToMovementComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Initialise the control points array. Call after adding control points if they are add after begin play ."
    },
    {
      "id": "reset-control-points",
      "name": "ResetControlPoints",
      "category": "Control",
      "signature": "ResetControlPoints(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInterpToMovementComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Clear the control points array and set to stopped."
    }
  ]
}