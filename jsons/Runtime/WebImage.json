{
  "id": "web-image",
  "label": "WebImage",
  "includepath": "WebImage.h",
  "includes": [
    "CoreMinimal",
    "DateTime",
    "UnrealString",
    "SharedPointer",
    "Delegate",
    "Attribute",
    "IHttpRequest",
    "IHttpResponse",
    "SlateDynamicImageBrush",
    "IImageWrapper"
  ],
  "functions": [
    {
      "id": "begin-download",
      "name": "BeginDownload",
      "category": "WebImage",
      "signature": "BeginDownload(Target, In Url, Stand In E Tag, Download Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        },
        {
          "name": "In Url",
          "type": "String&"
        },
        {
          "name": "Stand In E Tag",
          "type": "TOptional<FString>&",
          "default": "TOptional<FString>()"
        },
        {
          "name": "Download Callback",
          "type": "FOnImageDownloaded&",
          "default": "FOnImageDownloaded()"
        }
      ],
      "returnType": "Bool",
      "docs": "Begin downloading an image. This will automatically set the current brush to the downloaded image when it completes (if successful)"
    },
    {
      "id": "cancel-download",
      "name": "CancelDownload",
      "category": "WebImage",
      "signature": "CancelDownload(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        }
      ],
      "returnType": "Void",
      "docs": "Cancel any download in progress"
    },
    {
      "id": "attr",
      "name": "Attr",
      "category": "WebImage",
      "signature": "Attr(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        }
      ],
      "returnType": "TAttribute<FSlateBrush*>",
      "docs": "Use .Attr() to pass this brush into a slate attribute"
    },
    {
      "id": "http-request-complete",
      "name": "HttpRequestComplete",
      "category": "WebImage",
      "signature": "HttpRequestComplete(Target, Http Request, Http Response, Succeeded)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        },
        {
          "name": "Http Request",
          "type": "FHttpRequestPtr"
        },
        {
          "name": "Http Response",
          "type": "FHttpResponsePtr"
        },
        {
          "name": "Succeeded",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "request complete callback"
    }
  ]
}