      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        },
        {
          "name": "Stand In Brush In",
          "type": "TAttribute<FSlateBrush*>"
        }
      ],
      "returnType": "FWebImage&",
      "docs": "Set the brush that is currently being returned (this will be overridden when any async download completes)"
    },
    {
      "id": "begin-download-f4f367",
