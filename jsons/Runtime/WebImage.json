          "type": "FHttpResponsePtr"
        },
        {
          "name": "Succeeded",
          "type": "Bool"
        }
      ],
      "returnType": "private : void",
      "docs": "request complete callback"
    },
    {
      "id": "process-http-response",
      "name": "ProcessHttpResponse",
      "category": "WebImage",
      "signature": "ProcessHttpResponse(Target, Request Url, Http Response)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        },
        {
