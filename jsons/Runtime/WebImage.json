    "Attribute",
    "IHttpRequest",
    "IHttpResponse",
    "SlateDynamicImageBrush",
    "IImageWrapper"
  ],
  "functions": [
    {
      "id": "f-web-image",
      "name": "FWebImage",
      "category": "WebImage",
      "signature": "FWebImage()",
      "params": [],
      "returnType": "public :",
      "docs": "This class manages downloading an image and swapping it out a standin once it's done.\nExample (not cached):\nFWebImage Image;\nImage.SetStandInBrush(FStyle::Get()->GetBrush(\"Foo\"));\nImage.BeginDownload(Url, OptionalCallback);\nSNew(SImage)\n.Image(Image.Attr())\nYou may want to get your FWebImage from a FWebImageCache so we're not re-downloading the same URL all the time.\nExample (cached):\nFWebImageCache ImageCache; // usually global\nImageCache.SetStandInBrush(FStyle::Get()->GetBrush(\"Foo\"));\nSNew(SImage)\n.Image(ImageCache.Download(Url)->Attr())"
    },
    {
      "id": "begin-download",
      "name": "BeginDownload",
      "category": "WebImage",
      "signature": "BeginDownload(Target, In Url, Stand In E Tag, Download Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        },
        {
          "name": "In Url",
          "type": "String&"
        },
        {
          "name": "Stand In E Tag",
          "type": "TOptional<FString>&",
          "default": "TOptional<FString>()"
        },
        {
          "name": "Download Callback",
          "type": "FOnImageDownloaded&",
          "default": "FOnImageDownloaded()"
        }
      ],
      "returnType": "Bool",
      "docs": "Begin downloading an image. This will automatically set the current brush to the downloaded image when it completes (if successful)"
    },
    {
      "id": "cancel-download",
      "name": "CancelDownload",
      "category": "WebImage",
      "signature": "CancelDownload(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        }
      ],
      "returnType": "Void",
      "docs": "Cancel any download in progress"
    },
    {
      "id": "attr",
      "name": "Attr",
      "category": "WebImage",
      "signature": "Attr(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImage*"
        }
      ],
      "returnType": "public : TAttribute<FSlateBrush*>",
      "docs": "Use .Attr() to pass this brush into a slate attribute"
    },
    {
      "id": "http-request-complete",
      "name": "HttpRequestComplete",
      "category": "WebImage",
      "signature": "HttpRequestComplete(Target, Http Request, Http Response, Succeeded)",
      "params": [
