{
  "id": "u-object-allocator",
  "label": "UObjectAllocator",
  "includepath": "UObject/UObjectAllocator.h",
  "includes": [
    "CoreMinimal",
    "PlatformMath",
    "LinearAllocator"
  ],
  "functions": [
    {
      "id": "boot-message",
      "name": "BootMessage",
      "category": "UObjectAllocator",
      "signature": "BootMessage(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUObjectAllocator*"
        }
      ],
      "returnType": "Void",
      "docs": "Prints a debugf message to allow tuning"
    },
    {
      "id": "disable-persistent-allocator",
      "name": "DisablePersistentAllocator",
      "category": "UObjectAllocator",
      "signature": "DisablePersistentAllocator(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUObjectAllocator*"
        }
      ],
      "returnType": "Void",
      "docs": "Disables allocation of objects from the persistend allocator\nNeeded by the Editor to be able to clean up all objects"
    },
    {
      "id": "allocate-u-object",
      "name": "AllocateUObject",
      "category": "UObjectAllocator",
      "signature": "AllocateUObject(Target, Size, Alignment, Allow Permanent)",
      "params": [
        {
          "name": "Target",
          "type": "FUObjectAllocator*"
        },
        {
          "name": "Size",
          "type": "Int"
        },
        {
          "name": "Alignment",
          "type": "Int"
        },
        {
          "name": "Allow Permanent",
          "type": "Bool"
        }
      ],
      "returnType": "UObjectBase*",
      "docs": "Allocates a UObjectBase from the free store or the permanent object pool\n@param Size size of uobject to allocate\n@param Alignment alignment of uobject to allocate\n@param bAllowPermanent if true, allow allocation in the permanent object pool, if it fits\n@return newly allocated UObjectBase (not really a UObjectBase yet, no constructor like thing has been called)."
    },
    {
      "id": "free-u-object",
      "name": "FreeUObject",
      "category": "UObjectAllocator",
      "signature": "FreeUObject(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FUObjectAllocator*"
        },
        {
          "name": "Object",
          "type": "UObjectBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Returns a UObjectBase to the free store, unless it is in the permanent object pool\n@param Object object to free"
    },
    {
      "id": "contains",
      "name": "Contains",
      "category": "UObjectAllocator",
      "signature": "Contains(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FPermanentObjectPoolExtents*"
        },
        {
          "name": "Object",
          "type": "UObjectBase*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}