{
  "id": "package-writer",
  "label": "PackageWriter",
  "includepath": "Serialization/PackageWriter.h",
  "includes": [
    "Future",
    "StringView",
    "IoDispatcher",
    "IoHash",
    "AssertionMacros",
    "DateTime",
    "EnumClassFlags",
    "SecureHash",
    "CompactBinary",
    "RefCounting",
    "UniquePtr"
  ],
  "functions": [
    {
      "id": "get-capabilities",
      "name": "GetCapabilities",
      "category": "PackageWriter",
      "signature": "GetCapabilities(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        }
      ],
      "returnType": "FCapabilities",
      "docs": "Whether an entry should be created for each BulkData stored in the BulkData section\nThis is necessary for some Writers that need to be able to load the BulkDatas individually.\nFor other writers the extra regions are an unnecessary performance cost."
    },
    {
      "id": "get-exports-footer-size",
      "name": "GetExportsFooterSize",
      "category": "PackageWriter",
      "signature": "GetExportsFooterSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        }
      ],
      "returnType": "Int64",
      "docs": "Report the size of the Footer that is added after Exports and BulkData but before the PackageTrailer"
    },
    {
      "id": "create-linker-archive",
      "name": "CreateLinkerArchive",
      "category": "PackageWriter",
      "signature": "CreateLinkerArchive(Target, Package Name, Asset, Multi Output Index)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        },
        {
          "name": "Package Name",
          "type": "Name"
        },
        {
          "name": "Asset",
          "type": "UObject*"
        },
        {
          "name": "Multi Output Index",
          "type": "UInt16"
        }
      ],
      "returnType": "TUniquePtr<FLargeMemoryWriter>",
      "docs": "Create the FLargeMemoryWriter to which the Header and Exports are written during the save."
    },
    {
      "id": "create-linker-exports-archive",
      "name": "CreateLinkerExportsArchive",
      "category": "PackageWriter",
      "signature": "CreateLinkerExportsArchive(Target, Package Name, Asset, Multi Output Index)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        },
        {
          "name": "Package Name",
          "type": "Name"
        },
        {
          "name": "Asset",
          "type": "UObject*"
        },
        {
          "name": "Multi Output Index",
          "type": "UInt16"
        }
      ],
      "returnType": "TUniquePtr<FLargeMemoryWriter>",
      "docs": "Returns an archive to be used when serializing exports."
    },
    {
      "id": "register-determinism-helper",
      "name": "RegisterDeterminismHelper",
      "category": "PackageWriter",
      "signature": "RegisterDeterminismHelper(Target, Source Object, Determinism Helper)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        },
        {
          "name": "Source Object",
          "type": "UObject*"
        },
        {
          "name": "Determinism Helper",
          "type": "TRefCountPtr<UE::Cook::IDeterminismHelper>&"
        }
      ],
      "returnType": "Void",
      "docs": "Overridden by PackageWriters that handle bDeterminismDebug=true. A system will call this function to register\ntheir callback class for adding determinism diagnostics for the given object to the package save."
    },
    {
      "id": "is-pre-save-completed",
      "name": "IsPreSaveCompleted",
      "category": "PackageWriter",
      "signature": "IsPreSaveCompleted(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Report whether PreSave was already called by the PackageWriter before the current UPackage::Save call."
    },
    {
      "id": "as-cooked-package-writer",
      "name": "AsCookedPackageWriter",
      "category": "PackageWriter",
      "signature": "AsCookedPackageWriter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IPackageWriter*"
        }
      ],
      "returnType": "ICookedPackageWriter*",
      "docs": "Downcast function for IPackageWriters that implement the ICookedPackageWriters inherited interface.",
      "supportedTargets": [
        "IPackageWriter*",
        "ICookedPackageWriter*"
      ]
    },
    {
      "id": "get-cook-capabilities",
      "name": "GetCookCapabilities",
      "category": "PackageWriter",
      "signature": "GetCookCapabilities(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        }
      ],
      "returnType": "FCookCapabilities",
      "docs": "Whether this writer implements -diffonly or other difftypes."
    },
    {
      "id": "get-previous-cook-time",
      "name": "GetPreviousCookTime",
      "category": "PackageWriter",
      "signature": "GetPreviousCookTime(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        }
      ],
      "returnType": "FDateTime",
      "docs": "Return the timestamp of the previous cook, or FDateTime::MaxValue to indicate previous cook should be assumed newer than any other cook data."
    },
    {
      "id": "mark-packages-up-to-date",
      "name": "MarkPackagesUpToDate",
      "category": "PackageWriter",
      "signature": "MarkPackagesUpToDate(Target, Up To Date Packages)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Up To Date Packages",
          "type": "TArrayView<FName>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-previous-cooked-bytes",
      "name": "GetPreviousCookedBytes",
      "category": "PackageWriter",
      "signature": "GetPreviousCookedBytes(Target, Info, Out Data)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Info",
          "type": "FPackageInfo&"
        },
        {
          "name": "Out Data",
          "type": "FPreviousCookedBytesData&"
        }
      ],
      "returnType": "Bool",
      "docs": "Load the bytes of the previously-cooked package, used for diffing"
    },
    {
      "id": "complete-exports-archive-for-diff",
      "name": "CompleteExportsArchiveForDiff",
      "category": "PackageWriter",
      "signature": "CompleteExportsArchiveForDiff(Target, Info, Exports Archive)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Info",
          "type": "FPackageInfo&"
        },
        {
          "name": "Exports Archive",
          "type": "FLargeMemoryWriter&"
        }
      ],
      "returnType": "Void",
      "docs": "Append all data to the Exports archive that would normally be done in CommitPackage, used for diffing."
    },
    {
      "id": "begin-cache-for-cooked-platform-data",
      "name": "BeginCacheForCookedPlatformData",
      "category": "PackageWriter",
      "signature": "BeginCacheForCookedPlatformData(Target, Info)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Info",
          "type": "FBeginCacheForCookedPlatformDataInfo&"
        }
      ],
      "returnType": "EPackageWriterResult"
    },
    {
      "id": "update-save-arguments",
      "name": "UpdateSaveArguments",
      "category": "PackageWriter",
      "signature": "UpdateSaveArguments(Target, Save Args)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Save Args",
          "type": "FSavePackageArgs&"
        }
      ],
      "returnType": "Void",
      "docs": "Modify the SaveArgs if required before the first Save. Used for diffing."
    },
    {
      "id": "is-another-save-needed",
      "name": "IsAnotherSaveNeeded",
      "category": "PackageWriter",
      "signature": "IsAnotherSaveNeeded(Target, Previous Result, Save Args)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        },
        {
          "name": "Previous Result",
          "type": "FSavePackageResultStruct&"
        },
        {
          "name": "Save Args",
          "type": "FSavePackageArgs&"
        }
      ],
      "returnType": "Bool",
      "docs": "Report whether an additional save is needed and set up for it if so. Used for diffing."
    },
    {
      "id": "as-package-store-writer",
      "name": "AsPackageStoreWriter",
      "category": "PackageWriter",
      "signature": "AsPackageStoreWriter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ICookedPackageWriter*"
        }
      ],
      "returnType": "IPackageStoreWriter*",
      "docs": "Downcast function for ICookedPackageWriters that implement the IPackageStoreWriter inherited interface."
    },
    {
      "id": "lex-to-string",
      "name": "LexToString",
      "category": "PackageWriter",
      "signature": "LexToString(Value)",
      "params": [
        {
          "name": "Value",
          "type": "IPackageWriter::FBulkDataInfo::EType"
        }
      ],
      "returnType": "ANSICHAR*"
    }
  ]
}