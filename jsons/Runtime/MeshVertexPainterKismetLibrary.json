{
  "id": "mesh-vertex-painter-kismet-library",
  "label": "MeshVertexPainterKismetLibrary",
  "includepath": "MeshVertexPainter/MeshVertexPainterKismetLibrary.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "BlueprintFunctionLibrary",
    "MeshVertexPainterKismetLibrary.generated"
  ],
  "functions": [
    {
      "id": "paint-vertices-lerp-along-axis",
      "name": "PaintVerticesLerpAlongAxis",
      "category": "VertexPaint",
      "signature": "PaintVerticesLerpAlongAxis(Static Mesh Component, Start Color, End Color, Axis, Convert To SRGB)",
      "params": [
        {
          "name": "Static Mesh Component",
          "type": "UStaticMeshComponent*"
        },
        {
          "name": "Start Color",
          "type": "FLinearColor&"
        },
        {
          "name": "End Color",
          "type": "FLinearColor&"
        },
        {
          "name": "Axis",
          "type": "EVertexPaintAxis"
        },
        {
          "name": "Convert To SRGB",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Paints vertex colors on a mesh component lerping from the start to the end color along the specified axis."
    },
    {
      "id": "remove-painted-vertices",
      "name": "RemovePaintedVertices",
      "category": "VertexPaint",
      "signature": "RemovePaintedVertices(Static Mesh Component)",
      "params": [
        {
          "name": "Static Mesh Component",
          "type": "UStaticMeshComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes vertex colors on a mesh component"
    }
  ]
}