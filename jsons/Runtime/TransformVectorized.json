      "id": "multiply-using-matrix-with-scale",
      "name": "MultiplyUsingMatrixWithScale",
      "category": "TransformVectorized",
      "signature": "MultiplyUsingMatrixWithScale<T>(Out Transform, A, B)",
      "params": [
