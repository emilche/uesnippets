{
  "id": "volume-fader",
  "label": "VolumeFader",
  "includepath": "DSP/VolumeFader.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "activate",
      "name": "Activate",
      "category": "VolumeFader",
      "signature": "Activate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Void",
      "docs": "Activates the fader if currently deactivated. Sets duration to indefinite (-1.0f)"
    },
    {
      "id": "deactivate",
      "name": "Deactivate",
      "category": "VolumeFader",
      "signature": "Deactivate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Void",
      "docs": "Deactivates the fader, causing it to remain\nat the current value and disregard update."
    },
    {
      "id": "get-active-duration",
      "name": "GetActiveDuration",
      "category": "VolumeFader",
      "signature": "GetActiveDuration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Float",
      "docs": "Gets time fader is to remain active (-1.0f if always active)."
    },
    {
      "id": "get-volume",
      "name": "GetVolume",
      "category": "VolumeFader",
      "signature": "GetVolume(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Float",
      "docs": "Returns current volume of fader"
    },
    {
      "id": "get-volume-after-time",
      "name": "GetVolumeAfterTime",
      "category": "VolumeFader",
      "signature": "GetVolumeAfterTime(Target, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Returns the volume given the delta from the current time\ninto the future (Effectively like running to retrieve volume\nbut without actually updating internal state)."
    },
    {
      "id": "get-fade-duration",
      "name": "GetFadeDuration",
      "category": "VolumeFader",
      "signature": "GetFadeDuration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Float",
      "docs": "Returns the duration of the fade."
    },
    {
      "id": "get-curve",
      "name": "GetCurve",
      "category": "VolumeFader",
      "signature": "GetCurve(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "EFaderCurve",
      "docs": "Returns the curve type of the fader"
    },
    {
      "id": "get-target-volume",
      "name": "GetTargetVolume",
      "category": "VolumeFader",
      "signature": "GetTargetVolume(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Float",
      "docs": "Returns the target volume of the fader"
    },
    {
      "id": "is-active",
      "name": "IsActive",
      "category": "VolumeFader",
      "signature": "IsActive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether or not the fader is active."
    },
    {
      "id": "is-fading",
      "name": "IsFading",
      "category": "VolumeFader",
      "signature": "IsFading(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether or not the fader is currently\nfading over time."
    },
    {
      "id": "is-fading-in",
      "name": "IsFadingIn",
      "category": "VolumeFader",
      "signature": "IsFadingIn(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether or not the fader is currently\nfading over time and value is increasing."
    },
    {
      "id": "is-fading-out",
      "name": "IsFadingOut",
      "category": "VolumeFader",
      "signature": "IsFadingOut(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether or not the fader is currently\nfading over time and value is decreasing."
    },
    {
      "id": "set-active-duration",
      "name": "SetActiveDuration",
      "category": "VolumeFader",
      "signature": "SetActiveDuration(Target, In Duration)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        },
        {
          "name": "In Duration",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the duration the fader is to be active in the future,\nafter which point the fader is disabled.  When disabled,\nfader will hold the current fade state until activated,\nat which point it will continue applying the fade over the\nremainder of the fade duration."
    },
    {
      "id": "set-volume",
      "name": "SetVolume",
      "category": "VolumeFader",
      "signature": "SetVolume(Target, In Volume)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        },
        {
          "name": "In Volume",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the volume immediately, interrupting any currently active fade."
    },
    {
      "id": "start-fade",
      "name": "StartFade",
      "category": "VolumeFader",
      "signature": "StartFade(Target, In Volume, In Duration, In Curve)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        },
        {
          "name": "In Volume",
          "type": "Float"
        },
        {
          "name": "In Duration",
          "type": "Float"
        },
        {
          "name": "In Curve",
          "type": "EFaderCurve"
        }
      ],
      "returnType": "Void",
      "docs": "Applies a volume fade over time with the provided parameters."
    },
    {
      "id": "stop-fade",
      "name": "StopFade",
      "category": "VolumeFader",
      "signature": "StopFade(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        }
      ],
      "returnType": "Void",
      "docs": "Stops fade, maintaining the current value as the target."
    },
    {
      "id": "update",
      "name": "Update",
      "category": "VolumeFader",
      "signature": "Update(Target, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FVolumeFader*"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the fader's state with the given delta in time since last update."
    }
  ]
}