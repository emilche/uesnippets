{
  "id": "i-field-notification-class-descriptor",
  "label": "IFieldNotificationClassDescriptor",
  "includepath": "IFieldNotificationClassDescriptor.h",
  "includes": [
    "CoreMinimal",
    "FieldNotificationId"
  ],
  "functions": [
    {
      "id": "get-field",
      "name": "GetField",
      "category": "IFieldNotificationClassDescriptor",
      "signature": "GetField(Target, Class, In Field Name)",
      "params": [
        {
          "name": "Target",
          "type": "IClassDescriptor*"
        },
        {
          "name": "Class",
          "type": "UClass*"
        },
        {
          "name": "In Field Name",
          "type": "Name"
        }
      ],
      "returnType": "FFieldId",
      "docs": "Find the FieldId by name. Returns an invalid FFIeldId if not found."
    },
    {
      "id": "for-each-field",
      "name": "ForEachField",
      "category": "IFieldNotificationClassDescriptor",
      "signature": "ForEachField(Target, Class, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "IClassDescriptor*"
        },
        {
          "name": "Class",
          "type": "UClass*"
        },
        {
          "name": "Callback",
          "type": "TFunctionRef<bool ( FFieldId FielId )>"
        }
      ],
      "returnType": "Void",
      "docs": "Execute the callback for every FieldId in the ClassDescriptor."
    }
  ]
}