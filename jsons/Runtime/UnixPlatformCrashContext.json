    {
      "id": "init-from-signal",
      "name": "InitFromSignal",
      "category": "UnixPlatformCrashContext",
      "signature": "InitFromSignal(Target, In Signal, In Info, In Context)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixCrashContext*"
        },
        {
          "name": "In Signal",
          "type": "Int"
        },
        {
          "name": "In Info",
          "type": "siginfo_t*"
        },
        {
          "name": "In Context",
          "type": "void*"
        }
      ],
      "returnType": "Void",
      "docs": "Inits the crash context from data provided by a signal handler.\n@param InSignal number (SIGSEGV, etc)\n@param InInfo additional info (e.g. address we tried to read, etc)\n@param InContext thread context"
    },
    {
      "id": "init-from-diagnostics",
      "name": "InitFromDiagnostics",
      "category": "UnixPlatformCrashContext",
      "signature": "InitFromDiagnostics(Target, In Address)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixCrashContext*"
        },
        {
          "name": "In Address",
          "type": "void*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Inits the crash context from some diagnostic handler (ensure, stall, etc...)\n@param InAddress address where the event happened, for optional callstack trimming"
    },
    {
      "id": "capture-stack-trace",
      "name": "CaptureStackTrace",
      "category": "UnixPlatformCrashContext",
      "signature": "CaptureStackTrace(Target, Error Program Counter)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixCrashContext*"
        },
        {
          "name": "Error Program Counter",
          "type": "void*"
        }
      ],
      "returnType": "Void",
      "docs": "Populates crash context stack trace and a few related fields for the calling thread"
    },
    {
      "id": "capture-thread-stack-trace",
      "name": "CaptureThreadStackTrace",
      "category": "UnixPlatformCrashContext",
      "signature": "CaptureThreadStackTrace(Target, Thread Id)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixCrashContext*"
        },
        {
          "name": "Thread Id",
          "type": "uint32_t"
        }
      ],
      "returnType": "Void",
      "docs": "Populates crash context stack trace and a few related fields for another thread\n@param ThreadId The thread to capture the stack trace from"
    },
    {
      "id": "generate-crash-info-and-launch-reporter",
      "name": "GenerateCrashInfoAndLaunchReporter",
      "category": "UnixPlatformCrashContext",
      "signature": "GenerateCrashInfoAndLaunchReporter(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUnixCrashContext*"
        }
      ],
      "returnType": "Void",
      "docs": "Generates a new crash report containing information needed for the crash reporter and launches it; may not return.\n@return If the crash type is not continuable, the function will not return"
    },
    {
      "id": "set-type",
      "name": "SetType",
      "category": "UnixPlatformCrashContext",
      "signature": "SetType(Target, In Type)",
      "params": [
