{
  "id": "package-store",
  "label": "PackageStore",
  "includepath": "IO/PackageStore.h",
  "includes": [
    "Array",
    "ArrayView",
    "CoreMinimal",
    "CoreTypes",
    "Delegate",
    "PlatformCrt",
    "EnumClassFlags",
    "SecureHash",
    "PackageId",
    "SharedPointer",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "from-cb-object",
      "name": "FromCbObject",
      "category": "PackageStore",
      "signature": "FromCbObject(Obj)",
      "params": [
        {
          "name": "Obj",
          "type": "FCbObjectView"
        }
      ],
      "returnType": "FPackageStoreEntryResource"
    },
    {
      "id": "create-empty-package",
      "name": "CreateEmptyPackage",
      "category": "PackageStore",
      "signature": "CreateEmptyPackage(Package Name, Has Cook Error)",
      "params": [
        {
          "name": "Package Name",
          "type": "Name"
        },
        {
          "name": "Has Cook Error",
          "type": "Bool"
        }
      ],
      "returnType": "FPackageStoreEntryResource",
      "docs": "Creates a PackageStoreEntryResource that records a packagename and will be in an op with possible metadata\nstored in attachments, but for which the op has no packagedata. This is used for tracking build dependencies\non packages even if those packages fail to cook due to error or editoronly."
    },
    {
      "id": "mount",
      "name": "Mount",
      "category": "PackageStore",
      "signature": "Mount(Target, Backend, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        },
        {
          "name": "Backend",
          "type": "TSharedRef<IPackageStoreBackend>"
        },
        {
          "name": "Priority",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Mount a package store backend."
    },
    {
      "id": "get-package-store-entry",
      "name": "GetPackageStoreEntry",
      "category": "PackageStore",
      "signature": "GetPackageStoreEntry(Target, Package Id, Package Name, Out Package Store Entry)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        },
        {
          "name": "Package Id",
          "type": "FPackageId"
        },
        {
          "name": "Package Name",
          "type": "Name"
        },
        {
          "name": "Out Package Store Entry",
          "type": "FPackageStoreEntry&"
        }
      ],
      "returnType": "EPackageStoreEntryStatus",
      "docs": "Returns the package store entry data with export info and imported packages for the specified package ID."
    },
    {
      "id": "get-package-redirect-info",
      "name": "GetPackageRedirectInfo",
      "category": "PackageStore",
      "signature": "GetPackageRedirectInfo(Target, Package Id, Out Source Package Name, Out Redirected To Package Id)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        },
        {
          "name": "Package Id",
          "type": "FPackageId"
        },
        {
          "name": "Out Source Package Name",
          "type": "Name&"
        },
        {
          "name": "Out Redirected To Package Id",
          "type": "FPackageId&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns the redirected package ID and source package name for the specified package ID if it's being redirected."
    },
    {
      "id": "get-soft-references",
      "name": "GetSoftReferences",
      "category": "PackageStore",
      "signature": "GetSoftReferences(Target, Package Id, Out Package Ids)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        },
        {
          "name": "Package Id",
          "type": "FPackageId"
        },
        {
          "name": "Out Package Ids",
          "type": "TConstArrayView<FPackageId>&"
        }
      ],
      "returnType": "TConstArrayView<uint32>",
      "docs": "Returns all soft referenced package IDs for the specified package ID."
    },
    {
      "id": "on-pending-entries-added",
      "name": "OnPendingEntriesAdded",
      "category": "PackageStore",
      "signature": "OnPendingEntriesAdded(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        }
      ],
      "returnType": "FPackageStoreBackendContext::FPendingEntriesAddedEvent&"
    },
    {
      "id": "has-any-backends-mounted",
      "name": "HasAnyBackendsMounted",
      "category": "PackageStore",
      "signature": "HasAnyBackendsMounted(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageStore*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}