{
  "id": "damage-events",
  "label": "DamageEvents",
  "includepath": "Engine/DamageEvents.h",
  "includes": [
    "CoreMinimal",
    "SubclassOf",
    "NetSerialization",
    "HitResult",
    "DamageEvents.generated"
  ],
  "functions": [
    {
      "id": "get-best-hit-info",
      "name": "GetBestHitInfo",
      "category": "DamageEvents",
      "signature": "GetBestHitInfo(Target, Hit Actor, Hit Instigator, Out Hit Info, Out Impulse Dir)",
      "params": [
        {
          "name": "Target",
          "type": "FDamageEvent*"
        },
        {
          "name": "Hit Actor",
          "type": "AActor*"
        },
        {
          "name": "Hit Instigator",
          "type": "AActor*"
        },
        {
          "name": "Out Hit Info",
          "type": "FHitResult&"
        },
        {
          "name": "Out Impulse Dir",
          "type": "FVector&"
        }
      ],
      "returnType": "Void",
      "docs": "This is for compatibility with old-style functions which want a unified set of hit data regardless of type of hit.  Ideally this will go away over time."
    },
    {
      "id": "get-damage-scale",
      "name": "GetDamageScale",
      "category": "DamageEvents",
      "signature": "GetDamageScale(Target, Distance From Epicenter)",
      "params": [
        {
          "name": "Target",
          "type": "FRadialDamageParams*"
        },
        {
          "name": "Distance From Epicenter",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Returns damage done at a certain distance"
    }
  ]
}