        },
        {
          "name": "Src Data",
          "type": "void* RESTRICT"
        },
        {
          "name": "New State To Be Applied",
          "type": "FPropertyReplicationState*"
        }
      ],
      "returnType": "Bool",
      "docs": "Certain rep notifies requires the current state to be stored before we overwrite it, this method will copy property values from src data, , where SrcData is a UClass/UStruct containing properties\nif the property is marked as dirty in NewStateToBeApplied"
    },
    {
      "id": "push-property-replication-state",
