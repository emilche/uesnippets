        },
        {
          "name": "Dst Data",
          "type": "void* RESTRICT"
        },
        {
          "name": "Push All",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Push received state data to properties in DstData buffer. Note: DstData is a UClass/UStruct containing properties. Updates representation in DstStateBuffer and mark destination properties as dirty if updated."
    },
