        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        },
        {
          "name": "Other",
          "type": "FPropertyReplicationState&"
        }
      ],
      "returnType": "Void",
      "docs": "Set from Other this will update dirtiness by comparing all properties"
    },
    {
