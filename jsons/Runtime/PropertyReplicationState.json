      "params": [
        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        }
      ],
      "returnType": "Bool",
      "docs": "Either StateBuffer is initialized and owned by this instance, or we have been injected with a state from the network system\nA default constructed state is not valid"
    },
    {
      "id": "set-property-value",
      "name": "SetPropertyValue",
      "category": "PropertyReplicationState",
      "signature": "SetPropertyValue(Target, Index, Src Value)",
      "params": [
        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        },
        {
          "name": "Index",
          "type": "UInt"
        },
        {
          "name": "Src Value",
          "type": "void*"
        }
      ],
      "returnType": "Void",
      "docs": "Set the value at the provided Index,\nThe UProperty is looked up from the descriptor using the index, if the value differs the statemask is updated\nMostly intended for test code\nNormal use of this class is through the poll layer\nTODO: It would be nice if we could provide some validation on property types"
    },
    {
      "id": "get-property-value",
      "name": "GetPropertyValue",
      "category": "PropertyReplicationState",
      "signature": "GetPropertyValue(Target, Index, Dst Value)",
      "params": [
        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        },
        {
          "name": "Index",
          "type": "UInt"
        },
        {
          "name": "Dst Value",
          "type": "void*"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieve the value at the provided Index by writing it to DstValue.\nThe property is looked up from the descriptor using the index.\nMostly intended for test code. Normal use of this class is through the poll layer."
    },
    {
      "id": "is-dirty",
      "name": "IsDirty",
      "category": "PropertyReplicationState",
      "signature": "IsDirty(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        },
        {
          "name": "Index",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Is the property at the given index dirty, for properties with multiple bits in the statemask this will return true if any of those bits are set"
    },
    {
      "id": "mark-dirty",
      "name": "MarkDirty",
      "category": "PropertyReplicationState",
      "signature": "MarkDirty(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FPropertyReplicationState*"
        },
        {
          "name": "Index",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Explicitly mark the property at the given Index as dirty, for properties with multiple bits in the statemask this will mark all bits dirty"
    },
    {
      "id": "poll-property-replication-state",
