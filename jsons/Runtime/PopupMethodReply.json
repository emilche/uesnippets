{
  "id": "popup-method-reply",
  "label": "PopupMethodReply",
  "includepath": "Input/PopupMethodReply.h",
  "includes": [
    "CoreMinimal",
    "ReplyBase"
  ],
  "functions": [
    {
      "id": "use-method",
      "name": "UseMethod",
      "category": "PopupMethodReply",
      "signature": "UseMethod(With Method)",
      "params": [
        {
          "name": "With Method",
          "type": "EPopupMethod"
        }
      ],
      "returnType": "FPopupMethodReply",
      "docs": "Create a reply that specifies how a popup should be handled."
    },
    {
      "id": "set-should-throttle",
      "name": "SetShouldThrottle",
      "category": "PopupMethodReply",
      "signature": "SetShouldThrottle(Target, In Should Throttle)",
      "params": [
        {
          "name": "Target",
          "type": "FPopupMethodReply*"
        },
        {
          "name": "In Should Throttle",
          "type": "EShouldThrottle"
        }
      ],
      "returnType": "FPopupMethodReply&",
      "docs": "Specify whether we should throttle the engine ticking s.t. the UI is most responsive when this popup is up."
    },
    {
      "id": "get-should-throttle",
      "name": "GetShouldThrottle",
      "category": "PopupMethodReply",
      "signature": "GetShouldThrottle(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPopupMethodReply*"
        }
      ],
      "returnType": "EShouldThrottle",
      "docs": "Should we throttle the engine?"
    },
    {
      "id": "get-popup-method",
      "name": "GetPopupMethod",
      "category": "PopupMethodReply",
      "signature": "GetPopupMethod(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPopupMethodReply*"
        }
      ],
      "returnType": "EPopupMethod",
      "docs": "Which method to use for the popup: new window or reuse current window"
    },
    {
      "id": "is-set",
      "name": "IsSet",
      "category": "PopupMethodReply",
      "signature": "IsSet(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPopupMethodReply*"
        }
      ],
      "returnType": "Bool",
      "docs": "Alias for IsEventHandled for situations where this is used as optional"
    }
  ]
}