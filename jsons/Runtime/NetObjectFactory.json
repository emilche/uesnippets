      "signature": "GetProtocolId(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNetObjectCreationHeader*"
        }
      ],
      "returnType": "FReplicationProtocolIdentifier"
    },
    {
      "id": "get-net-factory-id",
      "name": "GetNetFactoryId",
      "category": "NetObjectFactory",
      "signature": "GetNetFactoryId(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNetObjectCreationHeader*"
        }
      ],
      "returnType": "FNetObjectFactoryId"
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "NetObjectFactory",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNetObjectCreationHeader*"
        }
      ],
      "returnType": "String",
      "docs": "Transform the header information into a readable format"
    },
    {
      "id": "post-instantiation",
      "name": "PostInstantiation",
      "category": "NetObjectFactory",
      "signature": "PostInstantiation(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "UNetObjectFactory*"
        },
        {
          "name": "Context",
          "type": "FPostInstantiationContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Optional callback triggered at the end of the instantiation process and before any replicated properties were applied.\nUseful to apply any additional data included with the header or to signal the new object to other systems.\n@param Context Gives you access to the new object and the header it was created from."
    },
    {
      "id": "post-init",
      "name": "PostInit",
      "category": "NetObjectFactory",
      "signature": "PostInit(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "UNetObjectFactory*"
        },
        {
          "name": "Context",
          "type": "FPostInitContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Optional callback triggered after we applied the initial replicated properties to the instantiated object.\nFrom here the remote object is ready to be used by the game engine.\n@param Context Gives you access to the new object."
    },
    {
      "id": "sub-object-created-from-replication",
      "name": "SubObjectCreatedFromReplication",
      "category": "NetObjectFactory",
      "signature": "SubObjectCreatedFromReplication(Target, Root Object, Sub Object Created)",
      "params": [
        {
          "name": "Target",
          "type": "UNetObjectFactory*"
        },
        {
          "name": "Root Object",
          "type": "UE::Net::FNetRefHandle"
        },
        {
          "name": "Sub Object Created",
          "type": "UE::Net::FNetRefHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Optional callback triggered when a root object managed by this factory gets assigned a dynamic subobject.\nThis callback is called on remotes only.\nAt the time of the callback the RootObject will have the latest replicated properties set, but the subobject will only be default constructed and won't be assigned the replicated properties received alongside the creation request.\n@param RootObject The root object that owns the subobject\n@param SubObjectCreated The subobject that was just instantiated"
    },
    {
      "id": "sub-object-destroyed-from-replication",
      "name": "SubObjectDestroyedFromReplication",
      "category": "NetObjectFactory",
      "signature": "SubObjectDestroyedFromReplication(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "UNetObjectFactory*"
        },
        {
          "name": "Context",
          "type": "FDestroyedContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Optional callback triggered when a subobject is about to destroyed for the owner root object managed by this factory.\nThis callback is called on remotes only.\n@param Context Gives access to the subobject about to be destroyed and the root object that owns him."
    },
    {
      "id": "is-root-object",
      "name": "IsRootObject",
      "category": "NetObjectFactory",
      "signature": "IsRootObject(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInstantiateContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tells if we instantiating a root object or a subobject."
    },
    {
      "id": "is-sub-object",
      "name": "IsSubObject",
      "category": "NetObjectFactory",
      "signature": "IsSubObject(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInstantiateContext*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}