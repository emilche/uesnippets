    {
      "id": "pre-register-new-object-reference-handle",
      "name": "PreRegisterNewObjectReferenceHandle",
      "category": "ObjectReplicationBridge",
      "signature": "PreRegisterNewObjectReferenceHandle(Target, Instance)",
      "params": [
        {
          "name": "Target",
          "type": "UObjectReplicationBridge*"
        },
        {
          "name": "Instance",
          "type": "UObject*"
        }
      ],
      "returnType": "UE::Net::FNetRefHandle",
      "docs": "Creates a NetRefHandle explicitly for object Instance and flags it as pre-registered in the ObjectReferenceCache.\nIf supported by an object factory, the pre-registered flag is meant to be serialized in a root object creation header\nand when a client receives a dynamic object header with this flag, it will look for an instance already registered by\nPreRegisterObjectWithReferenceHandle instead of creating a new instance of the object.\nMeant for use by the NetDriver's CreateNetIDForObject function.\n@see UNetDriver::CreateNetIDForObject, UObjectReplicationBridge::PreRegisterObjectWithReferenceHandle"
    },
    {
      "id": "pre-register-object-with-reference-handle",
      "name": "PreRegisterObjectWithReferenceHandle",
      "category": "ObjectReplicationBridge",
      "signature": "PreRegisterObjectWithReferenceHandle(Target, Instance, Handle)",
      "params": [
        {
          "name": "Target",
          "type": "UObjectReplicationBridge*"
        },
        {
          "name": "Instance",
          "type": "UObject*"
        },
        {
          "name": "Handle",
          "type": "FNetRefHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Directly assigns Handle to object Instance and flags it as pre-registered in the ObjectReferenceCache.\nIf supported by the object factory, clients receiving an object creation header with the pre-registered flag\nwill look for existing instances registered by this function instead of creating a new instance and\nuse the found instance for replication.\nMeant for use by the NetDriver's AssignNetIDToObject function.\n@see UNetDriver::AssignNetIDToObject, UObjectReplicationBridge::PreRegisterNewObjectReferenceHandle"
    },
