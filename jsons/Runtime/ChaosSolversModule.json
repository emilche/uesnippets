    {
      "id": "create-solver",
      "name": "CreateSolver",
      "category": "ChaosSolversModule",
      "signature": "CreateSolver(Target, In Owner, In Async Dt, Threading Mode, Debug Name)",
      "params": [
        {
          "name": "Target",
          "type": "FChaosSolversModule*"
        },
        {
          "name": "In Owner",
          "type": "UObject*"
        },
        {
          "name": "In Async Dt",
          "type": "Chaos::FReal"
        },
        {
          "name": "Threading Mode",
          "type": "Chaos::EThreadingMode",
          "default": "Chaos::EThreadingMode::SingleThread"
        },
        {
          "name": "Debug Name",
          "type": "Name&",
          "default": "NAME_None"
        }
      ],
      "returnType": "Chaos::FPBDRigidsSolver*",
      "docs": "Create a new solver state storage object to contain a solver and proxy storage object. Intended\nto be used by the physics scene to create a common storage object that can be passed to a dedicated\nthread when it is enabled without having to link Engine from Chaos.\nShould be called from the game thread to create a new solver. After creation, non-standalone solvers\nare dispatched to the physics thread automatically if it is available\n@param InOwner Ptr to some owning UObject. The module doesn't use this but allows calling code to organize solver ownership\n@param ThreadingMode The desired threading mode the solver will use\n@param bStandalone Whether the solver is standalone (not sent to physics thread - updating left to caller)"
    },
