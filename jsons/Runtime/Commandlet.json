    {
      "id": "parse-command-line-2b4785",
      "name": "ParseCommandLine",
      "category": "Commandlet",
      "signature": "ParseCommandLine(Cmd Line, Tokens, Switches)",
      "params": [
        {
          "name": "Cmd Line",
          "type": "TCHAR*"
        },
        {
          "name": "Tokens",
          "type": "TArray<FString>&"
        },
        {
          "name": "Switches",
          "type": "TArray<FString>&"
        }
      ],
      "returnType": "Void",
      "docs": "Parses a string into tokens, separating switches (beginning with - or /) from\nother parameters\n@param\tCmdLine\t\tthe string to parse\n@param\tTokens\t\t[out] filled with all parameters found in the string\n@param\tSwitches\t[out] filled with all switches found in the string\n@return\t@todo document"
    },
    {
      "id": "parse-command-line-167a49",
      "name": "ParseCommandLine",
      "category": "Commandlet",
      "signature": "ParseCommandLine(Cmd Line, Tokens, Switches, Params)",
      "params": [
        {
          "name": "Cmd Line",
          "type": "TCHAR*"
        },
        {
          "name": "Tokens",
          "type": "TArray<FString>&"
        },
        {
          "name": "Switches",
          "type": "TArray<FString>&"
        },
        {
          "name": "Params",
          "type": "TMap<FString,FString>&"
        }
      ],
      "returnType": "Void",
      "docs": "Parses a string into tokens, separating switches (beginning with - or /) from\nother parameters\n@param\tCmdLine\t\tthe string to parse\n@param\tTokens\t\t[out] filled with all parameters found in the string\n@param\tSwitches\t[out] filled with all switches found in the string\n@param\tParams\t\t[out] filled with all switches found in the string with the format key=value\n@return\t@todo document"
    },
    {
      "id": "create-custom-engine",
      "name": "CreateCustomEngine",
      "category": "Commandlet",
      "signature": "CreateCustomEngine(Target, Params)",
      "params": [
        {
          "name": "Target",
          "type": "UCommandlet*"
        },
        {
          "name": "Params",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Allows commandlets to override the default behavior and create a custom engine class for the commandlet. If\nthe commandlet implements this function, it should fully initialize the UEngine object as well.  Commandlets\nshould indicate that they have implemented this function by assigning the custom UEngine to GEngine."
    },
    {
      "id": "tick-engine",
      "name": "TickEngine",
      "category": "Commandlet",
      "signature": "TickEngine(Target, In World, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "UCommandlet*"
        },
        {
          "name": "In World",
          "type": "UWorld*",
          "default": "nullptr"
        },
        {
          "name": "In Delta Time",
          "type": "Double",
          "default": "0.0"
        }
      ],
      "returnType": "Void",
      "docs": "Simulate an engine frame tick.\nCan be used by commandlets to tick various subsystems. If running with -AllowCommandletRendering, this will\nalso tick rendering for the provided world scene(s)."
    },
