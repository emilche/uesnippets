    {
      "id": "activate-device-property",
      "name": "ActivateDeviceProperty",
      "category": "InputDeviceSubsystem",
      "signature": "ActivateDeviceProperty(Target, Property, Params)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Property",
          "type": "UInputDeviceProperty*"
        },
        {
          "name": "Params",
          "type": "FActivateDevicePropertyParams&"
        }
      ],
      "returnType": "FInputDevicePropertyHandle",
      "docs": "Starts tracking the given device property as an \"Active\" property. This means that the property will be evaluted and applied to its platform user\nNOTE: This does NOT make a new instance of the given property. If you pass in the same object before it is completely\nevaluated, then you see undesired effects."
    },
    {
      "id": "activate-device-property-of-class",
      "name": "ActivateDevicePropertyOfClass",
      "category": "Input Devices",
      "signature": "ActivateDevicePropertyOfClass(Target, Property Class, Params)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Property Class",
          "type": "TSubclassOf<UInputDeviceProperty>"
        },
        {
          "name": "Params",
          "type": "FActivateDevicePropertyParams&"
        }
      ],
      "returnType": "FInputDevicePropertyHandle",
      "docs": "Spawn a new instance of the given device property class and activate it."
    },
    {
      "id": "get-active-device-property",
      "name": "GetActiveDeviceProperty",
      "category": "Input Devices",
      "signature": "GetActiveDeviceProperty(Target, Handle)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Handle",
          "type": "FInputDevicePropertyHandle"
        }
      ],
      "returnType": "UInputDeviceProperty*",
      "docs": "Returns a pointer to the active input device property with the given handle. Returns null if the property doesn't exist"
    },
    {
      "id": "is-property-active",
      "name": "IsPropertyActive",
      "category": "Input Devices",
      "signature": "IsPropertyActive(Target, Handle)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Handle",
          "type": "FInputDevicePropertyHandle"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the property associated with the given handle is currently active, and it is not pending removal"
    },
    {
      "id": "remove-device-property-by-handle",
      "name": "RemoveDevicePropertyByHandle",
      "category": "Input Devices",
      "signature": "RemoveDevicePropertyByHandle(Target, Handle To Remove)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Handle To Remove",
          "type": "FInputDevicePropertyHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a single device property based on it's handle\n@param FInputDevicePropertyHandle\t\tDevice property handle to be removed\n@return\t\t\t\t\t\t\t\tThe number of removed device properties."
    },
    {
      "id": "remove-device-property-handles",
      "name": "RemoveDevicePropertyHandles",
      "category": "Input Devices",
      "signature": "RemoveDevicePropertyHandles(Target, Handles To Remove)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Handles To Remove",
          "type": "TSet<FInputDevicePropertyHandle>&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a set of device properties based on their handles.\n@param HandlesToRemove\tThe set of device property handles to remove\n@return\t\t\t\t\tThe number of removed device properties"
    },
    {
      "id": "remove-all-device-properties",
      "name": "RemoveAllDeviceProperties",
      "category": "Input Devices",
      "signature": "RemoveAllDeviceProperties(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes all the current Input Device Properties that are active, regardless of the Platform User"
    },
    {
      "id": "get-most-recently-used-hardware-device",
      "name": "GetMostRecentlyUsedHardwareDevice",
      "category": "Input Devices",
      "signature": "GetMostRecentlyUsedHardwareDevice(Target, In User Id)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "In User Id",
          "type": "FPlatformUserId"
        }
      ],
      "returnType": "FHardwareDeviceIdentifier",
      "docs": "Gets the most recently used hardware input device for the given platform user"
    },
    {
      "id": "get-most-recently-used-input-device-id",
      "name": "GetMostRecentlyUsedInputDeviceId",
      "category": "Input Devices",
      "signature": "GetMostRecentlyUsedInputDeviceId(Target, In User Id, Of Type)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "In User Id",
          "type": "FPlatformUserId"
        },
        {
          "name": "Of Type",
          "type": "EHardwareDevicePrimaryType",
          "default": "EHardwareDevicePrimaryType::Unspecified"
        }
      ],
      "returnType": "FInputDeviceId",
      "docs": "Returns the most recently used FInputDeviceId for the given platform user id.\nThis will be INPUTDEVICEID_NONE if there is no known device for the given user.\n@param InUserId\tThe platform user to find the most recent device for\n@param OfType\tThe type of input device to filter by. If unspecified, then the latest device regardless of its type will be returned."
    },
    {
      "id": "get-input-device-hardware-identifier",
      "name": "GetInputDeviceHardwareIdentifier",
      "category": "Input Devices",
      "signature": "GetInputDeviceHardwareIdentifier(Target, Input Device)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "Input Device",
          "type": "FInputDeviceId"
        }
      ],
      "returnType": "FHardwareDeviceIdentifier"
    },
    {
      "id": "get-latest-device-of-type",
      "name": "GetLatestDeviceOfType",
      "category": "InputDeviceSubsystem",
      "signature": "GetLatestDeviceOfType(Target, In User Id, Of Type)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "In User Id",
          "type": "FPlatformUserId"
        },
        {
          "name": "Of Type",
          "type": "EHardwareDevicePrimaryType"
        }
      ],
      "returnType": "FInputDeviceId",
      "docs": "Returns the latest used input device for a specific type of hardware"
    },
    {
      "id": "set-most-recently-used-hardware-device",
      "name": "SetMostRecentlyUsedHardwareDevice",
      "category": "InputDeviceSubsystem",
      "signature": "SetMostRecentlyUsedHardwareDevice(Target, In Device Id, In Hardware Id)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceSubsystem*"
        },
        {
          "name": "In Device Id",
          "type": "FInputDeviceId"
        },
        {
          "name": "In Hardware Id",
          "type": "FHardwareDeviceIdentifier&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the most recently used hardware device from the input processor"
    }
  ]
