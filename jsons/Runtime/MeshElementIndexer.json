{
  "id": "mesh-element-indexer",
  "label": "MeshElementIndexer",
  "includepath": "MeshElementIndexer.h",
  "includes": [
    "Array",
    "ArrayView",
    "ContainerAllocationPolicies",
    "Set",
    "CoreMinimal",
    "UnrealMemory",
    "UnrealMathSSE",
    "MeshAttributeArray",
    "AssertionMacros",
    "EnableIf",
    "UnrealTypeTraits",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "set",
      "name": "Set",
      "category": "MeshElementIndexer",
      "signature": "Set(Target, Key, Referencer, Attribute Name, Referencer Channel Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "Key",
          "type": "FMeshElementChannels*"
        },
        {
          "name": "Referencer",
          "type": "FMeshElementChannels*"
        },
        {
          "name": "Attribute Name",
          "type": "Name"
        },
        {
          "name": "Referencer Channel Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Set the parameters of this mesh element indexer"
    },
    {
      "id": "set-initial-num-references",
      "name": "SetInitialNumReferences",
      "category": "MeshElementIndexer",
      "signature": "SetInitialNumReferences(Target, In Initial Size)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "In Initial Size",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the initial/expected number of references per key"
    },
    {
      "id": "set-chunk-size",
      "name": "SetChunkSize",
      "category": "MeshElementIndexer",
      "signature": "SetChunkSize(Target, In Chunk Size)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "In Chunk Size",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the chunk size for the indexer, for optimization purposes.\nThe default chunk size is 256."
    },
    {
      "id": "set-unchunked",
      "name": "SetUnchunked",
      "category": "MeshElementIndexer",
      "signature": "SetUnchunked(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Configures the indexer not to use chunks.\nThis is desirable if there are very few keys with a lot of references, e.g. polygon groups to polygons"
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "MeshElementIndexer",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets the indexer"
    },
    {
      "id": "find",
      "name": "Find",
      "category": "MeshElementIndexer",
      "signature": "Find(Target, Key Index, Key Channel Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "Key Index",
          "type": "Int"
        },
        {
          "name": "Key Channel Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "TArrayView<int32>",
      "docs": "Retrieve all referencer indices whose named attribute refers to KeyIndex.\nNon-const because finding a stale index might cause a rebuild."
    },
    {
      "id": "remove-key",
      "name": "RemoveKey",
      "category": "MeshElementIndexer",
      "signature": "RemoveKey(Target, Key Index, Key Channel Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "Key Index",
          "type": "Int"
        },
        {
          "name": "Key Channel Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the specified key from the indexer"
    },
    {
      "id": "remove-reference-from-key",
      "name": "RemoveReferenceFromKey",
      "category": "MeshElementIndexer",
      "signature": "RemoveReferenceFromKey(Target, Key Index, Reference Index, Key Channel Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "Key Index",
          "type": "Int"
        },
        {
          "name": "Reference Index",
          "type": "Int"
        },
        {
          "name": "Key Channel Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Remove reference from key.\nThis will take immediate effect."
    },
    {
      "id": "add-reference-to-key",
      "name": "AddReferenceToKey",
      "category": "MeshElementIndexer",
      "signature": "AddReferenceToKey(Target, Key Index, Reference Index, Key Channel Index)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        },
        {
          "name": "Key Index",
          "type": "Int"
        },
        {
          "name": "Reference Index",
          "type": "Int"
        },
        {
          "name": "Key Channel Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Add a reference to a key.\nThis will be queued and take effect in batch when an affected key is looked up.\nThis is preferable to regenerating the index entirely."
    },
    {
      "id": "suspend",
      "name": "Suspend",
      "category": "MeshElementIndexer",
      "signature": "Suspend(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Suspend indexing until the next rebuild"
    },
    {
      "id": "resume",
      "name": "Resume",
      "category": "MeshElementIndexer",
      "signature": "Resume(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Resume indexing and mark indexer as stale, but do not force an immediate rebuild"
    },
    {
      "id": "force-rebuild",
      "name": "ForceRebuild",
      "category": "MeshElementIndexer",
      "signature": "ForceRebuild(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Force the indexer to be completely rebuilt."
    },
    {
      "id": "build",
      "name": "Build",
      "category": "MeshElementIndexer",
      "signature": "Build(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshElementIndexer*"
        }
      ],
      "returnType": "Void",
      "docs": "Build any stale indices"
    },
    {
      "id": "get",
      "name": "Get",
      "category": "MeshElementIndexer",
      "signature": "Get(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FChunk*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "TArrayView<int32>",
      "docs": "Get the range of data corresponding to this element"
    }
  ]
}