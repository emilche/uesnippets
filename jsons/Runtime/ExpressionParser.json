{
  "id": "expression-parser",
  "label": "ExpressionParser",
  "includepath": "Misc/ExpressionParser.h",
  "includes": [
    "Array",
    "CoreTypes",
    "PlatformCrt",
    "ExpressionParserTypes",
    "ValueOrError"
  ],
  "functions": [
    {
      "id": "lex",
      "name": "Lex",
      "category": "ExpressionParser",
      "signature": "Lex<CharType>(In Expression, Token Definitions)",
      "params": [
        {
          "name": "In Expression",
          "type": "CharType*"
        },
        {
          "name": "Token Definitions",
          "type": "TTokenDefinitions<CharType>&"
        }
      ],
      "returnType": "template<CharType> TLexResultType<CharType>",
      "docs": "An expression parser, responsible for lexing, compiling, and evaluating expressions.\nThe parser supports 3 functions:\n1. Lexing the expression into a set of user defined tokens,\n2. Compiling the tokenized expression to an efficient reverse-polish execution order,\n3. Evaluating the compiled tokens\nSee ExpressionParserExamples.cpp for example usage."
    },
    {
      "id": "compile-9c1330",
      "name": "Compile",
      "category": "ExpressionParser",
      "signature": "Compile<CharType>(In Expression, Token Definitions, In Grammar)",
      "params": [
        {
          "name": "In Expression",
          "type": "CharType*"
        },
        {
          "name": "Token Definitions",
          "type": "TTokenDefinitions<CharType>&"
        },
        {
          "name": "In Grammar",
          "type": "FExpressionGrammar&"
        }
      ],
      "returnType": "template<CharType> TCompileResultType<CharType>",
      "docs": "Compile the specified expression into an array of Reverse-Polish order nodes for evaluation, according to our grammar definition"
    },
    {
      "id": "compile-3dcb85",
      "name": "Compile",
      "category": "ExpressionParser",
      "signature": "Compile<CharType>(In Tokens, In Grammar)",
      "params": [
        {
          "name": "In Tokens",
          "type": "TArray<TExpressionToken<CharType>>"
        },
        {
          "name": "In Grammar",
          "type": "FExpressionGrammar&"
        }
      ],
      "returnType": "template<CharType> TCompileResultType<CharType>",
      "docs": "Compile the specified tokens into an array of Reverse-Polish order nodes for evaluation, according to our grammar definition"
    },
    {
      "id": "evaluate-efd5e3",
      "name": "Evaluate",
      "category": "ExpressionParser",
      "signature": "Evaluate<CharType>(In Expression, In Token Definitions, In Grammar, In Environment)",
      "params": [
        {
          "name": "In Expression",
          "type": "CharType*"
        },
        {
          "name": "In Token Definitions",
          "type": "TTokenDefinitions<CharType>&"
        },
        {
          "name": "In Grammar",
          "type": "FExpressionGrammar&"
        },
        {
          "name": "In Environment",
          "type": "TIOperatorEvaluationEnvironment<CharType>&"
        }
      ],
      "returnType": "template<CharType> FExpressionResult",
      "docs": "Evaluate the specified expression using the specified token definitions, grammar definition, and evaluation environment"
    },
    {
      "id": "evaluate-6dba4d",
      "name": "Evaluate",
      "category": "ExpressionParser",
      "signature": "Evaluate<CharType>(Compiled Tokens, In Environment)",
      "params": [
        {
          "name": "Compiled Tokens",
          "type": "TArray<TCompiledToken<CharType>>&"
        },
        {
          "name": "In Environment",
          "type": "TIOperatorEvaluationEnvironment<CharType>&"
        }
      ],
      "returnType": "template<CharType> FExpressionResult",
      "docs": "Evaluate the specified pre-compiled tokens using an evaluation environment"
    },
    {
      "id": "evaluate-42cac1",
      "name": "Evaluate",
      "category": "ExpressionParser",
      "signature": "Evaluate<CharType, ContextType>(In Expression, In Token Definitions, In Grammar, In Jump Table, In Context)",
      "params": [
        {
          "name": "In Expression",
          "type": "CharType*"
        },
        {
          "name": "In Token Definitions",
          "type": "TTokenDefinitions<CharType>&"
        },
        {
          "name": "In Grammar",
          "type": "FExpressionGrammar&"
        },
        {
          "name": "In Jump Table",
          "type": "TOperatorJumpTable<ContextType>&"
        },
        {
          "name": "In Context",
          "type": "ContextType*",
