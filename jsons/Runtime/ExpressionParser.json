        {
          "name": "Compiled Tokens",
          "type": "TArray<FCompiledToken>&"
        },
        {
          "name": "In Jump Table",
          "type": "TOperatorJumpTable<ContextType>&"
        },
        {
          "name": "In Context",
          "type": "ContextType*",
          "default": "nullptr"
        }
      ],
      "returnType": "template<ContextType> FExpressionResult"
