    {
      "id": "remove-and-copy-weightmap-allocation-layer-blend",
      "name": "RemoveAndCopyWeightmapAllocationLayerBlend",
      "category": "LandscapeEditLayer",
      "signature": "RemoveAndCopyWeightmapAllocationLayerBlend(Target, In Key, Out Value, In Modify)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeEditLayerBase*"
        },
        {
          "name": "In Key",
          "type": "TObjectPtr<ULandscapeLayerInfoObject>"
        },
        {
          "name": "Out Value",
          "type": "Bool&"
        },
        {
          "name": "In Modify",
          "type": "Bool"
        }
      ],
      "returnType": "UE_INTERNAL bool",
      "docs": "Remove and Copy a weightmap layer allocation for a given LayerInfoObj\n@param InKey : the ULandscapeLayerInfoObj key to be removed\n@param bOutValue: the layer allocation value stored in the map for InKey\n@param bInModify : true when Modify() needs to be called\nMarked as UE_INTERNAL to prevent external usage before blend refactor with the introduction of blend groups and premultiplied alpha blending"
    },
    {
      "id": "add-or-update-weightmap-allocation-layer-blend",
      "name": "AddOrUpdateWeightmapAllocationLayerBlend",
      "category": "LandscapeEditLayer",
      "signature": "AddOrUpdateWeightmapAllocationLayerBlend(Target, In Key, In Value, In Modify)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeEditLayerBase*"
        },
        {
          "name": "In Key",
          "type": "TObjectPtr<ULandscapeLayerInfoObject>"
        },
        {
          "name": "In Value",
          "type": "Bool"
        },
        {
          "name": "In Modify",
          "type": "Bool"
        }
      ],
      "returnType": "UE_INTERNAL void",
      "docs": "Updates the value of an existing layer allocation or adds a weightmap layer allocation if no entry is found\n@param InKey : the ULandscapeLayerInfoObj map key\n@param bInValue: the new allocation value\n@param bInModify : true when Modify() needs to be called\nMarked as UE_INTERNAL to prevent external usage before blend refactor with the introduction of blend groups and premultiplied alpha blending"
    },
    {
      "id": "get-weightmap-layer-allocation-blend",
      "name": "GetWeightmapLayerAllocationBlend",
      "category": "LandscapeEditLayer",
      "signature": "GetWeightmapLayerAllocationBlend(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeEditLayerBase*"
        }
      ],
      "returnType": "UE_INTERNAL TMap<TObjectPtr<ULandscapeLayerInfoObject>,bool>&",
      "docs": "@return the layer's weightmap layer allocation blend map. Layers do not have an entry in the map until a user sets the blend mode (selects Subtractive)\nMarked as UE_INTERNAL to prevent external usage before blend refactor with the introduction of blend groups and premultiplied alpha blending"
    },
    {
      "id": "set-weightmap-layer-allocation-blend",
