        },
        {
          "name": "In Modify",
          "type": "Bool"
        }
      ],
      "returnType": "UE_INTERNAL bool",
      "docs": "Remove and Copy a weightmap layer allocation for a given LayerInfoObj\n@param InKey : the ULandscapeLayerInfoObj key to be removed\n@param bOutValue: the layer allocation value stored in the map for InKey\n@param bInModify : true when Modify() needs to be called\nMarked as UE_INTERNAL to prevent external usage before blend refactor with the introduction of blend groups and premultiplied alpha blending"
    },
