    {
      "id": "set-a51fc4",
      "name": "Set",
      "category": "AnimationAsset",
      "signature": "Set(Target, In Previous, In Delta)",
      "params": [
        {
          "name": "Target",
          "type": "FDeltaTimeRecord*"
        },
        {
          "name": "In Previous",
          "type": "Float"
        },
        {
          "name": "In Delta",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Used when sampling a given animation asset, this structure will contain the previous frame's\ninternal sample time alongside the 'effective' delta time leading into the current frame.\nAn 'effective' delta time represents a value that has undergone all side effects present in the\ncorresponding asset's TickAssetPlayer call including but not limited to syncing, play rate\nadjustment, looping, etc.\nFor montages Delta isn't always abs(CurrentPosition-PreviousPosition) because a Montage can jump or repeat or loop"
    },
