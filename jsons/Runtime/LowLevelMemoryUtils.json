    {
      "id": "topological-sort-root-to-leaf",
      "name": "TopologicalSortRootToLeaf",
      "category": "LowLevelMemoryUtils",
      "signature": "TopologicalSortRootToLeaf<RangeType, GetEdgesType>(Range, Get Edges)",
      "params": [
        {
          "name": "Range",
          "type": "RangeType&&"
        },
        {
          "name": "Get Edges",
          "type": "GetEdgesType"
        }
      ],
      "returnType": "template<RangeType,GetEdgesType> void",
      "docs": "Sort a range of vertices topologically from root to leaf by the directed edges given by GetEdges.\nVertices in cycles will be sorted in an arbitrary order relative to each other.\nThe sort is stable.\n@param Range\t\t\tThe range of vertices to sort.\n@param GetEdges\t\tA callable GetEdges(SizeType InVertex, SizeType* OutEdgeBuffer, Sizetype& OutNumEdges) that provides the indexes into VertexData of the edges for InVertex.\nEdges should be written into OutEdgeBuffer; this buffer only has room for GetNum(Range) elements.\nInVertex is the index in Range of the vertex.\nOutEdgeBuffer should be populated with the indexes in Range of the target vertices."
    },
    {
      "id": "topological-sort-leaf-to-root",
      "name": "TopologicalSortLeafToRoot",
      "category": "LowLevelMemoryUtils",
      "signature": "TopologicalSortLeafToRoot<RangeType, GetEdgesType>(Range, Get Edges)",
      "params": [
        {
          "name": "Range",
          "type": "RangeType&&"
        },
        {
          "name": "Get Edges",
          "type": "GetEdgesType"
        }
      ],
      "returnType": "template<RangeType,GetEdgesType> void",
      "docs": "Sort a range of vertices topologically from leaf to root by the directed edges given by GetEdges.\nVertices in cycles will be sorted in an arbitrary order relative to each other.\nThe sort is stable.\n@param Range\t\t\tThe range of vertices to sort.\n@param GetEdges\t\tA callable GetEdges(SizeType InVertex, SizeType* OutEdgeBuffer, Sizetype& OutNumEdges) that provides the indexes into VertexData of the edges for InVertex.\nEdges should be written into OutEdgeBuffer; this buffer only has room for GetNum(Range) elements.\nInVertex is the index in Range of the vertex.\nOutEdgeBuffer should be populated with the indexes in Range of the target vertices."
    },
    {
      "id": "topological-sort",
      "name": "TopologicalSort",
      "category": "LowLevelMemoryUtils",
      "signature": "TopologicalSort<T, GetEdgesType, SizeType>(Vertex Data, Num Vertices, Get Edges, Sort Order)",
      "params": [
        {
          "name": "Vertex Data",
          "type": "T*"
        },
        {
          "name": "Num Vertices",
          "type": "SizeType"
        },
        {
          "name": "Get Edges",
          "type": "GetEdgesType"
        },
        {
          "name": "Sort Order",
          "type": "ETopologicalSortOrder"
        }
      ],
      "returnType": "template<T,GetEdgesType,SizeType> void",
      "docs": "Sort an array of vertices topologically by the directed edges given by GetEdges.\nVertices in cycles will be sorted in an arbitrary order relative to each other.\nThe sort is stable.\n@param VertexData\tPointer to the vertices to sort.\n@param NumVertices\tNumber of vertices.\n@param GetEdges\t\tA callable GetEdges(SizeType InVertex, SizeType* OutEdgeBuffer, Sizetype& OutNumEdges) that provides the indexes into VertexData of the edges for InVertex.\nEdges should be written into OutEdgeBuffer; this buffer only has room for NumVertices elements.\nInVertex is the index in Range of the vertex.\nOutEdgeBuffer should be populated with the indexes in Range of the target vertices.\n@param SortOrder\t\tWhether to order the in/out VertexData by sources before targets (RootToLeaf) or targets before sources (LeafToRoot)."
    }
  ]
}