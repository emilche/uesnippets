        {
          "name": "Merge Duplicate Sections",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Merging duplicate sections will make the resulting memory image smaller.\nThis will only work for data that is expected to be read-only after freezing.  Merging sections will break any manual fix-ups applied to the frozen data"
    },
    {
      "id": "move-to-empty",
