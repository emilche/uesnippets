    {
      "id": "enable-game-window-settings-override",
      "name": "EnableGameWindowSettingsOverride",
      "category": "GameEngine",
      "signature": "EnableGameWindowSettingsOverride(Enabled)",
      "params": [
        {
          "name": "Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enables/disables game window resolution setting overrides specified on the command line (true by default)\n@note Does not trigger a refresh of the game window based on the newly effective settings\n@note Not thread-safe; must be called from the main thread"
    },
    {
      "id": "conditionally-override-settings",
      "name": "ConditionallyOverrideSettings",
      "category": "GameEngine",
      "signature": "ConditionallyOverrideSettings(Resolution X, Resolution Y, Window Mode)",
      "params": [
        {
          "name": "Resolution X",
          "type": "Int&"
        },
        {
          "name": "Resolution Y",
          "type": "Int&"
        },
        {
          "name": "Window Mode",
          "type": "EWindowMode::Type&"
        }
      ],
      "returnType": "Void",
      "docs": "Modifies the game window resolution settings if any overrides have been specified on the command line\nand overrides are enabled (see EnableGameWindowSettingsOverride)\n@param ResolutionX\t[in/out] Width of the game window, in pixels\n@param ResolutionY\t[in/out] Height of the game window, in pixels\n@param WindowMode\t[in/out] What window mode the game should be in"
    },
    {
      "id": "determine-game-window-resolution",
      "name": "DetermineGameWindowResolution",
      "category": "GameEngine",
      "signature": "DetermineGameWindowResolution(Resolution X, Resolution Y, Window Mode, Use Work Area For Windowed)",
      "params": [
        {
          "name": "Resolution X",
          "type": "Int&"
        },
        {
          "name": "Resolution Y",
          "type": "Int&"
        },
        {
          "name": "Window Mode",
          "type": "EWindowMode::Type&"
        },
        {
          "name": "Use Work Area For Windowed",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Determines the resolution of the game window, ensuring that the requested size is never bigger than the available desktop size\n@param ResolutionX\t[in/out] Width of the game window, in pixels\n@param ResolutionY\t[in/out] Height of the game window, in pixels\n@param WindowMode\t[in/out] What window mode the game should be in\n@param bUseWorkArea\t[in] Should we find a resolution that fits within the desktop work area for the windowed mode instead of monitor's full resolution"
    },
    {
