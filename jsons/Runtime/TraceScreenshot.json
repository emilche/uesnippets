{
  "id": "trace-screenshot",
  "label": "TraceScreenshot",
  "includepath": "ProfilingDebugging/TraceScreenshot.h",
  "includes": [
    "CoreMinimal",
    "World"
  ],
  "functions": [
    {
      "id": "request-screenshot",
      "name": "RequestScreenshot",
      "category": "TraceScreenshot",
      "signature": "RequestScreenshot(Name, Show UI, Log Category)",
      "params": [
        {
          "name": "Name",
          "type": "String"
        },
        {
          "name": "Show UI",
          "type": "Bool"
        },
        {
          "name": "Log Category",
          "type": "FLogCategoryAlias&",
          "default": "LogCore"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "trace-screenshot",
      "name": "TraceScreenshot",
      "category": "TraceScreenshot",
      "signature": "TraceScreenshot(In Size X, In Size Y, In Image Data, In Screenshot Name, Desired X)",
      "params": [
        {
          "name": "In Size X",
          "type": "Int"
        },
        {
          "name": "In Size Y",
          "type": "Int"
        },
        {
          "name": "In Image Data",
          "type": "TArray<FColor>&"
        },
        {
          "name": "In Screenshot Name",
          "type": "String&"
        },
        {
          "name": "Desired X",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "Void",
      "docs": "Add the provided screenshot to the trace.\n@param InSizeX - The width of the screenshot.\n@param InSizeY - The heigth of the screenshot.\n@param InImageData - The data of the screenshot.\n@param InScreenshotName - The name of the screenshot.\n@param DesiredX - Optionally resize the image to the desired width before tracing. Aspect ratio is preserved."
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "TraceScreenshot",
      "signature": "Reset()",
      "params": [],
      "returnType": "Void",
      "docs": "Reset the internal state of the TraceScreenshot system."
    }
  ]
}