      "signature": "DumpToConsole(Target, Verbose)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "Verbose",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Output debugging information to the console."
    },
    {
      "id": "save-debug-image",
      "name": "SaveDebugImage",
      "category": "VirtualTextureAllocator",
      "signature": "SaveDebugImage(Target, Image Name)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "Image Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Void"
    }
