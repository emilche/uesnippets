{
  "id": "virtual-texture-allocator",
  "label": "VirtualTextureAllocator",
  "includepath": "VirtualTextureAllocator.h",
  "includes": [
    "CoreMinimal",
    "HashTable",
    "VirtualTextureShared"
  ],
  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "VirtualTextureAllocator",
      "signature": "Initialize(Target, Max Size)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "Max Size",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Initialise the allocator"
    },
    {
      "id": "find",
      "name": "Find",
      "category": "VirtualTextureAllocator",
      "signature": "Find(Target, V Address, Out Local V Address)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "V Address",
          "type": "UInt"
        },
        {
          "name": "Out Local V Address",
          "type": "UInt&"
        }
      ],
      "returnType": "FAllocatedVirtualTexture*",
      "docs": "Translate a virtual page address in the address space to a local page address within a virtual texture.\n@return nullptr If there is no virtual texture allocated at this address."
    },
    {
      "id": "alloc",
      "name": "Alloc",
      "category": "VirtualTextureAllocator",
      "signature": "Alloc(Target, VT)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "VT",
          "type": "FAllocatedVirtualTexture*"
        }
      ],
      "returnType": "UInt",
      "docs": "Allocate address space for the virtual texture.\n@return (~0) if no space left, the virtual page address if successfully allocated."
    },
    {
      "id": "try-alloc",
      "name": "TryAlloc",
      "category": "VirtualTextureAllocator",
      "signature": "TryAlloc(Target, In Size)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "In Size",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Test if an allocation of the given size will succeed.\n@return false if there isn't enough space left."
    },
    {
      "id": "free",
      "name": "Free",
      "category": "VirtualTextureAllocator",
      "signature": "Free(Target, VT)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualTextureAllocator*"
        },
        {
          "name": "VT",
          "type": "FAllocatedVirtualTexture*"
        }
      ],
      "returnType": "Void",
      "docs": "Free the virtual texture."
    },
    {
      "id": "dump-to-console",
      "name": "DumpToConsole",
