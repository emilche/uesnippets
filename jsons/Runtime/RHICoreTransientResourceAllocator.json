    {
      "id": "create-default",
      "name": "CreateDefault",
      "category": "RHICoreTransientResourceAllocator",
      "signature": "CreateDefault()",
      "params": [],
      "returnType": "FInitializer",
      "docs": "The RHI transient heap system is a base class for the platform implementation. It has a persistent lifetime\nand contains a cache of transient heaps. The transient allocator acquires heaps from the system and forfeits them\nat the end of its lifetime. Garbage collection of heaps is done using an internal counter that increments with\neach GarbageCollect call. This should be done periodically. Heaps older than a platform-specified fence latency\nare destroyed. Additionally, statistics are gathered automatically and reported to the 'rhitransientmemory' stats\ngroup."
    },
