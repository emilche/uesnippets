    {
      "id": "get-entry-to-write",
      "name": "GetEntryToWrite",
      "category": "VisualLogger",
      "signature": "GetEntryToWrite(Log Owner, Log Category)",
      "params": [
        {
          "name": "Log Owner",
          "type": "UObject*"
        },
        {
          "name": "Log Category",
          "type": "FLogCategoryBase&"
        }
      ],
      "returnType": "nodiscard ] ] FVisualLogEntry*",
      "docs": "Returns  the current (or new) entry for the given object; alternatively nullptr if we aren't allowed to vlog with the given parameters.\n@param LogOwner - The UObject (typically an AActor) we are going to write log entries about.  This becomes the row in the Visual Logger timeline.\n@param LogCategory - The LogCategory we are logging about.  This function will only return a valid log entry if the visual logging is enabled for the category."
    },
    {
      "id": "get-last-entry-for-object",
      "name": "GetLastEntryForObject",
      "category": "VisualLogger",
      "signature": "GetLastEntryForObject(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "FVisualLogger*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        }
      ],
      "returnType": "FVisualLogEntry*",
      "docs": "Retrieves last used entry for given UObject\n@note this function can return null"
    },
    {
      "id": "execute-on-last-entry-for-object",
      "name": "ExecuteOnLastEntryForObject",
      "category": "VisualLogger",
      "signature": "ExecuteOnLastEntryForObject(Target, Object, Function)",
      "params": [
        {
          "name": "Target",
          "type": "FVisualLogger*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Function",
          "type": "TFunctionRef<void ( FVisualLogEntry& )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Executes the provided function using the last used entry for given UObject if any.\nMethod provides validation for thread safe access when adding information to an existing LogEntry.\n@param Object The object to find a LogEntry for.\n@param Function Function to execute if a valid view can be created.\n@return Whether a LogEntry was found and the function was called"
    },
