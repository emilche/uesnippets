      "id": "build-actor-texture-streaming-data",
      "name": "BuildActorTextureStreamingData",
      "category": "TextureStreamingTypes",
      "signature": "BuildActorTextureStreamingData(In Actor, In Quality Level, In Feature Level)",
      "params": [
