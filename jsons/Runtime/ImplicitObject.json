    {
      "id": "find-most-opposing-face",
      "name": "FindMostOpposingFace",
      "category": "ImplicitObject",
      "signature": "FindMostOpposingFace(Target, Position, Unit Dir, Hint Face Index, Search Dist)",
      "params": [
        {
          "name": "Target",
          "type": "FImplicitObject*"
        },
        {
          "name": "Position",
          "type": "FVec3&"
        },
        {
          "name": "Unit Dir",
          "type": "FVec3&"
        },
        {
          "name": "Hint Face Index",
          "type": "Int"
        },
        {
          "name": "Search Dist",
          "type": "FReal"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the most opposing face.\n@param Position - local position to search around (for example an edge of a convex hull)\n@param UnitDir - the direction we want to oppose (for example a ray moving into the edge of a convex hull would get the face with the most negative dot(FaceNormal, UnitDir)\n@param HintFaceIndex - for certain geometry we can use this to accelerate the search.\n@return Index of the most opposing face"
    },
    {
      "id": "find-most-opposing-face-scaled",
      "name": "FindMostOpposingFaceScaled",
      "category": "ImplicitObject",
      "signature": "FindMostOpposingFaceScaled(Target, Position, Unit Dir, Hint Face Index, Search Dist, Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FImplicitObject*"
        },
        {
          "name": "Position",
          "type": "FVec3&"
        },
        {
          "name": "Unit Dir",
          "type": "FVec3&"
        },
        {
          "name": "Hint Face Index",
