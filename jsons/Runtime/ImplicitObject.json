          "type": "FReal"
        },
        {
          "name": "Scale",
          "type": "FVec3&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "find-closest-face-and-vertices",
      "name": "FindClosestFaceAndVertices",
      "category": "ImplicitObject",
      "signature": "FindClosestFaceAndVertices(Target, Position, Face Vertices, Search Dist)",
      "params": [
        {
          "name": "Target",
          "type": "FImplicitObject*"
        },
        {
          "name": "Position",
          "type": "FVec3&"
        },
        {
          "name": "Face Vertices",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Search Dist",
          "type": "FReal",
          "default": "0.01f"
        }
      ],
      "returnType": "Int",
      "docs": "Finds the first intersecting face at given position\n@param Position - local position to search around (for example a point on the surface of a convex hull)\n@param FaceIndices - Vertices that lie on the face plane.\n@param SearchDistance - distance to surface [def:0.01]"
    },
    {
      "id": "find-geometry-opposing-normal",
      "name": "FindGeometryOpposingNormal",
      "category": "ImplicitObject",
      "signature": "FindGeometryOpposingNormal(Target, Denorm Dir, Face Index, Original Normal)",
      "params": [
        {
          "name": "Target",
          "type": "FImplicitObject*"
        },
        {
          "name": "Denorm Dir",
          "type": "FVec3&"
        },
        {
          "name": "Face Index",
          "type": "Int"
        },
        {
          "name": "Original Normal",
          "type": "FVec3&"
        }
      ],
      "returnType": "FVec3",
      "docs": "Given a normal and a face index, compute the most opposing normal associated with the underlying geometry features.\nFor example a sphere swept against a box may not give a normal associated with one of the box faces. This function will return a normal associated with one of the faces.\n@param DenormDir - the direction we want to oppose\n@param FaceIndex - the face index associated with the geometry (for example if we hit a specific face of a convex hull)\n@param OriginalNormal - the original normal given by something like a sphere sweep\n@return The most opposing normal associated with the underlying geometry's feature (like a face)"
    },
