{
  "id": "sin-osc",
  "label": "SinOsc",
  "includepath": "DSP/SinOsc.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "init",
      "name": "Init",
      "category": "SinOsc",
      "signature": "Init(Target, In Sample Rate, In Frequency Hz, Scale, Add)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        },
        {
          "name": "In Sample Rate",
          "type": "Int"
        },
        {
          "name": "In Frequency Hz",
          "type": "Float"
        },
        {
          "name": "Scale",
          "type": "Float",
          "default": "1.0f"
        },
        {
          "name": "Add",
          "type": "Float",
          "default": "0.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize the oscillator with a sample rate and new frequency. Must be called before playing oscillator."
    },
    {
      "id": "set-scale",
      "name": "SetScale",
      "category": "SinOsc",
      "signature": "SetScale(Target, In Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        },
        {
          "name": "In Scale",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the scale of the oscillator."
    },
    {
      "id": "set-add",
      "name": "SetAdd",
      "category": "SinOsc",
      "signature": "SetAdd(Target, In Add)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        },
        {
          "name": "In Add",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the scale of the oscillator."
    },
    {
      "id": "set-frequency",
      "name": "SetFrequency",
      "category": "SinOsc",
      "signature": "SetFrequency(Target, In Frequency Hz)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        },
        {
          "name": "In Frequency Hz",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the frequency of the oscillator in Hz (based on sample rate). Performs initial condition calculation to avoid pops."
    },
    {
      "id": "get-frequency",
      "name": "GetFrequency",
      "category": "SinOsc",
      "signature": "GetFrequency(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        }
      ],
      "returnType": "Float",
      "docs": "Returns the current frequency."
    },
    {
      "id": "process-audio",
      "name": "ProcessAudio",
      "category": "SinOsc",
      "signature": "ProcessAudio(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSineOsc*"
        }
      ],
      "returnType": "Float",
      "docs": "Generates the next sample of the oscillator."
    }
  ]
}