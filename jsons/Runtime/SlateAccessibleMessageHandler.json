{
  "id": "slate-accessible-message-handler",
  "label": "SlateAccessibleMessageHandler",
  "includepath": "Widgets/Accessibility/SlateAccessibleMessageHandler.h",
  "includes": [
    "GenericAccessibleInterfaces",
    "Variant"
  ],
  "functions": [
    {
      "id": "on-activate",
      "name": "OnActivate",
      "category": "SlateAccessibleMessageHandler",
      "signature": "OnActivate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-deactivate",
      "name": "OnDeactivate",
      "category": "SlateAccessibleMessageHandler",
      "signature": "OnDeactivate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-accessible-window",
      "name": "GetAccessibleWindow",
      "category": "SlateAccessibleMessageHandler",
      "signature": "GetAccessibleWindow(Target, In Window)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "In Window",
          "type": "TSharedRef<FGenericWindow>&"
        }
      ],
      "returnType": "TSharedPtr<IAccessibleWidget>"
    },
    {
      "id": "get-accessible-window-id",
      "name": "GetAccessibleWindowId",
      "category": "SlateAccessibleMessageHandler",
      "signature": "GetAccessibleWindowId(Target, In Window)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "In Window",
          "type": "TSharedRef<FGenericWindow>&"
        }
      ],
      "returnType": "AccessibleWidgetId"
    },
    {
      "id": "get-accessible-widget-from-id",
      "name": "GetAccessibleWidgetFromId",
      "category": "SlateAccessibleMessageHandler",
      "signature": "GetAccessibleWidgetFromId(Target, Id)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "Id",
          "type": "AccessibleWidgetId"
        }
      ],
      "returnType": "TSharedPtr<IAccessibleWidget>"
    },
    {
      "id": "run-in-thread",
      "name": "RunInThread",
      "category": "SlateAccessibleMessageHandler",
      "signature": "RunInThread(Target, In Function, Wait For Completion, In Thread)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "In Function",
          "type": "TFunction<void ( )>&"
        },
        {
          "name": "Wait For Completion",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "In Thread",
          "type": "ENamedThreads::Type",
          "default": "ENamedThreads::GameThread"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "make-accessible-announcement",
      "name": "MakeAccessibleAnnouncement",
      "category": "SlateAccessibleMessageHandler",
      "signature": "MakeAccessibleAnnouncement(Target, Announcement String)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "Announcement String",
          "type": "String&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-widget-removed",
      "name": "OnWidgetRemoved",
      "category": "SlateAccessibleMessageHandler",
      "signature": "OnWidgetRemoved(Target, Widget)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "Widget",
          "type": "SWidget*"
        }
      ],
      "returnType": "Void",
      "docs": "Callback for SWidget destructor. Removes the corresponding accessible widget for the Slate widget.\n@param Widget The widget that is being deleted."
    },
    {
      "id": "on-widget-event-raised",
      "name": "OnWidgetEventRaised",
      "category": "SlateAccessibleMessageHandler",
      "signature": "OnWidgetEventRaised(Target, Args)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "Args",
          "type": "FSlateWidgetAccessibleEventArgs&"
        }
      ],
      "returnType": "Void",
      "docs": "The widget that's raising the accessible event"
    },
    {
      "id": "process-accessible-tasks",
      "name": "ProcessAccessibleTasks",
      "category": "SlateAccessibleMessageHandler",
      "signature": "ProcessAccessibleTasks(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Processes all the queued tasks in the AccessibleTaskQueue\nShould only be called from FSlateApplication::TickPlatform()"
    },
    {
      "id": "tick",
      "name": "Tick",
      "category": "SlateAccessibleMessageHandler",
      "signature": "Tick(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        }
      ],
      "returnType": "Void",
      "docs": "Process any pending Slate widgets and update the accessible widget tree."
    },
    {
      "id": "handle-accessible-widget-focus-change-event",
      "name": "HandleAccessibleWidgetFocusChangeEvent",
      "category": "SlateAccessibleMessageHandler",
      "signature": "HandleAccessibleWidgetFocusChangeEvent(Target, Focus Widget, Is Widget Gaining Focus, User Index)",
      "params": [
        {
          "name": "Target",
          "type": "FSlateAccessibleMessageHandler*"
        },
        {
          "name": "Focus Widget",
          "type": "TSharedRef<IAccessibleWidget>&"
        },
        {
          "name": "Is Widget Gaining Focus",
          "type": "Bool"
        },
        {
          "name": "User Index",
          "type": "FAccessibleUserIndex"
        }
      ],
      "returnType": "Void"
    }
  ]
}