{
  "id": "particle-system",
  "label": "ParticleSystem",
  "includepath": "Particles/ParticleSystem.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "ScriptMacros",
    "ParticlePerfStats",
    "TaskGraphInterfaces",
    "RHIDefinitions",
    "PSOPrecache",
    "ParticleSystem.generated"
  ],
  "functions": [
    {
      "id": "launch-pso-precaching",
      "name": "LaunchPSOPrecaching",
      "category": "ParticleSystem",
      "signature": "LaunchPSOPrecaching(Target, V Fs Per Materials)",
      "params": [
        {
          "name": "Target",
          "type": "UFXSystemAsset*"
        },
        {
          "name": "V Fs Per Materials",
          "type": "FMaterialInterfacePSOPrecacheParamsList&"
        }
      ],
      "returnType": "protected : void"
    },
    {
      "id": "get-parameters-utilized",
      "name": "GetParametersUtilized",
      "category": "ParticleSystem",
      "signature": "GetParametersUtilized(Target, Particle Sys Param List, Particle Parameter List)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        },
        {
          "name": "Particle Sys Param List",
          "type": "TArray<TArray<FString>>&"
        },
        {
          "name": "Particle Parameter List",
          "type": "TArray<TArray<FString>>&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieve the parameters associated with this particle system.\n@param\tParticleSysParamList\tThe list of FParticleSysParams used in the system\n@param\tParticleParameterList\tThe list of ParticleParameter distributions used in the system"
    },
    {
      "id": "setup-soloing",
      "name": "SetupSoloing",
      "category": "ParticleSystem",
      "signature": "SetupSoloing(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Setup the soloing information... Obliterates all current soloing."
    },
    {
      "id": "toggle-soloing",
      "name": "ToggleSoloing",
      "category": "ParticleSystem",
      "signature": "ToggleSoloing(Target, In Emitter)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        },
        {
          "name": "In Emitter",
          "type": "UParticleEmitter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Toggle the bIsSoloing flag on the given emitter.\n@param\tInEmitter\t\tThe emitter to toggle.\n@return\tbool\t\t\ttrue if ANY emitters are set to soloing, false if none are."
    },
    {
      "id": "turn-off-soloing",
      "name": "TurnOffSoloing",
      "category": "ParticleSystem",
      "signature": "TurnOffSoloing(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Bool",
      "docs": "Turn soloing off completely - on every emitter\n@return\tbool\t\t\ttrue if successful, false if not."
    },
    {
      "id": "setup-lod-validity",
      "name": "SetupLODValidity",
      "category": "ParticleSystem",
      "signature": "SetupLODValidity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Editor helper function for setting the LOD validity flags used in Cascade."
    },
    {
      "id": "set-delay",
      "name": "SetDelay",
      "category": "ParticleSystem",
      "signature": "SetDelay(Target, In Delay)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        },
        {
          "name": "In Delay",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Set the time to delay spawning the particle system"
    },
    {
      "id": "remove-all-duplicate-modules",
      "name": "RemoveAllDuplicateModules",
      "category": "ParticleSystem",
      "signature": "RemoveAllDuplicateModules(Target, In Mark For Cooker, Out Removed Modules)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        },
        {
          "name": "In Mark For Cooker",
          "type": "Bool"
        },
        {
          "name": "Out Removed Modules",
          "type": "TMap<UObject*,bool>*"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove all duplicate modules.\n@param\tbInMarkForCooker\tIf true, mark removed objects to not cook out.\n@param\tOutRemovedModules\tOptional map to fill in w/ removed modules...\n@return\tbool\t\t\t\ttrue if successful, false if not"
    },
    {
      "id": "update-all-module-lists",
      "name": "UpdateAllModuleLists",
      "category": "ParticleSystem",
      "signature": "UpdateAllModuleLists(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Update all emitter module lists"
    },
    {
      "id": "build-emitters",
      "name": "BuildEmitters",
      "category": "ParticleSystem",
      "signature": "BuildEmitters(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Builds all emitters in the particle system."
    },
    {
      "id": "compute-can-tick-in-any-thread",
      "name": "ComputeCanTickInAnyThread",
      "category": "ParticleSystem",
      "signature": "ComputeCanTickInAnyThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Decide if this psys can tick in any thread, and set bIsElligibleForAsyncTick"
    },
    {
      "id": "contains-emitter-type",
      "name": "ContainsEmitterType",
      "category": "Particle System",
      "signature": "ContainsEmitterType(Target, Type Data)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleSystem*"
        },
        {
          "name": "Type Data",
          "type": "UClass*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this system contains an emitter of the pasesd type.\n@ param TypeData - The emitter type to check for. Must be a child class of UParticleModuleTypeDataBase"
    }
  ]
}