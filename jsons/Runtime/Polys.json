  "functions": [
    {
      "id": "init",
      "name": "Init",
      "category": "Polys",
      "signature": "Init(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize everything in an  editor polygon structure to defaults.\nChanges to these default values should also be mirrored to UPolysExporterT3D::ExportText(...)."
    },
    {
      "id": "reverse",
      "name": "Reverse",
      "category": "Polys",
      "signature": "Reverse(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Void",
      "docs": "Reverse an FPoly by reversing the normal and reversing the order of its vertices."
    },
    {
