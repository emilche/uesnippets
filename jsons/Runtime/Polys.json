        },
        {
          "name": "Post Add",
          "type": "FVector3f&"
        }
      ],
      "returnType": "Void",
      "docs": "Transform an editor polygon with a post-transformation addition."
    },
    {
      "id": "rotate",
      "name": "Rotate",
      "category": "Polys",
      "signature": "Rotate(Target, Rotation)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "Rotation",
          "type": "FRotator3f&"
        }
      ],
      "returnType": "Void",
      "docs": "Rotate an editor polygon."
    },
    {
      "id": "scale",
      "name": "Scale",
      "category": "Polys",
      "signature": "Scale(Target, Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "Scale",
          "type": "FVector3f&"
        }
      ],
      "returnType": "Void",
      "docs": "Scale an editor polygon."
    },
    {
      "id": "fix",
      "name": "Fix",
      "category": "Polys",
      "signature": "Fix(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Int",
      "docs": "Fix up an editor poly by deleting vertices that are identical.  Sets\nvertex count to zero if it collapses.  Returns number of vertices, 0 or >=3."
    },
    {
      "id": "calc-normal",
      "name": "CalcNormal",
      "category": "Polys",
      "signature": "CalcNormal(Target, Silent)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "Silent",
          "type": "Bool",
          "default": "0"
        }
      ],
      "returnType": "Int",
      "docs": "Compute normal of an FPoly.  Works even if FPoly has 180-degree-angled sides (which\nare often created during T-joint elimination).  Returns nonzero result (plus sets\nnormal vector to zero) if a problem occurs."
    },
    {
      "id": "split-with-plane",
      "name": "SplitWithPlane",
      "category": "Polys",
      "signature": "SplitWithPlane(Target, In Base, In Normal, Front Poly, Back Poly, Very Precise)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Base",
          "type": "FVector3f&"
        },
        {
          "name": "In Normal",
          "type": "FVector3f&"
        },
        {
          "name": "Front Poly",
          "type": "FPoly*"
        },
        {
          "name": "Back Poly",
          "type": "FPoly*"
        },
        {
          "name": "Very Precise",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Split with plane. Meant to be numerically stable."
    },
    {
      "id": "split-with-node",
      "name": "SplitWithNode",
      "category": "Polys",
      "signature": "SplitWithNode(Target, Model, I Node, Front Poly, Back Poly, Very Precise)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "Model",
          "type": "UModel*"
        },
        {
          "name": "I Node",
          "type": "Int"
        },
        {
          "name": "Front Poly",
          "type": "FPoly*"
        },
        {
          "name": "Back Poly",
          "type": "FPoly*"
        },
        {
          "name": "Very Precise",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Split with a Bsp node."
    },
    {
      "id": "split-with-plane-fast",
      "name": "SplitWithPlaneFast",
      "category": "Polys",
      "signature": "SplitWithPlaneFast(Target, Plane, Front Poly, Back Poly)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "Plane",
          "type": "FPlane&"
        },
        {
          "name": "Front Poly",
          "type": "FPoly*"
        },
        {
          "name": "Back Poly",
          "type": "FPoly*"
        }
      ],
      "returnType": "Int",
      "docs": "Split with plane quickly for in-game geometry operations.\nResults are always valid. May return sliver polys."
    },
    {
      "id": "split",
      "name": "Split",
      "category": "Polys",
      "signature": "Split(Target, In Normal, In Base)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Normal",
          "type": "FVector3f&"
        },
        {
          "name": "In Base",
          "type": "FVector3f&"
        }
      ],
      "returnType": "Int",
      "docs": "Split a poly and keep only the front half. Returns number of vertices, 0 if clipped away."
    },
    {
      "id": "remove-colinears",
      "name": "RemoveColinears",
      "category": "Polys",
      "signature": "RemoveColinears(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Int",
      "docs": "Remove colinear vertices and check convexity.  Returns 1 if convex, 0 if nonconvex or collapsed."
    },
    {
      "id": "area",
      "name": "Area",
      "category": "Polys",
      "signature": "Area(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Float",
      "docs": "Computes the 2D area of the polygon.  Returns zero if the polygon has less than three verices."
    },
    {
      "id": "on-plane",
      "name": "OnPlane",
      "category": "Polys",
      "signature": "OnPlane(Target, In Vtx)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Vtx",
          "type": "FVector"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks to see if the specified vertex lies on this polygons plane."
    },
    {
      "id": "insert-vertex",
