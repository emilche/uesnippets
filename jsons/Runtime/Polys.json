      "signature": "RemoveVertex(Target, In Vtx)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Vtx",
          "type": "FVector"
        }
      ],
      "returnType": "Void",
      "docs": "Removes a vertex from the polygons list of vertices"
    },
    {
      "id": "is-coplanar-222f16",
      "name": "IsCoplanar",
      "category": "Polys",
      "signature": "IsCoplanar(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks to see if all the vertices on a polygon are coplanar."
    },
    {
      "id": "is-convex",
      "name": "IsConvex",
      "category": "Polys",
      "signature": "IsConvex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks to see if this polygon is a convex shape.\n@return\ttrue if this polygon is convex."
    },
    {
      "id": "triangulate",
      "name": "Triangulate",
      "category": "Polys",
      "signature": "Triangulate(Target, In Owner Brush, Out Triangles)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Owner Brush",
          "type": "ABrush*"
        },
        {
          "name": "Out Triangles",
          "type": "TArray<FPoly>&"
        }
      ],
      "returnType": "Int",
      "docs": "Breaks down this polygon into triangles.  The triangles are then returned to the caller in an array.\n@param\tInOwnerBrush\tThe brush that owns this polygon.\n@param\tOutTriangles\tAn array to store the resulting triangles in.\n@return\tThe number of triangles created"
    },
    {
      "id": "get-vertex-index",
      "name": "GetVertexIndex",
      "category": "Polys",
      "signature": "GetVertexIndex(Target, In Vtx)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Vtx",
          "type": "FVector3f&"
        }
      ],
      "returnType": "Int",
      "docs": "Finds the index of the specific vertex.\n@param\tInVtx\tThe vertex to find the index of\n@return\tThe index of the vertex, if found.  Otherwise INDEX_NONE."
    },
    {
      "id": "get-mid-point",
      "name": "GetMidPoint",
      "category": "Polys",
      "signature": "GetMidPoint(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        }
      ],
      "returnType": "FVector",
      "docs": "Computes the mid point of the polygon (in local space)."
    },
    {
      "id": "build-infinite-f-poly",
      "name": "BuildInfiniteFPoly",
      "category": "Polys",
      "signature": "BuildInfiniteFPoly(In Plane)",
      "params": [
        {
          "name": "In Plane",
          "type": "FPlane&"
        }
      ],
      "returnType": "FPoly",
      "docs": "Builds a huge poly aligned with the specified plane.  This poly is\ncarved up by the calling routine and used as a capping poly following a clip operation.\n@param\tInPlane\t\t\tThe plane to lay the polygon on.\n@param\tInCutPlanes\t\tThe planes to split the poly with.\n@param\tInOwnerBrush\tThe brush that owns the polygons.\n@return\tThe resulting polygon"
    },
    {
      "id": "build-and-cut-infinite-f-poly",
      "name": "BuildAndCutInfiniteFPoly",
      "category": "Polys",
      "signature": "BuildAndCutInfiniteFPoly(In Plane, In Cut Planes, In Owner Brush)",
      "params": [
        {
          "name": "In Plane",
          "type": "FPlane&"
        },
        {
          "name": "In Cut Planes",
          "type": "TArray<FPlane>&"
        },
        {
          "name": "In Owner Brush",
          "type": "ABrush*"
        }
      ],
      "returnType": "FPoly"
    },
    {
      "id": "finalize",
      "name": "Finalize",
      "category": "Polys",
      "signature": "Finalize(Target, In Owner, No Error)",
      "params": [
        {
          "name": "Target",
          "type": "FPoly*"
        },
        {
          "name": "In Owner",
          "type": "ABrush*"
        },
        {
          "name": "No Error",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Compute all remaining polygon parameters (normal, etc) that are blank.\nReturns 0 if ok, nonzero if problem."
    },
    {
      "id": "get-outside-windings",
      "name": "GetOutsideWindings",
      "category": "Polys",
      "signature": "GetOutsideWindings(In Owner Brush, In Polygons, In Windings)",
      "params": [
        {
          "name": "In Owner Brush",
          "type": "ABrush*"
        },
        {
          "name": "In Polygons",
          "type": "ArrayType&"
        },
        {
          "name": "In Windings",
          "type": "TArray<TArray<FVector3f>>&"
        }
      ],
      "returnType": "template<ArrayType> void",
      "docs": "Takes a set of polygons and returns a vertex array representing the outside winding\nfor them.\nNOTE : This will work for convex or concave sets of polygons but not for concave polygons with holes.\n@param\tInOwnerBrush\tThe brush that owns the polygons.\n@param\tInPolygons\t\tAn array of FPolys that you want to get the winding for\n@param\tInWindings\t\tThe resulting sets of vertices that represent the windings"
    },
