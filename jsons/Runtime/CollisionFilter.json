{
  "id": "collision-filter",
  "label": "CollisionFilter",
  "includepath": "Chaos/Collision/CollisionFilter.h",
  "includes": [
    "Core",
    "CollisionConstraintFlags",
    "CollisionFilterBits",
    "CollisionFilterData",
    "GeometryParticles",
    "ImplicitObjectType",
    "ParticleHandle"
  ],
  "functions": [
    {
      "id": "particle-pair-broad-phase-filter",
      "name": "ParticlePairBroadPhaseFilter",
      "category": "CollisionFilter",
      "signature": "ParticlePairBroadPhaseFilter(Particle 1, Particle 2, Ignore Collision Manager)",
      "params": [
        {
          "name": "Particle 1",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Particle 2",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Ignore Collision Manager",
          "type": "FIgnoreCollisionManager*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether the two particles need to be considered in the broadphase.\n@return true if the particle pair should be considered by the broadphase"
    },
    {
      "id": "is-filter-valid",
      "name": "IsFilterValid",
      "category": "CollisionFilter",
      "signature": "IsFilterValid(Filter)",
      "params": [
        {
          "name": "Filter",
          "type": "FCollisionFilterData&"
        }
      ],
      "returnType": "Bool",
      "docs": "A filter set to all zeroes means we do not filter"
    },
    {
      "id": "filter-has-sim-enabled",
      "name": "FilterHasSimEnabled",
      "category": "CollisionFilter",
      "signature": "FilterHasSimEnabled(Shape)",
      "params": [
        {
          "name": "Shape",
          "type": "FPerShapeData*"
        }
      ],
      "returnType": "Bool",
      "docs": "Does the shape collide with anything at all in the Sim? (else it is query-only)"
    },
    {
      "id": "do-collide-bbfba6",
      "name": "DoCollide",
      "category": "CollisionFilter",
      "signature": "DoCollide(Implicit Type, Shape)",
      "params": [
        {
          "name": "Implicit Type",
          "type": "EImplicitObjectType"
        },
        {
          "name": "Shape",
          "type": "FPerShapeData*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "do-collide-075f24",
      "name": "DoCollide",
      "category": "CollisionFilter",
      "signature": "DoCollide(Implicit 0 Type, Shape 0, Implicit 1 Type, Shape 1)",
      "params": [
        {
          "name": "Implicit 0 Type",
          "type": "EImplicitObjectType"
        },
        {
          "name": "Shape 0",
          "type": "FPerShapeData*"
        },
        {
          "name": "Implicit 1 Type",
          "type": "EImplicitObjectType"
        },
        {
          "name": "Shape 1",
          "type": "FPerShapeData*"
        }
      ],
      "returnType": "Bool",
      "docs": "Sim Collision filter (i.e., not Query collision filter)"
    },
    {
      "id": "shape-pair-narrow-phase-filter",
      "name": "ShapePairNarrowPhaseFilter",
      "category": "CollisionFilter",
      "signature": "ShapePairNarrowPhaseFilter(Implicit 0 Type, Shape 0, Implicit 1 Type, Shape 1)",
      "params": [
        {
          "name": "Implicit 0 Type",
          "type": "EImplicitObjectType"
        },
        {
          "name": "Shape 0",
          "type": "FPerShapeData*"
        },
        {
          "name": "Implicit 1 Type",
          "type": "EImplicitObjectType"
        },
        {
          "name": "Shape 1",
          "type": "FPerShapeData*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether the two particles need to be considered in the broadphase\nNOTE: Implicit0Type and Implicit1Type must be the inner type of the implicit,\nwith any decorators removed (scaled, instanced, transformed).\n@return true if the shape pair should be considered by the narrowphase"
    }
  ]
}