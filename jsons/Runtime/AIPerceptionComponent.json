      "returnType": "Void",
      "docs": "Note that this works only if given sense has been already configured for\nthis component instance"
    },
    {
      "id": "is-sense-enabled",
      "name": "IsSenseEnabled",
      "category": "AI",
      "signature": "IsSenseEnabled(Target, Sense Class)",
      "params": [
        {
          "name": "Target",
          "type": "UAIPerceptionComponent*"
        },
        {
          "name": "Sense Class",
          "type": "TSubclassOf<UAISense>"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns if a sense is active. Note that this works only if given sense has been\nalready configured for this component instance"
