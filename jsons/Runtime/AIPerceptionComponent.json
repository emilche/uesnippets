        {
          "name": "Target",
          "type": "UAIPerceptionComponent*"
        },
        {
          "name": "Sense To Use",
          "type": "TSubclassOf<UAISense>"
        },
        {
          "name": "Out Actors",
          "type": "TArray<AActor*>&"
        }
      ],
      "returnType": "Void",
      "docs": "If SenseToUse is none all actors ever perceived in any way (and not forgotten yet) will get fetched"
    },
    {
      "id": "get-actors-perception",
      "name": "GetActorsPerception",
      "category": "AI",
      "signature": "GetActorsPerception(Target, Actor, Info)",
      "params": [
        {
          "name": "Target",
          "type": "UAIPerceptionComponent*"
        },
        {
          "name": "Actor",
