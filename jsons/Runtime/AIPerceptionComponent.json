          "type": "TArray<AActor*>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-currently-perceived-actors",
      "name": "GetCurrentlyPerceivedActors",
      "category": "AI",
      "signature": "GetCurrentlyPerceivedActors(Target, Sense To Use, Out Actors)",
      "params": [
        {
          "name": "Target",
          "type": "UAIPerceptionComponent*"
        },
        {
          "name": "Sense To Use",
          "type": "TSubclassOf<UAISense>"
        },
        {
          "name": "Out Actors",
          "type": "TArray<AActor*>&"
        }
      ],
      "returnType": "Void",
      "docs": "If SenseToUse is none all actors currently perceived in any way will get fetched"
    },
    {
      "id": "get-known-perceived-actors",
      "name": "GetKnownPerceivedActors",
      "category": "AI",
      "signature": "GetKnownPerceivedActors(Target, Sense To Use, Out Actors)",
