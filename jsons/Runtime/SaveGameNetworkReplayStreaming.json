  "functions": [
    {
      "id": "f-save-game-network-replay-streamer-0e8dd2",
      "name": "FSaveGameNetworkReplayStreamer",
      "category": "SaveGameNetworkReplayStreaming",
      "signature": "FSaveGameNetworkReplayStreamer()",
      "params": [],
      "returnType": "public :",
      "docs": "Local file streamer that supports playback/recording to files on disk, and transferring replays to and from SaveGame slots.\nEnumerateStreams may be used to list all available replays that are in SaveGame slots.\nThe Name member in any FNetworkReplayStreamInfo returned will be the SaveGame slot where the replay lives.\nEnumerateRecentStreams may be used to list all available replays that are not in SaveGame slots.\nThe Name member in any FNetworkReplayStreamInfo returned will be the relative path where the replay lives.\nStartStreaming can be used to play replays both in and not in SaveGame slots.\nStartStreaming does not automatically put a replay in a SaveGame slot.\nKeepReplay can be used to move a non SaveGame slot replay into a SaveGame slot. The original replay is left untouched.\nDeleteFinishedStream can be used to delete replays both in and not in SaveGame slots.\nOnly one Save Game operation is permitted to occur at a single time (even across Streamers).\nTODO: Proper handling of UserIndex."
    },
