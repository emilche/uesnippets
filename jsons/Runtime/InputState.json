{
  "id": "input-state",
  "label": "InputState",
  "includepath": "InputState.h",
  "includes": [
    "CoreMinimal",
    "InputCoreTypes",
    "NumericLimits",
    "Ray",
    "UnrealMath",
    "UnrealMathSSE",
    "Vector",
    "Vector2D",
    "AssertionMacros",
    "EnumClassFlags",
    "ObjectMacros",
    "WeakObjectPtr",
    "WeakObjectPtrTemplates",
    "InputState.generated"
  ],
  "functions": [
    {
      "id": "set-hit-object",
      "name": "SetHitObject",
      "category": "InputState",
      "signature": "SetHitObject(Target, In Hit Object)",
      "params": [
        {
          "name": "Target",
          "type": "FInputRayHit*"
        },
        {
          "name": "In Hit Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Set hit object, will also set hit owner to the same value"
    },
    {
      "id": "set-states",
      "name": "SetStates",
      "category": "InputState",
      "signature": "SetStates(Target, Pressed In, Down In, Released In, Double Clicked In)",
      "params": [
        {
          "name": "Target",
          "type": "FDeviceButtonState*"
        },
        {
          "name": "Pressed In",
          "type": "Bool"
        },
        {
          "name": "Down In",
          "type": "Bool"
        },
        {
          "name": "Released In",
          "type": "Bool"
        },
        {
          "name": "Double Clicked In",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Update the states of this button"
    },
    {
      "id": "set-modifier-key-states",
      "name": "SetModifierKeyStates",
      "category": "InputState",
      "signature": "SetModifierKeyStates(Target, Shift Down, Alt Down, Ctrl Down, Cmd Down)",
      "params": [
        {
          "name": "Target",
          "type": "FInputDeviceState*"
        },
        {
          "name": "Shift Down",
          "type": "Bool"
        },
        {
          "name": "Alt Down",
          "type": "Bool"
        },
        {
          "name": "Ctrl Down",
          "type": "Bool"
        },
        {
          "name": "Cmd Down",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Update keyboard modifier key states"
    },
    {
      "id": "is-from-device",
      "name": "IsFromDevice",
      "category": "InputState",
      "signature": "IsFromDevice(Target, Device Type)",
      "params": [
        {
          "name": "Target",
          "type": "FInputDeviceState*"
        },
        {
          "name": "Device Type",
          "type": "EInputDevices"
        }
      ],
      "returnType": "Bool",
      "docs": "@param DeviceType Combination of device-type flags\n@return true if this input state is for an input device that matches the query flags"
    },
    {
      "id": "is-shift-key-down",
      "name": "IsShiftKeyDown",
      "category": "InputState",
      "signature": "IsShiftKeyDown(Input State)",
      "params": [
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if shift key is down in input state"
    },
    {
      "id": "is-ctrl-key-down",
      "name": "IsCtrlKeyDown",
      "category": "InputState",
      "signature": "IsCtrlKeyDown(Input State)",
      "params": [
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if ctrl key is down in input state"
    },
    {
      "id": "is-alt-key-down",
      "name": "IsAltKeyDown",
      "category": "InputState",
      "signature": "IsAltKeyDown(Input State)",
      "params": [
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if alt key is down in input state"
    },
    {
      "id": "is-cmd-key-down",
      "name": "IsCmdKeyDown",
      "category": "InputState",
      "signature": "IsCmdKeyDown(Input State)",
      "params": [
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if Apple Command key is down in input state"
    }
  ]
}