{
  "id": "static-mesh-source-data",
  "label": "StaticMeshSourceData",
  "includepath": "Engine/StaticMeshSourceData.h",
  "includes": [
    "CoreMinimal",
    "MeshDescriptionBaseBulkData",
    "EngineTypes",
    "MeshReductionSettings",
    "ObjectMacros",
    "PerPlatformProperties",
    "StaticMeshSourceData.generated"
  ],
  "functions": [
    {
      "id": "is-raw-mesh-empty",
      "name": "IsRawMeshEmpty",
      "category": "StaticMeshSourceData",
      "signature": "IsRawMeshEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "Bool",
      "docs": "Imported raw mesh data. Optional for all but the first LOD.\nThis is a member for legacy assets only.\nIf it is non-empty, this means that it has been de-serialized from the asset, and\nthe asset hence pre-dates MeshDescription."
    },
    {
      "id": "load-raw-mesh",
      "name": "LoadRawMesh",
      "category": "StaticMeshSourceData",
      "signature": "LoadRawMesh(Target, Out Raw Mesh)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "Out Raw Mesh",
          "type": "FRawMesh&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "save-raw-mesh",
      "name": "SaveRawMesh",
      "category": "StaticMeshSourceData",
      "signature": "SaveRawMesh(Target, In Raw Mesh, Convert To Meshdescription)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "In Raw Mesh",
          "type": "FRawMesh&"
        },
        {
          "name": "Convert To Meshdescription",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-static-mesh-owner",
      "name": "GetStaticMeshOwner",
      "category": "StaticMeshSourceData",
      "signature": "GetStaticMeshOwner(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "UStaticMesh*",
      "docs": "Returns the static mesh which owns this source model."
    },
    {
      "id": "is-source-model-initialized",
      "name": "IsSourceModelInitialized",
      "category": "StaticMeshSourceData",
      "signature": "IsSourceModelInitialized(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "Bool",
      "docs": "Verify that this SourceModel has been fully initialized. It may still not contain valid data ( use IsMeshDescriptionValid() for that )\nCurrently this checks if StaticMeshDescriptionBulkData is allocated, which the other functions below all require via checks."
    },
    {
      "id": "create-mesh-description",
      "name": "CreateMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "CreateMeshDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "FMeshDescription*",
      "docs": "Create a new MeshDescription object"
    },
    {
      "id": "load-mesh-description",
      "name": "LoadMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "LoadMeshDescription(Target, Out Mesh Description)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "Out Mesh Description",
          "type": "FMeshDescription&"
        }
      ],
      "returnType": "Bool",
      "docs": "Tries to initialize a MeshDescription into the given FMeshDescription object, returning whether it was successful.\nIt will try the following steps in order to obtain it:\n- if there's valid StaticMeshDescriptionBulkData, unpack it from that\n- if there's a valid DDC entry from a previously converted RawMesh, load it and unpack it\n- if there's a valid RawMesh, convert it to MeshDescription and return that.\nIf all the above failed, then return failure."
    },
    {
      "id": "clone-mesh-description",
      "name": "CloneMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "CloneMeshDescription(Target, Out Mesh Description)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "Out Mesh Description",
          "type": "FMeshDescription&"
        }
      ],
      "returnType": "Bool",
      "docs": "If there's a valid cached MeshDescription, return a copy of it.\nOtherwise unpack the mesh description from bulk data and return the result (without caching it)."
    },
    {
      "id": "get-or-cache-mesh-description",
      "name": "GetOrCacheMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "GetOrCacheMeshDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "FMeshDescription*",
      "docs": "Gets the cached mesh description if there was one, otherwise loads, caches and returns it."
    },
    {
      "id": "get-cached-mesh-description",
      "name": "GetCachedMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "GetCachedMeshDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "FMeshDescription*",
      "docs": "Gets the cached mesh description, or nullptr if there wasn't one"
    },
    {
      "id": "get-cached-static-mesh-description",
      "name": "GetCachedStaticMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "GetCachedStaticMeshDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "UStaticMeshDescription*",
      "docs": "Gets the cached StaticMeshDescription if there is one, or nullptr if not."
    },
    {
      "id": "get-mesh-description-bulk-data",
      "name": "GetMeshDescriptionBulkData",
      "category": "StaticMeshSourceData",
      "signature": "GetMeshDescriptionBulkData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "FMeshDescriptionBulkData*",
      "docs": "Gets the mesh description bulk data, or nullptr if not valid"
    },
    {
      "id": "is-mesh-description-valid",
      "name": "IsMeshDescriptionValid",
      "category": "StaticMeshSourceData",
      "signature": "IsMeshDescriptionValid(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether the cached mesh description is valid or not"
    },
    {
      "id": "commit-mesh-description",
      "name": "CommitMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "CommitMeshDescription(Target, Use Hash As Guid)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "Use Hash As Guid",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Commits the cached mesh description to bulk data"
    },
    {
      "id": "clear-mesh-description",
      "name": "ClearMeshDescription",
      "category": "StaticMeshSourceData",
      "signature": "ClearMeshDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the cached mesh description"
    },
    {
      "id": "reset-reduction-setting",
      "name": "ResetReductionSetting",
      "category": "StaticMeshSourceData",
      "signature": "ResetReductionSetting(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-sub-objects",
      "name": "CreateSubObjects",
      "category": "StaticMeshSourceData",
      "signature": "CreateSubObjects(Target, Owner)",
      "params": [
        {
          "name": "Target",
          "type": "FStaticMeshSourceModel*"
        },
        {
          "name": "Owner",
          "type": "UStaticMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize"
    }
  ]
}