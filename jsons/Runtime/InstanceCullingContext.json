      "name": "FInstanceCullingContext",
      "category": "InstanceCullingContext",
      "signature": "FInstanceCullingContext(Pass Name, Shader Platform, In Instance Culling Manager, In View Ids, In Prev HZB, In Instance Culling Mode, In Flags, In Single Instance Processing Mode)",
      "params": [
        {
          "name": "Pass Name",
          "type": "TCHAR*"
        },
        {
          "name": "Shader Platform",
          "type": "EShaderPlatform"
        },
        {
          "name": "In Instance Culling Manager",
          "type": "FInstanceCullingManager*"
        },
        {
          "name": "In View Ids",
          "type": "TArrayView<int32>"
        },
        {
          "name": "In Prev HZB",
          "type": "TRefCountPtr<IPooledRenderTarget>&"
        },
        {
          "name": "In Instance Culling Mode",
          "type": "EInstanceCullingMode",
          "default": "EInstanceCullingMode::Normal"
        },
        {
          "name": "In Flags",
          "type": "EInstanceCullingFlags",
          "default": "EInstanceCullingFlags::None"
        },
        {
          "name": "In Single Instance Processing Mode",
          "type": "EBatchProcessingMode",
          "default": "EBatchProcessingMode::UnCulled"
        }
      ],
      "returnType": "Void",
      "docs": "Create an instance culling context to process draw commands that can be culled using GPU-Scene.\n@param InPrevHZB if non-null enables HZB-occlusion culling for the context (if r.InstanceCulling.OcclusionCull is enabled),\nNOTE: only one PrevHZB target is allowed accross all passes currently, so either must be atlased or otherwise the same."
    },
