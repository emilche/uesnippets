    {
      "id": "default-left-delays",
      "name": "DefaultLeftDelays",
      "category": "LateReflectionsFast",
      "signature": "DefaultLeftDelays(In Sample Rate)",
      "params": [
        {
          "name": "In Sample Rate",
          "type": "Float"
        }
      ],
      "returnType": "FLateReflectionsPlateDelays",
      "docs": "Setting the delay values affects the tap locations. The audio flowchart below shows the\nrelationship between delay values and tap locations.\n+---------------+\n|    Input      |\n+------+--------+\n|\n+------v--------+\n| Modulated APF |\n+------+--------+\n|\n+------+-------+\n|    DelayA    |\n+------+-------+  +---------+\n|--------->+  Tap 0  |\n+------v-------+  +---------+\n|    DelayB    |\n+------+-------+  +---------+\n|---------->  Tap 1  |\n+------v-------+  +---------+\n|    DelayC    |\n+------+-------+  +---------+\n|---------->  Tap 2  |\n+------v-------+  +---------+\n|    DelayD    |\n+------+-------+\n|\n+------v--------+\n|     LPF       |\n+------+--------+\n|\n+------v-------+  +---------+  +---------+  +---------+  +--------+\n|     APF      +--> DelayE  +--> |Tap 3  +--> DelayF  +-->  Tap 4 |\n+------+-------+  +---------+  +---------+  +---------+  +--------+\n|\n+------v-------+\n|    DelayG    |\n+------+-------+  +---------+\n|---------->  Tap 5  |\n+------v-------+  +---------+\n|    DelayH    |\n+------+-------+  +---------+\n|--------->+  Tap 6  |\n+------v-------+  +---------+\n|    DelayI    |\n+------+-------+\n|\n+------v-------+\n|    Output    |\n+--------------+"
    },
