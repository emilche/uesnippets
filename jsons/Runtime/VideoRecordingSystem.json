    {
      "id": "is-enabled",
      "name": "IsEnabled",
      "category": "VideoRecordingSystem",
      "signature": "IsEnabled(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericVideoRecordingSystem*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether recording is currently enabled."
    },
    {
      "id": "new-recording",
      "name": "NewRecording",
      "category": "VideoRecordingSystem",
      "signature": "NewRecording(Target, Destination File Name, Parameters)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericVideoRecordingSystem*"
        },
        {
          "name": "Destination File Name",
          "type": "TCHAR*"
        },
        {
          "name": "Parameters",
          "type": "FVideoRecordingParameters",
          "default": "FVideoRecordingParameters()"
        }
      ],
      "returnType": "Bool",
      "docs": "Initializes a new video recording.\nBy default does not start capturing, will not start again after saving and will export to the library.\nUse the RegisterVideoRecordingFinalizedDelegate to retrieve the final filepath.\n@param DestinationFileName The base name of the resulting video, without a path or extension.\n@param Parameters the parameters for this recording\n@return True if opening the recording succeeded, false otherwise."
    },
    {
      "id": "start-recording",
      "name": "StartRecording",
      "category": "VideoRecordingSystem",
      "signature": "StartRecording(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericVideoRecordingSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Begins capturing video after a call to NewRecording or PauseRecording."
    },
    {
      "id": "pause-recording",
      "name": "PauseRecording",
      "category": "VideoRecordingSystem",
      "signature": "PauseRecording(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericVideoRecordingSystem*"
        }
      ],
      "returnType": "Void",
      "docs": "Pauses video recording after a call to StartRecording. Call StartRecording again to resume."
    },
    {
