      "params": [
        {
          "name": "Target",
          "type": "FGenericVideoRecordingSystem*"
        }
      ],
      "returnType": "UInt64"
    },
    {
      "id": "get-current-recording-seconds",
      "name": "GetCurrentRecordingSeconds",
      "category": "VideoRecordingSystem",
