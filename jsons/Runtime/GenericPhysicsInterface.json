          "type": "FCollisionQueryParams&"
        },
        {
          "name": "Response Params",
          "type": "FCollisionResponseParams&"
        },
        {
          "name": "Object Params",
          "type": "FCollisionObjectQueryParams&",
          "default": "FCollisionObjectQueryParams::DefaultObjectQueryParam"
        }
      ],
      "returnType": "Bool",
      "docs": "Trace a ray against the world and return the first blocking hit"
    },
    {
      "id": "raycast-multi",
      "name": "RaycastMulti",
      "category": "GenericPhysicsInterface",
      "signature": "RaycastMulti(World, Out Hits, Start, End, Trace Channel, Params, Response Params, Object Params)",
      "params": [
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Out Hits",
          "type": "TArray<FHitResult>&"
        },
        {
          "name": "Start",
          "type": "FVector&"
        },
        {
          "name": "End",
          "type": "FVector&"
        },
        {
          "name": "Trace Channel",
          "type": "ECollisionChannel"
