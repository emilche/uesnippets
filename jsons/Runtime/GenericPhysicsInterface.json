      "name": "RaycastTest",
      "category": "GenericPhysicsInterface",
      "signature": "RaycastTest(World, Start, End, Trace Channel, Params, Response Params, Object Params)",
      "params": [
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Start",
          "type": "FVector"
        },
        {
          "name": "End",
          "type": "FVector"
        },
        {
          "name": "Trace Channel",
          "type": "ECollisionChannel"
        },
        {
          "name": "Params",
          "type": "FCollisionQueryParams&"
        },
        {
          "name": "Response Params",
          "type": "FCollisionResponseParams&"
        },
        {
          "name": "Object Params",
          "type": "FCollisionObjectQueryParams&",
          "default": "FCollisionObjectQueryParams::DefaultObjectQueryParam"
        }
      ],
      "returnType": "Bool",
      "docs": "Generic interface for physics APIs in the engine. Some common functionality is defined here, but APIs can override behavior as needed. See FGenericPlatformMisc for a similar pattern"
    },
    {
      "id": "raycast-single",
      "name": "RaycastSingle",
      "category": "GenericPhysicsInterface",
      "signature": "RaycastSingle(World, Out Hit, Start, End, Trace Channel, Params, Response Params, Object Params)",
      "params": [
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Out Hit",
          "type": "FHitResult&"
        },
        {
          "name": "Start",
          "type": "FVector"
        },
        {
          "name": "End",
          "type": "FVector"
        },
        {
          "name": "Trace Channel",
          "type": "ECollisionChannel"
        },
        {
