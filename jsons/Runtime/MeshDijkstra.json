    },
    {
      "id": "find-path-to-nearest-seed",
      "name": "FindPathToNearestSeed",
      "category": "MeshDijkstra",
      "signature": "FindPathToNearestSeed(Target, Point ID, Path To Seed Out, Max Length)",
      "params": [
        {
          "name": "Target",
          "type": "TMeshDijkstra*"
        },
        {
          "name": "Point ID",
          "type": "Int"
        },
        {
          "name": "Path To Seed Out",
          "type": "TArray<int32>&"
        },
        {
          "name": "Max Length",
          "type": "Int",
          "default": "100000"
        }
      ],
      "returnType": "Bool",
      "docs": "Find path from a point to the nearest seed point\n@param PointID starting point, assumption is that we have computed dijkstra to this point\n@param PathToSeedOut path is returned here, includes PointID and seed point as last element\n@param MaxLength if PathToSeedOut grows beyond this length, we abort the search\n@return true if valid path was found"
    },
