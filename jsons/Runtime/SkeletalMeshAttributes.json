    {
      "id": "register-import-point-index-attribute",
      "name": "RegisterImportPointIndexAttribute",
      "category": "SkeletalMeshAttributes",
      "signature": "RegisterImportPointIndexAttribute(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshAttributes*"
        }
      ],
      "returnType": "Bool",
      "docs": "Register an attribute that can be used to maintain a relationship between a given vertex and the point it originated from\non the original imported mesh. This can be useful when trying to match the stored mesh to the import mesh as stored in the import file\n(e.g. FBX, Alembic, glTF, etc)."
    },
    {
      "id": "unregister-import-point-index-attribute",
      "name": "UnregisterImportPointIndexAttribute",
      "category": "SkeletalMeshAttributes",
      "signature": "UnregisterImportPointIndexAttribute(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshAttributes*"
        }
      ],
      "returnType": "Void",
      "docs": "Convenience function to unregister the attribute that maintains the relationship between a given vertex and the originating point\non the import mesh. Use if updating the mesh description but no longer maintaining this relationship (e.g. the topology changed and\nso this map cannot possibly be accurate)."
    },
