    },
    {
      "id": "get-desired-region-size",
      "name": "GetDesiredRegionSize",
      "category": "SGridPanel",
      "signature": "GetDesiredRegionSize(Target, Start Cell, Width, Height)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Start Cell",
          "type": "FIntPoint&"
        },
        {
          "name": "Width",
          "type": "Int"
        },
        {
          "name": "Height",
          "type": "Int"
        }
      ],
      "returnType": "FVector2D",
      "docs": "GetDesiredSize of a subregion in the graph.\n@param StartCell   The cell (inclusive) in the upper left of the region.\n@param Size        Number of cells in the X and Y directions to get the size for.\n@return FVector2D  The desired size of the region of cells specified."
    },
    {
      "id": "set-column-fill",
