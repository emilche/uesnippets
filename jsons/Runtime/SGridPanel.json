    },
    {
      "id": "compute-partial-sums",
      "name": "ComputePartialSums",
      "category": "SGridPanel",
      "signature": "ComputePartialSums(Turn Me Into Partial Sums)",
      "params": [
        {
          "name": "Turn Me Into Partial Sums",
          "type": "TArray<float>&"
        }
      ],
      "returnType": "private : void",
      "docs": "Given an array of values, re-populate the array such that every contains the partial sums up to that element.\ni.e. Array[N] = Array.Sum(0 .. N-1)\nThe resulting array is 1-element longer."
    },
    {
      "id": "distribute-size-contributions",
      "name": "DistributeSizeContributions",
      "category": "SGridPanel",
      "signature": "DistributeSizeContributions(Size Contribution, Distribute Over Me, Start Index, Upper Bound)",
      "params": [
        {
          "name": "Size Contribution",
          "type": "Float"
        },
        {
          "name": "Distribute Over Me",
          "type": "TArray<float>&"
        },
        {
          "name": "Start Index",
          "type": "Int"
        },
        {
          "name": "Upper Bound",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Given a SizeContribution, distribute it to the elements in DistributeOverMe at indexes from [StartIndex .. UpperBound)"
    },
    {
      "id": "find-insert-slot-location",
      "name": "FindInsertSlotLocation",
      "category": "SGridPanel",
      "signature": "FindInsertSlotLocation(Target, In Slot)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "In Slot",
          "type": "FSlot*"
        }
      ],
      "returnType": "Int",
      "docs": "Find the index where the given slot should be inserted into the list of Slots based on its LayerParam, such that Slots are sorter by layer.\n@param The newly-allocated slot to insert.\n@return The index where the slot should be inserted."
    },
    {
      "id": "compute-desired-cell-sizes",
      "name": "ComputeDesiredCellSizes",
      "category": "SGridPanel",
      "signature": "ComputeDesiredCellSizes(Target, Out Columns, Out Rows)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Out Columns",
          "type": "TArray<float>&"
        },
        {
          "name": "Out Rows",
          "type": "TArray<float>&"
        }
      ],
      "returnType": "Void",
      "docs": "Compute the sizes of columns and rows needed to fit all the slots in this grid."
    },
    {
      "id": "layout-debug-paint",
      "name": "LayoutDebugPaint",
      "category": "SGridPanel",
      "signature": "LayoutDebugPaint(Target, Allotted Geometry, My Culling Rect, Out Draw Elements, Layer Id)",
