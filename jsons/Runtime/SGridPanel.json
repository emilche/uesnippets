        },
        {
          "name": "Coefficient",
          "type": "TAttribute<float>&"
        }
      ],
      "returnType": "Void",
      "docs": "Specify a column to stretch instead of sizing to content."
    },
    {
      "id": "set-row-fill",
      "name": "SetRowFill",
      "category": "SGridPanel",
      "signature": "SetRowFill(Target, Row Id, Coefficient)",
