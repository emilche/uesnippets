{
  "id": "s-grid-panel",
  "label": "SGridPanel",
  "includepath": "Widgets/Layout/SGridPanel.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "Visibility",
    "DeclarativeSyntaxSupport",
    "SlotBase",
    "SWidget",
    "Children",
    "SPanel"
  ],
  "functions": [
    {
      "id": "slot",
      "name": "Slot",
      "category": "SGridPanel",
      "signature": "Slot(Column, Row, In Layer)",
      "params": [
        {
          "name": "Column",
          "type": "Int"
        },
        {
          "name": "Row",
          "type": "Int"
        },
        {
          "name": "In Layer",
          "type": "Layer",
          "default": "Layer(0)"
        }
      ],
      "returnType": "FSlot::FSlotArguments",
      "docs": "Used by declarative syntax to create a Slot in the specified Column, Row and Layer."
    },
    {
      "id": "add-slot",
      "name": "AddSlot",
      "category": "SGridPanel",
      "signature": "AddSlot(Target, Column, Row, In Layer)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Column",
          "type": "Int"
        },
        {
          "name": "Row",
          "type": "Int"
        },
        {
          "name": "In Layer",
          "type": "Layer",
          "default": "Layer(0)"
        }
      ],
      "returnType": "FScopedWidgetSlotArguments",
      "docs": "Dynamically add a new slot to the UI at specified Column and Row. Optionally, specify a layer at which this slot should be added.\n@return A reference to the newly-added slot"
    },
    {
      "id": "remove-slot",
      "name": "RemoveSlot",
      "category": "SGridPanel",
      "signature": "RemoveSlot(Target, Slot Widget)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Slot Widget",
          "type": "TSharedRef<SWidget>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Removes a slot from this panel which contains the specified SWidget\n@param SlotWidget The widget to match when searching through the slots\n@returns The true if the slot was removed and false if no slot was found matching the widget"
    },
    {
      "id": "clear-children",
      "name": "ClearChildren",
      "category": "SGridPanel",
      "signature": "ClearChildren(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes all slots from the panel"
    },
    {
      "id": "construct",
      "name": "Construct",
      "category": "SGridPanel",
      "signature": "Construct(Target, In Args)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "In Args",
          "type": "FArguments&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-desired-region-size",
      "name": "GetDesiredRegionSize",
      "category": "SGridPanel",
      "signature": "GetDesiredRegionSize(Target, Start Cell, Width, Height)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Start Cell",
          "type": "FIntPoint&"
        },
        {
          "name": "Width",
          "type": "Int"
        },
        {
          "name": "Height",
          "type": "Int"
        }
      ],
      "returnType": "FVector2D",
      "docs": "GetDesiredSize of a subregion in the graph.\n@param StartCell   The cell (inclusive) in the upper left of the region.\n@param Size        Number of cells in the X and Y directions to get the size for.\n@return FVector2D  The desired size of the region of cells specified."
    },
    {
      "id": "set-column-fill",
      "name": "SetColumnFill",
      "category": "SGridPanel",
      "signature": "SetColumnFill(Target, Column Id, Coefficient)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Column Id",
          "type": "Int"
        },
        {
          "name": "Coefficient",
          "type": "TAttribute<float>&"
        }
      ],
      "returnType": "Void",
      "docs": "Specify a column to stretch instead of sizing to content."
    },
    {
      "id": "set-row-fill",
      "name": "SetRowFill",
      "category": "SGridPanel",
      "signature": "SetRowFill(Target, Row Id, Coefficient)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Row Id",
          "type": "Int"
        },
        {
          "name": "Coefficient",
          "type": "TAttribute<float>&"
        }
      ],
      "returnType": "Void",
      "docs": "Specify a row to stretch instead of sizing to content."
    },
    {
      "id": "clear-fill",
      "name": "ClearFill",
      "category": "SGridPanel",
      "signature": "ClearFill(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        }
      ],
      "returnType": "Void",
      "docs": "Clear the row and column fill rules."
    },
