        },
        {
          "name": "Out Draw Elements",
          "type": "FSlateWindowElementList&"
        },
        {
          "name": "Layer Id",
          "type": "Int"
        },
        {
          "name": "In Widget Style",
          "type": "FWidgetStyle&"
        },
        {
          "name": "Parent Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "on-arrange-children",
      "name": "OnArrangeChildren",
      "category": "SGridPanel",
      "signature": "OnArrangeChildren(Target, Allotted Geometry, Arranged Children)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "Arranged Children",
          "type": "FArrangedChildren&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "cache-desired-size",
      "name": "CacheDesiredSize",
      "category": "SGridPanel",
      "signature": "CacheDesiredSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "compute-desired-size",
      "name": "ComputeDesiredSize",
      "category": "SGridPanel",
      "signature": "ComputeDesiredSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        }
      ],
      "returnType": "FVector2D"
    },
    {
      "id": "get-children",
      "name": "GetChildren",
      "category": "SGridPanel",
      "signature": "GetChildren(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        }
      ],
      "returnType": "FChildren*"
    },
    {
      "id": "compute-partial-sums",
      "name": "ComputePartialSums",
      "category": "SGridPanel",
      "signature": "ComputePartialSums(Turn Me Into Partial Sums)",
      "params": [
        {
          "name": "Turn Me Into Partial Sums",
          "type": "TArray<float>&"
        }
      ],
      "returnType": "Void",
      "docs": "Given an array of values, re-populate the array such that every contains the partial sums up to that element.\ni.e. Array[N] = Array.Sum(0 .. N-1)\nThe resulting array is 1-element longer."
    }
  ]
}