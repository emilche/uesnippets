{
  "id": "s-grid-panel",
  "label": "SGridPanel",
  "includepath": "Widgets/Layout/SGridPanel.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "Visibility",
    "DeclarativeSyntaxSupport",
    "SlotBase",
    "SWidget",
    "Children",
    "SPanel"
  ],
  "functions": [
    {
      "id": "slot",
      "name": "Slot",
      "category": "SGridPanel",
      "signature": "Slot(Column, Row, In Layer)",
      "params": [
        {
          "name": "Column",
          "type": "Int"
        },
        {
          "name": "Row",
          "type": "Int"
        },
        {
          "name": "In Layer",
          "type": "Layer",
          "default": "Layer(0)"
        }
      ],
      "returnType": "FSlot::FSlotArguments",
      "docs": "Used by declarative syntax to create a Slot in the specified Column, Row and Layer."
    },
    {
      "id": "add-slot",
      "name": "AddSlot",
      "category": "SGridPanel",
      "signature": "AddSlot(Target, Column, Row, In Layer)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Column",
          "type": "Int"
        },
        {
          "name": "Row",
          "type": "Int"
        },
        {
          "name": "In Layer",
          "type": "Layer",
          "default": "Layer(0)"
        }
      ],
      "returnType": "FScopedWidgetSlotArguments",
      "docs": "Dynamically add a new slot to the UI at specified Column and Row. Optionally, specify a layer at which this slot should be added.\n@return A reference to the newly-added slot"
    },
    {
      "id": "remove-slot",
      "name": "RemoveSlot",
      "category": "SGridPanel",
      "signature": "RemoveSlot(Target, Slot Widget)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "Slot Widget",
          "type": "TSharedRef<SWidget>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Removes a slot from this panel which contains the specified SWidget\n@param SlotWidget The widget to match when searching through the slots\n@returns The true if the slot was removed and false if no slot was found matching the widget"
    },
    {
      "id": "s-grid-panel",
