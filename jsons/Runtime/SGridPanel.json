    {
      "id": "notify-slot-changed",
      "name": "NotifySlotChanged",
      "category": "SGridPanel",
      "signature": "NotifySlotChanged(Target, In Slot, Slot Layer Changed)",
      "params": [
        {
          "name": "Target",
          "type": "SGridPanel*"
        },
        {
          "name": "In Slot",
          "type": "FSlot*"
        },
        {
          "name": "Slot Layer Changed",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Callback used to resize our internal arrays if a slot (or slot span) is changed.\n@param InSlot The slot that has just changed.\n@param bSlotLayerChanged Whether the slot layer changed."
