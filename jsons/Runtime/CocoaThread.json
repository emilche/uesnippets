          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "game-thread-call-711cee",
      "name": "GameThreadCall",
      "category": "CocoaThread",
      "signature": "GameThreadCall(Block, Wait, Send Modes)",
      "params": [
