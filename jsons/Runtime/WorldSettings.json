      "name": "SetTimeDilation",
      "category": "WorldSettings",
      "signature": "SetTimeDilation(Target, New Time Dilation)",
      "params": [
        {
          "name": "Target",
          "type": "AWorldSettings*"
        },
        {
          "name": "New Time Dilation",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Sets the global time dilation value (subject to clamping). Returns the final value that was set (which may be clamped) even if bAllowTimeDilation is set to false."
    },
