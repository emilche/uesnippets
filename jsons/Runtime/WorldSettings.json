    {
      "id": "get-or-add-bookmark",
      "name": "GetOrAddBookmark",
      "category": "WorldSettings",
      "signature": "GetOrAddBookmark(Target, Bookmark Index, Recreate On Class Mismatch)",
      "params": [
        {
          "name": "Target",
          "type": "AWorldSettings*"
        },
        {
          "name": "Bookmark Index",
          "type": "UInt"
        },
        {
          "name": "Recreate On Class Mismatch",
          "type": "Bool"
        }
      ],
      "returnType": "class UBookmarkBase*",
      "docs": "Gets the bookmark at the specified index, creating it if a bookmark doesn't exist.\nThis will fail if the specified index is greater than MaxNumberOfBookmarks.\nFor \"plain\" access that doesn't cause reallocation, use GetBookmarks\n@param bRecreateOnClassMismatch\tWhether or not we should recreate an existing bookmark if it's class\ndoesn't match the default bookmark class."
    },
    {
      "id": "add-bookmark",
      "name": "AddBookmark",
      "category": "WorldSettings",
      "signature": "AddBookmark(Target, Bookmark Class, Expand If Necessary)",
      "params": [
        {
          "name": "Target",
          "type": "AWorldSettings*"
        },
        {
          "name": "Bookmark Class",
          "type": "TSubclassOf<UBookmarkBase>"
        },
        {
          "name": "Expand If Necessary",
          "type": "Bool"
        }
      ],
      "returnType": "class UBookmarkBase*",
      "docs": "Creates and adds a new bookmark of a different class.\nWhen the bookmark's class is not of the same class as the default bookmark class, the bookmark\nwill be removed on the next update.\nThis will fail if we've overrun MaxNumberOfBookmarks.\n@param\tBookmarkClass\tClass of the new bookmark.\n@param\tbExpandIfNecessary\tWill increase MaxNumberOfBookmarks if there's not enough add another.\n@return\tThe bookmark that was created.\nWill be nullptr on failure."
    },
