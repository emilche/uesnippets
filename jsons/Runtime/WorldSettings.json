        },
        {
          "name": "New Allow Time Dilation",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets whether or not Time Dilation is allowed. When true, GetEffectiveTimeDilation() will return the time dilation as determined by the various dilation factors, when false it will return 1.0f."
    },
