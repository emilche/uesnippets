    {
      "id": "copy-from",
      "name": "CopyFrom",
      "category": "LandscapeEditResourcesSubsystem",
      "signature": "CopyFrom(Target, In Copy Params, RDG Builder Recorder)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeScratchRenderTarget*"
        },
        {
          "name": "In Copy Params",
          "type": "FCopyFromTextureParams&"
        },
        {
          "name": "RDG Builder Recorder",
          "type": "UE::Landscape::FRDGBuilderRecorder&"
        }
      ],
      "returnType": "LANDSCAPE_EDIT_LAYERS_BATCHED_MERGE_EXPERIMENTAL void",
      "docs": "Copies the content of the texture in parameter to the scratch texture (assuming the input texture is in CopySrc state already). Transitions the scratch texture's RHIAccess\n@param InCopyParams parameters for the texture to copy from\n@param RDGBuilderRecorder when the recorder is in \"recording\" mode, the copy's render command enqueuing will be delayed to the render thread, after a FRDGBuilder has been created\nbut the scratch render target's current state will still be mutated to reflect the state change on the game thread. In \"immediate\" mode, a render command will be enqueued immediately"
    },
    {
      "id": "transition-to",
      "name": "TransitionTo",
      "category": "LandscapeEditResourcesSubsystem",
      "signature": "TransitionTo(Target, In State After, RDG Builder Recorder)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeScratchRenderTarget*"
        },
        {
          "name": "In State After",
          "type": "ERHIAccess"
        },
        {
          "name": "RDG Builder Recorder",
          "type": "UE::Landscape::FRDGBuilderRecorder&"
        }
      ],
      "returnType": "LANDSCAPE_EDIT_LAYERS_BATCHED_MERGE_EXPERIMENTAL void",
      "docs": "Perform a transition of the scratch texture's RHIAccess\n@param InStateAfter desired RHIAccess of the scratch render target\n@param RDGBuilderRecorder  when the recorder is in \"recording\" mode, the transition's render command enqueuing will not be executed (we assume the FRDGBuilder will take care of it)\nbut the scratch render target's current state will still be mutated to reflect the state change on the game thread. In \"immediate\" mode, a render command will be enqueued immediately"
    },
    {
      "id": "clear",
      "name": "Clear",
      "category": "LandscapeEditResourcesSubsystem",
      "signature": "Clear(Target, RDG Builder Recorder)",
      "params": [
        {
