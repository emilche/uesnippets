    {
      "id": "pre-allocate-from-source-grid",
      "name": "PreAllocateFromSourceGrid",
      "category": "BlockedDenseGrid3",
      "signature": "PreAllocateFromSourceGrid<OtherElemType>(Target, Source Grid)",
      "params": [
        {
          "name": "Target",
          "type": "TBlockedDenseGrid3*"
        },
        {
          "name": "Source Grid",
          "type": "TBasicBlockedDenseGrid3<OtherElemType,BlockSize>&"
        }
      ],
      "returnType": "template<OtherElemType> bool",
      "docs": "Pre-allocate the grid blocks that also exist in SourceGrid of the same dimensions.\nThis is useful in grid-processing algorithms where parallel grid operations can be\ndone without locking if the blocks are already allocated.\n@return false on failure (e.g. different sized grids), otherwise true."
    },
