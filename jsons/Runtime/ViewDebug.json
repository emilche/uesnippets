      "name": "ComputeCurrentLODIndex",
      "category": "ViewDebug",
      "signature": "ComputeCurrentLODIndex(Target, Player Index, View Index)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimitiveInfo*"
        },
        {
          "name": "Player Index",
          "type": "Int",
          "default": "0"
        },
        {
          "name": "View Index",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "dump-draw-calls-to-csv",
      "name": "DumpDrawCallsToCSV",
      "category": "ViewDebug",
      "signature": "DumpDrawCallsToCSV(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewDebugInfo*"
        }
      ],
      "returnType": "Void",
      "docs": "Writes the draw call count of all currently tracked primitives to a csv file.\nThe file will be stored in /Saved/Profiling/Primitives/..."
    },
    {
      "id": "dump-to-csv",
      "name": "DumpToCSV",
      "category": "ViewDebug",
      "signature": "DumpToCSV(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewDebugInfo*"
        }
      ],
      "returnType": "Void",
      "docs": "Writes detailed information about all currently tracked primitives to a csv file.\nThe file will be stored in /Saved/Profiling/Primitives/..."
    },
    {
      "id": "has-ever-updated",
      "name": "HasEverUpdated",
      "category": "ViewDebug",
      "signature": "HasEverUpdated(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewDebugInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if this debug information has ever been updated.\n@returns True if the information has been updated at least once."
    },
    {
      "id": "is-out-of-date",
      "name": "IsOutOfDate",
      "category": "ViewDebug",
      "signature": "IsOutOfDate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FViewDebugInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if current information is from an older frame.\n@returns True if the data in this object is outdated."
    }
  ]
}