{
  "id": "datasmith-mesh-serialization",
  "label": "DatasmithMeshSerialization",
  "includepath": "DatasmithMeshSerialization.h",
  "includes": [
    "DatasmithCore",
    "Array",
    "UnrealString",
    "MeshDescription",
    "SecureHash",
    "DatasmithCloth"
  ],
  "functions": [
    {
      "id": "serialize",
      "name": "Serialize",
      "category": "DatasmithMeshSerialization",
      "signature": "Serialize(Target, Ar, Save Compressed)",
      "params": [
        {
          "name": "Target",
          "type": "FDatasmithPackedMeshes*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Save Compressed",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FMD5Hash"
    },
    {
      "id": "get-datasmith-mesh-from-file",
      "name": "GetDatasmithMeshFromFile",
      "category": "DatasmithMeshSerialization",
      "signature": "GetDatasmithMeshFromFile(Mesh Path)",
      "params": [
        {
          "name": "Mesh Path",
          "type": "String&"
        }
      ],
      "returnType": "FDatasmithPackedMeshes"
    },
    {
      "id": "get-datasmith-cloth-from-file",
      "name": "GetDatasmithClothFromFile",
      "category": "DatasmithMeshSerialization",
      "signature": "GetDatasmithClothFromFile(Path)",
      "params": [
        {
          "name": "Path",
          "type": "String&"
        }
      ],
      "returnType": "FDatasmithPackedCloths"
    }
  ]
}