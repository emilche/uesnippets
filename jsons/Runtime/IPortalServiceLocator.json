{
  "id": "i-portal-service-locator",
  "label": "IPortalServiceLocator",
  "includepath": "IPortalServiceLocator.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "get-service",
      "name": "GetService",
      "category": "IPortalServiceLocator",
      "signature": "GetService<ServiceType>(Target, Product Id)",
      "params": [
        {
          "name": "Target",
          "type": "IPortalServiceLocator*"
        },
        {
          "name": "Product Id",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "template<ServiceType> TSharedPtr<ServiceType>",
      "docs": "Get a service of the specified type.\n@param ServiceType The type of service to get.\n@return The service instance, or nullptr if unavailable.\n@see GetServiceRef"
    },
    {
      "id": "get-service-ref",
      "name": "GetServiceRef",
      "category": "IPortalServiceLocator",
      "signature": "GetServiceRef<ServiceType>(Target, Product Id)",
      "params": [
        {
          "name": "Target",
          "type": "IPortalServiceLocator*"
        },
        {
          "name": "Product Id",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "template<ServiceType> TSharedRef<ServiceType>",
      "docs": "Get a service of the specified type.\nUnlike GetService(), this method will assert if a service instance of\nthe specified type does not exist.\n@param ServiceType The type of service to get.\n@return The service instance.\n@see GetService"
    }
  ]
}