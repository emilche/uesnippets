      "docs": "Returns true if the associated requests are complete and the optional callback was invoked."
    },
    {
      "id": "get-overall-status",
      "name": "GetOverallStatus",
      "category": "DerivedData",
      "signature": "GetOverallStatus(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoResponse*"
        }
      ],
      "returnType": "EDerivedDataIoStatus",
      "docs": "Returns the overall status of the requests. See EDerivedDataIoStatus.\nThe status of the overall response is, in priority order,\n- Unknown if any request status is Unknown, or\n- Canceled if any request status is Canceled, or\n- Error if any request status is Error, otherwise\n- Ok because every request status must be Ok."
    },
    {
      "id": "get-status",
      "name": "GetStatus",
      "category": "DerivedData",
      "signature": "GetStatus(Target, Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoResponse*"
        },
        {
          "name": "Handle",
          "type": "FDerivedDataIoRequest"
        }
      ],
      "returnType": "EDerivedDataIoStatus",
      "docs": "Returns the status of the request. See EDerivedDataIoStatus."
    },
    {
      "id": "get-data",
      "name": "GetData",
      "category": "DerivedData",
      "signature": "GetData(Target, Handle)",
      "params": [
