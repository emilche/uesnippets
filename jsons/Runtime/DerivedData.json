    {
      "id": "read",
      "name": "Read",
      "category": "DerivedData",
      "signature": "Read(Target, Data, Options)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoBatch*"
        },
        {
          "name": "Data",
          "type": "FDerivedData&"
        },
        {
          "name": "Options",
          "type": "FDerivedDataIoOptions&",
          "default": "{}"
        }
      ],
      "returnType": "FDerivedDataIoRequest",
      "docs": "Reads the derived data into memory. Not executed until Dispatch() is invoked.\nThe data, size, and status will be available on the response.\n@return A request to query the response with. May be discarded by the caller if not needed."
    },
    {
      "id": "cache",
      "name": "Cache",
      "category": "DerivedData",
      "signature": "Cache(Target, Data, Options)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoBatch*"
        },
        {
          "name": "Data",
          "type": "FDerivedData&"
        },
        {
          "name": "Options",
          "type": "FDerivedDataIoOptions&",
          "default": "{}"
        }
      ],
      "returnType": "FDerivedDataIoRequest",
      "docs": "Caches the derived data into local storage without loading it. Not executed until Dispatch() is invoked.\nThe size and status will be available on the response. Status is Ok if it caches and Error if not.\n@return A request to query the response with. May be discarded by the caller if not needed."
    },
    {
      "id": "exists",
      "name": "Exists",
      "category": "DerivedData",
      "signature": "Exists(Target, Data, Options)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoBatch*"
        },
        {
          "name": "Data",
          "type": "FDerivedData&"
        },
        {
          "name": "Options",
          "type": "FDerivedDataIoOptions&",
          "default": "{}"
        }
      ],
      "returnType": "FDerivedDataIoRequest",
      "docs": "Caches the derived data into local storage without loading it. Not executed until Dispatch() is invoked.\nThe size and status will be available on the response. Status is Ok if it exists and Error if not.\n@return A request to query the response with. May be discarded by the caller if not needed."
    },
    {
      "id": "compress",
      "name": "Compress",
      "category": "DerivedData",
      "signature": "Compress(Target, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoBatch*"
        },
        {
          "name": "Data",
          "type": "FDerivedData&"
        }
      ],
      "returnType": "FDerivedDataIoRequest",
      "docs": "Compresses the derived data. Not executed until Dispatch() is invoked.\nThe compressed data, size, and status will be available on the response.\n@return A request to query the response with. May be discarded by the caller if not needed."
    },
    {
      "id": "dispatch-9cabe6",
      "name": "Dispatch",
      "category": "DerivedData",
      "signature": "Dispatch(Target, Out Response)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoBatch*"
        },
        {
          "name": "Out Response",
          "type": "FDerivedDataIoResponse&"
        }
      ],
      "returnType": "Void",
      "docs": "Dispatches the requests that have been queued to this batch and resets this batch to empty.\nThe response must be kept alive until the batch completes, otherwise it will be automatically canceled.\n@param OutResponse   Response that is assigned before any requests begin executing.\n@param Priority      Priority of this batch relative to other batches.\n@param OnComplete    Completion callback invoked when the entire batch is complete or canceled."
    },
    {
      "id": "dispatch-0b0a6a",
