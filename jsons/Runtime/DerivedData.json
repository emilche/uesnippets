    {
      "id": "cancel",
      "name": "Cancel",
      "category": "DerivedData",
      "signature": "Cancel(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoResponse*"
        }
      ],
      "returnType": "Bool",
      "docs": "Cancels the associated requests if they are not complete.\n@return true if cancellation completed synchronously, or false if further polling is needed."
    },
    {
      "id": "poll",
      "name": "Poll",
      "category": "DerivedData",
      "signature": "Poll(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedDataIoResponse*"
        }
      ],
