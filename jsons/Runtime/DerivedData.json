    {
      "id": "f-derived-data-io-options-3d8d16",
      "name": "FDerivedDataIoOptions",
      "category": "DerivedData",
      "signature": "FDerivedDataIoOptions(Target, Target View, Source Offset, Get Size, Source Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedData*"
        },
        {
          "name": "Target View",
          "type": "FMutableMemoryView"
        },
        {
          "name": "Source Offset",
          "type": "UInt64",
          "default": "0)\n\t\t: Target(TargetView.GetData())"
        },
        {
          "name": "Get Size",
          "type": "Size ( TargetView ."
        },
        {
          "name": "Source Offset",
          "type": "Offset ("
        }
      ],
      "returnType": "Void",
      "docs": "Reads referenced data into the target view, with an optional offset into the source data.\nThe size of the data from the source offset must be at least the size of the target view."
    },
    {
      "id": "f-derived-data-io-options-60c01c",
      "name": "FDerivedDataIoOptions",
      "category": "DerivedData",
      "signature": "FDerivedDataIoOptions(Target, Source Offset, Source Size, Source Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FDerivedData*"
        },
        {
          "name": "Source Offset",
          "type": "UInt64"
        },
        {
          "name": "Source Size",
          "type": "UInt64",
          "default": "MAX_uint64)\n\t\t: Size(SourceSize)"
        },
        {
          "name": "Source Offset",
          "type": "Offset ("
        }
      ],
      "returnType": "Void",
      "docs": "Reads referenced data into a buffer that is allocated on demand, with an optional offset into the source data.\nThe size of the data from the source offset must be at least the given source size, if not MAX_uint64."
