      "id": "get-debug-description",
      "name": "GetDebugDescription",
      "category": "GameplayTask",
      "signature": "GetDebugDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGameplayResourceSet*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "ready-for-activation",
      "name": "ReadyForActivation",
      "category": "Gameplay Tasks",
      "signature": "ReadyForActivation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "Void",
      "docs": "Called to trigger the actual task once the delegates have been set up"
    },
    {
      "id": "activate",
      "name": "Activate",
      "category": "GameplayTask",
      "signature": "Activate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "Void",
      "docs": "Called to trigger the actual task once the delegates have been set up\nNote that the default implementation does nothing and you don't have to call it"
    },
    {
      "id": "external-confirm",
      "name": "ExternalConfirm",
      "category": "GameplayTask",
      "signature": "ExternalConfirm(Target, End Task)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        },
        {
          "name": "End Task",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the task is asked to confirm from an outside node. What this means depends on the individual task. By default, this does nothing other than ending if bEndTask is true."
    },
    {
      "id": "external-cancel",
      "name": "ExternalCancel",
      "category": "GameplayTask",
      "signature": "ExternalCancel(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "Void",
      "docs": "Called when the task is asked to cancel from an outside node. What this means depends on the individual task. By default, this does nothing other than ending the task."
    },
    {
      "id": "get-debug-string",
      "name": "GetDebugString",
      "category": "GameplayTask",
      "signature": "GetDebugString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "String",
      "docs": "Return debug string describing task"
    },
    {
      "id": "get-world",
      "name": "GetWorld",
      "category": "GameplayTask",
      "signature": "GetWorld(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "UWorld*",
      "docs": "Helper function for getting UWorld off a task"
    },
    {
      "id": "get-owner-actor",
      "name": "GetOwnerActor",
      "category": "GameplayTask",
      "signature": "GetOwnerActor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "AActor*",
      "docs": "Proper way to get the owning actor of task owner. This can be the owner itself since the owner is given as a interface"
    },
    {
      "id": "get-avatar-actor",
      "name": "GetAvatarActor",
      "category": "GameplayTask",
      "signature": "GetAvatarActor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "AActor*",
      "docs": "Proper way to get the avatar actor associated with the task owner (usually a pawn, tower, etc)"
    },
    {
      "id": "end-task",
      "name": "EndTask",
      "category": "GameplayTasks",
      "signature": "EndTask(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "Void",
      "docs": "Called explicitly to end the task (usually by the task itself). Calls OnDestroy.\n@NOTE: you need to call EndTask before sending out any \"on completed\" delegates.\nIf you don't the task will still be in an \"active\" state while the event receivers may\nassume it's already \"finished\""
    },
    {
      "id": "add-required-resource-set",
      "name": "AddRequiredResourceSet",
      "category": "GameplayTask",
      "signature": "AddRequiredResourceSet(Target, Required Resource Set)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        },
        {
          "name": "Required Resource Set",
          "type": "TArray<TSubclassOf<UGameplayTaskResource>>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "add-claimed-resource",
      "name": "AddClaimedResource",
