    {
      "id": "on-destroy",
      "name": "OnDestroy",
      "category": "GameplayTask",
      "signature": "OnDestroy(Target, In Owner Finished)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        },
        {
          "name": "In Owner Finished",
          "type": "Bool"
        }
      ],
      "returnType": "protected : void",
      "docs": "End and CleanUp the task - may be called by the task itself or by the task owner if the owner is ending.\nIMPORTANT! Do NOT call directly! Call EndTask() or TaskOwnerEnded()\nIMPORTANT! When overriding this function make sure to call Super::OnDestroy(bOwnerFinished) as the last thing,\nsince the function internally marks the task as \"Pending Kill\", and this may interfere with internal BP mechanics"
    },
