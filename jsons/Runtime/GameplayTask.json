      "docs": "Called when task owner has \"ended\" (before the task ends) kills the task. Calls OnDestroy."
    },
    {
      "id": "end-task",
      "name": "EndTask",
      "category": "GameplayTasks",
      "signature": "EndTask(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UGameplayTask*"
        }
      ],
      "returnType": "Void",
      "docs": "Called explicitly to end the task (usually by the task itself). Calls OnDestroy.\n@NOTE: you need to call EndTask before sending out any \"on completed\" delegates.\nIf you don't the task will still be in an \"active\" state while the event receivers may\nassume it's already \"finished\""
    },
    {
      "id": "add-required-resource",
      "name": "AddRequiredResource",
      "category": "GameplayTask",
      "signature": "AddRequiredResource(Target, Required Resource)",
      "params": [
        {
          "name": "Target",
          "type": "T*"
        },
        {
          "name": "Required Resource",
          "type": "TSubclassOf<UGameplayTaskResource>"
        }
      ],
      "returnType": "Void",
      "docs": "Marks this task as requiring specified resource which has a number of consequences,\nlike task not being able to run if the resource is already taken.\n@note: Calling this function makes sense only until the task is being passed over to the GameplayTasksComponent.\nOnce that's that resources data is consumed and further changes won't get applied"
    },
