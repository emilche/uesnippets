        {
          "name": "In Icon Size",
          "type": "EPlatformIconSize"
        }
      ],
      "returnType": "Name",
      "docs": "Information about where to find the platform icons (for use by FAppStyle)"
    },
    {
      "id": "get-icon-path",
      "name": "GetIconPath",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetIconPath(Target, In Icon Size)",
      "params": [
        {
          "name": "Target",
