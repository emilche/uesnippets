{
  "id": "data-driven-platform-info-registry",
  "label": "DataDrivenPlatformInfoRegistry",
  "includepath": "Misc/DataDrivenPlatformInfoRegistry.h",
  "includes": [
    "Array",
    "Map",
    "UnrealString",
    "CoreTypes",
    "PlatformCrt",
    "Text",
    "Guid",
    "NameTypes",
    "UnrealNames"
  ],
  "functions": [
    {
      "id": "get-all-platform-infos",
      "name": "GetAllPlatformInfos",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetAllPlatformInfos()",
      "params": [],
      "returnType": "TMap<FName,FDataDrivenPlatformInfo>&",
      "docs": "Get the global set of data driven platform information"
    },
    {
      "id": "get-platform-directory-names",
      "name": "GetPlatformDirectoryNames",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetPlatformDirectoryNames(Check Valid)",
      "params": [
        {
          "name": "Check Valid",
          "type": "Bool"
        }
      ],
      "returnType": "TArray<FString>&",
      "docs": "Gets a set of platform names based on GetAllPlatformInfos, their AdditionalRestrictedFolders\nThis is not necessarily the same as IniParents, although there is overlap - IniParents come from chaining DDPIs, so those will be in GetAllPlatformInfos already to be checked\n@param bCheckValid\tIf true, the result is filtered based on what editor has support compiled for"
    },
    {
      "id": "get-platform-info",
      "name": "GetPlatformInfo",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetPlatformInfo(Platform Name)",
      "params": [
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "FDataDrivenPlatformInfo&",
      "docs": "Get the data driven platform info for a given platform. If the platform doesn't have any on disk,\nthis will return a default constructed FConfigDataDrivenPlatformInfo"
    },
    {
      "id": "get-sorted-platform-names",
      "name": "GetSortedPlatformNames",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetSortedPlatformNames(Platform Type)",
      "params": [
        {
          "name": "Platform Type",
          "type": "EPlatformInfoType"
        }
      ],
      "returnType": "TArray<FName>",
      "docs": "Get sorted platorm infos or names. PlatformType is used to choose between true platforms and platform groups (or other fake platforms)"
    },
    {
      "id": "get-sorted-platform-infos",
      "name": "GetSortedPlatformInfos",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetSortedPlatformInfos(Platform Type)",
      "params": [
        {
          "name": "Platform Type",
          "type": "EPlatformInfoType"
        }
      ],
      "returnType": "TArray<FDataDrivenPlatformInfo*>&"
    },
    {
      "id": "get-confidential-platforms",
      "name": "GetConfidentialPlatforms",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetConfidentialPlatforms()",
      "params": [],
      "returnType": "TArray<FName>&",
      "docs": "Gets a list of all known confidential platforms (note these are just the platforms you have access to, so, for example PS4 won't be\nreturned if you are not a PS4 licensee)"
    },
    {
      "id": "get-num-data-driven-ini-files",
      "name": "GetNumDataDrivenIniFiles",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetNumDataDrivenIniFiles()",
      "params": [],
      "returnType": "Int",
      "docs": "Returns the number of discovered ini files that can be loaded with LoadDataDrivenIniFile"
    },
    {
      "id": "load-data-driven-ini-file",
      "name": "LoadDataDrivenIniFile",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "LoadDataDrivenIniFile(Index, Ini File, Platform Name)",
      "params": [
        {
          "name": "Index",
          "type": "Int"
        },
        {
          "name": "Ini File",
          "type": "FConfigFile&"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Load the given ini file, and"
    },
    {
      "id": "has-compiled-support-for-platform",
      "name": "HasCompiledSupportForPlatform",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "HasCompiledSupportForPlatform(Platform Name, Platform Name Type)",
      "params": [
        {
          "name": "Platform Name",
          "type": "Name"
        },
        {
          "name": "Platform Name Type",
          "type": "EPlatformNameType"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks for the existence of compiled modules for a given (usually another, target, platform)\nSince there are different types of platform names, it is necessary pass in the type of name"
    },
    {
      "id": "clear-device-status",
      "name": "ClearDeviceStatus",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "ClearDeviceStatus(Platform Name)",
      "params": [
        {
          "name": "Platform Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Wipes out cached device status for all devices in a platform (or all platforms if PlatformName is empty)"
    },
    {
      "id": "device-id-to-info",
      "name": "DeviceIdToInfo",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "DeviceIdToInfo(Device Id, Out Device Name)",
      "params": [
        {
          "name": "Device Id",
          "type": "String"
        },
        {
          "name": "Out Device Name",
          "type": "String*",
          "default": "nullptr"
        }
      ],
      "returnType": "FDataDrivenPlatformInfo&"
    },
    {
      "id": "get-all-preview-platform-menu-items",
      "name": "GetAllPreviewPlatformMenuItems",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetAllPreviewPlatformMenuItems()",
      "params": [],
      "returnType": "TArray<struct FPreviewPlatformMenuItem>&",
      "docs": "Retrieve the full list of all known preview platforms from all DDPIs"
    },
    {
      "id": "is-platform-hidden-from-ui",
      "name": "IsPlatformHiddenFromUI",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "IsPlatformHiddenFromUI(Platform Name)",
      "params": [
        {
          "name": "Platform Name",
          "type": "Name"
        }
      ],
      "returnType": "Bool",
      "docs": "Option to hide a platform from the user interface at runtime"
    },
    {
      "id": "set-platform-hidden-from-ui",
      "name": "SetPlatformHiddenFromUI",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "SetPlatformHiddenFromUI(Platform Name)",
      "params": [
        {
          "name": "Platform Name",
          "type": "Name"
        }
      ],
      "returnType": "Void"
    }
  ]
}