        },
        {
          "name": "In Icon Size",
          "type": "EPlatformIconSize"
        }
      ],
      "returnType": "String&",
      "docs": "Get the path to the icon on disk (for FAppStyle) for the given icon type for this platform"
    },
    {
      "id": "get-all-platform-infos",
      "name": "GetAllPlatformInfos",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetAllPlatformInfos()",
      "params": [],
      "returnType": "TMap<FName,FDataDrivenPlatformInfo>&",
      "docs": "Get the global set of data driven platform information"
    },
    {
      "id": "get-platform-directory-names",
      "name": "GetPlatformDirectoryNames",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetPlatformDirectoryNames(Check Valid)",
      "params": [
        {
          "name": "Check Valid",
          "type": "Bool"
        }
      ],
      "returnType": "TArray<FString>&",
      "docs": "Gets a set of platform names based on GetAllPlatformInfos, their AdditionalRestrictedFolders\nThis is not necessarily the same as IniParents, although there is overlap - IniParents come from chaining DDPIs, so those will be in GetAllPlatformInfos already to be checked\n@param bCheckValid\tIf true, the result is filtered based on what editor has support compiled for"
    },
    {
      "id": "get-valid-platform-directory-names",
      "name": "GetValidPlatformDirectoryNames",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetValidPlatformDirectoryNames()",
      "params": [],
      "returnType": "TArray<FString>&",
      "docs": "Gets a set of platform names based on GetAllPlatformInfos, their AdditionalRestrictedFolders, and possibly filtered based on what editor has support compiled for\nThis is not necessarily the same as IniParents, although there is overlap - IniParents come from chaining DDPIs, so those will be in GetAllPlatformInfos already to be checked"
    },
    {
      "id": "get-platform-info",
      "name": "GetPlatformInfo",
      "category": "DataDrivenPlatformInfoRegistry",
      "signature": "GetPlatformInfo(Platform Name)",
      "params": [
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "FDataDrivenPlatformInfo&",
      "docs": "Get the data driven platform info for a given platform. If the platform doesn't have any on disk,\nthis will return a default constructed FConfigDataDrivenPlatformInfo"
    },
    {
