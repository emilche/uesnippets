{
  "id": "movie-scene-channel-editor-data",
  "label": "MovieSceneChannelEditorData",
  "includepath": "Channels/MovieSceneChannelEditorData.h",
  "includes": [
    "Platform",
    "Text",
    "Color",
    "Optional",
    "MovieSceneCommonHelpers",
    "Function",
    "NameTypes",
    "FrameNumber",
    "Attribute"
  ],
  "functions": [
    {
      "id": "set-identifiers",
      "name": "SetIdentifiers",
      "category": "MovieSceneChannelEditorData",
      "signature": "SetIdentifiers(Target, In Name, In Display Text, In Group)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneChannelMetaData*"
        },
        {
          "name": "In Name",
          "type": "Name"
        },
        {
          "name": "In Display Text",
          "type": "Text"
        },
        {
          "name": "In Group",
          "type": "Text",
          "default": "FText()"
        }
      ],
      "returnType": "Void",
      "docs": "Set the identifiers for this editor data\n@param InName           The unique name of this channel within the section\n@param InDisplayText    Text to display on the sequencer node tree\n@param InGroup          (Optional) When not empty, specifies a name to group channels by"
    },
    {
      "id": "get-property-meta-data",
      "name": "GetPropertyMetaData",
      "category": "MovieSceneChannelEditorData",
      "signature": "GetPropertyMetaData(Target, In Key)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneChannelMetaData*"
        },
        {
          "name": "In Key",
          "type": "Name&"
        }
      ],
      "returnType": "String",
      "docs": "Get property metadata that corresponds to the given key.\n@param InKey The requested key to get metadata for"
    },
    {
      "id": "get-offset-time",
      "name": "GetOffsetTime",
      "category": "MovieSceneChannelEditorData",
      "signature": "GetOffsetTime(Target, In Section)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneChannelMetaData*"
        },
        {
          "name": "In Section",
          "type": "UMovieSceneSection*"
        }
      ],
      "returnType": "FFrameNumber",
      "docs": "Get the amount that all of this channel's keys are offset by"
    }
  ]
}