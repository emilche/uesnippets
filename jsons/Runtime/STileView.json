{
  "id": "s-tile-view",
  "label": "STileView",
  "includepath": "Widgets/Views/STileView.h",
  "includes": [
    "CoreMinimal",
    "InputCoreTypes",
    "Visibility",
    "DeclarativeSyntaxSupport",
    "Reply",
    "SlateTypes",
    "SlateDelegates",
    "STextBlock",
    "STableViewBase",
    "TableViewTypeTraits",
    "Overscroll",
    "SListView"
  ],
  "functions": [
    {
      "id": "on-navigation",
      "name": "OnNavigation",
      "category": "STileView",
      "signature": "OnNavigation(Target, My Geometry, In Navigation Event)",
      "params": [
        {
          "name": "Target",
          "type": "STileView*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "In Navigation Event",
          "type": "FNavigationEvent&"
        }
      ],
      "returnType": "FNavigationReply"
    },
    {
      "id": "re-generate-items",
      "name": "ReGenerateItems",
      "category": "STileView",
      "signature": "ReGenerateItems(Target, My Geometry)",
      "params": [
        {
          "name": "Target",
          "type": "STileView*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        }
      ],
      "returnType": "STableViewBase::FReGenerateResults"
    },
    {
      "id": "get-num-items-being-observed",
      "name": "GetNumItemsBeingObserved",
      "category": "STileView",
      "signature": "GetNumItemsBeingObserved(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STileView*"
        }
      ],
      "returnType": "Int"
    }
  ]
}