    {
      "id": "vertices",
      "name": "Vertices",
      "category": "DynamicGraph2",
      "signature": "Vertices(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicGraph2*"
        }
      ],
      "returnType": "value_iteration<TVector2<T>>",
      "docs": "void AppendGraph(FDynamicGraph2 graph, int gid = -1)\n{\nint[] mapV = new int[graph.MaxVertexID];\nforeach(int vid in graph.VertexIndices()) {\nmapV[vid] = this.AppendVertex(graph.GetVertex(vid));\n}\nforeach(int eid in graph.EdgeIndices()) {\nFIndex2i ev = graph.GetEdgeV(eid);\nint use_gid = (gid == -1) ? graph.GetEdgeGroup(eid) : gid;\nthis.AppendEdge(mapV[ev.A], mapV[ev.B], use_gid);\n}\n}"
    },
