{
  "id": "s-text-combo-popup",
  "label": "STextComboPopup",
  "includepath": "Widgets/Input/STextComboPopup.h",
  "includes": [
    "CoreMinimal",
    "Reply",
    "DeclarativeSyntaxSupport",
    "SWidget",
    "SCompoundWidget",
    "SComboBox"
  ],
  "functions": [
    {
      "id": "on-key-down",
      "name": "OnKeyDown",
      "category": "STextComboPopup",
      "signature": "OnKeyDown(Target, My Geometry, In Key Event)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboPopup*"
        },
        {
          "name": "My Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "In Key Event",
          "type": "FKeyEvent&"
        }
      ],
      "returnType": "FReply",
      "docs": "SWidget interface"
    },
    {
      "id": "make-item-widget",
      "name": "MakeItemWidget",
      "category": "STextComboPopup",
      "signature": "MakeItemWidget(Target, String Item)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboPopup*"
        },
        {
          "name": "String Item",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Called to create a widget for each string"
    },
    {
      "id": "on-ok",
      "name": "OnOK",
      "category": "STextComboPopup",
      "signature": "OnOK(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboPopup*"
        }
      ],
      "returnType": "FReply",
      "docs": "Called when 'OK' button is pressed"
    },
    {
      "id": "focus-default-widget",
      "name": "FocusDefaultWidget",
      "category": "STextComboPopup",
      "signature": "FocusDefaultWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboPopup*"
        }
      ],
      "returnType": "Void",
      "docs": "focuses the control on the OK button"
    }
  ]
}