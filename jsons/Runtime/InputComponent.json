{
  "id": "input-component",
  "label": "InputComponent",
  "includepath": "Components/InputComponent.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "InputCoreTypes",
    "ActorComponent",
    "InputChord",
    "InputComponent.generated"
  ],
  "functions": [
    {
      "id": "on-input-owner-end-played",
      "name": "OnInputOwnerEndPlayed",
      "category": "InputComponent",
      "signature": "OnInputOwnerEndPlayed(Target, In Owner, End Play Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FCachedKeyToActionInfo*"
        },
        {
          "name": "In Owner",
          "type": "AActor*"
        },
        {
          "name": "End Play Reason",
          "type": "EEndPlayReason::Type"
        }
      ],
      "returnType": "class UInputComponent : public UActorComponent"
    },
    {
      "id": "is-controller-key-down",
      "name": "IsControllerKeyDown",
      "category": "InputComponent",
      "signature": "IsControllerKeyDown(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "struct FGetActionsBoundToKey",
      "docs": "Returns true if the given key/button is pressed on the input of the controller (if present)"
    },
    {
      "id": "was-controller-key-just-pressed",
      "name": "WasControllerKeyJustPressed",
      "category": "InputComponent",
      "signature": "WasControllerKeyJustPressed(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the given key/button was up last frame and down this frame."
    },
    {
      "id": "was-controller-key-just-released",
      "name": "WasControllerKeyJustReleased",
      "category": "InputComponent",
      "signature": "WasControllerKeyJustReleased(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the given key/button was down last frame and up this frame."
    },
    {
      "id": "get-controller-analog-key-state",
      "name": "GetControllerAnalogKeyState",
      "category": "InputComponent",
      "signature": "GetControllerAnalogKeyState(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Float",
      "docs": "Returns the analog value for the given key/button.  If analog isn't supported, returns 1 for down and 0 for up."
    },
    {
      "id": "get-controller-vector-key-state",
      "name": "GetControllerVectorKeyState",
      "category": "InputComponent",
      "signature": "GetControllerVectorKeyState(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "FVector",
      "docs": "Returns the vector value for the given key/button."
    },
    {
      "id": "get-touch-state",
      "name": "GetTouchState",
      "category": "InputComponent",
      "signature": "GetTouchState(Target, Finger Index, Location X, Location Y, Is Currently Pressed)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Finger Index",
          "type": "Int"
        },
        {
          "name": "Location X",
          "type": "Float&"
        },
        {
          "name": "Location Y",
          "type": "Float&"
        },
        {
          "name": "Is Currently Pressed",
          "type": "Bool&"
        }
      ],
      "returnType": "Void",
      "docs": "Returns the location of a touch, and if it's held down"
    },
    {
      "id": "get-controller-key-time-down",
      "name": "GetControllerKeyTimeDown",
      "category": "InputComponent",
      "signature": "GetControllerKeyTimeDown(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Float",
      "docs": "Returns how long the given key/button has been down.  Returns 0 if it's up or it just went down this frame."
    },
    {
      "id": "get-controller-mouse-delta",
      "name": "GetControllerMouseDelta",
      "category": "InputComponent",
      "signature": "GetControllerMouseDelta(Target, Delta X, Delta Y)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Delta X",
          "type": "Float&"
        },
        {
          "name": "Delta Y",
          "type": "Float&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieves how far the mouse moved this frame."
    },
    {
      "id": "get-controller-analog-stick-state",
      "name": "GetControllerAnalogStickState",
      "category": "InputComponent",
      "signature": "GetControllerAnalogStickState(Target, Which Stick, Stick X, Stick Y)",
      "params": [
        {
          "name": "Target",
          "type": "UInputComponent*"
        },
        {
          "name": "Which Stick",
          "type": "EControllerAnalogStick::Type"
        },
        {
          "name": "Stick X",
          "type": "Float&"
        },
        {
          "name": "Stick Y",
          "type": "Float&"
        }
      ],
      "returnType": "Void",
      "docs": "Retrieves the X and Y displacement of the given analog stick.  For WhickStick, 0 = left, 1 = right."
    }
  ]
}