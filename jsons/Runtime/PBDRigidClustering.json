      "id": "create-cluster-particle",
      "name": "CreateClusterParticle",
      "category": "PBDRigidClustering",
      "signature": "CreateClusterParticle(Target, Cluster Group Index, Children, Parameters, Proxy Geometry, Force Mass Orientation, Existing Index)",
      "params": [
        {
          "name": "Target",
          "type": "FRigidClustering*"
        },
        {
          "name": "Cluster Group Index",
          "type": "Int"
        },
        {
          "name": "Children",
          "type": "TArray<Chaos::FPBDRigidParticleHandle*>&&"
        },
        {
          "name": "Parameters",
          "type": "FClusterCreationParameters&",
          "default": "FClusterCreationParameters()"
        },
        {
          "name": "Proxy Geometry",
          "type": "Chaos::FImplicitObjectPtr&",
          "default": "nullptr"
        },
        {
          "name": "Force Mass Orientation",
          "type": "FRigidTransform3*",
          "default": "nullptr"
        },
        {
          "name": "Existing Index",
          "type": "FUniqueIdx*",
          "default": "nullptr"
        }
      ],
      "returnType": "Chaos::FPBDRigidClusteredParticleHandle*",
      "docs": "Initialize a cluster with the specified children.\n\\p ClusterGroupIndex - Index to join cluster into.\n\\p Children - List of children that should belong to the cluster\n\\p Parameters - ClusterParticleHandle must be valid, this is the parent cluster body.\nProxyGeometry : Collision default for the cluster, automatically generated otherwise.\nForceMassOrientation : Inertial alignment into mass space."
    },
