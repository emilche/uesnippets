    {
      "id": "reset",
      "name": "Reset",
      "category": "SolverConstraintContainer",
      "signature": "Reset(Target, Max Constraints)",
      "params": [
        {
          "name": "Target",
          "type": "TSimpleConstraintContainerSolver*"
        },
        {
          "name": "Max Constraints",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the maximum number of constraints the solver will have to handle.\nThis will be called only once per tick, so containers resized here will not have to resize again this tick\nso that pointers to elements in the container will remain valid for the tick (but not beyond)."
    },
