    {
      "id": "lerp-using-hsv",
      "name": "LerpUsingHSV",
      "category": "Color",
      "signature": "LerpUsingHSV(From, To, Progress)",
      "params": [
        {
          "name": "From",
          "type": "FLinearColor&"
        },
        {
          "name": "To",
          "type": "FLinearColor&"
        },
        {
          "name": "Progress",
          "type": "Float"
        }
      ],
      "returnType": "nodiscard ] ] FLinearColor",
      "docs": "Linearly interpolates between two colors by the specified progress amount.  The interpolation is performed in HSV color space\ntaking the shortest path to the new color's hue.  This can give better results than FMath::Lerp(), but is much more expensive.\nThe incoming colors are in RGB space, and the output color will be RGB.  The alpha value will also be interpolated.\n@param\tFrom\t\tThe color and alpha to interpolate from as linear RGBA\n@param\tTo\t\t\tThe color and alpha to interpolate to as linear RGBA\n@param\tProgress\tScalar interpolation amount (usually between 0.0 and 1.0 inclusive)\n@return\tThe interpolated color in linear RGB space along with the interpolated alpha value"
    },
