    {
      "id": "append-tags",
      "name": "AppendTags",
      "category": "GameplayTagContainer",
      "signature": "AppendTags(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FGameplayTagContainer*"
        },
        {
          "name": "Other",
          "type": "FGameplayTagContainer&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds all the tags from one container to this container\nNOTE: From set theory, this effectively is the union of the container this is called on with Other.\n@param Other TagContainer that has the tags you want to add to this container"
    },
    {
      "id": "append-matching-tags",
      "name": "AppendMatchingTags",
      "category": "GameplayTagContainer",
      "signature": "AppendMatchingTags(Target, Other A, Other B)",
      "params": [
        {
          "name": "Target",
          "type": "FGameplayTagContainer*"
        },
        {
          "name": "Other A",
          "type": "FGameplayTagContainer&"
        },
        {
          "name": "Other B",
          "type": "FGameplayTagContainer&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds all the tags that match between the two specified containers to this container.  WARNING: This matches any\nparent tag in A, not just exact matches!  So while this should be the union of the container this is called on with\nthe intersection of OtherA and OtherB, it's not exactly that.  Since OtherB matches against its parents, any tag\nin OtherA which has a parent match with a parent of OtherB will count.  For example, if OtherA has Color.Green\nand OtherB has Color.Red, that will count as a match due to the Color parent match!\nIf you want an exact match, you need to call A.FilterExact(B) (above) to get the intersection of A with B.\nIf you need the disjunctive union (the union of two sets minus their intersection), use AppendTags to create\nUnion, FilterExact to create Intersection, and then call Union.RemoveTags(Intersection).\n@param OtherA TagContainer that has the matching tags you want to add to this container, these tags have their parents expanded\n@param OtherB TagContainer used to check for matching tags.  If the tag matches on any parent, it counts as a match."
    },
