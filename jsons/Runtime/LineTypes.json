{
  "id": "line-types",
  "label": "LineTypes",
  "includepath": "LineTypes.h",
  "includes": [
    "UnrealMath",
    "VectorTypes"
  ],
  "functions": [
    {
      "id": "from-points",
      "name": "FromPoints",
      "category": "LineTypes",
      "signature": "FromPoints(Point 0, Point 1)",
      "params": [
        {
          "name": "Point 0",
          "type": "TVector2<T>&"
        },
        {
          "name": "Point 1",
          "type": "TVector2<T>&"
        }
      ],
      "returnType": "TLine2<T>",
      "docs": "@return line between two points"
    },
    {
      "id": "point-at",
      "name": "PointAt",
      "category": "LineTypes",
      "signature": "PointAt(Target, Line Parameter)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Line Parameter",
          "type": "T"
        }
      ],
      "returnType": "TVector2<T>",
      "docs": "@return point on line at given line parameter value (distance along line from origin)",
      "supportedTargets": [
        "TLine2*",
        "TLine3*"
      ]
    },
    {
      "id": "project",
      "name": "Project",
      "category": "LineTypes",
      "signature": "Project(Target, Query Point)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Query Point",
          "type": "TVector2<T>&"
        }
      ],
      "returnType": "T",
      "docs": "@return line parameter (ie distance from Origin) at nearest point on line to QueryPoint"
    },
    {
      "id": "distance-squared",
      "name": "DistanceSquared",
      "category": "LineTypes",
      "signature": "DistanceSquared(Target, Query Point)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Query Point",
          "type": "TVector2<T>&"
        }
      ],
      "returnType": "T",
      "docs": "@return smallest squared distance from line to QueryPoint"
    },
    {
      "id": "nearest-point",
      "name": "NearestPoint",
      "category": "LineTypes",
      "signature": "NearestPoint(Target, Query Point)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Query Point",
          "type": "TVector2<T>&"
        }
      ],
      "returnType": "TVector2<T>",
      "docs": "@return nearest point on line to QueryPoint"
    },
    {
      "id": "which-side",
      "name": "WhichSide",
      "category": "LineTypes",
      "signature": "WhichSide(Target, Query Point, On Line Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Query Point",
          "type": "TVector2<T>&"
        },
        {
          "name": "On Line Tolerance",
          "type": "T",
          "default": "0"
        }
      ],
      "returnType": "Int",
      "docs": "@return +1 if QueryPoint is \"right\" of line, -1 if \"left\" or 0 if \"on\" line (up to given tolerance)"
    },
    {
      "id": "intersection-point",
      "name": "IntersectionPoint",
      "category": "LineTypes",
      "signature": "IntersectionPoint(Target, Other Line, Intersection Point Out, Parallel Dot Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "TLine2*"
        },
        {
          "name": "Other Line",
          "type": "TLine2<T>&"
        },
        {
          "name": "Intersection Point Out",
          "type": "TVector2<T>&"
        },
        {
          "name": "Parallel Dot Tolerance",
          "type": "T",
          "default": "TMathUtil<T>::ZeroTolerance"
        }
      ],
      "returnType": "Bool",
      "docs": "Calculate intersection point between this line and another one\n@param OtherLine line to test against\n@param IntersectionPointOut intersection point is stored here, if found\n@param ParallelDotTolerance tolerance used to determine if lines are parallel (and hence cannot intersect)\n@return true if lines intersect and IntersectionPointOut was computed"
    }
  ]
}