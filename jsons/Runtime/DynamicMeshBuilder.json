    {
      "id": "f-dynamic-mesh-builder-d17186",
      "name": "FDynamicMeshBuilder",
      "category": "DynamicMeshBuilder",
      "signature": "FDynamicMeshBuilder(In Feature Level, In Num Tex Coords, In Lightmap Coordinate Index, In Use 16 Bit Tex Coord, In Dynamic Mesh Buffer Allocator)",
      "params": [
        {
          "name": "In Feature Level",
          "type": "ERHIFeatureLevel::Type"
        },
        {
          "name": "In Num Tex Coords",
          "type": "UInt",
          "default": "1"
        },
        {
          "name": "In Lightmap Coordinate Index",
          "type": "UInt",
          "default": "0"
        },
        {
          "name": "In Use 16 Bit Tex Coord",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Dynamic Mesh Buffer Allocator",
          "type": "FDynamicMeshBufferAllocator*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "A utility used to construct dynamically generated meshes, and render them to a FPrimitiveDrawInterface.\nNote: This is meant to be easy to use, not fast.  It moves the data around more than necessary, and requires dynamically allocating RHI\nresources.  Exercise caution."
    },
