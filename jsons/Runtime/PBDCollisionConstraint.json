    {
      "id": "contact-constraint-sort-predicate",
      "name": "ContactConstraintSortPredicate",
      "category": "PBDCollisionConstraint",
      "signature": "ContactConstraintSortPredicate(Target, L, R)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDCollisionConstraint*"
        },
        {
          "name": "L",
          "type": "FPBDCollisionConstraint&"
        },
        {
          "name": "R",
          "type": "FPBDCollisionConstraint&"
        }
      ],
      "returnType": "Bool",
      "docs": "@brief A contact constraint\nA contact constraint represents the non-penetration, friction, and restitution constraints for a single\nshape pair on a particle pair. I.e., a specific particle-pair may have multiple contact constraints\nbetween them if one or boht has multuple collision shapes that overlap the shape(s) of the other body.\nEach contact constraint contains a Manifold, which is a set of contact points that approximate the\ncontact patch between the two shapes.\nContact constraints are allocated on the heap (Asee FCollisionConstraintAllocator) and have permanent addresses.\nThey use intrusive handles to reduce unnecessary indirection."
    },
    {
      "id": "calculate-implicit-bounds-test-flags",
      "name": "CalculateImplicitBoundsTestFlags",
      "category": "PBDCollisionConstraint",
      "signature": "CalculateImplicitBoundsTestFlags(Target, Particle 0, Implicit 0, Shape 0, Particle 1, Implicit 1, Shape 1, Out Distance Check Size)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDCollisionConstraint*"
        },
        {
          "name": "Particle 0",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 0",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 0",
          "type": "FPerShapeData*"
        },
        {
          "name": "Particle 1",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 1",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 1",
          "type": "FPerShapeData*"
        },
        {
          "name": "Out Distance Check Size",
          "type": "FRealSingle&"
        }
      ],
      "returnType": "FImplicitBoundsTestFlags"
    },
    {
      "id": "make",
      "name": "Make",
      "category": "PBDCollisionConstraint",
      "signature": "Make(Particle 0, Implicit 0, Shape 0, Simplicial 0, Implicit Local Transform 0, Particle 1, Implicit 1, Shape 1, Simplicial 1, Implicit Local Transform 1, In Cull Distance, In Use Manifold, Shapes Type, Out Constraint)",
      "params": [
        {
          "name": "Particle 0",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 0",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 0",
          "type": "FPerShapeData*"
        },
        {
          "name": "Simplicial 0",
          "type": "FBVHParticles*"
        },
        {
          "name": "Implicit Local Transform 0",
          "type": "FRigidTransform3&"
        },
        {
          "name": "Particle 1",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "Implicit 1",
          "type": "FImplicitObject*"
        },
        {
          "name": "Shape 1",
          "type": "FPerShapeData*"
        },
        {
          "name": "Simplicial 1",
          "type": "FBVHParticles*"
        },
        {
          "name": "Implicit Local Transform 1",
          "type": "FRigidTransform3&"
        },
        {
          "name": "In Cull Distance",
          "type": "FReal"
        },
        {
          "name": "In Use Manifold",
          "type": "Bool"
        },
        {
          "name": "Shapes Type",
          "type": "EContactShapesType"
        },
        {
          "name": "Out Constraint",
          "type": "FPBDCollisionConstraint&"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Create a contact constraint\nInitializes a constraint stored inline in an object. Only intended to be called once right after construction.\nDoes not reinitialize all data so not intended to reset a constraint for reuse with different particles etc."
    },
