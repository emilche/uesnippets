      "id": "has-destination-json-string-char-representation",
      "name": "HasDestinationJsonStringCharRepresentation",
      "category": "JsonWriter",
      "signature": "HasDestinationJsonStringCharRepresentation<DstChar, SrcChar>(Target, Char)",
      "params": [
        {
          "name": "Target",
          "type": "TJsonWriter*"
        },
        {
          "name": "Char",
          "type": "SrcChar"
        }
      ],
      "returnType": "template<DstChar,SrcChar> bool",
      "docs": "Takes an input source char representing and returns if it is possible to represent in DstChar expected encoding\n@param Char source char\n@return false if character is a control char or if it is out of range of representation in case of converting to ANSICHAR. true otherwise"
    },
    {
      "id": "append-escape-json-string",
      "name": "AppendEscapeJsonString",
      "category": "JsonWriter",
      "signature": "AppendEscapeJsonString<StringType>(Target, Append To, String Val)",
      "params": [
        {
          "name": "Target",
          "type": "TJsonWriter*"
        },
        {
          "name": "Append To",
          "type": "StringType&"
        },
        {
          "name": "String Val",
          "type": "String&"
        }
      ],
      "returnType": "template<StringType> StringType&",
      "docs": "Takes an input string and escapes it so it can be written as a valid Json string. Also adds the quotes.\nAppends to a given string-like object to avoid reallocations.\nString-like object must support operator+=(const TCHAR*) and operation+=(TCHAR)\n@param AppendTo the string to append to.\n@param StringVal the string to escape\n@return the AppendTo string for convenience."
    },
    {
      "id": "escape-json-string",
      "name": "EscapeJsonString",
      "category": "JsonWriter",
      "signature": "EscapeJsonString(Target, String Val)",
      "params": [
        {
          "name": "Target",
          "type": "TJsonWriter*"
        },
        {
          "name": "String Val",
          "type": "String&"
        }
      ],
      "returnType": "String",
      "docs": "Takes an input string and escapes it so it can be written as a valid Json string. Also adds the quotes.\n@param StringVal the string to escape\n@return the given string, escaped to produce a valid Json string."
    },
