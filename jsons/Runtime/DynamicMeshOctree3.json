  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "DynamicMeshOctree3",
      "signature": "Initialize(Target, Mesh In)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicMeshOctree3*"
        },
        {
          "name": "Mesh In",
          "type": "FDynamicMesh3*"
        }
      ],
      "returnType": "Void",
      "docs": "FDynamicMeshOctree3 is an extension of FSparseDynamicOctree3 for the triangles of a FDynamicMesh3 instance.\nThis extension does several things:\n1) provides a simplified API based on triangle IDs to various Octree functions\n2) tracks ModifiedBounds box of modified areas\n3) support for computing/updating/querying a \"Cut\" of the octree, ie a set of cells which are roots of sub-branches\nthat partition the tree. This is useful for splitting up mesh processing/rendering into spatially-coherent chunks.\n(This functionality should probably be extracted into a separate class...)"
    },
