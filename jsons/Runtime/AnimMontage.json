    {
      "id": "extract-root-motion-from-track-range",
      "name": "ExtractRootMotionFromTrackRange",
      "category": "AnimMontage",
      "signature": "ExtractRootMotionFromTrackRange(Target, Start Track Position, End Track Position, Context)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimMontage*"
        },
        {
          "name": "Start Track Position",
          "type": "Float"
        },
        {
          "name": "End Track Position",
          "type": "Float"
        },
        {
          "name": "Context",
          "type": "FAnimExtractContext&"
        }
      ],
      "returnType": "FTransform",
      "docs": "Extract RootMotion Transform from a contiguous Track position range.\n*CONTIGUOUS* means that if playing forward StartTractPosition < EndTrackPosition.\nNo wrapping over if looping. No jumping across different sections.\nSo the AnimMontage has to break the update into contiguous pieces to handle those cases.\nThis does handle Montage playing backwards (StartTrackPosition > EndTrackPosition).\nIt will break down the range into steps if needed to handle looping animations, or different animations.\nThese steps will be processed sequentially, and output the RootMotion transform in component space."
    },
