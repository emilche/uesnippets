      "id": "get-section-meta-data",
      "name": "GetSectionMetaData",
      "category": "AnimMontage",
      "signature": "GetSectionMetaData(Target, Section Name, Include Sequence, Slot Name)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimMontage*"
        },
        {
          "name": "Section Name",
          "type": "Name"
        },
        {
          "name": "Include Sequence",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Slot Name",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "TArray<class UAnimMetaData*>",
      "docs": "Get Section Metadata for the montage including metadata belong to the anim reference\nThis will remove redundant entry if found - i.e. multiple same anim reference is used\n@param : SectionName - Name of section you'd like to get meta data for.\n- If SectionName == NONE, it will return all the section data\n@param : bIncludeSequence - if true, it returns all metadata of the animation within that section\n- whether partial or full\n@param : SlotName - this only matters if bIncludeSequence is true.\n- If true, and if SlotName is given, it will only look for SlotName.\n- If true and if SlotName is none, then it will look for all slot nodes\n*"
    },
