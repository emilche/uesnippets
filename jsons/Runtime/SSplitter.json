    {
      "id": "get-children",
      "name": "GetChildren",
      "category": "SSplitter",
      "signature": "GetChildren(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SSplitter*"
        }
      ],
      "returnType": "FChildren*",
      "docs": "All widgets must provide a way to access their children in a layout-agnostic way.\nPanels store their children in Slots, which creates a dilemma. Most panels\ncan store their children in a TPanelChildren<Slot>, where the Slot class\nprovides layout information about the child it stores. In that case\nGetChildren should simply return the TPanelChildren<Slot>. See StackPanel for an example."
    },
