      "category": "AnimSyncScope",
      "signature": "FAnimSyncDebugInfo(In Context)",
      "params": [
        {
          "name": "In Context",
          "type": "FAnimationBaseContext&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "f-anim-sync-group-scope",
      "name": "FAnimSyncGroupScope",
      "category": "AnimSyncScope",
      "signature": "FAnimSyncGroupScope(In Context, In Sync Group, In Group Role)",
      "params": [
        {
          "name": "In Context",
          "type": "FAnimationBaseContext&"
        },
        {
          "name": "In Sync Group",
          "type": "Name",
          "default": "NAME_None"
        },
        {
          "name": "In Group Role",
          "type": "EAnimGroupRole::Type",
          "default": "EAnimGroupRole::CanBeLeader"
        }
      ],
      "returnType": "public :"
    },
    {
      "id": "add-tick-record",
      "name": "AddTickRecord",
      "category": "AnimSyncScope",
      "signature": "AddTickRecord(Target, In Tick Record, In Sync Params, In Debug Info)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimSyncGroupScope*"
        },
        {
          "name": "In Tick Record",
          "type": "FAnimTickRecord&"
        },
        {
          "name": "In Sync Params",
          "type": "FAnimSyncParams&",
          "default": "FAnimSyncParams()"
        },
        {
          "name": "In Debug Info",
          "type": "FAnimSyncDebugInfo&",
          "default": "FAnimSyncDebugInfo()"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-mirror",
      "name": "SetMirror",
      "category": "AnimSyncScope",
      "signature": "SetMirror(Target, Mirror Data Table)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimSyncGroupScope*"
        },
        {
          "name": "Mirror Data Table",
          "type": "UMirrorDataTable*"
        }
      ],
      "returnType": "Void"
    }
  ]
}