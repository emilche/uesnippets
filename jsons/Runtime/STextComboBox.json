{
  "id": "s-text-combo-box",
  "label": "STextComboBox",
  "includepath": "Widgets/Input/STextComboBox.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "Margin",
    "SlateColor",
    "SlateFontInfo",
    "DeclarativeSyntaxSupport",
    "SWidget",
    "SCompoundWidget",
    "SlateTypes",
    "CoreStyle",
    "SlateDelegates",
    "SComboBox"
  ],
  "functions": [
    {
      "id": "make-item-widget",
      "name": "MakeItemWidget",
      "category": "STextComboBox",
      "signature": "MakeItemWidget(Target, String Item)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "String Item",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Called to create a widget for each string"
    },
    {
      "id": "set-selected-item",
      "name": "SetSelectedItem",
      "category": "STextComboBox",
      "signature": "SetSelectedItem(Target, New Selection)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "New Selection",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-selected-item",
      "name": "GetSelectedItem",
      "category": "STextComboBox",
      "signature": "GetSelectedItem(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "TSharedPtr<FString>",
      "docs": "Returns the currently selected text string"
    },
    {
      "id": "set-items-source",
      "name": "SetItemsSource",
      "category": "STextComboBox",
      "signature": "SetItemsSource(Target, In List Items Source)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "In List Items Source",
          "type": "TArray<TSharedPtr<FString>>*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets new item source"
    },
    {
      "id": "clear-items-source",
      "name": "ClearItemsSource",
      "category": "STextComboBox",
      "signature": "ClearItemsSource(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears current item source"
    },
    {
      "id": "set-style",
      "name": "SetStyle",
      "category": "STextComboBox",
      "signature": "SetStyle(Target, In Combo Style)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "In Combo Style",
          "type": "FComboBoxStyle*"
        }
      ],
      "returnType": "Void",
      "docs": "Update the style of the internal ComboBox"
    },
    {
      "id": "is-open",
      "name": "IsOpen",
      "category": "STextComboBox",
      "signature": "IsOpen(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if the popup is open; false otherwise."
    },
    {
      "id": "refresh-options",
      "name": "RefreshOptions",
      "category": "STextComboBox",
      "signature": "RefreshOptions(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Request to reload the text options in the combobox from the OptionsSource attribute"
    },
    {
      "id": "clear-selection",
      "name": "ClearSelection",
      "category": "STextComboBox",
      "signature": "ClearSelection(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the selected item in the text combo"
    }
  ]
}