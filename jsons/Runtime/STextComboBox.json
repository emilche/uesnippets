{
  "id": "s-text-combo-box",
  "label": "STextComboBox",
  "includepath": "Widgets/Input/STextComboBox.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "Margin",
    "SlateColor",
    "SlateFontInfo",
    "DeclarativeSyntaxSupport",
    "SWidget",
    "SCompoundWidget",
    "SlateTypes",
    "CoreStyle",
    "SlateDelegates",
    "SComboBox"
  ],
  "functions": [
    {
      "id": "make-item-widget",
      "name": "MakeItemWidget",
      "category": "STextComboBox",
      "signature": "MakeItemWidget(Target, String Item)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "String Item",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "TSharedRef<SWidget>",
      "docs": "Called to create a widget for each string"
    },
    {
      "id": "set-selected-item",
      "name": "SetSelectedItem",
      "category": "STextComboBox",
      "signature": "SetSelectedItem(Target, New Selection)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "New Selection",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "refresh-options",
      "name": "RefreshOptions",
      "category": "STextComboBox",
      "signature": "RefreshOptions(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Request to reload the text options in the combobox from the OptionsSource attribute"
    },
    {
      "id": "clear-selection",
      "name": "ClearSelection",
      "category": "STextComboBox",
      "signature": "ClearSelection(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the selected item in the text combo"
    },
    {
      "id": "on-selection-changed",
      "name": "OnSelectionChanged",
      "category": "STextComboBox",
      "signature": "OnSelectionChanged(Target, Selection, Select Info)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "Selection",
          "type": "TSharedPtr<FString>"
        },
        {
          "name": "Select Info",
          "type": "ESelectInfo::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Called when selection changes in the combo pop-up"
    },
    {
      "id": "get-selected-text-label",
      "name": "GetSelectedTextLabel",
      "category": "STextComboBox",
      "signature": "GetSelectedTextLabel(Target)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        }
      ],
      "returnType": "Text",
      "docs": "Helper method to get the text for a given item in the combo box"
    },
    {
      "id": "get-item-text-label",
      "name": "GetItemTextLabel",
      "category": "STextComboBox",
      "signature": "GetItemTextLabel(Target, String Item)",
      "params": [
        {
          "name": "Target",
          "type": "STextComboBox*"
        },
        {
          "name": "String Item",
          "type": "TSharedPtr<FString>"
        }
      ],
      "returnType": "Text"
    }
  ]
}