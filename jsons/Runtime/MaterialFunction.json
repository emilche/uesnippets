    {
      "id": "iterate-dependent-functions",
      "name": "IterateDependentFunctions",
      "category": "MaterialFunction",
      "signature": "IterateDependentFunctions(Target, Predicate)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunction*"
        },
        {
          "name": "Predicate",
          "type": "TFunctionRef<bool ( UMaterialFunctionInterface* )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Iterates all functions that this function is dependent on, directly or indrectly.\n@param Predicate a visitor predicate returning true to continue iteration, false to break\n@return true if all dependent functions were visited, false if the Predicate did break iteration"
    },
    {
      "id": "get-dependent-functions",
      "name": "GetDependentFunctions",
      "category": "MaterialFunction",
      "signature": "GetDependentFunctions(Target, Dependent Functions)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunction*"
        },
        {
          "name": "Dependent Functions",
          "type": "TArray<UMaterialFunctionInterface*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Returns an array of the functions that this function is dependent on, directly or indirectly."
    },
    {
      "id": "get-user-exposed-caption",
      "name": "GetUserExposedCaption",
      "category": "MaterialFunction",
      "signature": "GetUserExposedCaption(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunction*"
        }
      ],
      "returnType": "String",
      "docs": "Returns If returns an empty string, use the default class name for the material function. Otherwise, the string will be the name shown when the function is exposed to users in the material graph as a node, or from the contextual menu when searching for nodes."
    },
