      "name": "IterateDependentFunctions",
      "category": "MaterialFunction",
      "signature": "IterateDependentFunctions(Target, Predicate)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunction*"
        },
        {
          "name": "Predicate",
          "type": "TFunctionRef<bool ( UMaterialFunctionInterface* )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Iterates all functions that this function is dependent on, directly or indrectly.\n@param Predicate a visitor predicate returning true to continue iteration, false to break\n@return true if all dependent functions were visited, false if the Predicate did break iteration"
    },
