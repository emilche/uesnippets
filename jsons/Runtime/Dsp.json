    {
      "id": "generate-buffer",
      "name": "GenerateBuffer",
      "category": "Dsp",
      "signature": "GenerateBuffer(Sample Rate, Clamped Frequency, Buffer, Buffer Sample Count)",
      "params": [
        {
          "name": "Sample Rate",
          "type": "Float"
        },
        {
          "name": "Clamped Frequency",
          "type": "Float"
        },
        {
          "name": "Buffer",
          "type": "Float*"
        },
        {
          "name": "Buffer Sample Count",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Generates the sine tone, continuing from the last phase.\n@param SampleRate the sample rate the buffer will be played at\n@param ClampedFrequency the frequency of the tone to emit, clamped to nyquist (SampleRate/2)\n@param Buffer the output buffer\n@param BufferSampleCount the number of samples in the buffer. Generally, this should be %4 granularity."
    },
