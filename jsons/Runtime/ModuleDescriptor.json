{
  "id": "module-descriptor",
  "label": "ModuleDescriptor",
  "includepath": "ModuleDescriptor.h",
  "includes": [
    "Array",
    "Map",
    "UnrealString",
    "CoreMinimal",
    "Platform",
    "PlatformMisc",
    "JsonWriter",
    "NameTypes",
    "UnrealNames"
  ],
  "functions": [
    {
      "id": "from-string",
      "name": "FromString",
      "category": "ModuleDescriptor",
      "signature": "FromString(Target, Text)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Text",
          "type": "TCHAR*"
        }
      ],
      "returnType": "ELoadingPhase::Type",
      "docs": "Phase at which this module should be loaded during startup."
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "ModuleDescriptor",
      "signature": "ToString(Target, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Value",
          "type": "ELoadingPhase::Type"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Returns the name of a module load phase.\n@param\tThe value to convert to a string\n@return\tThe string representation of this enum value"
    },
    {
      "id": "f-module-descriptor",
      "name": "FModuleDescriptor",
      "category": "ModuleDescriptor",
      "signature": "FModuleDescriptor(In Name, In Type, In Loading Phase)",
      "params": [
        {
          "name": "In Name",
          "type": "Name",
          "default": "NAME_None"
        },
        {
          "name": "In Type",
          "type": "EHostType::Type",
          "default": "EHostType::Runtime"
        },
        {
          "name": "In Loading Phase",
          "type": "ELoadingPhase::Type",
          "default": "ELoadingPhase::Default"
        }
      ],
      "returnType": "Void",
      "docs": "Description of a loadable module."
    },
    {
      "id": "read",
      "name": "Read",
      "category": "ModuleDescriptor",
      "signature": "Read(Target, Object, Out Fail Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Object",
          "type": "FJsonObject&"
        },
        {
          "name": "Out Fail Reason",
          "type": "Text*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool",
      "docs": "Reads a descriptor from the given JSON object"
    },
    {
      "id": "read-array",
      "name": "ReadArray",
      "category": "ModuleDescriptor",
      "signature": "ReadArray(Object, Name, Out Modules, Out Fail Reason)",
      "params": [
        {
          "name": "Object",
          "type": "FJsonObject&"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Out Modules",
          "type": "TArray<FModuleDescriptor>&"
        },
        {
          "name": "Out Fail Reason",
          "type": "Text*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool",
      "docs": "Reads an array of modules from the given JSON object"
    },
    {
      "id": "write",
      "name": "Write",
      "category": "ModuleDescriptor",
      "signature": "Write(Target, Writer)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Writer",
          "type": "TJsonWriter<>&"
        }
      ],
      "returnType": "Void",
      "docs": "Writes a descriptor to JSON"
    },
    {
      "id": "update-json",
      "name": "UpdateJson",
      "category": "ModuleDescriptor",
      "signature": "UpdateJson(Target, Json Object)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Json Object",
          "type": "FJsonObject&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the given json object with values in this descriptor"
    },
    {
      "id": "write-array",
      "name": "WriteArray",
      "category": "ModuleDescriptor",
      "signature": "WriteArray(Writer, Array Name, Modules)",
      "params": [
        {
          "name": "Writer",
          "type": "TJsonWriter<>&"
        },
        {
          "name": "Array Name",
          "type": "TCHAR*"
        },
        {
          "name": "Modules",
          "type": "TArray<FModuleDescriptor>&"
        }
      ],
      "returnType": "Void",
      "docs": "Writes an array of modules to JSON"
    },
    {
      "id": "update-array",
      "name": "UpdateArray",
      "category": "ModuleDescriptor",
      "signature": "UpdateArray(Json Object, Array Name, Modules)",
      "params": [
        {
          "name": "Json Object",
          "type": "FJsonObject&"
        },
        {
          "name": "Array Name",
          "type": "TCHAR*"
        },
        {
          "name": "Modules",
          "type": "TArray<FModuleDescriptor>&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates an array of module descriptors in the specified JSON field (indexed by module name)"
    },
    {
      "id": "is-compiled-in-configuration",
      "name": "IsCompiledInConfiguration",
      "category": "ModuleDescriptor",
      "signature": "IsCompiledInConfiguration(Target, Platform, Configuration, Target Name, Target Type, Build Developer Tools, Build Requires Cooked Data)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        },
        {
          "name": "Platform",
          "type": "String&"
        },
        {
          "name": "Configuration",
          "type": "EBuildConfiguration"
        },
        {
          "name": "Target Name",
          "type": "String&"
        },
        {
          "name": "Target Type",
          "type": "EBuildTargetType"
        },
        {
          "name": "Build Developer Tools",
          "type": "Bool"
        },
        {
          "name": "Build Requires Cooked Data",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Tests whether the module should be built for the given target"
    },
    {
      "id": "is-compiled-in-current-configuration",
      "name": "IsCompiledInCurrentConfiguration",
      "category": "ModuleDescriptor",
      "signature": "IsCompiledInCurrentConfiguration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tests whether the module should be built for the current engine configuration"
    },
    {
      "id": "is-loaded-in-current-configuration",
      "name": "IsLoadedInCurrentConfiguration",
      "category": "ModuleDescriptor",
      "signature": "IsLoadedInCurrentConfiguration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FModuleDescriptor*"
        }
      ],
      "returnType": "Bool",
      "docs": "Tests whether the module should be loaded for the current engine configuration"
    },
    {
      "id": "load-modules-for-phase",
      "name": "LoadModulesForPhase",
      "category": "ModuleDescriptor",
      "signature": "LoadModulesForPhase(Loading Phase, Modules, Module Load Errors)",
      "params": [
        {
          "name": "Loading Phase",
          "type": "ELoadingPhase::Type"
        },
        {
          "name": "Modules",
          "type": "TArray<FModuleDescriptor>&"
        },
        {
          "name": "Module Load Errors",
          "type": "TMap<FName,EModuleLoadResult>&"
        }
      ],
      "returnType": "Void",
      "docs": "Loads all the modules for a given loading phase. Returns a map of module names to load errors"
    },
    {
      "id": "unload-modules-for-phase",
      "name": "UnloadModulesForPhase",
      "category": "ModuleDescriptor",
      "signature": "UnloadModulesForPhase(Loading Phase, Modules, Out Errors, Skip Unload, Allow Unload Code)",
      "params": [
        {
          "name": "Loading Phase",
          "type": "ELoadingPhase::Type"
        },
        {
          "name": "Modules",
          "type": "TArray<FModuleDescriptor>&"
        },
        {
          "name": "Out Errors",
          "type": "TMap<FName,EModuleUnloadResult>&"
        },
        {
          "name": "Skip Unload",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Allow Unload Code",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Unloads all the modules for a given loading phase. Returns a map of module names to load errors. bSkipUnload can be used to simulate unloading"
    },
    {
      "id": "check-module-compatibility",
      "name": "CheckModuleCompatibility",
      "category": "ModuleDescriptor",
      "signature": "CheckModuleCompatibility(Modules, Out Incompatible Files)",
      "params": [
        {
          "name": "Modules",
          "type": "TArray<FModuleDescriptor>&"
        },
        {
          "name": "Out Incompatible Files",
          "type": "TArray<FString>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks that all modules are compatible with the current engine version. Returns false and appends a list of names to OutIncompatibleFiles if not."
    }
  ]
}