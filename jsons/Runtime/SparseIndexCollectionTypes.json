{
  "id": "sparse-index-collection-types",
  "label": "SparseIndexCollectionTypes",
  "includepath": "Util/SparseIndexCollectionTypes.h",
  "includes": [
    "IndexTypes",
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "init-auto",
      "name": "InitAuto",
      "category": "SparseIndexCollectionTypes",
      "signature": "InitAuto(Target, Max Index, Subset Count Est)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        },
        {
          "name": "Max Index",
          "type": "Int"
        },
        {
          "name": "Subset Count Est",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize to either sparse or dense automatically, based on max index and estimated number of set indices"
    },
    {
      "id": "init-manual",
      "name": "InitManual",
      "category": "SparseIndexCollectionTypes",
      "signature": "InitManual(Target, Set Sparse, Max Index)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        },
        {
          "name": "Set Sparse",
          "type": "Bool"
        },
        {
          "name": "Max Index",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize to sparse or dense based on the explicit caller choice\n@param bSetSparse if true, will use sparse storage; otherwise will use dense\n@param MaxIndex maximum valid index in set; must be non-negative for dense case"
    },
    {
      "id": "contains",
      "name": "Contains",
      "category": "SparseIndexCollectionTypes",
      "signature": "Contains(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "@param Index index to check for set membership\n@return true if Index is in set",
      "supportedTargets": [
        "FIndexFlagSet*",
        "FOptionallySparseIndexMap*"
      ]
    },
    {
      "id": "add",
      "name": "Add",
      "category": "SparseIndexCollectionTypes",
      "signature": "Add(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@param Index index to add to set"
    },
    {
      "id": "remove",
      "name": "Remove",
      "category": "SparseIndexCollectionTypes",
      "signature": "Remove(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@param Index index to remove from set"
    },
    {
      "id": "count",
      "name": "Count",
      "category": "SparseIndexCollectionTypes",
      "signature": "Count(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FIndexFlagSet*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns number of values in set"
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "SparseIndexCollectionTypes",
      "signature": "Initialize(Target, Max Index In, Subset Count Est)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        },
        {
          "name": "Max Index In",
          "type": "Int"
        },
        {
          "name": "Subset Count Est",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Automatically choose sparse or dense storage based on use estimate"
    },
    {
      "id": "identity-map",
      "name": "IdentityMap",
      "category": "SparseIndexCollectionTypes",
      "signature": "IdentityMap(Max Index)",
      "params": [
        {
          "name": "Max Index",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "FOptionallySparseIndexMap",
      "docs": "@return an identity map"
    },
    {
      "id": "constant-map",
      "name": "ConstantMap",
      "category": "SparseIndexCollectionTypes",
      "signature": "ConstantMap(Constant Value, Max Index)",
      "params": [
        {
          "name": "Constant Value",
          "type": "Int"
        },
        {
          "name": "Max Index",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "FOptionallySparseIndexMap",
      "docs": "@return a constant map"
    },
    {
      "id": "sparse-identity-map",
      "name": "SparseIdentityMap",
      "category": "SparseIndexCollectionTypes",
      "signature": "SparseIdentityMap(Max Index)",
      "params": [
        {
          "name": "Max Index",
          "type": "Int",
          "default": "-1"
        }
      ],
      "returnType": "FOptionallySparseIndexMap",
      "docs": "@return a sparsely-overriden an identity map; elements not explicitly set are identity"
    },
    {
      "id": "init-defaults",
      "name": "InitDefaults",
      "category": "SparseIndexCollectionTypes",
      "signature": "InitDefaults(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize default values for dense map (sparse defaults are computed on the fly)"
    },
    {
      "id": "bad-index",
      "name": "BadIndex",
      "category": "SparseIndexCollectionTypes",
      "signature": "BadIndex(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if a given Index is invalid (below zero or above MaxIndex if MaxIndex is valid)"
    },
    {
      "id": "unset",
      "name": "Unset",
      "category": "SparseIndexCollectionTypes",
      "signature": "Unset(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@param Index this index will be unset in map, restoring the default mapping (Index -> Index*DefaultScale + DefaultOffset)"
    },
    {
      "id": "set",
      "name": "Set",
      "category": "SparseIndexCollectionTypes",
      "signature": "Set(Target, Index, Value)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        },
        {
          "name": "Index",
          "type": "Int"
        },
        {
          "name": "Value",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the map at a given index.  Do not call if MapType is ScaleAndOffset."
    },
    {
      "id": "set-invalid",
      "name": "SetInvalid",
      "category": "SparseIndexCollectionTypes",
      "signature": "SetInvalid(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FOptionallySparseIndexMap*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@param Index Explicitly sets the given index to Invalid (*not* default).  Do not call if MapType is ScaleAndOffset."
    }
  ]
}