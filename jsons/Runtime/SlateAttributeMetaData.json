{
  "id": "slate-attribute-meta-data",
  "label": "SlateAttributeMetaData",
  "includepath": "Types/SlateAttributeMetaData.h",
  "includes": [
    "CoreMinimal",
    "BinarySearch",
    "ISlateMetaData",
    "SlateAttribute",
    "SlateAttributeDescriptor",
    "InvalidateWidgetReason",
    "limits"
  ],
  "functions": [
    {
      "id": "find-meta-data",
      "name": "FindMetaData",
      "category": "SlateAttributeMetaData",
      "signature": "FindMetaData(Owning Widget)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        }
      ],
      "returnType": "FSlateAttributeMetaData*",
      "docs": "@return the instance associated to the SWidget (if it exists)."
    },
    {
      "id": "update-all-attributes",
      "name": "UpdateAllAttributes",
      "category": "SlateAttributeMetaData",
      "signature": "UpdateAllAttributes(Owning Widget, Invalidation Style)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        },
        {
          "name": "Invalidation Style",
          "type": "EInvalidationPermission"
        }
      ],
      "returnType": "Void",
      "docs": "Invalidate the widget if it's needed and it's construction phase is completed."
    },
    {
      "id": "update-only-visibility-attributes",
      "name": "UpdateOnlyVisibilityAttributes",
      "category": "SlateAttributeMetaData",
      "signature": "UpdateOnlyVisibilityAttributes(Owning Widget, Invalidation Style)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        },
        {
          "name": "Invalidation Style",
          "type": "EInvalidationPermission"
        }
      ],
      "returnType": "Void",
      "docs": "Update attributes that are responsible to change visibility of the widget.\n@param InvalidationStyle if we should invalidate the widget."
    },
    {
      "id": "update-except-visibility-attributes",
      "name": "UpdateExceptVisibilityAttributes",
      "category": "SlateAttributeMetaData",
      "signature": "UpdateExceptVisibilityAttributes(Owning Widget, Invalidation Style)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        },
        {
          "name": "Invalidation Style",
          "type": "EInvalidationPermission"
        }
      ],
      "returnType": "Void",
      "docs": "Update attributes that are NOT responsible to change visibility of the widget.\n@param InvalidationStyle if we should invalidate the widget."
    },
    {
      "id": "update-children-only-visibility-attributes",
      "name": "UpdateChildrenOnlyVisibilityAttributes",
      "category": "SlateAttributeMetaData",
      "signature": "UpdateChildrenOnlyVisibilityAttributes(Owning Widget, Invalidation Style, Recursive)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        },
        {
          "name": "Invalidation Style",
          "type": "EInvalidationPermission"
        },
        {
          "name": "Recursive",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Execute UpdateOnlyVisibilityAttributes on every children of the widget.\n@param InvalidationStyle if we should invalidate the widget."
    },
    {
      "id": "apply-delayed-invalidation",
      "name": "ApplyDelayedInvalidation",
      "category": "SlateAttributeMetaData",
      "signature": "ApplyDelayedInvalidation(Owning Widget)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        }
      ],
      "returnType": "Void",
      "docs": "Apply any delayed invalidation previously delayed with EInvalidationPermission::DelayInvalidation."
    },
    {
      "id": "get-attribute-names",
      "name": "GetAttributeNames",
      "category": "SlateAttributeMetaData",
      "signature": "GetAttributeNames(Owning Widget)",
      "params": [
        {
          "name": "Owning Widget",
          "type": "SWidget&"
        }
      ],
      "returnType": "TArray<FName>",
      "docs": "Get the name of all the attributes, if available."
    }
  ]
}