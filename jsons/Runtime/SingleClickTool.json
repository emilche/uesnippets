{
  "id": "single-click-tool",
  "label": "SingleClickTool",
  "includepath": "BaseTools/SingleClickTool.h",
  "includes": [
    "BehaviorTargetInterfaces",
    "SingleClickBehavior",
    "CoreMinimal",
    "InputState",
    "InteractiveTool",
    "InteractiveToolBuilder",
    "ObjectMacros",
    "UObjectGlobals",
    "SingleClickTool.generated"
  ],
  "functions": [
    {
      "id": "build-tool",
      "name": "BuildTool",
      "category": "SingleClickTool",
      "signature": "BuildTool(Target, Scene State)",
      "params": [
        {
          "name": "Target",
          "type": "USingleClickToolBuilder*"
        },
        {
          "name": "Scene State",
          "type": "FToolBuilderState&"
        }
      ],
      "returnType": "UInteractiveTool*"
    },
    {
      "id": "is-hit-by-click",
      "name": "IsHitByClick",
      "category": "SingleClickTool",
      "signature": "IsHitByClick(Target, Click Pos)",
      "params": [
        {
          "name": "Target",
          "type": "USingleClickTool*"
        },
        {
          "name": "Click Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "FInputRayHit",
      "docs": "Test if the Target is hit at this 2D position / 3D ray"
    },
    {
      "id": "on-clicked",
      "name": "OnClicked",
      "category": "SingleClickTool",
      "signature": "OnClicked(Target, Click Pos)",
      "params": [
        {
          "name": "Target",
          "type": "USingleClickTool*"
        },
        {
          "name": "Click Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Click the Target at this 2D position / 3D ray. Default behavior is to print debug string."
    }
  ]
}