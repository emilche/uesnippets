{
  "id": "model-component",
  "label": "ModelComponent",
  "includepath": "Components/ModelComponent.h",
  "includes": [
    "CoreMinimal",
    "IndirectArray",
    "ObjectMacros",
    "Model",
    "Interface_CollisionDataProvider",
    "TextureStreamingTypes",
    "PrimitiveComponent",
    "ModelComponent.generated"
  ],
  "functions": [
    {
      "id": "get-surface-light-map-resolution",
      "name": "GetSurfaceLightMapResolution",
      "category": "ModelComponent",
      "signature": "GetSurfaceLightMapResolution(Target, Surface Index, Quality Scale, Width, Height, World To Map, Gathered Nodes)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        },
        {
          "name": "Surface Index",
          "type": "Int"
        },
        {
          "name": "Quality Scale",
          "type": "Int"
        },
        {
          "name": "Width",
          "type": "Int&"
        },
        {
          "name": "Height",
          "type": "Int&"
        },
        {
          "name": "World To Map",
          "type": "FMatrix&"
        },
        {
          "name": "Gathered Nodes",
          "type": "TArray<int32>*",
          "default": "NULL"
        }
      ],
      "returnType": "Void",
      "docs": "Calculate the lightmap resolution to be used by the given surface."
    },
    {
      "id": "copy-elements-from",
      "name": "CopyElementsFrom",
      "category": "ModelComponent",
      "signature": "CopyElementsFrom(Target, Other Model Component)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        },
        {
          "name": "Other Model Component",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Copy model elements from the other component. This is used when duplicating components for PIE to guarantee correct rendering."
    },
    {
      "id": "get-static-lighting-type",
      "name": "GetStaticLightingType",
      "category": "ModelComponent",
      "signature": "GetStaticLightingType(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "ELightMapInteractionType"
    },
    {
      "id": "get-body-setup",
      "name": "GetBodySetup",
      "category": "ModelComponent",
      "signature": "GetBodySetup(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "class UBodySetup*"
    },
    {
      "id": "wants-neg-x-tri-mesh",
      "name": "WantsNegXTriMesh",
      "category": "ModelComponent",
      "signature": "WantsNegXTriMesh(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "select-all-surfaces",
      "name": "SelectAllSurfaces",
      "category": "ModelComponent",
      "signature": "SelectAllSurfaces(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Selects all surfaces that are part of this model component."
    },
    {
      "id": "get-model",
      "name": "GetModel",
      "category": "ModelComponent",
      "signature": "GetModel(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "UModel*"
    },
    {
      "id": "get-elements",
      "name": "GetElements",
      "category": "ModelComponent",
      "signature": "GetElements(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UModelComponent*"
        }
      ],
      "returnType": "TIndirectArray<FModelElement>&"
    },
    {
      "id": "apply-temp-elements",
      "name": "ApplyTempElements",
      "category": "ModelComponent",
      "signature": "ApplyTempElements(Lighting Was Successful)",
      "params": [
        {
          "name": "Lighting Was Successful",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Apply all the elements that we were putting into the TempBSPElements map to\nthe Elements arrays in all components\n@param bLightingWasSuccessful If true, the lighting should be applied, otherwise, the temp lighting should be cleaned up"
    }
  ]
}