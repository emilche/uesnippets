        {
          "name": "Chunk Idx",
          "type": "Int"
        },
        {
          "name": "VF Mode",
          "type": "ESkinVertexFactoryMode",
          "default": "ESkinVertexFactoryMode::Default"
        }
      ],
      "returnType": "FVertexFactory*"
    },
    {
      "id": "get-static-skin-vertex-factory",
      "name": "GetStaticSkinVertexFactory",
      "category": "SkeletalRenderCPUSkin",
      "signature": "GetStaticSkinVertexFactory(Target, LOD Index, Chunk Idx, VF Mode)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "LOD Index",
          "type": "Int"
        },
        {
          "name": "Chunk Idx",
          "type": "Int"
        },
        {
          "name": "VF Mode",
          "type": "ESkinVertexFactoryMode"
        }
      ],
      "returnType": "FVertexFactory*"
    },
    {
      "id": "get-component-space-transforms",
      "name": "GetComponentSpaceTransforms",
      "category": "SkeletalRenderCPUSkin",
      "signature": "GetComponentSpaceTransforms(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        }
      ],
      "returnType": "TArray<FTransform>*"
    },
    {
      "id": "get-reference-to-local-matrices",
      "name": "GetReferenceToLocalMatrices",
      "category": "SkeletalRenderCPUSkin",
      "signature": "GetReferenceToLocalMatrices(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        }
      ],
      "returnType": "TArray<FMatrix44f>&"
    },
    {
      "id": "cache-vertices",
      "name": "CacheVertices",
      "category": "SkeletalRenderCPUSkin",
      "signature": "CacheVertices(Target, LOD Index, Force, RHI Cmd List)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "LOD Index",
          "type": "Int"
        },
        {
          "name": "Force",
          "type": "Bool"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandList&"
        }
      ],
      "returnType": "Void",
      "docs": "Re-skin cached vertices for an LOD and update the vertex buffer. Note that this\nfunction is called from the render thread!\n@param\tLODIndex - index to LODs\n@param\tbForce - force update even if LOD index hasn't changed"
    },
    {
      "id": "draw-vertex-elements",
      "name": "DrawVertexElements",
      "category": "SkeletalRenderCPUSkin",
      "signature": "DrawVertexElements(Target, PDI, To World Space, Draw Normals, Draw Tangents, Draw Binormals)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "PDI",
          "type": "FPrimitiveDrawInterface*"
        },
        {
          "name": "To World Space",
          "type": "FMatrix&"
        },
        {
          "name": "Draw Normals",
          "type": "Bool"
        },
        {
          "name": "Draw Tangents",
          "type": "Bool"
        },
        {
          "name": "Draw Binormals",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "update-skin-weight-buffer",
      "name": "UpdateSkinWeightBuffer",
      "category": "SkeletalRenderCPUSkin",
      "signature": "UpdateSkinWeightBuffer(Target, In LOD Info)",
