  "functions": [
    {
      "id": "update-cloth-simulation-data",
      "name": "UpdateClothSimulationData",
      "category": "SkeletalRenderCPUSkin",
      "signature": "UpdateClothSimulationData(Target, In Mesh Component)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicSkelMeshObjectDataCPUSkin*"
        },
        {
          "name": "In Mesh Component",
          "type": "USkinnedMeshComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Update Simulated Positions & Normals from Clothing actor"
    },
    {
      "id": "init-resources",
      "name": "InitResources",
      "category": "SkeletalRenderCPUSkin",
      "signature": "InitResources(Target, In Mesh Desc)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "In Mesh Desc",
          "type": "FSkinnedMeshSceneProxyDesc&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "release-resources",
      "name": "ReleaseResources",
      "category": "SkeletalRenderCPUSkin",
      "signature": "ReleaseResources(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        }
      ],
      "returnType": "Void",
      "docs": "Release rendering resources for this LOD"
    },
    {
      "id": "update",
      "name": "Update",
      "category": "SkeletalRenderCPUSkin",
      "signature": "Update(Target, LOD Index, In Dynamic Data, In Scene Proxy, In Skinned Asset, In Active Morph Targets, In Morph Target Weights, Previous Bone Transform Update Mode, In External Morph Weight Data)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "LOD Index",
          "type": "Int"
        },
        {
          "name": "In Dynamic Data",
          "type": "FSkinnedMeshSceneProxyDynamicData&"
        },
        {
          "name": "In Scene Proxy",
          "type": "FPrimitiveSceneProxy*"
        },
        {
          "name": "In Skinned Asset",
          "type": "USkinnedAsset*"
        },
        {
          "name": "In Active Morph Targets",
          "type": "FMorphTargetWeightMap&"
        },
        {
          "name": "In Morph Target Weights",
          "type": "TArray<float>&"
        },
        {
          "name": "Previous Bone Transform Update Mode",
          "type": "EPreviousBoneTransformUpdateMode"
        },
        {
          "name": "In External Morph Weight Data",
          "type": "FExternalMorphWeightData&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "update-dynamic-data-render-thread",
      "name": "UpdateDynamicData_RenderThread",
      "category": "SkeletalRenderCPUSkin",
      "signature": "UpdateDynamicData_RenderThread(Target, RHI Cmd List, In Dynamic Data, Frame Number To Prepare, Revision Number)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandList&"
        },
        {
          "name": "In Dynamic Data",
          "type": "FDynamicSkelMeshObjectDataCPUSkin*"
        },
        {
          "name": "Frame Number To Prepare",
          "type": "UInt64"
        },
        {
          "name": "Revision Number",
          "type": "UInt"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "enable-overlay-rendering",
      "name": "EnableOverlayRendering",
      "category": "SkeletalRenderCPUSkin",
      "signature": "EnableOverlayRendering(Target, Enabled, In Bones Of Interest, In Morph Target Of Interest)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshObjectCPUSkin*"
        },
        {
          "name": "Enabled",
          "type": "Bool"
        },
        {
          "name": "In Bones Of Interest",
          "type": "TArray<int32>*"
        },
        {
          "name": "In Morph Target Of Interest",
          "type": "TArray<UMorphTarget*>*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-skin-vertex-factory",
      "name": "GetSkinVertexFactory",
      "category": "SkeletalRenderCPUSkin",
      "signature": "GetSkinVertexFactory(Target, View, LOD Index, Chunk Idx, VF Mode)",
