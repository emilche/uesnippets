        {
          "name": "P",
          "type": "FVector3d&"
        },
        {
          "name": "Winding Iso Threshold",
          "type": "Double",
          "default": "0.5"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if fast winding number at point P is greater than winding threshold (default 0.5)"
