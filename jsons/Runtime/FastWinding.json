          "type": "Double&"
        },
        {
          "name": "Order 1",
          "type": "FVector3d&"
        },
        {
          "name": "Order 2",
          "type": "FMatrix3d&"
        }
      ],
      "returnType": "template<class TriangleMeshType,class IterableTriangleIndices> void",
      "docs": "Formulas for triangle winding number approximation"
    },
    {
      "id": "compute-coeffs",
      "name": "ComputeCoeffs",
      "category": "FastWinding",
      "signature": "ComputeCoeffs<TriangleMeshType>(Mesh, Triangle Set, Tri Cache, P, R, Order 1, Order 2, Num Tasks)",
      "params": [
        {
          "name": "Mesh",
          "type": "TriangleMeshType&"
        },
        {
          "name": "Triangle Set",
          "type": "TSet<int>&"
        },
        {
          "name": "Tri Cache",
          "type": "FMeshTriInfoCache&"
        },
        {
          "name": "P",
          "type": "FVector3d&"
        },
        {
          "name": "R",
          "type": "Double&"
        },
        {
          "name": "Order 1",
          "type": "FVector3d&"
        },
        {
          "name": "Order 2",
          "type": "FMatrix3d&"
        },
        {
          "name": "Num Tasks",
          "type": "Int",
          "default": "16"
        }
      ],
      "returnType": "template<class TriangleMeshType> void",
      "docs": "precompute constant coefficients of triangle winding number approximation (evaluated in parallel for large sets of triangles)\nP: 'Center' of expansion for Triangles (area-weighted centroid avg)\nR: max distance from P to Triangles\nOrder1: first-order vector coeff\nOrder2: second-order matrix coeff\nTriCache: precomputed triangle centroid/normal/area"
    },
    {
