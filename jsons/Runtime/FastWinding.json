    {
      "id": "fast-winding-number",
      "name": "FastWindingNumber",
      "category": "FastWinding",
      "signature": "FastWindingNumber(Target, P)",
      "params": [
        {
          "name": "Target",
          "type": "TFastWindingTree*"
        },
        {
          "name": "P",
          "type": "FVector3d&"
        }
      ],
      "returnType": "Double",
      "docs": "Fast approximation of winding number using far-field approximations.\nOn a closed mesh the winding number will be 1 or more inside (depending on number of \"winds\").\nOutside a closed mesh the winding number will be zero.\nOn an open mesh, the above holds near the mesh but in the \"hole\" areas the value will smoothly blend from 1 to 0 over a band of width dependent on the hole extent"
    },
    {
      "id": "is-inside",
      "name": "IsInside",
      "category": "FastWinding",
