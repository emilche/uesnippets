        },
        {
          "name": "Ref Handle",
          "type": "FNetRefHandle"
        }
      ],
      "returnType": "UInt",
      "docs": "Deserializes blobs with object using their respective DeserializeWithObject() method.\n@return The number of blobs that were deserialized.\n@see SerializeWithObject"
    },
