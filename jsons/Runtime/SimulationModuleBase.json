{
  "id": "simulation-module-base",
  "label": "SimulationModuleBase",
  "includepath": "SimModule/SimulationModuleBase.h",
  "includes": [
    "GeometryParticlesfwd",
    "ParticleHandleFwd",
    "PhysicsObject",
    "LogMacros",
    "ModuleFactoryRegister",
    "ModuleInput",
    "VehicleBlackboard"
  ],
  "functions": [
    {
      "id": "set-animation-data",
      "name": "SetAnimationData",
      "category": "SimulationModuleBase",
      "signature": "SetAnimationData(Target, Bone Name In, Animation Offset In, Animation Setup Index In)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "Bone Name In",
          "type": "Name&"
        },
        {
          "name": "Animation Offset In",
          "type": "FVector&"
        },
        {
          "name": "Animation Setup Index In",
          "type": "Int"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-debug-string",
      "name": "GetDebugString",
      "category": "SimulationModuleBase",
      "signature": "GetDebugString(Target, String Out)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "String Out",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Option to return debug text for drawing on the HUD in the Game Thread"
    },
    {
      "id": "add-local-force-at-position",
      "name": "AddLocalForceAtPosition",
      "category": "SimulationModuleBase",
      "signature": "AddLocalForceAtPosition(Target, Force, Position, Allow Substepping, Is Local Force, Level Slope, Debug Color In)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "Force",
          "type": "FVector&"
        },
        {
          "name": "Position",
          "type": "FVector&"
        },
        {
          "name": "Allow Substepping",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Is Local Force",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Level Slope",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Debug Color In",
          "type": "FColor&",
          "default": "FColor::Blue"
        }
      ],
      "returnType": "Void",
      "docs": "Force application function, handles deferred force application and applying the force at the collect location based on whether the GC cluster is intact or fractured\nNote: forces are applied in local coordinates of the module"
    },
    {
      "id": "add-force-at-com-position",
      "name": "AddForceAtCOMPosition",
      "category": "SimulationModuleBase",
      "signature": "AddForceAtCOMPosition(Target, Force, Offset From COM, Allow Substepping, Level Slope, Debug Color In)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "Force",
          "type": "FVector&"
        },
        {
          "name": "Offset From COM",
          "type": "FVector&",
          "default": "FVector::ZeroVector"
        },
        {
          "name": "Allow Substepping",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Level Slope",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Debug Color In",
          "type": "FColor&",
          "default": "FColor::Blue"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "add-local-force",
      "name": "AddLocalForce",
      "category": "SimulationModuleBase",
      "signature": "AddLocalForce(Target, Force, Allow Substepping, Is Local Force, Level Slope, Debug Color In)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "Force",
          "type": "FVector&"
        },
        {
          "name": "Allow Substepping",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Is Local Force",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Level Slope",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Debug Color In",
          "type": "FColor&",
          "default": "FColor::Blue"
        }
      ],
      "returnType": "Void",
      "docs": "Force application function, handles deferred force application and applying the force at the collect location based on whether the GC cluster is intact or fractured\nNote: forces are applied in local coordinates of the module"
    },
    {
      "id": "add-local-torque",
      "name": "AddLocalTorque",
      "category": "SimulationModuleBase",
      "signature": "AddLocalTorque(Target, Torque, Allow Substepping, Accel Change In, Debug Color In)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
        {
          "name": "Torque",
          "type": "FVector&"
        },
        {
          "name": "Allow Substepping",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Accel Change In",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Debug Color In",
          "type": "FColor&",
          "default": "FColor::Magenta"
        }
      ],
      "returnType": "Void",
      "docs": "Torque application function\nNote: forces are applied in local coordinates of the module"
    },
    {
      "id": "get-parent-relative-transform",
      "name": "GetParentRelativeTransform",
      "category": "SimulationModuleBase",
      "signature": "GetParentRelativeTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        }
      ],
      "returnType": "FTransform&",
      "docs": "The modules transform relative to the simulating body will depend on whether the GC is intact (get the transform relative to intact cluster)\nor fractured (transform relative to fractured part)"
    },
