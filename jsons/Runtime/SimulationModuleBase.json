    {
      "id": "get-particle-from-unique-index",
      "name": "GetParticleFromUniqueIndex",
      "category": "SimulationModuleBase",
      "signature": "GetParticleFromUniqueIndex(Target, Particle Unique Idx, Particles)",
      "params": [
        {
          "name": "Target",
          "type": "ISimulationModuleBase*"
        },
