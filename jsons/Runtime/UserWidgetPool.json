  "functions": [
    {
      "id": "set-world",
      "name": "SetWorld",
      "category": "UserWidgetPool",
      "signature": "SetWorld(Target, Owning World)",
      "params": [
        {
          "name": "Target",
          "type": "FUserWidgetPool*"
        },
        {
          "name": "Owning World",
          "type": "UWorld*"
        }
      ],
      "returnType": "Void",
      "docs": "In the case that you don't have an owner widget, you should set a world to your pool, or it won't be able to construct widgets."
    },
    {
      "id": "set-default-player-controller",
      "name": "SetDefaultPlayerController",
      "category": "UserWidgetPool",
      "signature": "SetDefaultPlayerController(Target, In Default Player Controller)",
      "params": [
        {
          "name": "Target",
          "type": "FUserWidgetPool*"
        },
        {
          "name": "In Default Player Controller",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void",
      "docs": "In the case a pool has no owner widget, a default player controller can optionally be specified allowing greater control\nin split screen scenarios. The following priority rules are applied when determining the controller which should own created widgets:\nController of owning widget (if set) > Default player controller (if set) > First local player controller from world."
    },
    {
