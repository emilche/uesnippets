      "name": "ValidAndGreaterOrEqual",
      "category": "GuardedInt",
      "signature": "ValidAndGreaterOrEqual(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if *this and Other are both valid and *this is greater than or equal to Other."
    },
    {
      "id": "invalid-or-less-than",
      "name": "InvalidOrLessThan",
      "category": "GuardedInt",
      "signature": "InvalidOrLessThan(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if either of *this or Other are invalid or *this is less than Other."
