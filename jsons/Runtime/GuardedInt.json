      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if either of *this or Other are invalid or *this is greater than Other."
    },
    {
      "id": "invalid-or-greater-or-equal",
      "name": "InvalidOrGreaterOrEqual",
      "category": "GuardedInt",
      "signature": "InvalidOrGreaterOrEqual(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if either of *this or Other are invalid or *this is greater than or equal to Other."
    },
    {
      "id": "abs",
      "name": "Abs",
      "category": "GuardedInt",
      "signature": "Abs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        }
      ],
      "returnType": "nodiscard ] ] TGuardedInt",
      "docs": "@return The absolute value of *this."
    }
  ]
}