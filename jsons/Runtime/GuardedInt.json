{
  "id": "guarded-int",
  "label": "GuardedInt",
  "includepath": "Math/GuardedInt.h",
  "includes": [
    "CoreTypes",
    "PlatformMath",
    "AssertionMacros",
    "Requires",
    "limits",
    "type_traits"
  ],
  "functions": [
    {
      "id": "is-valid",
      "name": "IsValid",
      "category": "GuardedInt",
      "signature": "IsValid(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        }
      ],
      "returnType": "nodiscard ] ] bool",
      "docs": "@return true if current value is valid (assigned and no overflows or other errors occurred), false otherwise."
    },
    {
      "id": "get",
      "name": "Get",
      "category": "GuardedInt",
      "signature": "Get(Target, Default Value)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Default Value",
          "type": "IntType"
        }
      ],
      "returnType": "nodiscard ] ] IntType",
      "docs": "@return The value if valid, DefaultValue otherwise."
    },
    {
      "id": "get-checked",
      "name": "GetChecked",
      "category": "GuardedInt",
      "signature": "GetChecked(Target, Default Value)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Default Value",
          "type": "IntType",
          "default": "0"
        }
      ],
      "returnType": "nodiscard ] ] IntType",
      "docs": "@return Returns the value if valid, DefaultValue otherwise, but also check()s that the value is valid.\nIntended for cases where the value is not expected to be invalid."
    },
    {
      "id": "comparison-valid",
      "name": "ComparisonValid",
      "category": "GuardedInt",
      "signature": "ComparisonValid(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "TGuardedInt"
        }
      ],
      "returnType": "nodiscard ] ] bool",
      "docs": "@return true if *this and Other are both valid so they can be compared."
    },
    {
      "id": "valid-and-less-than",
      "name": "ValidAndLessThan",
      "category": "GuardedInt",
      "signature": "ValidAndLessThan(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if *this and Other are both valid and *this is less than Other."
    },
    {
      "id": "valid-and-less-or-equal",
      "name": "ValidAndLessOrEqual",
      "category": "GuardedInt",
      "signature": "ValidAndLessOrEqual(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if *this and Other are both valid and *this is less than or equal to Other."
    },
    {
