      "category": "GuardedInt",
      "signature": "ValidAndGreaterThan(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "TGuardedInt*"
        },
        {
          "name": "Other",
          "type": "ValueType"
        }
      ],
      "returnType": "template<ValueType> [ [ nodiscard ] ] bool",
      "docs": "@return true if *this and Other are both valid and *this is greater than Other."
