      "category": "PlayerInput",
      "signature": "SmoothMouse(Target, A Mouse, Sample Count, Index)",
      "params": [
        {
          "name": "Target",
          "type": "UPlayerInput*"
        },
        {
          "name": "A Mouse",
          "type": "Float"
