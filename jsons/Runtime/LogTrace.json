{
  "id": "log-trace",
  "label": "LogTrace",
  "includepath": "Logging/LogTrace.h",
  "includes": [
    "CoreTypes",
    "Array",
    "PreprocessorHelpers",
    "LogVerbosity",
    "Build",
    "IsArrayOrRefOfTypeByPredicate",
    "Config",
    "Trace",
    "IsCharEncodingCompatibleWith",
    "FormatArgsTrace"
  ],
  "functions": [
    {
      "id": "output-log-category",
      "name": "OutputLogCategory",
      "category": "LogTrace",
      "signature": "OutputLogCategory(Category, Name, Default Verbosity)",
      "params": [
        {
          "name": "Category",
          "type": "FLogCategoryBase*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Default Verbosity",
          "type": "ELogVerbosity::Type"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "output-log-message-spec",
      "name": "OutputLogMessageSpec",
      "category": "LogTrace",
      "signature": "OutputLogMessageSpec(Log Point, Category, Verbosity, File, Line, Format)",
      "params": [
        {
          "name": "Log Point",
          "type": "void*"
        },
        {
          "name": "Category",
          "type": "FLogCategoryBase*"
        },
        {
          "name": "Verbosity",
          "type": "ELogVerbosity::Type"
        },
        {
          "name": "File",
          "type": "ANSICHAR*"
        },
        {
          "name": "Line",
          "type": "Int"
        },
        {
          "name": "Format",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "output-log-message-simple",
      "name": "OutputLogMessageSimple",
      "category": "LogTrace",
      "signature": "OutputLogMessageSimple(Log Point, Fmt)",
      "params": [
        {
          "name": "Log Point",
          "type": "void*"
        },
        {
          "name": "Fmt",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "output-log-message-internal",
      "name": "OutputLogMessageInternal",
      "category": "LogTrace",
      "signature": "OutputLogMessageInternal(Log Point, Encoded Format Args Size, Encoded Format Args)",
      "params": [
        {
          "name": "Log Point",
          "type": "void*"
        },
        {
          "name": "Encoded Format Args Size",
          "type": "Int"
        },
        {
          "name": "Encoded Format Args",
          "type": "Byte*"
        }
      ],
      "returnType": "Void"
    }
  ]
}