    {
      "id": "update",
      "name": "Update",
      "category": "CameraShakeBase",
      "signature": "Update(Target, Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FCameraShakeState*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Updates the state with a delta time.\nIf the state isn't managed (i.e. it doesn't have any fixed duration information), this doesn't\ndo anything and returns 1.\nIf the state is managed, this updates the internal state of this class and auto-computes when\nthe shake has ended, along with a blending weight if there is any blending in/out.\n@param DeltaTime The elapsed time since last update\n@return The evaluated blending weight (if any) for the new time"
    },
    {
      "id": "scrub",
      "name": "Scrub",
      "category": "CameraShakeBase",
      "signature": "Scrub(Target, Absolute Time)",
      "params": [
        {
          "name": "Target",
          "type": "FCameraShakeState*"
        },
        {
          "name": "Absolute Time",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Scrub the state to the given absolute time.\nIf the state isn't managed (i.e. it doesn't have any fixed duration information), this doesn't\ndo anything and returns 1.\nIf the state is managed, this updates the internal state of this class and auto-computes when\nthe shake has ended, along with a blending weight if there is any blending in/out.\n@param AbsoluteTime The time to scrub to\n@return The evaluated blending weight (if any) for the scrub time"
    },
    {
      "id": "stop",
      "name": "Stop",
      "category": "CameraShakeBase",
      "signature": "Stop(Target, Immediately)",
      "params": [
        {
          "name": "Target",
          "type": "FCameraShakeState*"
        },
        {
          "name": "Immediately",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Marks the shake has having been stopped.\nThis renders the shake inactive (if we need to stop immediately), or starts the shake's blend-out,\nif any (if we don't stop immediately). If no duration or blending information is available (i.e. if\nthe shake duration is \"Custom\"), stopping non-immediately does nothing: the sub-class is expected\nto handle it."
    },
