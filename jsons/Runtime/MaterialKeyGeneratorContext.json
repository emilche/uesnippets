{
  "id": "material-key-generator-context",
  "label": "MaterialKeyGeneratorContext",
  "includepath": "MaterialKeyGeneratorContext.h",
  "includes": [
    "StringView",
    "UnrealString",
    "EnumClassFlags",
    "StringBuilder",
    "RHIShaderPlatform",
    "CompactBinary",
    "CompactBinaryWriter",
    "ShaderKeyGenerator",
    "Function",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "record-object-start",
      "name": "RecordObjectStart",
      "category": "MaterialKeyGeneratorContext",
      "signature": "RecordObjectStart(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Name",
          "type": "FUtf8StringView"
        }
      ],
      "returnType": "Void",
      "docs": "When saving or loading, start a new object scope with the given name. When emitting, this function is a noop.\nThe name is scoped in the parent object level defined by previous calls to RecordObjectStart/RecordObjectEnd."
    },
    {
      "id": "record-object-end",
      "name": "RecordObjectEnd",
      "category": "MaterialKeyGeneratorContext",
      "signature": "RecordObjectEnd(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Void",
      "docs": "When saving or loading, end the object scope started by the last call to RecordObjectStart, and return to the\nparent object scope. When emitting, this function is a noop."
    },
    {
      "id": "add-flags",
      "name": "AddFlags",
      "category": "MaterialKeyGeneratorContext",
      "signature": "AddFlags(Target, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Flags",
          "type": "EMaterialKeyInclude"
        }
      ],
      "returnType": "Void",
      "docs": "Add include flags. @see EMaterialKeyInclude."
    },
    {
      "id": "remove-flags",
      "name": "RemoveFlags",
      "category": "MaterialKeyGeneratorContext",
      "signature": "RemoveFlags(Target, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Flags",
          "type": "EMaterialKeyInclude"
        }
      ],
      "returnType": "Void",
      "docs": "Remove include flags. @see EMaterialKeyInclude."
    },
    {
      "id": "set-flags",
      "name": "SetFlags",
      "category": "MaterialKeyGeneratorContext",
      "signature": "SetFlags(Target, Flags, Included)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Flags",
          "type": "EMaterialKeyInclude"
        },
        {
          "name": "Included",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Add or remove include flags, depending on the value of bIncluded. @see EMaterialKeyInclude."
    },
    {
      "id": "has-all-flags",
      "name": "HasAllFlags",
      "category": "MaterialKeyGeneratorContext",
      "signature": "HasAllFlags(Target, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Flags",
          "type": "EMaterialKeyInclude"
        }
      ],
      "returnType": "Bool",
      "docs": "Report whether all requested flags are included. @see EMaterialKeyInclude."
    },
    {
      "id": "get-flags",
      "name": "GetFlags",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetFlags(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "EMaterialKeyInclude",
      "docs": "Return the list of include flags. @see EMaterialKeyInclude."
    },
    {
      "id": "get-mode",
      "name": "GetMode",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "FMaterialKeyGeneratorContext::EMode",
      "docs": "Return the mode the Context is operating in. See also the Is functions that returns true when in each mode."
    },
    {
      "id": "is-emitting",
      "name": "IsEmitting",
      "category": "MaterialKeyGeneratorContext",
      "signature": "IsEmitting(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "True iff the Context is in emit mode - creating DDC key or hashing material dependencies."
    },
    {
      "id": "is-recording",
      "name": "IsRecording",
      "category": "MaterialKeyGeneratorContext",
      "signature": "IsRecording(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "True iff the Context is in either IsSaving or IsLoading mode."
    },
    {
      "id": "is-saving",
      "name": "IsSaving",
      "category": "MaterialKeyGeneratorContext",
      "signature": "IsSaving(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "True iff the Context is saving to compact binary."
    },
    {
      "id": "is-loading",
      "name": "IsLoading",
      "category": "MaterialKeyGeneratorContext",
      "signature": "IsLoading(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "True iff the Context is loading from compact binary."
    },
    {
      "id": "get-shader-platform",
      "name": "GetShaderPlatform",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetShaderPlatform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "EShaderPlatform",
      "docs": "The ShaderPlatform provided by the caller."
    },
    {
      "id": "get-shader-format",
      "name": "GetShaderFormat",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetShaderFormat(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Name",
      "docs": "The ShaderFormat that corresponds to the ShaderPlatform provided by the caller."
    },
    {
      "id": "record-and-emit",
      "name": "RecordAndEmit",
      "category": "MaterialKeyGeneratorContext",
      "signature": "RecordAndEmit(Target, Name, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Name",
          "type": "FUtf8StringView"
        },
        {
          "name": "Data",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> void",
      "docs": "Output function used by all three modes. The given data is either saved, loaded, or emitted. If saving or\nloading, the Name is used as the id for the data. If emitting the Name is not used.\nThe name is scoped by the object level defined by RecordObjectStart/RecordObjectEnd."
    },
    {
      "id": "record",
      "name": "Record",
      "category": "MaterialKeyGeneratorContext",
      "signature": "Record(Target, Name, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Name",
          "type": "FUtf8StringView"
        },
        {
          "name": "Data",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> void",
      "docs": "When saving or loading, save the given Data with the given name. When emitting, this function is a noop.\nThe name is scoped by the object level defined by RecordObjectStart/RecordObjectEnd."
    },
    {
      "id": "emit",
      "name": "Emit",
      "category": "MaterialKeyGeneratorContext",
      "signature": "Emit(Target, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Data",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> void",
      "docs": "When emitting, append the given Data to the ShaderKeyGenerator, using operator<<. In all other modes, this\nfunction is a noop."
    },
    {
      "id": "emit-func",
      "name": "EmitFunc",
      "category": "MaterialKeyGeneratorContext",
      "signature": "EmitFunc(Target, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Callback",
          "type": "TFunctionRef<void ( FShaderKeyGenerator& )>"
        }
      ],
      "returnType": "Void",
      "docs": "When emitting, call Callback with the ShaderKeyGenerator. In all other modes, this function is a noop."
    },
    {
      "id": "emit-debug-text",
      "name": "EmitDebugText",
      "category": "MaterialKeyGeneratorContext",
      "signature": "EmitDebugText(Target, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Data",
          "type": "FStringView"
        }
      ],
      "returnType": "Void",
      "docs": "When emitting, call the ShaderKeyGenerator's AppendDebugText. In all other modes, this function is a noop."
    },
    {
      "id": "emit-separator",
      "name": "EmitSeparator",
      "category": "MaterialKeyGeneratorContext",
      "signature": "EmitSeparator(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Void",
      "docs": "When emitting, call the ShaderKeyGenerator's AppendSeparator. In all other modes, this function is a noop."
    },
    {
      "id": "emit-bool-int",
      "name": "EmitBoolInt",
      "category": "MaterialKeyGeneratorContext",
      "signature": "EmitBoolInt(Target, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        },
        {
          "name": "Data",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "When emitting, call the ShaderKeyGenerator's AppendBoolInt. In all other modes, this function is a noop."
    },
    {
      "id": "get-key-gen-if-emitting",
      "name": "GetKeyGenIfEmitting",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetKeyGenIfEmitting(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "FShaderKeyGenerator*",
      "docs": "When emitting, return pointer to the ShaderKeyGenerator. In all other modes, returns nullptr."
    },
    {
      "id": "get-key-gen-if-emitting-checked",
      "name": "GetKeyGenIfEmittingChecked",
      "category": "MaterialKeyGeneratorContext",
      "signature": "GetKeyGenIfEmittingChecked(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "FShaderKeyGenerator&",
      "docs": "Must only be called when emitting; fails assertion if not. Returns reference to the ShaderKeyGenerator."
    },
    {
      "id": "has-load-error",
      "name": "HasLoadError",
      "category": "MaterialKeyGeneratorContext",
      "signature": "HasLoadError(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMaterialKeyGeneratorContext*"
        }
      ],
      "returnType": "Bool",
      "docs": "When loading, report whether any Record function reported an error. In all other modes, always returns true."
    }
  ]
}