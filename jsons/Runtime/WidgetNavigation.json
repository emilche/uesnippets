{
  "id": "widget-navigation",
  "label": "WidgetNavigation",
  "includepath": "Blueprint/WidgetNavigation.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "WeakObjectPtr",
    "NavigationMetaData",
    "WidgetNavigation.generated"
  ],
  "functions": [
    {
      "id": "resolve",
      "name": "Resolve",
      "category": "WidgetNavigation",
      "signature": "Resolve(Target, Outer, Widget Tree)",
      "params": [
        {
          "name": "Target",
          "type": "FWidgetNavigationData*"
        },
        {
          "name": "Outer",
          "type": "UUserWidget*"
        },
        {
          "name": "Widget Tree",
          "type": "UWidgetTree*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "try-to-rename-binding",
      "name": "TryToRenameBinding",
      "category": "WidgetNavigation",
      "signature": "TryToRenameBinding(Target, Old Name, New Name)",
      "params": [
        {
          "name": "Target",
          "type": "FWidgetNavigationData*"
        },
        {
          "name": "Old Name",
          "type": "Name"
        },
        {
          "name": "New Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "Try to rename any explicit or custom bindings from an old to a new name. This method can be overridden to customize resolving rules.",
      "supportedTargets": [
        "FWidgetNavigationData*",
        "UWidgetNavigation*"
      ]
    },
    {
      "id": "get-navigation-data",
      "name": "GetNavigationData",
      "category": "WidgetNavigation",
      "signature": "GetNavigationData(Target, Nav)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetNavigation*"
        },
        {
          "name": "Nav",
          "type": "EUINavigation"
        }
      ],
      "returnType": "FWidgetNavigationData&"
    },
    {
      "id": "get-navigation-rule",
      "name": "GetNavigationRule",
      "category": "WidgetNavigation",
      "signature": "GetNavigationRule(Target, Nav)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetNavigation*"
        },
        {
          "name": "Nav",
          "type": "EUINavigation"
        }
      ],
      "returnType": "EUINavigationRule"
    },
    {
      "id": "resolve-rules",
      "name": "ResolveRules",
      "category": "WidgetNavigation",
      "signature": "ResolveRules(Target, Outer, Widget Tree)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetNavigation*"
        },
        {
          "name": "Outer",
          "type": "UUserWidget*"
        },
        {
          "name": "Widget Tree",
          "type": "UWidgetTree*"
        }
      ],
      "returnType": "Void",
      "docs": "Resolve widget names. This method can be overridden to customize resolving rules."
    },
    {
      "id": "update-meta-data",
      "name": "UpdateMetaData",
      "category": "WidgetNavigation",
      "signature": "UpdateMetaData(Target, Meta Data)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetNavigation*"
        },
        {
          "name": "Meta Data",
          "type": "TSharedRef<FNavigationMetaData>"
        }
      ],
      "returnType": "Void",
      "docs": "Updates a slate metadata object to match this configured navigation ruleset."
    },
    {
      "id": "is-default-navigation",
      "name": "IsDefaultNavigation",
      "category": "WidgetNavigation",
      "signature": "IsDefaultNavigation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetNavigation*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if the configured navigation object is the same as an un-customized navigation rule set."
    }
  ]
