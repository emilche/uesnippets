    {
      "id": "can-sense-anything",
      "name": "CanSenseAnything",
      "category": "PawnSensingComponent",
      "signature": "CanSenseAnything(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Are we capable of sensing anything (and do we have any callbacks that care about sensing)? If so UpdateAISensing() will be called every sensing interval."
    },
    {
      "id": "should-check-visibility-of",
      "name": "ShouldCheckVisibilityOf",
      "category": "PawnSensingComponent",
      "signature": "ShouldCheckVisibilityOf(Target, Pawn)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "Pawn",
          "type": "APawn*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if we should check whether the given Pawn is visible (because we can see things, the Pawn is not hidden, and if the Pawn is a player and we only see players)"
    },
    {
      "id": "could-see-pawn",
      "name": "CouldSeePawn",
      "category": "PawnSensingComponent",
      "signature": "CouldSeePawn(Target, Other, May Skip Checks)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "Other",
          "type": "APawn*"
        },
        {
          "name": "May Skip Checks",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Chance of seeing other pawn decreases with increasing distance or angle in peripheral vision\n@param bMaySkipChecks if true allows checks to be sometimes skipped if target is far away (used by periodic automatic visibility checks)\n@return true if the specified pawn Other is potentially visible (within peripheral vision, etc.) - still need to do LineOfSightTo() check to see if actually visible."
    },
    {
      "id": "should-check-audibility-of",
      "name": "ShouldCheckAudibilityOf",
      "category": "PawnSensingComponent",
      "signature": "ShouldCheckAudibilityOf(Target, Pawn)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "Pawn",
          "type": "APawn*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if we should check whether we can hear the given Pawn (because we are able to hear, and the Pawn has the correct team relationship to us)"
    },
    {
      "id": "has-line-of-sight-to",
      "name": "HasLineOfSightTo",
      "category": "PawnSensingComponent",
      "signature": "HasLineOfSightTo(Target, Other)",
      "params": [
