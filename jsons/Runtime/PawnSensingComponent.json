      "id": "set-sensing-interval-4cbbc6",
      "name": "SetSensingInterval",
      "category": "AI",
      "signature": "SetSensingInterval(Target, New Sensing Interval)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "New Sensing Interval",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Changes the SensingInterval.\nIf we are currently waiting for an interval, this can either extend or shorten that interval.\nA value <= 0 prevents any updates."
    },
    {
      "id": "set-sensing-updates-enabled",
