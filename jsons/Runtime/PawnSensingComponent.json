        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enables or disables sensing updates. The timer is reset in either case."
    },
    {
