        },
        {
          "name": "Other",
          "type": "AActor*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check line to other actor.\n@param Other is the actor whose visibility is being checked.\n@param ViewPoint is eye position visibility is being checked from.\n@return true if controller's pawn can see Other actor."
    },
    {
      "id": "is-noise-relevant",
      "name": "IsNoiseRelevant",
      "category": "PawnSensingComponent",
      "signature": "IsNoiseRelevant(Target, Pawn, Noise Emitter Component, Source Within Noise Emitter)",
      "params": [
        {
          "name": "Target",
          "type": "UPawnSensingComponent*"
        },
        {
          "name": "Pawn",
          "type": "APawn&"
        },
        {
          "name": "Noise Emitter Component",
          "type": "UPawnNoiseEmitterComponent&"
        },
        {
          "name": "Source Within Noise Emitter",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Test whether the noise is loud enough and recent enough to care about.  bSourceWithinNoiseEmitter is true iff the\nnoise was made by the pawn itself or within close proximity (its collision volume).  Otherwise the noise was made\nat significant distance from the pawn."
    },
    {
      "id": "can-hear",
      "name": "CanHear",
      "category": "PawnSensingComponent",
      "signature": "CanHear(Target, Noise Loc, Loudness, Failed LOS)",
