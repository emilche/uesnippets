        },
        {
          "name": "Loudness",
          "type": "Float"
        },
        {
          "name": "Failed LOS",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "@Returns true if sensor can hear this noise. Only executed if the noise has been determined to be relevant (via IsNoiseRelevant)"
    },
