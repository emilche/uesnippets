    {
      "id": "create-widget-display-name-text",
      "name": "CreateWidgetDisplayNameText",
      "category": "TypedElementDataStorageUiInterface",
      "signature": "CreateWidgetDisplayNameText(Target, Data Storage, Row)",
      "params": [
        {
          "name": "Target",
          "type": "FTypedElementWidgetConstructor*"
        },
        {
          "name": "Data Storage",
          "type": "UE::Editor::DataStorage::ICoreProvider*"
        },
        {
          "name": "Row",
          "type": "UE::Editor::DataStorage::RowHandle",
          "default": "UE::Editor::DataStorage::InvalidRowHandle"
        }
      ],
      "returnType": "Text",
      "docs": "Returns an FText of the friendly name for the data the created widget represents.\nBy default the associated column is used. If there are multiple columns associated with the constructor\nthe default implementation will attempt to find the longest common starting string for all the columns.\nIndividual widget constructors can override this function with a name specific to them.\nIf no row is specified, it will default to an InvalidRowHandle, assuming that we are asking for a display\nname for the whole widget and not a specific instance."
    },
