{
  "id": "nav-link-definition",
  "label": "NavLinkDefinition",
  "includepath": "AI/Navigation/NavLinkDefinition.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "Class",
    "SubclassOf",
    "NavigationTypes",
    "NavAgentSelector",
    "NavLinkDefinition.generated"
  ],
  "functions": [
    {
      "id": "initialize-area-class",
      "name": "InitializeAreaClass",
      "category": "NavLinkDefinition",
      "signature": "InitializeAreaClass(Target, Force Refresh)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationLinkBase*"
        },
        {
          "name": "Force Refresh",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "PRAGMA_ENABLE_DEPRECATION_WARNINGS void"
    },
    {
      "id": "set-area-class",
      "name": "SetAreaClass",
      "category": "NavLinkDefinition",
      "signature": "SetAreaClass(Target, In Area Class)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationLinkBase*"
        },
        {
          "name": "In Area Class",
          "type": "UClass*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-area-class",
      "name": "GetAreaClass",
      "category": "NavLinkDefinition",
      "signature": "GetAreaClass(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationLinkBase*"
        }
      ],
      "returnType": "UClass*"
    },
    {
      "id": "has-meta-area",
      "name": "HasMetaArea",
      "category": "NavLinkDefinition",
      "signature": "HasMetaArea(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationLinkBase*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "post-serialize",
      "name": "PostSerialize",
      "category": "NavLinkDefinition",
      "signature": "PostSerialize(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationLinkBase*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "describe-custom-flags",
      "name": "DescribeCustomFlags",
      "category": "NavLinkDefinition",
      "signature": "DescribeCustomFlags(Editable Flag Names, Nav Link Properties Owner Class)",
      "params": [
        {
          "name": "Editable Flag Names",
          "type": "TArray<FString>&"
        },
        {
          "name": "Nav Link Properties Owner Class",
          "type": "UClass*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "set up bCustomFlagX properties and expose them for edit\n@param NavLinkPropertiesOwnerClass - optional object holding FNavigationLinkBase structs, defaults to UNavLinkDefinition"
    }
  ]
}