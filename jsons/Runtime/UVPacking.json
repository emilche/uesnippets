{
  "id": "uv-packing",
  "label": "UVPacking",
  "includepath": "Parameterization/UVPacking.h",
  "includes": [
    "BoxTypes",
    "Array",
    "IndexTypes",
    "UnrealMathSSE",
    "Vector2D",
    "VectorTypes"
  ],
  "functions": [
    {
      "id": "standard-pack",
      "name": "StandardPack",
      "category": "UVPacking",
      "signature": "StandardPack(Target, Mesh, Num Islands, Copy Island)",
      "params": [
        {
          "name": "Target",
          "type": "FUVPacker*"
        },
        {
          "name": "Mesh",
          "type": "IUVMeshView*"
        },
        {
          "name": "Num Islands",
          "type": "Int"
        },
        {
          "name": "Copy Island",
          "type": "TFunctionRef<void ( int,TArray<int32>& )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Resolution of the target texture. This is used to convert pixel gutter/border thickness to UV space"
    },
    {
      "id": "stack-pack",
      "name": "StackPack",
      "category": "UVPacking",
      "signature": "StackPack(Target, Mesh, Num Islands, Copy Island)",
      "params": [
        {
          "name": "Target",
          "type": "FUVPacker*"
        },
        {
          "name": "Mesh",
          "type": "IUVMeshView*"
        },
        {
          "name": "Num Islands",
          "type": "Int"
        },
        {
          "name": "Copy Island",
          "type": "TFunctionRef<void ( int,TArray<int32>& )>"
        }
      ],
      "returnType": "Bool",
      "docs": "Uniformly scale all UV islands so that the largest fits in positive-unit-square,\nand translate each islands separately so that it's bbox-min is at the origin.\nSo the islands are \"stacked\" and all fit in the unit box."
    },
    {
      "id": "get-island-stats",
      "name": "GetIslandStats",
      "category": "UVPacking",
      "signature": "GetIslandStats(Target, Mesh, Island, Island Bounds Out, Island Scale Factor Out, UV Area Out)",
      "params": [
        {
          "name": "Target",
          "type": "FUVPacker*"
        },
        {
          "name": "Mesh",
          "type": "IUVMeshView*"
        },
        {
          "name": "Island",
          "type": "TArray<int32>&"
        },
        {
          "name": "Island Bounds Out",
          "type": "FAxisAlignedBox2d&"
        },
        {
          "name": "Island Scale Factor Out",
          "type": "Double&"
        },
        {
          "name": "UV Area Out",
          "type": "Double&"
        }
      ],
      "returnType": "protected : void",
      "docs": "Compute common stats used by the packing algorithms to transform UV islands"
    }
  ]
}