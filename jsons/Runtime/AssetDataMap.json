    {
      "id": "f-array-or-next-index",
      "name": "FArrayOrNextIndex",
      "category": "AssetDataMap",
      "signature": "FArrayOrNextIndex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetDataMap*"
        }
      ],
      "returnType": "FIndirectAssetDataArrays::FArrayOrNextIndex::~",
      "docs": "Since the elements in Arrays need to have a stable index, we keep track of a freelist\nwhenever one of those elements is freed. To store the freelist without a wasteful additional\ncontainer, we use a linked list, with bytes used in the array reinterpreted as an index of the\nnext element of the freelist. This requires a union that can be either a TArray or a uint32\nNextIndex, which is what FArrayOrNextIndex provides."
    }
