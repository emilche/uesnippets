{
  "id": "dvr-streaming",
  "label": "DVRStreaming",
  "includepath": "DVRStreaming.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "get-streaming-status",
      "name": "GetStreamingStatus",
      "category": "DVRStreaming",
      "signature": "GetStreamingStatus(Target, Streaming Status)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericDVRStreamingSystem*"
        },
        {
          "name": "Streaming Status",
          "type": "FDVRStreamingStatus&"
        }
      ],
      "returnType": "Void",
      "docs": "Fetches the current status of streaming"
    },
    {
      "id": "enable-streaming",
      "name": "EnableStreaming",
      "category": "DVRStreaming",
      "signature": "EnableStreaming(Target, Enable)",
      "params": [
        {
          "name": "Target",
          "type": "FGenericDVRStreamingSystem*"
        },
        {
          "name": "Enable",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enables or disables streaming.\nNOTE: This does not prevent the user from streaming, it simply unblocks/blocks video and audio on any current or future stream."
    }
  ]
