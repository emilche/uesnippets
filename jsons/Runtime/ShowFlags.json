        }
      ],
      "returnType": "EShowFlagGroup"
    },
    {
      "id": "apply-view-mode",
      "name": "ApplyViewMode",
      "category": "ShowFlags",
      "signature": "ApplyViewMode(Target, View Mode Index, Perspective, Engine Show Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "View Mode Index",
          "type": "EViewModeIndex"
        },
        {
          "name": "Perspective",
          "type": "Bool"
        },
        {
          "name": "Engine Show Flags",
          "type": "FEngineShowFlags&"
        }
      ],
      "returnType": "Void",
      "docs": "Set ShowFlags and EngineShowFlags depending on view mode."
    },
    {
      "id": "engine-show-flag-override",
      "name": "EngineShowFlagOverride",
      "category": "ShowFlags",
      "signature": "EngineShowFlagOverride(Target, Show Flag Init Mode, View Mode Index, Engine Show Flags, Can Disable Tonemapper)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "Show Flag Init Mode",
          "type": "EShowFlagInitMode"
        },
        {
          "name": "View Mode Index",
          "type": "EViewModeIndex"
        },
        {
          "name": "Engine Show Flags",
          "type": "FEngineShowFlags&"
        },
        {
          "name": "Can Disable Tonemapper",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Call each view rendering after game [engine] show flags for rendering a view have been set."
    },
    {
      "id": "engine-show-flag-orthographic-override",
      "name": "EngineShowFlagOrthographicOverride",
      "category": "ShowFlags",
      "signature": "EngineShowFlagOrthographicOverride(Target, Is Perspective, Engine Show Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "Is Perspective",
          "type": "Bool"
        },
        {
          "name": "Engine Show Flags",
          "type": "FEngineShowFlags&"
        }
      ],
      "returnType": "Void",
      "docs": "Call each view rendering after game [engine] show flags for rendering a view have been set; disables effects that will not work in an orthographic projection due to shader limitations."
    },
    {
      "id": "find-view-mode",
      "name": "FindViewMode",
      "category": "ShowFlags",
      "signature": "FindViewMode(Target, Engine Show Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "Engine Show Flags",
          "type": "FEngineShowFlags&"
        }
      ],
