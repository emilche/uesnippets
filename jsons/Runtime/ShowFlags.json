    {
      "id": "find-show-flag-group",
      "name": "FindShowFlagGroup",
      "category": "ShowFlags",
      "signature": "FindShowFlagGroup(Name)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "EShowFlagGroup",
      "docs": "this function defines the grouping in the editor. If a flag is not defined here it's assumed to be a postprocess flag"
    },
