{
  "id": "show-flags",
  "label": "ShowFlags",
  "includepath": "ShowFlags.h",
  "includes": [
    "CoreMinimal",
    "EngineBaseTypes",
    "EngineDefines",
    "ShowFlagsValues"
  ],
  "functions": [
    {
      "id": "set-single-flag",
      "name": "SetSingleFlag",
      "category": "ShowFlags",
      "signature": "SetSingleFlag(Target, Index, Set)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "Index",
          "type": "UInt"
        },
        {
          "name": "Set",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "O(1)\n@param bSet true:set the flag, false:clear the flag"
    },
    {
      "id": "get-single-flag",
      "name": "GetSingleFlag",
      "category": "ShowFlags",
      "signature": "GetSingleFlag(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "Index",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "O(1)\n@param Index you can get the index from FindIndexByName() or IterateAllFlags()"
    },
    {
      "id": "is-force-flag-set",
      "name": "IsForceFlagSet",
      "category": "ShowFlags",
      "signature": "IsForceFlagSet(Index)",
      "params": [
        {
          "name": "Index",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "O(1)\nCheck if a CVar is forcing a particular flag on / off\n@param Index you can get the index from FindIndexByName() or IterateAllFlags()\n@return true if CVars are forcing flag on / off, false otherwise"
    },
    {
      "id": "to-string",
      "name": "ToString",
      "category": "ShowFlags",
      "signature": "ToString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        }
      ],
      "returnType": "String",
      "docs": "not optimized for speed, good for serialization and debugging\n@return e.g. TEXT(\"PostProcessingTonemapper=0,AmbientCubemap=1\")"
    },
    {
      "id": "set-from-string",
      "name": "SetFromString",
      "category": "ShowFlags",
      "signature": "SetFromString(Target, In)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineShowFlags*"
        },
        {
          "name": "In",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Bool",
      "docs": "More powerful than SetSingleFlag() as it allows to set/clear multiple flags\nnot optimized but doesn't have to be\nTolerates whitespace and user error, as user might manipulate the data\n@param In e.g. TEXT(\"PostProcessing,PostProcessingTonemapper=0,AmbientCubemap=1\")\n@return true:success, false:parse error detected"
    },
    {
      "id": "find-index-by-name",
      "name": "FindIndexByName",
      "category": "ShowFlags",
      "signature": "FindIndexByName(Name, Comma Separated Names)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Comma Separated Names",
          "type": "TCHAR*",
          "default": "0"
        }
      ],
      "returnType": "Int",
      "docs": "@param Name e.g. TEXT(\"EyeAdaptation\")\n@param CommaSeparatedNames leave 0 for normal purpose, is used internally for the grouping feature\n@return -1 if not found"
    },
    {
      "id": "find-name-by-index",
      "name": "FindNameByIndex",
      "category": "ShowFlags",
      "signature": "FindNameByIndex(In Index)",
      "params": [
        {
          "name": "In Index",
          "type": "UInt"
        }
      ],
      "returnType": "String",
      "docs": "@param InIndex can be from FindIndexByName() or IterateAllFlags()\n@return empty string if not found, otherwise name of the flag e.g. FString(TEXT(\"PostProcessing\"))"
    },
    {
