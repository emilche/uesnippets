        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-custom-show-flag-group",
      "name": "GetCustomShowFlagGroup",
      "category": "ShowFlags",
      "signature": "GetCustomShowFlagGroup(Index)",
      "params": [
