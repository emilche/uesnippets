    {
      "id": "move-temp",
      "name": "MoveTemp",
      "category": "UnrealTemplate",
      "signature": "MoveTemp<T>(Obj)",
      "params": [
        {
          "name": "Obj",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> UE_INTRINSIC_CAST UE_NODEBUG std::remove_reference_t<T>&&",
      "docs": "Removes one level of pointer from a type, e.g.:\nTRemovePointer<      int32  >::Type == int32\nTRemovePointer<      int32* >::Type == int32\nTRemovePointer<      int32**>::Type == int32*\nTRemovePointer<const int32* >::Type == const int32"
    },
    {
      "id": "move-temp-if-possible",
      "name": "MoveTempIfPossible",
      "category": "UnrealTemplate",
      "signature": "MoveTempIfPossible<T>(Obj)",
      "params": [
        {
          "name": "Obj",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> UE_INTRINSIC_CAST UE_NODEBUG std::remove_reference_t<T>&&",
      "docs": "MoveTempIfPossible will cast a reference to an rvalue reference.\nThis is UE's equivalent of std::move.  It doesn't static assert like MoveTemp, because it is useful in\ntemplates or macros where it's not obvious what the argument is, but you want to take advantage of move semantics\nwhere you can but not stop compilation."
    },
    {
      "id": "copy-temp",
      "name": "CopyTemp",
      "category": "UnrealTemplate",
      "signature": "CopyTemp<T>(Val)",
      "params": [
        {
          "name": "Val",
          "type": "T&"
        }
      ],
      "returnType": "template<T> T",
      "docs": "CopyTemp will enforce the creation of a prvalue which can bind to rvalue reference parameters.\nUnlike MoveTemp, a source lvalue will never be modified. (i.e. a copy will always be made)\nThere is no std:: equivalent, though there is the exposition function std::decay-copy:\nhttps://eel.is/c++draft/expos.only.func\nCopyTemp(<rvalue>) is regarded as an error and will not compile, similarly to how MoveTemp(<rvalue>)\ndoes not compile, and CopyTempIfNecessary should be used instead when the nature of the\nargument is not known in advance."
    },
    {
      "id": "copy-temp-if-necessary",
      "name": "CopyTempIfNecessary",
      "category": "UnrealTemplate",
      "signature": "CopyTempIfNecessary<T>(Val)",
      "params": [
        {
          "name": "Val",
          "type": "T&&"
        }
      ],
      "returnType": "template<T> std::decay_t<T>",
      "docs": "CopyTempIfNecessary will enforce the creation of a prvalue.\nThis is UE's equivalent of the exposition std::decay-copy:\nhttps://eel.is/c++draft/expos.only.func\nIt doesn't static assert like CopyTemp, because it is useful in\ntemplates or macros where it's not obvious what the argument is, but you want to\ncreate a PR value without stopping compilation."
    },
