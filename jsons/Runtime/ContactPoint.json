{
  "id": "contact-point",
  "label": "ContactPoint",
  "includepath": "Chaos/Collision/ContactPoint.h",
  "includes": [
    "Core"
  ],
  "functions": [
    {
      "id": "invalid-phi",
      "name": "InvalidPhi",
      "category": "ContactPoint",
      "signature": "InvalidPhi<T>(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TContactPoint*"
        }
      ],
      "returnType": "template<T> T",
      "docs": "@brief Used in FContactPoint to indicate whether the contact is vertex-plane, edge-edge, etc\n@note the order here is the order of preference in the solver. I.e., we like to solve Plane contacts before edge contacts before vertex contacts.\nThis is most impotant for collisions against triangle meshes (or any concave shape) where the second shape is always the triangle, and so a PlaneVertex collision\ncounts as a vertex collision."
    },
    {
      "id": "phi",
      "name": "Phi",
      "category": "ContactPoint",
      "signature": "Phi(Target, Phi, Face Index, Contact Type)",
      "params": [
        {
          "name": "Target",
          "type": "TContactPoint*"
        },
        {
          "name": "Phi",
          "type": "FRealType ( Other ."
        },
        {
          "name": "Face Index",
          "type": "FaceIndex ( Other ."
        },
        {
          "name": "Contact Type",
          "type": "ContactType ( Other ."
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "is-set",
      "name": "IsSet",
      "category": "ContactPoint",
      "signature": "IsSet(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TContactPoint*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "f-flags",
      "name": "FFlags",
      "category": "ContactPoint",
      "signature": "FFlags(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FManifoldPoint*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief A single point in a contact manifold.\nEach Collision Constraint will have up to 4 of these."
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "ContactPoint",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FManifoldPoint*"
        }
      ],
      "returnType": "Void",
      "supportedTargets": [
        "FManifoldPoint*",
        "FManifoldPointResult*"
      ]
    },
    {
      "id": "initial-phi",
      "name": "InitialPhi",
      "category": "ContactPoint",
      "signature": "InitialPhi(Target)",
      "params": [
        {
          "name": "Target",
