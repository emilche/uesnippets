{
  "id": "ui-command-info",
  "label": "UICommandInfo",
  "includepath": "Framework/Commands/UICommandInfo.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "InputCoreTypes",
    "Visibility",
    "SlateIcon",
    "SlateMemoryTags",
    "InputChord",
    "UICommandInfo.generated"
  ],
  "functions": [
    {
      "id": "user-interface-type",
      "name": "UserInterfaceType",
      "category": "UICommandInfo",
      "signature": "UserInterfaceType(Target, In Type)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfoDecl*"
        },
        {
          "name": "In Type",
          "type": "EUserInterfaceActionType"
        }
      ],
      "returnType": "FUICommandInfoDecl&"
    },
    {
      "id": "icon",
      "name": "Icon",
      "category": "UICommandInfo",
      "signature": "Icon(Target, In Icon)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfoDecl*"
        },
        {
          "name": "In Icon",
          "type": "FSlateIcon&"
        }
      ],
      "returnType": "FUICommandInfoDecl&"
    },
    {
      "id": "description",
      "name": "Description",
      "category": "UICommandInfo",
      "signature": "Description(Target, In Desc)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfoDecl*"
        },
        {
          "name": "In Desc",
          "type": "Text&"
        }
      ],
      "returnType": "FUICommandInfoDecl&"
    },
    {
      "id": "fui-command-info",
      "name": "FUICommandInfo",
      "category": "UICommandInfo",
      "signature": "FUICommandInfo(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfoDecl*"
        }
      ],
      "returnType": "operator TSharedPtr<"
    },
    {
      "id": "new-command",
      "name": "NewCommand",
      "category": "UICommandInfo",
      "signature": "NewCommand(Target, In Command Name, In Command Label, In Command Desc)",
      "params": [
        {
          "name": "Target",
          "type": "FBindingContext*"
        },
        {
          "name": "In Command Name",
          "type": "Name"
        },
        {
          "name": "In Command Label",
          "type": "Text&"
        },
        {
          "name": "In Command Desc",
          "type": "Text&"
        }
      ],
      "returnType": "FUICommandInfoDecl",
      "docs": "Creates a new command declaration used to populate commands with data"
    },
    {
      "id": "add-bundle",
      "name": "AddBundle",
      "category": "UICommandInfo",
      "signature": "AddBundle(Target, Name, Desc)",
      "params": [
        {
          "name": "Target",
          "type": "FBindingContext*"
        },
        {
          "name": "Name",
          "type": "Name"
        },
        {
          "name": "Desc",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a new command bundle to this context that can be referenced by name\nfrom commands within the context.\n@param Name A unique identifier for the bundle in this context\n@param Desc A localized description of the bundle"
    },
    {
      "id": "get-bundle-label",
      "name": "GetBundleLabel",
      "category": "UICommandInfo",
      "signature": "GetBundleLabel(Target, Name)",
      "params": [
        {
          "name": "Target",
          "type": "FBindingContext*"
        },
        {
          "name": "Name",
          "type": "Name"
        }
      ],
      "returnType": "Text&",
      "docs": "Gets a localized label of a command bundle\n@param Name The name of the bundle to get a label for\n@return The localized label of the bundle"
    },
    {
      "id": "get-input-text",
      "name": "GetInputText",
      "category": "UICommandInfo",
      "signature": "GetInputText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfo*"
        }
      ],
      "returnType": "Text",
      "docs": "Returns the friendly, localized string name of the first valid chord in the key bindings list that is required to perform the command\n@return\tLocalized friendly text for the chord"
    },
    {
      "id": "make-command-info",
      "name": "MakeCommandInfo",
      "category": "UICommandInfo",
      "signature": "MakeCommandInfo(In Context, Out Command, In Command Name, In Command Label, In Command Desc, In Icon, In User Interface Type, In Default Chord, In Alternate Default Chord, In Bundle)",
      "params": [
        {
          "name": "In Context",
          "type": "TSharedRef<FBindingContext>&"
        },
        {
          "name": "Out Command",
          "type": "TSharedPtr<FUICommandInfo>&"
        },
        {
          "name": "In Command Name",
          "type": "Name"
        },
        {
          "name": "In Command Label",
          "type": "Text&"
        },
        {
          "name": "In Command Desc",
          "type": "Text&"
        },
        {
          "name": "In Icon",
          "type": "FSlateIcon&"
        },
        {
          "name": "In User Interface Type",
          "type": "EUserInterfaceActionType"
        },
        {
          "name": "In Default Chord",
          "type": "FInputChord&"
        },
        {
          "name": "In Alternate Default Chord",
          "type": "FInputChord&",
          "default": "FInputChord()"
        },
        {
          "name": "In Bundle",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Utility function to make an FUICommandInfo"
    },
    {
      "id": "unregister-command-info",
      "name": "UnregisterCommandInfo",
      "category": "UICommandInfo",
      "signature": "UnregisterCommandInfo(In Context, In Command)",
      "params": [
        {
          "name": "In Context",
          "type": "TSharedRef<FBindingContext>&"
        },
        {
          "name": "In Command",
          "type": "TSharedRef<FUICommandInfo>&"
        }
      ],
      "returnType": "Void",
      "docs": "Utility function to unregister an FUICommandInfo"
    },
    {
      "id": "set-active-chord",
      "name": "SetActiveChord",
      "category": "UICommandInfo",
      "signature": "SetActiveChord(Target, New Chord, In Chord Index)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfo*"
        },
        {
          "name": "New Chord",
          "type": "FInputChord&"
        },
        {
          "name": "In Chord Index",
          "type": "EMultipleKeyBindingIndex"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the new active chord for this command"
    },
    {
      "id": "remove-active-chord",
      "name": "RemoveActiveChord",
      "category": "UICommandInfo",
      "signature": "RemoveActiveChord(Target, In Chord Index)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfo*"
        },
        {
          "name": "In Chord Index",
          "type": "EMultipleKeyBindingIndex"
        }
      ],
      "returnType": "Void",
      "docs": "Removes the active chord from this command"
    },
    {
      "id": "make-tooltip",
      "name": "MakeTooltip",
      "category": "UICommandInfo",
      "signature": "MakeTooltip(Target, In Text, In Tool Tip Visibility)",
      "params": [
        {
          "name": "Target",
          "type": "FUICommandInfo*"
        },
        {
          "name": "In Text",
          "type": "TAttribute<FText>&",
          "default": "TAttribute<FText>()"
        },
        {
          "name": "In Tool Tip Visibility",
          "type": "TAttribute<EVisibility>&",
          "default": "TAttribute<EVisibility>()"
        }
      ],
      "returnType": "TSharedRef<class SToolTip>",
      "docs": "Makes a tooltip for this command.\n@param\tInText\tOptional dynamic text to be displayed in the tooltip.\n@return\tThe tooltip widget"
    }
  ]
}