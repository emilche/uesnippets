      "name": "Draw",
      "category": "HUDHitBox",
      "signature": "Draw(Target, In Canvas, In Color)",
      "params": [
        {
          "name": "Target",
          "type": "FHUDHitBox*"
        },
        {
          "name": "In Canvas",
          "type": "FCanvas*"
        },
        {
          "name": "In Color",
          "type": "FLinearColor&"
        }
      ],
