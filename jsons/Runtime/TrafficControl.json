{
  "id": "traffic-control",
  "label": "TrafficControl",
  "includepath": "Net/TrafficControl.h",
  "includes": [
    "CoreMinimal",
    "SequenceNumber",
    "ResizableCircularQueue",
    "EngineLogs"
  ],
  "functions": [
    {
      "id": "f-network-traffic-analyzer",
      "name": "FNetworkTrafficAnalyzer",
      "category": "TrafficControl",
      "signature": "FNetworkTrafficAnalyzer(In Traffic Control Module)",
      "params": [
        {
          "name": "In Traffic Control Module",
          "type": "FNetworkCongestionControl*"
        }
      ],
      "returnType": "public :",
      "docs": "A Network traffic analyzer that keeps track of useful information\nincluding the RTT and uplink bandwidth of the latest received packet\nto help the congestion control module work. It uses seq and\nack mechanism to track packet and use timestamp and packet size to\ncalculate RTT and bandwidth."
    },
    {
      "id": "on-ack",
      "name": "OnAck",
      "category": "TrafficControl",
      "signature": "OnAck(Target, Ack Sample)",
      "params": [
        {
          "name": "Target",
          "type": "FNetworkTrafficAnalyzer*"
        },
        {
          "name": "Ack Sample",
          "type": "FAckSample&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-send",
      "name": "OnSend",
      "category": "TrafficControl",
      "signature": "OnSend(Target, Seq Sample)",
      "params": [
        {
          "name": "Target",
          "type": "FNetworkTrafficAnalyzer*"
        },
        {
          "name": "Seq Sample",
          "type": "FSeqSample&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "f-network-congestion-control",
      "name": "FNetworkCongestionControl",
      "category": "TrafficControl",
      "signature": "FNetworkCongestionControl(Configured Net Speed, Max Packets)",
      "params": [
        {
          "name": "Configured Net Speed",
          "type": "Double"
        },
        {
          "name": "Max Packets",
          "type": "UInt"
        }
      ],
      "returnType": "public :",
      "docs": "Circular queue that keeps track of useful data of all unacked packets.\nInvariant:\nThe tail of the circular queue is the first unacked packet\nwhose packet id is OutAckedSeq + 1. The head of the circular\nqueue is the latest sent packet whose id is equal to OutSeq."
    },
    {
      "id": "is-ready-to-send",
      "name": "IsReadyToSend",
      "category": "TrafficControl",
      "signature": "IsReadyToSend(Target, Timestamp)",
      "params": [
        {
          "name": "Target",
          "type": "FNetworkCongestionControl*"
        },
        {
          "name": "Timestamp",
          "type": "Double"
        }
      ],
      "returnType": "Bool"
    }
  ]
}