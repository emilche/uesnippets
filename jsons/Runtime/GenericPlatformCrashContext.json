    {
      "id": "is-out-of-process-crash-reporter",
      "name": "IsOutOfProcessCrashReporter",
      "category": "GenericPlatformCrashContext",
      "signature": "IsOutOfProcessCrashReporter()",
      "params": [],
      "returnType": "Bool",
      "docs": "@return true if walking the crashed call stack and writing the minidump is being handled out-of-process.\n@note The reporting itself (showing the crash UI and sending the report is always done out of process)"
    },
    {
      "id": "get-out-of-process-crash-reporter-process-id",
      "name": "GetOutOfProcessCrashReporterProcessId",
      "category": "GenericPlatformCrashContext",
      "signature": "GetOutOfProcessCrashReporterProcessId()",
      "params": [],
      "returnType": "UInt",
      "docs": "@return a non-zero value if crash reporter process is used to monitor the session, capture the call stack and write the minidump, otherwise, this is done inside the crashing process."
    },
    {
      "id": "set-out-of-process-crash-reporter-pid",
      "name": "SetOutOfProcessCrashReporterPid",
      "category": "GenericPlatformCrashContext",
      "signature": "SetOutOfProcessCrashReporterPid(Process Id)",
      "params": [
        {
          "name": "Process Id",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Set whether or not the out-of-process crash reporter is running. A non-zero process id means that crash artifacts like the call stack and then minidump are\nbuilt in a separated background process. The reporting itself, i.e. packaging and sending the crash artifacts is always done out of process.\n@note CrashReportClient (CrashReportClientEditor for the Editor) can be configured to wait for crash, capture the crashed process callstack, write the minidump, collect all crash artifacts\nand send them (out-of-process reporting) or just collect and send them (in-process reporting because the crashing process creates all crash artifacts itself)."
    },
    {
      "id": "set-out-of-process-crash-reporter-exit-code",
      "name": "SetOutOfProcessCrashReporterExitCode",
      "category": "GenericPlatformCrashContext",
      "signature": "SetOutOfProcessCrashReporterExitCode(Exit Code)",
      "params": [
        {
          "name": "Exit Code",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the out of process crash reporter exit code if known. The out of process reporter is expected to run in background, waiting for a signal to handle a\ncrashes/ensures/assert, but sometimes it crashes. If the engine detects that its associated out of process crash reporter died and if the child process exit\ncode can be retrieved, it can be exposed through this function.\n@see GetOutOfProcessCrashReporterExitCode"
    },
    {
      "id": "get-out-of-process-crash-reporter-exit-code",
      "name": "GetOutOfProcessCrashReporterExitCode",
      "category": "GenericPlatformCrashContext",
      "signature": "GetOutOfProcessCrashReporterExitCode()",
      "params": [],
      "returnType": "TOptional<int32>",
      "docs": "Return the out-of-process crash reporter exit code if available. The exit code is available if crash reporter process died while the application it monitors was still running.\nThen engine periodically poll the health of the crash reporter process and try to read its exit code if it unexpectedly died.\n@note This function is useful to try diagnose why the crash reporter died (crashed/killed/asserted) and gather data for the analytics."
    },
