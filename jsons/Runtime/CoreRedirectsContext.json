      "params": [
        {
          "name": "New Context",
          "type": "FCoreRedirectsContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Changes the context for FCoreRedirects calls to use for the current thread. The passed in context must remain\nvalid until PopThreadContext is called."
    },
