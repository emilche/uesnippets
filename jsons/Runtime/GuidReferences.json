        {
          "name": "Target",
          "type": "FGuidReferences*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-unmapped-gui-ds",
      "name": "GetUnmappedGUIDs",
      "category": "GuidReferences",
      "signature": "GetUnmappedGUIDs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGuidReferences*"
        }
      ],
      "returnType": "TSet<FNetworkGUID>&",
      "docs": "Get the set of GUIDs for objects that haven't been loaded / created yet."
    },
    {
      "id": "add-unmapped-guid",
      "name": "AddUnmappedGUID",
      "category": "GuidReferences",
      "signature": "AddUnmappedGUID(Target, In GUID)",
      "params": [
        {
          "name": "Target",
          "type": "FGuidReferences*"
        },
        {
          "name": "In GUID",
          "type": "FNetworkGUID"
        }
      ],
      "returnType": "Void",
      "docs": "Starts tracking InGUID if not already and calls UPackageMap::AddUnmappedNetGUIDReference if bRemapStableSubobjects is enabled."
    },
    {
      "id": "remove-unmapped-guid",
      "name": "RemoveUnmappedGUID",
      "category": "GuidReferences",
      "signature": "RemoveUnmappedGUID(Target, In GUID)",
      "params": [
        {
          "name": "Target",
          "type": "FGuidReferences*"
        },
        {
          "name": "In GUID",
          "type": "FNetworkGUID"
        }
      ],
      "returnType": "Void",
      "docs": "Stops tracking a GUID and calls UPackageMap::RemoveUnmappedNetGUIDReference if bRemapStableSubobjects is enabled."
    },
    {
      "id": "update-unmapped-gui-ds",
      "name": "UpdateUnmappedGUIDs",
      "category": "GuidReferences",
      "signature": "UpdateUnmappedGUIDs(Target, In Package Map, Original Object, Property, Abs Offset)",
      "params": [
        {
          "name": "Target",
          "type": "FGuidReferences*"
        },
        {
          "name": "In Package Map",
          "type": "UPackageMap*"
        },
        {
          "name": "Original Object",
          "type": "UObject*"
        },
        {
          "name": "Property",
          "type": "FProperty*"
        },
        {
          "name": "Abs Offset",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "Called by FRepLayout to update GUID tracking when updating unmapped objects."
    }
  ]
