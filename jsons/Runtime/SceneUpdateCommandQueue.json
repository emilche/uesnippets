    {
      "id": "for-each-update-command-b91c30",
      "name": "ForEachUpdateCommand",
      "category": "SceneUpdateCommandQueue",
      "signature": "ForEachUpdateCommand(Target, Command Filter, Update Payload Mask, Callback Func)",
      "params": [
        {
          "name": "Target",
          "type": "TSceneUpdateCommandQueue*"
        },
        {
          "name": "Command Filter",
          "type": "ESceneUpdateCommandFilter"
        },
        {
          "name": "Update Payload Mask",
          "type": "UInt64"
        },
        {
          "name": "Callback Func",
          "type": "CallbackFuncType"
        }
      ],
      "returnType": "template<CallbackFuncType> void",
      "docs": "Filter on ESceneUpdateCommandFilter and _updates_ on payload mask. I.e., the payload mask only matters if the Command is an update.\nE.g., ForEachUpdateCommand(ESceneUpdateCommandFilter::Added,...) will return _all_ added commands regardless of payload mask.\nE.g., ForEachUpdateCommand(ESceneUpdateCommandFilter::Added | ESceneUpdateCommandFilter::Updated,...) will return _all_ added commands regardless of UpdatePayloadMask AND all updates that match the UpdatePayloadMask."
    },
    {
