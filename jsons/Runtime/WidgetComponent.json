          "type": "UWidgetComponent*"
        },
        {
          "name": "Local Player",
          "type": "ULocalPlayer*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the local player that owns this widget component.  Setting the owning player controls\nwhich player's viewport the widget appears on in a split screen scenario.  Additionally it\nforwards the owning player to the actual UserWidget that is spawned."
    },
