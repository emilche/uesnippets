        },
        {
          "name": "Widget",
          "type": "UUserWidget*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the widget to use directly. This function will keep track of the widget till the next time it's called\nwith either a newer widget or a nullptr"
    },
    {
