      "id": "new-simplicial-1767c6",
      "name": "NewSimplicial",
      "category": "GeometryCollectionCollisionStructureManager",
      "signature": "NewSimplicial(Vertices, Tri Mesh, Implicit, Collision Particles Max Input)",
      "params": [
        {
          "name": "Vertices",
          "type": "Chaos::FParticles&"
        },
        {
          "name": "Tri Mesh",
          "type": "Chaos::FTriangleMesh&"
        },
        {
          "name": "Implicit",
          "type": "Chaos::FImplicitObject*"
        },
        {
          "name": "Collision Particles Max Input",
          "type": "Int"
        }
      ],
      "returnType": "FSimplicial*",
      "docs": "Culls particles inside \\p Implicit, and coincident particles (defined by\nbeing within 1/20'th of the size of the domain from one another), truncates\nat \\p CollisionParticlesMaxInput, and returns a bounding volume hierarchy\nof the remainder."
    },
    {
      "id": "new-simplicial-be1bc7",
      "name": "NewSimplicial",
      "category": "GeometryCollectionCollisionStructureManager",
      "signature": "NewSimplicial(All Particles, Bone Map, Collision Type, Tri Mesh, Collision Particles Fraction)",
      "params": [
