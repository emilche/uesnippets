        },
        {
          "name": "Collision Particles Fraction",
          "type": "Float"
        }
      ],
      "returnType": "FSimplicial*",
      "docs": "Culls particles by importance (See \\c FTriangleMesh::GetVertexImportanceOrdering()),\nand returns a bounding volume hierarchy of the remainder."
