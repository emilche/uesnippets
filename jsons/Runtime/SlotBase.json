        {
          "name": "Target",
          "type": "FSlotBase*"
        },
        {
          "name": "In Widget",
          "type": "TSharedRef<SWidget>&&"
        }
      ],
      "returnType": "Void",
      "docs": "Attach the child widget the slot now owns."
    },
    {
      "id": "get-widget",
