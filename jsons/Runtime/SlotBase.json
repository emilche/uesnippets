          "name": "Target",
          "type": "FSlotBase*"
        }
      ],
      "returnType": "SWidget*",
      "docs": "Access the widget that own the slot.\nThe owner can be invalid when the slot is not attached."
    },
    {
      "id": "set-owner",
      "name": "SetOwner",
      "category": "SlotBase",
      "signature": "SetOwner(Target, Children)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        },
        {
          "name": "Children",
          "type": "FChildren&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the owner of the slot.\nSlots cannot be reassigned to different parents."
    },
    {
      "id": "attach-widget-f0d7c6",
      "name": "AttachWidget",
      "category": "SlotBase",
      "signature": "AttachWidget(Target, In Widget)",
