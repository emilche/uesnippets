      "category": "SlotBase",
      "signature": "GetWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        }
      ],
      "returnType": "TSharedRef<SWidget>&",
      "docs": "Access the widget in the current slot.\nThere will always be a widget in the slot; sometimes it is\nthe SNullWidget instance."
    },
    {
      "id": "detach-widget",
