{
  "id": "slot-base",
  "label": "SlotBase",
  "includepath": "SlotBase.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "InvalidateWidgetReason"
  ],
  "functions": [
    {
      "id": "get-owner-widget",
      "name": "GetOwnerWidget",
      "category": "SlotBase",
      "signature": "GetOwnerWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        }
      ],
      "returnType": "SWidget*",
      "docs": "Access the widget that own the slot.\nThe owner can be invalid when the slot is not attached."
    },
    {
      "id": "set-owner",
      "name": "SetOwner",
      "category": "SlotBase",
      "signature": "SetOwner(Target, Children)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        },
        {
          "name": "Children",
          "type": "FChildren&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the owner of the slot.\nSlots cannot be reassigned to different parents."
    },
    {
      "id": "detach-widget",
      "name": "DetachWidget",
      "category": "SlotBase",
      "signature": "DetachWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        }
      ],
      "returnType": "TSharedPtr<SWidget>",
      "docs": "Remove the widget from its current slot.\nThe removed widget is returned so that operations could be performed on it.\nIf the null widget was being stored, an invalid shared ptr is returned instead."
    },
    {
      "id": "invalidate",
      "name": "Invalidate",
      "category": "SlotBase",
      "signature": "Invalidate(Target, Invalidate Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FSlotBase*"
        },
        {
          "name": "Invalidate Reason",
          "type": "EInvalidateWidgetReason"
        }
      ],
      "returnType": "Void",
      "docs": "Invalidate the widget's owner."
    }
  ]
}