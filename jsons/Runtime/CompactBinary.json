    {
      "id": "equals",
      "name": "Equals",
      "category": "CompactBinary",
      "signature": "Equals(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FCbFieldView*"
        },
        {
          "name": "Other",
          "type": "FCbFieldView&"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether this field is identical to the other field.\nPerforms a deep comparison of any contained arrays or objects and their fields. Comparison\nassumes that both fields are valid and are written in the canonical format. Fields must be\nwritten in the same order in arrays and objects, and name comparison is case sensitive. If\nthese assumptions do not hold, this may return false for equivalent inputs. Validation can\nbe performed with ValidateCompactBinary, except for field order and field name case."
    },
