{
  "id": "lumen-view-state",
  "label": "LumenViewState",
  "includepath": "LumenViewState.h",
  "includes": [
    "RenderGraphResources",
    "SceneTexturesConfig",
    "LFSR"
  ],
  "functions": [
    {
      "id": "safe-release",
      "name": "SafeRelease",
      "category": "LumenViewState",
      "signature": "SafeRelease(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FScreenProbeGatherTemporalState*"
        }
      ],
      "returnType": "Void",
      "supportedTargets": [
        "FScreenProbeGatherTemporalState*",
        "FReSTIRTemporalResamplingState*",
        "FReSTIRTemporalAccumulationState*",
        "FReSTIRGatherTemporalState*",
        "FReflectionTemporalState*",
        "FLumenViewState*"
      ]
    },
    {
      "id": "add-cross-gpu-transfers",
      "name": "AddCrossGPUTransfers",
      "category": "LumenViewState",
      "signature": "AddCrossGPUTransfers(Target, Source GPU Index, Dest GPU Index, Out Transfers)",
      "params": [
        {
          "name": "Target",
          "type": "FScreenProbeGatherTemporalState*"
        },
        {
          "name": "Source GPU Index",
          "type": "UInt"
        },
        {
          "name": "Dest GPU Index",
          "type": "UInt"
        },
        {
          "name": "Out Transfers",
          "type": "TArray<FTransferResourceParams>&"
        }
      ],
      "returnType": "Void",
      "supportedTargets": [
        "FScreenProbeGatherTemporalState*",
        "FReflectionTemporalState*",
        "FRadianceCacheState*",
        "FLumenViewState*"
      ]
    },
    {
      "id": "release-textures",
      "name": "ReleaseTextures",
      "category": "LumenViewState",
      "signature": "ReleaseTextures(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRadianceCacheState*"
        }
      ],
      "returnType": "Void",
      "docs": "Clipmaps of probe indexes, used to lookup the probe index for a world space position."
    }
  ]
}