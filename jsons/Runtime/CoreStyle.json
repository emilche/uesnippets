    {
      "id": "get",
      "name": "Get",
      "category": "CoreStyle",
      "signature": "Get()",
      "params": [],
      "returnType": "ISlateStyle&",
      "docs": "@return the Application Style\nNOTE: Until the Editor can be fully updated, calling FCoreStyle::Get() will\nreturn the AppStyle instead of the style definied in this class.\nUsing the AppStyle is preferred in most cases as it allows the style to be changed\nand restyled more easily.\nIn cases requiring explicit use of the CoreStyle where a Slate Widget should not take on\nthe appearance of the rest of the application, use FCoreStyle::GetCoreStyle()."
    },
    {
      "id": "get-core-style",
      "name": "GetCoreStyle",
      "category": "CoreStyle",
      "signature": "GetCoreStyle()",
      "params": [],
      "returnType": "ISlateStyle&",
      "docs": "@return the singleton instance of the style created in ."
    },
