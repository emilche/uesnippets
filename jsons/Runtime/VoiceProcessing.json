      "id": "f-moving-averager",
      "name": "FMovingAverager",
      "category": "VoiceProcessing",
      "signature": "FMovingAverager(Num Samples)",
      "params": [
        {
          "name": "Num Samples",
          "type": "UInt"
        }
      ],
      "returnType": "public :",
      "docs": "This class buffers audio while maintaining a running average of the underlying buffer.\nThis is useful for cases where we can't use a peak detector with asymptotic tracking.\nFor example: lookahead limiters, silence detection, etc."
    },
