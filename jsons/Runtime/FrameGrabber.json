      "id": "f-frame-grabber-bf0370",
      "name": "FFrameGrabber",
      "category": "FrameGrabber",
      "signature": "FFrameGrabber(Viewport, Desired Buffer Size, In Pixel Format, Num Surfaces)",
      "params": [
        {
          "name": "Viewport",
          "type": "TSharedRef<FSceneViewport>"
        },
        {
          "name": "Desired Buffer Size",
          "type": "FIntPoint"
        },
        {
          "name": "In Pixel Format",
          "type": "EPixelFormat",
          "default": "PF_B8G8R8A8"
        },
        {
          "name": "Num Surfaces",
          "type": "UInt",
          "default": "3"
        }
      ],
      "returnType": "public :",
      "docs": "Class responsible for resolving render target data for a specific viewport in an efficient manner\nInternally, the class uses a fixed array of resolution surfaces, and dispatches rendering commands\nto resolve the viewport render target into a specific index into this array. This means we can\nresolve the render target data without having to wait, or flush rendering commands."
    },
