    {
      "id": "compute-golden-spiral-points-9a2528",
      "name": "ComputeGoldenSpiralPoints",
      "category": "Cylinder",
      "signature": "ComputeGoldenSpiralPoints(Points, Origin, Axis, Radius, Height, Num Points, Include End Caps, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Origin",
          "type": "FVec3&"
        },
        {
          "name": "Axis",
          "type": "FVec3&"
        },
        {
          "name": "Radius",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Include End Caps",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Use the golden spiral method to generate evenly spaced points on a cylinder.\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the cylinder, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Origin is the bottom-most point of the cylinder.\n\\p Axis is the orientation of the cylinder.\n\\p Radius is the radius of the cylinder.\n\\p Height is the height of the cylinder.\n\\p NumPoints is the number of points to generate.\n\\p IncludeEndCaps determines whether or not points are generated on the\nend caps of the cylinder.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
    {
      "id": "compute-golden-spiral-points-unoriented",
      "name": "ComputeGoldenSpiralPointsUnoriented",
      "category": "Cylinder",
      "signature": "ComputeGoldenSpiralPointsUnoriented(Points, Radius, Height, Num Points, Include End Caps, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Radius",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Include End Caps",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Generates evenly spaced points on a cylinder, oriented about the Z axis,\nvarying from [-Height/2, Height/2].\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the cylinder, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Radius is the radius of the cylinder.\n\\p Height is the height of the cylinder.\n\\p NumPoints is the number of points to generate.\n\\p IncludeEndCaps determines whether or not points are generated on the\nend caps of the cylinder.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
