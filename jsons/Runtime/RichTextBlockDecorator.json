{
  "id": "rich-text-block-decorator",
  "label": "RichTextBlockDecorator",
  "includepath": "Components/RichTextBlockDecorator.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "SlateFontInfo",
    "SlateTypes",
    "TextLayout",
    "ISlateRun",
    "ITextDecorator",
    "RichTextBlockDecorator.generated"
  ],
  "functions": [
    {
      "id": "create",
      "name": "Create",
      "category": "RichTextBlockDecorator",
      "signature": "Create(Target, Text Layout, Run Parse Result, Original Text, In Out Model Text, Style)",
      "params": [
        {
          "name": "Target",
          "type": "FRichTextDecorator*"
        },
        {
          "name": "Text Layout",
          "type": "TSharedRef<FTextLayout>&"
        },
        {
          "name": "Run Parse Result",
          "type": "FTextRunParseResults&"
        },
        {
          "name": "Original Text",
          "type": "String&"
        },
        {
          "name": "In Out Model Text",
          "type": "TSharedRef<FString>&"
        },
        {
          "name": "Style",
          "type": "ISlateStyle*"
        }
      ],
      "returnType": "TSharedRef<ISlateRun>"
    },
    {
      "id": "create-decorator-widget",
      "name": "CreateDecoratorWidget",
      "category": "RichTextBlockDecorator",
      "signature": "CreateDecoratorWidget(Target, Run Info, Default Text Style)",
      "params": [
        {
          "name": "Target",
          "type": "FRichTextDecorator*"
        },
        {
          "name": "Run Info",
          "type": "FTextRunInfo&"
        },
        {
          "name": "Default Text Style",
          "type": "FTextBlockStyle&"
        }
      ],
      "returnType": "TSharedPtr<SWidget>",
      "docs": "Override this function if you want to create a unique widget like an image"
    },
    {
      "id": "create-decorator",
      "name": "CreateDecorator",
      "category": "RichTextBlockDecorator",
      "signature": "CreateDecorator(Target, In Owner)",
      "params": [
        {
          "name": "Target",
          "type": "URichTextBlockDecorator*"
        },
        {
          "name": "In Owner",
          "type": "URichTextBlock*"
        }
      ],
      "returnType": "TSharedPtr<ITextDecorator>"
    }
  ]
}