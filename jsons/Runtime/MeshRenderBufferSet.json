        {
          "name": "Parallel",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "template<TriangleEnumerable> void",
      "docs": "Initialize rendering buffers from given attribute overlays.\nCreates three vertices per triangle, IE no shared vertices in buffers."
    },
    {
      "id": "update-secondary-triangle-buffer",
      "name": "UpdateSecondaryTriangleBuffer",
      "category": "MeshRenderBufferSet",
      "signature": "UpdateSecondaryTriangleBuffer(Target, Render Buffers, Mesh, Duplicate)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRenderBufferSetConversionUtil*"
        },
        {
          "name": "Render Buffers",
          "type": "FMeshRenderBufferSet*"
        },
        {
          "name": "Mesh",
          "type": "FDynamicMesh3*"
        },
        {
          "name": "Duplicate",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Filter the triangles in a FMeshRenderBufferSet into the SecondaryIndexBuffer.\nRequires that RenderBuffers->Triangles has been initialized.\n@param bDuplicate if set, then primary IndexBuffer is unmodified and SecondaryIndexBuffer contains duplicates. Otherwise triangles are sorted via predicate into either primary or secondary."
    },
    {
      "id": "recompute-render-buffer-triangle-index-sets",
      "name": "RecomputeRenderBufferTriangleIndexSets",
      "category": "MeshRenderBufferSet",
