    {
      "id": "upload-index-buffer-update",
      "name": "UploadIndexBufferUpdate",
      "category": "MeshRenderBufferSet",
      "signature": "UploadIndexBufferUpdate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRenderBufferSet*"
        }
      ],
      "returnType": "Void",
      "docs": "Fast path to only update the primary and secondary index buffers. This can be used\nwhen (eg) the secondary index buffer is being used to highlight/hide a subset of triangles.\n@warning This can only be called on the Rendering Thread."
    },
    {
      "id": "upload-vertex-update",
      "name": "UploadVertexUpdate",
      "category": "MeshRenderBufferSet",
      "signature": "UploadVertexUpdate(Target, Positions, Mesh Attribs, Colors)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRenderBufferSet*"
        },
        {
          "name": "Positions",
          "type": "Bool"
        },
        {
          "name": "Mesh Attribs",
          "type": "Bool"
        },
        {
          "name": "Colors",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Fast path to only update vertex buffers. This path rebuilds all the\nresources and reconfigures the vertex factory, so the counts/etc could be modified.\n@warning This can only be called on the Rendering Thread."
    },
    {
      "id": "transfer-vertex-update-to-gpu",
      "name": "TransferVertexUpdateToGPU",
      "category": "MeshRenderBufferSet",
      "signature": "TransferVertexUpdateToGPU(Target, RHI Cmd List, Positions, Normals, Tex Coords, Colors)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRenderBufferSet*"
        },
        {
          "name": "RHI Cmd List",
          "type": "FRHICommandListBase&"
        },
        {
          "name": "Positions",
          "type": "Bool"
        },
        {
          "name": "Normals",
          "type": "Bool"
        },
        {
          "name": "Tex Coords",
          "type": "Bool"
        },
        {
          "name": "Colors",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Fast path to update various vertex buffers. This path does not support changing the\nsize/counts of any of the sub-buffers, a direct memcopy from the CPU-side buffer to the RHI buffer is used.\n@warning This can only be called on the Rendering Thread."
    },
