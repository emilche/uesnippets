        {
          "name": "Copy",
          "type": "FDynamicMeshAttributeSet&"
        }
      ],
      "returnType": "Void",
      "docs": "Performs a CompactCopy of the attached overlays/attributes.\nCalled by the parent mesh CompactCopy function.\n@param CompactMaps Maps indicating how vertices and triangles were changes in the parent\n@param Copy The attribute set to be copied"
    },
