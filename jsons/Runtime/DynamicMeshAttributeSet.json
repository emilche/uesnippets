      "id": "copy-bone-attributes",
      "name": "CopyBoneAttributes",
      "category": "DynamicMeshAttributeSet",
      "signature": "CopyBoneAttributes(Target, Copy)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicMeshAttributeSet*"
        },
        {
          "name": "Copy",
          "type": "FDynamicMeshAttributeSet&"
        }
      ],
      "returnType": "Void",
      "docs": "Copy all bone attributes from the given attribute set to this attribute set, removing any values that were there before.\n@param Copy The attribute set to copy from."
    },
    {
      "id": "copy-bone-attributes-with-remapping",
      "name": "CopyBoneAttributesWithRemapping",
      "category": "DynamicMeshAttributeSet",
      "signature": "CopyBoneAttributesWithRemapping(Target, Copy, Bone Hierarchy)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicMeshAttributeSet*"
        },
        {
          "name": "Copy",
          "type": "FDynamicMeshAttributeSet&"
        },
        {
          "name": "Bone Hierarchy",
          "type": "TMap<FName,FName>&"
        }
      ],
      "returnType": "Void",
      "docs": "Copy bone attributes from the given attribute set to this attribute set, removing any values that were there before, using\nthe given bone hierarchy map to control which bones are copied, and how parent bone indices should be remapped.\n@param Copy The attribute set to copy from.\n@param BoneHierarchy The hierarchy to use to copy. The key is the bone name to copy and value is the new parent name to\nassign to it upon copy. The order of the resulting values is the same as in the Copy. A parent name of NAME_None indicates\nthat the bone is a root bone and will have a parent index of INDEX_NONE. If a parent name is not in the list of bones to\ncopy, then that bone's parent index will also be set to INDEX_NONE."
    },
