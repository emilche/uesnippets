    {
      "id": "enable-matching-attributes",
      "name": "EnableMatchingAttributes",
      "category": "DynamicMeshAttributeSet",
      "signature": "EnableMatchingAttributes(Target, To Match, Clear Existing, Discard Extra Attributes)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicMeshAttributeSet*"
        },
        {
          "name": "To Match",
          "type": "FDynamicMeshAttributeSet&"
        },
        {
          "name": "Clear Existing",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Discard Extra Attributes",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Enable the matching attributes and overlay layers as the ToMatch set, but do not copy any data across.\nIf bClearExisting=true, all existing attributes are cleared, so after the function there is an exact match\nbut any existing attribute data is lost (!)\nIf bClearExisting=false, new attributes are added, but existing attributes and data are preserved\nIf bDiscardExtraAttributes=true and bClearExisting=false, then attributes in the current set but not in ToMatch are discarded, but existing attributes are not cleared/reset"
    },
