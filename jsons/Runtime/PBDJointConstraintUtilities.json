    {
      "id": "condition-inertia",
      "name": "ConditionInertia",
      "category": "PBDJointConstraintUtilities",
      "signature": "ConditionInertia(In I, Max Ratio)",
      "params": [
        {
          "name": "In I",
          "type": "FVec3&"
        },
        {
          "name": "Max Ratio",
          "type": "FReal"
        }
      ],
      "returnType": "FVec3",
      "docs": "Increase the lower inertia components to ensure that the maximum ratio between any pair of elements is MaxRatio.\n@param InI The input inertia.\n@return An altered inertia so that the minimum element is at least MaxElement/MaxRatio."
    },
    {
      "id": "condition-parent-inertia",
      "name": "ConditionParentInertia",
      "category": "PBDJointConstraintUtilities",
      "signature": "ConditionParentInertia(I Parent, I Child, Min Ratio)",
      "params": [
        {
          "name": "I Parent",
          "type": "FVec3&"
        },
        {
          "name": "I Child",
          "type": "FVec3&"
        },
        {
          "name": "Min Ratio",
          "type": "FReal"
        }
      ],
      "returnType": "FVec3",
      "docs": "Increase the IParent inertia so that its largest component is at least MinRatio times the largest IChild component.\nThis is used to condition joint chains for more robust solving with low iteration counts or larger time steps.\n@param IParent The input inertia.\n@param IChild The input inertia.\n@param OutIParent The output inertia.\n@param MinRatio Parent inertia will be at least this multiple of child inertia\n@return The max/min ratio of InI elements."
    },
