      "category": "SNotificationList",
      "signature": "AddNotification(Target, Info)",
      "params": [
        {
          "name": "Target",
          "type": "SNotificationList*"
        },
        {
          "name": "Info",
          "type": "FNotificationInfo&"
        }
      ],
      "returnType": "TSharedRef<SNotificationItem>",
      "docs": "Adds a floating notification.\n@param Info \t\tContains various settings used to initialize the notification."
    },
    {
      "id": "notification-item-faded-out",
      "name": "NotificationItemFadedOut",
      "category": "SNotificationList",
      "signature": "NotificationItemFadedOut(Target, Notification Item)",
      "params": [
        {
          "name": "Target",
          "type": "SNotificationList*"
        },
        {
          "name": "Notification Item",
          "type": "TSharedRef<SNotificationItem>&"
        }
      ],
      "returnType": "protected : void",
