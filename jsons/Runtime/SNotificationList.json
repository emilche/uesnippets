      "name": "ShowCopyToClipboadHyperlink",
      "category": "SNotificationList",
      "signature": "ShowCopyToClipboadHyperlink(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNotificationInfo*"
        }
      ],
      "returnType": "Void",
      "docs": "Shows a \"Copy to Clipboard\" hyperlink that when clicked copies the text and sub-text to the operating system clipboard\n@note Text and SubText must be set prior to calling this method for them to be included"
    },
    {
