    {
      "id": "multiply-using-matrix-with-scale",
      "name": "MultiplyUsingMatrixWithScale",
      "category": "TransformNonVectorized",
      "signature": "MultiplyUsingMatrixWithScale(Out Transform, A, B)",
      "params": [
        {
          "name": "Out Transform",
          "type": "TTransform<T>*"
        },
        {
          "name": "A",
          "type": "TTransform<T>*"
        },
        {
          "name": "B",
          "type": "TTransform<T>*"
        }
      ],
      "returnType": "template<T> void TTransform<T",
      "docs": "Create a new transform: OutTransform = A * B using the matrix while keeping the scale that's given by A and B\nPlease note that this operation is a lot more expensive than normal Multiply\nOrder matters when composing transforms : A * B will yield a transform that logically first applies A then B to any subsequent transformation.\n@param  OutTransform pointer to transform that will store the result of A * B.\n@param  A Transform A.\n@param  B Transform B."
    },
    {
      "id": "construct-transform-from-matrix-with-desired-scale",
      "name": "ConstructTransformFromMatrixWithDesiredScale",
      "category": "TransformNonVectorized",
      "signature": "ConstructTransformFromMatrixWithDesiredScale(A Matrix, B Matrix, Desired Scale, Out Transform)",
      "params": [
        {
          "name": "A Matrix",
          "type": "TMatrix<T>&"
        },
        {
          "name": "B Matrix",
          "type": "TMatrix<T>&"
        },
        {
          "name": "Desired Scale",
          "type": "TVector<T>&"
        },
        {
          "name": "Out Transform",
          "type": "TTransform<T>&"
        }
      ],
      "returnType": "template<T> void TTransform<T",
      "docs": "Create a new transform from multiplications of given to matrices (AMatrix*BMatrix) using desired scale\nThis is used by MultiplyUsingMatrixWithScale and GetRelativeTransformUsingMatrixWithScale\nThis is only used to handle negative scale\n@param\tAMatrix first Matrix of operation\n@param\tBMatrix second Matrix of operation\n@param\tDesiredScale - there is no check on if the magnitude is correct here. It assumes that is correct.\n@param\tOutTransform the constructed transform"
    },
