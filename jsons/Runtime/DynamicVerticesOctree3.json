      "returnType": "Void",
      "docs": "Remove a list of vertices from the tree"
    },
    {
      "id": "reinsert-vertices",
      "name": "ReinsertVertices",
      "category": "DynamicVerticesOctree3",
      "signature": "ReinsertVertices(Target, Vertices)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVerticesOctree3*"
