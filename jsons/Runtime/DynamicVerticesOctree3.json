        },
        {
          "name": "Vertices",
          "type": "TArray<int>&"
        }
      ],
      "returnType": "Void",
      "docs": "Insert a list of vertices into the tree"
    },
    {
      "id": "remove-point",
      "name": "RemovePoint",
      "category": "DynamicVerticesOctree3",
