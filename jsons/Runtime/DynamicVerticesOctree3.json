{
  "id": "dynamic-vertices-octree-3",
  "label": "DynamicVerticesOctree3",
  "includepath": "DynamicMesh/DynamicVerticesOctree3.h",
  "includes": [
    "MeshAABBTree3",
    "SparseDynamicPointOctree3",
    "MeshQueries",
    "IntersectionUtil",
    "DynamicMesh3"
  ],
  "functions": [
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "DynamicVerticesOctree3",
      "signature": "Initialize(Target, Vertex Source In, Dynamic Expand)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVerticesOctree3*"
        },
        {
          "name": "Vertex Source In",
          "type": "SourceType*"
        },
        {
          "name": "Dynamic Expand",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "TDynamicVerticesOctree3 is an extension of FSparseDynamicPointOctree3 for the vertices of\na FDynamicXYZ3 instance (eg FDynamicMesh3, TDynamicPointSet3, FDynamicGraph, etc)\nThis extension does several things:\n1) provides a simplified API based on vertex IDs to various Octree functions\n2) tracks ModifiedBounds box of modified areas\nThe template expansion requires that FDynamicXYZ3 has the following API:\n1) a function int MaxVertexID() that returns the maximum vertex ID/index\n2) a function bool IsVertex(int) that returns true if the index is valid\n3) a function FVector3d GetVertex(int index) that returns the position of a vertex\n4) a function FAxisAlignedBox3d GetBounds() that returns a bounding-box of the point set"
    },
    {
      "id": "reset-modified-bounds",
      "name": "ResetModifiedBounds",
      "category": "DynamicVerticesOctree3",
      "signature": "ResetModifiedBounds(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVerticesOctree3*"
        }
      ],
      "returnType": "Void",
      "docs": "Reset the internal ModifiedBounds box that tracks modified triangle bounds"
    },
    {
      "id": "insert-vertex",
      "name": "InsertVertex",
      "category": "DynamicVerticesOctree3",
      "signature": "InsertVertex(Target, Vertex ID)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVerticesOctree3*"
        },
        {
          "name": "Vertex ID",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Insert a triangle into the tree"
    },
    {
      "id": "insert-vertices",
      "name": "InsertVertices",
