    },
    {
      "id": "notify-pending-modification-035864",
      "name": "NotifyPendingModification",
      "category": "DynamicVerticesOctree3",
      "signature": "NotifyPendingModification(Target, Vertices)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVerticesOctree3*"
        },
        {
