{
  "id": "s-mesh-widget",
  "label": "SMeshWidget",
  "includepath": "Slate/SMeshWidget.h",
  "includes": [
    "CoreMinimal",
    "GCObject",
    "SlateShaderResource",
    "RenderingCommon",
    "DeclarativeSyntaxSupport",
    "SLeafWidget"
  ],
  "functions": [
    {
      "id": "add-mesh",
      "name": "AddMesh",
      "category": "SMeshWidget",
      "signature": "AddMesh(Target, In Mesh Data)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "In Mesh Data",
          "type": "USlateVectorArtData&"
        }
      ],
      "returnType": "UInt",
      "docs": "Draw the InStaticMesh when this widget paints.\n@return the Index of the mesh data that was added; cache this value for use with @see FRenderRun."
    },
    {
      "id": "add-mesh-with-instancing",
      "name": "AddMeshWithInstancing",
      "category": "SMeshWidget",
      "signature": "AddMeshWithInstancing(Target, In Mesh Data, Initial Buffer Size)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "In Mesh Data",
          "type": "USlateVectorArtData&"
        },
        {
          "name": "Initial Buffer Size",
          "type": "Int",
          "default": "1"
        }
      ],
      "returnType": "UInt",
      "docs": "Much like AddMesh, but also enables instancing support for this MeshId."
    },
    {
      "id": "convert-to-mid",
      "name": "ConvertToMID",
      "category": "SMeshWidget",
      "signature": "ConvertToMID(Target, Mesh Id)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        }
      ],
      "returnType": "UMaterialInstanceDynamic*",
      "docs": "Switch from static material to material instance dynamic.\n@param MeshId    The index of the mesh; returned from AddMesh.\n@return The MID for this Asset on which parameters can be set."
    },
    {
      "id": "clear-runs",
      "name": "ClearRuns",
      "category": "SMeshWidget",
      "signature": "ClearRuns(Target, Num Runs)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Num Runs",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Discard any previous runs and reserve space for new render runs if needed."
    },
    {
      "id": "add-render-run",
      "name": "AddRenderRun",
      "category": "SMeshWidget",
      "signature": "AddRenderRun(Target, In Mesh Index, In Instance Offset, In Num Instances)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "In Mesh Index",
          "type": "UInt"
        },
        {
          "name": "In Instance Offset",
          "type": "UInt"
        },
        {
          "name": "In Num Instances",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Tell the widget to draw instances of a mesh a given number of times starting at\na given offset.\n@param InMeshIndex        Which mesh to draw; returned by @see AddMesh\n@param InInstanceOffset   Start drawing with this instance\n@param InNumInstances     Draw this many instances"
    },
    {
      "id": "enable-instancing",
      "name": "EnableInstancing",
      "category": "SMeshWidget",
      "signature": "EnableInstancing(Target, Mesh Id, Initial Size)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        },
        {
          "name": "Initial Size",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Enable hardware instancing"
    },
    {
      "id": "update-per-instance-buffer",
      "name": "UpdatePerInstanceBuffer",
      "category": "SMeshWidget",
      "signature": "UpdatePerInstanceBuffer(Target, Mesh Id, Data)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        },
        {
          "name": "Data",
          "type": "FSlateInstanceBufferData&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the per instance buffer. Automatically enables hardware instancing."
    },
    {
      "id": "get-mesh-index",
      "name": "GetMeshIndex",
      "category": "SMeshWidget",
      "signature": "GetMeshIndex(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRenderRun*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-instance-offset",
      "name": "GetInstanceOffset",
      "category": "SMeshWidget",
      "signature": "GetInstanceOffset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRenderRun*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-num-instances",
      "name": "GetNumInstances",
      "category": "SMeshWidget",
      "signature": "GetNumInstances(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRenderRun*"
        }
      ],
      "returnType": "UInt"
    }
  ]
}