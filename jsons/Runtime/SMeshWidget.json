{
  "id": "s-mesh-widget",
  "label": "SMeshWidget",
  "includepath": "Slate/SMeshWidget.h",
  "includes": [
    "CoreMinimal",
    "GCObject",
    "SlateShaderResource",
    "RenderingCommon",
    "DeclarativeSyntaxSupport",
    "SLeafWidget"
  ],
  "functions": [
    {
      "id": "add-mesh",
      "name": "AddMesh",
      "category": "SMeshWidget",
      "signature": "AddMesh(Target, In Mesh Data)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "In Mesh Data",
          "type": "USlateVectorArtData&"
        }
      ],
      "returnType": "UInt",
      "docs": "Draw the InStaticMesh when this widget paints.\n@return the Index of the mesh data that was added; cache this value for use with @see FRenderRun."
    },
    {
      "id": "add-mesh-with-instancing",
      "name": "AddMeshWithInstancing",
      "category": "SMeshWidget",
      "signature": "AddMeshWithInstancing(Target, In Mesh Data, Initial Buffer Size)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "In Mesh Data",
          "type": "USlateVectorArtData&"
        },
        {
          "name": "Initial Buffer Size",
          "type": "Int",
          "default": "1"
        }
      ],
      "returnType": "UInt",
      "docs": "Much like AddMesh, but also enables instancing support for this MeshId."
    },
    {
      "id": "convert-to-mid",
      "name": "ConvertToMID",
      "category": "SMeshWidget",
      "signature": "ConvertToMID(Target, Mesh Id)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        }
      ],
      "returnType": "UMaterialInstanceDynamic*",
      "docs": "Switch from static material to material instance dynamic.\n@param MeshId    The index of the mesh; returned from AddMesh.\n@return The MID for this Asset on which parameters can be set."
    },
    {
      "id": "clear-runs",
      "name": "ClearRuns",
      "category": "SMeshWidget",
      "signature": "ClearRuns(Target, Num Runs)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Num Runs",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Discard any previous runs and reserve space for new render runs if needed."
    },
    {
      "id": "enable-instancing",
      "name": "EnableInstancing",
      "category": "SMeshWidget",
      "signature": "EnableInstancing(Target, Mesh Id, Initial Size)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        },
        {
          "name": "Initial Size",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Enable hardware instancing"
    },
    {
      "id": "update-per-instance-buffer",
      "name": "UpdatePerInstanceBuffer",
      "category": "SMeshWidget",
      "signature": "UpdatePerInstanceBuffer(Target, Mesh Id, Data)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Mesh Id",
          "type": "UInt"
        },
        {
          "name": "Data",
          "type": "FSlateInstanceBufferData&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the per instance buffer. Automatically enables hardware instancing."
    },
    {
      "id": "on-paint",
      "name": "OnPaint",
      "category": "SMeshWidget",
      "signature": "OnPaint(Target, Args, Allotted Geometry, My Culling Rect, Out Draw Elements, Layer Id, In Widget Style, Parent Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Args",
          "type": "FPaintArgs&"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "My Culling Rect",
          "type": "FSlateRect&"
        },
        {
          "name": "Out Draw Elements",
          "type": "FSlateWindowElementList&"
        },
        {
          "name": "Layer Id",
          "type": "Int"
        },
        {
          "name": "In Widget Style",
          "type": "FWidgetStyle&"
        },
        {
          "name": "Parent Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "protected : int32"
    },
    {
      "id": "compute-desired-size",
      "name": "ComputeDesiredSize",
      "category": "SMeshWidget",
      "signature": "ComputeDesiredSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        }
      ],
      "returnType": "FVector2D"
    },
    {
      "id": "add-referenced-objects",
      "name": "AddReferencedObjects",
      "category": "SMeshWidget",
      "signature": "AddReferencedObjects(Target, Collector)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        },
        {
          "name": "Collector",
          "type": "FReferenceCollector&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-referencer-name",
      "name": "GetReferencerName",
      "category": "SMeshWidget",
      "signature": "GetReferencerName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SMeshWidget*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "push-update-5adda9",
      "name": "PushUpdate",
      "category": "SMeshWidget",
      "signature": "PushUpdate(Vector Art Id, Widget, Position, Scale, Base Address)",
      "params": [
        {
          "name": "Vector Art Id",
          "type": "UInt"
        },
        {
          "name": "Widget",
          "type": "SMeshWidget&"
        },
        {
          "name": "Position",
          "type": "FVector2D&"
        },
        {
          "name": "Scale",
          "type": "Float"
        },
        {
          "name": "Base Address",
          "type": "UInt"
        }
      ],
      "returnType": "protected : void"
    },
    {
      "id": "push-update-930475",
      "name": "PushUpdate",
      "category": "SMeshWidget",
      "signature": "PushUpdate(Vector Art Id, Widget, Position, Scale, Optional Float)",
      "params": [
        {
          "name": "Vector Art Id",
          "type": "UInt"
        },
        {
          "name": "Widget",
          "type": "SMeshWidget&"
        },
        {
          "name": "Position",
          "type": "FVector2D&"
        },
        {
          "name": "Scale",
          "type": "Float"
        },
        {
          "name": "Optional Float",
          "type": "Float",
          "default": "0"
        }
      ],
      "returnType": "Void"
    }
  ]
}