    {
      "id": "to-barycentric",
      "name": "ToBarycentric",
      "category": "Triangle",
      "signature": "ToBarycentric<RealType>(Target, Point, V 0, V 1, V 2)",
      "params": [
        {
          "name": "Target",
          "type": "TTriangle*"
        },
        {
          "name": "Point",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 0",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 1",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 2",
          "type": "TVec3<RealType>&"
        }
      ],
      "returnType": "template<RealType> TVec3<RealType>",
      "docs": "@brief Convert the cartesian coordinate into a barycentric corrdinate.\nCompute barycentric coordinates/weights of Point inside 3D triangle (V0,V1,V2).\nIf point is in triangle plane and inside triangle, coords will be positive and sum to 1.\nie if result is a, then vPoint = a.x*V0 + a.y*V1 + a.z*V2.\n@note For points outside the triangle it will return negative barycentric coordinates that should still sum to 1. However,\nif the triangle is degenerate and the point is not on the line/vertex, it will return (1,0,0) with no way to detect this condition.\n@see FromBarycentric()"
    },
    {
      "id": "from-barycentric",
      "name": "FromBarycentric",
      "category": "Triangle",
      "signature": "FromBarycentric<RealType>(Target, Barycentric, V 0, V 1, V 2)",
      "params": [
        {
          "name": "Target",
          "type": "TTriangle*"
