        {
          "name": "Barycentric",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 0",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 1",
          "type": "TVec3<RealType>&"
        },
        {
          "name": "V 2",
          "type": "TVec3<RealType>&"
        }
      ],
      "returnType": "template<RealType> TVec3<RealType>",
      "docs": "@brief Convert the barycentric coordinate into a cartesian corrdinate\n@see ToBarycentric()"
    },
