    {
      "id": "rhi-lock-staging-buffer",
      "name": "RHILockStagingBuffer",
      "category": "DynamicRHI",
      "signature": "RHILockStagingBuffer(Target, Staging Buffer, Fence, Offset, Size RHI)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicRHI*"
        },
        {
          "name": "Staging Buffer",
          "type": "FRHIStagingBuffer*"
        },
        {
          "name": "Fence",
          "type": "FRHIGPUFence*"
        },
        {
          "name": "Offset",
          "type": "UInt"
        },
        {
          "name": "Size RHI",
          "type": "UInt"
        }
      ],
      "returnType": "void*",
      "docs": "Lock a staging buffer to read contents on the CPU that were written by the GPU, without having to stall.\n@discussion This function requires that you have issued an CopyToStagingBuffer invocation and verified that the FRHIGPUFence has been signaled before calling.\n@param StagingBuffer The buffer to lock.\n@param Fence An optional fence synchronized with the last buffer update.\n@param Offset The offset in the buffer to return.\n@param SizeRHI The length of the region in the buffer to lock.\n@returns A pointer to the data starting at 'Offset' and of length 'SizeRHI' from 'StagingBuffer', or nullptr when there is an error."
    },
    {
      "id": "rhi-unlock-staging-buffer",
      "name": "RHIUnlockStagingBuffer",
      "category": "DynamicRHI",
      "signature": "RHIUnlockStagingBuffer(Target, Staging Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicRHI*"
        },
        {
          "name": "Staging Buffer",
          "type": "FRHIStagingBuffer*"
        }
      ],
      "returnType": "Void",
      "docs": "Unlock a staging buffer previously locked with RHILockStagingBuffer.\n@param StagingBuffer The buffer that was previously locked."
    },
    {
      "id": "lock-staging-buffer-render-thread",
      "name": "LockStagingBuffer_RenderThread",
      "category": "DynamicRHI",
      "signature": "LockStagingBuffer_RenderThread(Target, RHI Cmd List, Staging Buffer, Fence, Offset, Size RHI)",
      "params": [
        {
          "name": "Target",
