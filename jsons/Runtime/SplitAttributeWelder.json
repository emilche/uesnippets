      "returnType": "Void",
      "docs": "Weld split-elements across the entire mesh."
    },
    {
      "id": "weld-split-u-vs",
      "name": "WeldSplitUVs",
      "category": "SplitAttributeWelder",
      "signature": "WeldSplitUVs(Parent VID, UV Overlay, UV Dist Sqrd Threshold)",
      "params": [
        {
          "name": "Parent VID",
          "type": "Int"
        },
        {
          "name": "UV Overlay",
          "type": "FDynamicMeshUVOverlay&"
        },
        {
          "name": "UV Dist Sqrd Threshold",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Welds split UVs shared by the ParentVID vertex in the ParentMesh.\n@param ParentVID  defines a vertex in the parent mesh.\n@param UVOverlay contains potentially split UVs associated with the ParentVID. Assumed to be an overlay of the ParentMesh.\n@param UVDistSqrdThreshold  provides a threshold in distance squared UV space between split UVs that should be welded."
    },
    {
      "id": "weld-split-unit-vectors",
      "name": "WeldSplitUnitVectors",
      "category": "SplitAttributeWelder",
      "signature": "WeldSplitUnitVectors(Parent VID, Normal Overlay, Dot Threshold, Merge Zero Vectors)",
      "params": [
        {
          "name": "Parent VID",
          "type": "Int"
        },
        {
          "name": "Normal Overlay",
          "type": "FDynamicMeshNormalOverlay&"
        },
        {
          "name": "Dot Threshold",
          "type": "Float"
        },
        {
          "name": "Merge Zero Vectors",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Welds split Normals / Tangents shared by the ParentVID vertex in the ParentMesh based on the angled between the vectors.\n@param ParentVID  defines a vertex in the Parent Mesh\n@param NormalOverlay contains potentially split vectors associated with the ParentVID. Assumed to be an overlay of the ParentMesh.\n@param DotThreshold  provides a threshold for the dot product between two vectors that should be welded.\n@param bMergeZeroVectors will weld vectors that are too small to normalize."
    },
    {
      "id": "weld-split-colors",
      "name": "WeldSplitColors",
      "category": "SplitAttributeWelder",
      "signature": "WeldSplitColors(Parent VID, Color Overlay, Color Dist Sqrd Threshold)",
      "params": [
        {
          "name": "Parent VID",
          "type": "Int"
        },
        {
          "name": "Color Overlay",
          "type": "FDynamicMeshColorOverlay&"
        },
        {
          "name": "Color Dist Sqrd Threshold",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Welds split colors shared by the ParentVID vertex in the ParentMesh.\n@param ParentVID  defines a vertex in the Parent Mesh\n@param ColorOverlay contains potentially split colors associated with the ParentVID. Assumed to be an overlay of the ParentMesh.\n@param ColorDistSqrdThreshold  provides a threshold applied to the sum of the square differences between to colors.  Used to determine if a weld should be preformed."
