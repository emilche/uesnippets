      "id": "weld-split-elements-037f86",
      "name": "WeldSplitElements",
      "category": "SplitAttributeWelder",
      "signature": "WeldSplitElements(Target, Parent Mesh, Parent VID)",
      "params": [
        {
          "name": "Target",
