        {
          "name": "Parent VID",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Merge threshold used to compare UV Overlay elements.\nApplied as FVector2f::DistSquared(UVA , UVB) <= UVDisSqrdThreshold"
    },
    {
      "id": "weld-split-elements-01b08b",
