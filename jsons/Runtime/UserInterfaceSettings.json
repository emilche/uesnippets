{
  "id": "user-interface-settings",
  "label": "UserInterfaceSettings",
  "includepath": "Engine/UserInterfaceSettings.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SoftObjectPath",
    "CurveFloat",
    "DeveloperSettings",
    "SWidget",
    "UserInterfaceSettings.generated"
  ],
  "functions": [
    {
      "id": "post-init-properties",
      "name": "PostInitProperties",
      "category": "UserInterfaceSettings",
      "signature": "PostInitProperties(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "force-load-resources",
      "name": "ForceLoadResources",
      "category": "UserInterfaceSettings",
      "signature": "ForceLoadResources(Target, Force Load Everything)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        },
        {
          "name": "Force Load Everything",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Loads assets, if bForceLoadEverything is true it will load despite environment"
    },
    {
      "id": "get-dpi-scale-based-on-size",
      "name": "GetDPIScaleBasedOnSize",
      "category": "UserInterfaceSettings",
      "signature": "GetDPIScaleBasedOnSize(Target, Size)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        },
        {
          "name": "Size",
          "type": "FIntPoint"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the current scale of the UI based on the size of a viewport"
    },
    {
      "id": "get-font-dpi-display-string",
      "name": "GetFontDPIDisplayString",
      "category": "UserInterfaceSettings",
      "signature": "GetFontDPIDisplayString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the string to use when we need detailed info about the DPI.\nIt will take into account the defined presets to give more context."
    },
    {
      "id": "get-font-display-dpi",
      "name": "GetFontDisplayDPI",
      "category": "UserInterfaceSettings",
      "signature": "GetFontDisplayDPI(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        }
      ],
      "returnType": "UInt",
      "docs": "Gets the Font DPI that should be used for display"
    },
    {
      "id": "post-edit-change-property",
      "name": "PostEditChangeProperty",
      "category": "UserInterfaceSettings",
      "signature": "PostEditChangeProperty(Target, Property Changed Event)",
      "params": [
        {
          "name": "Target",
          "type": "UUserInterfaceSettings*"
        },
        {
          "name": "Property Changed Event",
          "type": "FPropertyChangedEvent&"
        }
      ],
      "returnType": "Void"
    }
  ]
}