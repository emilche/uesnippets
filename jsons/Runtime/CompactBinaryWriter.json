    {
      "id": "save-beca23",
      "name": "Save",
      "category": "CompactBinaryWriter",
      "signature": "Save(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCbWriter*"
        }
      ],
      "returnType": "FCbFieldIterator",
      "docs": "Serialize the field(s) to an owned buffer and return it as an iterator.\nIt is not valid to call this function in the middle of writing an object, array, or field.\nThe writer remains valid for further use when this function returns."
    },
    {
      "id": "save-b5d753",
      "name": "Save",
      "category": "CompactBinaryWriter",
      "signature": "Save(Target, Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FCbWriter*"
        },
        {
          "name": "Buffer",
          "type": "FMutableMemoryView"
        }
      ],
      "returnType": "FCbFieldViewIterator",
      "docs": "Serialize the field(s) to memory.\nIt is not valid to call this function in the middle of writing an object, array, or field.\nThe writer remains valid for further use when this function returns.\n@param Buffer A mutable memory view to write to. Must be exactly GetSaveSize() bytes.\n@return An iterator for the field(s) written to the buffer."
    },
    {
      "id": "save-612c1d",
      "name": "Save",
      "category": "CompactBinaryWriter",
      "signature": "Save(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FCbWriter*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Serialize the field(s) to an archive.\nIt is not valid to call this function in the middle of writing an object, array, or field.\nThe writer remains valid for further use when this function returns.\n@param Ar An archive to write to. Exactly GetSaveSize() bytes will be written."
    },
    {
      "id": "get-save-size",
      "name": "GetSaveSize",
      "category": "CompactBinaryWriter",
      "signature": "GetSaveSize(Target)",
      "params": [
