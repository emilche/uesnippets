{
  "id": "ai-blueprint-helper-library",
  "label": "AIBlueprintHelperLibrary",
  "includepath": "Blueprint/AIBlueprintHelperLibrary.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SubclassOf",
    "Pawn",
    "BlueprintFunctionLibrary",
    "AIBlueprintHelperLibrary.generated"
  ],
  "functions": [
    {
      "id": "create-move-to-proxy-object",
      "name": "CreateMoveToProxyObject",
      "category": "AIBlueprintHelperLibrary",
      "signature": "CreateMoveToProxyObject(World Context Object, Pawn, Destination, Target Actor, Acceptance Radius, Stop On Overlap)",
      "params": [
        {
          "name": "World Context Object",
          "type": "UObject*"
        },
        {
          "name": "Pawn",
          "type": "APawn*"
        },
        {
          "name": "Destination",
          "type": "FVector"
        },
        {
          "name": "Target Actor",
          "type": "AActor*",
          "default": "NULL"
        },
        {
          "name": "Acceptance Radius",
          "type": "Float",
          "default": "5.f"
        },
        {
          "name": "Stop On Overlap",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "UAIAsyncTaskBlueprintProxy*"
    },
    {
      "id": "send-ai-message",
      "name": "SendAIMessage",
      "category": "AI",
      "signature": "SendAIMessage(Target, Message, Message Source, Success)",
      "params": [
        {
          "name": "Target",
          "type": "APawn*"
        },
        {
          "name": "Message",
          "type": "Name"
        },
        {
          "name": "Message Source",
          "type": "UObject*"
        },
        {
          "name": "Success",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "spawn-ai-from-class",
      "name": "SpawnAIFromClass",
      "category": "AI",
      "signature": "SpawnAIFromClass(World Context Object, Pawn Class, Behavior Tree, Location, Rotation, No Collision Fail, Owner)",
      "params": [
        {
          "name": "World Context Object",
          "type": "UObject*"
        },
        {
          "name": "Pawn Class",
          "type": "TSubclassOf<APawn>"
        },
        {
          "name": "Behavior Tree",
          "type": "UBehaviorTree*"
        },
        {
          "name": "Location",
          "type": "FVector"
        },
        {
          "name": "Rotation",
          "type": "FRotator",
          "default": "FRotator::ZeroRotator"
        },
        {
          "name": "No Collision Fail",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Owner",
          "type": "AActor*",
          "default": "nullptr"
        }
      ],
      "returnType": "APawn*",
      "docs": "Spawns AI agent of a given class. The PawnClass needs to have AIController\nset for the function to spawn a controller as well.\n@param BehaviorTree if set, and the function has successfully spawned\nand AI controller, this BehaviorTree asset will be assigned to the AI\ncontroller, and run.\n@param Owner lets you spawn the AI in a sublevel rather than in the\npersistent level (which is the default behavior)."
    },
    {
      "id": "get-ai-controller",
      "name": "GetAIController",
      "category": "AI",
      "signature": "GetAIController(Controlled Actor)",
      "params": [
        {
          "name": "Controlled Actor",
          "type": "AActor*"
        }
      ],
      "returnType": "AAIController*",
      "docs": "The way it works exactly is if the actor passed in is a pawn, then the function retrieves\npawn's controller cast to AIController. Otherwise the function returns actor cast to AIController."
    },
    {
      "id": "get-blackboard",
      "name": "GetBlackboard",
      "category": "AI",
      "signature": "GetBlackboard(Target)",
      "params": [
        {
          "name": "Target",
          "type": "AActor*"
        }
      ],
      "returnType": "UBlackboardComponent*"
    },
    {
      "id": "lock-ai-resources-with-animation",
      "name": "LockAIResourcesWithAnimation",
      "category": "Animation",
      "signature": "LockAIResourcesWithAnimation(Anim Instance, Lock Movement, Lock AI Logic)",
      "params": [
        {
          "name": "Anim Instance",
          "type": "UAnimInstance*"
        },
        {
          "name": "Lock Movement",
          "type": "Bool"
        },
        {
          "name": "Lock AI Logic",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "locks indicated AI resources of animated pawn"
    },
    {
      "id": "unlock-ai-resources-with-animation",
      "name": "UnlockAIResourcesWithAnimation",
      "category": "Animation",
      "signature": "UnlockAIResourcesWithAnimation(Anim Instance, Unlock Movement, Unlock AI Logic)",
      "params": [
        {
          "name": "Anim Instance",
          "type": "UAnimInstance*"
        },
        {
          "name": "Unlock Movement",
          "type": "Bool"
        },
        {
          "name": "Unlock AI Logic",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "unlocks indicated AI resources of animated pawn. Will unlock only animation-locked resources"
    },
    {
      "id": "is-valid-ai-location",
      "name": "IsValidAILocation",
      "category": "AI",
      "signature": "IsValidAILocation(Location)",
      "params": [
        {
          "name": "Location",
          "type": "FVector"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "is-valid-ai-direction",
      "name": "IsValidAIDirection",
      "category": "AI",
      "signature": "IsValidAIDirection(Direction Vector)",
      "params": [
        {
          "name": "Direction Vector",
          "type": "FVector"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "is-valid-ai-rotation",
      "name": "IsValidAIRotation",
      "category": "AI",
      "signature": "IsValidAIRotation(Rotation)",
      "params": [
        {
          "name": "Rotation",
          "type": "FRotator"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-current-path",
      "name": "GetCurrentPath",
      "category": "AI",
      "signature": "GetCurrentPath(Controller)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        }
      ],
      "returnType": "UNavigationPath*",
      "docs": "Returns a NEW UOBJECT that is a COPY of navigation path given controller is currently using.\nThe result being a copy means you won't be able to influence agent's pathfollowing\nby manipulating received path.\nPlease use GetCurrentPathPoints if you only need the array of path points."
    },
    {
      "id": "get-current-path-points",
      "name": "GetCurrentPathPoints",
      "category": "AI",
      "signature": "GetCurrentPathPoints(Controller)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        }
      ],
      "returnType": "TArray<FVector>",
      "docs": "Returns an array of navigation path points given controller is currently using."
    },
    {
      "id": "get-current-path-index",
      "name": "GetCurrentPathIndex",
      "category": "AI",
      "signature": "GetCurrentPathIndex(Controller)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        }
      ],
      "returnType": "Int",
      "docs": "Return the path index the given controller is currently at. Returns INDEX_NONE if no path."
    },
    {
      "id": "get-next-nav-link-index",
      "name": "GetNextNavLinkIndex",
      "category": "AI",
      "signature": "GetNextNavLinkIndex(Controller)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        }
      ],
      "returnType": "Int",
      "docs": "Return the path index of the next nav link for the current path of the given controller. Returns INDEX_NONE if no path or no incoming nav link."
    },
    {
      "id": "simple-move-to-actor",
      "name": "SimpleMoveToActor",
      "category": "AI",
      "signature": "SimpleMoveToActor(Controller, Goal)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        },
        {
          "name": "Goal",
          "type": "AActor*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "simple-move-to-location",
      "name": "SimpleMoveToLocation",
      "category": "AI",
      "signature": "SimpleMoveToLocation(Controller, Goal)",
      "params": [
        {
          "name": "Controller",
          "type": "AController*"
        },
        {
          "name": "Goal",
          "type": "FVector&"
        }
      ],
      "returnType": "Void"
    }
  ]
}