{
  "id": "ai-blueprint-helper-library",
  "label": "AIBlueprintHelperLibrary",
  "includepath": "Blueprint/AIBlueprintHelperLibrary.h",
  "functions": [
    {
      "id": "create-move-to-proxy-object",
      "name": "CreateMoveToProxyObject",
      "category": "AIBlueprintHelperLibrary",
      "signature": "CreateMoveToProxyObject(World Context Object, Pawn, Destination, Target Actor, Acceptance Radius, Stop On Overlap)",
      "params": [
        {
          "name": "World Context Object",
          "type": "UObject*"
        },
        {
          "name": "Pawn",
          "type": "APawn*"
        },
        {
          "name": "Destination",
          "type": "FVector"
        },
        {
          "name": "Target Actor",
          "type": "AActor*",
          "default": "NULL"
        },
        {
          "name": "Acceptance Radius",
          "type": "Float",
          "default": "5.f"
        },
        {
          "name": "Stop On Overlap",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "class AAIController"
    },
    {
      "id": "send-ai-message",
      "name": "SendAIMessage",
      "category": "AI",
      "signature": "SendAIMessage(Target, Message, Message Source, Success)",
      "params": [
        {
          "name": "Target",
          "type": "APawn*"
        },
        {
          "name": "Message",
          "type": "Name"
        },
        {
          "name": "Message Source",
          "type": "UObject*"
        },
        {
          "name": "Success",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "spawn-ai-from-class",
      "name": "SpawnAIFromClass",
      "category": "AI",
      "signature": "SpawnAIFromClass(World Context Object, Pawn Class, Behavior Tree, Location, Rotation, No Collision Fail, Owner)",
      "params": [
        {
          "name": "World Context Object",
          "type": "UObject*"
        },
        {
          "name": "Pawn Class",
          "type": "TSubclassOf<APawn>"
        },
        {
          "name": "Behavior Tree",
          "type": "UBehaviorTree*"
        },
        {
          "name": "Location",
          "type": "FVector"
        },
        {
          "name": "Rotation",
          "type": "FRotator",
          "default": "FRotator::ZeroRotator"
        },
        {
          "name": "No Collision Fail",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Owner",
          "type": "AActor*",
          "default": "nullptr"
        }
      ],
      "returnType": "APawn*"
    },
    {
