{
  "id": "bezier-utilities",
  "label": "BezierUtilities",
  "includepath": "Curves/BezierUtilities.h",
  "includes": [
    "Vector",
    "Box",
    "UnrealMathUtility"
  ],
  "functions": [
    {
      "id": "eval",
      "name": "Eval",
      "category": "BezierUtilities",
      "signature": "Eval(P 0, P 1, P 2, P 3, T)",
      "params": [
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "T",
          "type": "Float"
        }
      ],
      "returnType": "FVector",
      "docs": "Evaluates cubic bezier value at specified time"
    },
    {
      "id": "eval-derivate",
      "name": "EvalDerivate",
      "category": "BezierUtilities",
      "signature": "EvalDerivate(P 0, P 1, P 2, P 3, T)",
      "params": [
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "T",
          "type": "Float"
        }
      ],
      "returnType": "FVector",
      "docs": "Evaluates cubic bezier derivative at specified time"
    },
    {
      "id": "split-at",
      "name": "SplitAt",
      "category": "BezierUtilities",
      "signature": "SplitAt(P 0, P 1, P 2, P 3, T, Out Result)",
      "params": [
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "T",
          "type": "Float"
        },
        {
          "name": "Out Result",
          "type": "FVector"
        }
      ],
      "returnType": "Void",
      "docs": "Splits cubic bezier curve at specified time, returns new points.\nThe new curves are (P0, Result[0], Result[1], Result[2]) and (P0, Result[2], Result[3], Result[4], P3)"
    },
    {
      "id": "calc-bounds",
      "name": "CalcBounds",
      "category": "BezierUtilities",
      "signature": "CalcBounds(P 0, P 1, P 2, P 3)",
      "params": [
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        }
      ],
      "returnType": "FBox",
      "docs": "Returns bounding box of cubic bezier curve."
    },
    {
      "id": "closest-point-approximate",
      "name": "ClosestPointApproximate",
      "category": "BezierUtilities",
      "signature": "ClosestPointApproximate(From Point, P 0, P 1, P 2, P 3, Out Closest Point, Out Closest T, Steps)",
      "params": [
        {
          "name": "From Point",
          "type": "FVector&"
        },
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "Out Closest Point",
          "type": "FVector&"
        },
        {
          "name": "Out Closest T",
          "type": "Float&"
        },
        {
          "name": "Steps",
          "type": "Int",
          "default": "16"
        }
      ],
      "returnType": "Void",
      "docs": "Returns closest point to cubic bezier segment. The curve is split to up to Steps linear segments for approximate calculation."
    },
    {
      "id": "segment-closest-point-approximate",
      "name": "SegmentClosestPointApproximate",
      "category": "BezierUtilities",
      "signature": "SegmentClosestPointApproximate(Seg Start, Seg End, P 0, P 1, P 2, P 3, Out Closest Point, Out Closest T, Steps)",
      "params": [
        {
          "name": "Seg Start",
          "type": "FVector&"
        },
        {
          "name": "Seg End",
          "type": "FVector&"
        },
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "Out Closest Point",
          "type": "FVector&"
        },
        {
          "name": "Out Closest T",
          "type": "Float&"
        },
        {
          "name": "Steps",
          "type": "Int",
          "default": "16"
        }
      ],
      "returnType": "Void",
      "docs": "Returns closest point between a linear segment and cubic bezier segment. The curve is split to up to Steps linear segments for approximate calculation."
    },
    {
      "id": "arc-length-approximate",
      "name": "ArcLengthApproximate",
      "category": "BezierUtilities",
      "signature": "ArcLengthApproximate(P 0, P 1, P 2, P 3)",
      "params": [
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        }
      ],
      "returnType": "Float",
      "docs": "Returns approximate arc length of cubic bezier. The length is calculated based on control point hull with one subdivision."
    },
    {
      "id": "tessellate",
      "name": "Tessellate",
      "category": "BezierUtilities",
      "signature": "Tessellate(Output, P 0, P 1, P 2, P 3, Tolerance, Max Level)",
      "params": [
        {
          "name": "Output",
          "type": "TArray<FVector>&"
        },
        {
          "name": "P 0",
          "type": "FVector&"
        },
        {
          "name": "P 1",
          "type": "FVector&"
        },
        {
          "name": "P 2",
          "type": "FVector&"
        },
        {
          "name": "P 3",
          "type": "FVector&"
        },
        {
          "name": "Tolerance",
          "type": "Float"
        },
        {
          "name": "Max Level",
          "type": "Int",
          "default": "6"
        }
      ],
      "returnType": "Void",
      "docs": "Recursively tessellate a bezier curve until the segments are within Tolerance from the curve, or until max recursion level is reached.\nOutput will contain points describing linear segments of the flattened curve.\nNote that the points are appended, and that the first point is omitted so that the function can be used to flatten a bezier shape."
    }
  ]
}