{
  "id": "system-settings",
  "label": "SystemSettings",
  "includepath": "SystemSettings.h",
  "includes": [
    "CoreMinimal",
    "ShowFlags"
  ],
  "functions": [
    {
      "id": "load-from-ini",
      "name": "LoadFromIni",
      "category": "SystemSettings",
      "signature": "LoadFromIni(Target, Ini Section, Ini Filename, Allow Missing Values, Found Values)",
      "params": [
        {
          "name": "Target",
          "type": "FSystemSettingsData*"
        },
        {
          "name": "Ini Section",
          "type": "TCHAR*"
        },
        {
          "name": "Ini Filename",
          "type": "String&",
          "default": "GEngineIni"
        },
        {
          "name": "Allow Missing Values",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Found Values",
          "type": "Bool*",
          "default": "NULL"
        }
      ],
      "returnType": "Void",
      "docs": "loads settings from the given section in the given ini"
    },
    {
      "id": "on-set-c-var-from-ini-entry",
      "name": "OnSetCVarFromIniEntry",
      "category": "SystemSettings",
      "signature": "OnSetCVarFromIniEntry(Target, Ini File, Key, Value, Set By, Allow Cheating)",
      "params": [
        {
          "name": "Target",
          "type": "FSystemSettings*"
        },
        {
          "name": "Ini File",
          "type": "TCHAR*"
        },
        {
          "name": "Key",
          "type": "TCHAR*"
        },
        {
          "name": "Value",
          "type": "TCHAR*"
        },
        {
          "name": "Set By",
          "type": "UInt"
        },
        {
          "name": "Allow Cheating",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "category": "SystemSettings",
      "signature": "Initialize(Target, Setup For Editor)",
      "params": [
        {
          "name": "Target",
          "type": "FSystemSettings*"
        },
        {
          "name": "Setup For Editor",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes system settings and included texture LOD settings.\n@param bSetupForEditor\tWhether to initialize settings for Editor"
    },
    {
      "id": "get-force-0-mask",
      "name": "GetForce0Mask",
      "category": "SystemSettings",
      "signature": "GetForce0Mask(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSystemSettings*"
        }
      ],
      "returnType": "FEngineShowFlags&",
      "docs": "Mask where 1 bits mean we want to force the engine show flag to be off"
    },
    {
      "id": "get-force-1-mask",
      "name": "GetForce1Mask",
      "category": "SystemSettings",
      "signature": "GetForce1Mask(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSystemSettings*"
        }
      ],
      "returnType": "FEngineShowFlags&",
      "docs": "Mask where 1 bits mean we want to force the engine show flag to be on"
    }
  ]
}