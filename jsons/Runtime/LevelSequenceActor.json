    {
      "id": "set-binding",
      "name": "SetBinding",
      "category": "Sequencer",
      "signature": "SetBinding(Target, Binding, Actors, Allow Bindings From Asset)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelSequenceActor*"
        },
        {
          "name": "Binding",
          "type": "FMovieSceneObjectBindingID"
        },
        {
          "name": "Actors",
          "type": "TArray<AActor*>&"
        },
        {
          "name": "Allow Bindings From Asset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Overrides the specified binding with the specified actors, optionally still allowing the bindings defined in the Level Sequence asset\n@param Binding Binding to modify\n@param Actors Actors to bind\n@param bAllowBindingsFromAsset If false the new bindings being supplied here will replace the bindings set in the level sequence asset, meaning the original object animated by\nSequencer will no longer be animated. Bindings set to spawnables will not spawn if false. If true, new bindings will be in addition to ones set\nset in Sequencer UI. This function will not modify the original asset."
    },
    {
      "id": "set-binding-by-tag",
      "name": "SetBindingByTag",
      "category": "Sequencer",
      "signature": "SetBindingByTag(Target, Binding Tag, Actors, Allow Bindings From Asset)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelSequenceActor*"
        },
        {
          "name": "Binding Tag",
          "type": "Name"
        },
        {
          "name": "Actors",
          "type": "TArray<AActor*>&"
        },
        {
          "name": "Allow Bindings From Asset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Assigns an set of actors to all the bindings tagged with the specified name in this sequence. Object Bindings can be tagged within the sequence UI by RMB -> Tags... on the object binding in the tree.\n@param BindingTag   The unique tag name to lookup bindings with\n@param Actors       The actors to assign to all the tagged bindings\n@param bAllowBindingsFromAsset If false the new bindings being supplied here will replace the bindings set in the level sequence asset, meaning the original object animated by\nSequencer will no longer be animated. Bindings set to spawnables will not spawn if false. If true, new bindings will be in addition to ones set\nset in Sequencer UI. This function will not modify the original asset."
    },
    {
      "id": "add-binding",
      "name": "AddBinding",
      "category": "Sequencer",
      "signature": "AddBinding(Target, Binding, Actor, Allow Bindings From Asset)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelSequenceActor*"
        },
        {
          "name": "Binding",
          "type": "FMovieSceneObjectBindingID"
        },
        {
          "name": "Actor",
          "type": "AActor*"
        },
        {
          "name": "Allow Bindings From Asset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Adds the specified actor to the overridden bindings for the specified binding ID, optionally still allowing the bindings defined in the Level Sequence asset\n@param Binding Binding to modify\n@param Actor Actor to bind\n@param bAllowBindingsFromAsset If false the new bindings being supplied here will replace the bindings set in the level sequence asset, meaning the original object animated by\nSequencer will no longer be animated. Bindings set to spawnables will not spawn if false. If true, new bindings will be in addition to ones set\nset in Sequencer UI. This function will not modify the original asset."
    },
    {
      "id": "add-binding-by-tag",
      "name": "AddBindingByTag",
      "category": "Sequencer",
      "signature": "AddBindingByTag(Target, Binding Tag, Actor, Allow Bindings From Asset)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelSequenceActor*"
        },
        {
          "name": "Binding Tag",
          "type": "Name"
        },
        {
          "name": "Actor",
          "type": "AActor*"
        },
        {
          "name": "Allow Bindings From Asset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Binds an actor to all the bindings tagged with the specified name in this sequence. Does not remove any exising bindings that have been set up through this API. Object Bindings can be tagged within the sequence UI by RMB -> Tags... on the object binding in the tree.\n@param BindingTag   The unique tag name to lookup bindings with\n@param Actor        The actor to assign to all the tagged bindings\n@param bAllowBindingsFromAsset If false the new bindings being supplied here will replace the bindings set in the level sequence asset, meaning the original object animated by\nSequencer will no longer be animated. Bindings set to spawnables will not spawn if false. If true, new bindings will be in addition to ones set\nset in Sequencer UI. This function will not modify the original asset."
    },
