      "id": "check-event-implementation-version",
      "name": "CheckEventImplementationVersion",
      "category": "BTFunctionLibrary",
      "signature": "CheckEventImplementationVersion(Target, Generic Event Name, AI Event Name, Object, Stop At Class)",
      "params": [
        {
          "name": "Target",
          "type": "UBTFunctionLibrary*"
        },
        {
          "name": "Generic Event Name",
          "type": "Name"
        },
        {
          "name": "AI Event Name",
          "type": "Name"
        },
        {
          "name": "Object",
          "type": "UObject&"
        },
        {
          "name": "Stop At Class",
          "type": "UClass&"
        }
      ],
      "returnType": "Int",
      "docs": "checks if given object implements GenericEventName and/or AIEventName BP events, and returns an result as flags set on return integer\n@return flags set in returned integer indicate kinds of events implemented by given object"
    },
