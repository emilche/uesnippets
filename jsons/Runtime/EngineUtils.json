    {
      "id": "f-strip-data-flags-a49fea",
      "name": "FStripDataFlags",
      "category": "EngineUtils",
      "signature": "FStripDataFlags(Ar, In Global Flags, In Class Flags, In Version)",
      "params": [
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "In Global Flags",
          "type": "Byte"
        },
        {
          "name": "In Class Flags",
          "type": "Byte"
        },
        {
          "name": "In Version",
          "type": "FPackageFileVersion&",
          "default": "GOldestLoadablePackageFileUEVersion"
        }
      ],
      "returnType": "Void",
      "docs": "Constructor.\nSerializes strip data flags. Global (engine) flags are user defined and will not be automatically generated\nwhen saving. Class flags also need to be defined by the user.\n@param Ar - Archive to serialize with.\n@param InGlobalFlags Engine flags\n@param InClassFlags - User defined per class flags.\n@param InVersion - Minimal version required to serialize strip flags"
    },
    {
      "id": "f-strip-data-flags-aa8276",
      "name": "FStripDataFlags",
      "category": "EngineUtils",
      "signature": "FStripDataFlags(Slot, In Class Flags, In Version)",
      "params": [
        {
          "name": "Slot",
          "type": "FStructuredArchive::FSlot"
        },
        {
          "name": "In Class Flags",
          "type": "Byte",
          "default": "0"
        },
        {
          "name": "In Version",
          "type": "FPackageFileVersion&",
          "default": "GOldestLoadablePackageFileUEVersion"
        }
      ],
      "returnType": "Void",
      "docs": "Constructor.\nSerializes strip data flags. Global (engine) flags are automatically generated from target platform\nwhen saving. Class flags need to be defined by the user.\n@param Slot - Slot holding the archive to serialize with.\n@param InClassFlags - User defined per class flags .\n@param InVersion - Minimal strip version required to serialize strip flags"
    },
    {
      "id": "f-strip-data-flags-9ccf6a",
      "name": "FStripDataFlags",
      "category": "EngineUtils",
