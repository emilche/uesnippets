{
  "id": "engine-utils",
  "label": "EngineUtils",
  "includepath": "EngineUtils.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SubclassOf",
    "EngineTypes",
    "Actor",
    "HitProxies",
    "Level",
    "World",
    "UObjectHash",
    "ProfilingHelpers",
    "WorldSettings",
    "Accumulate",
    "Copy"
  ],
  "functions": [
    {
      "id": "get-mouse-cursor",
      "name": "GetMouseCursor",
      "category": "EngineUtils",
      "signature": "GetMouseCursor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "HActor*"
        }
      ],
      "returnType": "EMouseCursor::Type",
      "supportedTargets": [
        "HActor*",
        "HTranslucentActor*"
      ]
    },
    {
      "id": "get-element-handle",
      "name": "GetElementHandle",
      "category": "EngineUtils",
      "signature": "GetElementHandle(Target)",
      "params": [
        {
          "name": "Target",
          "type": "HActor*"
        }
      ],
      "returnType": "FTypedElementHandle"
    },
    {
      "id": "always-allows-translucent-primitives",
      "name": "AlwaysAllowsTranslucentPrimitives",
      "category": "EngineUtils",
      "signature": "AlwaysAllowsTranslucentPrimitives(Target)",
      "params": [
        {
          "name": "Target",
          "type": "HActor*"
        }
      ],
      "returnType": "Bool",
      "supportedTargets": [
        "HActor*",
        "HTranslucentActor*"
      ]
    },
    {
      "id": "get-actor-checked",
      "name": "GetActorChecked",
      "category": "EngineUtils",
      "signature": "GetActorChecked(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FActorIteratorState*"
        }
      ],
      "returnType": "AActor*",
      "docs": "Returns the current suitable actor pointed at by the Iterator\n@return\tCurrent suitable actor"
    },
    {
      "id": "bool",
      "name": "bool",
      "category": "EngineUtils",
      "signature": "bool(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TActorIteratorBase*"
        }
      ],
      "returnType": "operator",
      "docs": "Returns whether the iterator has reached the end and no longer points\nto a suitable actor.\n@return true if iterator points to a suitable actor, false if it has reached the end"
    },
    {
      "id": "clear-current",
      "name": "ClearCurrent",
      "category": "EngineUtils",
      "signature": "ClearCurrent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TActorIteratorBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears the current Actor in the array (setting it to NULL)."
    },
    {
      "id": "get-progress-numerator",
      "name": "GetProgressNumerator",
      "category": "EngineUtils",
      "signature": "GetProgressNumerator(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TActorIteratorBase*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the number of actors considered thus far. Can be used in combination\nwith GetProgressDenominator to gauge progress iterating over all actors.\n@return number of actors considered thus far."
    },
    {
      "id": "draw-stats-hud",
      "name": "DrawStatsHUD",
      "category": "EngineUtils",
      "signature": "DrawStatsHUD(In World, Viewport, Canvas, Canvas Object, Debug Properties, View Location, View Rotation)",
      "params": [
        {
          "name": "In World",
          "type": "UWorld*"
        },
        {
          "name": "Viewport",
          "type": "FViewport*"
        },
        {
          "name": "Canvas",
          "type": "FCanvas*"
        },
        {
          "name": "Canvas Object",
          "type": "UCanvas*"
        },
        {
          "name": "Debug Properties",
          "type": "TArray<FDebugDisplayProperty>&"
        },
        {
          "name": "View Location",
          "type": "FVector&"
        },
        {
          "name": "View Rotation",
          "type": "FRotator&"
        }
      ],
      "returnType": "Void",
      "docs": "The console which output is written to."
    },
    {
      "id": "get-sub-levels-status",
      "name": "GetSubLevelsStatus",
      "category": "EngineUtils",
      "signature": "GetSubLevelsStatus(In World, Sort By Actor Count)",
      "params": [
        {
          "name": "In World",
          "type": "UWorld*"
        },
        {
          "name": "Sort By Actor Count",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "TArray<FSubLevelStatus>",
      "docs": "SubLevel status information"
    },
    {
      "id": "find-or-load-assets-by-path",
      "name": "FindOrLoadAssetsByPath",
      "category": "EngineUtils",
      "signature": "FindOrLoadAssetsByPath(Path, Out Assets, Type)",
      "params": [
        {
          "name": "Path",
          "type": "String&"
        },
        {
          "name": "Out Assets",
          "type": "TArray<UObject*>&"
        },
        {
          "name": "Type",
          "type": "EAssetToLoad"
        }
      ],
      "returnType": "Bool",
      "docs": "Loads all the assets found in the specified path and subpaths"
    },
    {
      "id": "is-editor-data-stripped",
      "name": "IsEditorDataStripped",
      "category": "EngineUtils",
      "signature": "IsEditorDataStripped(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStripDataFlags*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if FStripDataFlags::Editor flag is set or not\n@return true if FStripDataFlags::Editor is set, false otherwise."
    },
    {
      "id": "is-audio-visual-data-stripped",
      "name": "IsAudioVisualDataStripped",
      "category": "EngineUtils",
      "signature": "IsAudioVisualDataStripped(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStripDataFlags*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if FStripDataFlags::AudioVisual flag is set or not\n@return true if FStripDataFlags::AudioVisual is set, false otherwise."
    },
    {
      "id": "is-data-needed-for-cooking-stripped",
      "name": "IsDataNeededForCookingStripped",
      "category": "EngineUtils",
      "signature": "IsDataNeededForCookingStripped(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStripDataFlags*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if FStripDataFlags::NeededForCooking flag is set or not. It should be set for all non-content-worker targets\n@return true if FStripDataFlags::NeededForCooking is set, false otherwise."
    },
    {
      "id": "is-class-data-stripped",
      "name": "IsClassDataStripped",
      "category": "EngineUtils",
      "signature": "IsClassDataStripped(Target, In Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FStripDataFlags*"
        },
        {
          "name": "In Flags",
          "type": "Byte"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks if user defined flags are set or not.\n@InFlags - User defined flags to check.\n@return true if the specified user defined flags are set, false otherwise."
    },
    {
      "id": "check-and-report-invalid-usage",
      "name": "CheckAndReportInvalidUsage",
      "category": "EngineUtils",
      "signature": "CheckAndReportInvalidUsage(Owner, Property Name, Texture)",
      "params": [
        {
          "name": "Owner",
          "type": "UObject*"
        },
        {
          "name": "Property Name",
          "type": "Name&"
        },
        {
          "name": "Texture",
          "type": "UTexture*"
        }
      ],
      "returnType": "Void",
      "docs": "Function that will test if the passed in texture is VT. If so, print to Messagelog that the property does not support VT textures"
    }
  ]
}