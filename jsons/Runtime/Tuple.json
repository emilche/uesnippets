    {
      "id": "forward-as-tuple",
      "name": "ForwardAsTuple",
      "category": "Tuple",
      "signature": "ForwardAsTuple(Target, Args)",
      "params": [
        {
          "name": "Target",
          "type": "TTuple*"
        },
        {
          "name": "Args",
          "type": "Types&& . . ."
        }
      ],
      "returnType": "template<. . . Types> TTuple<Types&& . . .>",
      "docs": "Makes a TTuple from some arguments.  Unlike MakeTuple, the TTuple element types are references and retain the\nsame value category of the arguments, like the Forward function.\n@param  Args  The arguments used to construct the tuple.\n@return A tuple containing forwarded references to the arguments.\nExample:\ntemplate <typename... Ts>\nvoid Foo(const TTuple<Ts...>&);\nvoid Func(const int32 A, FString&& B)\n{\n// Calls Foo<const int32&, const TCHAR(&)[6], FString&&>(...);\nFoo(ForwardAsTuple(A, TEXT(\"Hello\"), MoveTemp(B)));\n}"
    },
    {
      "id": "decltype-363cf8",
      "name": "decltype",
      "category": "Tuple",
      "signature": "decltype(Target, Func)",
      "params": [
        {
          "name": "Target",
          "type": "TTuple*"
        },
        {
          "name": "Func",
          "type": "auto ) TransformTuple ( TTuple<Types . . .>&& Tuple,FuncType"
        }
      ],
      "returnType": "template<FuncType,. . . Types>",
      "docs": "Creates a new TTuple by applying a functor to each of the elements.\n@param  Tuple  The tuple to apply the functor to.\n@param  Func   The functor to apply.\n@return A new tuple of the transformed elements.\nExample:\nfloat        Overloaded(int32 Arg);\nchar         Overloaded(const TCHAR* Arg);\nconst TCHAR* Overloaded(const FString& Arg);\nvoid Func(const TTuple<int32, const TCHAR*, FString>& MyTuple)\n{\n// Equivalent to:\n// TTuple<float, char, const TCHAR*> TransformedTuple(Overloaded(MyTuple.Get<0>()), Overloaded(MyTuple.Get<1>()), Overloaded(MyTuple.Get<2>())));\nauto TransformedTuple = TransformTuple(MyTuple, [](const auto& Arg) { return Overloaded(Arg); });\n}"
    },
    {
      "id": "visit-tuple-elements",
      "name": "VisitTupleElements",
      "category": "Tuple",
      "signature": "VisitTupleElements(Target, Func, First Tuple, Tuples)",
      "params": [
        {
          "name": "Target",
          "type": "TTuple*"
        },
        {
          "name": "Func",
          "type": "FuncType&&"
        },
        {
          "name": "First Tuple",
          "type": "FirstTupleType&&"
        },
        {
          "name": "Tuples",
          "type": "TupleTypes&& . . ."
        }
      ],
      "returnType": "template<FuncType,FirstTupleType,. . . TupleTypes> void",
      "docs": "Visits each element in the specified tuples in parallel and applies them as arguments to the functor.\nAll specified tuples must have the same number of elements.\n@param  Func    The functor to apply.\n@param  Tuples  The tuples whose elements are to be applied to the functor.\nExample:\nvoid Func(const TTuple<int32, const TCHAR*, FString>& Tuple1, const TTuple<bool, float, FName>& Tuple2)\n{\n// Equivalent to:\n// Functor(Tuple1.Get<0>(), Tuple2.Get<0>());\n// Functor(Tuple1.Get<1>(), Tuple2.Get<1>());\n// Functor(Tuple1.Get<2>(), Tuple2.Get<2>());\nVisitTupleElements(Functor, Tuple1, Tuple2);\n}"
    },
