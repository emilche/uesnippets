      "signature": "AddSubObjectUnique(Target, In Sub Object, In Net Condition)",
      "params": [
        {
          "name": "Target",
          "type": "FSubObjectRegistry*"
        },
        {
          "name": "In Sub Object",
          "type": "UObject*"
        },
        {
          "name": "In Net Condition",
          "type": "ELifetimeCondition"
        }
      ],
      "returnType": "FSubObjectRegistry::EResult",
      "docs": "Stores the SubObjects to replicate and the network condition dictating to which connection they can replicate to."
    },
    {
      "id": "remove-sub-object",
      "name": "RemoveSubObject",
      "category": "NetSubObjectRegistry",
      "signature": "RemoveSubObject(Target, In Sub Object)",
      "params": [
        {
          "name": "Target",
          "type": "FSubObjectRegistry*"
        },
        {
          "name": "In Sub Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Remove the subobject from the replicated list. Returns true if the subobject had been registered."
    },
    {
      "id": "clean-registry-indexes",
      "name": "CleanRegistryIndexes",
      "category": "NetSubObjectRegistry",
      "signature": "CleanRegistryIndexes(Target, Indexes To Clean)",
      "params": [
        {
          "name": "Target",
          "type": "FSubObjectRegistry*"
        },
        {
          "name": "Indexes To Clean",
          "type": "TArrayView<int32>&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove all the indexes specified by the passed array\n@param IndexesToClean Array of indexes sorted from smallest to biggest. The sorted order is assumed to have been done by the caller"
    },
    {
      "id": "get-net-condition",
      "name": "GetNetCondition",
      "category": "NetSubObjectRegistry",
      "signature": "GetNetCondition(Target, Sub Object)",
      "params": [
        {
          "name": "Target",
          "type": "FSubObjectRegistry*"
        },
        {
          "name": "Sub Object",
          "type": "UObject*"
        }
      ],
      "returnType": "ELifetimeCondition",
      "docs": "Find the NetCondition of a SubObject. Returns COND_MAX if not registered"
    },
    {
      "id": "is-sub-object-in-registry",
      "name": "IsSubObjectInRegistry",
      "category": "NetSubObjectRegistry",
      "signature": "IsSubObjectInRegistry(Target, Sub Object)",
      "params": [
        {
          "name": "Target",
          "type": "FSubObjectRegistry*"
        },
        {
          "name": "Sub Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the subobject is contained in this list"
