  "functions": [
    {
      "id": "add-component-custom",
      "name": "AddComponentCustom",
      "category": "TransformProxy",
      "signature": "AddComponentCustom(Target, Component, Get Transform Func, Set Transform Func, User Defined Index, Modify Component On Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        },
        {
          "name": "Component",
          "type": "USceneComponent*"
        },
        {
          "name": "Get Transform Func",
          "type": "TUniqueFunction<FTransform ( void )>"
        },
        {
          "name": "Set Transform Func",
          "type": "TUniqueFunction<void ( FTransform& )>"
        },
        {
          "name": "User Defined Index",
          "type": "Int64",
          "default": "0"
        },
        {
          "name": "Modify Component On Transform",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Add a component sub-object to the proxy set with custom transform access functions. This can be used\nto do things like add an ISM Instance to the TransformProxy.\n@param GetTransformFunc return current transform\n@param SetTransformFunc set current transform\n@param UserDefinedIndex an arbitrary integer that can be provided, not currently used but may be useful in subclasses\n@param bModifyComponentOnTransform if true, Component->Modify() is called before the Component transform is updated\n@warning The internal shared transform is regenerated each time a component is added"
    },
    {
      "id": "get-transform",
      "name": "GetTransform",
      "category": "TransformProxy",
      "signature": "GetTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        }
      ],
      "returnType": "FTransform",
      "docs": "@return the shared transform for all the sub-objects"
    },
    {
      "id": "set-transform",
      "name": "SetTransform",
      "category": "TransformProxy",
      "signature": "SetTransform(Target, Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        },
        {
          "name": "Transform",
          "type": "FTransform&"
        }
      ],
      "returnType": "Void",
      "docs": "Update the main transform and then update the sub-objects based on their relative transformations"
    },
    {
      "id": "begin-transform-edit-sequence",
      "name": "BeginTransformEditSequence",
      "category": "TransformProxy",
      "signature": "BeginTransformEditSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "In some use cases SetTransform() will be called repeatedly (eg during an interactive gizmo edit). External\ncode may know and/or need to know when such a sequence starts/ends. The OnBeginTransformEdit/OnEndTransformEdit delegates\ncan provide these notifications, however client code must call BeginTransformEditSequence()/EndTransformEditSequence() to fire those delegates\nas the TransformProxy doesn't know about this external state.\n@note FTransformProxyChangeSource will call these functions on Begin/End"
    },
    {
      "id": "end-transform-edit-sequence",
      "name": "EndTransformEditSequence",
      "category": "TransformProxy",
      "signature": "EndTransformEditSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "External clients should call this when done a sequence of SetTransform calls (see BeginTransformEditSequence)"
    },
    {
      "id": "begin-pivot-edit-sequence",
      "name": "BeginPivotEditSequence",
      "category": "TransformProxy",
      "signature": "BeginPivotEditSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Clients should call this before a sequence of SetTransform calls that have bSetPivotMode as true\n(see comment in BeginTransformEditSequence)."
    },
    {
      "id": "end-pivot-edit-sequence",
      "name": "EndPivotEditSequence",
      "category": "TransformProxy",
      "signature": "EndPivotEditSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTransformProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Clients should call this when done with a sequence of SetTransform that have bSetPivotMode as true\n(see comment in BeginTransformEditSequence)."
    },
