{
  "id": "i-localized-text-source",
  "label": "ILocalizedTextSource",
  "includepath": "Internationalization/ILocalizedTextSource.h",
  "includes": [
    "CoreTypes",
    "ContainersFwd",
    "ArrayView",
    "TextKey",
    "LocalizedTextSourceTypes",
    "CoreGlobals"
  ],
  "functions": [
    {
      "id": "get-priority",
      "name": "GetPriority",
      "category": "ILocalizedTextSource",
      "signature": "GetPriority(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ILocalizedTextSource*"
        }
      ],
      "returnType": "Int",
      "docs": "Get the priority of this source when building the complete list of translations to apply (higher numbers have a higher priority)."
    },
    {
      "id": "query-localized-resource",
      "name": "QueryLocalizedResource",
      "category": "ILocalizedTextSource",
      "signature": "QueryLocalizedResource(Target, In Load Flags, In Prioritized Cultures, In Text Id, In Out Native Resource, In Out Localized Resource)",
      "params": [
        {
          "name": "Target",
          "type": "ILocalizedTextSource*"
        },
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        },
        {
          "name": "In Prioritized Cultures",
          "type": "TArrayView<FString>"
        },
        {
          "name": "In Text Id",
          "type": "FTextId"
        },
        {
          "name": "In Out Native Resource",
          "type": "FTextLocalizationResource&"
        },
        {
          "name": "In Out Localized Resource",
          "type": "FTextLocalizationResource&"
        }
      ],
      "returnType": "EQueryLocalizedResourceResult",
      "docs": "Query a localized resource from this localized text source for the given cultures and ID into the given maps (ELocalizationLoadFlags controls which resources should be queried)."
    },
    {
      "id": "should-load-native",
      "name": "ShouldLoadNative",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadNative(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load native data based on the given load flags and environment?"
    },
    {
      "id": "should-load-editor",
      "name": "ShouldLoadEditor",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadEditor(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load editor data based on the given load flags and environment?"
    },
    {
      "id": "should-load-game",
      "name": "ShouldLoadGame",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadGame(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load game data based on the given load flags and environment?"
    },
    {
      "id": "should-load-engine",
      "name": "ShouldLoadEngine",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadEngine(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load engine data based on the given load flags and environment?"
    },
    {
      "id": "should-load-additional",
      "name": "ShouldLoadAdditional",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadAdditional(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load additional (eg, plugin) data based on the given load flags and environment?"
    },
    {
      "id": "should-load-native-game-data",
      "name": "ShouldLoadNativeGameData",
      "category": "ILocalizedTextSource",
      "signature": "ShouldLoadNativeGameData(In Load Flags)",
      "params": [
        {
          "name": "In Load Flags",
          "type": "ELocalizationLoadFlags"
        }
      ],
      "returnType": "Bool",
      "docs": "Should we load native game data based on the given load flags and environment?"
    }
  ]
}