    {
      "id": "fast-array-delta-serialize-delta-serialize-structs",
      "name": "FastArrayDeltaSerialize_DeltaSerializeStructs",
      "category": "FastArraySerializer",
      "signature": "FastArrayDeltaSerialize_DeltaSerializeStructs<Type, SerializerType>(Target, Items, Parms, Array Serializer)",
      "params": [
        {
          "name": "Target",
          "type": "FFastArraySerializer*"
        },
        {
          "name": "Items",
          "type": "TArray<Type>&"
        },
        {
          "name": "Parms",
          "type": "FNetDeltaSerializeInfo&"
        },
        {
          "name": "Array Serializer",
          "type": "SerializerType&"
        }
      ],
      "returnType": "template<Type,SerializerType> bool",
      "docs": "Performs \"struct delta\" serialization on the items in the FastArraySerializer.\nThis method relies more directly on FRepLayout for management, and will only send properties\nthat have changed since the last update.\nThis is potentially more CPU intensive since we'll be doing comparisons, but should require less bandwidth.\nFor this method to work, the following **must** be true:\n- Your array of FFastArraySerializerItems must be a top level UPROPERTY within your FFastArraySerializer.\n- Your array of FFastArraySerializerItems must **not** be marked RepSkip.\n- Your array of FFastArraySerializerItems must be the **only** replicated array of FFastArraySerializerItems within the FastArraySerializer.\nNote, it's OK to have multiple arrays of items, as long as only one is replicated (all others **must** be marked RepSkip).\n- Your FFastArraySerializer must not be nested in a static array.\n- Your array of FFastArraySerializerItem must not be nested in a static array.\n@param Items\t\t\t\tArray of items owned by ArraySerializer.\n@param Parms\t\t\t\tSet of parms that dictate what serialization will do / return.\n@param ArraySerializer\tThe typed subclass of FFastArraySerializer that we're serializing."
    }
  ]
