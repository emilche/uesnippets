{
  "id": "string-curve",
  "label": "StringCurve",
  "includepath": "Curves/StringCurve.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Class",
    "KeyHandle",
    "IndexedCurve",
    "StringCurve.generated"
  ],
  "functions": [
    {
      "id": "serialize",
      "name": "Serialize",
      "category": "StringCurve",
      "signature": "Serialize(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurveKey*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "add-key",
      "name": "AddKey",
      "category": "StringCurve",
      "signature": "AddKey(Target, In Time, In Value, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "In Value",
          "type": "String&"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle",
          "default": "FKeyHandle()"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Add a new key to the curve with the supplied Time and Value. Returns the handle of the new key.\n@param InTime The time at which to add the key.\n@param InValue The value of the key.\n@param KeyHandle Optional handle for the new key."
    },
    {
      "id": "delete-key",
      "name": "DeleteKey",
      "category": "StringCurve",
      "signature": "DeleteKey(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Remove the specified key from the curve.\n@param KeyHandle Handle to the key to remove."
    },
    {
      "id": "eval",
      "name": "Eval",
      "category": "StringCurve",
      "signature": "Eval(Target, Time, In Default Value)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Time",
          "type": "Float"
        },
        {
          "name": "In Default Value",
          "type": "String&"
        }
      ],
      "returnType": "String",
      "docs": "Evaluate the curve at the specified time.\n@param Time The time to evaluate.\n@param InDefaultValue The default value if no key exists.\n@return The evaluated string."
    },
    {
      "id": "find-key",
      "name": "FindKey",
      "category": "StringCurve",
      "signature": "FindKey(Target, Key Time, Key Time Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Time",
          "type": "Float"
        },
        {
          "name": "Key Time Tolerance",
          "type": "Float",
          "default": "UE_KINDA_SMALL_NUMBER"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Finds a key a the specified time.\n@param KeyTime The time at which to find the key.\n@param KeyTimeTolerance The key time tolerance to use for equality.\n@return A handle to the key, or invalid key handle if not found."
    },
    {
      "id": "get-key",
      "name": "GetKey",
      "category": "StringCurve",
      "signature": "GetKey(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "FStringCurveKey&",
      "docs": "Get a key.\n@param KeyHandle The handle of the key to get.\n@return The key."
    },
    {
      "id": "get-key-time",
      "name": "GetKeyTime",
      "category": "StringCurve",
      "signature": "GetKeyTime(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "Float",
      "docs": "Get the time for the Key with the specified index.\n@param KeyHandle Handle to the key whose time to get.\n@return The key's time."
    },
    {
      "id": "get-key-value",
      "name": "GetKeyValue",
      "category": "StringCurve",
      "signature": "GetKeyValue(Target, Key Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        }
      ],
      "returnType": "String",
      "docs": "Get the value for the Key with the specified index.\n@param KeyHandle Handle to the key whose value to get.\n@return The key's value."
    },
    {
      "id": "set-key-time",
      "name": "SetKeyTime",
      "category": "StringCurve",
      "signature": "SetKeyTime(Target, Key Handle, New Time)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        },
        {
          "name": "New Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Move a key to a new time.\n@param KeyHandle The handle of the key to change.\n@param NewTime The new time to set on the key."
    },
    {
      "id": "set-key-value",
      "name": "SetKeyValue",
      "category": "StringCurve",
      "signature": "SetKeyValue(Target, Key Handle, New Value)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "Key Handle",
          "type": "FKeyHandle"
        },
        {
          "name": "New Value",
          "type": "String"
        }
      ],
      "returnType": "Void",
      "docs": "Assign a new value to a key.\n@param KeyHandle The handle of the key to change.\n@param NewTime The new value to set on the key."
    },
    {
      "id": "update-or-add-key",
      "name": "UpdateOrAddKey",
      "category": "StringCurve",
      "signature": "UpdateOrAddKey(Target, In Time, In Value, Key Time Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "In Value",
          "type": "String&"
        },
        {
          "name": "Key Time Tolerance",
          "type": "Float",
          "default": "UE_KINDA_SMALL_NUMBER"
        }
      ],
      "returnType": "FKeyHandle",
      "docs": "Finds the key at InTime, and updates its value. If it can't find the key within the KeyTimeTolerance, it adds one at that time.\n@param InTime The time at which the key should be added or updated.\n@param InValue The value of the key.\n@param KeyTimeTolerance The tolerance used for key time equality."
    },
    {
      "id": "remove-redundant-keys",
      "name": "RemoveRedundantKeys",
      "category": "StringCurve",
      "signature": "RemoveRedundantKeys(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStringCurve*"
        }
      ],
      "returnType": "Void",
      "docs": "Tries to reduce the number of keys required for accurate evaluation (removing duplicates)"
    }
  ]
}