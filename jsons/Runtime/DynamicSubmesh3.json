    {
      "id": "compute-9b9b67",
      "name": "Compute",
      "category": "DynamicSubmesh3",
      "signature": "Compute(Target, Sub Triangles, Want Components, Attributes)",
      "params": [
        {
          "name": "Target",
          "type": "FDynamicSubmesh3*"
        },
        {
          "name": "Sub Triangles",
          "type": "TArrayView<int>&"
        },
        {
          "name": "Want Components",
          "type": "Int",
          "default": "(int)EMeshComponents::All"
        },
        {
          "name": "Attributes",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Computes the Submesh object, index mappings corresponding sub to base mesh, and boundary between sub and base mesh\n@param SubTriangles ArrayView of triangle IDs to include in the submesh\n@param WantComponents Bit flag of desired mesh components; will only enable if flag is set AND the components are enabled in the BaseMesh\n@param bAttributes Flag indicating if attributes are needed for submesh; will only enable attributes if flag is set AND attributes are enabled in the BaseMesh"
    },
