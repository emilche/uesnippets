  "functions": [
    {
      "id": "update-prerequisite",
      "name": "UpdatePrerequisite",
      "category": "SlateAttributeDescriptor",
      "signature": "UpdatePrerequisite(Target, Prerequisite)",
      "params": [
        {
          "name": "Target",
          "type": "FAttributeEntry*"
        },
        {
          "name": "Prerequisite",
          "type": "Name"
        }
      ],
      "returnType": "FAttributeEntry&",
      "docs": "Update the attribute after the prerequisite.\nThe order is guaranteed but other attributes may be updated in between.\nNo order is guaranteed if the prerequisite or this property is updated manually."
    },
    {
      "id": "on-value-changed",
      "name": "OnValueChanged",
      "category": "SlateAttributeDescriptor",
      "signature": "OnValueChanged(Target, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FAttributeEntry*"
        },
        {
          "name": "Callback",
          "type": "FAttributeValueChangedDelegate"
        }
      ],
      "returnType": "FAttributeEntry&",
      "docs": "Notified when the attribute value changed.\nIt's preferable that you delay any action to the Tick or Paint function.\nYou are not allowed to make changes that would affect the SWidget ChildOrder or its Visibility.\nIt will not be called when the SWidget is in its construction phase.\n@see SWidget::IsConstructed"
    },
    {
      "id": "add-contained-attribute",
      "name": "AddContainedAttribute",
      "category": "SlateAttributeDescriptor",
      "signature": "AddContainedAttribute(Target, Attribute Name, Offset, Reason Getter)",
      "params": [
        {
          "name": "Target",
          "type": "FContainerInitializer*"
        },
        {
          "name": "Attribute Name",
          "type": "Name"
        },
        {
          "name": "Offset",
          "type": "OffsetType"
        },
        {
          "name": "Reason Getter",
          "type": "FInvalidateWidgetReasonAttribute&"
        }
      ],
      "returnType": "FAttributeEntry"
    },
    {
      "id": "override-invalidation-reason",
      "name": "OverrideInvalidationReason",
      "category": "SlateAttributeDescriptor",
      "signature": "OverrideInvalidationReason(Target, Attribute Name, Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FContainerInitializer*"
        },
        {
          "name": "Attribute Name",
          "type": "Name"
        },
        {
          "name": "Reason",
          "type": "FInvalidateWidgetReasonAttribute&"
        }
      ],
      "returnType": "Void",
      "docs": "Change the InvalidationReason of an attribute defined in a base class."
    },
    {
      "id": "override-on-value-changed",
      "name": "OverrideOnValueChanged",
      "category": "SlateAttributeDescriptor",
      "signature": "OverrideOnValueChanged(Target, Attribute Name, Override Type, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FContainerInitializer*"
        },
        {
          "name": "Attribute Name",
          "type": "Name"
        },
        {
          "name": "Override Type",
          "type": "ECallbackOverrideType"
        },
        {
          "name": "Callback",
          "type": "FAttributeValueChangedDelegate"
        }
      ],
      "returnType": "Void",
      "docs": "Change the FAttributeValueChangedDelegate of an attribute defined in a base class."
    },
    {
      "id": "affect-visibility",
      "name": "AffectVisibility",
      "category": "SlateAttributeDescriptor",
      "signature": "AffectVisibility(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAttributeEntry*"
        }
      ],
      "returnType": "FAttributeEntry&",
      "docs": "The attribute affect the visibility of the widget.\nWe only update the attributes that can change the visibility of the widget when the widget is collapsed.\nAttributes that affect visibility must have the Visibility attribute as a Prerequisite or the Visibility attribute must have it as a Prerequisite."
    },
    {
      "id": "add-member-attribute",
      "name": "AddMemberAttribute",
      "category": "SlateAttributeDescriptor",
