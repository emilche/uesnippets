{
  "id": "slate-attribute-descriptor",
  "label": "SlateAttributeDescriptor",
  "includepath": "Types/SlateAttributeDescriptor.h",
  "includes": [
    "Array",
    "ContainerAllocationPolicies",
    "CoreMinimal",
    "Delegate",
    "Platform",
    "AssertionMacros",
