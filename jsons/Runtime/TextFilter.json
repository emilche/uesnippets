{
  "id": "text-filter",
  "label": "TextFilter",
  "includepath": "Misc/TextFilter.h",
  "includes": [
    "CoreTypes",
    "PlatformAtomics",
    "AssertionMacros",
    "RemoveReference",
    "Array",
    "UnrealString",
    "SharedPointer",
    "Delegate",
    "Text",
    "TextFilterExpressionEvaluator",
    "IFilter"
  ],
  "functions": [
    {
      "id": "on-changed",
      "name": "OnChanged",
      "category": "TextFilter",
      "signature": "OnChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TTextFilter*"
        }
      ],
      "returnType": "FChangedEvent&"
    },
    {
      "id": "passes-filter",
      "name": "PassesFilter",
      "category": "TextFilter",
      "signature": "PassesFilter(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "TTextFilter*"
        },
        {
          "name": "In Item",
          "type": "ItemType"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether the specified Item passes the Filter's text restrictions\n@param\tInItem\tThe Item to check\n@return\t\t\tWhether the specified Item passed the filter"
    },
    {
      "id": "get-raw-filter-text",
      "name": "GetRawFilterText",
      "category": "TextFilter",
      "signature": "GetRawFilterText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TTextFilter*"
        }
      ],
      "returnType": "Text",
      "docs": "Returns the unsanitized and unsplit filter terms"
    },
    {
      "id": "set-raw-filter-text",
      "name": "SetRawFilterText",
      "category": "TextFilter",
      "signature": "SetRawFilterText(Target, In Filter Text)",
      "params": [
        {
          "name": "Target",
          "type": "TTextFilter*"
        },
        {
          "name": "In Filter Text",
          "type": "Text&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the Text to be used as the Filter's restrictions"
    },
    {
      "id": "get-filter-error-text",
      "name": "GetFilterErrorText",
      "category": "TextFilter",
      "signature": "GetFilterErrorText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TTextFilter*"
        }
      ],
      "returnType": "Text",
      "docs": "Get the last error returned from lexing or compiling the current filter text"
    },
    {
      "id": "set-item",
      "name": "SetItem",
      "category": "TextFilter",
      "signature": "SetItem(Target, In Item)",
      "params": [
        {
          "name": "Target",
          "type": "FTextFilterExpressionContext*"
        },
        {
          "name": "In Item",
          "type": "ItemTypePtr"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "clear-item",
      "name": "ClearItem",
      "category": "TextFilter",
      "signature": "ClearItem(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FTextFilterExpressionContext*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "test-basic-string-expression",
      "name": "TestBasicStringExpression",
      "category": "TextFilter",
      "signature": "TestBasicStringExpression(Target, In Value, In Text Comparison Mode)",
      "params": [
        {
          "name": "Target",
          "type": "FTextFilterExpressionContext*"
        },
        {
          "name": "In Value",
          "type": "FTextFilterString&"
        },
        {
          "name": "In Text Comparison Mode",
          "type": "ETextFilterTextComparisonMode"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "test-complex-expression",
      "name": "TestComplexExpression",
      "category": "TextFilter",
      "signature": "TestComplexExpression(Target, In Key, In Value, In Comparison Operation, In Text Comparison Mode)",
      "params": [
        {
          "name": "Target",
          "type": "FTextFilterExpressionContext*"
        },
        {
          "name": "In Key",
          "type": "Name&"
        },
        {
          "name": "In Value",
          "type": "FTextFilterString&"
        },
        {
          "name": "In Comparison Operation",
          "type": "ETextFilterComparisonOperation"
        },
        {
          "name": "In Text Comparison Mode",
          "type": "ETextFilterTextComparisonMode"
        }
      ],
      "returnType": "Bool"
    }
  ]
}