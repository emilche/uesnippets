      "name": "IsInFilterRegion",
      "category": "BoxFilter",
      "signature": "IsInFilterRegion(Target, Dist)",
      "params": [
        {
          "name": "Target",
          "type": "FBoxFilter*"
        },
        {
          "name": "Dist",
          "type": "FVector2d&"
        }
