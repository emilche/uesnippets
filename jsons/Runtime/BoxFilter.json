  "functions": [
    {
      "id": "get-weight",
      "name": "GetWeight",
      "category": "BoxFilter",
      "signature": "GetWeight(Target, Dist)",
      "params": [
        {
          "name": "Target",
          "type": "FBoxFilter*"
        },
        {
          "name": "Dist",
          "type": "FVector2d&"
        }
      ],
      "returnType": "Float",
      "docs": "@return The filter weight given a 2D distance vector\n@note   Works on general 2D point sets i.e., does not assume Cartesian/pixel grids"
    },
    {
