    "CoreMinimal",
    "AudioVolume",
    "ReverbSettings",
    "SoundMix",
    "Object",
    "ObjectMacros",
    "AudioEffect.generated"
  ],
  "functions": [
    {
      "id": "interpolate",
      "name": "Interpolate",
      "category": "AudioEffect",
      "signature": "Interpolate(Target, In Start, In End)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioReverbEffect*"
        },
        {
          "name": "In Start",
          "type": "FAudioEffectParameters&"
        },
        {
          "name": "In End",
          "type": "FAudioEffectParameters&"
        }
      ],
      "returnType": "Bool",
      "docs": "Interpolates between Start and End reverb effect settings, storing results locally and returning if interpolation is complete"
    },
    {
      "id": "print-settings",
      "name": "PrintSettings",
      "category": "AudioEffect",
      "signature": "PrintSettings(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioReverbEffect*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "volume-to-deci-bels",
      "name": "VolumeToDeciBels",
      "category": "AudioEffect",
      "signature": "VolumeToDeciBels(Target, Volume)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioEffectsManager*"
        },
        {
          "name": "Volume",
          "type": "Float"
        }
      ],
      "returnType": "Int64",
      "docs": "Converts and volume (0.0f to 1.0f) to a deciBel value"
    },
    {
      "id": "volume-to-milli-bels",
      "name": "VolumeToMilliBels",
      "category": "AudioEffect",
      "signature": "VolumeToMilliBels(Target, Volume, Max Milli Bels)",
      "params": [
        {
          "name": "Target",
          "type": "FAudioEffectsManager*"
        },
        {
          "name": "Volume",
          "type": "Float"
        },
        {
          "name": "Max Milli Bels",
          "type": "Int"
        }
      ],
      "returnType": "Int64",
      "docs": "Converts and volume (0.0f to 1.0f) to a MilliBel value (a Hundredth of a deciBel)"
    }
  ]
}