{
  "id": "web-image-cache",
  "label": "WebImageCache",
  "includepath": "WebImageCache.h",
  "includes": [
    "CoreMinimal",
    "UnrealString",
    "WebImage"
  ],
  "functions": [
    {
      "id": "pre-unload",
      "name": "PreUnload",
      "category": "WebImageCache",
      "signature": "PreUnload(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImageCache*"
        }
      ],
      "returnType": "Void",
      "docs": "Signifies the module is being unloaded and to perform any actions that depend on other modules which may be unloaded as well"
    },
    {
      "id": "empty",
      "name": "Empty",
      "category": "WebImageCache",
      "signature": "Empty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImageCache*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes all cached images"
    },
    {
      "id": "download",
      "name": "Download",
      "category": "WebImageCache",
      "signature": "Download(Target, Url, Default Image Url)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImageCache*"
        },
        {
          "name": "Url",
          "type": "String&"
        },
        {
          "name": "Default Image Url",
          "type": "TOptional<FString>&",
          "default": "TOptional<FString>()"
        }
      ],
      "returnType": "TSharedRef<FWebImage>",
      "docs": "Find or create a WebImage object for this URL (you probably just want to call ->Attr() on this)"
    },
    {
      "id": "set-default-stand-in-brush",
      "name": "SetDefaultStandInBrush",
      "category": "WebImageCache",
      "signature": "SetDefaultStandInBrush(Target, Stand In Brush In)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImageCache*"
        },
        {
          "name": "Stand In Brush In",
          "type": "TAttribute<FSlateBrush*>"
        }
      ],
      "returnType": "Void",
      "docs": "Set the brush that will be returned until the download completes (only affects future downloads)."
    },
    {
      "id": "relinquish-unused-images",
      "name": "RelinquishUnusedImages",
      "category": "WebImageCache",
      "signature": "RelinquishUnusedImages(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FWebImageCache*"
        }
      ],
      "returnType": "Void",
      "docs": "This function causes the web image cache to stop holding on to strong references to images. Normally\nonce downloaded, an image is cached forever. This allows us to release images that are not currently\nbeing displayed (those would have Strong pointers existing external to this class) to be released."
    }
  ]
}