      "category": "AnimBank",
      "signature": "ValidatePosition(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimBankSequence*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-component",
      "name": "CreateComponent",
      "category": "AnimBank",
      "signature": "CreateComponent(Target, Outer, Name, Object Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FSkinnedMeshComponentDescriptorBase*"
        },
        {
          "name": "Outer",
          "type": "UObject*"
        },
        {
          "name": "Name",
          "type": "Name",
          "default": "NAME_None"
        },
        {
          "name": "Object Flags",
          "type": "EObjectFlags",
          "default": "EObjectFlags::RF_NoFlags"
        }
      ],
      "returnType": "UInstancedSkinnedMeshComponent*"
    },
    {
      "id": "init-from",
      "name": "InitFrom",
      "category": "AnimBank",
      "signature": "InitFrom(Target, Component, Init Body Instance)",
      "params": [
        {
          "name": "Target",
          "type": "FSkinnedMeshComponentDescriptorBase*"
        },
        {
          "name": "Component",
          "type": "UInstancedSkinnedMeshComponent*"
        },
        {
          "name": "Init Body Instance",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "init-component",
      "name": "InitComponent",
      "category": "AnimBank",
      "signature": "InitComponent(Target, ISM Component)",
      "params": [
        {
          "name": "Target",
          "type": "FSkinnedMeshComponentDescriptorBase*"
        },
        {
          "name": "ISM Component",
          "type": "UInstancedSkinnedMeshComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "compute-hash",
      "name": "ComputeHash",
      "category": "AnimBank",
      "signature": "ComputeHash(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkinnedMeshComponentDescriptor*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "post-load-fixup",
      "name": "PostLoadFixup",
      "category": "AnimBank",
      "signature": "PostLoadFixup(Target, Loader)",
      "params": [
        {
          "name": "Target",
          "type": "FSkinnedMeshComponentDescriptor*"
        },
        {
          "name": "Loader",
          "type": "UObject*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-hash",
      "name": "GetHash",
      "category": "AnimBank",
      "signature": "GetHash(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnimBankDesc*"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "convert-local-to-global-space-transforms",
      "name": "ConvertLocalToGlobalSpaceTransforms",
      "category": "AnimBank",
      "signature": "ConvertLocalToGlobalSpaceTransforms(Target, In Ref Skeleton, In Local Space Transforms, Out Global Space Transforms)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimBank*"
        },
        {
          "name": "In Ref Skeleton",
          "type": "FReferenceSkeleton&"
        },
        {
          "name": "In Local Space Transforms",
          "type": "TArray<FTransform>&"
        },
        {
          "name": "Out Global Space Transforms",
          "type": "TArray<FTransform>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "build-skinned-asset-mapping",
      "name": "BuildSkinnedAssetMapping",
      "category": "AnimBank",
      "signature": "BuildSkinnedAssetMapping(Target, Asset, Mapping)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimBank*"
        },
        {
          "name": "Asset",
          "type": "USkinnedAsset&"
        },
        {
          "name": "Mapping",
          "type": "FSkinnedAssetMapping&"
        }
      ],
      "returnType": "Void"
    }
