{
  "id": "anim-bank",
  "label": "AnimBank",
  "includepath": "Animation/AnimBank.h",
  "includes": [
    "AnimationAsset",
    "RobinHoodHashTable",
    "HLODBatchingPolicy",
    "Interface_AsyncCompilation",
    "IoHash",
    "LogMacros",
