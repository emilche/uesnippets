{
  "id": "developer-settings",
  "label": "DeveloperSettings",
  "includepath": "Engine/DeveloperSettings.h",
  "includes": [
    "CoreMinimal",
    "Delegate",
    "Text",
    "SharedPointer",
    "NameTypes",
    "Object",
    "ObjectMacros",
    "UObjectGlobals",
    "DeveloperSettings.generated"
  ],
  "functions": [
    {
      "id": "u-developer-settings",
      "name": "UDeveloperSettings",
      "category": "DeveloperSettings",
      "signature": "UDeveloperSettings(Object Initializer)",
      "params": [
        {
          "name": "Object Initializer",
          "type": "FObjectInitializer&",
          "default": "FObjectInitializer::Get()"
        }
      ],
      "returnType": "public :"
    },
    {
      "id": "get-container-name",
      "name": "GetContainerName",
      "category": "DeveloperSettings",
      "signature": "GetContainerName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "Gets the settings container name for the settings, either Project or Editor"
    },
    {
      "id": "get-category-name",
      "name": "GetCategoryName",
      "category": "DeveloperSettings",
      "signature": "GetCategoryName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "Gets the category for the settings, some high level grouping like, Editor, Engine, Game...etc."
    },
    {
      "id": "get-section-name",
      "name": "GetSectionName",
      "category": "DeveloperSettings",
      "signature": "GetSectionName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "The unique name for your section of settings, uses the class's FName."
    },
    {
      "id": "get-section-text",
      "name": "GetSectionText",
      "category": "DeveloperSettings",
      "signature": "GetSectionText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the section text, uses the classes DisplayName by default."
    },
    {
      "id": "get-section-description",
      "name": "GetSectionDescription",
      "category": "DeveloperSettings",
      "signature": "GetSectionDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the description for the section, uses the classes ToolTip by default."
    },
    {
      "id": "on-setting-changed",
      "name": "OnSettingChanged",
      "category": "DeveloperSettings",
      "signature": "OnSettingChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "FOnSettingsChanged&"
    },
    {
      "id": "post-edit-change-property",
      "name": "PostEditChangeProperty",
      "category": "DeveloperSettings",
      "signature": "PostEditChangeProperty(Target, Property Changed Event)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        },
        {
          "name": "Property Changed Event",
          "type": "FPropertyChangedEvent&"
        }
      ],
      "returnType": "Void",
      "docs": "UObject interface"
    },
    {
      "id": "get-custom-settings-widget",
      "name": "GetCustomSettingsWidget",
      "category": "DeveloperSettings",
      "signature": "GetCustomSettingsWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "TSharedPtr<SWidget>",
      "docs": "Gets a custom widget for the settings.  This is only for very custom situations."
    },
    {
      "id": "import-console-variable-values",
      "name": "ImportConsoleVariableValues",
      "category": "DeveloperSettings",
      "signature": "ImportConsoleVariableValues(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Void",
      "docs": "The category name to use, overrides the one detected by looking at the config=... class metadata.\nArbitrary category names are not supported, this must map to an existing category we support in the settings\nviewer."
    },
    {
      "id": "export-values-to-console-variables",
      "name": "ExportValuesToConsoleVariables",
      "category": "DeveloperSettings",
      "signature": "ExportValuesToConsoleVariables(Target, Property That Changed)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        },
        {
          "name": "Property That Changed",
          "type": "FProperty*"
        }
      ],
      "returnType": "Void",
      "docs": "If property has 'ConsoleVariable' meta data, exports the property value to the specified console variable"
    }
  ]
}