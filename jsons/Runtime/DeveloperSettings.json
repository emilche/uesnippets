{
  "id": "developer-settings",
  "label": "DeveloperSettings",
  "includepath": "Engine/DeveloperSettings.h",
  "includes": [
    "CoreMinimal",
    "Delegate",
    "Text",
    "SharedPointer",
    "NameTypes",
    "Object",
    "ObjectMacros",
    "UObjectGlobals",
    "DeveloperSettings.generated"
  ],
  "functions": [
    {
      "id": "get-container-name",
      "name": "GetContainerName",
      "category": "DeveloperSettings",
      "signature": "GetContainerName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "Gets the settings container name for the settings, either Project or Editor"
    },
    {
      "id": "get-category-name",
      "name": "GetCategoryName",
      "category": "DeveloperSettings",
      "signature": "GetCategoryName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "Gets the category for the settings, some high level grouping like, Editor, Engine, Game...etc."
    },
    {
      "id": "get-section-name",
      "name": "GetSectionName",
      "category": "DeveloperSettings",
      "signature": "GetSectionName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Name",
      "docs": "The unique name for your section of settings, uses the class's FName."
    },
    {
      "id": "get-section-text",
      "name": "GetSectionText",
      "category": "DeveloperSettings",
      "signature": "GetSectionText(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the section text, uses the classes DisplayName by default."
    },
    {
      "id": "get-section-description",
      "name": "GetSectionDescription",
      "category": "DeveloperSettings",
      "signature": "GetSectionDescription(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Text",
      "docs": "Gets the description for the section, uses the classes ToolTip by default."
    },
    {
      "id": "supports-auto-registration",
      "name": "SupportsAutoRegistration",
      "category": "DeveloperSettings",
      "signature": "SupportsAutoRegistration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether or not this class supports auto registration or if the settings have a custom setup"
    },
    {
      "id": "on-setting-changed",
      "name": "OnSettingChanged",
      "category": "DeveloperSettings",
      "signature": "OnSettingChanged(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "FOnSettingsChanged&"
    },
    {
      "id": "get-custom-settings-widget",
      "name": "GetCustomSettingsWidget",
      "category": "DeveloperSettings",
      "signature": "GetCustomSettingsWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UDeveloperSettings*"
        }
      ],
      "returnType": "TSharedPtr<SWidget>",
      "docs": "Gets a custom widget for the settings.  This is only for very custom situations."
    }
  ]
}