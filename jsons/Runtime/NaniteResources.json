    {
      "id": "rebuild-bulk-data-from-cache-async",
      "name": "RebuildBulkDataFromCacheAsync",
      "category": "NaniteResources",
      "signature": "RebuildBulkDataFromCacheAsync(Target, Owner, Failed)",
      "params": [
        {
          "name": "Target",
          "type": "FResources*"
        },
        {
          "name": "Owner",
          "type": "UObject*"
        },
        {
          "name": "Failed",
          "type": "Bool&"
        }
      ],
      "returnType": "Bool",
      "docs": "Requests (or polls) an async operation that rebuilds the streaming bulk data from the cache.\nIf a rebuild is already in progress, the call will just poll the pending operation.\nIf true is returned, the operation is complete and it is safe to access the streaming data.\nIf false is returned, the operation has not yet completed.\nThe operation can fail, which is indicated by the value of bFailed."
    },
