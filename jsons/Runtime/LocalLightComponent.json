{
  "id": "local-light-component",
  "label": "LocalLightComponent",
  "includepath": "Components/LocalLightComponent.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "EngineTypes",
    "LightComponent",
    "LocalLightComponent.generated"
  ],
  "functions": [
    {
      "id": "set-attenuation-radius",
      "name": "SetAttenuationRadius",
      "category": "Rendering",
      "signature": "SetAttenuationRadius(Target, New Radius)",
      "params": [
        {
          "name": "Target",
          "type": "ULocalLightComponent*"
        },
        {
          "name": "New Radius",
          "type": "Float"
        }
      ],
      "returnType": "class FLightSceneProxy"
    },
    {
      "id": "set-intensity-units",
      "name": "SetIntensityUnits",
      "category": "Rendering",
      "signature": "SetIntensityUnits(Target, New Intensity Units)",
      "params": [
        {
          "name": "Target",
          "type": "ULocalLightComponent*"
        },
        {
          "name": "New Intensity Units",
          "type": "ELightUnits"
        }
      ],
      "returnType": "Void",
      "docs": "Set the units used for the intensity of the light"
    },
    {
      "id": "get-units-conversion-factor",
      "name": "GetUnitsConversionFactor",
      "category": "Rendering",
      "signature": "GetUnitsConversionFactor(Src Units, Target Units, Cos Half Cone Angle)",
      "params": [
        {
          "name": "Src Units",
          "type": "ELightUnits"
        },
        {
          "name": "Target Units",
          "type": "ELightUnits"
        },
        {
          "name": "Cos Half Cone Angle",
          "type": "Float",
          "default": "-1"
        }
      ],
      "returnType": "Float"
    }
  ]
}