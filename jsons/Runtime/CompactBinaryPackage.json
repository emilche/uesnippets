{
  "id": "compact-binary-package",
  "label": "CompactBinaryPackage",
  "includepath": "Serialization/CompactBinaryPackage.h",
  "includes": [
    "CompressedBuffer",
    "Array",
    "ContainersFwd",
    "CoreTypes",
    "IoHash",
    "CompositeBuffer",
    "SharedBuffer",
    "AssertionMacros",
    "TVariant",
    "CompactBinary",
    "Function",
    "UnrealTemplate"
  ],
  "functions": [
    {
      "id": "get-hash",
      "name": "GetHash",
      "category": "CompactBinaryPackage",
      "signature": "GetHash(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCbAttachment*"
        }
      ],
      "returnType": "FIoHash",
      "docs": "Returns the hash of the attachment value."
    },
    {
      "id": "try-load-b317b2",
      "name": "TryLoad",
      "category": "CompactBinaryPackage",
      "signature": "TryLoad(Target, Fields)",
      "params": [
        {
          "name": "Target",
          "type": "FCbAttachment*"
        },
        {
          "name": "Fields",
          "type": "FCbFieldIterator&"
        }
      ],
      "returnType": "Bool",
      "docs": "Load the attachment from compact binary as written by Save.\nThe attachment references the input iterator if it is owned, and otherwise clones the value.\nThe iterator is advanced as attachment fields are consumed from it."
    },
    {
      "id": "try-load-3f389b",
      "name": "TryLoad",
      "category": "CompactBinaryPackage",
      "signature": "TryLoad(Target, Ar, Allocator)",
      "params": [
        {
          "name": "Target",
          "type": "FCbAttachment*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Allocator",
          "type": "FCbBufferAllocator",
          "default": "FUniqueBuffer::Alloc"
        }
      ],
      "returnType": "Bool",
      "docs": "Load the attachment from compact binary as written by Save.\nThe attachments value will be loaded into an owned buffer.\n@param Ar Archive to read the attachment from. An error state is set on failure.\n@param Allocator Allocator for the attachment value buffer.\n@note Allocated buffers will be cloned if they are not owned."
    },
    {
      "id": "save-29bdd9",
      "name": "Save",
      "category": "CompactBinaryPackage",
      "signature": "Save(Target, Writer)",
      "params": [
        {
          "name": "Target",
          "type": "FCbAttachment*"
        },
        {
          "name": "Writer",
          "type": "FCbWriter&"
        }
      ],
      "returnType": "Void",
      "docs": "Save the attachment into the writer as a stream of compact binary fields."
    },
    {
      "id": "save-612c1d",
      "name": "Save",
      "category": "CompactBinaryPackage",
      "signature": "Save(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FCbAttachment*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Save the attachment into the archive as a stream of compact binary fields."
    },
    {
      "id": "find-attachment",
      "name": "FindAttachment",
      "category": "CompactBinaryPackage",
      "signature": "FindAttachment(Target, Hash)",
      "params": [
        {
          "name": "Target",
          "type": "FCbPackage*"
        },
        {
          "name": "Hash",
          "type": "FIoHash&"
        }
      ],
      "returnType": "FCbAttachment*",
      "docs": "Find an attachment by its hash.\n@return The attachment, or null if the attachment is not found.\n@note The returned pointer is only valid until the attachments on this package are modified."
    },
    {
      "id": "remove-attachment",
      "name": "RemoveAttachment",
      "category": "CompactBinaryPackage",
      "signature": "RemoveAttachment(Target, Hash)",
      "params": [
        {
          "name": "Target",
          "type": "FCbPackage*"
        },
        {
          "name": "Hash",
          "type": "FIoHash&"
        }
      ],
      "returnType": "Int",
      "docs": "Remove an attachment by hash.\n@return Number of attachments removed, which will be either 0 or 1."
    },
    {
      "id": "equals",
      "name": "Equals",
      "category": "CompactBinaryPackage",
      "signature": "Equals(Target, Package)",
      "params": [
        {
          "name": "Target",
          "type": "FCbPackage*"
        },
        {
          "name": "Package",
          "type": "FCbPackage&"
        }
      ],
      "returnType": "Bool",
      "docs": "Compares packages by their object and attachment hashes."
    },
    {
      "id": "set-object",
      "name": "SetObject",
      "category": "CompactBinaryPackage",
      "signature": "SetObject(Target, Object, Hash, Resolver)",
      "params": [
        {
          "name": "Target",
          "type": "FCbPackage*"
        },
        {
          "name": "Object",
          "type": "FCbObject"
        },
        {
          "name": "Hash",
          "type": "FIoHash*"
        },
        {
          "name": "Resolver",
          "type": "FAttachmentResolver*"
        }
      ],
      "returnType": "Void"
    }
  ]
}