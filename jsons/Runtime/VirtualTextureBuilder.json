{
  "id": "virtual-texture-builder",
  "label": "VirtualTextureBuilder",
  "includepath": "VT/VirtualTextureBuilder.h",
  "includes": [
    "CoreMinimal",
    "Texture",
    "VirtualTextureBuilder.generated"
  ],
  "functions": [
    {
      "id": "get-virtual-texture",
      "name": "GetVirtualTexture",
      "category": "VirtualTextureBuilder",
      "signature": "GetVirtualTexture(Target, Shading Path)",
      "params": [
        {
          "name": "Target",
          "type": "UVirtualTextureBuilder*"
        },
        {
          "name": "Shading Path",
          "type": "EShadingPath"
        }
      ],
      "returnType": "UVirtualTexture2D*",
      "docs": "Virtual texture for a specific shading path"
    },
    {
      "id": "build-texture",
      "name": "BuildTexture",
      "category": "VirtualTextureBuilder",
      "signature": "BuildTexture(Target, Shading Path, Build Desc, Wait For Compilation)",
      "params": [
        {
          "name": "Target",
          "type": "UVirtualTextureBuilder*"
        },
        {
          "name": "Shading Path",
          "type": "EShadingPath"
        },
        {
          "name": "Build Desc",
          "type": "FVirtualTextureBuildDesc&"
        },
        {
          "name": "Wait For Compilation",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Creates a new UVirtualTexture2D and stores it in the contained Texture."
    }
  ]
}