    {
      "id": "create-from-model",
      "name": "CreateFromModel",
      "category": "BodySetup",
      "signature": "CreateFromModel(Target, In Model, Remove Existing)",
      "params": [
        {
          "name": "Target",
          "type": "UBodySetup*"
        },
        {
          "name": "In Model",
          "type": "UModel*"
        },
        {
          "name": "Remove Existing",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Converts a UModel to a set of convex hulls for simplified collision.  Any convex elements already in\nthis BodySetup will be destroyed.  WARNING: the input model can have no single polygon or\nset of coplanar polygons which merge to more than FPoly::MAX_VERTICES vertices.\n@param\t\tInModel\t\t\t\t\tThe input BSP.\n@param\t\tbRemoveExisting\t\t\tIf true, clears any pre-existing collision\n@return\t\t\t\t\t\t\t\ttrue on success, false on failure because of vertex count overflow."
    },
    {
      "id": "update-tri-mesh-vertices",
      "name": "UpdateTriMeshVertices",
      "category": "BodySetup",
      "signature": "UpdateTriMeshVertices(Target, New Positions)",
      "params": [
        {
          "name": "Target",
          "type": "UBodySetup*"
        },
        {
          "name": "New Positions",
          "type": "TArray<FVector>&"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the tri mesh collision with new positions, and refits the BVH to match.\nThis is not a full collision cook, and so you can only safely move positions and not change the structure\n@param\tNewPositions\t\tThe new mesh positions to use"
    },
    {
      "id": "get-shortest-distance-to-point",
      "name": "GetShortestDistanceToPoint",
      "category": "BodySetup",
      "signature": "GetShortestDistanceToPoint(Target, World Position, Body To World TM, Use Convex Shapes)",
      "params": [
        {
          "name": "Target",
          "type": "UBodySetup*"
        },
        {
          "name": "World Position",
          "type": "FVector&"
        },
        {
          "name": "Body To World TM",
          "type": "FTransform&"
        },
        {
          "name": "Use Convex Shapes",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Float",
      "docs": "Finds the shortest distance between the body setup and a world position. Input and output are given in world space\n@param\tWorldPosition\tThe point we are trying to get close to\n@param\tBodyToWorldTM\tThe transform to convert BodySetup into world space\n@param\tbUseConvexShapes When true also check the convex shapes if any (false by default)\n@return\t\t\t\t\tThe distance between WorldPosition and the body setup. 0 indicates WorldPosition is inside one of the shapes.\nNOTE: This function ignores trimesh data"
    },
    {
      "id": "get-closest-point-and-normal",
      "name": "GetClosestPointAndNormal",
      "category": "BodySetup",
      "signature": "GetClosestPointAndNormal(Target, World Position, Body To World TM, Closest World Position, Feature Normal, Use Convex Shapes)",
      "params": [
        {
          "name": "Target",
          "type": "UBodySetup*"
        },
        {
          "name": "World Position",
          "type": "FVector&"
        },
        {
          "name": "Body To World TM",
          "type": "FTransform&"
        },
        {
          "name": "Closest World Position",
          "type": "FVector&"
        },
        {
          "name": "Feature Normal",
          "type": "FVector&"
        },
        {
          "name": "Use Convex Shapes",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Float",
      "docs": "Finds the closest point in the body setup. Input and outputs are given in world space.\n@param\tWorldPosition\t\t\tThe point we are trying to get close to\n@param\tBodyToWorldTM\t\t\tThe transform to convert BodySetup into world space\n@param\tClosestWorldPosition\tThe closest point on the body setup to WorldPosition\n@param\tFeatureNormal\t\t\tThe normal of the feature associated with ClosestWorldPosition\n@param\tbUseConvexShapes When true also check the convex shapes if any (false by default)\n@return\t\t\t\t\t\t\tThe distance between WorldPosition and the body setup. 0 indicates WorldPosition is inside one of the shapes.\nNOTE: This function ignores trimesh data"
    },
