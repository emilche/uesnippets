      "id": "get-render-target-resource",
      "name": "GetRenderTargetResource",
      "category": "TextureRenderTarget",
      "signature": "GetRenderTargetResource(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureRenderTarget*"
        }
      ],
      "returnType": "FTextureRenderTargetResource*",
      "docs": "If true, there will be two copies in memory - one for the texture and one for the render target. If false, they will share memory if possible. This is useful for scene capture textures that are used in the scene."
    },
    {
      "id": "game-thread-get-render-target-resource",
      "name": "GameThread_GetRenderTargetResource",
      "category": "TextureRenderTarget",
      "signature": "GameThread_GetRenderTargetResource(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureRenderTarget*"
        }
      ],
      "returnType": "FTextureRenderTargetResource*",
      "docs": "Returns a pointer to the (game thread managed) render target resource.  Note that you're not allowed\nto deferenced this pointer on the game thread, you can only pass the pointer around and check for NULLness\n@return pointer to resource"
    },
