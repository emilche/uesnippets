{
  "id": "aerofoil-module",
  "label": "AerofoilModule",
  "includepath": "SimModule/AerofoilModule.h",
  "includes": [
    "VehicleUtility",
    "SimulationModuleBase"
  ],
  "functions": [
    {
      "id": "simulate",
      "name": "Simulate",
      "category": "AerofoilModule",
      "signature": "Simulate(Target, Delta Time, Inputs, Vehicle Module System)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Inputs",
          "type": "FAllInputs&"
        },
        {
          "name": "Vehicle Module System",
          "type": "FSimModuleTree&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "animate",
      "name": "Animate",
      "category": "AerofoilModule",
      "signature": "Animate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-center-of-lift-offset",
      "name": "GetCenterOfLiftOffset",
      "category": "AerofoilModule",
      "signature": "GetCenterOfLiftOffset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        }
      ],
      "returnType": "FVector"
    },
    {
      "id": "get-force",
      "name": "GetForce",
      "category": "AerofoilModule",
      "signature": "GetForce(Target, V, Altitude, Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "V",
          "type": "FVector&"
        },
        {
          "name": "Altitude",
          "type": "Float"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "FVector"
    },
    {
      "id": "calc-dynamic-pressure",
      "name": "CalcDynamicPressure",
      "category": "AerofoilModule",
      "signature": "CalcDynamicPressure(Target, Velocity Sqr, In Altitude)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "Velocity Sqr",
          "type": "Float"
        },
        {
          "name": "In Altitude",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Dynamic air pressure = 0.5 * AirDensity * Vsqr"
    },
    {
      "id": "calc-centre-of-lift",
      "name": "CalcCentreOfLift",
      "category": "AerofoilModule",
      "signature": "CalcCentreOfLift(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        }
      ],
      "returnType": "Float",
      "docs": "Center of lift moves fore/aft based on current AngleOfAttack"
    },
    {
      "id": "calc-drag-coefficient",
      "name": "CalcDragCoefficient",
      "category": "AerofoilModule",
      "signature": "CalcDragCoefficient(Target, In Angle Of Attack, In Control Surface Angle)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "In Angle Of Attack",
          "type": "Float"
        },
        {
          "name": "In Control Surface Angle",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Returns drag coefficient for the current angle of attack of the aerofoil surface"
    },
    {
      "id": "calc-lift-coefficient",
      "name": "CalcLiftCoefficient",
      "category": "AerofoilModule",
      "signature": "CalcLiftCoefficient(Target, In Angle Of Attack, In Control Surface Angle)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "In Angle Of Attack",
          "type": "Float"
        },
        {
          "name": "In Control Surface Angle",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Returns lift coefficient for the current angle of attack of the aerofoil surface\nCheating by making control surface part of entire aerofoil movement"
    },
    {
      "id": "calc-angle-of-attack-degrees",
      "name": "CalcAngleOfAttackDegrees",
      "category": "AerofoilModule",
      "signature": "CalcAngleOfAttackDegrees(Target, Up Axis, In Airflow Vector)",
      "params": [
        {
          "name": "Target",
          "type": "FAerofoilSimModule*"
        },
        {
          "name": "Up Axis",
          "type": "FVector&"
        },
        {
          "name": "In Airflow Vector",
          "type": "FVector&"
        }
      ],
      "returnType": "Float",
      "docs": "Angle of attack is the angle between the aerofoil and the airflow vector"
    }
  ]
}