    {
      "id": "client-fill-network-move-data-974a97",
      "name": "ClientFillNetworkMoveData",
      "category": "CharacterMovementReplication",
      "signature": "ClientFillNetworkMoveData(Target, Client Move, Move Type)",
      "params": [
        {
          "name": "Target",
          "type": "FCharacterNetworkMoveData*"
        },
        {
          "name": "Client Move",
          "type": "FSavedMove_Character&"
        },
        {
          "name": "Move Type",
          "type": "ENetworkMoveType"
        }
      ],
      "returnType": "Void",
      "docs": "Given a FSavedMove_Character from UCharacterMovementComponent, fill in data in this struct with relevant movement data.\nNote that the instance of the FSavedMove_Character is likely a custom struct of a derived struct of your own, if you have added your own saved move data.\n@see UCharacterMovementComponent::AllocateNewMove()"
    },
    {
      "id": "serialize-c05474",
      "name": "Serialize",
      "category": "CharacterMovementReplication",
      "signature": "Serialize(Target, Character Movement, Ar, Package Map, Move Type)",
      "params": [
        {
          "name": "Target",
          "type": "FCharacterNetworkMoveData*"
        },
        {
          "name": "Character Movement",
          "type": "UCharacterMovementComponent&"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Package Map",
          "type": "UPackageMap*"
        },
        {
          "name": "Move Type",
          "type": "ENetworkMoveType"
        }
      ],
      "returnType": "Bool",
      "docs": "Serialize the data in this struct to or from the given FArchive. This packs or unpacks the data in to a variable-sized data stream that is sent over the\nnetwork from client to server.\n@see UCharacterMovementComponent::CallServerMovePacked"
    },
    {
      "id": "client-fill-network-move-data-d76b6d",
      "name": "ClientFillNetworkMoveData",
      "category": "CharacterMovementReplication",
      "signature": "ClientFillNetworkMoveData(Target, Client New Move, Client Pending Move, Client Old Move)",
      "params": [
        {
          "name": "Target",
          "type": "FCharacterNetworkMoveDataContainer*"
        },
        {
          "name": "Client New Move",
          "type": "FSavedMove_Character*"
        },
        {
          "name": "Client Pending Move",
          "type": "FSavedMove_Character*"
        },
        {
          "name": "Client Old Move",
          "type": "FSavedMove_Character*"
        }
      ],
      "returnType": "Void",
      "docs": "Passes through calls to ClientFillNetworkMoveData on each FCharacterNetworkMoveData matching the client moves. Note that ClientNewMove will never be null, but others may be."
    },
    {
      "id": "serialize-08b074",
      "name": "Serialize",
      "category": "CharacterMovementReplication",
      "signature": "Serialize(Target, Character Movement, Ar, Package Map)",
      "params": [
        {
          "name": "Target",
          "type": "FCharacterNetworkMoveDataContainer*"
        },
        {
          "name": "Character Movement",
          "type": "UCharacterMovementComponent&"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Package Map",
          "type": "UPackageMap*"
        }
      ],
      "returnType": "Bool",
      "docs": "Serialize movement data. Passes Serialize calls to each FCharacterNetworkMoveData as applicable, based on bHasPendingMove and bHasOldMove."
    },
    {
      "id": "server-fill-response-data",
