{
  "id": "geom-tools",
  "label": "GeomTools",
  "includepath": "GeomTools.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "copy-face",
      "name": "CopyFace",
      "category": "GeomTools",
      "signature": "CopyFace(Target, Other Face)",
      "params": [
        {
          "name": "Target",
          "type": "FClipSMFace*"
        },
        {
          "name": "Other Face",
          "type": "FClipSMFace&"
        }
      ],
      "returnType": "Void",
      "docs": "A polygon in 2D space, used by utility function."
    },
    {
      "id": "compute-gradients-and-normal",
      "name": "ComputeGradientsAndNormal",
      "category": "GeomTools",
      "signature": "ComputeGradientsAndNormal(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FClipSMTriangle*"
        }
      ],
      "returnType": "Void",
      "docs": "Properties of a clipped static mesh triangle."
    },
    {
      "id": "get-clippable-static-mesh-triangles",
      "name": "GetClippableStaticMeshTriangles",
      "category": "GeomTools",
      "signature": "GetClippableStaticMeshTriangles(Out Clippable Triangles, Static Mesh)",
      "params": [
        {
          "name": "Out Clippable Triangles",
          "type": "TArray<FClipSMTriangle>&"
        },
        {
          "name": "Static Mesh",
          "type": "UStaticMesh*"
        }
      ],
      "returnType": "Void",
      "docs": "Extracts the triangles from a static-mesh as clippable triangles."
    },
    {
      "id": "clip-mesh-with-plane",
      "name": "ClipMeshWithPlane",
      "category": "GeomTools",
      "signature": "ClipMeshWithPlane(Out Tris, Out Clip Edges, In Triangles, Plane)",
      "params": [
        {
          "name": "Out Tris",
          "type": "TArray<FClipSMTriangle>&"
        },
        {
          "name": "Out Clip Edges",
          "type": "TArray<FUtilEdge3D>&"
        },
        {
          "name": "In Triangles",
          "type": "TArray<FClipSMTriangle>&"
        },
        {
          "name": "Plane",
          "type": "FPlane&"
        }
      ],
      "returnType": "Void",
      "docs": "Take the input mesh and cut it with supplied plane, creating new verts etc. Also outputs new edges created on the plane."
    },
    {
      "id": "project-edges",
      "name": "ProjectEdges",
      "category": "GeomTools",
      "signature": "ProjectEdges(Out 2 D Edges, To World, In 3 D Edges, In Plane)",
      "params": [
        {
          "name": "Out 2 D Edges",
          "type": "TArray<FUtilEdge2D>&"
        },
        {
          "name": "To World",
          "type": "FMatrix&"
        },
        {
          "name": "In 3 D Edges",
          "type": "TArray<FUtilEdge3D>&"
        },
        {
          "name": "In Plane",
          "type": "FPlane&"
        }
      ],
      "returnType": "Void",
      "docs": "Take a set of 3D Edges and project them onto the supplied plane. Also returns matrix use to convert them back into 3D edges."
    },
    {
      "id": "buid-2-d-polys-from-edges",
      "name": "Buid2DPolysFromEdges",
      "category": "GeomTools",
      "signature": "Buid2DPolysFromEdges(Out Polys, In Edges, Vert Color)",
      "params": [
        {
          "name": "Out Polys",
          "type": "TArray<FUtilPoly2D>&"
        },
        {
          "name": "In Edges",
          "type": "TArray<FUtilEdge2D>&"
        },
        {
          "name": "Vert Color",
          "type": "FColor&"
        }
      ],
      "returnType": "Void",
      "docs": "Given a set of edges, find the set of closed polygons created by them."
    },
    {
      "id": "triangulate-poly-7d982c",
      "name": "TriangulatePoly",
      "category": "GeomTools",
      "signature": "TriangulatePoly(Out Tris, In Poly, Keep Colinear Vertices)",
      "params": [
        {
          "name": "Out Tris",
          "type": "TArray<FClipSMTriangle>&"
        },
        {
          "name": "In Poly",
          "type": "FClipSMPolygon&"
        },
        {
          "name": "Keep Colinear Vertices",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Given a polygon, decompose into triangles and append to OutTris.\n@return\ttrue if the triangulation was successful."
    },
    {
      "id": "transform-2-d-polygon-to-sm-polygon",
      "name": "Transform2DPolygonToSMPolygon",
      "category": "GeomTools",
      "signature": "Transform2DPolygonToSMPolygon(In Tri, In Matrix)",
      "params": [
        {
          "name": "In Tri",
          "type": "FUtilPoly2D&"
        },
        {
          "name": "In Matrix",
          "type": "FMatrix&"
        }
      ],
      "returnType": "FClipSMPolygon",
      "docs": "Transform triangle from 2D to 3D static-mesh triangle."
    },
    {
      "id": "generate-planar-fit-poly-u-vs",
      "name": "GeneratePlanarFitPolyUVs",
      "category": "GeomTools",
      "signature": "GeneratePlanarFitPolyUVs(Polygon)",
      "params": [
        {
          "name": "Polygon",
          "type": "FUtilPoly2D&"
        }
      ],
      "returnType": "Void",
      "docs": "Does a simple planar map using the bounds of this 2D polygon."
    },
    {
      "id": "generate-planar-tiling-poly-u-vs",
      "name": "GeneratePlanarTilingPolyUVs",
      "category": "GeomTools",
      "signature": "GeneratePlanarTilingPolyUVs(Polygon, Tile Size)",
      "params": [
        {
          "name": "Polygon",
          "type": "FUtilPoly2D&"
        },
        {
          "name": "Tile Size",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Applies tiling UVs to the verts of this polygon"
    },
    {
      "id": "remove-redundant-triangles-e4230b",
      "name": "RemoveRedundantTriangles",
      "category": "GeomTools",
      "signature": "RemoveRedundantTriangles(Tris)",
      "params": [
        {
          "name": "Tris",
          "type": "TArray<FClipSMTriangle>&"
        }
      ],
      "returnType": "Void",
      "docs": "Given a set of triangles, remove those which share an edge and could be collapsed into one triangle."
    },
    {
      "id": "split-2-d-polys-with-plane",
      "name": "Split2DPolysWithPlane",
      "category": "GeomTools",
      "signature": "Split2DPolysWithPlane(Poly Set, Plane, Exterior Vert Color, Interior Vert Color)",
      "params": [
        {
          "name": "Poly Set",
          "type": "FUtilPoly2DSet&"
        },
        {
          "name": "Plane",
          "type": "FPlane&"
        },
        {
          "name": "Exterior Vert Color",
          "type": "FColor&"
        },
        {
          "name": "Interior Vert Color",
          "type": "FColor&"
        }
      ],
      "returnType": "Void",
      "docs": "Split 2D polygons with a 3D plane."
    },
    {
      "id": "vectors-on-same-side",
      "name": "VectorsOnSameSide",
      "category": "GeomTools",
      "signature": "VectorsOnSameSide(Vec, A, B, Same Side Dot Product Epsilon)",
      "params": [
        {
          "name": "Vec",
          "type": "FVector3f&"
        },
        {
          "name": "A",
          "type": "FVector3f&"
        },
        {
          "name": "B",
          "type": "FVector3f&"
        },
        {
          "name": "Same Side Dot Product Epsilon",
          "type": "Float",
          "default": "0.0f"
        }
      ],
      "returnType": "Bool",
      "docs": "Given three direction vectors, indicates if A and B are on the same 'side' of Vec."
    },
    {
      "id": "point-in-triangle",
      "name": "PointInTriangle",
      "category": "GeomTools",
      "signature": "PointInTriangle(A, B, C, P, Inside Triangle Dot Product Epsilon)",
      "params": [
        {
          "name": "A",
          "type": "FVector3f&"
        },
        {
          "name": "B",
          "type": "FVector3f&"
        },
        {
          "name": "C",
          "type": "FVector3f&"
        },
        {
          "name": "P",
          "type": "FVector3f&"
        },
        {
          "name": "Inside Triangle Dot Product Epsilon",
          "type": "Float",
          "default": "0.0f"
        }
      ],
      "returnType": "Bool",
      "docs": "Util to see if P lies within triangle created by A, B and C."
    },
