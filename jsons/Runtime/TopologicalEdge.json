      "params": [
        {
          "name": "Target",
          "type": "FTopologicalEdge*"
        }
      ],
      "returnType": "Bool",
      "docs": "An edge is a thin peak means that this edge is a small edge at the extremity of a peak thin zone\nSo this edge must not be meshed (except at its extremities)\nThinSide 0\n#-------------------------------------#\n/\n/  <- Thin peak edge\n/\n#-----------------------------------------#\nThinSide 1"
