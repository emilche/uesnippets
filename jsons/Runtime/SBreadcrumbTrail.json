{
  "id": "s-breadcrumb-trail",
  "label": "SBreadcrumbTrail",
  "includepath": "Widgets/Navigation/SBreadcrumbTrail.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "SlateColor",
    "Visibility",
    "Reply",
    "SWidget",
    "Margin",
    "SNullWidget",
    "DeclarativeSyntaxSupport",
    "SCompoundWidget",
    "SBoxPanel",
    "SlateTypes",
    "CoreStyle",
    "SImage",
    "SMenuAnchor",
    "SButton",
    "SScrollBox"
  ],
  "functions": [
    {
      "id": "scroll-to-end",
      "name": "ScrollToEnd",
      "category": "SBreadcrumbTrail",
      "signature": "ScrollToEnd(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrailBase*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "push-crumb",
      "name": "PushCrumb",
      "category": "SBreadcrumbTrail",
      "signature": "PushCrumb(Target, Crumb Text, New Crumb Data)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        },
        {
          "name": "Crumb Text",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "New Crumb Data",
          "type": "ItemType&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a crumb to the end of the trail."
    },
    {
      "id": "pop-crumb",
      "name": "PopCrumb",
      "category": "SBreadcrumbTrail",
      "signature": "PopCrumb(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        }
      ],
      "returnType": "ItemType",
      "docs": "Pops a crumb off the end of the trail. Returns the crumb data."
    },
    {
      "id": "peek-crumb",
      "name": "PeekCrumb",
      "category": "SBreadcrumbTrail",
      "signature": "PeekCrumb(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        }
      ],
      "returnType": "ItemType",
      "docs": "Peeks at the end crumb in the trail. Returns the crumb data."
    },
    {
      "id": "has-crumbs",
      "name": "HasCrumbs",
      "category": "SBreadcrumbTrail",
      "signature": "HasCrumbs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if there are any crumbs in the trail."
    },
    {
      "id": "num-crumbs",
      "name": "NumCrumbs",
      "category": "SBreadcrumbTrail",
      "signature": "NumCrumbs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the number of crumbs in the trail."
    },
    {
      "id": "clear-crumbs",
      "name": "ClearCrumbs",
      "category": "SBreadcrumbTrail",
      "signature": "ClearCrumbs(Target, Pop All Crumbs To Clear)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        },
        {
          "name": "Pop All Crumbs To Clear",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Removes all crumbs from the crumb box"
    },
    {
      "id": "get-all-crumb-data",
      "name": "GetAllCrumbData",
      "category": "SBreadcrumbTrail",
      "signature": "GetAllCrumbData(Target, Crumb Data)",
      "params": [
        {
          "name": "Target",
          "type": "SBreadcrumbTrail*"
        },
        {
          "name": "Crumb Data",
          "type": "TArray<ItemType>&"
        }
      ],
      "returnType": "Void",
      "docs": "Gets all the crumb data in the trail"
    }
  ]
}