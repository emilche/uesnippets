{
  "id": "dxgi-utilities",
  "label": "DXGIUtilities",
  "includepath": "DXGIUtilities.h",
  "includes": [
    "Platform",
    "PixelFormat",
    "RHIDefinitions",
    "AssertionMacros",
    "AllowMicrosoftPlatformTypes",
    "HideMicrosoftPlatformTypes"
  ],
  "functions": [
    {
      "id": "get-format-string",
      "name": "GetFormatString",
      "category": "DXGIUtilities",
      "signature": "GetFormatString(Format)",
      "params": [
        {
          "name": "Format",
          "type": "DXGI_FORMAT"
        }
      ],
      "returnType": "TCHAR*"
    },
    {
      "id": "get-d-3-d-memory-stats",
      "name": "GetD3DMemoryStats",
      "category": "DXGIUtilities",
      "signature": "GetD3DMemoryStats(Adapter, Out Stats)",
      "params": [
        {
          "name": "Adapter",
          "type": "IDXGIAdapter*"
        },
        {
          "name": "Out Stats",
          "type": "FD3DMemoryStats&"
        }
      ],
      "returnType": "HRESULT"
    }
  ]
}