      "signature": "ResetFlushState(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMovieSceneEntitySystemRunner*"
        }
      ],
      "returnType": "Void",
      "docs": "Called in the event that the structure of the entity manager has been unexpectedly changed while this runner is active.\nThis allows the runner to be reset so it runs from the start of its evaluation loop next time it is evaluated, rather than half-way through"
    },
