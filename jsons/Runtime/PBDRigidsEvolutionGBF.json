    },
    {
      "id": "apply-particle-transform-correction-delta",
      "name": "ApplyParticleTransformCorrectionDelta",
      "category": "PBDRigidsEvolutionGBF",
      "signature": "ApplyParticleTransformCorrectionDelta(Target, In Particle, In Pos Delta, In Rot Delta, Apply To Connected Bodies, In Recalculate Friction On Connected Bodies, Exclude Connections)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionGBF*"
        },
        {
          "name": "In Particle",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "In Pos Delta",
          "type": "FVec3&"
        },
        {
          "name": "In Rot Delta",
          "type": "FVec3&"
        },
        {
          "name": "Apply To Connected Bodies",
          "type": "Bool"
        },
        {
          "name": "In Recalculate Friction On Connected Bodies",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Exclude Connections",
          "type": "TArray<FParticleID>&",
          "default": "TArray<FParticleID>()"
        }
      ],
      "returnType": "Void",
      "docs": "[EXPERIMENTAL] Apply a momentumless correction to the particle transform, usually as a result of a server correction.\nThis will shift the particle by the supplied delta and handle updating of friction anchors or anything else that might prevent or undo the shift.\nIf bApplyToConnectedBodies is true, any particle attached by a joint with locked linear limits will also get moved.\nNOTE: must be called prior to Integrate() to be effective.\nNOTE: be careful with bApplyToConnectedBodies - only one particle in the connected graph should have ApplyParticleTransformCorrectionDelta called on\nit, otherwise you will get multiple particles trying to recorrect each other leading to very strange behaviour.\nUse @param ExcludeConnections to exclude particles from being corrected, this includes particles connected to the excluded particle as long as they are not connected to a non-excluded particle."
    },
    {
      "id": "apply-particle-transform-correction",
      "name": "ApplyParticleTransformCorrection",
      "category": "PBDRigidsEvolutionGBF",
      "signature": "ApplyParticleTransformCorrection(Target, In Particle, In Pos, In Rot, Apply To Connected Bodies, In Recalculate Friction On Connected Bodies, Exclude Connections)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionGBF*"
        },
        {
          "name": "In Particle",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "In Pos",
          "type": "FVec3&"
        },
        {
          "name": "In Rot",
          "type": "FRotation3&"
        },
        {
          "name": "Apply To Connected Bodies",
          "type": "Bool"
        },
        {
          "name": "In Recalculate Friction On Connected Bodies",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Exclude Connections",
          "type": "TArray<FParticleID>&",
          "default": "TArray<FParticleID>()"
        }
      ],
      "returnType": "Void",
      "docs": "[EXPERIMENTAL] Similar to SetParticleTransformCorrectionDelta, but supplied an absolute transform to jump to. This is used for snaps."
    },
