    {
      "id": "get-lod-model-derive-data-key",
      "name": "GetLODModelDeriveDataKey",
      "category": "SkeletalMeshLODModel",
      "signature": "GetLODModelDeriveDataKey(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
        }
      ],
      "returnType": "String",
      "docs": "Build a derive data key with the user section data (UserSectionsData) and the original bulk data"
    },
    {
      "id": "update-chunked-section-info",
      "name": "UpdateChunkedSectionInfo",
      "category": "SkeletalMeshLODModel",
      "signature": "UpdateChunkedSectionInfo(Target, Skeletal Mesh Name)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
        },
        {
          "name": "Skeletal Mesh Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "This function will update the chunked information for each section. Only old data before the\nskeletal mesh build refactor should need to call this function."
    },
    {
      "id": "copy-structure",
      "name": "CopyStructure",
      "category": "SkeletalMeshLODModel",
      "signature": "CopyStructure(Destination, Source)",
      "params": [
        {
          "name": "Destination",
          "type": "FSkeletalMeshLODModel*"
        },
        {
          "name": "Source",
          "type": "FSkeletalMeshLODModel*"
        }
      ],
      "returnType": "Void",
      "docs": "Copy one structure to the other, make sure all bulk data is unlock and the data can be read before copying.\nIt also use a private mutex to make sure it's thread safe to copy the same source multiple time in multiple thread."
    },
    {
      "id": "get-mesh-description",
      "name": "GetMeshDescription",
      "category": "SkeletalMeshLODModel",
      "signature": "GetMeshDescription(Target, In Skeletal Mesh, In LOD Index, Out Mesh Description)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
        },
        {
          "name": "In Skeletal Mesh",
          "type": "USkeletalMesh*"
        },
        {
          "name": "In LOD Index",
          "type": "Int"
        },
        {
          "name": "Out Mesh Description",
          "type": "FMeshDescription&"
        }
      ],
      "returnType": "Void",
      "docs": "Fills in a representation of this model into the given mesh description object. Existing\nmesh description data is emptied."
    }
