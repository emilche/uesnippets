      "name": "HasClothData",
      "category": "SkeletalMeshLODModel",
      "signature": "HasClothData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if any chunks have cloth data."
    },
    {
      "id": "num-non-clothing-sections",
      "name": "NumNonClothingSections",
      "category": "SkeletalMeshLODModel",
      "signature": "NumNonClothingSections(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-num-non-clothing-vertices",
      "name": "GetNumNonClothingVertices",
      "category": "SkeletalMeshLODModel",
