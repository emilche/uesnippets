      "returnType": "Void",
      "docs": "Similar to GetVertices but ignores vertices from clothing sections\nto avoid getting duplicate vertices from clothing sections if not needed\n@param OutVertices Array to fill"
    },
    {
      "id": "get-max-bone-influences",
      "name": "GetMaxBoneInfluences",
      "category": "SkeletalMeshLODModel",
