    },
    {
      "id": "syncronize-user-sections-data-array",
      "name": "SyncronizeUserSectionsDataArray",
      "category": "SkeletalMeshLODModel",
      "signature": "SyncronizeUserSectionsDataArray(Target, Reset Non Used Section)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODModel*"
