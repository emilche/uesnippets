{
  "id": "slate-editable-text-types",
  "label": "SlateEditableTextTypes",
  "includepath": "Widgets/Text/SlateEditableTextTypes.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "TextLayout",
    "ISlateLineHighlighter"
  ],
  "functions": [
    {
      "id": "get-cursor-location",
      "name": "GetCursorLocation",
      "category": "SlateEditableTextTypes",
      "signature": "GetCursorLocation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "FTextLocation",
      "docs": "Get the literal position of the cursor (note: this may not be the correct place to insert text to, use GetCursorInteractionLocation for that)"
    },
    {
      "id": "get-cursor-alignment",
      "name": "GetCursorAlignment",
      "category": "SlateEditableTextTypes",
      "signature": "GetCursorAlignment(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "ECursorAlignment",
      "docs": "Get the alignment of the cursor"
    },
    {
      "id": "get-cursor-text-direction",
      "name": "GetCursorTextDirection",
      "category": "SlateEditableTextTypes",
      "signature": "GetCursorTextDirection(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "TextBiDi::ETextDirection",
      "docs": "Get the direction of the text under the cursor"
    },
    {
      "id": "get-cursor-interaction-location",
      "name": "GetCursorInteractionLocation",
      "category": "SlateEditableTextTypes",
      "signature": "GetCursorInteractionLocation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "FTextLocation",
      "docs": "Get the interaction position of the cursor (where to insert, delete, etc, text from/to)"
    },
    {
      "id": "get-last-cursor-interaction-time",
      "name": "GetLastCursorInteractionTime",
      "category": "SlateEditableTextTypes",
      "signature": "GetLastCursorInteractionTime(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "Double"
    },
    {
      "id": "update-last-cursor-interaction-time",
      "name": "UpdateLastCursorInteractionTime",
      "category": "SlateEditableTextTypes",
      "signature": "UpdateLastCursorInteractionTime(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "Void",
      "docs": "Update the last cursor interaction time to now"
    },
    {
      "id": "set-cursor-location-and-calculate-alignment",
      "name": "SetCursorLocationAndCalculateAlignment",
      "category": "SlateEditableTextTypes",
      "signature": "SetCursorLocationAndCalculateAlignment(Target, In Text Layout, In Cursor Position)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        },
        {
          "name": "In Text Layout",
          "type": "FTextLayout&"
        },
        {
          "name": "In Cursor Position",
          "type": "FTextLocation&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the position of the cursor, and then work out the correct alignment based on the current text layout"
    },
    {
      "id": "set-cursor-location-and-alignment",
      "name": "SetCursorLocationAndAlignment",
      "category": "SlateEditableTextTypes",
      "signature": "SetCursorLocationAndAlignment(Target, In Text Layout, In Cursor Position, In Cursor Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        },
        {
          "name": "In Text Layout",
          "type": "FTextLayout&"
        },
        {
          "name": "In Cursor Position",
          "type": "FTextLocation&"
        },
        {
          "name": "In Cursor Alignment",
          "type": "ECursorAlignment"
        }
      ],
      "returnType": "Void",
      "docs": "Set the literal position and alignment of the cursor"
    },
    {
      "id": "create-undo",
      "name": "CreateUndo",
      "category": "SlateEditableTextTypes",
      "signature": "CreateUndo(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        }
      ],
      "returnType": "FCursorInfo",
      "docs": "Create an undo for this cursor data"
    },
    {
      "id": "restore-from-undo",
      "name": "RestoreFromUndo",
      "category": "SlateEditableTextTypes",
      "signature": "RestoreFromUndo(Target, Undo Data)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorInfo*"
        },
        {
          "name": "Undo Data",
          "type": "FCursorInfo&"
        }
      ],
      "returnType": "Void",
      "docs": "Restore this cursor data from an undo"
    },
    {
      "id": "set-cursor-brush",
      "name": "SetCursorBrush",
      "category": "SlateEditableTextTypes",
      "signature": "SetCursorBrush(Target, In Cursor Brush)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorLineHighlighter*"
        },
        {
          "name": "In Cursor Brush",
          "type": "TAttribute<FSlateBrush*>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-paint",
      "name": "OnPaint",
      "category": "SlateEditableTextTypes",
      "signature": "OnPaint(Target, Args, Line, Offset, Width, Default Style, Allotted Geometry, My Culling Rect, Out Draw Elements, Layer Id, In Widget Style, Parent Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "FCursorLineHighlighter*"
        },
        {
          "name": "Args",
          "type": "FPaintArgs&"
        },
        {
          "name": "Line",
          "type": "FTextLayout::FLineView&"
        },
        {
          "name": "Offset",
          "type": "FVector2D"
        },
        {
          "name": "Width",
          "type": "Float"
        },
        {
          "name": "Default Style",
          "type": "FTextBlockStyle&"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "My Culling Rect",
          "type": "FSlateRect&"
        },
        {
          "name": "Out Draw Elements",
          "type": "FSlateWindowElementList&"
        },
        {
          "name": "Layer Id",
          "type": "Int"
        },
        {
          "name": "In Widget Style",
          "type": "FWidgetStyle&"
        },
        {
          "name": "Parent Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Int",
      "supportedTargets": [
        "FCursorLineHighlighter*",
        "FTextCompositionHighlighter*",
        "FTextSelectionHighlighter*",
        "FTextSearchHighlighter*"
      ]
    },
    {
      "id": "set-composition-brush",
      "name": "SetCompositionBrush",
      "category": "SlateEditableTextTypes",
      "signature": "SetCompositionBrush(Target, In Composition Brush)",
      "params": [
        {
          "name": "Target",
          "type": "FTextCompositionHighlighter*"
        },
        {
          "name": "In Composition Brush",
          "type": "TAttribute<FSlateBrush*>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-has-keyboard-focus",
      "name": "SetHasKeyboardFocus",
      "category": "SlateEditableTextTypes",
      "signature": "SetHasKeyboardFocus(Target, In Has Keyboard Focus)",
      "params": [
        {
          "name": "Target",
          "type": "FTextSelectionHighlighter*"
        },
        {
          "name": "In Has Keyboard Focus",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "supportedTargets": [
        "FTextSelectionHighlighter*",
        "FTextSearchHighlighter*"
      ]
    }
  ]
}