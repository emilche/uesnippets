  "functions": [
    {
      "id": "get-processor-execution-flags-for-world",
      "name": "GetProcessorExecutionFlagsForWorld",
      "category": "MassEntityUtils",
      "signature": "GetProcessorExecutionFlagsForWorld(World)",
      "params": [
        {
          "name": "World",
          "type": "UWorld&"
        }
      ],
      "returnType": "EProcessorExecutionFlags",
      "docs": "returns the current execution mode for the processors calculated from the world network mode"
    },
    {
      "id": "determine-processor-execution-flags",
      "name": "DetermineProcessorExecutionFlags",
      "category": "MassEntityUtils",
      "signature": "DetermineProcessorExecutionFlags(World, Execution Flags Override)",
      "params": [
        {
          "name": "World",
          "type": "UWorld*"
        },
        {
          "name": "Execution Flags Override",
          "type": "EProcessorExecutionFlags",
          "default": "EProcessorExecutionFlags::None"
        }
      ],
      "returnType": "EProcessorExecutionFlags",
      "docs": "based on the given World (which can be null) and 'ExecutionFlagsOverride', the function determines the execution flags to use"
    },
    {
      "id": "create-entity-collections",
      "name": "CreateEntityCollections",
      "category": "MassEntityUtils",
      "signature": "CreateEntityCollections(Entity Manager, Entities, Duplicates Handling, Out Entity Collections)",
      "params": [
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        },
        {
          "name": "Entities",
          "type": "TConstArrayView<FMassEntityHandle>"
        },
        {
          "name": "Duplicates Handling",
          "type": "FMassArchetypeEntityCollection::EDuplicatesHandling"
        },
        {
          "name": "Out Entity Collections",
          "type": "TArray<FMassArchetypeEntityCollection>&"
        }
      ],
      "returnType": "Void",
      "docs": "Fills OutEntityCollections with per-archetype FMassArchetypeEntityCollection instances.\n@param DuplicatesHandling used to inform the function whether to expect duplicates."
    },
