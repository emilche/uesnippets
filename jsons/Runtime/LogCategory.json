{
  "id": "log-category",
  "label": "LogCategory",
  "includepath": "Logging/LogCategory.h",
  "includes": [
    "CoreTypes",
    "LogVerbosity",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "is-suppressed",
      "name": "IsSuppressed",
      "category": "LogCategory",
      "signature": "IsSuppressed(Target, Verbosity Level)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        },
        {
          "name": "Verbosity Level",
          "type": "ELogVerbosity::Type"
        }
      ],
      "returnType": "Bool",
      "docs": "Should not generally be used directly. Tests the runtime verbosity and maybe triggers a debug break, etc."
    },
    {
      "id": "post-trigger",
      "name": "PostTrigger",
      "category": "LogCategory",
      "signature": "PostTrigger(Target, Verbosity Level)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        },
        {
          "name": "Verbosity Level",
          "type": "ELogVerbosity::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Called just after a logging statement being allow to print. Checks a few things and maybe breaks into the debugger."
    },
    {
      "id": "get-category-name",
      "name": "GetCategoryName",
      "category": "LogCategory",
      "signature": "GetCategoryName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        }
      ],
      "returnType": "FLogCategoryName&"
    },
    {
      "id": "get-verbosity",
      "name": "GetVerbosity",
      "category": "LogCategory",
      "signature": "GetVerbosity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        }
      ],
      "returnType": "ELogVerbosity::Type",
      "docs": "Gets the working verbosity."
    },
    {
      "id": "set-verbosity",
      "name": "SetVerbosity",
      "category": "LogCategory",
      "signature": "SetVerbosity(Target, Verbosity)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        },
        {
          "name": "Verbosity",
          "type": "ELogVerbosity::Type"
        }
      ],
      "returnType": "Void",
      "docs": "Sets up the working verbosity and clamps to the compile time verbosity."
    },
    {
      "id": "get-compile-time-verbosity",
      "name": "GetCompileTimeVerbosity",
      "category": "LogCategory",
      "signature": "GetCompileTimeVerbosity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FLogCategoryBase*"
        }
      ],
      "returnType": "ELogVerbosity::Type",
      "docs": "Gets the compile time verbosity.",
      "supportedTargets": [
        "FLogCategoryBase*",
        "FLogCategory*"
      ]
    },
    {
      "id": "f-log-category",
      "name": "FLogCategory",
      "category": "LogCategory",
      "signature": "FLogCategory(Compile Time Verbosity)",
      "params": [
        {
          "name": "Compile Time Verbosity",
          "type": "FLogCategoryName& InCategoryName ) : FLogCategoryBase ( InCategoryName,InDefaultVerbosity,"
        }
      ],
      "returnType": "Void"
    }
  ]
}