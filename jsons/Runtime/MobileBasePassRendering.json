        },
        {
          "name": "Shader Bindings",
          "type": "FMeshDrawSingleShaderBindings&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "modify-compilation-environment",
      "name": "ModifyCompilationEnvironment",
