{
  "id": "rich-text-layout-marshaller",
  "label": "RichTextLayoutMarshaller",
  "includepath": "Framework/Text/RichTextLayoutMarshaller.h",
  "includes": [
    "CoreMinimal",
    "SlateGlobals",
    "TextLineHighlight",
    "IRun",
    "ITextDecorator",
    "BaseTextLayoutMarshaller"
  ],
  "functions": [
