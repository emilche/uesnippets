      "name": "Create",
      "category": "RichTextLayoutMarshaller",
      "signature": "Create(In Parser, In Writer, In Decorators, In Decorator Style Set)",
      "params": [
        {
          "name": "In Parser",
          "type": "TSharedPtr<IRichTextMarkupParser>"
        },
        {
          "name": "In Writer",
          "type": "TSharedPtr<IRichTextMarkupWriter>"
        },
        {
          "name": "In Decorators",
          "type": "TArray<TSharedRef<ITextDecorator>>"
        },
        {
          "name": "In Decorator Style Set",
          "type": "ISlateStyle*"
        }
      ],
      "returnType": "TSharedRef<FRichTextLayoutMarshaller>"
    },
    {
      "id": "set-text",
      "name": "SetText",
      "category": "RichTextLayoutMarshaller",
      "signature": "SetText(Target, Source String, Target Text Layout)",
      "params": [
        {
          "name": "Target",
          "type": "FRichTextLayoutMarshaller*"
        },
        {
          "name": "Source String",
          "type": "String&"
        },
        {
          "name": "Target Text Layout",
          "type": "FTextLayout&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-text",
      "name": "GetText",
      "category": "RichTextLayoutMarshaller",
      "signature": "GetText(Target, Target String, Source Text Layout)",
      "params": [
        {
          "name": "Target",
          "type": "FRichTextLayoutMarshaller*"
        },
        {
          "name": "Target String",
          "type": "String&"
        },
        {
          "name": "Source Text Layout",
          "type": "FTextLayout&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-font-size-multiplier",
      "name": "SetFontSizeMultiplier",
      "category": "RichTextLayoutMarshaller",
      "signature": "SetFontSizeMultiplier(Target, New Font Size Multiplier)",
      "params": [
        {
          "name": "Target",
          "type": "FRichTextLayoutMarshaller*"
        },
        {
          "name": "New Font Size Multiplier",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Set the Multiplier applied on the font size of the text"
    }
  ]
}