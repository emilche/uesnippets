{
  "id": "generic-input-device-map",
  "label": "GenericInputDeviceMap",
  "includepath": "GenericPlatform/GenericInputDeviceMap.h",
  "includes": [
    "Map",
    "GenericPlatformInputDeviceMapper",
    "CoreMiscDefines"
  ],
  "functions": [
    {
      "id": "get-or-create-device-id",
      "name": "GetOrCreateDeviceId",
      "category": "GenericInputDeviceMap",
      "signature": "GetOrCreateDeviceId(Target, Device Key)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Key",
          "type": "TDeviceKeyType&"
        }
      ],
      "returnType": "nodiscard ] ] FInputDeviceId",
      "docs": "Given the DeviceKey, find it's associated FInputDeviceId.\nIf one does not exist yet, such as for a newly connected device,\nthen create one from the IPlatformInputDeviceMapper."
    },
    {
      "id": "map-default-input-device",
      "name": "MapDefaultInputDevice",
      "category": "GenericInputDeviceMap",
      "signature": "MapDefaultInputDevice(Target, Device Key)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Key",
          "type": "TDeviceKeyType&"
        }
      ],
      "returnType": "nodiscard ] ] FInputDeviceId",
      "docs": "Maps a DeviceKey to the default FInputDeviceId which has the internal value 0.\nReturns the default FInputDeviceId for straightforward use."
    },
    {
      "id": "find-device-id",
      "name": "FindDeviceId",
      "category": "GenericInputDeviceMap",
      "signature": "FindDeviceId(Target, Device Key)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Key",
          "type": "TDeviceKeyType&"
        }
      ],
      "returnType": "nodiscard ] ] FInputDeviceId",
      "docs": "Returns the FInputDeviceId for the given device key.\nReturns FInputDeviceId::Invalid if it is not yet mapped."
    },
    {
      "id": "find-device-id-checked",
      "name": "FindDeviceIdChecked",
      "category": "GenericInputDeviceMap",
      "signature": "FindDeviceIdChecked(Target, Device Key)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Key",
          "type": "TDeviceKeyType&"
        }
      ],
      "returnType": "nodiscard ] ] FInputDeviceId",
      "docs": "Returns the FInputDeviceId associated with the given device key. Asserts if not found."
    },
    {
      "id": "get-device-key-checked",
      "name": "GetDeviceKeyChecked",
      "category": "GenericInputDeviceMap",
      "signature": "GetDeviceKeyChecked(Target, Device Id)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Id",
          "type": "FInputDeviceId"
        }
      ],
      "returnType": "nodiscard ] ] TDeviceKeyType&",
      "docs": "Returns the device key for the given FInputDeviceId. Nullptr if not found."
    },
    {
      "id": "find-device-key",
      "name": "FindDeviceKey",
      "category": "GenericInputDeviceMap",
      "signature": "FindDeviceKey(Target, Device Id)",
      "params": [
        {
          "name": "Target",
          "type": "TInputDeviceMap*"
        },
        {
          "name": "Device Id",
          "type": "FInputDeviceId"
        }
      ],
      "returnType": "nodiscard ] ] TDeviceKeyType*",
      "docs": "Returns the device key for the given FInputDeviceId. Nullptr if not found."
    }
  ]
}