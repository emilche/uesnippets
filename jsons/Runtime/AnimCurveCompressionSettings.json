        {
          "name": "Target",
          "type": "UAnimCurveCompressionSettings*"
        },
        {
          "name": "Path",
          "type": "String&"
        }
      ],
      "returnType": "UAnimCurveCompressionCodec*",
      "docs": "Allow us to convert DDC serialized path back into codec object"
    },
    {
      "id": "get-preload-dependencies",
      "name": "GetPreloadDependencies",
      "category": "AnimCurveCompressionSettings",
      "signature": "GetPreloadDependencies(Target, Out Deps)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimCurveCompressionSettings*"
        },
        {
          "name": "Out Deps",
          "type": "TArray<UObject*>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "are-settings-valid",
      "name": "AreSettingsValid",
      "category": "AnimCurveCompressionSettings",
      "signature": "AreSettingsValid(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimCurveCompressionSettings*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether or not we can use these settings to compress."
    },
    {
      "id": "compress",
      "name": "Compress",
      "category": "AnimCurveCompressionSettings",
      "signature": "Compress(Target, Anim Seq, Out Compressed Data)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimCurveCompressionSettings*"
        },
        {
          "name": "Anim Seq",
          "type": "FCompressibleAnimData&"
        },
        {
          "name": "Out Compressed Data",
          "type": "FCompressedAnimSequence&"
        }
      ],
      "returnType": "Bool",
      "docs": "Compresses the animation curves inside the supplied sequence data.\nThe resultant compressed data is applied to the OutCompressedData structure."
    },
    {
      "id": "populate-ddc-key",
      "name": "PopulateDDCKey",
      "category": "AnimCurveCompressionSettings",
      "signature": "PopulateDDCKey(Target, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "UAnimCurveCompressionSettings*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Generates a DDC key that takes into account the current settings and selected codec."
    }
