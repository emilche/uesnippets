    {
      "id": "f-quartz-clock-cd3cb7",
      "name": "FQuartzClock",
      "category": "AudioMixerClock",
      "signature": "FQuartzClock(In Name, In Clock Settings, In Owning Clock Manager Ptr)",
      "params": [
        {
          "name": "In Name",
          "type": "Name&"
        },
        {
          "name": "In Clock Settings",
          "type": "FQuartzClockSettings&"
        },
        {
          "name": "In Owning Clock Manager Ptr",
          "type": "FQuartzClockManager*",
          "default": "nullptr"
        }
      ],
      "returnType": "public :",
      "docs": "FQuartzClock:\nThis class receives, schedules, and fires quantized commands.\nThe underlying FQuartzMetronome handles all counting / timing logic.\nThis class gets ticked externally (i.e. by some Clock Manager)\nand counts down the time-to-fire the commands in audio frames.\nUpdateCachedState() updates a game-thread copy of data accessed via FQuartzClockProxy\n(see FQuartzClockState)"
    },
