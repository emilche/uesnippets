{
  "id": "legacy-ixr-input",
  "label": "LegacyIXRInput",
  "includepath": "LegacyIXRInput.h",
  "includes": [
    "CoreMinimal",
    "HeadMountedDisplayTypes",
    "InputCoreTypes",
    "EngineBaseTypes"
  ],
  "functions": [
    {
      "id": "handle-input-touch",
      "name": "HandleInputTouch",
      "category": "LegacyIXRInput",
      "signature": "HandleInputTouch(Target, Handle, Type, Touch Location, Device Timestamp, Touchpad Index)",
      "params": [
        {
          "name": "Target",
          "type": "FKey*"
        },
        {
          "name": "Handle",
          "type": "UInt"
        },
        {
          "name": "Type",
          "type": "ETouchType::Type"
        },
        {
          "name": "Touch Location",
          "type": "FVector2D&"
        },
        {
          "name": "Device Timestamp",
          "type": "FDateTime"
        },
        {
          "name": "Touchpad Index",
          "type": "UInt"
        }
      ],
      "returnType": "Bool",
      "docs": "Passing touch events to HMD.\nIf returns 'false' then touch will be handled by PlayerController;\notherwise, touch won't be handled by the PlayerController."
    }
  ]
}