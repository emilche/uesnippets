      "name": "AccessProducerBuffer",
      "category": "MultiBufferResource",
      "signature": "AccessProducerBuffer(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleBuffer*"
        }
      ],
      "returnType": "ResourceType*",
      "docs": "Get the current producer buffer for writing.\nThe returned pointer will never be null.\nThis function should only be called by the producer thread.",
      "supportedTargets": [
        "FSingleBuffer*",
        "FDoubleBuffer*",
        "FTripleBuffer*",
        "FGuardedTripleBuffer*"
      ]
    },
    {
      "id": "get-consumer-buffer-mutable",
      "name": "GetConsumerBufferMutable",
      "category": "MultiBufferResource",
      "signature": "GetConsumerBufferMutable(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleBuffer*"
        }
      ],
      "returnType": "ResourceType*",
      "supportedTargets": [
        "FSingleBuffer*",
        "FDoubleBuffer*",
        "FTripleBuffer*",
        "FGuardedTripleBuffer*"
      ]
    },
    {
      "id": "get-producer-buffer",
      "name": "GetProducerBuffer",
      "category": "MultiBufferResource",
      "signature": "GetProducerBuffer(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleBuffer*"
        }
      ],
      "returnType": "ResourceType*",
      "docs": "Get the current producer buffer.\nThe returned pointer will never be null.\nThis function should only be called by the producer thread.",
      "supportedTargets": [
        "FSingleBuffer*",
        "FDoubleBuffer*",
        "FTripleBuffer*",
        "FGuardedTripleBuffer*"
      ]
    },
    {
      "id": "get-consumer-buffer",
      "name": "GetConsumerBuffer",
      "category": "MultiBufferResource",
      "signature": "GetConsumerBuffer(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleBuffer*"
        }
      ],
      "returnType": "ResourceType*",
      "docs": "Get an updated buffer for the consuming thread to read from.\nThe returned pointer may be null if the producer thread hasn't done\nan update since the last time this function was called.\nThis function should only be called by the consumer thread.",
      "supportedTargets": [
        "FSingleBuffer*",
        "FDoubleBuffer*",
        "FTripleBuffer*",
        "FGuardedTripleBuffer*"
      ]
    },
    {
      "id": "flip-producer",
      "name": "FlipProducer",
      "category": "MultiBufferResource",
      "signature": "FlipProducer(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleBuffer*"
        }
      ],
      "returnType": "Void",
      "docs": "Make the current producer buffer available to the consumer thread.\nThis function should only be called by the producer thread.",
      "supportedTargets": [
        "FSingleBuffer*",
        "FDoubleBuffer*",
        "FTripleBuffer*",
        "FGuardedTripleBuffer*"
      ]
    },
    {
      "id": "peek-consumer-buffer",
      "name": "PeekConsumerBuffer",
      "category": "MultiBufferResource",
      "signature": "PeekConsumerBuffer(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FGuardedTripleBuffer*"
        }
      ],
      "returnType": "ResourceType*",
      "docs": "Get access to the currently held consumer buffer, ignoring whether\nit's already been consumed."
    }
  ]
