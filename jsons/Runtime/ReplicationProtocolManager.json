{
  "id": "replication-protocol-manager",
  "label": "ReplicationProtocolManager",
  "includepath": "ReplicationProtocolManager.h",
  "includes": [
    "CoreTypes",
    "Map",
    "ReplicationStateDescriptor",
    "ReplicationFragment",
    "ReplicationProtocol"
  ],
  "functions": [
    {
      "id": "create-replication-protocol",
      "name": "CreateReplicationProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "CreateReplicationProtocol(Target, Protocol Id, Fragments, Debug Name, Params)",
      "params": [
        {
          "name": "Target",
          "type": "FReplicationProtocolManager*"
        },
        {
          "name": "Protocol Id",
          "type": "FReplicationProtocolIdentifier"
        },
        {
          "name": "Fragments",
          "type": "FReplicationFragments&"
        },
        {
          "name": "Debug Name",
          "type": "TCHAR*"
        },
        {
          "name": "Params",
          "type": "FCreateReplicationProtocolParameters&",
          "default": "FCreateReplicationProtocolParameters()"
        }
      ],
      "returnType": "FReplicationProtocol*",
      "docs": "Create protocol from registered fragment data with provided Id, verification is optional"
    },
    {
      "id": "get-replication-protocol",
      "name": "GetReplicationProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "GetReplicationProtocol(Target, Protocol Id, Archetype Or CDO Used As Key)",
      "params": [
        {
          "name": "Target",
          "type": "FReplicationProtocolManager*"
        },
        {
          "name": "Protocol Id",
          "type": "FReplicationProtocolIdentifier"
        },
        {
          "name": "Archetype Or CDO Used As Key",
          "type": "UObject*",
          "default": "nullptr"
        }
      ],
      "returnType": "FReplicationProtocol*",
      "docs": "Get an existing replication protocol"
    },
    {
      "id": "destroy-replication-protocol",
      "name": "DestroyReplicationProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "DestroyReplicationProtocol(Target, Replication Protocol)",
      "params": [
        {
          "name": "Target",
          "type": "FReplicationProtocolManager*"
        },
        {
          "name": "Replication Protocol",
          "type": "FReplicationProtocol*"
        }
      ],
      "returnType": "Void",
      "docs": "Destroy existing replication protocol"
    },
    {
      "id": "create-instance-protocol",
      "name": "CreateInstanceProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "CreateInstanceProtocol(Fragments, Object Traits)",
      "params": [
        {
          "name": "Fragments",
          "type": "FReplicationFragments&"
        },
        {
          "name": "Object Traits",
          "type": "UE::Net::EReplicationFragmentTraits"
        }
      ],
      "returnType": "FReplicationInstanceProtocol*",
      "docs": "Create instance protocol from registered fragment data\nLifetime either the same as the lifetime of a remotely created instance (we are the client) or controlled by\tcalls to the bridge api to replicate an object or not\n@param ObjectTraits Traits that are passed by the object instance itself"
    },
    {
      "id": "destroy-instance-protocol",
      "name": "DestroyInstanceProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "DestroyInstanceProtocol()",
      "params": [],
      "returnType": "Void"
    },
    {
      "id": "invalidate-descriptor",
      "name": "InvalidateDescriptor",
      "category": "ReplicationProtocolManager",
      "signature": "InvalidateDescriptor(Target, Invalidated Replication State Descriptor)",
      "params": [
        {
          "name": "Target",
          "type": "FReplicationProtocolManager*"
        },
        {
          "name": "Invalidated Replication State Descriptor",
          "type": "FReplicationStateDescriptor*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "calculate-protocol-identifier",
      "name": "CalculateProtocolIdentifier",
      "category": "ReplicationProtocolManager",
      "signature": "CalculateProtocolIdentifier(Fragments)",
      "params": [
        {
          "name": "Fragments",
          "type": "FReplicationFragments&"
        }
      ],
      "returnType": "FReplicationProtocolIdentifier",
      "docs": "Calculate protocol Identifier from registered fragment data"
    },
    {
      "id": "validate-replication-protocol",
      "name": "ValidateReplicationProtocol",
      "category": "ReplicationProtocolManager",
      "signature": "ValidateReplicationProtocol(Fragments, Log Fragment Errors)",
      "params": [
        {
          "name": "Fragments",
          "type": "FReplicationFragments&"
        },
        {
          "name": "Log Fragment Errors",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Validate that a existing protocol matches the FragmentList of an instance, returns true of it is a match"
    },
    {
      "id": "fragment-list-to-string",
      "name": "FragmentListToString",
      "category": "ReplicationProtocolManager",
      "signature": "FragmentListToString(String Builder, Fragments)",
      "params": [
        {
          "name": "String Builder",
          "type": "FStringBuilderBase&"
        },
        {
          "name": "Fragments",
          "type": "FReplicationFragments&"
        }
      ],
      "returnType": "Void",
      "docs": "Print the names of the fragments and their hash"
    }
  ]
}