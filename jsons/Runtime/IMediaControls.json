    {
      "id": "seek-9a61c2",
      "name": "Seek",
      "category": "IMediaControls",
      "signature": "Seek(Target, In New Time, In Additional Params)",
      "params": [
        {
          "name": "Target",
          "type": "IMediaControls*"
        },
        {
          "name": "In New Time",
          "type": "FTimespan&"
        },
        {
          "name": "In Additional Params",
          "type": "FMediaSeekParams&"
        }
      ],
      "returnType": "Bool",
      "docs": "Same as Seek(), but with additional options.\nThis default implementation just calls Seek() and ignores options."
    },
    {
      "id": "pause",
      "name": "Pause",
      "category": "IMediaControls",
      "signature": "Pause(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMediaControls*"
        }
      ],
      "returnType": "Bool",
      "docs": "Pause media playback.\nThis is the same as setting the playback rate to 0.0.\n@return true if the media is being paused, false otherwise.\n@see Play, Stop"
    },
    {
      "id": "play",
      "name": "Play",
      "category": "IMediaControls",
      "signature": "Play(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMediaControls*"
        }
      ],
      "returnType": "Bool",
      "docs": "Start media playback at the default rate of 1.0.\nThis is the same as setting the playback rate to 1.0.\n@return true if playback is starting, false otherwise.\n@see Pause, Stop"
    },
    {
