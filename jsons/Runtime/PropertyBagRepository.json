    {
      "id": "create-property-bag-placeholder-type",
      "name": "CreatePropertyBagPlaceholderType",
      "category": "PropertyBagRepository",
      "signature": "CreatePropertyBagPlaceholderType(Outer, Class, Name, Flags, Super Struct)",
      "params": [
        {
          "name": "Outer",
          "type": "UObject*"
        },
        {
          "name": "Class",
          "type": "UClass*"
        },
        {
          "name": "Name",
          "type": "Name",
          "default": "NAME_None"
        },
        {
          "name": "Flags",
          "type": "EObjectFlags",
          "default": "RF_NoFlags"
        },
        {
          "name": "Super Struct",
          "type": "UStruct*",
          "default": "nullptr"
        }
      ],
      "returnType": "UStruct*",
      "docs": "Create a new placeholder type object to swap in for a missing class/struct. An object of\nthis type will be associated with a property bag when serialized so it doesn't lose data.\n@param Outer\t\t\tScope at which to create the placeholder type object (e.g. UPackage).\n@param Class\t\t\tType object class (or derivative type). For example, UClass::StaticClass().\n@param Name\t\t\tOptional object name. If not specified, a unique object name will be created.\n@param Flags\t\t\tAdditional object flags. These will be appended to the default set of type object flags.\n(Note: All placeholder types are transient by definition and internally default to 'RF_Transient'.)\n@param SuperStruct\tOptional super type. By default, placeholder types are derivatives of UObject (NULL implies default).\n@return A reference to a new placeholder type object."
    }
  ]
