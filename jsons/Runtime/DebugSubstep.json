    {
      "id": "add-681502",
      "name": "Add",
      "category": "DebugSubstep",
      "signature": "Add(Target, Label)",
      "params": [
        {
          "name": "Target",
          "type": "FDebugSubstep*"
        },
        {
          "name": "Label",
          "type": "TCHAR*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Add a new potential pause point where the debug solver thread can wait until the next step/substep command.\n@param Label The reference (if any) that will be used in verbose logs when this point is reached, or nullptr otherwise.\nOnly call from the solver thread.\nIt will fail if called from inside a parallel for loop, or any other thread."
