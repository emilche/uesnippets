{
  "id": "physics-filtering",
  "label": "PhysicsFiltering",
  "includepath": "Physics/PhysicsFiltering.h",
  "includes": [
    "CoreMinimal",
    "EngineDefines",
    "PhysicsPublic",
    "PhysicsInterfaceTypes",
    "ChaosEngineInterface"
  ],
  "functions": [
    {
      "id": "conditional-set-flags",
      "name": "ConditionalSetFlags",
      "category": "PhysicsFiltering",
      "signature": "ConditionalSetFlags(Target, Flag, Enabled)",
      "params": [
        {
          "name": "Target",
          "type": "FPhysicsFilterBuilder*"
        },
        {
          "name": "Flag",
          "type": "EPhysXFilterDataFlags"
        },
        {
          "name": "Enabled",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-query-data",
      "name": "GetQueryData",
      "category": "PhysicsFiltering",
      "signature": "GetQueryData(Target, Source Object ID, Out Word 0, Out Word 1, Out Word 2, Out Word 3)",
      "params": [
        {
          "name": "Target",
          "type": "FPhysicsFilterBuilder*"
        },
        {
          "name": "Source Object ID",
          "type": "UInt"
        },
        {
          "name": "Out Word 0",
          "type": "UInt&"
        },
        {
          "name": "Out Word 1",
          "type": "UInt&"
        },
        {
          "name": "Out Word 2",
          "type": "UInt&"
        },
        {
          "name": "Out Word 3",
          "type": "UInt&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-sim-data",
      "name": "GetSimData",
      "category": "PhysicsFiltering",
      "signature": "GetSimData(Target, Body Index, Component ID, Out Word 0, Out Word 1, Out Word 2, Out Word 3)",
      "params": [
        {
          "name": "Target",
          "type": "FPhysicsFilterBuilder*"
        },
        {
          "name": "Body Index",
          "type": "UInt"
        },
        {
          "name": "Component ID",
          "type": "UInt"
        },
        {
          "name": "Out Word 0",
          "type": "UInt&"
        },
        {
          "name": "Out Word 1",
          "type": "UInt&"
        },
        {
          "name": "Out Word 2",
          "type": "UInt&"
        },
        {
          "name": "Out Word 3",
          "type": "UInt&"
        }
      ],
      "returnType": "Void",
      "docs": "Format for QueryData :\nword0 (object ID)\nword1 (blocking channels)\nword2 (touching channels)\nword3 (ExtraFilter (top NumExtraFilterBits) + MyChannel (next NumCollisionChannelBits) as ECollisionChannel + Flags (remaining NumFilterDataFlagBits)"
    },
    {
      "id": "get-combined-data",
      "name": "GetCombinedData",
      "category": "PhysicsFiltering",
      "signature": "GetCombinedData(Target, Out Blocking Bits, Out Touching Bits, Out Object Type And Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FPhysicsFilterBuilder*"
        },
        {
          "name": "Out Blocking Bits",
          "type": "UInt&"
        },
        {
          "name": "Out Touching Bits",
          "type": "UInt&"
        },
        {
          "name": "Out Object Type And Flags",
          "type": "UInt&"
        }
      ],
      "returnType": "Void",
      "docs": "Format for SimData :\nword0 (body index)\nword1 (blocking channels)\nword2 (skeletal mesh component ID)\nword3 (ExtraFilter (top NumExtraFilterBits) + MyChannel (next NumCollisionChannelBits) as ECollisionChannel + Flags (remaining NumFilterDataFlagBits)"
    },
    {
      "id": "create-shape-filter-data",
      "name": "CreateShapeFilterData",
      "category": "PhysicsFiltering",
      "signature": "CreateShapeFilterData(My Channel, Mask Filter, Source Object ID, Response To Channels, Component ID, Body Index, Out Query Data, Out Sim Data, Enable CCD, Enable Contact Notify, Static Shape, Modify Contacts)",
      "params": [
        {
          "name": "My Channel",
          "type": "Byte"
        },
        {
          "name": "Mask Filter",
          "type": "FMaskFilter"
        },
        {
          "name": "Source Object ID",
          "type": "Int"
        },
        {
          "name": "Response To Channels",
          "type": "FCollisionResponseContainer&"
        },
        {
          "name": "Component ID",
          "type": "UInt"
        },
        {
          "name": "Body Index",
          "type": "UInt16"
        },
        {
          "name": "Out Query Data",
          "type": "FCollisionFilterData&"
        },
        {
          "name": "Out Sim Data",
          "type": "FCollisionFilterData&"
        },
        {
          "name": "Enable CCD",
          "type": "Bool"
        },
        {
          "name": "Enable Contact Notify",
          "type": "Bool"
        },
        {
          "name": "Static Shape",
          "type": "Bool"
        },
        {
          "name": "Modify Contacts",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Utility for creating a FCollisionFilterData for filtering query (trace) and sim (physics) from the Unreal filtering info."
    },
    {
      "id": "get-collision-channel",
      "name": "GetCollisionChannel",
      "category": "PhysicsFiltering",
      "signature": "GetCollisionChannel(Word 3)",
      "params": [
        {
          "name": "Word 3",
          "type": "UInt"
        }
      ],
      "returnType": "ECollisionChannel"
    },
    {
      "id": "get-collision-channel-and-extra-filter",
      "name": "GetCollisionChannelAndExtraFilter",
      "category": "PhysicsFiltering",
      "signature": "GetCollisionChannelAndExtraFilter(Word 3, Out Mask Filter)",
      "params": [
        {
          "name": "Word 3",
          "type": "UInt"
        },
        {
          "name": "Out Mask Filter",
          "type": "FMaskFilter&"
        }
      ],
      "returnType": "ECollisionChannel"
    },
    {
      "id": "create-channel-and-filter",
      "name": "CreateChannelAndFilter",
      "category": "PhysicsFiltering",
      "signature": "CreateChannelAndFilter(Collision Channel, Mask Filter)",
      "params": [
        {
          "name": "Collision Channel",
          "type": "ECollisionChannel"
        },
        {
          "name": "Mask Filter",
          "type": "FMaskFilter"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "update-mask-filter",
      "name": "UpdateMaskFilter",
      "category": "PhysicsFiltering",
      "signature": "UpdateMaskFilter(Word 3, New Mask Filter)",
      "params": [
        {
          "name": "Word 3",
          "type": "UInt&"
        },
        {
          "name": "New Mask Filter",
          "type": "FMaskFilter"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "extract-sim-collision-response-container",
      "name": "ExtractSimCollisionResponseContainer",
      "category": "PhysicsFiltering",
      "signature": "ExtractSimCollisionResponseContainer(In Sim Filter Data)",
      "params": [
        {
          "name": "In Sim Filter Data",
          "type": "FCollisionFilterData&"
        }
      ],
      "returnType": "FCollisionResponseContainer"
    },
    {
      "id": "extract-query-collision-response-container",
      "name": "ExtractQueryCollisionResponseContainer",
      "category": "PhysicsFiltering",
      "signature": "ExtractQueryCollisionResponseContainer(In Query Filter Data)",
      "params": [
        {
          "name": "In Query Filter Data",
          "type": "FCollisionFilterData&"
        }
      ],
      "returnType": "FCollisionResponseContainer"
    }
  ]
}