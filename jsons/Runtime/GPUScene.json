  "functions": [
    {
      "id": "add-primitive-to-update",
      "name": "AddPrimitiveToUpdate",
      "category": "GPUScene",
      "signature": "AddPrimitiveToUpdate(Target, Persistent Primitive Index, Dirty State)",
      "params": [
        {
          "name": "Target",
          "type": "FGPUScene*"
        },
        {
          "name": "Persistent Primitive Index",
          "type": "FPersistentPrimitiveIndex"
        },
        {
          "name": "Dirty State",
          "type": "EPrimitiveDirtyState",
          "default": "EPrimitiveDirtyState::ChangedAll"
        }
      ],
      "returnType": "Void",
      "docs": "Queue the given primitive for upload to GPU at next call to Update.\nMay be called multiple times, dirty-flags are cumulative."
    }
  ]
