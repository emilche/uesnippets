{
  "id": "i-input-interface",
  "label": "IInputInterface",
  "includepath": "GenericPlatform/IInputInterface.h",
  "includes": [
    "CoreTypes",
    "Array",
    "Color",
    "NameTypes"
  ],
  "functions": [
    {
      "id": "needs-update",
      "name": "NeedsUpdate",
      "category": "IInputInterface",
      "signature": "NeedsUpdate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FHapticFeedbackBuffer*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "property-name",
      "name": "PropertyName",
      "category": "IInputInterface",
      "signature": "PropertyName()",
      "params": [],
      "returnType": "Name"
    },
    {
      "id": "set-haptic-feedback-values",
      "name": "SetHapticFeedbackValues",
      "category": "IInputInterface",
      "signature": "SetHapticFeedbackValues(Target, Controller Id, Hand, Values)",
      "params": [
        {
          "name": "Target",
          "type": "IInputInterface*"
        },
        {
          "name": "Controller Id",
          "type": "Int"
        },
        {
          "name": "Hand",
          "type": "Int"
        },
        {
          "name": "Values",
          "type": "FHapticFeedbackValues&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the frequency and amplitude of haptic feedback channels for a given controller id.\nSome devices / platforms may support just haptics, or just force feedback.\n@param ControllerId\tID of the controller to issue haptic feedback for\n@param HandId\t\t\tWhich hand id (e.g. left or right) to issue the feedback for.  These usually correspond to EControllerHands\n@param Values\t\t\tFrequency and amplitude to haptics at"
    },
    {
      "id": "set-device-property",
      "name": "SetDeviceProperty",
      "category": "IInputInterface",
      "signature": "SetDeviceProperty(Target, Controller Id, Property)",
      "params": [
        {
          "name": "Target",
          "type": "IInputInterface*"
        },
        {
          "name": "Controller Id",
          "type": "Int"
        },
        {
          "name": "Property",
          "type": "FInputDeviceProperty*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets a property for a given controller id.\nWill be ignored for devices which don't support the property.\n@param ControllerId the id of the controller whose property is to be applied\n@param Property Base class pointer to property that will be applied"
    }
  ]
}