      "id": "create-2-d-desc",
      "name": "Create2DDesc",
      "category": "RendererInterface",
      "signature": "Create2DDesc(In Extent, In Format, In Clear Value, In Flags, In Targetable Flags, In Force Separate Target And Shader Resource, In Num Mips, In Autowritable, In Create RT Write Mask, In Create Fmask)",
      "params": [
        {
          "name": "In Extent",
          "type": "FIntPoint"
        },
        {
          "name": "In Format",
          "type": "EPixelFormat"
        },
        {
          "name": "In Clear Value",
          "type": "FClearValueBinding&"
        },
        {
          "name": "In Flags",
          "type": "ETextureCreateFlags"
        },
        {
          "name": "In Targetable Flags",
          "type": "ETextureCreateFlags"
        },
        {
          "name": "In Force Separate Target And Shader Resource",
          "type": "Bool"
        },
        {
          "name": "In Num Mips",
          "type": "Byte",
          "default": "1"
        },
        {
          "name": "In Autowritable",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "In Create RT Write Mask",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Create Fmask",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "FPooledRenderTargetDesc",
      "docs": "Factory function to create 2D texture description\n@param InFlags bit mask combined from elements of ETextureCreateFlags e.g. TexCreate_UAV"
    },
