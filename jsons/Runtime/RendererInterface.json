{
  "id": "renderer-interface",
  "label": "RendererInterface",
  "includepath": "RendererInterface.h",
  "includes": [
    "CoreMinimal",
    "RefCounting",
    "MemStack",
    "ModuleInterface",
    "RHI",
    "RenderResource",
    "RenderUtils",
    "EnumClassFlags",
    "UniformBuffer",
    "VirtualTexturing",
    "RenderGraphDefinitions",
    "PathTracingOutputInvalidateReason"
  ],
  "functions": [
    {
      "id": "create-render-target",
      "name": "CreateRenderTarget",
      "category": "RendererInterface",
      "signature": "CreateRenderTarget(Texture, Name)",
      "params": [
        {
          "name": "Texture",
          "type": "FRHITexture*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "TRefCountPtr<IPooledRenderTarget>",
      "docs": "The internal references to the created render target"
    },
    {
      "id": "cache-render-target",
      "name": "CacheRenderTarget",
      "category": "RendererInterface",
      "signature": "CacheRenderTarget(Texture, Name, Out Pooled Render Target)",
      "params": [
        {
          "name": "Texture",
          "type": "FRHITexture*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Out Pooled Render Target",
          "type": "TRefCountPtr<IPooledRenderTarget>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Creates an untracked pooled render target from the RHI texture, but only if the pooled render target is\nempty or doesn't match the input texture. If the pointer already exists and points at the input texture,\nthe function just returns. Useful to cache a pooled render target for an RHI texture. Returns true if the\nrender target was created, or false if it was reused."
    },
    {
      "id": "allocate-virtual-texture",
      "name": "AllocateVirtualTexture",
      "category": "RendererInterface",
      "signature": "AllocateVirtualTexture(Target, Desc)",
      "params": [
        {
          "name": "Target",
          "type": "IRendererModule*"
        },
        {
          "name": "Desc",
          "type": "FAllocatedVTDescription&"
        }
      ],
      "returnType": "IAllocatedVirtualTexture*"
    },
    {
      "id": "allocate-adaptive-virtual-texture",
      "name": "AllocateAdaptiveVirtualTexture",
      "category": "RendererInterface",
      "signature": "AllocateAdaptiveVirtualTexture(Target, Adaptive VT Desc, Allocated VT Desc)",
      "params": [
        {
          "name": "Target",
          "type": "IRendererModule*"
        },
        {
          "name": "Adaptive VT Desc",
          "type": "FAdaptiveVTDescription&"
        },
        {
          "name": "Allocated VT Desc",
          "type": "FAllocatedVTDescription&"
        }
      ],
      "returnType": "IAdaptiveVirtualTexture*"
    },
    {
      "id": "register-virtual-texture-producer",
      "name": "RegisterVirtualTextureProducer",
      "category": "RendererInterface",
      "signature": "RegisterVirtualTextureProducer(Target, Desc, Producer)",
      "params": [
        {
          "name": "Target",
          "type": "IRendererModule*"
        },
        {
          "name": "Desc",
          "type": "FVTProducerDescription&"
        },
        {
          "name": "Producer",
          "type": "IVirtualTexture*"
        }
      ],
      "returnType": "FVirtualTextureProducerHandle"
    }
  ]
