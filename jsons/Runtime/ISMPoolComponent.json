{
  "id": "ism-pool-component",
  "label": "ISMPoolComponent",
  "includepath": "ISMPool/ISMPoolComponent.h",
  "includes": [
    "SceneComponent",
    "Map",
    "InstancedStaticMeshDelegates",
    "MaterialInterface",
    "InstanceDataTypes",
    "ISMPoolComponent.generated"
  ],
  "functions": [
    {
      "id": "tick-component",
      "name": "TickComponent",
      "category": "ISMPoolComponent",
      "signature": "TickComponent(Target, Delta Time, Tick Type, This Tick Function)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Tick Type",
          "type": "ELevelTick"
        },
        {
          "name": "This Tick Function",
          "type": "FActorComponentTickFunction*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-resource-size-ex",
      "name": "GetResourceSizeEx",
      "category": "ISMPoolComponent",
      "signature": "GetResourceSizeEx(Target, Cumulative Resource Size)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Cumulative Resource Size",
          "type": "FResourceSizeEx&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-mesh-group",
      "name": "CreateMeshGroup",
      "category": "ISMPoolComponent",
      "signature": "CreateMeshGroup(Target, Allow Per Instance Removal)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Allow Per Instance Removal",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "FMeshGroupId",
      "docs": "Create an Mesh group which represent an arbitrary set of mesh with their instance\nno resources are created until the meshes are added for this group\nreturn a mesh group Id used to add and update instances"
    },
    {
      "id": "destroy-mesh-group",
      "name": "DestroyMeshGroup",
      "category": "ISMPoolComponent",
      "signature": "DestroyMeshGroup(Target, Mesh Group Id)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Mesh Group Id",
          "type": "FMeshGroupId"
        }
      ],
      "returnType": "Void",
      "docs": "Destroy  a mesh group and its associated resources"
    },
    {
      "id": "add-mesh-to-group",
      "name": "AddMeshToGroup",
      "category": "ISMPoolComponent",
      "signature": "AddMeshToGroup(Target, Mesh Group Id, Mesh Instance, Instance Count, Custom Data Floats)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Mesh Group Id",
          "type": "FMeshGroupId"
        },
        {
          "name": "Mesh Instance",
          "type": "FISMPoolStaticMeshInstance&"
        },
        {
          "name": "Instance Count",
          "type": "Int"
        },
        {
          "name": "Custom Data Floats",
          "type": "TArrayView<float>"
        }
      ],
      "returnType": "FMeshId",
      "docs": "Add a static mesh for a mesh group"
    },
    {
      "id": "batch-update-instances-transforms",
      "name": "BatchUpdateInstancesTransforms",
      "category": "ISMPoolComponent",
      "signature": "BatchUpdateInstancesTransforms(Target, Mesh Group Id, Mesh Id, Start Instance Index, New Instances Transforms, World Space, Mark Render State Dirty, Teleport)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Mesh Group Id",
          "type": "FMeshGroupId"
        },
        {
          "name": "Mesh Id",
          "type": "FMeshId"
        },
        {
          "name": "Start Instance Index",
          "type": "Int"
        },
        {
          "name": "New Instances Transforms",
          "type": "TArrayView<FTransform>"
        },
        {
          "name": "World Space",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Mark Render State Dirty",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Teleport",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Update transforms for a mesh group"
    },
    {
      "id": "batch-update-instance-custom-data",
      "name": "BatchUpdateInstanceCustomData",
      "category": "ISMPoolComponent",
      "signature": "BatchUpdateInstanceCustomData(Target, Mesh Group Id, Custom Float Index, Custom Float Value)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Mesh Group Id",
          "type": "FMeshGroupId"
        },
        {
          "name": "Custom Float Index",
          "type": "Int"
        },
        {
          "name": "Custom Float Value",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Update a single slot of custom instance data for all instances in a mesh group"
    },
    {
      "id": "preallocate-mesh-instance",
      "name": "PreallocateMeshInstance",
      "category": "ISMPoolComponent",
      "signature": "PreallocateMeshInstance(Target, Mesh Instance)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Mesh Instance",
          "type": "FISMPoolStaticMeshInstance&"
        }
      ],
      "returnType": "Void",
      "docs": "Preallocate an ISM in the pool.\nDoing this early for known mesh instance descriptions can reduce the component registration cost of AddMeshToGroup() for newly discovered mesh descriptions."
    },
    {
      "id": "set-tickable-pool-management",
      "name": "SetTickablePoolManagement",
      "category": "ISMPoolComponent",
      "signature": "SetTickablePoolManagement(Target, Enable Pool Management)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Enable Pool Management",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-override-transform-updates",
      "name": "SetOverrideTransformUpdates",
      "category": "ISMPoolComponent",
      "signature": "SetOverrideTransformUpdates(Target, Override Updates)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Override Updates",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "update-absolute-transforms",
      "name": "UpdateAbsoluteTransforms",
      "category": "ISMPoolComponent",
      "signature": "UpdateAbsoluteTransforms(Target, Base Transform, Update Transform Flags, Teleport)",
      "params": [
        {
          "name": "Target",
          "type": "UISMPoolComponent*"
        },
        {
          "name": "Base Transform",
          "type": "FTransform&"
        },
        {
          "name": "Update Transform Flags",
          "type": "EUpdateTransformFlags"
        },
        {
          "name": "Teleport",
          "type": "ETeleportType"
        }
      ],
      "returnType": "Void"
    }
  ]
}