    {
      "id": "initialize-de64e5",
      "name": "Initialize",
      "category": "CollectionEmbeddedSpringConstraintFacade",
      "signature": "Initialize(Target, End Points, In Spring Length, In Extension Stiffnes Weight, In Compression Stiffness Weight, In Damping Weight, In Constraint Name)",
      "params": [
        {
          "name": "Target",
          "type": "FEmbeddedSpringConstraintFacade*"
        },
        {
          "name": "End Points",
          "type": "TConstArrayView<FIntVector2>&"
        },
        {
          "name": "In Spring Length",
          "type": "TConstArrayView<float>&"
        },
        {
          "name": "In Extension Stiffnes Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Compression Stiffness Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Damping Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Constraint Name",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize from a list of Vertex-Vertex springs.\nSpring Indices are VerticesGroup indices.\nStiffness and Damping weights are expected have a value in [0.f, 1.f]. They will be set to constant 0.f if not supplied."
    },
    {
      "id": "append-abee47",
      "name": "Append",
      "category": "CollectionEmbeddedSpringConstraintFacade",
      "signature": "Append(Target, End Points, In Spring Length, In Extension Stiffnes Weight, In Compression Stiffness Weight, In Damping Weight)",
      "params": [
        {
          "name": "Target",
          "type": "FEmbeddedSpringConstraintFacade*"
        },
        {
          "name": "End Points",
          "type": "TConstArrayView<FIntVector2>&"
        },
        {
          "name": "In Spring Length",
          "type": "TConstArrayView<float>&"
        },
        {
          "name": "In Extension Stiffnes Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Compression Stiffness Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Damping Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        }
      ],
      "returnType": "Void",
      "docs": "Append from a list of Vertex-Vertex springs. Only succeeds if existing EndPointNumIndices == (1,1)\nSpring Indices are VerticesGroup indices.\nStiffness and Damping weights are expected have a value in [0.f, 1.f]. They will be set to constant 0.f if not supplied."
    },
    {
      "id": "initialize-f9d396",
      "name": "Initialize",
      "category": "CollectionEmbeddedSpringConstraintFacade",
      "signature": "Initialize(Target, End Point Num Indices, In Source Indices, In Source Weights, In Target Indices, In Target Weights, In Spring Length, In Extension Stiffnes Weight, In Compression Stiffness Weight, In Damping Weight, In Constraint Name)",
      "params": [
        {
          "name": "Target",
          "type": "FEmbeddedSpringConstraintFacade*"
        },
        {
          "name": "End Point Num Indices",
          "type": "FUintVector2&"
        },
        {
          "name": "In Source Indices",
          "type": "TConstArrayView<TArray<int32>>&"
        },
        {
          "name": "In Source Weights",
          "type": "TConstArrayView<TArray<float>>&"
        },
        {
          "name": "In Target Indices",
          "type": "TConstArrayView<TArray<int32>>&"
        },
        {
          "name": "In Target Weights",
          "type": "TConstArrayView<TArray<float>>&"
        },
        {
          "name": "In Spring Length",
          "type": "TConstArrayView<float>&"
        },
        {
          "name": "In Extension Stiffnes Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Compression Stiffness Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Damping Weight",
          "type": "TConstArrayView<float>&",
          "default": "TConstArrayView<float>()"
        },
        {
          "name": "In Constraint Name",
          "type": "String&",
          "default": "TEXT(\"\")"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize from a list of springs. This is generic for any number of end point indices. If you have vertex-vertex constraints, use the Initialize method above which skips setting weights.\nSource Indices and Weights arrays are expected to be exactly EndPointNumIndices[0] long.\nTarget Indices and Weights arrays are expected to be exactly EndPointNumIndices[1] long.\nIndices and Weights will be truncated or filled in with zeros if they aren't the expected length.\nSpring Indices are VerticesGroup indices.\nStiffness and Damping weights are expected have a value in [0.f, 1.f]. They will be set to constant 0.f if not supplied."
    },
