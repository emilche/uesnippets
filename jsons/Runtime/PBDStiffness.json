{
  "id": "pbd-stiffness",
  "label": "PBDStiffness",
  "includepath": "Chaos/PBDStiffness.h",
  "includes": [
    "Core",
    "PBDSoftsEvolutionFwd",
    "PBDWeightMap",
    "ArrayView",
    "ContainersFwd",
    "ChaosStats"
  ],
  "functions": [
    {
      "id": "set-weighted-value",
      "name": "SetWeightedValue",
      "category": "PBDStiffness",
      "signature": "SetWeightedValue(Target, In Weighted Value, Max Stiffness)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDStiffness*"
        },
        {
          "name": "In Weighted Value",
          "type": "FSolverVec2&"
        },
        {
          "name": "Max Stiffness",
          "type": "FSolverReal",
          "default": "DefaultPBDMaxStiffness"
        }
      ],
      "returnType": "Void",
      "docs": "Set the low and high values of the weight map.\nThe weight map table only gets updated after ApplyValues is called.\nLow and high values are clamped between [0, MaxStiffness]"
    },
    {
      "id": "calc-exponential-parameter-fit",
      "name": "CalcExponentialParameterFit",
      "category": "PBDStiffness",
      "signature": "CalcExponentialParameterFit(Parameter Fit Base, Parameter Fit Log Base, In Value)",
      "params": [
        {
          "name": "Parameter Fit Base",
          "type": "FSolverReal"
        },
        {
          "name": "Parameter Fit Log Base",
          "type": "FSolverReal"
        },
        {
          "name": "In Value",
          "type": "FSolverReal"
        }
      ],
      "returnType": "FSolverReal"
    },
    {
      "id": "apply-pbd-values",
      "name": "ApplyPBDValues",
      "category": "PBDStiffness",
      "signature": "ApplyPBDValues(Target, Dt, Num Iterations)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDStiffness*"
        },
        {
          "name": "Dt",
          "type": "FSolverReal"
        },
        {
          "name": "Num Iterations",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Update the weight map table with the current simulation parameters."
    },
    {
      "id": "apply-xpbd-values",
      "name": "ApplyXPBDValues",
      "category": "PBDStiffness",
      "signature": "ApplyXPBDValues(Target, Max Stiffness)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDStiffness*"
        },
        {
          "name": "Max Stiffness",
          "type": "FSolverReal"
        }
      ],
      "returnType": "Void"
    }
  ]
}