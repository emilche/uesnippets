        {
          "name": "Target",
          "type": "FSparseDynamicOctree3*"
        },
        {
          "name": "Max Tree Depth In",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Sets max tree depth w/ protection against setting beyond supported max"
    },
