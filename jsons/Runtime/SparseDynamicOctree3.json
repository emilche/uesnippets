    {
      "id": "parallel-range-query-588c1c",
      "name": "ParallelRangeQuery",
      "category": "SparseDynamicOctree3",
      "signature": "ParallelRangeQuery(Target, Range Bounds Hint, Bounds Overlap Fn, Object I Ds)",
      "params": [
        {
          "name": "Target",
          "type": "FSparseDynamicOctree3*"
        },
