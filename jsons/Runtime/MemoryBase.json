{
  "id": "memory-base",
  "label": "MemoryBase",
  "includepath": "HAL/MemoryBase.h",
  "includes": [
    "CoreTypes",
    "PlatformAtomics",
    "PlatformCrt",
    "Exec",
    "OutputDevice",
    "Atomic"
  ],
  "functions": [
    {
      "id": "delete",
      "name": "delete",
      "category": "MemoryBase",
      "signature": "delete(Target, Ptr)",
      "params": [
        {
          "name": "Target",
          "type": "FUseSystemMallocForNew*"
        },
        {
          "name": "Ptr",
          "type": "void*"
        }
      ],
      "returnType": "void operator",
      "docs": "Overloaded delete operator using the system allocator\n@param\tPtr\t\tPointer to delete"
    },
    {
      "id": "try-malloc",
      "name": "TryMalloc",
      "category": "MemoryBase",
      "signature": "TryMalloc(Target, Count, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        },
        {
          "name": "Count",
          "type": "SIZE_T"
        },
        {
          "name": "Alignment",
          "type": "UInt",
          "default": "DEFAULT_ALIGNMENT"
        }
      ],
      "returnType": "void*",
      "docs": "TryMalloc - like Malloc(), but may return a nullptr result if the allocation\nrequest cannot be satisfied."
    },
    {
      "id": "try-realloc",
      "name": "TryRealloc",
      "category": "MemoryBase",
      "signature": "TryRealloc(Target, Original, Count, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        },
        {
          "name": "Original",
          "type": "void*"
        },
        {
          "name": "Count",
          "type": "SIZE_T"
        },
        {
          "name": "Alignment",
          "type": "UInt",
          "default": "DEFAULT_ALIGNMENT"
        }
      ],
      "returnType": "void*",
      "docs": "TryRealloc - like Realloc(), but may return a nullptr if the allocation\nrequest cannot be satisfied. Note that in this case the memory\npointed to by Original will still be valid"
    },
    {
      "id": "malloc-zeroed",
      "name": "MallocZeroed",
      "category": "MemoryBase",
      "signature": "MallocZeroed(Target, Count, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        },
        {
          "name": "Count",
          "type": "SIZE_T"
        },
        {
          "name": "Alignment",
          "type": "UInt",
          "default": "DEFAULT_ALIGNMENT"
        }
      ],
      "returnType": "void*",
      "docs": "Malloc zeroed memory"
    },
    {
      "id": "try-malloc-zeroed",
      "name": "TryMallocZeroed",
      "category": "MemoryBase",
      "signature": "TryMallocZeroed(Target, Count, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        },
        {
          "name": "Count",
          "type": "SIZE_T"
        },
        {
          "name": "Alignment",
          "type": "UInt",
          "default": "DEFAULT_ALIGNMENT"
        }
      ],
      "returnType": "void*",
      "docs": "TryMalloc - like MallocZeroed(), but may return a nullptr result if the allocation\nrequest cannot be satisfied."
    },
    {
      "id": "initialize-stats-metadata",
      "name": "InitializeStatsMetadata",
      "category": "MemoryBase",
      "signature": "InitializeStatsMetadata(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes stats metadata. We need to do this as soon as possible, but cannot be done in the constructor\ndue to the FName::StaticInit"
    },
    {
      "id": "update-stats",
      "name": "UpdateStats",
      "category": "MemoryBase",
      "signature": "UpdateStats(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        }
      ],
      "returnType": "Void",
      "docs": "Called once per frame, gathers and sets all memory allocator statistics into the corresponding stats. MUST BE THREAD SAFE."
    },
    {
      "id": "get-allocator-stats",
      "name": "GetAllocatorStats",
      "category": "MemoryBase",
      "signature": "GetAllocatorStats(Target, Out Stats)",
      "params": [
        {
          "name": "Target",
          "type": "FMalloc*"
        },
        {
          "name": "Out Stats",
          "type": "FGenericMemoryStats&"
        }
      ],
      "returnType": "Void",
      "docs": "Writes allocator stats from the last update into the specified destination."
    }
  ]
}