    {
      "id": "apply-c-var-settings-from-ini",
      "name": "ApplyCVarSettingsFromIni",
      "category": "ConfigUtilities",
      "signature": "ApplyCVarSettingsFromIni(In Section Base Name, In Ini Filename, Set By, Allow Cheating, Tag)",
      "params": [
        {
          "name": "In Section Base Name",
          "type": "TCHAR*"
        },
        {
          "name": "In Ini Filename",
          "type": "TCHAR*"
        },
        {
          "name": "Set By",
          "type": "UInt"
        },
        {
          "name": "Allow Cheating",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Tag",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Helper function to read the contents of an ini file and a specified group of cvar parameters, where sections in the ini file are marked [InName]\n@param InSectionBaseName - The base name of the section to apply cvars from\n@param InIniFilename - The ini filename\n@param SetBy anything in ECVF_LastSetMask e.g. ECVF_SetByScalability"
    },
