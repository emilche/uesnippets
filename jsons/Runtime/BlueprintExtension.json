{
  "id": "blueprint-extension",
  "label": "BlueprintExtension",
  "includepath": "Blueprint/BlueprintExtension.h",
  "includes": [
    "CoreTypes",
    "Object",
    "BlueprintExtension.generated"
  ],
  "functions": [
    {
      "id": "generate-function-graphs",
      "name": "GenerateFunctionGraphs",
      "category": "BlueprintExtension",
      "signature": "GenerateFunctionGraphs(Target, Compiler Context)",
      "params": [
        {
          "name": "Target",
          "type": "UBlueprintExtension*"
        },
        {
          "name": "Compiler Context",
          "type": "FKismetCompilerContext*"
        }
      ],
      "returnType": "Void",
      "docs": "Called during compilation (after skeleton class generation) in order to generate dynamic function graphs for this blueprint"
    },
    {
      "id": "preload-objects-for-compilation",
      "name": "PreloadObjectsForCompilation",
      "category": "BlueprintExtension",
      "signature": "PreloadObjectsForCompilation(Target, Owning Blueprint)",
      "params": [
        {
          "name": "Target",
          "type": "UBlueprintExtension*"
        },
        {
          "name": "Owning Blueprint",
          "type": "UBlueprint*"
        }
      ],
      "returnType": "Void",
      "docs": "Called before blueprint compilation to ensure that any objects necessary for the specified blueprint's compilation"
    },
    {
      "id": "gather-search-data",
      "name": "GatherSearchData",
      "category": "BlueprintExtension",
      "signature": "GatherSearchData(Target, Owning Blueprint)",
      "params": [
        {
          "name": "Target",
          "type": "UBlueprintExtension*"
        },
        {
          "name": "Owning Blueprint",
          "type": "UBlueprint*"
        }
      ],
      "returnType": "FSearchData",
      "docs": "Called when the find in blueprint system gather the search data for the blueprint"
    },
    {
      "id": "get-all-graphs",
      "name": "GetAllGraphs",
      "category": "BlueprintExtension",
      "signature": "GetAllGraphs(Target, Graphs)",
      "params": [
        {
          "name": "Target",
          "type": "UBlueprintExtension*"
        },
        {
          "name": "Graphs",
          "type": "TArray<UEdGraph*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Override this function to inform editor tools of any graphs in this extension (eg. blueprint diff, asset search)"
    }
  ]
}