    {
      "id": "reset-reflection-captures",
      "name": "ResetReflectionCaptures",
      "category": "SceneInterface",
      "signature": "ResetReflectionCaptures(Target, Only If OOM)",
      "params": [
        {
          "name": "Target",
          "type": "FSceneInterface*"
        },
        {
          "name": "Only If OOM",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Resets reflection capture data to allow it to be rebuilt from scratch.  Allows shrinking of the number of items in\nthe capture array, which otherwise only grows.  This can allow the user to solve cases where an out of memory (OOM)\ncondition prevented captures from being generated.  The user can remove some items or reduce the capture resolution\nto fix the issue, and run \"Build Reflection Captures\" (which calls this function), instead of needing to restart\nthe editor.  The flag \"bOnlyIfOOM\" only does the reset if an OOM had occurred."
    },
