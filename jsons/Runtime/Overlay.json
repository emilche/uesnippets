{
  "id": "overlay",
  "label": "Overlay",
  "includepath": "Components/Overlay.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "SWidget",
    "SOverlay",
    "PanelWidget",
    "Overlay.generated"
  ],
  "functions": [
    {
      "id": "add-child-to-overlay",
      "name": "AddChildToOverlay",
      "category": "Widget",
      "signature": "AddChildToOverlay(Target, Content)",
      "params": [
        {
          "name": "Target",
          "type": "UOverlay*"
        },
        {
          "name": "Content",
          "type": "UWidget*"
        }
      ],
      "returnType": "UOverlaySlot*"
    },
    {
      "id": "replace-overlay-child-at",
      "name": "ReplaceOverlayChildAt",
      "category": "Panel",
      "signature": "ReplaceOverlayChildAt(Target, Index, Content)",
      "params": [
        {
          "name": "Target",
          "type": "UOverlay*"
        },
        {
          "name": "Index",
          "type": "Int"
        },
        {
          "name": "Content",
          "type": "UWidget*"
        }
      ],
      "returnType": "Bool",
      "docs": "Replace the widget at the given index it with a different widget."
    },
    {
      "id": "get-palette-category",
      "name": "GetPaletteCategory",
      "category": "Overlay",
      "signature": "GetPaletteCategory(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UOverlay*"
        }
      ],
      "returnType": "Text"
    }
  ]
}