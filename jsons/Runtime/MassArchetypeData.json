      "id": "does-archetype-match-requirements-3107cc",
      "name": "DoesArchetypeMatchRequirements",
      "category": "MassArchetypeData",
      "signature": "DoesArchetypeMatchRequirements(Archetype, Requirements, Bail Out On First Fail, Output Device)",
      "params": [
        {
          "name": "Archetype",
          "type": "FMassArchetypeData&"
        },
        {
          "name": "Requirements",
          "type": "FMassFragmentRequirements&"
        },
        {
          "name": "Bail Out On First Fail",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Output Device",
          "type": "FOutputDevice*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines whether given Archetype matches given Requirements. In case of failure to match and if WITH_MASSENTITY_DEBUG\nthe function will also log the reasons for said failure (at VeryVerbose level).\n@param bBailOutOnFirstFail if true will skip the remaining tests as soon as a single mismatch is detected. This option\nis used when looking for matching archetypes. For debugging purposes use `false` to list all the mismatching elements."
    },
