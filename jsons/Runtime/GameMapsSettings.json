      "id": "get-global-default-game-mode",
      "name": "GetGlobalDefaultGameMode",
      "category": "GameMapsSettings",
      "signature": "GetGlobalDefaultGameMode()",
      "params": [],
      "returnType": "String",
      "docs": "Get the global default game type specified in the configuration\nMakes a choice based on running as listen server/client vs dedicated server\n@return the proper global default game type"
    },
    {
      "id": "get-game-mode-for-name",
      "name": "GetGameModeForName",
      "category": "GameMapsSettings",
      "signature": "GetGameModeForName(Game Mode Name)",
      "params": [
        {
          "name": "Game Mode Name",
          "type": "String&"
        }
      ],
      "returnType": "String",
      "docs": "Searches the GameModeClassAliases list for a named game mode, if not found will return passed in string\n@return the proper game type class path to load"
    },
    {
      "id": "get-game-mode-for-map-name",
      "name": "GetGameModeForMapName",
      "category": "GameMapsSettings",
      "signature": "GetGameModeForMapName(Map Name)",
      "params": [
        {
          "name": "Map Name",
          "type": "String&"
        }
      ],
      "returnType": "String",
      "docs": "Searches the GameModeMapPrefixes list for a named game mode, if not found will return passed in string\n@return the proper game type class path to load, or empty if not found"
    },
