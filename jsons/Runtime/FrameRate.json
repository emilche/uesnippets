    {
      "id": "compute-grid-spacing",
      "name": "ComputeGridSpacing",
      "category": "FrameRate",
      "signature": "ComputeGridSpacing(Target, Pixels Per Second, Out Major Interval, Out Minor Divisions, Min Tick Px, Desired Major Tick Px)",
      "params": [
        {
          "name": "Target",
          "type": "FFrameRate*"
        },
        {
          "name": "Pixels Per Second",
          "type": "Float"
        },
        {
          "name": "Out Major Interval",
          "type": "Double&"
        },
        {
          "name": "Out Minor Divisions",
          "type": "Int&"
        },
        {
          "name": "Min Tick Px",
          "type": "Float",
          "default": "30.f"
        },
        {
          "name": "Desired Major Tick Px",
          "type": "Float",
          "default": "120.f"
        }
      ],
      "returnType": "Bool",
      "docs": "Compute a desirable grid spacing for the specified screen units\n@param PixelsPerSecond    The number of pixels representing a second of time\n@param OutMajorInterval   (Out) The interval in seconds at which to draw major grid lines\n@param OutMinorDivisions  (Out) The number of divisions to draw between major tick lines\n@param MinTickPx          (Optional) The smallest size in pixels that is desirable between ticks\n@param DesiredMajorTickPx (Optional) The desired size to compute major tick lines from\n@return True if a valid grid spacing was computed, false otherwise."
    },
