{
  "id": "widget-interaction-component",
  "label": "WidgetInteractionComponent",
  "includepath": "Components/WidgetInteractionComponent.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "UObjectGlobals",
    "InputCoreTypes",
    "HitResult",
    "SceneComponent",
    "GenericApplication",
    "WidgetPath",
    "WidgetInteractionComponent.generated"
  ],
  "functions": [
    {
      "id": "on-component-created",
      "name": "OnComponentCreated",
      "category": "WidgetInteractionComponent",
      "signature": "OnComponentCreated(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "activate",
      "name": "Activate",
      "category": "WidgetInteractionComponent",
      "signature": "Activate(Target, Reset)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Reset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "deactivate",
      "name": "Deactivate",
      "category": "WidgetInteractionComponent",
      "signature": "Deactivate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "tick-component",
      "name": "TickComponent",
      "category": "WidgetInteractionComponent",
      "signature": "TickComponent(Target, Delta Time, Tick Type, This Tick Function)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        },
        {
          "name": "Tick Type",
          "type": "ELevelTick"
        },
        {
          "name": "This Tick Function",
          "type": "FActorComponentTickFunction*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "press-pointer-key",
      "name": "PressPointerKey",
      "category": "Interaction",
      "signature": "PressPointerKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Void",
      "docs": "Presses a key as if the mouse/pointer were the source of it.  Normally you would just use\nLeft/Right mouse button for the Key.  However - advanced uses could also be imagined where you\nsend other keys to signal widgets to take special actions if they're under the cursor."
    },
    {
      "id": "release-pointer-key",
      "name": "ReleasePointerKey",
      "category": "Interaction",
      "signature": "ReleasePointerKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Void",
      "docs": "Releases a key as if the mouse/pointer were the source of it.  Normally you would just use\nLeft/Right mouse button for the Key.  However - advanced uses could also be imagined where you\nsend other keys to signal widgets to take special actions if they're under the cursor."
    },
    {
      "id": "press-key",
      "name": "PressKey",
      "category": "Interaction",
      "signature": "PressKey(Target, Key, Repeat)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        },
        {
          "name": "Repeat",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Press a key as if it had come from the keyboard.  Avoid using this for 'a-z|A-Z', things like\nthe Editable Textbox in Slate expect OnKeyChar to be called to signal a specific character being\nsend to the widget.  So for those cases you should use SendKeyChar."
    },
    {
      "id": "release-key",
      "name": "ReleaseKey",
      "category": "Interaction",
      "signature": "ReleaseKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Bool",
      "docs": "Releases a key as if it had been released by the keyboard."
    },
    {
      "id": "press-and-release-key",
      "name": "PressAndReleaseKey",
      "category": "Interaction",
      "signature": "PressAndReleaseKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Key",
          "type": "FKey"
        }
      ],
      "returnType": "Bool",
      "docs": "Does both the press and release of a simulated keyboard key."
    },
    {
      "id": "send-key-char",
      "name": "SendKeyChar",
      "category": "Interaction",
      "signature": "SendKeyChar(Target, Characters, Repeat)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Characters",
          "type": "String"
        },
        {
          "name": "Repeat",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Transmits a list of characters to a widget by simulating a OnKeyChar event for each key listed in\nthe string."
    },
    {
      "id": "scroll-wheel",
      "name": "ScrollWheel",
      "category": "Interaction",
      "signature": "ScrollWheel(Target, Scroll Delta)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Scroll Delta",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sends a scroll wheel event to the widget under the last hit result."
    },
    {
      "id": "get-hovered-widget-component",
      "name": "GetHoveredWidgetComponent",
      "category": "Interaction",
      "signature": "GetHoveredWidgetComponent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "UWidgetComponent*",
      "docs": "Get the currently hovered widget component."
    },
    {
      "id": "is-over-interactable-widget",
      "name": "IsOverInteractableWidget",
      "category": "Interaction",
      "signature": "IsOverInteractableWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if a widget under the hit result is interactive.  e.g. Slate widgets\nthat return true for IsInteractable()."
    },
    {
      "id": "is-over-focusable-widget",
      "name": "IsOverFocusableWidget",
      "category": "Interaction",
      "signature": "IsOverFocusableWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if a widget under the hit result is focusable.  e.g. Slate widgets that\nreturn true for SupportsKeyboardFocus()."
    },
    {
      "id": "is-over-hit-test-visible-widget",
      "name": "IsOverHitTestVisibleWidget",
      "category": "Interaction",
      "signature": "IsOverHitTestVisibleWidget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if a widget under the hit result is has a visibility that makes it hit test\nvisible.  e.g. Slate widgets that return true for GetVisibility().IsHitTestVisible()."
    },
    {
      "id": "get-hovered-widget-path",
      "name": "GetHoveredWidgetPath",
      "category": "WidgetInteractionComponent",
      "signature": "GetHoveredWidgetPath(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "FWeakWidgetPath&",
      "docs": "Gets the widget path for the slate widgets under the last hit result."
    },
    {
      "id": "get-last-hit-result",
      "name": "GetLastHitResult",
      "category": "Interaction",
      "signature": "GetLastHitResult(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "FHitResult&",
      "docs": "Gets the last hit result generated by the component.  Returns the custom hit result if that was set."
    },
    {
      "id": "get-2-d-hit-location",
      "name": "Get2DHitLocation",
      "category": "Interaction",
      "signature": "Get2DHitLocation(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        }
      ],
      "returnType": "FVector2D",
      "docs": "Gets the last hit location on the widget in 2D, local pixel units of the render target."
    },
    {
      "id": "set-custom-hit-result",
      "name": "SetCustomHitResult",
      "category": "Interaction",
      "signature": "SetCustomHitResult(Target, Hit Result)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Hit Result",
          "type": "FHitResult&"
        }
      ],
      "returnType": "Void",
      "docs": "Set custom hit result.  This is only taken into account if InteractionSource is set to EWidgetInteractionSource::Custom."
    },
    {
      "id": "set-focus",
      "name": "SetFocus",
      "category": "Interaction",
      "signature": "SetFocus(Target, Focus Widget)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetInteractionComponent*"
        },
        {
          "name": "Focus Widget",
          "type": "UWidget*"
        }
      ],
      "returnType": "Void",
      "docs": "Set the focus target of the virtual user managed by this component"
    }
  ]
}