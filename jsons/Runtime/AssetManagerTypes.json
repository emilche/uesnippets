          "name": "Target",
          "type": "FPrimaryAssetTypeInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this has valid config data that can be converted into runtime data as needed, this may be false for runtime only info"
    },
    {
      "id": "has-valid-runtime-data",
      "name": "HasValidRuntimeData",
      "category": "AssetManagerTypes",
      "signature": "HasValidRuntimeData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimaryAssetTypeInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this has valid runtime data because FillRuntimeData was previously called"
    },
    {
      "id": "can-modify-config-data",
      "name": "CanModifyConfigData",
      "category": "AssetManagerTypes",
      "signature": "CanModifyConfigData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimaryAssetTypeInfo*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if it is safe to modify config data as it has not been turned into runtime data yet"
    },
    {
      "id": "fill-runtime-data",
      "name": "FillRuntimeData",
      "category": "AssetManagerTypes",
      "signature": "FillRuntimeData(Target, Is Valid, Base Class Was Loaded)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimaryAssetTypeInfo*"
        },
        {
          "name": "Is Valid",
          "type": "Bool&"
        },
        {
          "name": "Base Class Was Loaded",
          "type": "Bool&"
        }
      ],
      "returnType": "Void",
      "docs": "Fills out transient variables based on parsed ones. Sets status bools saying rather data is valid, and rather it had to synchronously load the base class"
    },
    {
      "id": "are-rules-set",
      "name": "AreRulesSet",
      "category": "AssetManagerTypes",
      "signature": "AreRulesSet(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetManagerSearchRules*"
        }
      ],
      "returnType": "Bool",
      "docs": "Native filter delegate to call on asset data, if bound it should return true if asset should be included in results"
    },
    {
      "id": "union-with",
      "name": "UnionWith",
      "category": "AssetManagerTypes",
      "signature": "UnionWith(Target, Cook Rule, Direct Reference, Id, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimaryAssetCookRuleUnion*"
        },
        {
          "name": "Cook Rule",
          "type": "EPrimaryAssetCookRule"
        },
        {
          "name": "Direct Reference",
          "type": "Bool"
        },
        {
          "name": "Id",
          "type": "FPrimaryAssetId&"
        },
        {
          "name": "Priority",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Merges CookRules from multiple managers to decide the final CookRule for an asset they manage."
    },
    {
      "id": "get-rule",
      "name": "GetRule",
      "category": "AssetManagerTypes",
      "signature": "GetRule(Target, Out Conflict Ids)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimaryAssetCookRuleUnion*"
        },
        {
          "name": "Out Conflict Ids",
          "type": "TOptional<TTuple<FPrimaryAssetId,FPrimaryAssetId>>*"
        }
      ],
      "returnType": "EPrimaryAssetCookRule",
      "docs": "Get the result of the unions up to this point. If OutConflictIds is non-null, it will be cleared if there\nare no conflicts, and will be set to the Ids that have a conflict between inclusion and exclusion."
    }
  ]
