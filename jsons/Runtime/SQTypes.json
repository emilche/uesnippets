    {
      "id": "fsq-hit-buffer-0e570c",
      "name": "FSQHitBuffer",
      "category": "SQTypes",
      "signature": "FSQHitBuffer(Single, False, B Single)",
      "params": [
        {
          "name": "Single",
          "type": "Bool",
          "default": "false)\n\t\t\t: AcceleratorDepth(0)"
        },
        {
          "name": "False",
          "type": "bHasBlockingHit ("
        },
        {
          "name": "B Single",
          "type": "bSingleResult ("
        }
      ],
      "returnType": "Void",
      "docs": "Stores the results of scene queries. This can be passed around to multiple SQAccelerators and is responsible for sorting the results and pruning based on blocking.\nIncFlushCount / DecFlushCount is used to ensure any final sort / pruning operation is done when all SQAccelerators are finished. If you are passing this into multiple accelerators\nyou should call IncFlushCount / DecFlushCount yourself as otherwise each accelerator will trigger its own sort / prune."
    },
