{
  "id": "input-behavior",
  "label": "InputBehavior",
  "includepath": "InputBehavior.h",
  "includes": [
    "CoreMinimal",
    "InputState",
    "NumericLimits",
    "Object",
    "ObjectMacros",
    "UObjectGlobals",
    "InputBehavior.generated"
  ],
  "functions": [
    {
      "id": "u-input-behavior",
      "name": "UInputBehavior",
      "category": "InputBehavior",
      "signature": "UInputBehavior()",
      "params": [],
      "returnType": "public :"
    },
    {
      "id": "get-priority",
      "name": "GetPriority",
      "category": "InputBehavior",
      "signature": "GetPriority(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        }
      ],
      "returnType": "FInputCapturePriority",
      "docs": "The priority is used to resolve situations where multiple behaviors want the same capture"
    },
    {
      "id": "set-default-priority",
      "name": "SetDefaultPriority",
      "category": "InputBehavior",
      "signature": "SetDefaultPriority(Target, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Priority",
          "type": "FInputCapturePriority&"
        }
      ],
      "returnType": "Void",
      "docs": "Configure the default priority of an instance of this behavior"
    },
    {
      "id": "get-supported-devices",
      "name": "GetSupportedDevices",
      "category": "InputBehavior",
      "signature": "GetSupportedDevices(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        }
      ],
      "returnType": "EInputDevices",
      "docs": "Which device types does this Behavior support"
    },
    {
      "id": "wants-capture",
      "name": "WantsCapture",
      "category": "InputBehavior",
      "signature": "WantsCapture(Target, Input State)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "FInputCaptureRequest",
      "docs": "Given the input state, does this Behavior want to begin capturing some input devices?"
    },
    {
      "id": "begin-capture",
      "name": "BeginCapture",
      "category": "InputBehavior",
      "signature": "BeginCapture(Target, Input State, E Side)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        },
        {
          "name": "E Side",
          "type": "EInputCaptureSide"
        }
      ],
      "returnType": "FInputCaptureUpdate",
      "docs": "Called after WantsCapture() returns a capture request that was accepted"
    },
    {
      "id": "update-capture",
      "name": "UpdateCapture",
      "category": "InputBehavior",
      "signature": "UpdateCapture(Target, Input State, Capture Data)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        },
        {
          "name": "Capture Data",
          "type": "FInputCaptureData&"
        }
      ],
      "returnType": "FInputCaptureUpdate",
      "docs": "Called for each new input event during a capture sequence. Return Continue to keep\ncapturing, or End to finish capturing."
    },
    {
      "id": "force-end-capture",
      "name": "ForceEndCapture",
      "category": "InputBehavior",
      "signature": "ForceEndCapture(Target, Capture Data)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Capture Data",
          "type": "FInputCaptureData&"
        }
      ],
      "returnType": "Void",
      "docs": "If this is called, the Behavior has forcibly lost capture (eg due to app losing focus for example) and needs to clean up accordingly"
    },
    {
      "id": "wants-hover-events",
      "name": "WantsHoverEvents",
      "category": "InputBehavior",
      "signature": "WantsHoverEvents(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        }
      ],
      "returnType": "Bool",
      "docs": "return true if this Behavior supports hover (ie passive input events)"
    },
    {
      "id": "wants-hover-capture",
      "name": "WantsHoverCapture",
      "category": "InputBehavior",
      "signature": "WantsHoverCapture(Target, Input State)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "FInputCaptureRequest",
      "docs": "Given the input state, does this Behavior want to begin capturing some input devices for hover"
    },
    {
      "id": "begin-hover-capture",
      "name": "BeginHoverCapture",
      "category": "InputBehavior",
      "signature": "BeginHoverCapture(Target, Input State, E Side)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        },
        {
          "name": "E Side",
          "type": "EInputCaptureSide"
        }
      ],
      "returnType": "FInputCaptureUpdate",
      "docs": "Called after WantsHoverCapture() returns a capture request that was accepted"
    },
    {
      "id": "update-hover-capture",
      "name": "UpdateHoverCapture",
      "category": "InputBehavior",
      "signature": "UpdateHoverCapture(Target, Input State)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "Input State",
          "type": "FInputDeviceState&"
        }
      ],
      "returnType": "FInputCaptureUpdate",
      "docs": "Called on each new hover input event, ie if no other behavior is actively capturing input"
    },
    {
      "id": "end-hover-capture",
      "name": "EndHoverCapture",
      "category": "InputBehavior",
      "signature": "EndHoverCapture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        }
      ],
      "returnType": "Void",
      "docs": "If a different hover capture begins, focus is lost, a tool starts, etc, any active hover visualization needs to terminate"
    },
    {
      "id": "wants-force-end-capture",
      "name": "WantsForceEndCapture",
      "category": "InputBehavior",
      "signature": "WantsForceEndCapture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        }
      ],
      "returnType": "Bool",
      "docs": "When this function returns true, this behavior will always receive ForceEndCapture calls even when it is not actively\ncapturing. This is useful for behaviors that do not capture, but hold state (ex. Key Modifiers) and want to be notified when to clear that state."
    }
  ]
}