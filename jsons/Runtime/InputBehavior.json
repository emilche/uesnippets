    {
      "id": "f-input-capture-update",
      "name": "FInputCaptureUpdate",
      "category": "InputBehavior",
      "signature": "FInputCaptureUpdate(Target, State In, Source Behavior In, Which Side In, Custom Data)",
      "params": [
        {
          "name": "Target",
          "type": "UInputBehavior*"
        },
        {
          "name": "State In",
          "type": "EInputCaptureState"
        },
