{
  "id": "network-message",
  "label": "NetworkMessage",
  "includepath": "NetworkMessage.h",
  "includes": [
    "Array",
    "CoreMinimal",
    "Platform",
    "AssertionMacros",
    "ByteSwap",
    "Crc",
    "DateTime",
    "EnumClassFlags",
    "Archive",
    "ArrayReader",
    "BufferArchive"
  ],
  "functions": [
    {
      "id": "send",
      "name": "Send",
      "category": "NetworkMessage",
      "signature": "Send(Target, Buffer, Size)",
      "params": [
        {
          "name": "Target",
          "type": "FSimpleAbstractSocket_FSocket*"
        },
        {
          "name": "Buffer",
          "type": "Byte*"
        },
        {
          "name": "Size",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "Send bytes out the socket\n@param Buffer\t\t\tBuffer containing bytes to send\n@param Size\t\t\tNumber of bytes to send\n@return\t\t\t\ttrue if read is successful",
      "supportedTargets": [
        "FSimpleAbstractSocket_FSocket*",
        "FSimpleAbstractSocket_FMultichannelTCPSocket*"
      ]
    },
    {
      "id": "get-magic",
      "name": "GetMagic",
      "category": "NetworkMessage",
      "signature": "GetMagic(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSimpleAbstractSocket_FSocket*"
        }
      ],
      "returnType": "UInt",
      "docs": "return the magic number for this message, also used for endian correction on the archives *",
      "supportedTargets": [
        "FSimpleAbstractSocket_FSocket*",
        "FSimpleAbstractSocket_FMultichannelTCPSocket*"
      ]
    },
    {
      "id": "wrap-and-send-payload",
      "name": "WrapAndSendPayload",
      "category": "NetworkMessage",
      "signature": "WrapAndSendPayload(Payload, Socket)",
      "params": [
        {
          "name": "Payload",
          "type": "TArray<uint8>&"
        },
        {
          "name": "Socket",
          "type": "FSimpleAbstractSocket&"
        }
      ],
      "returnType": "Bool",
      "docs": "This function will create a header for the payload, then send the header and\npayload over the network\n@param Payload Bytes to send over the network\n@param Socket Connection to send the header and payload\n@return true if successful"
    },
    {
      "id": "send-payload-and-receive-response",
      "name": "SendPayloadAndReceiveResponse",
      "category": "NetworkMessage",
      "signature": "SendPayloadAndReceiveResponse(Payload, Response, Socket)",
      "params": [
        {
          "name": "Payload",
          "type": "TArray<uint8>&"
        },
        {
          "name": "Response",
          "type": "FArrayReader&"
        },
        {
          "name": "Socket",
          "type": "FSimpleAbstractSocket&"
        }
      ],
      "returnType": "Bool",
      "docs": "This function will send a payload data (with header) and wait for a response, serializing\nthe response to a FBufferArchive\n@param Payload Bytes to send over the network\n@param Response The archive to read the response into\n@param Socket Connection to send the header and payload\n@return true if successful"
    },
    {
      "id": "f-file-info",
      "name": "FFileInfo",
      "category": "NetworkMessage",
      "signature": "FFileInfo(False, False, Min Value, Min Value)",
      "params": [
        {
          "name": "False",
          "type": ") : FileExists ("
        },
        {
          "name": "False",
          "type": "ReadOnly ("
        },
        {
          "name": "Min Value",
          "type": "TimeStamp ( FDateTime::"
        },
        {
          "name": "Min Value",
          "type": "AccessTimeStamp ( FDateTime::"
        }
      ],
      "returnType": "Void",
      "docs": "A helper class for storing all available file info."
    },
    {
      "id": "f-network-file-archive",
      "name": "FNetworkFileArchive",
      "category": "NetworkMessage",
      "signature": "FNetworkFileArchive(Command)",
      "params": [
        {
          "name": "Command",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "A helper class for wrapping some of the network file payload specifics"
    }
  ]
}