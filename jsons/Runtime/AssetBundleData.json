{
  "id": "asset-bundle-data",
  "label": "AssetBundleData",
  "includepath": "AssetRegistry/AssetBundleData.h",
  "includes": [
    "Array",
    "UnrealString",
    "CoreTypes",
    "AssertionMacros",
    "Class",
    "NameTypes",
    "PrimaryAssetId",
    "SoftObjectPath",
    "SoftObjectPtr",
    "TopLevelAssetPath"
  ],
  "functions": [
    {
      "id": "export-text-item",
      "name": "ExportTextItem",
      "category": "AssetBundleData",
      "signature": "ExportTextItem(Target, Value Str, Default Value, Parent, Port Flags, Export Root Scope)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleEntry*"
        },
        {
          "name": "Value Str",
          "type": "String&"
        },
        {
          "name": "Default Value",
          "type": "FAssetBundleEntry&"
        },
        {
          "name": "Parent",
          "type": "UObject*"
        },
        {
          "name": "Port Flags",
          "type": "Int"
        },
        {
          "name": "Export Root Scope",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "import-text-item",
      "name": "ImportTextItem",
      "category": "AssetBundleData",
      "signature": "ImportTextItem(Target, Buffer, Port Flags, Parent, Error Text)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleEntry*"
        },
        {
          "name": "Buffer",
          "type": "TCHAR*&"
        },
        {
          "name": "Port Flags",
          "type": "Int"
        },
        {
          "name": "Parent",
          "type": "UObject*"
        },
        {
          "name": "Error Text",
          "type": "FOutputDevice*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "find-entry",
      "name": "FindEntry",
      "category": "AssetBundleData",
      "signature": "FindEntry(Target, Search Name)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Search Name",
          "type": "Name"
        }
      ],
      "returnType": "FAssetBundleEntry*",
      "docs": "Returns pointer to an entry with given Scope/Name"
    },
    {
      "id": "add-bundle-asset",
      "name": "AddBundleAsset",
      "category": "AssetBundleData",
      "signature": "AddBundleAsset(Target, Bundle Name, Asset Path)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Path",
          "type": "FSoftObjectPath&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds or updates an entry with the given BundleName -> Path. Scope is empty and will be filled in later"
    },
    {
      "id": "add-bundle-assets",
      "name": "AddBundleAssets",
      "category": "AssetBundleData",
      "signature": "AddBundleAssets(Target, Bundle Name, Asset Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Paths",
          "type": "TArray<FSoftObjectPath>&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds multiple assets at once"
    },
    {
      "id": "set-bundle-assets",
      "name": "SetBundleAssets",
      "category": "AssetBundleData",
      "signature": "SetBundleAssets(Target, Bundle Name, Asset Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Paths",
          "type": "TArray<FSoftObjectPath>&&"
        }
      ],
      "returnType": "Void",
      "docs": "A fast set of asset bundle assets, will destroy copied in path list"
    },
    {
      "id": "add-bundle-asset-truncated",
      "name": "AddBundleAssetTruncated",
      "category": "AssetBundleData",
      "signature": "AddBundleAssetTruncated(Target, Bundle Name, Asset Path)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Path",
          "type": "FSoftObjectPath&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds or updates an entry with the given BundleName -> Path, truncating to a top-level asset path if necessary."
    },
    {
      "id": "add-bundle-assets-truncated",
      "name": "AddBundleAssetsTruncated",
      "category": "AssetBundleData",
      "signature": "AddBundleAssetsTruncated(Target, Bundle Name, Asset Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Paths",
          "type": "TArray<FSoftObjectPath>&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds multiple assets at once, truncating to top-level asset paths if necessary"
    },
    {
      "id": "set-bundle-assets-truncated",
      "name": "SetBundleAssetsTruncated",
      "category": "AssetBundleData",
      "signature": "SetBundleAssetsTruncated(Target, Bundle Name, Asset Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        },
        {
          "name": "Bundle Name",
          "type": "Name"
        },
        {
          "name": "Asset Paths",
          "type": "TArray<FSoftObjectPath>&"
        }
      ],
      "returnType": "Void",
      "docs": "Replaces the contents of this bundle with the given assets, truncating to top-level asset paths if necessary."
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "AssetBundleData",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets the data to defaults"
    },
    {
      "id": "to-debug-string",
      "name": "ToDebugString",
      "category": "AssetBundleData",
      "signature": "ToDebugString(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAssetBundleData*"
        }
      ],
      "returnType": "String"
    }
  ]
}