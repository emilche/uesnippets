      "signature": "AddOrUpdateBlendable(Target, In Blendable Object, In Weight)",
      "params": [
        {
          "name": "Target",
          "type": "UPostProcessComponent*"
        },
        {
          "name": "In Blendable Object",
          "type": "TScriptInterface<IBlendableInterface>"
        },
        {
          "name": "In Weight",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Adds an Blendable (implements IBlendableInterface) to the array of Blendables (if it doesn't exist) and update the weight"
