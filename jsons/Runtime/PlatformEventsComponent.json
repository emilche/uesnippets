      "name": "IsInTabletMode",
      "category": "Components",
      "signature": "IsInTabletMode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UPlatformEventsComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether a convertible laptop is laptop mode.\n@return true if in tablet mode, false otherwise or if not a convertible laptop.\n@see IsInLaptopMode, SupportsConvertibleLaptops"
    },
    {
      "id": "supports-convertible-laptops",
      "name": "SupportsConvertibleLaptops",
      "category": "Components",
      "signature": "SupportsConvertibleLaptops(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UPlatformEventsComponent*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether the platform supports convertible laptops.\nNote: This does not necessarily mean that the platform is a convertible laptop.\nFor example, convertible laptops running Windows 7 or older will return false,\nand regular laptops running Windows 8 or newer will return true.\n@return true for convertible laptop platforms, false otherwise.\n@see IsInLaptopMode, IsInTabletMode"
    },
