    {
      "id": "add-constraint-container",
      "name": "AddConstraintContainer",
      "category": "IslandGroupManager",
      "signature": "AddConstraintContainer(Target, Constraint Container, Priority)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDIslandGroupManager*"
        },
        {
          "name": "Constraint Container",
          "type": "FPBDConstraintContainer&"
        },
        {
          "name": "Priority",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Register a constraint type with the manager. This will create a ConstraintContainerSolver for the ConstraintsContainer.\nConstraints are solved in Priority order with lower priorities first, so higher priorities \"win\"."
    },
    {
      "id": "remove-constraint-container",
