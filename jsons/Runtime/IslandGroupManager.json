          "type": "FPBDIslandGroupManager*"
        },
        {
          "name": "Constraint Container",
          "type": "FPBDConstraintContainer&"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a previously-added container. Generall this is only needed for debuggin as cleanup is automatic on destruction."
    },
    {
      "id": "set-constraint-container-priority",
