  "functions": [
    {
      "id": "add-split-strided-views-for-delta",
      "name": "AddSplitStridedViewsForDelta",
      "category": "ImageCoreDelta",
      "signature": "AddSplitStridedViewsForDelta(Out Views, In View)",
      "params": [
        {
          "name": "Out Views",
          "type": "TArray64<FImageViewStrided>&"
        },
        {
          "name": "In View",
          "type": "FImageView&"
        }
      ],
      "returnType": "Void",
      "docs": "Split InView into tiles and add to OutViews.  Will add 1 more entries to OutViews."
    },
    {
      "id": "do-transform",
      "name": "DoTransform",
      "category": "ImageCoreDelta",
      "signature": "DoTransform(In Image, Out Data, Forward)",
      "params": [
        {
          "name": "In Image",
          "type": "FImageViewStrided&"
        },
        {
          "name": "Out Data",
          "type": "Byte*"
        },
        {
          "name": "Forward",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Do Delta Transform\nbForward=false is the inverse transform\nOutData must be the same size and layout as InImage ; eg. same pixel sizes and strides.  It is not rearranged in any way.\nNo headers are added."
    }
  ]
