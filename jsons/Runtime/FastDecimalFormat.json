{
  "id": "fast-decimal-format",
  "label": "FastDecimalFormat",
  "includepath": "Internationalization/FastDecimalFormat.h",
  "includes": [
    "UnrealString",
    "CoreTypes",
    "Text",
    "NumericLimits",
    "CString",
    "type_traits",
    "EnableIf",
    "IsFloatingPoint",
    "IsIntegral",
    "IsSigned"
  ],
  "functions": [
    {
      "id": "integral-to-string",
      "name": "IntegralToString",
      "category": "FastDecimalFormat",
      "signature": "IntegralToString(Is Negative, In Val, In Formatting Rules, In Formatting Options, Out String)",
      "params": [
        {
          "name": "Is Negative",
          "type": "Bool"
        },
        {
          "name": "In Val",
          "type": "UInt64"
        },
        {
          "name": "In Formatting Rules",
          "type": "FDecimalNumberFormattingRules&"
        },
        {
          "name": "In Formatting Options",
          "type": "FNumberFormattingOptions"
        },
        {
          "name": "Out String",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Number formatting rules, typically extracted from the ICU decimal formatter for a given culture"
    },
    {
      "id": "fractional-to-string",
      "name": "FractionalToString",
      "category": "FastDecimalFormat",
      "signature": "FractionalToString(In Val, In Formatting Rules, In Formatting Options, Out String)",
      "params": [
        {
          "name": "In Val",
          "type": "Double"
        },
        {
          "name": "In Formatting Rules",
          "type": "FDecimalNumberFormattingRules&"
        },
        {
          "name": "In Formatting Options",
          "type": "FNumberFormattingOptions"
        },
        {
          "name": "Out String",
          "type": "String&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "string-to-integral",
      "name": "StringToIntegral",
      "category": "FastDecimalFormat",
      "signature": "StringToIntegral(In Str, In Str Len, In Formatting Rules, In Parsing Options, Limits, Out Is Negative, Out Val, Out Parsed Len)",
      "params": [
        {
          "name": "In Str",
          "type": "TCHAR*"
        },
        {
          "name": "In Str Len",
          "type": "Int"
        },
        {
          "name": "In Formatting Rules",
          "type": "FDecimalNumberFormattingRules&"
        },
        {
          "name": "In Parsing Options",
          "type": "FNumberParsingOptions&"
        },
        {
          "name": "Limits",
          "type": "FDecimalNumberIntegralLimits&"
        },
        {
          "name": "Out Is Negative",
          "type": "Bool&"
        },
        {
          "name": "Out Val",
          "type": "UInt64&"
        },
        {
          "name": "Out Parsed Len",
          "type": "Int*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "string-to-fractional",
      "name": "StringToFractional",
      "category": "FastDecimalFormat",
      "signature": "StringToFractional(In Str, In Str Len, In Formatting Rules, In Parsing Options, Limits, Out Val, Out Parsed Len)",
      "params": [
        {
          "name": "In Str",
          "type": "TCHAR*"
        },
        {
          "name": "In Str Len",
          "type": "Int"
        },
        {
          "name": "In Formatting Rules",
          "type": "FDecimalNumberFormattingRules&"
        },
        {
          "name": "In Parsing Options",
          "type": "FNumberParsingOptions&"
        },
        {
          "name": "Limits",
          "type": "FDecimalNumberFractionalLimits&"
        },
        {
          "name": "Out Val",
          "type": "Double&"
        },
        {
          "name": "Out Parsed Len",
          "type": "Int*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "pow-10",
      "name": "Pow10",
      "category": "FastDecimalFormat",
      "signature": "Pow10(In Exponent)",
      "params": [
        {
          "name": "In Exponent",
          "type": "Int"
        }
      ],
      "returnType": "UInt64",
      "docs": "Return the value of 10^exp for the given exponent value.\n@note The maximum exponent supported is 10^18."
    }
  ]
}