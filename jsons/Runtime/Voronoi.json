    {
      "id": "initialize-a7f9a9",
      "name": "Initialize",
      "category": "Voronoi",
      "signature": "Initialize(Target, Sites, Bounds, Extra Bounding Space, Squared Dist Skip Pt Threshold)",
      "params": [
        {
          "name": "Target",
          "type": "FVoronoiDiagram*"
        },
        {
          "name": "Sites",
          "type": "TArrayView<FVector>&"
        },
        {
          "name": "Bounds",
          "type": "FBox&"
        },
        {
          "name": "Extra Bounding Space",
          "type": "Double"
        },
        {
          "name": "Squared Dist Skip Pt Threshold",
          "type": "Double",
          "default": "UE_KINDA_SMALL_NUMBER"
        }
      ],
      "returnType": "Void",
      "docs": "Create a Voronoi diagram with the given sites, in a given bounding box.  Any previous data is discarded.\n@param Sites\t\t\t\t\t\t\tVoronoi sites for the diagram\n@param Bounds\t\t\t\t\t\tBounding box within which to compute the Voronoi diagram\n@param ExtraBoundingSpace\t\t\tVoronoi diagram will be computed within the input Bounds + this amount of extra space in each dimension\n@param SquaredDistSkipPtThreshold\tA safety threshold to avoid creating invalid cells: sites that are within this distance of an already-added site will not be added.\n(If you know there will be no duplicate sites, can set to zero for faster perf.)"
    },
    {
