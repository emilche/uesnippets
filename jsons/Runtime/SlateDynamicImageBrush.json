  "functions": [
    {
      "id": "create-with-image-data",
      "name": "CreateWithImageData",
      "category": "SlateDynamicImageBrush",
      "signature": "CreateWithImageData(In Texture Name, In Image Size, In Image Data, In Tint, In Tiling, In Image Type)",
      "params": [
        {
          "name": "In Texture Name",
          "type": "Name"
        },
        {
          "name": "In Image Size",
          "type": "UE::Slate::FDeprecateVector2DParameter&"
        },
        {
          "name": "In Image Data",
          "type": "TArray<uint8>&"
        },
        {
          "name": "In Tint",
          "type": "FLinearColor&",
          "default": "FLinearColor(1.0f, 1.0f, 1.0f, 1.0f)"
        },
        {
          "name": "In Tiling",
          "type": "ESlateBrushTileType::Type",
          "default": "ESlateBrushTileType::NoTile"
        },
        {
          "name": "In Image Type",
          "type": "ESlateBrushImageType::Type",
          "default": "ESlateBrushImageType::FullColor"
        }
      ],
      "returnType": "TSharedPtr<FSlateDynamicImageBrush>",
      "docs": "@param InTextureName\t\tThe name to use when registering the image data as a texture.\n@param InImageSize\t\tHow large should the image be (not necessarily the image size on disk)\n@param InImageData\t\tThe raw image data formatted as BGRA\n@param InTint\t\t\t\tThe tint of the image.\n@param InTiling\t\t\tHow do we tile if at all?\n@param InImageType\t\tThe type of image this this is"
    },
