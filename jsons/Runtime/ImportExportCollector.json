{
  "id": "import-export-collector",
  "label": "ImportExportCollector",
  "includepath": "ImportExportCollector.h",
  "includes": [
    "CoreTypes",
    "Map",
    "RingBuffer",
    "Set",
    "ArchiveUObject",
    "Package",
    "NameTypes",
    "SoftObjectPath",
    "UObjectGlobals"
  ],
  "functions": [
    {
      "id": "add-export-to-ignore",
      "name": "AddExportToIgnore",
      "category": "ImportExportCollector",
      "signature": "AddExportToIgnore(Target, Export)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        },
        {
          "name": "Export",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Mark that a given export (e.g. the export that is doing the collecting) should not be explored\nif encountered again. Prevents infinite recursion when the collector is constructed and called during\nSerialize."
    },
    {
      "id": "serialize-object-and-referenced-exports",
      "name": "SerializeObjectAndReferencedExports",
      "category": "ImportExportCollector",
      "signature": "SerializeObjectAndReferencedExports(Target, Root Object)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        },
        {
          "name": "Root Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Serialize the given object, following its object references to find other imports and exports,\nand recursively serialize any new exports that it references."
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "ImportExportCollector",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        }
      ],
      "returnType": "Void",
      "docs": "Restore the collector to empty."
    }
  ]
}