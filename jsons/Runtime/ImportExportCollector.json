{
  "id": "import-export-collector",
  "label": "ImportExportCollector",
  "includepath": "ImportExportCollector.h",
  "includes": [
    "CoreTypes",
    "Map",
    "RingBuffer",
    "Set",
    "ArchiveUObject",
    "Package",
    "NameTypes",
    "SoftObjectPath",
    "UObjectGlobals"
  ],
  "functions": [
    {
      "id": "add-export-to-ignore",
      "name": "AddExportToIgnore",
      "category": "ImportExportCollector",
      "signature": "AddExportToIgnore(Target, Export)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        },
        {
          "name": "Export",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Mark that a given export (e.g. the export that is doing the collecting) should not be explored\nif encountered again. Prevents infinite recursion when the collector is constructed and called during\nSerialize."
    },
    {
      "id": "serialize-object-and-referenced-exports",
      "name": "SerializeObjectAndReferencedExports",
      "category": "ImportExportCollector",
      "signature": "SerializeObjectAndReferencedExports(Target, Root Object)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        },
        {
          "name": "Root Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Serialize the given object, following its object references to find other imports and exports,\nand recursively serialize any new exports that it references."
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "ImportExportCollector",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        }
      ],
      "returnType": "Void",
      "docs": "Restore the collector to empty."
    },
    {
      "id": "get-exports",
      "name": "GetExports",
      "category": "ImportExportCollector",
      "signature": "GetExports(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        }
      ],
      "returnType": "TArray<UObject*>"
    },
    {
      "id": "get-imports",
      "name": "GetImports",
      "category": "ImportExportCollector",
      "signature": "GetImports(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        }
      ],
      "returnType": "TMap<FSoftObjectPath,ESoftObjectPathCollectType>&"
    },
    {
      "id": "get-imported-packages",
      "name": "GetImportedPackages",
      "category": "ImportExportCollector",
      "signature": "GetImportedPackages(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        }
      ],
      "returnType": "TMap<FName,ESoftObjectPathCollectType>&"
    },
    {
      "id": "set-callback-is-editor-only-object-allowed",
      "name": "SetCallbackIsEditorOnlyObjectAllowed",
      "category": "ImportExportCollector",
      "signature": "SetCallbackIsEditorOnlyObjectAllowed(Target, In Callback)",
      "params": [
        {
          "name": "Target",
          "type": "FImportExportCollector*"
        },
        {
          "name": "In Callback",
          "type": "TFunction<bool ( UObject* )>"
        }
      ],
      "returnType": "Void",
      "docs": "By default, when this->IsFilterEditorOnly, exports that are EditorOnly exports are not serialized\nto look for imports or other exports, and EditorOnly imports are not recorded. But the caller can\noverride this and allow some of them to be serialized."
    }
  ]
}