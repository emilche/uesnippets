    {
      "id": "f-collision-sort-key-hashed-37bbb8",
      "name": "FCollisionSortKeyHashed",
      "category": "CollisionKeys",
      "signature": "FCollisionSortKeyHashed(Key)",
      "params": [
        {
          "name": "Key",
          "type": ") :"
        }
      ],
      "returnType": "Void",
      "docs": "A key used to sort collisions. This to ensure consistent collision solver order when collisions are generated\nin a semi-random order (during multi-threaded collision detection).\nNOTE: This version does not result in collisions being sorted by Particle, but it is smaller than FCollisionSortKeyNonHashed\n@todo(chaos): Hashing the particle pair key does not work well at all. Do not use this for the time being (see FCollisionSortKeyNonHashed)"
    },
