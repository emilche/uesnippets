{
  "id": "mesh-render-decomposition",
  "label": "MeshRenderDecomposition",
  "includepath": "Components/MeshRenderDecomposition.h",
  "includes": [
    "Array",
    "CoreMinimal",
    "GeometryBase",
    "Platform",
    "UniquePtr"
  ],
  "functions": [
    {
      "id": "build-associations",
      "name": "BuildAssociations",
      "category": "MeshRenderDecomposition",
      "signature": "BuildAssociations(Target, Mesh)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRenderDecomposition*"
        },
        {
          "name": "Mesh",
          "type": "FDynamicMesh3*"
        }
      ],
      "returnType": "Void",
      "docs": "Construct mappings between mesh and groups (eg TriangleToGroupMap)"
    },
    {
      "id": "build-material-decomposition",
      "name": "BuildMaterialDecomposition",
      "category": "MeshRenderDecomposition",
      "signature": "BuildMaterialDecomposition(Mesh, Material Set, Decomp)",
      "params": [
        {
          "name": "Mesh",
          "type": "FDynamicMesh3*"
        },
        {
          "name": "Material Set",
          "type": "FComponentMaterialSet*"
        },
        {
          "name": "Decomp",
          "type": "FMeshRenderDecomposition&"
        }
      ],
      "returnType": "Void",
      "docs": "Build decomposition with one group for each MaterialID of mesh"
    },
    {
      "id": "build-chunked-decomposition",
      "name": "BuildChunkedDecomposition",
      "category": "MeshRenderDecomposition",
      "signature": "BuildChunkedDecomposition(Mesh, Material Set, Decomp, Max Chunk Size)",
      "params": [
        {
          "name": "Mesh",
          "type": "FDynamicMesh3*"
        },
        {
          "name": "Material Set",
          "type": "FComponentMaterialSet*"
        },
        {
          "name": "Decomp",
          "type": "FMeshRenderDecomposition&"
        },
        {
          "name": "Max Chunk Size",
          "type": "Int",
          "default": "1 << 14"
        }
      ],
      "returnType": "Void",
      "docs": "Build per-material decomposition, and then split each of those into chunks of at most MaxChunkSize\n(actual chunk sizes will be highly variable and some may be very small...)"
    }
  ]
}