      "id": "passes-starts-with-filter",
      "name": "PassesStartsWithFilter",
      "category": "NamePermissionList",
      "signature": "PassesStartsWithFilter(Target, Item, Allow Parent Paths)",
      "params": [
        {
          "name": "Target",
          "type": "FPathPermissionList*"
        },
        {
          "name": "Item",
          "type": "FStringView"
        },
        {
          "name": "Allow Parent Paths",
