    {
      "id": "compute-golden-spiral-points-9834db",
      "name": "ComputeGoldenSpiralPoints",
      "category": "TaperedCapsule",
      "signature": "ComputeGoldenSpiralPoints(Points, Origin, Axis, Radius 1, Radius 2, Height, Num Points, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Origin",
          "type": "FVec3&"
        },
        {
          "name": "Axis",
          "type": "FVec3&"
        },
        {
          "name": "Radius 1",
          "type": "FReal"
        },
        {
          "name": "Radius 2",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Use the golden spiral method to generate evenly spaced points on a tapered\ncapsule (truncated cone with two hemispherical ends).\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the tapered capsule part, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Origin is the bottom-most point of the tapered capsule.\n\\p Axis is the orientation of the tapered capsule.\n\\p Radius1 is the first radius of the tapered capsule.\n\\p Radius2 is the second radius of the tapered capsule.\n\\p Height is the height of the tapered capsule.\n\\p NumPoints is the number of points to generate.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
    {
      "id": "compute-golden-spiral-points-unoriented",
      "name": "ComputeGoldenSpiralPointsUnoriented",
      "category": "TaperedCapsule",
      "signature": "ComputeGoldenSpiralPointsUnoriented(Points, Radius 1, Radius 2, Height, Num Points, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Radius 1",
          "type": "FReal"
        },
        {
          "name": "Radius 2",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Generates points on a tapered capsule (truncated cone), oriented about\nthe Z axis, varying from [-Height/2, Height/2].\nTODO: Note that this method does not produce evenly spaced points!  It'll\nbunch points together on the side of the capsule with the smaller radius,\nand spread them apart on the larger.  We need a routine that operates in\nconical space, rather than cylindrical.  That said, points are distributed\nevenly between the two end caps, proportional to their respective areas.\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the capsule, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Radius1 is the first radius of the tapered capsule.\n\\p Radius2 is the second radius of the tapered capsule.\n\\p Height is the height of the capsule.\n\\p NumPoints is the number of points to generate.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
    {
