      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        }
      ],
      "returnType": "ETextureImportPNGInfill"
    },
    {
      "id": "get-auto-limit-pixel-count",
      "name": "GetAutoLimitPixelCount",
      "category": "TextureImportSettings",
      "signature": "GetAutoLimitPixelCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        }
      ],
      "returnType": "Int64"
    },
    {
      "id": "is-import-auto-vt-enabled",
      "name": "IsImportAutoVTEnabled",
      "category": "TextureImportSettings",
      "signature": "IsImportAutoVTEnabled(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "apply-defaults-for-newly-imported-textures",
      "name": "ApplyDefaultsForNewlyImportedTextures",
      "category": "TextureImportSettings",
      "signature": "ApplyDefaultsForNewlyImportedTextures(Target, Texture, Is Reimport)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        },
        {
          "name": "Texture",
          "type": "UTexture*"
        },
        {
          "name": "Is Reimport",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Set default properties on Texture for newly imported textures, or reimports.\nShould be called after all texture properties are set, before PostEditChange()"
    },
    {
      "id": "should-texture-be-virtual-by-auto-import-size",
      "name": "ShouldTextureBeVirtualByAutoImportSize",
      "category": "TextureImportSettings",
      "signature": "ShouldTextureBeVirtualByAutoImportSize(Target, Texture)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        },
        {
          "name": "Texture",
          "type": "UTexture*"
        }
      ],
      "returnType": "Bool",
      "docs": "Query if texture will be made VT automatically on import due to exceeding AutoVTSize\nor other conditions which require it to be VT\nonly returns true if VT is enabled and auto-VT is enabled"
    },
    {
      "id": "get-default-srgb",
      "name": "GetDefaultSRGB",
      "category": "TextureImportSettings",
      "signature": "GetDefaultSRGB(Target, TC, Import Image Format, Import Image SRGB)",
      "params": [
        {
          "name": "Target",
          "type": "UTextureImportSettings*"
        },
        {
          "name": "TC",
          "type": "TextureCompressionSettings"
        },
        {
          "name": "Import Image Format",
          "type": "ETextureSourceFormat"
        },
        {
          "name": "Import Image SRGB",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Get the default value for Texture->SRGB\nImportImageSRGB is the SRGB setting of the imported image"
    }
