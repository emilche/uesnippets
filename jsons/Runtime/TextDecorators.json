{
  "id": "text-decorators",
  "label": "TextDecorators",
  "includepath": "Framework/Text/TextDecorators.h",
  "includes": [
    "CoreMinimal",
    "SlateGlobals",
    "ISlateRun",
    "SlateHyperlinkRun",
    "ITextDecorator",
    "SlateWidgetRun"
  ],
  "functions": [
    {
      "id": "supports",
      "name": "Supports",
      "category": "TextDecorators",
      "signature": "Supports(Target, Run Parse Result, Text)",
      "params": [
        {
          "name": "Target",
          "type": "FWidgetDecorator*"
        },
        {
          "name": "Run Parse Result",
          "type": "FTextRunParseResults&"
        },
        {
          "name": "Text",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "supportedTargets": [
        "FWidgetDecorator*",
        "FImageDecorator*",
        "FHyperlinkDecorator*"
      ]
    },
    {
      "id": "create",
      "name": "Create",
      "category": "TextDecorators",
      "signature": "Create(Target, Text Layout, Run Parse Result, Original Text, In Out Model Text, Style)",
      "params": [
        {
          "name": "Target",
          "type": "FWidgetDecorator*"
        },
        {
          "name": "Text Layout",
          "type": "TSharedRef<FTextLayout>&"
        },
        {
          "name": "Run Parse Result",
          "type": "FTextRunParseResults&"
        },
        {
          "name": "Original Text",
          "type": "String&"
        },
        {
          "name": "In Out Model Text",
          "type": "TSharedRef<FString>&"
        },
        {
          "name": "Style",
          "type": "ISlateStyle*"
        }
      ],
      "returnType": "TSharedRef<ISlateRun>",
      "supportedTargets": [
        "FWidgetDecorator*",
        "FImageDecorator*",
        "FHyperlinkDecorator*"
      ]
    }
  ]
}