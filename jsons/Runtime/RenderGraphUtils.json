    {
      "id": "add-indirect-args-setup-cs-pass-1-d",
      "name": "AddIndirectArgsSetupCsPass1D",
      "category": "RenderGraphUtils",
      "signature": "AddIndirectArgsSetupCsPass1D(Graph Builder, Feature Level, Input Count Buffer, Output Buffer Name, Divisor, Input Count Offset, Multiplier)",
      "params": [
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        },
        {
          "name": "Feature Level",
          "type": "ERHIFeatureLevel::Type"
        },
        {
          "name": "Input Count Buffer",
          "type": "FRDGBuffer*"
        },
        {
          "name": "Output Buffer Name",
          "type": "TCHAR*"
        },
        {
          "name": "Divisor",
          "type": "UInt"
        },
        {
          "name": "Input Count Offset",
          "type": "UInt",
          "default": "0U"
        },
        {
          "name": "Multiplier",
          "type": "UInt",
          "default": "1U"
        }
      ],
      "returnType": "FRDGBufferRef",
      "docs": "Create and set up an 1D indirect dispatch argument from some GPU-side integer in a buffer (InputCountBuffer).\nSets up a group count as (InputCountBuffer[InputCountOffset] * Multiplier + Divisor - 1U) / Divisor;\nCommonly use Divisor <=> number of threads per group."
    },
