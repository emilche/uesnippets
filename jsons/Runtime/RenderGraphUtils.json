    {
      "id": "clear-unused-graph-resources-impl-f198fa",
      "name": "ClearUnusedGraphResourcesImpl",
      "category": "RenderGraphUtils",
      "signature": "ClearUnusedGraphResourcesImpl(Shader Bindings, Parameters Metadata, Inout Parameters, Exclude List)",
      "params": [
        {
          "name": "Shader Bindings",
          "type": "FShaderParameterBindings&"
        },
        {
          "name": "Parameters Metadata",
          "type": "FShaderParametersMetadata*"
        },
        {
          "name": "Inout Parameters",
          "type": "void*"
        },
        {
          "name": "Exclude List",
          "type": "std::initializer_list<FRDGResourceRef>"
        }
      ],
      "returnType": "Void",
      "docs": "Clears all render graph tracked resources that are not bound by a shader.\nExcludes any resources on the ExcludeList from being cleared regardless of whether the\nshader binds them or not. This is needed for resources that are used outside of shader\nbindings such as indirect arguments buffers."
    },
    {
      "id": "clear-unused-graph-resources-impl-0182ce",
      "name": "ClearUnusedGraphResourcesImpl",
      "category": "RenderGraphUtils",
      "signature": "ClearUnusedGraphResourcesImpl(Shader Bindings List, Parameters Metadata, Inout Parameters, Exclude List)",
      "params": [
        {
          "name": "Shader Bindings List",
          "type": "TArrayView<FShaderParameterBindings*>"
        },
        {
          "name": "Parameters Metadata",
          "type": "FShaderParametersMetadata*"
        },
        {
          "name": "Inout Parameters",
          "type": "void*"
        },
        {
          "name": "Exclude List",
          "type": "std::initializer_list<FRDGResourceRef>"
        }
      ],
      "returnType": "Void",
      "docs": "Similar to the function above, but takes a list of shader bindings and only clears if none of the shaders contain the resource."
    },
