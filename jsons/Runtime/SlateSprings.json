{
  "id": "slate-springs",
  "label": "SlateSprings",
  "includepath": "Animation/SlateSprings.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "set-config",
      "name": "SetConfig",
      "category": "SlateSprings",
      "signature": "SetConfig(Target, In Config)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        },
        {
          "name": "In Config",
          "type": "FSpringConfig&"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the config for this spring\n@param  InConfig  New configuration"
    },
    {
      "id": "set-position",
      "name": "SetPosition",
      "category": "SlateSprings",
      "signature": "SetPosition(Target, In Position)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        },
        {
          "name": "In Position",
          "type": "FloatType"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the current position (and target position) for the spring\n@param  InTarget  New position"
    },
    {
      "id": "get-position",
      "name": "GetPosition",
      "category": "SlateSprings",
      "signature": "GetPosition(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        }
      ],
      "returnType": "FloatType",
      "docs": "Gets the current position of the spring\n@return  Current position for this spring"
    },
    {
      "id": "set-target",
      "name": "SetTarget",
      "category": "SlateSprings",
      "signature": "SetTarget(Target, In Target)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        },
        {
          "name": "In Target",
          "type": "FloatType"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the target position for the spring\n@param  InTarget  New target position"
    },
    {
      "id": "get-target",
      "name": "GetTarget",
      "category": "SlateSprings",
      "signature": "GetTarget(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        }
      ],
      "returnType": "FloatType",
      "docs": "Gets the target position\n@return  Target position for this spring"
    },
    {
      "id": "is-at-rest",
      "name": "IsAtRest",
      "category": "SlateSprings",
      "signature": "IsAtRest(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return True if the spring is at rest (i.e. at its target position)"
    },
    {
      "id": "tick",
      "name": "Tick",
      "category": "SlateSprings",
      "signature": "Tick(Target, In Quantum)",
      "params": [
        {
          "name": "Target",
          "type": "TSpring1D*"
        },
        {
          "name": "In Quantum",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the simulation.  Should be called every tick!\n@param  InQuantum  Time passed since last update"
    }
  ]
}