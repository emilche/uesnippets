      "id": "f-mass-entity-view-52e6d5",
      "name": "FMassEntityView",
      "category": "MassEntityView",
      "signature": "FMassEntityView(Archetype Handle, Entity)",
      "params": [
        {
          "name": "Archetype Handle",
          "type": "FMassArchetypeHandle&"
        },
        {
          "name": "Entity",
          "type": "FMassEntityHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Resolves Entity against ArchetypeHandle. Note that this approach requires the caller to ensure that Entity\nindeed belongs to ArchetypeHandle. If not the call will fail a check. As a remedy calling the\nFMassEntityManager-flavored constructor is recommended since it will first find the appropriate archetype for\nEntity."
    },
    {
      "id": "f-mass-entity-view-bbf5a5",
      "name": "FMassEntityView",
      "category": "MassEntityView",
      "signature": "FMassEntityView(Entity Manager, Entity)",
      "params": [
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        },
        {
          "name": "Entity",
          "type": "FMassEntityHandle"
        }
      ],
      "returnType": "Void",
      "docs": "Finds the archetype Entity belongs to and then resolves against it. The caller is responsible for ensuring\nthat the given Entity is in fact a valid ID tied to any of the archetypes"
    },
    {
      "id": "try-make-view",
      "name": "TryMakeView",
      "category": "MassEntityView",
      "signature": "TryMakeView(Entity Manager, Entity)",
      "params": [
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        },
        {
          "name": "Entity",
          "type": "FMassEntityHandle"
        }
      ],
      "returnType": "FMassEntityView",
      "docs": "If the given handle represents a valid entity the function will create a FMassEntityView just like a constructor\nwould. If the entity is not valid the produced view will be \"unset\"."
    },
