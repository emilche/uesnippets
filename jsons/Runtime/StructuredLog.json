    {
      "id": "convert-to-common-log",
      "name": "ConvertToCommonLog",
      "category": "StructuredLog",
      "signature": "ConvertToCommonLog(Target, Out Format, Out Fields)",
      "params": [
        {
          "name": "Target",
          "type": "FLogRecord*"
        },
        {
          "name": "Out Format",
          "type": "FUtf8StringBuilderBase&"
        },
        {
          "name": "Out Fields",
          "type": "FCbWriter&"
        }
      ],
      "returnType": "Void",
      "docs": "Converts this record into a common format string and compatible fields.\nThe common format string uses '{{' as a literal '{' and uses as a literal '}}'.\nThe common format string contains no format specifiers or format argument modifiers.\nThe common format string uses field names matching [A-Za-z0-9_]+.\nWhen a compatible field is an object, it will have a string field named $text containing the formatted value.\nA compatible field will never be an array.\n@param OutFormat   Appended with a transformed version of the format from Template.\n@param OutFields   Must be within an object scope. Appended with a compatible version of Fields."
    },
    {
      "id": "dispatch-dynamic-log-record",
      "name": "DispatchDynamicLogRecord",
      "category": "StructuredLog",
      "signature": "DispatchDynamicLogRecord(Record)",
      "params": [
        {
          "name": "Record",
          "type": "FLogRecord&"
        }
      ],
      "returnType": "Void",
      "docs": "Advanced function to dispatch a log record to active output devices.\nAlways use UE_LOGFMT or its variants when possible.\nDynamic dispatch bypasses many optimizations provided by the macros.\nAnything pointed to by the record MUST remain valid until threaded logs have been flushed.\nFiltering by category or verbosity is the responsibility of the caller.\nActive log contexts will not be added to this record. If they are needed that is the responsibility of the caller."
    },
    {
      "id": "visit-log-context",
      "name": "VisitLogContext",
      "category": "StructuredLog",
      "signature": "VisitLogContext(Visitor)",
      "params": [
        {
          "name": "Visitor",
          "type": "TFunctionRef<void ( FCbField& )>"
        }
      ],
      "returnType": "Void",
      "docs": "Advanced function to visit the log contexts for the calling thread.\nInvokes the visitor once for each context, in order from the oldest context added on this thread to the newest.\nIf there are multiple contexts with the same name, only the newest will be visited."
    },
