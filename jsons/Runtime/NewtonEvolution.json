      "id": "f-newton-evolution",
      "name": "FNewtonEvolution",
      "category": "NewtonEvolution",
      "signature": "FNewtonEvolution(In Particles, In Geometry Particles, Collision Triangles, In Mesh, In Incident Elements, Num Newton Iterations, Num CG Iterations, Constrained Vertices, BC Positions, Collision Thickness, Self Collisions Thickness, Coefficient Of Friction, Damping, Local Damping, E Mesh, Nu Mesh, Newton Tol, CG Tol In, Write Debug Info In)",
      "params": [
        {
          "name": "In Particles",
          "type": "FSolverParticles&&"
        },
        {
          "name": "In Geometry Particles",
          "type": "FSolverCollisionParticles&&"
        },
        {
          "name": "Collision Triangles",
          "type": "TArray<TVec3<int32>>&&"
        },
        {
          "name": "In Mesh",
          "type": "TArray<TVector<int32,4>>&"
        },
        {
          "name": "In Incident Elements",
          "type": "TArray<TArray<TVector<int32,2>>>&&"
        },
        {
          "name": "Num Newton Iterations",
          "type": "Int",
          "default": "5"
        },
        {
          "name": "Num CG Iterations",
          "type": "Int",
          "default": "20"
        },
        {
          "name": "Constrained Vertices",
          "type": "TArray<int32>&",
          "default": "TArray<int32>()"
        },
        {
          "name": "BC Positions",
          "type": "TArray<FSolverVec3>&",
          "default": "TArray<FSolverVec3>()"
        },
        {
          "name": "Collision Thickness",
          "type": "FSolverReal",
          "default": "(FSolverReal)0."
        },
        {
          "name": "Self Collisions Thickness",
          "type": "FSolverReal",
          "default": "(FSolverReal)0."
        },
        {
          "name": "Coefficient Of Friction",
          "type": "FSolverReal",
          "default": "(FSolverReal)0."
        },
        {
          "name": "Damping",
          "type": "FSolverReal",
          "default": "(FSolverReal)0.04"
        },
        {
          "name": "Local Damping",
          "type": "FSolverReal",
          "default": "(FSolverReal)0."
        },
        {
          "name": "E Mesh",
          "type": "FSolverReal",
          "default": "(FSolverReal)1000."
        },
        {
          "name": "Nu Mesh",
          "type": "FSolverReal",
          "default": "(FSolverReal).3"
        },
        {
          "name": "Newton Tol",
          "type": "FSolverReal",
          "default": "(FSolverReal) 1e-6"
        },
        {
          "name": "CG Tol In",
          "type": "FSolverReal",
          "default": "(FSolverReal) 1e-8"
        },
        {
          "name": "Write Debug Info In",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "public :"
    },
