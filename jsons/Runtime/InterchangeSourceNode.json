    {
      "id": "get-custom-use-asset-type-sub-path-suffix",
      "name": "GetCustomUseAssetTypeSubPathSuffix",
      "category": "Interchange ",
      "signature": "GetCustomUseAssetTypeSubPathSuffix(Target, Suffix)",
      "params": [
        {
          "name": "Target",
          "type": "UInterchangeSourceNode*"
        },
        {
          "name": "Suffix",
          "type": "Bool&"
        }
      ],
      "returnType": "Bool",
      "docs": "Gets whether factory nodes for this import should have a suffix named after their asset category added to their\ncustom sub path attribute. For example, if this is set then imported StaticMesh assets will be placed inside of\nan additional content folder named \"StaticMeshes\".\nNote that this is done automatically for all factory nodes created by the generic assets pipeline, but must be\nhandled manually by calling FillSubPathFromSourceNode() from InterchangePipelineHelper.h for any factory nodes\nthat other pipelines may create."
    },
