    {
      "id": "populate-linearized-items",
      "name": "PopulateLinearizedItems",
      "category": "STreeView",
      "signature": "PopulateLinearizedItems(Target, In Items Source, In Linearized Items, New Dense Item Infos, Needs Parent Wire, Out New Selected Items, New Sparse Item Info, Adding Items, Parent Index)",
      "params": [
        {
          "name": "Target",
          "type": "STreeView*"
        },
        {
          "name": "In Items Source",
          "type": "TArrayView<ItemType>"
        },
        {
          "name": "In Linearized Items",
          "type": "TArray<ItemType>&"
        },
        {
          "name": "New Dense Item Infos",
          "type": "TArray<FItemInfo>&"
        },
        {
          "name": "Needs Parent Wire",
          "type": "TBitArray<>"
        },
        {
          "name": "Out New Selected Items",
          "type": "TItemSet&"
        },
        {
          "name": "New Sparse Item Info",
          "type": "TSparseItemMap&"
        },
        {
          "name": "Adding Items",
          "type": "Bool"
        },
        {
          "name": "Parent Index",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "Given: an array of items (ItemsSource) each of which potentially has a child.\nTask: populate the LinearizedItems array with a flattened version of the visible data items.\nIn the process, remove any items that are not visible while maintaining any collapsed\nitems that may have expanded children.\n@param ItemsSource          An array of data items each of which may have 0 or more children.\n@param LinearizedItems      Array to populate with items based on expanded/collapsed state.\n@param NewDenseItemInfos    Array representing how nested each item in the Linearized items is, and whether it has children.\n@param TreeLevel            The current level of indentation.\n@param OutNewSelectedItems  Selected items minus any items that are no longer observed by the list.\n@param NewSparseItemInfo    Expanded items and items that have expanded children minus any items that are no longer observed by the list.\n@param bAddingItems         Are we adding encountered items to the linearized items list or just testing them for existence.\n@param ParentIndex\t\t   The index in the resulting linearized item list of the parent node for the currently processed level.\n@return true if we encountered expanded children; false otherwise."
    },
