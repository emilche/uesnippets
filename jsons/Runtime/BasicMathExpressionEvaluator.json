{
  "id": "basic-math-expression-evaluator",
  "label": "BasicMathExpressionEvaluator",
  "includepath": "Math/BasicMathExpressionEvaluator.h",
  "includes": [
    "CoreTypes",
    "FastDecimalFormat",
    "ExpressionParserTypes",
    "Optional",
    "ValueOrError"
  ],
  "functions": [
    {
      "id": "evaluate",
      "name": "Evaluate",
      "category": "BasicMathExpressionEvaluator",
      "signature": "Evaluate(Target, In Expression, In Existing Value)",
      "params": [
        {
          "name": "Target",
          "type": "FBasicMathExpressionEvaluator*"
        },
        {
          "name": "In Expression",
          "type": "TCHAR*"
        },
        {
          "name": "In Existing Value",
          "type": "Double",
          "default": "0"
        }
      ],
      "returnType": "nodiscard ] ] TValueOrError<double,FExpressionError>",
      "docs": "Evaluate the given expression, resulting in either a double value, or an error"
    },
    {
      "id": "define-arithmetic-tokens",
      "name": "DefineArithmeticTokens",
      "category": "BasicMathExpressionEvaluator",
      "signature": "DefineArithmeticTokens(Token Definitions)",
      "params": [
        {
          "name": "Token Definitions",
          "type": "FTokenDefinitions&"
        }
      ],
      "returnType": "Void",
      "docs": "Utils that can be re-used as part of more complex evaluators\nNote precedences are 3-5 for power/multiplicative/additive"
    },
    {
      "id": "define-arithmetic-operators",
      "name": "DefineArithmeticOperators",
      "category": "BasicMathExpressionEvaluator",
      "signature": "DefineArithmeticOperators(Token Definitions)",
      "params": [
        {
          "name": "Token Definitions",
          "type": "FExpressionGrammar&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "map-arithmetic-operators",
      "name": "MapArithmeticOperators",
      "category": "BasicMathExpressionEvaluator",
      "signature": "MapArithmeticOperators(Jump Table)",
      "params": [
        {
          "name": "Jump Table",
          "type": "FOperatorJumpTable&"
        }
      ],
      "returnType": "Void"
    }
  ]
}