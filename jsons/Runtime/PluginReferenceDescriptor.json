      "id": "f-plugin-reference-descriptor",
      "name": "FPluginReferenceDescriptor",
      "category": "PluginReferenceDescriptor",
      "signature": "FPluginReferenceDescriptor(In Name, In Enabled)",
      "params": [
        {
          "name": "In Name",
          "type": "String&",
          "default": "TEXT(\"\")"
        },
        {
          "name": "In Enabled",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Descriptor for a plugin reference. Contains the information required to enable or disable a plugin for a given platform."
    },
    {
      "id": "is-enabled-for-platform",
      "name": "IsEnabledForPlatform",
      "category": "PluginReferenceDescriptor",
      "signature": "IsEnabledForPlatform(Target, Platform)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginReferenceDescriptor*"
        },
        {
          "name": "Platform",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines whether the plugin is enabled for the given platform"
    },
    {
      "id": "is-enabled-for-target-configuration",
      "name": "IsEnabledForTargetConfiguration",
      "category": "PluginReferenceDescriptor",
