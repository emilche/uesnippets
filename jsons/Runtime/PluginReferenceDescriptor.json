      "docs": "Determines whether the plugin is enabled for the given target"
    },
    {
      "id": "is-supported-target-platform",
      "name": "IsSupportedTargetPlatform",
      "category": "PluginReferenceDescriptor",
      "signature": "IsSupportedTargetPlatform(Target, Platform)",
      "params": [
        {
          "name": "Target",
          "type": "FPluginReferenceDescriptor*"
        },
        {
          "name": "Platform",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Determines if the referenced plugin is supported for the given platform"
