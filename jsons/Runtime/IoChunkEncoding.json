    {
      "id": "decode-block",
      "name": "DecodeBlock",
      "category": "IoChunkEncoding",
      "signature": "DecodeBlock(Params, Encoded Block, Out Decoded Block)",
      "params": [
        {
          "name": "Params",
          "type": "FIoChunkBlockDecodingParams"
        },
        {
          "name": "Encoded Block",
