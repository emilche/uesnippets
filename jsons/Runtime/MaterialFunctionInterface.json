    {
      "id": "is-dependent",
      "name": "IsDependent",
      "category": "MaterialFunctionInterface",
      "signature": "IsDependent(Target, False)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunctionInterface*"
        },
        {
          "name": "False",
          "type": "UMaterialFunctionInterface* OtherFunction ) PURE_VIRTUAL ( UMaterialFunctionInterface::IsDependent,return"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if this function is dependent on the passed in function, directly or indirectly."
    },
    {
      "id": "iterate-dependent-functions",
      "name": "IterateDependentFunctions",
      "category": "MaterialFunctionInterface",
      "signature": "IterateDependentFunctions(Target, False)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunctionInterface*"
        },
        {
          "name": "False",
          "type": "TFunctionRef<bool ( UMaterialFunctionInterface* )> Predicate ) PURE_VIRTUAL ( UMaterialFunctionInterface::IterateDependentFunctions,return"
        }
      ],
      "returnType": "Bool",
      "docs": "Iterates all functions that this function is dependent on, directly or indrectly.\n@param Predicate a visitor predicate returning true to continue iteration, false to break\n@return true if all dependent functions were visited, false if the Predicate did break iteration"
    },
    {
      "id": "get-dependent-functions",
      "name": "GetDependentFunctions",
      "category": "MaterialFunctionInterface",
      "signature": "GetDependentFunctions(Target, Get Dependent Functions)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialFunctionInterface*"
        },
        {
          "name": "Get Dependent Functions",
          "type": "TArray<UMaterialFunctionInterface*>& DependentFunctions ) PURE_VIRTUAL ( UMaterialFunctionInterface::"
        }
      ],
      "returnType": "Void",
      "docs": "Returns an array of the functions that this function is dependent on, directly or indirectly."
    },
    {
      "id": "get-user-exposed-caption",
