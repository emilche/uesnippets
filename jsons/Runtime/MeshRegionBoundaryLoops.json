        }
      ],
      "returnType": "Int",
      "docs": "@return index of loop with maximum number of vertices"
    },
    {
      "id": "get-loop-overlay-map",
      "name": "GetLoopOverlayMap",
      "category": "MeshRegionBoundaryLoops",
      "signature": "GetLoopOverlayMap(Target, Loop In, Overlay, Loop Vids To Overlay Elements Out)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRegionBoundaryLoops*"
        },
        {
          "name": "Loop In",
          "type": "FEdgeLoop&"
        },
        {
          "name": "Overlay",
          "type": "TDynamicMeshOverlay<StorageType,ElementSize>&"
        },
        {
          "name": "Loop Vids To Overlay Elements Out",
          "type": "VidOverlayMap<ElementType>&"
        }
      ],
      "returnType": "template<StorageType,int ElementSize,ElementType> bool",
      "docs": "Generates a map from vertex ID's of the loop vertices to corresponding overlay element ID's\nand values. The elements chosen are those associated with the internal triangle whose\nedge goes out of that vertex in the loop direction.\nThe function is useful in cases where the triangles inside the loop will be deleted and replaced,\nand we want to keep the same UV's on the border vertices.\nDoes not clear LoopVidsToOverlayElementsOut before use (simply adds to it), so could\nbe used for multiple loops.\n@returns false if there is an error (if the overlay does not have an element for one of the vids)"
    },
    {
      "id": "update-loop-overlay-map-validity",
      "name": "UpdateLoopOverlayMapValidity",
      "category": "MeshRegionBoundaryLoops",
      "signature": "UpdateLoopOverlayMapValidity(Target, Loop Vids To Overlay Elements, Overlay)",
      "params": [
        {
          "name": "Target",
          "type": "FMeshRegionBoundaryLoops*"
        },
        {
          "name": "Loop Vids To Overlay Elements",
          "type": "VidOverlayMap<ElementType>&"
        },
        {
          "name": "Overlay",
          "type": "TDynamicMeshOverlay<StorageType,ElementSize>&"
        }
      ],
      "returnType": "template<StorageType,int ElementSize,ElementType> void",
      "docs": "Given a map generated by GetLoopOverlayMap(), checks that the overlay elements pointed to by the\nmap still exist in the overlay, and sets the ID to be invalid if not.\nThis can be called after deleting the triangles inside a loop to update the generated map\nand remove any UV elements that no longer exist (because the vertex was on a UV seam)."
    },
    {
      "id": "get-triangle-set-boundary-loop",
      "name": "GetTriangleSetBoundaryLoop",
      "category": "MeshRegionBoundaryLoops",
      "signature": "GetTriangleSetBoundaryLoop(Mesh, Tris, Loop)",
      "params": [
        {
          "name": "Mesh",
          "type": "FDynamicMesh3&"
        },
        {
          "name": "Tris",
          "type": "TArray<int32>&"
        },
        {
          "name": "Loop",
          "type": "FEdgeLoop&"
        }
      ],
      "returnType": "Bool",
      "docs": "Find the edge loop border around a set of triangles of a Mesh.\nThis is computed via local walk and so does not create any full-mesh data structures.\nHowever current implementation may not be efficient for large triangle sets.\nAlgorithm terminates if a non-manifold boundary is detected, and returns false if some triangles are unused.\n@param Loop output loop will be stored here. This value is garbage if false is returned.\n@return true if a single well-formed loop was found, false if non-manifold or failure case encountered"
    },
