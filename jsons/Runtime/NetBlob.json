      "category": "NetBlob",
      "signature": "SetState(Target, Blob Descriptor, Quantized Blob State)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Blob Descriptor",
          "type": "TRefCountPtr<FReplicationStateDescriptor>&"
        },
        {
          "name": "Quantized Blob State",
          "type": "FQuantizedBlobState&&"
        }
      ],
      "returnType": "Void",
      "docs": "Set the blob state. Use when there's a descriptor to avoid having to override serialization functions."
    },
    {
      "id": "serialize-creation-info",
      "name": "SerializeCreationInfo",
      "category": "NetBlob",
      "signature": "SerializeCreationInfo(Context, Creation Info)",
      "params": [
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Creation Info",
          "type": "FNetBlobCreationInfo&"
        }
      ],
      "returnType": "Void",
      "docs": "Serializes the necessary parts of the creation info so that the blob can be recreated on the receiving side."
    },
    {
      "id": "deserialize-creation-info",
      "name": "DeserializeCreationInfo",
      "category": "NetBlob",
      "signature": "DeserializeCreationInfo(Context, Out Creation Info)",
      "params": [
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Out Creation Info",
          "type": "FNetBlobCreationInfo&"
        }
      ],
      "returnType": "Void",
      "docs": "Deserializes the necessary parts of the creation info so that the correct blob can be created."
    },
    {
