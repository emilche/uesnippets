    {
      "id": "deserialize-with-object",
      "name": "DeserializeWithObject",
      "category": "NetBlob",
      "signature": "DeserializeWithObject(Target, Context, Ref Handle)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Ref Handle",
          "type": "FNetRefHandle"
        }
