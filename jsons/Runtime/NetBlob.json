    {
      "id": "serialize",
      "name": "Serialize",
      "category": "NetBlob",
      "signature": "Serialize(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Serialize the blob."
    },
    {
      "id": "deserialize",
      "name": "Deserialize",
      "category": "NetBlob",
      "signature": "Deserialize(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        }
      ],
      "returnType": "Void",
      "docs": "Deserialize a blob that was serialized with Serialize."
