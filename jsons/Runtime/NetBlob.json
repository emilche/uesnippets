    {
      "id": "collect-object-references",
      "name": "CollectObjectReferences",
      "category": "NetBlob",
      "signature": "CollectObjectReferences(Target, Context, Collector)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Collector",
          "type": "FNetReferenceCollector&"
        }
      ],
      "returnType": "Void",
      "docs": "Collect object references from quantized data"
    },
    {
      "id": "release",
      "name": "Release",
      "category": "NetBlob",
      "signature": "Release(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes a reference. When the reference count reaches zero the blob will be deleted. A blob is created with reference count zero."
