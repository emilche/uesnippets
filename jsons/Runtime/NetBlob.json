      "params": [
        {
          "name": "Target",
          "type": "FNetBlob*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Ref Handle",
          "type": "FNetRefHandle"
        }
      ],
