{
  "id": "level-script-actor",
  "label": "LevelScriptActor",
  "includepath": "Engine/LevelScriptActor.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Actor",
    "LevelScriptActor.generated"
  ],
  "functions": [
    {
      "id": "remote-event",
      "name": "RemoteEvent",
      "category": "Miscellaneous",
      "signature": "RemoteEvent(Target, Event Name)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        },
        {
          "name": "Event Name",
          "type": "Name"
        }
      ],
      "returnType": "Bool",
      "docs": "Tries to find an event named \"EventName\" on all other levels, and calls it"
    },
    {
      "id": "set-cinematic-mode",
      "name": "SetCinematicMode",
      "category": "Game",
      "signature": "SetCinematicMode(Target, Cinematic Mode, Hide Player, Affects HUD, Affects Movement, Affects Turning)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        },
        {
          "name": "Cinematic Mode",
          "type": "Bool"
        },
        {
          "name": "Hide Player",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Affects HUD",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Affects Movement",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Affects Turning",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the cinematic mode on all PlayerControllers\n@param\tbInCinematicMode\tspecify true if the player is entering cinematic mode; false if the player is leaving cinematic mode.\n@param\tbHidePlayer\t\t\tspecify true to hide the player's pawn (only relevant if bInCinematicMode is true)\n@param\tbAffectsHUD\t\t\tspecify true if we should show/hide the HUD to match the value of bCinematicMode\n@param\tbAffectsMovement\tspecify true to disable movement in cinematic mode, enable it when leaving\n@param\tbAffectsTurning\t\tspecify true to disable turning in cinematic mode or enable it when leaving"
    },
    {
      "id": "level-reset",
      "name": "LevelReset",
      "category": "LevelScriptActor",
      "signature": "LevelReset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        }
      ],
      "returnType": "Void",
      "docs": "@todo document"
    },
    {
      "id": "world-origin-location-changed",
      "name": "WorldOriginLocationChanged",
      "category": "LevelScriptActor",
      "signature": "WorldOriginLocationChanged(Target, Old Origin Location, New Origin Location)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        },
        {
          "name": "Old Origin Location",
          "type": "FIntVector"
        },
        {
          "name": "New Origin Location",
          "type": "FIntVector"
        }
      ],
      "returnType": "Void",
      "docs": "Event called on world origin location changes\n@param\tOldOriginLocation\tPrevious world origin location\n@param\tNewOriginLocation\tNew world origin location"
    },
    {
      "id": "pre-initialize-components",
      "name": "PreInitializeComponents",
      "category": "LevelScriptActor",
      "signature": "PreInitializeComponents(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "enable-input",
      "name": "EnableInput",
      "category": "LevelScriptActor",
      "signature": "EnableInput(Target, Player Controller)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        },
        {
          "name": "Player Controller",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "disable-input",
      "name": "DisableInput",
      "category": "LevelScriptActor",
      "signature": "DisableInput(Target, Player Controller)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        },
        {
          "name": "Player Controller",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "find-sibling-level-script-actors",
      "name": "FindSiblingLevelScriptActors",
      "category": "LevelScriptActor",
      "signature": "FindSiblingLevelScriptActors(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ALevelScriptActor*"
        }
      ],
      "returnType": "TArray<ALevelScriptActor*>",
      "docs": "Utility function for finding a map corruption issue that can cause duplicate level scripting events"
    }
  ]
}