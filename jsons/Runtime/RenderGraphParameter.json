    {
      "id": "get-render-pass-info-681419",
      "name": "GetRenderPassInfo",
      "category": "RenderGraphParameter",
      "signature": "GetRenderPassInfo(Parameters)",
      "params": [
        {
          "name": "Parameters",
          "type": "TParameterStruct*"
        }
      ],
      "returnType": "template<TParameterStruct> FRHIRenderPassInfo",
      "docs": "Helper function to get RHI render pass info from a pass parameter struct. Must be called\nwithin an RDG pass with the pass parameters; otherwise, the RHI access checks will assert.\nThis helper is useful when you want to control the mechanics of render passes within an\nRDG raster pass by specifying 'SkipRenderPass'."
    },
