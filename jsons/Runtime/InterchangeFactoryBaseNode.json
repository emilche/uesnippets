    {
      "id": "should-skip-node-import",
      "name": "ShouldSkipNodeImport",
      "category": "Interchange ",
      "signature": "ShouldSkipNodeImport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInterchangeFactoryBaseNode*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true if this node should skip the factory import process, or false otherwise.\nNodes can be in a situation where we have to skip the import process because we cannot import the associated asset for multiple reasons. For example:\n- An asset can already exist and represents a different type (UClass).\n- An asset can already exist and is being compiled.\n- An asset can already exist and is being imported by another concurrent import task (such as a user importing multiple files at the same time in the same content folder)."
    },
    {
      "id": "set-skip-node-import",
      "name": "SetSkipNodeImport",
      "category": "Interchange ",
      "signature": "SetSkipNodeImport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInterchangeFactoryBaseNode*"
        }
      ],
      "returnType": "Bool",
      "docs": "Add the skip node attribute. Use this function to cancel the creation of the Unreal asset. See ShouldSkipNodeImport for more documentation."
    },
