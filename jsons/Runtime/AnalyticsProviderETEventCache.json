      "category": "AnalyticsProviderETEventCache",
      "signature": "GetSetPreallocatedPayloadSize(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAnalyticsProviderETEventCache*"
        }
      ],
      "returnType": "Int",
      "docs": "Gets the preallocated size of the payload buffer."
    },
