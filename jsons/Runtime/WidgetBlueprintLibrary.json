        },
        {
          "name": "Flush Input",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Setup an input mode that allows only player input / player controller to respond to user input.\nNote: Any bound Input Events in this widget will be called."
