    },
    {
      "id": "draw-spline",
      "name": "DrawSpline",
      "category": "Painting",
      "signature": "DrawSpline(Context, Start, Start Dir, End, End Dir, Tint, Thickness)",
      "params": [
        {
          "name": "Context",
          "type": "FPaintContext&"
        },
        {
          "name": "Start",
          "type": "FVector2D"
        },
        {
          "name": "Start Dir",
          "type": "FVector2D"
        },
        {
          "name": "End",
          "type": "FVector2D"
        },
        {
          "name": "End Dir",
          "type": "FVector2D"
        },
        {
          "name": "Tint",
          "type": "FLinearColor",
          "default": "FLinearColor::White"
        },
        {
          "name": "Thickness",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Draws a hermite spline.\n@param Start\t\t\tStarting position of the spline in local space.\n@param StartDir\t\tThe direction of the spline from the start point.\n@param End\t\t\tEnding position of the spline in local space.\n@param EndDir\t\tThe direction of the spline to the end point.\n@param Tint\t\t\tColor to render the spline.\n@param Thickness\t\tHow many pixels thick this spline should be."
    },
    {
      "id": "draw-line",
      "name": "DrawLine",
      "category": "Painting",
      "signature": "DrawLine(Context, Position A, Position B, Tint, Anti Alias, Thickness)",
      "params": [
        {
          "name": "Context",
          "type": "FPaintContext&"
        },
        {
          "name": "Position A",
          "type": "FVector2D"
        },
        {
          "name": "Position B",
          "type": "FVector2D"
        },
        {
          "name": "Tint",
          "type": "FLinearColor",
          "default": "FLinearColor::White"
        },
        {
          "name": "Anti Alias",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Thickness",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Draws a line.\n@param PositionA\t\tStarting position of the line in local space.\n@param PositionB\t\tEnding position of the line in local space.\n@param Tint\t\t\tColor to render the line.\n@param bAntialias\tWhether the line should be antialiased.\n@param Thickness\t\tHow many pixels thick this line should be."
    },
    {
      "id": "draw-lines",
      "name": "DrawLines",
      "category": "Painting",
      "signature": "DrawLines(Context, Points, Tint, Anti Alias, Thickness)",
      "params": [
        {
          "name": "Context",
          "type": "FPaintContext&"
        },
        {
          "name": "Points",
          "type": "TArray<FVector2D>&"
        },
        {
          "name": "Tint",
          "type": "FLinearColor",
          "default": "FLinearColor::White"
        },
        {
          "name": "Anti Alias",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Thickness",
          "type": "Float",
          "default": "1.0f"
        }
      ],
      "returnType": "Void",
      "docs": "Draws several line segments.\n@param Points\t\tLine pairs, each line needs to be 2 separate points in the array.\n@param Tint\t\t\tColor to render the line.\n@param bAntialias\tWhether the line should be antialiased.\n@param Thickness\t\tHow many pixels thick this line should be."
    },
    {
      "id": "draw-text",
      "name": "DrawText",
      "category": "Painting",
      "signature": "DrawText(Context, In String, Position, Tint)",
      "params": [
