          "default": "FLinearColor::White"
        }
      ],
      "returnType": "Void",
      "docs": "Draws text.\n@param InString\t\tThe string to draw.\n@param Position\t\tThe starting position where the text is drawn in local space.\n@param Tint\t\t\tColor to render the line."
    },
    {
      "id": "draw-text-formatted",
