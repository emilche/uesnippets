    {
      "id": "create",
      "name": "Create",
      "category": "Widget",
      "signature": "Create(World Context Object, Widget Type, Owning Player)",
      "params": [
        {
          "name": "World Context Object",
          "type": "UObject*"
        },
        {
          "name": "Widget Type",
          "type": "TSubclassOf<UUserWidget>"
        },
        {
          "name": "Owning Player",
          "type": "APlayerController*"
        }
      ],
      "returnType": "class UFont",
      "docs": "Creates a widget"
    },
    {
      "id": "create-drag-drop-operation",
      "name": "CreateDragDropOperation",
      "category": "Widget",
      "signature": "CreateDragDropOperation(Operation Class)",
      "params": [
        {
          "name": "Operation Class",
          "type": "TSubclassOf<UDragDropOperation>"
        }
      ],
      "returnType": "UDragDropOperation*",
      "docs": "Creates a new drag and drop operation that can be returned from a drag begin to inform the UI what i\nbeing dragged and dropped and what it looks like."
    },
    {
      "id": "set-input-mode-ui-only-ex",
      "name": "SetInputMode_UIOnlyEx",
      "category": "Input",
      "signature": "SetInputMode_UIOnlyEx(Player Controller, In Widget To Focus, In Mouse Lock Mode, Flush Input)",
      "params": [
        {
          "name": "Player Controller",
          "type": "APlayerController*"
        },
        {
          "name": "In Widget To Focus",
          "type": "UWidget*",
          "default": "nullptr"
        },
        {
          "name": "In Mouse Lock Mode",
          "type": "EMouseLockMode",
          "default": "EMouseLockMode::DoNotLock"
        },
        {
          "name": "Flush Input",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Setup an input mode that allows only the UI to respond to user input.\nNote: This means that any bound Input Events in the widget will not be called!"
    },
    {
      "id": "set-input-mode-game-and-ui-ex",
      "name": "SetInputMode_GameAndUIEx",
      "category": "Input",
      "signature": "SetInputMode_GameAndUIEx(Player Controller, In Widget To Focus, In Mouse Lock Mode, Hide Cursor During Capture, Flush Input)",
      "params": [
        {
          "name": "Player Controller",
          "type": "APlayerController*"
        },
        {
          "name": "In Widget To Focus",
          "type": "UWidget*",
          "default": "nullptr"
        },
        {
          "name": "In Mouse Lock Mode",
          "type": "EMouseLockMode",
          "default": "EMouseLockMode::DoNotLock"
        },
        {
          "name": "Hide Cursor During Capture",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Flush Input",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Setup an input mode that allows only the UI to respond to user input, and if the UI doesn't handle it player input / player controller gets a chance.\nNote: This means that any bound Input events in the widget will be called."
    },
    {
      "id": "set-input-mode-game-only",
