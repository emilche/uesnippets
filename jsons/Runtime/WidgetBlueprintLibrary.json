    {
      "id": "detect-drag",
      "name": "DetectDrag",
      "category": "Widget",
      "signature": "DetectDrag(Reply, Widget Detecting Drag, Drag Key)",
      "params": [
        {
          "name": "Reply",
          "type": "FEventReply&"
        },
        {
          "name": "Widget Detecting Drag",
          "type": "UWidget*"
        },
        {
          "name": "Drag Key",
          "type": "FKey"
        }
      ],
      "returnType": "FEventReply",
      "docs": "Ask Slate to detect if a user starts dragging in this widget later.  Slate internally tracks the movement\nand if it surpasses the drag threshold, Slate will send an OnDragDetected event to the widget.\n@param WidgetDetectingDrag  Detect dragging in this widget\n@param DragKey\t\t       This button should be pressed to detect the drag"
    },
    {
      "id": "detect-drag-if-pressed",
      "name": "DetectDragIfPressed",
      "category": "Widget",
      "signature": "DetectDragIfPressed(Pointer Event, Widget Detecting Drag, Drag Key)",
      "params": [
        {
          "name": "Pointer Event",
          "type": "FPointerEvent&"
        },
        {
          "name": "Widget Detecting Drag",
          "type": "UWidget*"
        },
        {
          "name": "Drag Key",
          "type": "FKey"
        }
      ],
      "returnType": "FEventReply",
      "docs": "Given the pointer event, emit the DetectDrag reply if the provided key was pressed.\nIf the DragKey is a touch key, that will also automatically work.\n@param PointerEvent\tThe pointer device event coming in.\n@param WidgetDetectingDrag  Detect dragging in this widget.\n@param DragKey\t\t       This button should be pressed to detect the drag, won't emit the DetectDrag FEventReply unless this is pressed."
    },
