{
  "id": "net-stats-utils",
  "label": "NetStatsUtils",
  "includepath": "Net/Core/Analytics/NetStatsUtils.h",
  "includes": [
    "ArrayView",
    "CoreMinimal",
    "CoreTypes",
    "Optional",
    "EnableIf",
    "Models",
    "limits"
  ],
  "functions": [
    {
      "id": "reset",
      "name": "Reset",
      "category": "NetStatsUtils",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FBinnedMovingValueBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets the accumulated bin/sample data.",
      "supportedTargets": [
        "FBinnedMovingValueBase*",
        "TBinnedDeltaMovingValue*"
      ]
    },
    {
      "id": "add-measurement",
      "name": "AddMeasurement",
      "category": "NetStatsUtils",
      "signature": "AddMeasurement(Target, Time Val, Value)",
      "params": [
        {
          "name": "Target",
          "type": "TBinnedMovingValue*"
        },
        {
          "name": "Time Val",
          "type": "Double"
        },
        {
          "name": "Value",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Inputs a measurement value and the approximate time it was measured.\n@param TimeVal\t\tThe time of the measurement.\n@param Value\t\t\tThe measurement value",
      "supportedTargets": [
        "TBinnedMovingValue*",
        "TBinnedDeltaMovingValue*"
      ]
    },
    {
      "id": "flush",
      "name": "Flush",
      "category": "NetStatsUtils",
      "signature": "Flush(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TBinnedMovingValue*"
        }
      ],
      "returnType": "Void",
      "docs": "Flushes a sample from the current bin values to the consumer.\nSince this is a moving value, none of the bins are reset when a sample is output (so the flushed sample can partially reflect old values),\nand the current bin will have been reset recently so it can be filled (so the flushed value may not reflect the full time period).\nThe user must consider whether this is accurate/suitable for their use case."
    },
    {
      "id": "num-bins",
      "name": "NumBins",
      "category": "NetStatsUtils",
      "signature": "NumBins(In Num Bins)",
      "params": [
        {
          "name": "In Num Bins",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "Alias for tracking a moving average. See TBinnedMovingValue."
    },
    {
      "id": "time-per-bin",
      "name": "TimePerBin",
      "category": "NetStatsUtils",
      "signature": "TimePerBin(In Bin Size)",
      "params": [
        {
          "name": "In Bin Size",
          "type": "Double"
        }
      ],
      "returnType": "Double"
    },
    {
      "id": "get-min",
      "name": "GetMin",
      "category": "NetStatsUtils",
      "signature": "GetMin(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Double",
      "docs": "Gets the minimum sample value encountered\n@return\tThe minimum sample value"
    },
    {
      "id": "get-max",
      "name": "GetMax",
      "category": "NetStatsUtils",
      "signature": "GetMax(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Double",
      "docs": "Gets the maximum sample value encountered\n@return\tThe maximum sample value"
    },
    {
      "id": "get-current",
      "name": "GetCurrent",
      "category": "NetStatsUtils",
      "signature": "GetCurrent(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Double",
      "docs": "Gets the current/latest sample value\n@return\tThe current sample value"
    },
    {
      "id": "get-avg",
      "name": "GetAvg",
      "category": "NetStatsUtils",
      "signature": "GetAvg(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Double",
      "docs": "Gets the average sample value\n@return\tThe average sample value"
    },
    {
      "id": "get-sum",
      "name": "GetSum",
      "category": "NetStatsUtils",
      "signature": "GetSum(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Double",
      "docs": "Gets the sum of all sample values tracked\n@return\tThe sum of samples"
    },
    {
      "id": "get-sample-count",
      "name": "GetSampleCount",
      "category": "NetStatsUtils",
      "signature": "GetSampleCount(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSampleMinMaxAvg*"
        }
      ],
      "returnType": "Int",
      "docs": "Gets the number of samples tracked\n@return\tThe number of samples"
    },
    {
      "id": "peek-measurement",
      "name": "PeekMeasurement",
      "category": "NetStatsUtils",
      "signature": "PeekMeasurement(Target, Time Val, Value)",
      "params": [
        {
          "name": "Target",
          "type": "TSampleMinMaxAvg*"
        },
        {
          "name": "Time Val",
          "type": "Double"
        },
        {
          "name": "Value",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Called by subclasses to let the consumer peek at individual measurements\n@param Value\t\tThe measurement value being collected for sampling"
    },
    {
      "id": "time-seconds",
      "name": "TimeSeconds",
      "category": "NetStatsUtils",
      "signature": "TimeSeconds(In Time Seconds)",
      "params": [
        {
          "name": "In Time Seconds",
          "type": "Int"
        }
      ],
      "returnType": "Int",
      "docs": "The time at which the last Min/Max averaging period started"
    }
  ]
}