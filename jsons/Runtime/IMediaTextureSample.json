      "returnType": "FMediaTextureTilingDescription",
      "docs": "Get tile information (number, size and border size) of the sample.\n@return TileInfo struct\n@note Default implementation provided as most samples will not feature tiles"
    },
    {
      "id": "should-apply-color-conversion",
      "name": "ShouldApplyColorConversion",
      "category": "IMediaTextureSample",
      "signature": "ShouldApplyColorConversion(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IMediaTextureSample*"
        }
      ],
      "returnType": "Bool",
      "docs": "Whether samples should be converted based on a mismatch with the working color space.\nIf this is false, samples will not go through the conversion process even if their encoding or chromaticity doesn't match the working color space."
    },
