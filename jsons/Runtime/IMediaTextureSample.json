  "functions": [
    {
      "id": "enum-to-string",
      "name": "EnumToString",
      "category": "IMediaTextureSample",
      "signature": "EnumToString(Target, In Sample Format)",
      "params": [
        {
          "name": "Target",
          "type": "IMediaTextureSample*"
        },
        {
          "name": "In Sample Format",
          "type": "EMediaTextureSampleFormat"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Available formats for media texture samples.\nDepending on the decoder, the pixel data of a media texture frame may be stored\nin one of the listed formats. Some of these may be supported natively by the\nrenderer, others may require a conversion step to a natively supported format.\nThe media texture sink is responsible for performing any necessary conversions.\nFor details on the various YUV packings see: https://www.fourcc.org/yuv.php"
    },
    {
      "id": "is-block-compressed-format",
      "name": "IsBlockCompressedFormat",
      "category": "IMediaTextureSample",
      "signature": "IsBlockCompressedFormat(In Sample Format)",
      "params": [
        {
          "name": "In Sample Format",
          "type": "EMediaTextureSampleFormat"
        }
      ],
      "returnType": "Bool"
    },
