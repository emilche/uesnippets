    {
      "id": "forward-input",
      "name": "ForwardInput",
      "category": "DataflowNode",
      "signature": "ForwardInput(Target, Context, Input Reference, Reference)",
      "params": [
        {
          "name": "Target",
          "type": "FDataflowNode*"
        },
        {
          "name": "Context",
          "type": "UE::Dataflow::FContext&"
        },
        {
          "name": "Input Reference",
          "type": "UE::Dataflow::FConnectionReference&"
        },
        {
          "name": "Reference",
          "type": "UE::Dataflow::FConnectionReference&"
        }
      ],
      "returnType": "Void",
      "docs": "ForwardInput(...)\nForward an input to this output.\nThis will not cache the value itself but cache a reference to the input connection cache entry.\nThis is memory efficient and do not require a runtime copy of the data.\nInput and output references must match in type.\nNote that forwarding an input never sets a default value when no input is connected, use SafeForwardInput instead.\n@param Context : The evaluation context that holds the data store.\n@param InputReference : Pointer to a input member of this node that needs to be forwarded.\n@param Reference : Pointer to a member of this node that corresponds with the output to set."
    },
    {
      "id": "set-array-element-from-input",
      "name": "SetArrayElementFromInput",
      "category": "DataflowNode",
      "signature": "SetArrayElementFromInput(Target, Context, Input Reference, Index, Output Reference)",
      "params": [
        {
          "name": "Target",
          "type": "FDataflowNode*"
        },
        {
          "name": "Context",
          "type": "UE::Dataflow::FContext&"
        },
        {
          "name": "Input Reference",
          "type": "UE::Dataflow::FConnectionReference&"
        },
        {
          "name": "Index",
          "type": "Int"
        },
        {
          "name": "Output Reference",
          "type": "void*"
        }
      ],
      "returnType": "Void",
      "docs": "This method extracts an element from the specified input at a specific index and set it as output to the specified output.\nWhen called, the input will be pulled as a result.\nIf the input is not an array or if the index is out of bounds, a null value will be set on the output (which will result in a default value when read from)"
    },
