{
  "id": "engine-analytics-session-summary",
  "label": "EngineAnalyticsSessionSummary",
  "includepath": "Analytics/EngineAnalyticsSessionSummary.h",
  "includes": [
    "CoreMinimal",
    "DateTime",
    "Optional",
    "Timespan"
  ],
  "functions": [
    {
      "id": "f-engine-analytics-session-summary",
      "name": "FEngineAnalyticsSessionSummary",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "FEngineAnalyticsSessionSummary(Storage, Monitor Process Id)",
      "params": [
        {
          "name": "Storage",
          "type": "TSharedPtr<IAnalyticsPropertyStore>"
        },
        {
          "name": "Monitor Process Id",
          "type": "UInt"
        }
      ],
      "returnType": "public :",
      "docs": "Collects engine events/stats and stores a summary on disk until reported by the analytics session summary manager."
    },
    {
      "id": "tick",
      "name": "Tick",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "Tick(Target, Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Ticks the session. This calls UpdateSessionProgress() at the configured update period which calls UpdateSessionProgressInternal() for derived classes."
    },
    {
      "id": "shutdown",
      "name": "Shutdown",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "Shutdown(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        }
      ],
      "returnType": "Void",
      "docs": "Shuts down the session, unregistering the callbacks and closing the session."
    },
    {
      "id": "low-drive-space-detected",
      "name": "LowDriveSpaceDetected",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "LowDriveSpaceDetected(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked by the engine when the user is running low on disk space.."
    },
    {
      "id": "update-session-progress",
      "name": "UpdateSessionProgress",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "UpdateSessionProgress(Target, Flush Async, Flush Timeout, Crashing)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "Flush Async",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Flush Timeout",
          "type": "FTimespan&",
          "default": "FTimespan::Zero()"
        },
        {
          "name": "Crashing",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "private : void",
      "docs": "Invoked periodically and during important events to update the session progression."
    },
    {
      "id": "on-crashing",
      "name": "OnCrashing",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "OnCrashing(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked when the engine is crashing.."
    },
    {
      "id": "on-terminate",
      "name": "OnTerminate",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "OnTerminate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked when the engine is requested to terminate."
    },
    {
      "id": "on-user-login-changed",
      "name": "OnUserLoginChanged",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "OnUserLoginChanged(Target, Logging In)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "Logging In",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked when the user is logging in or logging out. Only handles when the user logs out."
    },
    {
      "id": "on-user-activity",
      "name": "OnUserActivity",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "OnUserActivity(Target, User Activity)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "User Activity",
          "type": "FUserActivity&"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked when the user activity changes."
    },
    {
      "id": "on-vanilla-state-changed",
      "name": "OnVanillaStateChanged",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "OnVanillaStateChanged(Target, Is Vanilla)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "Is Vanilla",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Invoked if the engine detects some local changes.."
    },
    {
      "id": "update-external-process-reporter-state",
      "name": "UpdateExternalProcessReporterState",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "UpdateExternalProcessReporterState(Target, Quick Check)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        },
        {
          "name": "Quick Check",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Check on CRC and return true if its running state state changed (so that the change is persisted on disk)."
    },
    {
      "id": "update-debugger-states",
      "name": "UpdateDebuggerStates",
      "category": "EngineAnalyticsSessionSummary",
      "signature": "UpdateDebuggerStates(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FEngineAnalyticsSessionSummary*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns whether the debugger state changed."
    }
  ]
}