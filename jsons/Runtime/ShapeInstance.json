    {
      "id": "get-world-transform",
      "name": "GetWorldTransform",
      "category": "ShapeInstance",
      "signature": "GetWorldTransform(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FShapeInstanceExtended*"
        }
      ],
      "returnType": "FRigidTransform3",
      "docs": "An extended version of FShapeInstance (physics-thread shape instance data) that caches\nsome world-space state of the shape for use in collision detection. This extended data\nif only required for shapes that have a transform relative to the particle they are\nattached to. It helps by avoiding the need to recalculate the shape transform every\ntime it is needed in collision detection, which is once for each other shape we\nmay be in contact with.\nNOTE: keep size to a minimum. There can be millions of these in s scene."
    },
