    {
      "id": "f-scoped-class-dependency-gather-5c4584",
      "name": "FScopedClassDependencyGather",
      "category": "BlueprintSupport",
      "signature": "FScopedClassDependencyGather(Class To Gather, In Load Context)",
      "params": [
        {
          "name": "Class To Gather",
          "type": "UClass*"
        },
        {
          "name": "In Load Context",
          "type": "FUObjectSerializeContext*"
        }
      ],
      "returnType": "public :",
      "docs": "This is a helper struct that allows us to gather all previously unloaded class dependencies of a UClass\nThe first time we create a new UClass object in FLinkerLoad::CreateExport(), we register it as a dependency\nauthority. Any subsequent UClasses that are created for the first time during the preload of that class are\nadded to the list as potential cyclic referencers.  We then step over the list at the end of the load, and\nrecompile any classes that may depend on each other a second time to ensure that that functions and properties\nare properly resolved"
    },
    {
      "id": "f-scoped-class-dependency-gather-7389a7",
      "name": "FScopedClassDependencyGather",
      "category": "BlueprintSupport",
      "signature": "FScopedClassDependencyGather()",
      "params": [],
      "returnType": "Void",
      "docs": "Whether or not this dependency gather is the dependency authoritative class, and thus should process all dependencies in the destructor"
    },
