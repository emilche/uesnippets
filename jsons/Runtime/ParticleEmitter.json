      "id": "auto-populate-instance-properties",
      "name": "AutoPopulateInstanceProperties",
      "category": "ParticleEmitter",
      "signature": "AutoPopulateInstanceProperties(Target, P Sys Comp)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "P Sys Comp",
          "type": "UParticleSystemComponent*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-lod-level",
      "name": "CreateLODLevel",
      "category": "ParticleEmitter",
      "signature": "CreateLODLevel(Target, LOD Level, Generate Module Data)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "LOD Level",
          "type": "Int"
        },
        {
          "name": "Generate Module Data",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Int",
      "docs": "CreateLODLevel\nCreates the given LOD level.\nIntended for editor-time usage.\nAssumes that the given LODLevel will be in the [0..100] range.\n@return The index of the created LOD level"
    },
    {
      "id": "is-lod-level-valid",
      "name": "IsLODLevelValid",
      "category": "ParticleEmitter",
      "signature": "IsLODLevelValid(Target, LOD Level)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "LOD Level",
          "type": "Int"
        }
      ],
      "returnType": "Bool",
      "docs": "IsLODLevelValid\nReturns true if the given LODLevel is one of the array entries.\nIntended for editor-time usage.\nAssumes that the given LODLevel will be in the [0..(NumLODLevels - 1)] range.\n@return false if the requested LODLevel is not valid.\ntrue if the requested LODLevel is valid."
    },
    {
      "id": "get-current-lod-level",
      "name": "GetCurrentLODLevel",
      "category": "ParticleEmitter",
      "signature": "GetCurrentLODLevel(Target, Instance)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "Instance",
          "type": "FParticleEmitterInstance*"
        }
      ],
      "returnType": "UParticleLODLevel*",
      "docs": "GetCurrentLODLevel\nReturns the currently set LODLevel. Intended for game-time usage.\nAssumes that the given LODLevel will be in the [0..# LOD levels] range.\n@return NULL if the requested LODLevel is not valid.\nThe pointer to the requested UParticleLODLevel if valid."
    },
    {
      "id": "editor-update-current-lod",
      "name": "EditorUpdateCurrentLOD",
      "category": "ParticleEmitter",
      "signature": "EditorUpdateCurrentLOD(Target, Instance)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "Instance",
          "type": "FParticleEmitterInstance*"
        }
      ],
      "returnType": "Void",
      "docs": "This will update the LOD of the particle in the editor.\n@see GetCurrentLODLevel(FParticleEmitterInstance* Instance)"
    },
    {
      "id": "get-lod-level",
      "name": "GetLODLevel",
      "category": "ParticleEmitter",
      "signature": "GetLODLevel(Target, LOD Level)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "LOD Level",
          "type": "Int"
        }
      ],
      "returnType": "UParticleLODLevel*",
      "docs": "GetLODLevel\nReturns the given LODLevel. Intended for game-time usage.\nAssumes that the given LODLevel will be in the [0..# LOD levels] range.\n@param\tLODLevel - the requested LOD level in the range [0..# LOD levels].\n@return NULL if the requested LODLevel is not valid.\nThe pointer to the requested UParticleLODLevel if valid."
    },
    {
      "id": "has-any-enabled-lo-ds",
      "name": "HasAnyEnabledLODs",
      "category": "ParticleEmitter",
      "signature": "HasAnyEnabledLODs(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if the is emitter has any enabled LODs, false otherwise."
    },
    {
      "id": "is-significant",
      "name": "IsSignificant",
      "category": "ParticleEmitter",
      "signature": "IsSignificant(Target, Required Significance)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleEmitter*"
        },
        {
          "name": "Required Significance",
          "type": "EParticleSignificanceLevel"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns if this emitter is considered significant for the passed requirement."
    }
  ]
}