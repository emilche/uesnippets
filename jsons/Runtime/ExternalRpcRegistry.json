      "name": "RegisterNewRouteWithArguments",
      "category": "ExternalRpcRegistry",
      "signature": "RegisterNewRouteWithArguments(Target, Route Name, Http Path, Request Verbs, Handler, In Arguments, Override If Bound, Is Always On, Optional Category, Optional Content Type)",
      "params": [
        {
          "name": "Target",
          "type": "UExternalRpcRegistry*"
        },
        {
          "name": "Route Name",
          "type": "Name"
        },
