{
  "id": "lumen-hardware-ray-tracing-common",
  "label": "LumenHardwareRayTracingCommon",
  "includepath": "LumenHardwareRayTracingCommon.h",
  "includes": [
    "RHIDefinitions",
    "GlobalShader",
    "LumenTracingUtils",
    "RayTracingLighting",
    "RayTracing",
    "RayTracingPayloadType",
    "SceneTextureParameters",
    "Substrate"
  ],
  "functions": [
    {
      "id": "add-stochastic-lighting-ray-trace-dispatch-pass",
      "name": "AddStochasticLightingRayTraceDispatchPass",
      "category": "LumenHardwareRayTracingCommon",
      "signature": "AddStochasticLightingRayTraceDispatchPass<TShaderClass>(Graph Builder, Pass Name, Ray Generation Shader, Parameters, Scene Uniform Buffer, Nanite Ray Tracing Uniform Buffer, Resolution, View, Use Minimal Payload, Compute Pass Flags)",
      "params": [
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        },
        {
          "name": "Pass Name",
          "type": "FRDGEventName&&"
        },
        {
          "name": "Ray Generation Shader",
          "type": "TShaderRef<TShaderClass>&"
        },
        {
          "name": "Parameters",
          "type": "TShaderClass::FParameters*"
        },
        {
          "name": "Scene Uniform Buffer",
          "type": "TRDGUniformBufferBinding<FSceneUniformParameters>&"
        },
        {
          "name": "Nanite Ray Tracing Uniform Buffer",
          "type": "TRDGUniformBufferBinding<FNaniteRayTracingUniformParameters>&"
        },
        {
          "name": "Resolution",
          "type": "FIntPoint"
        },
        {
          "name": "View",
          "type": "FViewInfo&"
        },
        {
          "name": "Use Minimal Payload",
          "type": "Bool"
        },
        {
          "name": "Compute Pass Flags",
          "type": "ERDGPassFlags"
        }
      ],
      "returnType": "template<TShaderClass> void"
    },
    {
