        },
        {
          "name": "Compute Pass Flags",
          "type": "ERDGPassFlags"
        }
      ],
      "returnType": "template<TShaderClass> void"
    },
    {
      "id": "modify-compilation-environment",
      "name": "ModifyCompilationEnvironment",
      "category": "LumenHardwareRayTracingCommon",
      "signature": "ModifyCompilationEnvironment(Parameters, Shader Dispatch Type, Surface Cache Sampling, Out Environment)",
      "params": [
        {
          "name": "Parameters",
          "type": "FGlobalShaderPermutationParameters&"
        },
        {
          "name": "Shader Dispatch Type",
          "type": "Lumen::ERayTracingShaderDispatchType"
        },
