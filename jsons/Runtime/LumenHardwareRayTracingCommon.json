      "name": "AddStochasticLightingRayTraceDispatchIndirectPass",
      "category": "LumenHardwareRayTracingCommon",
      "signature": "AddStochasticLightingRayTraceDispatchIndirectPass<TShaderClass>(Graph Builder, Pass Name, Ray Generation Shader, Parameters, Scene Uniform Buffer, Nanite Ray Tracing Uniform Buffer, Indirect Args Buffer, Indirect Args Offset, View, Use Minimal Payload, Compute Pass Flags)",
      "params": [
        {
          "name": "Graph Builder",
          "type": "FRDGBuilder&"
        },
        {
          "name": "Pass Name",
          "type": "FRDGEventName&&"
        },
        {
          "name": "Ray Generation Shader",
          "type": "TShaderRef<TShaderClass>&"
        },
        {
          "name": "Parameters",
          "type": "TShaderClass::FParameters*"
        },
        {
          "name": "Scene Uniform Buffer",
          "type": "TRDGUniformBufferBinding<FSceneUniformParameters>&"
        },
        {
          "name": "Nanite Ray Tracing Uniform Buffer",
          "type": "TRDGUniformBufferBinding<FNaniteRayTracingUniformParameters>&"
        },
        {
          "name": "Indirect Args Buffer",
          "type": "FRDGBufferRef"
        },
        {
          "name": "Indirect Args Offset",
