{
  "id": "mass-processor",
  "label": "MassProcessor",
  "includepath": "MassProcessor.h",
  "includes": [
    "CoreMinimal",
    "MassEntityManager",
    "MassProcessingTypes",
    "TaskGraphInterfaces",
    "MassCommandBuffer",
    "MassProcessor.generated"
  ],
  "functions": [
    {
      "id": "call-initialize",
      "name": "CallInitialize",
      "category": "MassProcessor",
      "signature": "CallInitialize(Target, Owner, Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Owner",
          "type": "TNotNull<UObject*>"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void",
      "docs": "Calls InitializeInternal and handles initialization bookkeeping."
    },
    {
      "id": "dispatch-processor-tasks",
      "name": "DispatchProcessorTasks",
      "category": "MassProcessor",
      "signature": "DispatchProcessorTasks(Target, Entity Manager, Execution Context, Prerequisites)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedPtr<FMassEntityManager>&"
        },
        {
          "name": "Execution Context",
          "type": "FMassExecutionContext&"
        },
        {
          "name": "Prerequisites",
          "type": "FGraphEventArray&",
          "default": "FGraphEventArray()"
        }
      ],
      "returnType": "FGraphEventRef"
    },
    {
      "id": "call-execute",
      "name": "CallExecute",
      "category": "MassProcessor",
      "signature": "CallExecute(Target, Entity Manager, Context)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        },
        {
          "name": "Context",
          "type": "FMassExecutionContext&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "debug-output-description",
      "name": "DebugOutputDescription",
      "category": "MassProcessor",
      "signature": "DebugOutputDescription(Target, Ar, Indent)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Ar",
          "type": "FOutputDevice&"
        },
        {
          "name": "Indent",
          "type": "Int"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-processor-name",
      "name": "GetProcessorName",
      "category": "MassProcessor",
      "signature": "GetProcessorName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "should-allow-query-based-pruning",
      "name": "ShouldAllowQueryBasedPruning",
      "category": "MassProcessor",
      "signature": "ShouldAllowQueryBasedPruning(Target, Runtime Mode)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Runtime Mode",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Indicates whether this processor can ever be pruned while considered for a phase processing graph. A processor\ncan get pruned if none of its registered queries interact with archetypes instantiated at the moment of graph\nbuilding. This can also happen for special processors that don't register any queries - if that's the case override\nthis function to return an appropriate value or use QueryBasedPruning to configure the expected behavior.\nBy default, the processor will be the subject of pruning when bRuntimeMode == true.\n@param bRuntimeMode indicates whether the pruning is being done for game runtime (true) or editor-time presentation (false)"
    },
    {
      "id": "get-processing-phase",
      "name": "GetProcessingPhase",
      "category": "MassProcessor",
      "signature": "GetProcessingPhase(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        }
      ],
      "returnType": "EMassProcessingPhase"
    },
    {
      "id": "set-processing-phase",
      "name": "SetProcessingPhase",
      "category": "MassProcessor",
      "signature": "SetProcessingPhase(Target, Phase)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Phase",
          "type": "EMassProcessingPhase"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "export-requirements",
      "name": "ExportRequirements",
      "category": "MassProcessor",
      "signature": "ExportRequirements(Target, Out Requirements)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Out Requirements",
          "type": "FMassExecutionRequirements&"
        }
      ],
      "returnType": "Void",
      "docs": "By default,  fetches requirements declared entity queries registered via RegisterQuery. Processors can override\nthis function to supply additional requirements"
    },
    {
      "id": "register-query",
      "name": "RegisterQuery",
      "category": "MassProcessor",
      "signature": "RegisterQuery(Target, Query)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Query",
          "type": "FMassEntityQuery&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds Query to RegisteredQueries list. Query is required to be a member variable of this processor. Not meeting\nthis requirement will cause check failure and the query won't be registered."
    },
    {
      "id": "set-should-auto-register-with-global-list",
      "name": "SetShouldAutoRegisterWithGlobalList",
      "category": "MassProcessor",
      "signature": "SetShouldAutoRegisterWithGlobalList(Target, Auto Register)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Auto Register",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets bAutoRegisterWithProcessingPhases. Setting it to true will result in this processor class being always\ninstantiated to be automatically evaluated every frame. @see FMassProcessingPhaseManager\nNote that calling this function is only valid on CDOs. Calling it on a regular instance will fail an ensure and\nhave no other effect, i.e. CDO's value won't change"
    },
    {
      "id": "get-archetypes-matching-owned-queries",
      "name": "GetArchetypesMatchingOwnedQueries",
      "category": "MassProcessor",
      "signature": "GetArchetypesMatchingOwnedQueries(Target, Entity Manager, Out Archetype)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        },
        {
          "name": "Out Archetype",
          "type": "TArray<FMassArchetypeHandle>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "does-any-archetype-match-owned-queries",
      "name": "DoesAnyArchetypeMatchOwnedQueries",
      "category": "MassProcessor",
      "signature": "DoesAnyArchetypeMatchOwnedQueries(Target, Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Entity Manager",
          "type": "FMassEntityManager&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "initialize-internal-ec1840",
      "name": "InitializeInternal",
      "category": "MassProcessor",
      "signature": "InitializeInternal(Target, Owner, Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Owner",
          "type": "UObject&"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void",
      "docs": "Called to initialize the processor's internal state. Override to perform custom steps."
    },
    {
      "id": "set-child-processors",
      "name": "SetChildProcessors",
      "category": "MassProcessor",
      "signature": "SetChildProcessors(Target, In Processors)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "In Processors",
          "type": "TArrayView<UMassProcessor*>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "initialize-internal-792b00",
      "name": "InitializeInternal",
      "category": "MassProcessor",
      "signature": "InitializeInternal(Target, Owner, In Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "Owner",
          "type": "UObject&"
        },
        {
          "name": "In Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-group-name",
      "name": "SetGroupName",
      "category": "MassProcessor",
      "signature": "SetGroupName(Target, New Name)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "New Name",
          "type": "Name"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-processors",
      "name": "SetProcessors",
      "category": "MassProcessor",
      "signature": "SetProcessors(Target, In Processor Instances, Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "In Processor Instances",
          "type": "TArrayView<UMassProcessor*>"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedPtr<FMassEntityManager>&",
          "default": "nullptr"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "build-flat-processing-graph",
      "name": "BuildFlatProcessingGraph",
      "category": "MassProcessor",
      "signature": "BuildFlatProcessingGraph(Target, Sorted Processors)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "Sorted Processors",
          "type": "TConstArrayView<FMassProcessorOrderInfo>"
        }
      ],
      "returnType": "Void",
      "docs": "Builds flat processing graph that's being used for multithreading execution of hosted processors."
    },
    {
      "id": "update-processors-collection",
      "name": "UpdateProcessorsCollection",
      "category": "MassProcessor",
      "signature": "UpdateProcessorsCollection(Target, In Out Ordered Processors, In World Execution Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "In Out Ordered Processors",
          "type": "TArrayView<FMassProcessorOrderInfo>"
        },
        {
          "name": "In World Execution Flags",
          "type": "EProcessorExecutionFlags",
          "default": "EProcessorExecutionFlags::None"
        }
      ],
      "returnType": "Void",
      "docs": "Adds processors in InOutOrderedProcessors to ChildPipeline.\nNote that this operation is non-destructive for the existing processors - the ones of classes found in InOutOrderedProcessors\nwill be retained and used instead of the instances provided via InOutOrderedProcessors. Respective entries in InOutOrderedProcessors\nwill be updated to reflect the reuse.\nThe described behavior however is available only for processors with bAllowMultipleInstances == false."
    },
    {
      "id": "add-grouped-processor",
      "name": "AddGroupedProcessor",
      "category": "MassProcessor",
      "signature": "AddGroupedProcessor(Target, Requested Group Name, Sub Processor)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "Requested Group Name",
          "type": "Name"
        },
        {
          "name": "Sub Processor",
          "type": "UMassProcessor&"
        }
      ],
      "returnType": "Void",
      "docs": "adds SubProcessor to an appropriately named group. If RequestedGroupName == None then SubProcessor\nwill be added directly to ChildPipeline. If not then the indicated group will be searched for in ChildPipeline\nand if it's missing it will be created and AddGroupedProcessor will be called recursively"
    },
    {
      "id": "configure-queries",
      "name": "ConfigureQueries",
      "category": "MassProcessor",
      "signature": "ConfigureQueries(Target, Entity Manager)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "Entity Manager",
          "type": "TSharedRef<FMassEntityManager>&"
        }
      ],
      "returnType": "Void",
      "docs": "Called internally during processor's initialization so that child classes configure their owned queries\nwith requirements. This function is called before the processor gets considered by Mass dependency\nsolver, and the requirement information stored in queries is crucial for that process."
    }
  ]
}