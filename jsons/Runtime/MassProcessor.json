    {
      "id": "update-processors-collection",
      "name": "UpdateProcessorsCollection",
      "category": "MassProcessor",
      "signature": "UpdateProcessorsCollection(Target, In Out Ordered Processors, In World Execution Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "In Out Ordered Processors",
          "type": "TArrayView<FMassProcessorOrderInfo>"
        },
        {
          "name": "In World Execution Flags",
          "type": "EProcessorExecutionFlags",
          "default": "EProcessorExecutionFlags::None"
        }
      ],
      "returnType": "Void",
      "docs": "Adds processors in InOutOrderedProcessors to ChildPipeline.\nNote that this operation is non-destructive for the existing processors - the ones of classes found in InOutOrderedProcessors\nwill be retained and used instead of the instances provided via InOutOrderedProcessors. Respective entries in InOutOrderedProcessors\nwill be updated to reflect the reuse.\nThe described behavior however is available only for processors with bAllowMultipleInstances == false."
    },
    {
      "id": "add-grouped-processor",
      "name": "AddGroupedProcessor",
      "category": "MassProcessor",
      "signature": "AddGroupedProcessor(Target, Requested Group Name, Sub Processor)",
      "params": [
        {
          "name": "Target",
          "type": "UMassCompositeProcessor*"
        },
        {
          "name": "Requested Group Name",
          "type": "Name"
        },
        {
          "name": "Sub Processor",
          "type": "UMassProcessor&"
        }
      ],
      "returnType": "Void",
      "docs": "adds SubProcessor to an appropriately named group. If RequestedGroupName == None then SubProcessor\nwill be added directly to ChildPipeline. If not then the indicated group will be searched for in ChildPipeline\nand if it's missing it will be created and AddGroupedProcessor will be called recursively"
    },
