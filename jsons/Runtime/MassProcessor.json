    {
      "id": "should-allow-query-based-pruning",
      "name": "ShouldAllowQueryBasedPruning",
      "category": "MassProcessor",
      "signature": "ShouldAllowQueryBasedPruning(Target, Runtime Mode)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Runtime Mode",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Indicates whether this processor can ever be pruned while considered for a phase processing graph. A processor\ncan get pruned if none of its registered queries interact with archetypes instantiated at the moment of graph\nbuilding. This can also happen for special processors that don't register any queries - if that's the case override\nthis function to return an appropriate value or use QueryBasedPruning to configure the expected behavior.\nBy default, the processor will be the subject of pruning when bRuntimeMode == true.\n@param bRuntimeMode indicates whether the pruning is being done for game runtime (true) or editor-time presentation (false)"
    },
    {
      "id": "get-processing-phase",
      "name": "GetProcessingPhase",
