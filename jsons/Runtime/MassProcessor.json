        },
        {
          "name": "Out Requirements",
          "type": "FMassExecutionRequirements&"
        }
      ],
      "returnType": "Void",
      "docs": "By default,  fetches requirements declared entity queries registered via RegisterQuery. Processors can override\nthis function to supply additional requirements"
    },
    {
      "id": "register-query",
      "name": "RegisterQuery",
      "category": "MassProcessor",
      "signature": "RegisterQuery(Target, Query)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Query",
          "type": "FMassEntityQuery&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds Query to RegisteredQueries list. Query is required to be a member variable of this processor. Not meeting\nthis requirement will cause check failure and the query won't be registered."
    },
    {
      "id": "set-should-auto-register-with-global-list",
      "name": "SetShouldAutoRegisterWithGlobalList",
      "category": "MassProcessor",
      "signature": "SetShouldAutoRegisterWithGlobalList(Target, Auto Register)",
      "params": [
        {
          "name": "Target",
          "type": "UMassProcessor*"
        },
        {
          "name": "Auto Register",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Sets bAutoRegisterWithProcessingPhases. Setting it to true will result in this processor class being always\ninstantiated to be automatically evaluated every frame. @see FMassProcessingPhaseManager\nNote that calling this function is only valid on CDOs. Calling it on a regular instance will fail an ensure and\nhave no other effect, i.e. CDO's value won't change"
    },
