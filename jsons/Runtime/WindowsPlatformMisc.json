      "params": [
        {
          "name": "Process Id",
          "type": "UInt"
        }
      ],
      "returnType": "Windows::HWND",
      "docs": "Attempts to get the handle to a top-level window of the specified process.\nIf the process has a single main window (root), its handle will be returned.\nIf the process has multiple top-level windows, the first one found is returned.\n@param ProcessId The identifier of the process to get the window for.\n@return Window handle, or 0 if not found."
    },
