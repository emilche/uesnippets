      "id": "should-use-spatial",
      "name": "ShouldUseSpatial",
      "category": "SparseNarrowBandMeshSDF",
      "signature": "ShouldUseSpatial(Exact Cells, Cell Size, Avg Edge Len)",
      "params": [
