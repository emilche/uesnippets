{
  "id": "s-menu-owner",
  "label": "SMenuOwner",
  "includepath": "Widgets/Layout/SMenuOwner.h",
  "includes": [
    "CoreMinimal",
    "DeclarativeSyntaxSupport",
    "SCompoundWidget",
    "SMenuAnchor"
  ],
  "functions": [
    {
      "id": "set-summoned-menu",
      "name": "SetSummonedMenu",
      "category": "SMenuOwner",
      "signature": "SetSummonedMenu(Target, In Menu Anchor)",
      "params": [
        {
          "name": "Target",
          "type": "SMenuOwner*"
        },
        {
          "name": "In Menu Anchor",
          "type": "TSharedRef<SMenuAnchor>"
        }
      ],
      "returnType": "Void",
      "docs": "For menu widgets, tells the owner widget about a currently active pull-down menu\n@param\tInMenuAnchor\tMenu anchor for active pull-down menu or sub-menu"
    },
    {
      "id": "get-open-menu",
      "name": "GetOpenMenu",
      "category": "SMenuOwner",
      "signature": "GetOpenMenu(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SMenuOwner*"
        }
      ],
      "returnType": "TSharedPtr<SMenuAnchor>",
      "docs": "For menu bar or sub-menu widgets, returns the currently open menu, if there is one open\n@return\tMenu anchor, or null pointer"
    },
    {
      "id": "close-summoned-menus",
      "name": "CloseSummonedMenus",
      "category": "SMenuOwner",
      "signature": "CloseSummonedMenus(Target)",
      "params": [
        {
          "name": "Target",
          "type": "SMenuOwner*"
        }
      ],
      "returnType": "Void",
      "docs": "For menu bar widget, closes any open pull-down or sub menus"
    }
  ]
}