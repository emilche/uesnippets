{
  "id": "debug-view-mode-helpers",
  "label": "DebugViewModeHelpers",
  "includepath": "DebugViewModeHelpers.h",
  "includes": [
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "debug-view-shader-mode-to-string",
      "name": "DebugViewShaderModeToString",
      "category": "DebugViewModeHelpers",
      "signature": "DebugViewShaderModeToString(In Shader Mode)",
      "params": [
        {
          "name": "In Shader Mode",
          "type": "EDebugViewShaderMode"
        }
      ],
      "returnType": "TCHAR*",
      "docs": "Enumeration for different Quad Overdraw visualization mode."
    },
    {
      "id": "is-debug-view-shader-mode-odsc-only",
      "name": "IsDebugViewShaderModeODSCOnly",
      "category": "DebugViewModeHelpers",
      "signature": "IsDebugViewShaderModeODSCOnly()",
      "params": [],
      "returnType": "Bool",
      "docs": "Returns true if debug view shaders are only ODSC compiled (in editor or cooked builds). Returns false if they are can also be compiled for editor only shader maps as well as ODSC."
    },
    {
      "id": "support-debug-view-shader-mode",
      "name": "SupportDebugViewShaderMode",
      "category": "DebugViewModeHelpers",
      "signature": "SupportDebugViewShaderMode(Shader Mode, Platform)",
      "params": [
        {
          "name": "Shader Mode",
          "type": "EDebugViewShaderMode"
        },
        {
          "name": "Platform",
          "type": "EShaderPlatform"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if a specific debug view supported for a platform. Can be used as input for shader cooking."
    },
    {
      "id": "allow-debug-view-shader-mode",
      "name": "AllowDebugViewShaderMode",
      "category": "DebugViewModeHelpers",
      "signature": "AllowDebugViewShaderMode(Shader Mode, Platform, Feature Level)",
      "params": [
        {
          "name": "Shader Mode",
          "type": "EDebugViewShaderMode"
        },
        {
          "name": "Platform",
          "type": "EShaderPlatform"
        },
        {
          "name": "Feature Level",
          "type": "ERHIFeatureLevel::Type"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if a specific debug view can be displayed at runtime."
    },
    {
      "id": "get-num-actors-in-world",
      "name": "GetNumActorsInWorld",
      "category": "DebugViewModeHelpers",
      "signature": "GetNumActorsInWorld(In World)",
      "params": [
        {
          "name": "In World",
          "type": "UWorld*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "get-used-materials-in-world",
      "name": "GetUsedMaterialsInWorld",
      "category": "DebugViewModeHelpers",
      "signature": "GetUsedMaterialsInWorld(In World, Out Materials, Task)",
      "params": [
        {
          "name": "In World",
          "type": "UWorld*"
        },
        {
          "name": "Out Materials",
          "type": "OUT TSet<UMaterialInterface*>&"
        },
        {
          "name": "Task",
          "type": "FSlowTask*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "compile-debug-view-mode-shaders",
      "name": "CompileDebugViewModeShaders",
      "category": "DebugViewModeHelpers",
      "signature": "CompileDebugViewModeShaders(Mode, Quality Level, Feature Level, Materials, Progress Task)",
      "params": [
        {
          "name": "Mode",
          "type": "EDebugViewShaderMode"
        },
        {
          "name": "Quality Level",
          "type": "EMaterialQualityLevel::Type"
        },
        {
          "name": "Feature Level",
          "type": "ERHIFeatureLevel::Type"
        },
        {
          "name": "Materials",
          "type": "TSet<UMaterialInterface*>&"
        },
        {
          "name": "Progress Task",
          "type": "FSlowTask*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "wait-for-shader-compilation",
      "name": "WaitForShaderCompilation",
      "category": "DebugViewModeHelpers",
      "signature": "WaitForShaderCompilation(Message, Progress Task)",
      "params": [
        {
          "name": "Message",
          "type": "Text&"
        },
        {
          "name": "Progress Task",
          "type": "FSlowTask*"
        }
      ],
      "returnType": "Bool"
    }
  ]
}