{
  "id": "ios-runtime-settings",
  "label": "IOSRuntimeSettings",
  "includepath": "IOSRuntimeSettings.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "Class",
    "PropertyPortFlags",
    "AudioCompressionSettings",
    "IOSRuntimeSettings.generated"
  ],
  "functions": [
    {
      "id": "import-text-item",
      "name": "ImportTextItem",
      "category": "IOSRuntimeSettings",
      "signature": "ImportTextItem(Target, Buffer, Port Flags, Parent, Error Text)",
      "params": [
        {
          "name": "Target",
          "type": "FIOSBuildResourceFilePath*"
        },
        {
          "name": "Buffer",
          "type": "TCHAR*&"
        },
        {
          "name": "Port Flags",
          "type": "Int"
        },
        {
          "name": "Parent",
          "type": "UObject*"
        },
        {
          "name": "Error Text",
          "type": "FOutputDevice*"
        }
      ],
      "returnType": "Bool",
      "docs": "Custom import item used to parse ini entries straight into the filename.",
      "supportedTargets": [
        "FIOSBuildResourceFilePath*",
        "FIOSBuildResourceDirectory*"
      ]
    }
  ]
}