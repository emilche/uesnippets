    {
      "id": "set-is-kinematic",
      "name": "SetIsKinematic",
      "category": "ImmediatePhysicsActorHandle_Chaos",
      "signature": "SetIsKinematic(Target, Kinematic)",
      "params": [
        {
          "name": "Target",
          "type": "FActorHandle*"
        },
        {
          "name": "Kinematic",
          "type": "Bool"
        }
      ],
      "returnType": "Bool",
      "docs": "Normally used to modify a EParticleType::Rigid between kinematic and dynamic. Returns true if that\nwas possible (even if nothing changed). Returns false if it fails - e.g. because there was no current\nParticleHandle, or if the particle type was not EParticleType::Rigid (unless the current type was\nEParticleType::Kinematic and bKinematic was true)\nNote that this will not update the colliding pairs in the simulation, so better to change the kinematic\nstate there."
    },
