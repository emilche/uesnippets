    {
      "id": "register-spawn-from-file-extension",
      "name": "RegisterSpawnFromFileExtension",
      "category": "MediaSource",
      "signature": "RegisterSpawnFromFileExtension(Extension, In Delegate)",
      "params": [
        {
          "name": "Extension",
          "type": "String&"
        },
        {
          "name": "In Delegate",
          "type": "FMediaSourceSpawnDelegate"
        }
      ],
      "returnType": "Void",
      "docs": "Call this to register a callback when someone calls SpawnMediaSourceForString.\nThis lets you spawn a media source if the file extension matches what you want.\n@param Extension\t\tFile extension to match. This is case insensitive.\n@param InDelegate\tThis will get called if the Url passed into GetMediaSourceForUrl\nmatches Extension."
    },
    {
      "id": "unregister-spawn-from-file-extension",
      "name": "UnregisterSpawnFromFileExtension",
      "category": "MediaSource",
      "signature": "UnregisterSpawnFromFileExtension(Extension)",
      "params": [
        {
          "name": "Extension",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Call this to unregister a callback set with RegisterSpawnFromFileExtension.\n@param Extension\t\tFile extension that the callack was registered with."
    },
    {
      "id": "spawn-media-source-for-string",
      "name": "SpawnMediaSourceForString",
      "category": "MediaSource",
      "signature": "SpawnMediaSourceForString(Media Path, Outer)",
      "params": [
        {
          "name": "Media Path",
          "type": "String&"
        },
        {
          "name": "Outer",
          "type": "UObject*"
        }
      ],
      "returnType": "UMediaSource*",
      "docs": "Call this to try and create a media source appropriate for the media.\n@param MediaPath\t\tCan be a file location or a Url.\n@param Outer\t\t\tOuter to use for this object.\n@return\t\t\t\tMedia source or nullptr if none are appropriate."
