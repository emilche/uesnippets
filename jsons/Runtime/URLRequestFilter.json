{
  "id": "url-request-filter",
  "label": "URLRequestFilter",
  "includepath": "Misc/URLRequestFilter.h",
  "includes": [
    "CoreTypes",
    "ContainersFwd",
    "StringFwd",
    "Map"
  ],
  "functions": [
    {
      "id": "update-config",
      "name": "UpdateConfig",
      "category": "URLRequestFilter",
      "signature": "UpdateConfig(Target, Config Section Root Name, Config File Name)",
      "params": [
        {
          "name": "Target",
          "type": "FURLRequestFilter*"
        },
        {
          "name": "Config Section Root Name",
          "type": "TCHAR*"
        },
        {
          "name": "Config File Name",
          "type": "String&"
        }
      ],
      "returnType": "Void",
      "docs": "Update the allow list by corresponding section in a config file"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "URLRequestFilter",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FURLRequestFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if allow list is empty"
    },
    {
      "id": "is-request-allowed",
      "name": "IsRequestAllowed",
      "category": "URLRequestFilter",
      "signature": "IsRequestAllowed(Target, In URL)",
      "params": [
        {
          "name": "Target",
          "type": "FURLRequestFilter*"
        },
        {
          "name": "In URL",
          "type": "FStringView"
        }
      ],
      "returnType": "Bool",
      "docs": "Matches InURL against the configued list of allowed URL schemes and domains. Returns true if the URL is allowed."
    }
  ]
}