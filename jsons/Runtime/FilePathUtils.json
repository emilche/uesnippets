{
  "id": "file-path-utils",
  "label": "FilePathUtils",
  "includepath": "uLang/Common/Text/FilePathUtils.h",
  "includes": [
    "UTF8String"
  ],
  "functions": [
    {
      "id": "normalize-path",
      "name": "NormalizePath",
      "category": "FilePathUtils",
      "signature": "NormalizePath(Path)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Replaces backslashes with slashes and make drive letters uppercase"
    },
    {
      "id": "is-path-relative",
      "name": "IsPathRelative",
      "category": "FilePathUtils",
      "signature": "IsPathRelative(Path)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "Bool",
      "docs": "Determine if a path is relative (i.e. not fully qualified)"
    },
    {
      "id": "split-path",
      "name": "SplitPath",
      "category": "FilePathUtils",
      "signature": "SplitPath(File Path, Out Dir, Out File Name, Include Dir End Slash)",
      "params": [
        {
          "name": "File Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Out Dir",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Out File Name",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Include Dir End Slash",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Splits a path into the file name and the directory in front of it\nThe directory will have a slash or no slash at the end as specified by bIncludeDirEndSlash\nIf there's no slash in the path, returns false."
    },
    {
      "id": "foreach-part-of-path",
      "name": "ForeachPartOfPath",
      "category": "FilePathUtils",
      "signature": "ForeachPartOfPath(Path, Lambda)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Lambda",
          "type": "FunctionType&&"
        }
      ],
      "returnType": "template<FunctionType> void",
      "docs": "Invoke a lambda with each part of a path from left to right\nSlashes at either begin or end of path, as well as double slashes, will result in an invocation with an empty part"
    },
    {
      "id": "append-slash",
      "name": "AppendSlash",
      "category": "FilePathUtils",
      "signature": "AppendSlash(Path)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Appends a slash to the path if there isn't one already"
    },
    {
      "id": "get-directory",
      "name": "GetDirectory",
      "category": "FilePathUtils",
      "signature": "GetDirectory(Path, Include Dir End Slash)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Include Dir End Slash",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Gets the containing directory of a file or directory"
    },
    {
      "id": "get-file-name",
      "name": "GetFileName",
      "category": "FilePathUtils",
      "signature": "GetFileName(Path)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Gets the unqualified name of a file or directory (without the containing path)"
    },
    {
      "id": "split-file-name",
      "name": "SplitFileName",
      "category": "FilePathUtils",
      "signature": "SplitFileName(File Name, Stem, Extension)",
      "params": [
        {
          "name": "File Name",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Stem",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Extension",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "Void",
      "docs": "Splits a file name into stem (name) and extension (including the dot)"
    },
    {
      "id": "combine-paths",
      "name": "CombinePaths",
      "category": "FilePathUtils",
      "signature": "CombinePaths(Lhs Path, Rhs Path)",
      "params": [
        {
          "name": "Lhs Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Rhs Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Combines two paths"
    },
    {
      "id": "convert-relative-path-to-full",
      "name": "ConvertRelativePathToFull",
      "category": "FilePathUtils",
      "signature": "ConvertRelativePathToFull(Path, Base Path)",
      "params": [
        {
          "name": "Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Base Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Checks if a path is relative, and if so, combines it with given base path"
    },
    {
      "id": "convert-full-path-to-relative",
      "name": "ConvertFullPathToRelative",
      "category": "FilePathUtils",
      "signature": "ConvertFullPathToRelative(Full Path, Base Path)",
      "params": [
        {
          "name": "Full Path",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Base Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8String",
      "docs": "Creates a relative path by removing BasePath from the head of FullPath. Result will be empty if this is not possible."
    },
    {
      "id": "get-name-from-file-or-dir",
      "name": "GetNameFromFileOrDir",
      "category": "FilePathUtils",
      "signature": "GetNameFromFileOrDir(File Path)",
      "params": [
        {
          "name": "File Path",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "CUTF8StringView",
      "docs": "Gets stem/name of given file, or if stem is empty, name of enclosing directory"
    },
    {
      "id": "is-descendant-of-directory",
      "name": "IsDescendantOfDirectory",
      "category": "FilePathUtils",
      "signature": "IsDescendantOfDirectory(Parent Directory, Potential Child Directory)",
      "params": [
        {
          "name": "Parent Directory",
          "type": "CUTF8StringView&"
        },
        {
          "name": "Potential Child Directory",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if a file/directory is a descendant of a given directory\nNOTE: This fails in a number of cases, but the most obvious one is when the parent directory passed in is a symbolic link and the second argument is the actual file/directory path."
    }
  ]
}