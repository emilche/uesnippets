    {
      "id": "find-nodes-with-predicate",
      "name": "FindNodesWithPredicate",
      "category": "GenericOctree",
      "signature": "FindNodesWithPredicate(Target, Predicate, Func)",
      "params": [
        {
          "name": "Target",
          "type": "TOctree2*"
        },
        {
          "name": "Predicate",
          "type": "PredicateFunc&"
        },
        {
          "name": "Func",
          "type": "IterateFunc&"
        }
      ],
      "returnType": "template<PredicateFunc,IterateFunc> void",
      "docs": "this function will traverse the Octree starting from the root in depth first order and the predicate can be used to implement custom culling for each node.\n@param Predicate - a Function when given the bounds of the currently traversed node that returns true if traversal should continue or false to skip that branch.\n@param Func - Function that will receive the node ID which can be stored and later used to get the elements using GetElementsForNode for all nodes that passed the predicate."
    },
