{
  "id": "object-version",
  "label": "ObjectVersion",
  "includepath": "UObject/ObjectVersion.h",
  "includes": [
    "CoreTypes"
  ],
  "functions": [
    {
      "id": "f-package-file-version",
      "name": "FPackageFileVersion",
      "category": "ObjectVersion",
      "signature": "FPackageFileVersion(UE 4 Version, UE 4 Version, UE 5 Version)",
      "params": [
        {
          "name": "UE 4 Version",
          "type": "Int"
        },
        {
          "name": "UE 4 Version",
          "type": "EUnrealEngineObjectUE5Version UE5Version ) : FileVersionUE4 ("
        },
        {
          "name": "UE 5 Version",
          "type": "FileVersionUE5 ( ( int32 )"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "ObjectVersion",
      "signature": "Reset()",
      "params": [],
      "returnType": "Void",
      "docs": "Set all versions to the default state"
    },
    {
      "id": "create-ue-4-version",
      "name": "CreateUE4Version",
      "category": "ObjectVersion",
      "signature": "CreateUE4Version(Version)",
      "params": [
        {
          "name": "Version",
          "type": "Int"
        }
      ],
      "returnType": "FPackageFileVersion",
      "docs": "Creates and returns a FPackageFileVersion based on a single EUnrealEngineObjectUEVersion and no other versions."
    },
    {
      "id": "to-value",
      "name": "ToValue",
      "category": "ObjectVersion",
      "signature": "ToValue()",
      "params": [],
      "returnType": "Int",
      "docs": "Returns the highest valid version number which is considered to be the 'true' version number"
    },
    {
      "id": "is-compatible",
      "name": "IsCompatible",
      "category": "ObjectVersion",
      "signature": "IsCompatible(Other)",
      "params": [
        {
          "name": "Other",
          "type": "FPackageFileVersion&"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this object is compatible with the FPackageFileVersion passed in as the parameter.\nThis means that  all version numbers for the current object are equal or greater than the\ncorresponding version numbers of the other structure."
    },
    {
      "id": "write",
      "name": "Write",
      "category": "ObjectVersion",
      "signature": "Write(Writer)",
      "params": [
        {
          "name": "Writer",
          "type": "FCbWriter&"
        }
      ],
      "returnType": "FCbWriter&"
    },
    {
      "id": "load-from-compact-binary",
      "name": "LoadFromCompactBinary",
      "category": "ObjectVersion",
      "signature": "LoadFromCompactBinary(Field View, Version)",
      "params": [
        {
          "name": "Field View",
          "type": "FCbFieldView&"
        },
        {
          "name": "Version",
          "type": "FPackageFileVersion&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "try-read",
      "name": "TryRead",
      "category": "ObjectVersion",
      "signature": "TryRead(Field View)",
      "params": [
        {
          "name": "Field View",
          "type": "FCbFieldView&"
        }
      ],
      "returnType": "Bool"
    }
  ]
