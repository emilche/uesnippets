{
  "id": "procedural-foliage-tile",
  "label": "ProceduralFoliageTile",
  "includepath": "ProceduralFoliageTile.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "Object",
    "RandomStream",
    "InstancedFoliage",
    "ProceduralFoliageInstance",
    "ProceduralFoliageBroadphase",
    "ProceduralFoliageTile.generated"
  ],
  "functions": [
    {
      "id": "simulate",
      "name": "Simulate",
      "category": "ProceduralFoliageTile",
      "signature": "Simulate(Target, In Foliage Spawner, Random Seed, Max Num Steps, In Last Cancel)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "In Foliage Spawner",
          "type": "UProceduralFoliageSpawner*"
        },
        {
          "name": "Random Seed",
          "type": "Int"
        },
        {
          "name": "Max Num Steps",
          "type": "Int"
        },
        {
          "name": "In Last Cancel",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Procedurally determine the placement of foliage instances.\n@param InFoliageSpawner the foliage spawner containing the various foliage types to simulate\n@param RandomSeed For seeding (in the RNG sense) the random dispersion of seeds (in the foliage sense)\n@param MaxNumSteps The maximum number of steps to run the simulation"
    },
    {
      "id": "extract-desired-instances",
      "name": "ExtractDesiredInstances",
      "category": "ProceduralFoliageTile",
      "signature": "ExtractDesiredInstances(Target, Out Desired Instances, World TM, Actor Volume Location, Actor Volume Max Extent, Procedural Guid, Half Height, Volume Body Instance, Empty Tile Info)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "Out Desired Instances",
          "type": "TArray<FDesiredFoliageInstance>&"
        },
        {
          "name": "World TM",
          "type": "FTransform&"
        },
        {
          "name": "Actor Volume Location",
          "type": "FVector2D&"
        },
        {
          "name": "Actor Volume Max Extent",
          "type": "FVector::FReal"
        },
        {
          "name": "Procedural Guid",
          "type": "FGuid&"
        },
        {
          "name": "Half Height",
          "type": "FVector::FReal"
        },
        {
          "name": "Volume Body Instance",
          "type": "FBodyInstance*"
        },
        {
          "name": "Empty Tile Info",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Extracts information on each instance that should be spawned based on the simulation."
    },
    {
      "id": "copy-instances-to-tile",
      "name": "CopyInstancesToTile",
      "category": "ProceduralFoliageTile",
      "signature": "CopyInstancesToTile(Target, To Tile, Local AABB, Relative TM, Overlap)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "To Tile",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "Local AABB",
          "type": "FBox2D&"
        },
        {
          "name": "Relative TM",
          "type": "FTransform&"
        },
        {
          "name": "Overlap",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Copies instances within this tile to another\n@param ToTile The tile to copy instances to\n@param LocalAABB The region (in local space) to copy instances from\n@param RelativeTM The transform of the destination tile relative to this tile\n@param Overlap The amount by which the tiles are overlapping"
    },
    {
      "id": "remove-instance",
      "name": "RemoveInstance",
      "category": "ProceduralFoliageTile",
      "signature": "RemoveInstance(Target, Inst)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "Inst",
          "type": "FProceduralFoliageInstance*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes a single instance from the tile\n@param Inst The instance to remove"
    },
    {
      "id": "remove-instances",
      "name": "RemoveInstances",
      "category": "ProceduralFoliageTile",
      "signature": "RemoveInstances(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes all instances from the tile"
    },
    {
      "id": "empty",
      "name": "Empty",
      "category": "ProceduralFoliageTile",
      "signature": "Empty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        }
      ],
      "returnType": "Void",
      "docs": "Empty arrays and sets"
    },
    {
      "id": "init-simulation",
      "name": "InitSimulation",
      "category": "ProceduralFoliageTile",
      "signature": "InitSimulation(Target, In Foliage Spawner, In Random Seed)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "In Foliage Spawner",
          "type": "UProceduralFoliageSpawner*"
        },
        {
          "name": "In Random Seed",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes the tile for simulation. Called automatically by Simulate, so only bother to call if the tile won't actually simulate."
    },
    {
      "id": "get-resource-size-ex",
      "name": "GetResourceSizeEx",
      "category": "ProceduralFoliageTile",
      "signature": "GetResourceSizeEx(Target, Cumulative Resource Size)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        },
        {
          "name": "Cumulative Resource Size",
          "type": "FResourceSizeEx&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "begin-destroy",
      "name": "BeginDestroy",
      "category": "ProceduralFoliageTile",
      "signature": "BeginDestroy(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProceduralFoliageTile*"
        }
      ],
      "returnType": "Void"
    }
  ]
}