{
  "id": "spherical-fibonacci",
  "label": "SphericalFibonacci",
  "includepath": "Sampling/SphericalFibonacci.h",
  "includes": [
    "MathUtil",
    "VectorTypes",
    "MatrixTypes"
  ],
  "functions": [
    {
      "id": "num",
      "name": "Num",
      "category": "SphericalFibonacci",
      "signature": "Num(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TSphericalFibonacci*"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "point",
      "name": "Point",
      "category": "SphericalFibonacci",
      "signature": "Point(Target, Index)",
      "params": [
        {
          "name": "Target",
          "type": "TSphericalFibonacci*"
        },
        {
          "name": "Index",
          "type": "Int"
        }
      ],
      "returnType": "TVector<RealType>",
      "docs": "@param Index point index in range [0,Num()-1]\n@return sphere point for given Index"
    },
    {
      "id": "find-index",
      "name": "FindIndex",
      "category": "SphericalFibonacci",
      "signature": "FindIndex(Target, P)",
      "params": [
        {
          "name": "Target",
          "type": "TSphericalFibonacci*"
        },
        {
          "name": "P",
          "type": "TVector<RealType>&"
        }
      ],
      "returnType": "Int",
      "docs": "@return Index of the sphere point closest to the given point P"
    },
    {
      "id": "t-fibonacci-lattice",
      "name": "TFibonacciLattice",
      "category": "SphericalFibonacci",
      "signature": "TFibonacciLattice(Target, Num Points, In Type, In Type)",
      "params": [
        {
          "name": "Target",
          "type": "TSphericalFibonacci*"
        },
        {
          "name": "Num Points",
          "type": "Int",
          "default": "64"
        },
        {
          "name": "In Type",
          "type": "EType",
          "default": "EType::Square)\n\t\t: N(NumPoints)"
        },
        {
          "name": "In Type",
          "type": "Type ("
        }
      ],
      "returnType": "Void",
      "docs": "A 2D point set based on the Fibonacci sequence where the i'th point\nof an N point set can be directly computed.\nReference: Spherical Fibonacci Point Sets for Illumination Integrals\nhttps://repositori.upf.edu/bitstream/handle/10230/35552/marques_CGForum32_sphe.pdf?sequence=1&isAllowed=y"
    },
    {
      "id": "t-hemispherical-fibonacci",
      "name": "THemisphericalFibonacci",
      "category": "SphericalFibonacci",
      "signature": "THemisphericalFibonacci(Target, Num Points, Dist, Dist)",
      "params": [
        {
          "name": "Target",
          "type": "TSphericalFibonacci*"
        },
        {
          "name": "Num Points",
          "type": "Int",
          "default": "64"
        },
        {
          "name": "Dist",
          "type": "EDistribution",
          "default": "EDistribution::Uniform)\n\t\t: N(NumPoints)"
        },
        {
          "name": "Dist",
          "type": "Distribution ("
        }
      ],
      "returnType": "Void",
      "docs": "A hemisphere point set generated using a Fibonacci lattice\nwhere the i'th point of an N point set can be computed directly.\nZ is \"up\" in the hemisphere."
    }
  ]
}