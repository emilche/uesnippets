{
  "id": "skeletal-mesh-lod-render-data",
  "label": "SkeletalMeshLODRenderData",
  "includepath": "Rendering/SkeletalMeshLODRenderData.h",
  "includes": [
    "CoreMinimal",
    "MultiSizeIndexContainer",
    "SkeletalMeshVertexBuffer",
    "SkinWeightVertexBuffer",
    "ColorVertexBuffer",
    "SkeletalMeshDuplicatedVerticesBuffer",
    "SkeletalMeshVertexClothBuffer",
    "MorphTargetVertexInfoBuffers",
    "SkeletalMeshHalfEdgeBuffer",
    "SkeletalMeshTypes",
    "BoneIndices",
    "StaticMeshResources",
    "GPUSkinVertexFactory",
    "SkeletalMeshVertexAttribute",
    "SkinWeightProfile"
  ],
  "functions": [
    {
      "id": "release-resources",
      "name": "ReleaseResources",
      "category": "SkeletalMeshLODRenderData",
      "signature": "ReleaseResources(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        }
      ],
      "returnType": "Void",
      "docs": "Releases the LOD's render resources."
    },
    {
      "id": "serialize-streamed-data",
      "name": "SerializeStreamedData",
      "category": "SkeletalMeshLODRenderData",
      "signature": "SerializeStreamedData(Target, Ar, Owner, LOD Idx, Class Strip Flags, Needs CPU Access, Force Keep CPU Resources)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
          "name": "Owner",
          "type": "USkinnedAsset*"
        },
        {
          "name": "LOD Idx",
          "type": "Int"
        },
        {
          "name": "Class Strip Flags",
          "type": "Byte"
        },
        {
          "name": "Needs CPU Access",
          "type": "Bool"
        },
        {
          "name": "Force Keep CPU Resources",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Serialize the portion of data that might be streamed\n@param bNeedsCPUAcces - Whether something requires keeping CPU copy of resources (see ShouldKeepCPUResources)\n@param bForceKeepCPUResources - Whether we want to force keeping CPU resources\n@return Size of streamed LOD data in bytes"
    },
    {
      "id": "build-from-lod-model",
      "name": "BuildFromLODModel",
      "category": "SkeletalMeshLODRenderData",
      "signature": "BuildFromLODModel(Target, In LOD Model, In Vertex Attribute Infos, In Build Settings)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        },
        {
          "name": "In LOD Model",
          "type": "FSkeletalMeshLODModel*"
        },
        {
          "name": "In Vertex Attribute Infos",
          "type": "TConstArrayView<FSkeletalMeshVertexAttributeInfo>",
          "default": "{}"
        },
        {
          "name": "In Build Settings",
          "type": "FBuildSettings&",
          "default": "FBuildSettings{ESkeletalMeshVertexFlags::None, false}"
        }
      ],
      "returnType": "Void",
      "docs": "Initialize render data (e.g. vertex buffers) from model info\n@param InLODModel The model to build the render data from.\n@param InVertexAttributeInfos The vertex attributes to possibly include and their stored data type.\n@param InBuildSettings Forwards relevant settings from LodInfo, See ESkeletalMeshVertexFlags."
    },
    {
      "id": "get-total-faces",
      "name": "GetTotalFaces",
      "category": "SkeletalMeshLODRenderData",
      "signature": "GetTotalFaces(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        }
      ],
      "returnType": "Int",
      "docs": "Utility function for returning total number of faces in this LOD."
    },
    {
      "id": "has-cloth-data",
      "name": "HasClothData",
      "category": "SkeletalMeshLODRenderData",
      "signature": "HasClothData(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if any chunks have cloth data."
    },
    {
      "id": "get-section-from-vertex-index",
      "name": "GetSectionFromVertexIndex",
      "category": "SkeletalMeshLODRenderData",
      "signature": "GetSectionFromVertexIndex(Target, In Vert Index, Out Section Index, Out Vert Index)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        },
        {
          "name": "In Vert Index",
          "type": "Int"
        },
        {
          "name": "Out Section Index",
          "type": "Int&"
        },
        {
          "name": "Out Vert Index",
          "type": "Int&"
        }
      ],
      "returnType": "Void",
      "docs": "Utility for finding the section that a particular vertex is in."
    },
    {
      "id": "get-resource-size-ex",
      "name": "GetResourceSizeEx",
      "category": "SkeletalMeshLODRenderData",
      "signature": "GetResourceSizeEx(Target, Cumulative Resource Size)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        },
        {
          "name": "Cumulative Resource Size",
          "type": "FResourceSizeEx&"
        }
      ],
      "returnType": "Void",
      "docs": "Get Resource Size"
    },
    {
      "id": "num-non-clothing-sections",
      "name": "NumNonClothingSections",
      "category": "SkeletalMeshLODRenderData",
      "signature": "NumNonClothingSections(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSkeletalMeshLODRenderData*"
        }
      ],
      "returnType": "Int"
    }
  ]
}