      "name": "IsThisNotNull",
      "category": "CoreGlobals",
      "signature": "IsThisNotNull(This, Function)",
      "params": [
        {
          "name": "This",
          "type": "void*"
        },
        {
          "name": "Function",
          "type": "ANSICHAR*"
        }
      ],
