    {
      "id": "get-commandlet-name-from-cmdline",
      "name": "GetCommandletNameFromCmdline",
      "category": "CoreGlobals",
      "signature": "GetCommandletNameFromCmdline()",
      "params": [],
      "returnType": "String",
      "docs": "Returns the name of the commandlet that was set on the command line by\nthe arg '-Run=<CommandletName>'.\nThis should be used by code that needs to know the commandlet name\nearly on during engine startup, before the commandlet has been initialized.\nIf possible, code should prefer calling GetRunningCommandletClass()->GetName()\ninstead.\n@return The name of the commandlet that will end up running. If there is\nno commandlet then an empty string will be returned."
    },
    {
      "id": "get-multiprocess-id",
      "name": "GetMultiprocessId",
      "category": "CoreGlobals",
      "signature": "GetMultiprocessId()",
      "params": [],
      "returnType": "Int",
      "docs": "If multiple copies of the process are running and communicating together, the director process has MultiprocessId 0\nand the worker processes have MultiprocessId > 0.\nWhen only a single process is running, GetMultiprocessId returns 0.\nBased on commandline. Primary example is cookworkers in multiprocess cook.\nSystems that need to write a separate file per running process should use this id as part of their file descriptor."
    },
