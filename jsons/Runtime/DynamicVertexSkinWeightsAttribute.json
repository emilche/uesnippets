    {
      "id": "reindex-bone-indices-to-skeleton",
      "name": "ReindexBoneIndicesToSkeleton",
      "category": "DynamicVertexSkinWeightsAttribute",
      "signature": "ReindexBoneIndicesToSkeleton(Target, From Ref Skeleton, To Ref Skeleton)",
      "params": [
        {
          "name": "Target",
          "type": "TDynamicVertexSkinWeightsAttribute*"
        },
        {
          "name": "From Ref Skeleton",
          "type": "TArray<FName>&"
        },
        {
          "name": "To Ref Skeleton",
          "type": "TArray<FName>&"
        }
      ],
      "returnType": "Bool",
      "docs": "Re-index bone indices of the skin weights from one reference skeleton (represented by an array of bone names)\nto another.\n@param FromRefSkeleton The reference skeleton that the current skin weights are indexed against.\n@param ToRefSkeleton The new reference skeleton that should be used to reindex the weights.\n@return true on success, false otherwise\n@note Reasons for failure are:\n- bone index of one of the bone weights is larger than the number of bones in FromRefSkeleton, meaning\nthe weights most likely were not computed with respect to the FromRefSkeleton.\n- one of the bone weights references a bone in FromRefSkeleton that doesn't exist in ToRefSkeleton.\n- ToRefSkeleton contains duplicates.\n@note FromRefSkeleton can contain bones that are not present in ToRefSkeleton as long as those bones are not\nreferenced by any of the weights."
    },
