    {
      "id": "panic",
      "name": "Panic",
      "category": "OutputDeviceRedirector",
      "signature": "Panic(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FOutputDeviceRedirector*"
        }
      ],
      "returnType": "Void",
      "docs": "Attempts to set the calling thread as the panic thread and enable panic mode.\nOnly one thread can be the panic thread. Subsequent calls from other threads are ignored.\nOnly redirects logs to panic-safe output devices from this point forward.\nMakes the calling thread the primary log thread as well.\nFlushes buffered logs to panic-safe output devices.\nFlushes panic-safe output devices."
    },
