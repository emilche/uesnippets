    {
      "id": "enable-backlog",
      "name": "EnableBacklog",
      "category": "OutputDeviceRedirector",
      "signature": "EnableBacklog(Target, Enable)",
      "params": [
        {
          "name": "Target",
          "type": "FOutputDeviceRedirector*"
        },
        {
          "name": "Enable",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Enables or disables the backlog.\n@param bEnable   Starts saving a backlog if true, disables and discards any backlog if false."
    },
    {
      "id": "set-current-thread-as-primary-thread",
      "name": "SetCurrentThreadAsPrimaryThread",
      "category": "OutputDeviceRedirector",
      "signature": "SetCurrentThreadAsPrimaryThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FOutputDeviceRedirector*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the current thread to be the thread that redirects logs to buffered output devices.\nThe current thread can redirect to buffered output devices without buffering, and becomes\nresponsible for flushing buffered logs from secondary threads. Logs from secondary threads\nwill not be redirected unless the current thread periodically flushes threaded logs."
    },
    {
      "id": "try-start-dedicated-primary-thread",
      "name": "TryStartDedicatedPrimaryThread",
      "category": "OutputDeviceRedirector",
      "signature": "TryStartDedicatedPrimaryThread(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FOutputDeviceRedirector*"
        }
      ],
      "returnType": "Bool",
      "docs": "Starts a dedicated primary thread that redirects logs to buffered output devices.\nA thread will not be started for certain configurations or platforms, or when threading is disabled.\n@return true if a dedicated primary logging thread is running, false otherwise."
    },
    {
      "id": "serialize-record",
      "name": "SerializeRecord",
      "category": "OutputDeviceRedirector",
      "signature": "SerializeRecord(Target, Record)",
      "params": [
