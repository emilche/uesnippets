      "signature": "HasTransactionsAPI(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInteractiveCommandArguments*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-transactions-api",
      "name": "GetTransactionsAPI",
      "category": "InteractiveCommand",
      "signature": "GetTransactionsAPI(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInteractiveCommandArguments*"
        }
      ],
      "returnType": "IToolsContextTransactionsAPI*"
    },
    {
      "id": "can-execute-command",
      "name": "CanExecuteCommand",
      "category": "InteractiveCommand",
      "signature": "CanExecuteCommand(Target, Arguments)",
      "params": [
        {
          "name": "Target",
          "type": "UInteractiveCommand*"
        },
        {
          "name": "Arguments",
          "type": "UInteractiveCommandArguments*"
        }
      ],
      "returnType": "Bool",
      "docs": "@return true if it is safe to call ExecuteCommand() with the given Arguments"
    },
    {
      "id": "execute-command",
      "name": "ExecuteCommand",
      "category": "InteractiveCommand",
      "signature": "ExecuteCommand(Target, Arguments, Result)",
      "params": [
        {
          "name": "Target",
          "type": "UInteractiveCommand*"
        },
        {
          "name": "Arguments",
          "type": "UInteractiveCommandArguments*"
        },
        {
          "name": "Result",
          "type": "UInteractiveCommandResult**",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Execute the command with the given Arguments\n@param Result optional command result. Command would have to allocate the UInteractiveCommandResult object to return it, but is not required to. Caller should not assume that a non-null Result is necessarily returned."
    }
  ]
