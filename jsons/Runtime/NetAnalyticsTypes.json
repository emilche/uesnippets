  "functions": [
    {
      "id": "f-delinquency-analytics-11f2c4",
      "name": "FDelinquencyAnalytics",
      "category": "NetAnalyticsTypes",
      "signature": "FDelinquencyAnalytics(In Number Of Top Offenders To Track)",
      "params": [
        {
          "name": "In Number Of Top Offenders To Track",
          "type": "UInt"
        }
      ],
      "returnType": "public :",
      "docs": "Convenience type that can be used to tracks information about things that can result in prolonged\nperiods of apparent network inactivity, despite actually receiving traffic.\nThe overall number of entries is expected to be small, but ultimately is left up to callers."
    },
    {
      "id": "f-delinquency-analytics-442682",
      "name": "FDelinquencyAnalytics",
      "category": "NetAnalyticsTypes",
      "signature": "FDelinquencyAnalytics(Other)",
      "params": [
        {
          "name": "Other",
          "type": "FDelinquencyAnalytics&&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "add",
      "name": "Add",
      "category": "NetAnalyticsTypes",
      "signature": "Add(Target, To Track)",
      "params": [
        {
          "name": "Target",
          "type": "FDelinquencyAnalytics*"
        },
        {
          "name": "To Track",
          "type": "FDelinquencyNameTimePair&&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds the event to the delinquency tracking, by accumulating its time into total time,\nand updating any existing events to choose the one with the highest time.\nWhen NumberOfTopOffendersToTrack == 0, we will just track the set of all events as well as the total time.\nWhen NumberOfTopOffendersToTrack > 0, we will track the set, total time, and also maintain sorted list\n(highest to lowest) of events that occurred.\nBy setting NumberOfTopOffendersToTrack to 0, users can manage their own lists of \"TopOffenders\", or\notherwise avoid the per add overhead of this tracking."
    },
