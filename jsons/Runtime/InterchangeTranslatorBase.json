      "returnType": "Bool",
      "docs": "Translate the associated source data into node(s) that are hold in the specified nodes container.\n@param BaseNodeContainer - The nodes container where to put the translated source data result.\n@return true if the translator can translate the source data, false otherwise."
    },
    {
      "id": "release-source",
      "name": "ReleaseSource",
      "category": "InterchangeTranslatorBase",
      "signature": "ReleaseSource(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInterchangeTranslatorBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Release source is called when we do not need anymore the translator source and also early in the cancel process.\nThis is where out of process translator will send the stop command.\nA good example of why its useful to release the source is when the dispatcher delete the worker, the join on the\nthread will be very short and will not block the main thread. If the worker stop command was send before the completion task."
    },
