        },
        {
          "name": "Relative Movement",
          "type": "FVec3f&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "generate-collision-ccd",
      "name": "GenerateCollisionCCD",
      "category": "ParticlePairMidPhase",
      "signature": "GenerateCollisionCCD(Target, Dt, Cull Distance, Relative Movement, Enable CCD Sweep, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleShapePairCollisionDetector*"
        },
        {
          "name": "Dt",
          "type": "FRealSingle"
        },
        {
          "name": "Cull Distance",
          "type": "FRealSingle"
        },
        {
          "name": "Relative Movement",
          "type": "FVec3f&"
        },
        {
