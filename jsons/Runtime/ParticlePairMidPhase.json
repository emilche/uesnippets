        },
        {
          "name": "Relative Movement",
          "type": "FVec3f&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "make",
      "name": "Make",
      "category": "ParticlePairMidPhase",
      "signature": "Make(In Particle 0, In Particle 1)",
      "params": [
        {
          "name": "In Particle 0",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "In Particle 1",
          "type": "FGeometryParticleHandle*"
        }
      ],
      "returnType": "FParticlePairMidPhase*"
    },
    {
      "id": "init",
      "name": "Init",
      "category": "ParticlePairMidPhase",
      "signature": "Init(Target, In Particle 0, In Particle 1, In Key, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "In Particle 0",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "In Particle 1",
          "type": "FGeometryParticleHandle*"
        },
        {
          "name": "In Key",
          "type": "Private::FCollisionParticlePairKey&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Set up the midphase based on the ShapesArrays of the two particles\nOnly intended to be called once right after constructor. We don't do this work in\nthe constructor so that we can reduce the time that the lock is held when allocating\nnew MidPhases."
    },
    {
      "id": "set-is-sleeping",
      "name": "SetIsSleeping",
      "category": "ParticlePairMidPhase",
      "signature": "SetIsSleeping(Target, In Is Sleeping, Current Epoch)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "In Is Sleeping",
          "type": "Bool"
        },
        {
          "name": "Current Epoch",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Update the sleeping state\nIf this switches the state to Awake, it will reactivate any collisions between the particle pair that\nwere active when they went to sleep."
    },
    {
      "id": "is-in-constraint-graph",
      "name": "IsInConstraintGraph",
      "category": "ParticlePairMidPhase",
      "signature": "IsInConstraintGraph(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "detach-particle",
      "name": "DetachParticle",
      "category": "ParticlePairMidPhase",
      "signature": "DetachParticle(Target, Particle)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "Particle",
          "type": "FGeometryParticleHandle*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Destroy all collisions and prevent this midphasae from being used any more. Called when one of its particles is destoyed.\nIt will be culled at the next Prune in the CollisionConstraintAllocator. We don't delete it immediately so that we don't\nhave to remove it from either Particle's ParticleCollisions array (which is O(N) and unnecessary when the particles are being destroyed)"
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "ParticlePairMidPhase",
      "signature": "Reset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Delete all cached data and collisions. Should be called when a particle changes its shapes"
    },
    {
      "id": "reset-modifications",
      "name": "ResetModifications",
      "category": "ParticlePairMidPhase",
      "signature": "ResetModifications(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "generate-collisions",
      "name": "GenerateCollisions",
      "category": "ParticlePairMidPhase",
      "signature": "GenerateCollisions(Target, Cull Distance, Dt, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "Cull Distance",
          "type": "FReal"
        },
        {
          "name": "Dt",
          "type": "FReal"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Create collision constraints for all colliding shape pairs"
    },
    {
      "id": "inject-collision",
      "name": "InjectCollision",
      "category": "ParticlePairMidPhase",
      "signature": "InjectCollision(Target, Constraint, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "Constraint",
          "type": "FPBDCollisionConstraint&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Copy a collision and activate it\nThis is used by the Resim system to restore saved colisions. If there is already a matching constraint\nit will be overwritten, otherwise a new constraint will be added."
    },
    {
      "id": "set-convex-optimization-is-active",
      "name": "SetConvexOptimizationIsActive",
      "category": "ParticlePairMidPhase",
      "signature": "SetConvexOptimizationIsActive(Target, Set Convex Optimization Is Active, On Destroying Collision)",
      "params": [
        {
          "name": "Target",
          "type": "FParticlePairMidPhase*"
        },
        {
          "name": "Set Convex Optimization Is Active",
          "type": "Bool"
        },
        {
          "name": "On Destroying Collision",
          "type": "TFunctionRef<void ( FPBDCollisionConstraint* )>"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Override whether convex optimization if used this mid-phase. Used by the MidPhase modifier and gets reset every frame.\nNOTE: when this setting is changed, collisions will be destroyed so any external systems referencing them will need to\ndrop their references."
    },
    {
      "id": "reset-impl",
      "name": "ResetImpl",
      "category": "ParticlePairMidPhase",
      "signature": "ResetImpl(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FShapePairParticlePairMidPhase*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "build-detectors-impl",
      "name": "BuildDetectorsImpl",
      "category": "ParticlePairMidPhase",
      "signature": "BuildDetectorsImpl(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FShapePairParticlePairMidPhase*"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Build the list of potentially colliding shape pairs.\nThis is all the shape pairs in the partilces' shapes arrays that pass the collision filter."
    },
    {
      "id": "generate-collisions-impl",
      "name": "GenerateCollisionsImpl",
      "category": "ParticlePairMidPhase",
      "signature": "GenerateCollisionsImpl(Target, Dt, Cull Distance, Relative Movement, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FShapePairParticlePairMidPhase*"
        },
        {
          "name": "Dt",
          "type": "FRealSingle"
        },
        {
          "name": "Cull Distance",
          "type": "FRealSingle"
        },
        {
          "name": "Relative Movement",
          "type": "FVec3f&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Int"
    }
  ]
}