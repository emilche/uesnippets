      "returnType": "Int"
    },
    {
      "id": "wake-collision",
      "name": "WakeCollision",
      "category": "ParticlePairMidPhase",
      "signature": "WakeCollision(Target, Sleep Epoch, Current Epoch)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleShapePairCollisionDetector*"
        },
        {
          "name": "Sleep Epoch",
          "type": "Int"
        },
        {
          "name": "Current Epoch",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Reactivate the constraint\n@parame SleepEpoch The tick on which the particle went to sleep.\nOnly constraints that were active when the particle went to sleep should be reactivated."
    },
    {
      "id": "set-collision",
      "name": "SetCollision",
      "category": "ParticlePairMidPhase",
      "signature": "SetCollision(Target, Constraint, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleShapePairCollisionDetector*"
        },
        {
          "name": "Constraint",
          "type": "FPBDCollisionConstraint&"
        },
        {
          "name": "Context",
          "type": "FCollisionContext&"
        }
      ],
      "returnType": "Void",
      "docs": "@brief Set the collision from the parameter and activate it\nThis is used by the Resim restore functionality"
    },
    {
      "id": "generate-collision-impl",
      "name": "GenerateCollisionImpl",
      "category": "ParticlePairMidPhase",
      "signature": "GenerateCollisionImpl(Target, Dt, Cull Distance, Relative Movement, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FSingleShapePairCollisionDetector*"
        },
        {
