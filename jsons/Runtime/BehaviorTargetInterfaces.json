{
  "id": "behavior-target-interfaces",
  "label": "BehaviorTargetInterfaces",
  "includepath": "BaseBehaviors/BehaviorTargetInterfaces.h",
  "includes": [
    "CoreMinimal",
    "InputState"
  ],
  "functions": [
    {
      "id": "on-update-modifier-state",
      "name": "OnUpdateModifierState",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnUpdateModifierState(Target, Modifier ID, Is On)",
      "params": [
        {
          "name": "Target",
          "type": "IModifierToggleBehaviorTarget*"
        },
        {
          "name": "Modifier ID",
          "type": "Int"
        },
        {
          "name": "Is On",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Notify target of current modifier state\n@param ModifierID client-defined integer that identifiers modifier\n@param bIsOn is modifier current on or off"
    },
    {
      "id": "on-force-end-capture",
      "name": "OnForceEndCapture",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnForceEndCapture(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IModifierToggleBehaviorTarget*"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target that capture is ending",
      "supportedTargets": [
        "IModifierToggleBehaviorTarget*",
        "IKeyInputBehaviorTarget*"
      ]
    },
    {
      "id": "on-key-pressed",
      "name": "OnKeyPressed",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnKeyPressed(Target, Key ID)",
      "params": [
        {
          "name": "Target",
          "type": "IKeyInputBehaviorTarget*"
        },
        {
          "name": "Key ID",
          "type": "FKey&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-key-released",
      "name": "OnKeyReleased",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnKeyReleased(Target, Key ID)",
      "params": [
        {
          "name": "Target",
          "type": "IKeyInputBehaviorTarget*"
        },
        {
          "name": "Key ID",
          "type": "FKey&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-begin-sequence-preview",
      "name": "OnBeginSequencePreview",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnBeginSequencePreview(Target, Click Pos)",
      "params": [
        {
          "name": "Target",
          "type": "IClickSequenceBehaviorTarget*"
        },
        {
          "name": "Click Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target device position has changed but a click sequence hasn't begun yet (eg for interactive previews)\n@param ClickPos device position/ray at click point"
    },
    {
      "id": "on-next-sequence-preview",
      "name": "OnNextSequencePreview",
      "category": "BehaviorTargetInterfaces",
      "signature": "OnNextSequencePreview(Target, Click Pos)",
      "params": [
        {
          "name": "Target",
          "type": "IClickSequenceBehaviorTarget*"
        },
        {
          "name": "Click Pos",
          "type": "FInputDeviceRay&"
        }
      ],
      "returnType": "Void",
      "docs": "Notify Target device position has changed but a click hasn't ocurred yet (eg for interactive previews)\n@param ClickPos device position/ray at click point"
    },
    {
      "id": "request-abort-click-sequence",
      "name": "RequestAbortClickSequence",
      "category": "BehaviorTargetInterfaces",
      "signature": "RequestAbortClickSequence(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IClickSequenceBehaviorTarget*"
        }
      ],
      "returnType": "Bool",
      "docs": "Target overrides this and returns true if it wants to abort click sequence.\nBehavior checks every update and if this ever returns true, terminates sequence"
    },
    {
      "id": "get-edit-rate",
      "name": "GetEditRate",
