      "name": "IsEnabled",
      "category": "BehaviorTargetInterfaces",
      "signature": "IsEnabled(Target)",
      "params": [
        {
          "name": "Target",
          "type": "IPropertyInterface*"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-capture-key",
      "name": "GetCaptureKey",
      "category": "BehaviorTargetInterfaces",
      "signature": "GetCaptureKey(Target)",
      "params": [
        {
          "name": "Target",
