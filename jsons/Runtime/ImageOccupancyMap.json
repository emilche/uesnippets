    {
      "id": "compute-from-uv-space-mesh",
      "name": "ComputeFromUVSpaceMesh",
      "category": "ImageOccupancyMap",
      "signature": "ComputeFromUVSpaceMesh(Target, UV Space Mesh, Get Triangle ID Func, UV Space Mesh Tri Charts)",
      "params": [
        {
          "name": "Target",
          "type": "FImageOccupancyMap*"
        },
        {
          "name": "UV Space Mesh",
          "type": "MeshType&"
        },
        {
          "name": "Get Triangle ID Func",
          "type": "GetTriangleIDFuncType",
          "default": "[](int32 TriangleID) { return TriangleID; }"
        },
        {
          "name": "UV Space Mesh Tri Charts",
          "type": "TArray<int32>*",
          "default": "nullptr"
        }
      ],
      "returnType": "template<MeshType,GetTriangleIDFuncType> bool",
      "docs": "Computes the image occupancy map from a UV space mesh. This function classifies all the samples in the image,\nand computes the GutterTexels mapping, if you dont want the mapping you can call ClassifySamplesFromUVSpaceMesh\nand compute it yourself (eg for texture baking we use filter kernel coverage to compute the GutterTexels mapping)\n@param UVSpaceMesh UV space mesh to compute the occupancy map from.\n@param GetTriangleIDFunc Lambda to remap a texel's nearest triangle ID\n@param UVSpaceMeshTriCharts Optional UVSpaceMesh triangle ID to UV chart map"
    },
