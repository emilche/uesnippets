    {
      "id": "is-running-dedicated-server",
      "name": "IsRunningDedicatedServer",
      "category": "CoreMisc",
      "signature": "IsRunningDedicatedServer()",
      "params": [],
      "returnType": "Bool",
      "docs": "Check to see if this executable was launched as a dedicated server process and should not load client only data.\nAn editor build can be launched with -server to set this to true, but it will be false during single process PlayInEditor mode.\nThis function should not be used for gameplay or networking purposes, check for NM_DedicatedServer instead."
    },
    {
      "id": "is-running-game",
      "name": "IsRunningGame",
      "category": "CoreMisc",
      "signature": "IsRunningGame()",
      "params": [],
      "returnType": "Bool",
      "docs": "Check to see if this executable was launched as a game (not editor or dedicated server) process.\nThis is true for both client only and client/server packaged games, call IsRunningClientOnly to differentiate.\nAn editor build can be launched with -game to set this to true, but it will be false during single process PlayInEditor mode.\nThis function should not be used for gameplay or networking purposes, check the NetMode instead."
    },
    {
      "id": "is-running-client-only",
      "name": "IsRunningClientOnly",
      "category": "CoreMisc",
      "signature": "IsRunningClientOnly()",
      "params": [],
      "returnType": "Bool",
      "docs": "Check to see if this executable was launched as a client only game process that should not load server data.\nThis will be true for packaged builds with a Client target type which will define WITH_SERVER_CODE=0.\nAn editor build can be launched with -clientonly to set this to true, but it will be false during single process PlayInEditor mode.\nThis function should not be used for gameplay or networking purposes, check for NM_Client instead."
    },
