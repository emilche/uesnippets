    {
      "id": "set-data-layer-instance-runtime-state",
      "name": "SetDataLayerInstanceRuntimeState",
      "category": "DataLayers",
      "signature": "SetDataLayerInstanceRuntimeState(Target, In Data Layer Instance, In State, In Is Recursive)",
      "params": [
        {
          "name": "Target",
          "type": "UDataLayerManager*"
        },
        {
          "name": "In Data Layer Instance",
          "type": "UDataLayerInstance*"
        },
        {
          "name": "In State",
          "type": "EDataLayerRuntimeState"
        },
        {
          "name": "In Is Recursive",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Changes the Data Layer instance runtime state.\nIf recursive is set to true, the runtime state will also be applied to all child Data Layer instances.\nNote:\n- Changing the runtime state of a Client-Only Data Layer instance must be done on the client side or else it will have no effect.\n- Changing the runtime state of a Server-Only Data Layer instance can only be done on the server side or else it will have no effect.\n- Changing the runtime state of a runtime Data Layer instance (with no Load Filter set on the asset) must be done on the server side\nor else it will have no effect. The runtime state will then be replicated on the client.\n(see Data Layer asset Load Filter for more details)"
    },
    {
      "id": "set-data-layer-runtime-state",
      "name": "SetDataLayerRuntimeState",
      "category": "DataLayers",
      "signature": "SetDataLayerRuntimeState(Target, In Data Layer Asset, In State, In Is Recursive)",
      "params": [
        {
          "name": "Target",
          "type": "UDataLayerManager*"
        },
        {
          "name": "In Data Layer Asset",
          "type": "UDataLayerAsset*"
        },
        {
          "name": "In State",
          "type": "EDataLayerRuntimeState"
        },
        {
          "name": "In Is Recursive",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Bool",
      "docs": "Finds a matching Data Layer instance referencing the provided Data Layer asset and changes its runtime state (if any).\nIf recursive is set to true, the runtime state will also be applied to all child Data Layer instances.\nNote:\n- Changing the runtime state of a Client-Only Data Layer instance must be done on the client side or else it will have no effect.\n- Changing the runtime state of a Server-Only Data Layer instance can only be done on the server side or else it will have no effect.\n- Changing the runtime state of a runtime Data Layer instance (with no Load Filter set on the asset) must be done on the server side\nor else it will have no effect. The runtime state will then be replicated on the client.\n(see Data Layer asset Load Filter for more details)"
    },
