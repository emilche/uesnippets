{
  "id": "virtual-allocator",
  "label": "VirtualAllocator",
  "includepath": "HAL/VirtualAllocator.h",
  "includes": [
    "CoreTypes",
    "CriticalSection",
    "ThreadSafeCounter",
    "PlatformProcess",
    "ScopeLock",
    "AlignmentTemplates"
  ],
  "functions": [
    {
      "id": "get-pages-for-size-and-alignment",
