      "signature": "GetPagesForSizeAndAlignment(Target, Size, Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualAllocator*"
        },
        {
          "name": "Size",
          "type": "size_t"
        },
        {
          "name": "Alignment",
          "type": "size_t",
          "default": "1"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "allocate-virtual-pages",
      "name": "AllocateVirtualPages",
      "category": "VirtualAllocator",
      "signature": "AllocateVirtualPages(Target, Num Pages, Alignment For Check)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualAllocator*"
        },
        {
          "name": "Num Pages",
          "type": "UInt"
        },
        {
          "name": "Alignment For Check",
          "type": "size_t",
          "default": "1"
        }
      ],
      "returnType": "void*"
    },
    {
      "id": "free-virtual",
      "name": "FreeVirtual",
      "category": "VirtualAllocator",
      "signature": "FreeVirtual(Target, Ptr, Num Pages)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualAllocator*"
        },
        {
          "name": "Ptr",
          "type": "void*"
        },
        {
          "name": "Num Pages",
          "type": "UInt"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-stats",
      "name": "GetStats",
      "category": "VirtualAllocator",
      "signature": "GetStats(Target, Out Stats)",
      "params": [
        {
          "name": "Target",
          "type": "FVirtualAllocator*"
        },
        {
          "name": "Out Stats",
          "type": "FVirtualAllocatorStats&"
        }
      ],
      "returnType": "Void"
    }
  ]
