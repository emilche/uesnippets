    {
      "id": "create-from-mesh-description",
      "name": "CreateFromMeshDescription",
      "category": "SkeletalMeshLODImporterData",
      "signature": "CreateFromMeshDescription(In Mesh Description)",
      "params": [
        {
          "name": "In Mesh Description",
          "type": "FMeshDescription&"
        }
      ],
      "returnType": "FSkeletalMeshImportData",
      "docs": "@note MeshDescription always contains color, normal and tangent data by default. Therefore, while iterating\nover the vertices, we check if at least one normal/tangent vector is not a zero vector and the vertex color is\nnot pure white, then we set the corresponding bHasNormals/bHasTangent/bHasVertexColors flags to true."
    },
