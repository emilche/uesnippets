      "params": [
        {
          "name": "My Channel",
          "type": "Byte"
        },
        {
          "name": "Trace Complex",
          "type": "Bool"
        },
        {
          "name": "In Collision Response Container",
          "type": "FCollisionResponseContainer&"
        },
        {
          "name": "Query Param",
          "type": "FCollisionQueryParams&"
        },
        {
          "name": "Object Param",
          "type": "FCollisionObjectQueryParams&"
        },
        {
          "name": "Multitrace",
          "type": "Bool"
        }
      ],
      "returnType": "FCollisionFilterData",
      "docs": "Utility for creating a filter data object for performing a query (trace) against the scene"
    },
    {
