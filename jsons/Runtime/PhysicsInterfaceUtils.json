      "name": "DispatchOnBroken",
      "category": "PhysicsInterfaceUtils",
      "signature": "DispatchOnBroken(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FConstraintBrokenDelegateData*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "create-physics-replication-lod",
      "name": "CreatePhysicsReplicationLOD",
      "category": "PhysicsInterfaceUtils",
      "signature": "CreatePhysicsReplicationLOD(Target, Owning Phys Scene)",
      "params": [
        {
          "name": "Target",
          "type": "IPhysicsReplicationFactory*"
        },
        {
          "name": "Owning Phys Scene",
          "type": "FPhysScene*"
