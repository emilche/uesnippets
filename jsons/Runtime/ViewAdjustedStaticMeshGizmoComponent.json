  "functions": [
    {
      "id": "set-transform-adjuster",
      "name": "SetTransformAdjuster",
      "category": "ViewAdjustedStaticMeshGizmoComponent",
      "signature": "SetTransformAdjuster(Target, Adjuster)",
      "params": [
        {
          "name": "Target",
          "type": "UViewAdjustedStaticMeshGizmoComponent*"
        },
        {
          "name": "Adjuster",
          "type": "TSharedPtr<UE::GizmoRenderingUtil::IViewBasedTransformAdjuster>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-render-visibility-function",
      "name": "SetRenderVisibilityFunction",
      "category": "ViewAdjustedStaticMeshGizmoComponent",
      "signature": "SetRenderVisibilityFunction(Target, Render Visibility Func)",
      "params": [
        {
          "name": "Target",
          "type": "UViewAdjustedStaticMeshGizmoComponent*"
        },
        {
          "name": "Render Visibility Func",
          "type": "TFunction<bool ( UE::GizmoRenderingUtil::ISceneViewInterface& View,FTransform& ComponentToWorld )>"
        }
      ],
      "returnType": "Void",
      "docs": "The render visibility function is an optional function that can hide the component based on view\ninformation (for instance to hide an arrow gizmo when looking directly down the arrow). It must\nbe callable from both the game and the render threads (for line traces and rendering)."
    },
    {
      "id": "set-all-materials",
      "name": "SetAllMaterials",
      "category": "ViewAdjustedStaticMeshGizmoComponent",
      "signature": "SetAllMaterials(Target, Material)",
      "params": [
        {
          "name": "Target",
          "type": "UViewAdjustedStaticMeshGizmoComponent*"
        },
        {
          "name": "Material",
          "type": "UMaterialInterface*"
        }
      ],
      "returnType": "Void",
      "docs": "Helper method that just sets the same material in all slots. Does not include hover override material."
    },
    {
      "id": "set-hover-override-material",
      "name": "SetHoverOverrideMaterial",
      "category": "ViewAdjustedStaticMeshGizmoComponent",
      "signature": "SetHoverOverrideMaterial(Target, Material)",
      "params": [
        {
          "name": "Target",
          "type": "UViewAdjustedStaticMeshGizmoComponent*"
        },
        {
          "name": "Material",
          "type": "UMaterialInterface*"
        }
      ],
      "returnType": "Void",
      "docs": "Sets a material that will override all material slots whenever the component is told that is being\nhovered (via UpdateHoverState)."
    },
    {
      "id": "set-substitute-interaction-component",
      "name": "SetSubstituteInteractionComponent",
      "category": "ViewAdjustedStaticMeshGizmoComponent",
      "signature": "SetSubstituteInteractionComponent(Target, Component, Relative Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UViewAdjustedStaticMeshGizmoComponent*"
        },
        {
          "name": "Component",
          "type": "UPrimitiveComponent*"
        },
        {
          "name": "Relative Transform",
          "type": "FTransform&",
          "default": "FTransform::Identity"
        }
      ],
      "returnType": "Void",
      "docs": "Sets a mesh that is swapped in while the component is being interacted with. This is done by not rendering this\ncomponent and making the substitute component visible."
    },
