{
  "id": "view-adjusted-static-mesh-gizmo-component",
  "label": "ViewAdjustedStaticMeshGizmoComponent",
  "includepath": "BaseGizmos/ViewAdjustedStaticMeshGizmoComponent.h",
  "includes": [
    "StaticMeshComponent",
    "GizmoBaseComponent",
    "ViewAdjustedStaticMeshGizmoComponent.generated"
