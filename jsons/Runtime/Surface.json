    },
    {
      "id": "evaluate-point-in-cylindrical-space",
      "name": "EvaluatePointInCylindricalSpace",
      "category": "Surface",
      "signature": "EvaluatePointInCylindricalSpace(Target, In Surfacic Coordinate)",
      "params": [
        {
          "name": "Target",
          "type": "FSurface*"
        },
        {
          "name": "In Surfacic Coordinate",
          "type": "FVector2d&"
        }
      ],
      "returnType": "FVector2d",
      "docs": "X = Rho cos(Alpha)\nY = Rho sin(Alpha)\nZ = Z\nYZ => cylindrical projection\nXY => Plan projection along rotation axis\nFor Normal(u,v) parallel Rotation Axis -> use Plan projection\nFor Normal(u,v) perpendicular to Rotation Axis -> use cylindrical projection"
    },
