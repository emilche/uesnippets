    {
      "id": "get-iso-tolerances",
      "name": "GetIsoTolerances",
      "category": "Surface",
      "signature": "GetIsoTolerances(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FSurface*"
        }
      ],
      "returnType": "FSurfacicTolerance&",
      "docs": "Tolerance along Iso U/V is very costly to compute and not accurate.\nA first approximation is based on the surface parametric space length along U and along V\nIndeed, defining a Tolerance2D has no sense has the boundary length along an Iso could be very very huge compare to the boundary length along the other Iso like [[0, 1000] [0, 1]]\n@see FBoundary::ComputeMinimalTolerance\nIn the used, a local tolerance has to be estimated"
    },
    {
      "id": "get-iso-tolerance",
      "name": "GetIsoTolerance",
      "category": "Surface",
      "signature": "GetIsoTolerance(Target, Iso)",
      "params": [
        {
          "name": "Target",
          "type": "FSurface*"
        },
        {
          "name": "Iso",
          "type": "EIso"
        }
      ],
      "returnType": "Double",
      "docs": "Return the minimum tolerance in the parametric space of the surface along the specified axis\nWith Tolerance3D = FSysteme.GeometricalTolerance\n@see FBoundary::ComputeMinimalTolerance"
    },
