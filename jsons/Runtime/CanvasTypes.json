      "id": "get-batched-elements",
      "name": "GetBatchedElements",
      "category": "CanvasTypes",
      "signature": "GetBatchedElements(Target, In Element Type, In Batched Element Parameters, Texture, Blend Mode, Glow Info, Apply DPI Scale)",
      "params": [
        {
          "name": "Target",
          "type": "FCanvas*"
        },
        {
          "name": "In Element Type",
          "type": "EElementType"
        },
        {
          "name": "In Batched Element Parameters",
          "type": "FBatchedElementParameters*",
          "default": "NULL"
        },
        {
          "name": "Texture",
          "type": "FTexture*",
          "default": "NULL"
        },
        {
          "name": "Blend Mode",
          "type": "ESimpleElementBlendMode",
          "default": "SE_BLEND_MAX"
        },
        {
          "name": "Glow Info",
          "type": "FDepthFieldGlowInfo&",
          "default": "FDepthFieldGlowInfo()"
        },
        {
          "name": "Apply DPI Scale",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "FBatchedElements*",
      "docs": "Returns a FBatchedElements pointer to be used for adding vertices and primitives for rendering.\nAdds a new render item to the sort element entry based on the current sort key.\n@param InElementType - Type of element we are going to draw.\n@param InBatchedElementParameters - Parameters for this element\n@param InTexture - New texture that will be set.\n@param InBlendMode - New blendmode that will be set.\n@param GlowInfo - info for optional glow effect when using depth field rendering\n@return Returns a pointer to a FBatchedElements object."
    },
