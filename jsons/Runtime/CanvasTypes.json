        },
        {
          "name": "Out Wrapped Line Data",
          "type": "FWrappedLineData*"
        }
      ],
      "returnType": "Void",
      "docs": "Used to generate multi-line/wrapped text.\n@param InString The unwrapped text.\n@param InFontInfo The font used to render the text.\n@param InWrapWidth The width available.\n@param OutWrappedLineData An optional array to fill with the indices from the source string marking the begin and end points of the wrapped lines"
    },
