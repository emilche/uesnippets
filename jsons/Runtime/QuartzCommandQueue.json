      ],
      "returnType": "Void",
      "docs": "void PumpCommandQueue(TArray<IConsumerBase*>& InListeners)\n{\nQueue.ConsumeAllFifo([&InListeners](TUniquePtr<ICommandBase> InCommand)\n{\nfor(TUniquePtr<ICommandBase> Listener : InListeners)\n{\nif (ensure(InCommand))\n{\nListener->Accept(*InCommand);\n}\n}\n});\n}"
