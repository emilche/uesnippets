      "id": "fai-stimulus",
      "name": "FAIStimulus",
      "category": "AIPerceptionTypes",
      "signature": "FAIStimulus(Sense, Stimulus Strength, In Stimulus Location, In Receiver Location, Result, In Stimulus Tag)",
      "params": [
        {
          "name": "Sense",
          "type": "UAISense&"
        },
        {
          "name": "Stimulus Strength",
          "type": "Float"
        },
        {
          "name": "In Stimulus Location",
          "type": "FVector&"
        },
        {
          "name": "In Receiver Location",
          "type": "FVector&"
        },
        {
          "name": "Result",
          "type": "FResult",
          "default": "SensingSucceeded"
        },
        {
          "name": "In Stimulus Tag",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "public :",
      "docs": "this means the stimulus was originally created with a \"time limit\" and this time has passed.\nExpiration also results in calling MarkNoLongerSensed"
    },
