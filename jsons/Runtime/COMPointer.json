      "params": [
        {
          "name": "Target",
          "type": "TComPtr*"
        },
        {
          "name": "Riid",
          "type": "REFIID"
        },
        {
          "name": "Unknown",
          "type": "IUnknown*"
        }
      ],
      "returnType": "HRESULT",
      "docs": "Initialize this pointer from a COM interface to be queried.\n@param Riid The ID of the interface to be queried.\n@param Unknown The object to query the interface from.\n@return The result code of the query."
