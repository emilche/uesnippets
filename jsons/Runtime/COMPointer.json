    {
      "id": "attach",
      "name": "Attach",
      "category": "COMPointer",
      "signature": "Attach(Target, Object)",
      "params": [
        {
          "name": "Target",
          "type": "TComPtr*"
        },
        {
          "name": "Object",
          "type": "PointerType*"
        }
