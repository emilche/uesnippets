{
  "id": "multi-box-defs",
  "label": "MultiBoxDefs",
  "includepath": "Framework/MultiBox/MultiBoxDefs.h",
  "includes": [
    "CoreMinimal",
    "Attribute",
    "ISlateStyle",
    "UICommandInfo",
    "SlateStructs",
    "MultiBoxDefs.generated"
  ],
  "functions": [
    {
      "id": "construct-default-tool-tip",
      "name": "ConstructDefaultToolTip",
      "category": "MultiBoxDefs",
      "signature": "ConstructDefaultToolTip(Tool Tip Text, Override Content, Action, Show Action Shortcut)",
      "params": [
        {
          "name": "Tool Tip Text",
          "type": "TAttribute<FText>&"
        },
        {
          "name": "Override Content",
          "type": "TSharedPtr<SWidget>&"
        },
        {
          "name": "Action",
          "type": "TSharedPtr<FUICommandInfo>&"
        },
        {
          "name": "Show Action Shortcut",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "TSharedRef<SToolTip>"
    },
    {
      "id": "reset-tool-tip-constructor",
      "name": "ResetToolTipConstructor",
      "category": "MultiBoxDefs",
      "signature": "ResetToolTipConstructor()",
      "params": [],
      "returnType": "Void"
    },
    {
      "id": "allow-customization",
      "name": "AllowCustomization",
      "category": "MultiBoxDefs",
      "signature": "AllowCustomization(In Customization Name)",
      "params": [
        {
          "name": "In Customization Name",
          "type": "Name"
        }
      ],
      "returnType": "FMultiBoxCustomization"
    },
    {
      "id": "get-customization-name",
      "name": "GetCustomizationName",
      "category": "MultiBoxDefs",
      "signature": "GetCustomizationName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMultiBoxCustomization*"
        }
      ],
      "returnType": "Name"
    },
    {
      "id": "to-name",
      "name": "ToName",
      "category": "MultiBoxDefs",
      "signature": "ToName(Style Name, In Location)",
      "params": [
        {
          "name": "Style Name",
          "type": "Name"
        },
        {
          "name": "In Location",
          "type": "Type"
        }
      ],
      "returnType": "Name",
      "docs": "The Name of the customization that uniquely identifies the multibox for saving and loading users data"
    },
    {
      "id": "to-horizontal-margin",
      "name": "ToHorizontalMargin",
      "category": "MultiBoxDefs",
      "signature": "ToHorizontalMargin(In Box Type, In Location, Margin)",
      "params": [
        {
          "name": "In Box Type",
          "type": "EMultiBoxType"
        },
        {
          "name": "In Location",
          "type": "Type"
        },
        {
          "name": "Margin",
          "type": "FMargin"
        }
      ],
      "returnType": "FMargin",
      "docs": "Trims a provided margin based on the block location. Grouped multiblocks want to be\ndirectly next to each other so that they can be presented as a single visual item.\nThis function allows for defining a single \"padding between items\" value and have the\nappropriate sides of that padding zeroed out.\n@param InBoxType The type of box the group is within. Used to determine horizontal/vertical flow.\n@param InLocation The location of the block within the group.\n@param Margin The margin around a group or individual block.\n@return The margin for the block at the given location."
    }
  ]
}