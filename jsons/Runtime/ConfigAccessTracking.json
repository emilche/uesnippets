{
  "id": "config-access-tracking",
  "label": "ConfigAccessTracking",
  "includepath": "Misc/ConfigAccessTracking.h",
  "includes": [
    "Platform",
    "NameTypes",
    "atomic",
    "StringView",
    "Function",
    "RefCounting"
  ],
  "functions": [
    {
      "id": "get-filename-to-load",
      "name": "GetFilenameToLoad",
      "category": "ConfigAccessTracking",
      "signature": "GetFilenameToLoad(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFile*"
        }
      ],
      "returnType": "Name"
    },
    {
      "id": "get-platform-name",
      "name": "GetPlatformName",
      "category": "ConfigAccessTracking",
      "signature": "GetPlatformName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FFile*"
        }
      ],
      "returnType": "Name"
    },
    {
      "id": "set-as-load-type-config-system",
      "name": "SetAsLoadTypeConfigSystem",
      "category": "ConfigAccessTracking",
      "signature": "SetAsLoadTypeConfigSystem(Target, Config System, Config File)",
      "params": [
        {
          "name": "Target",
          "type": "FFile*"
        },
        {
          "name": "Config System",
          "type": "FConfigCacheIni&"
        },
        {
          "name": "Config File",
          "type": "FConfigFile&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "add-config-value-read-callback",
      "name": "AddConfigValueReadCallback",
      "category": "ConfigAccessTracking",
      "signature": "AddConfigValueReadCallback(Callback)",
      "params": [
        {
          "name": "Callback",
          "type": "FConfigValueReadCallbackFunc"
        }
      ],
      "returnType": "FConfigValueReadCallbackId",
      "docs": "Subscribe to events sent whenever any FConfigValue is read."
    },
    {
      "id": "remove-config-value-read-callback",
      "name": "RemoveConfigValueReadCallback",
      "category": "ConfigAccessTracking",
      "signature": "RemoveConfigValueReadCallback(Delegate Handle)",
      "params": [
        {
          "name": "Delegate Handle",
          "type": "FConfigValueReadCallbackId"
        }
      ],
      "returnType": "Void",
      "docs": "Remove a subscriber that was added via FConfigValue."
    },
    {
      "id": "on-config-value-read-internal",
      "name": "OnConfigValueReadInternal",
      "category": "ConfigAccessTracking",
      "signature": "OnConfigValueReadInternal(Section, Value Name, Config Value)",
      "params": [
        {
          "name": "Section",
          "type": "UE::ConfigAccessTracking::FSection*"
        },
        {
          "name": "Value Name",
          "type": "FMinimalName"
        },
        {
          "name": "Config Value",
          "type": "FConfigValue&"
        }
      ],
      "returnType": "Void",
      "docs": "Stores the number of existing AddConfigValueReadCallback subscribers. We use it to avoid the cost\nof a function call when no subscribers are registered."
    }
  ]
}