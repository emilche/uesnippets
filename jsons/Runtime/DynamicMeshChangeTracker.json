    {
      "id": "f-dynamic-mesh-change-tracker-dd27e6",
      "name": "FDynamicMeshChangeTracker",
      "category": "DynamicMeshChangeTracker",
      "signature": "FDynamicMeshChangeTracker(Mesh)",
      "params": [
        {
          "name": "Mesh",
          "type": "FDynamicMesh3*"
        }
      ],
      "returnType": "Void",
      "docs": "FDynamicMeshChangeTracker tracks changes to a FDynamicMesh and returns a\nFDynamicMeshChange instance that represents this change and allows it to be reverted/reapplied.\nThis is the top-level class you likely want to use to track mesh changes.\nCall BeginChange() before making any changes to the mesh, then call SaveVertex()\nand SaveTriangle() before modifying the respective elements. Then call EndChange()\nto construct a FDynamicMeshChange that represents the mesh delta.\n@warning Currently only vertices that are part of saved triangles will be stored in the emitted FMeshChange!"
    },
