    {
      "id": "send-override-object-event",
      "name": "SendOverrideObjectEvent",
      "category": "OverrideEventHelper",
      "signature": "SendOverrideObjectEvent(Object)",
      "params": [
        {
          "name": "Object",
          "type": "TNotNull<UObject*>"
        }
      ],
      "returnType": "Void",
      "docs": "Helper method that calls the pre and post change notification responsible for overriding an object.\nThis is the preferred way to override because it will notify listeners\n@param Object to override all it's properties"
    },
    {
      "id": "send-clear-overrides-event",
      "name": "SendClearOverridesEvent",
      "category": "OverrideEventHelper",
      "signature": "SendClearOverridesEvent(Object)",
      "params": [
        {
          "name": "Object",
          "type": "TNotNull<UObject*>"
        }
      ],
      "returnType": "Void",
      "docs": "Helper method that calls the pre and post change notification responsible for clearing the overrides of an object.\nThis is the preferred way to clear overrides because it will notify listeners\n@param Object to clear overrides on"
    },
    {
      "id": "send-override-property-event-339f0a",
      "name": "SendOverridePropertyEvent",
      "category": "OverrideEventHelper",
      "signature": "SendOverridePropertyEvent(Object, Property Path, Change Type)",
      "params": [
        {
          "name": "Object",
          "type": "TNotNull<UObject*>"
        },
        {
          "name": "Property Path",
          "type": "FPropertyVisitorPath&"
        },
        {
          "name": "Change Type",
          "type": "EPropertyChangeType::Type",
          "default": "EPropertyChangeType::Unspecified"
        }
      ],
      "returnType": "Void",
      "docs": "Helper method that calls the pre and post change notification responsible for overriding an object property.\nThis is the preferred way to override properties because it will notify listeners\nNote: If you're also changing property values (especially if it's in a container) use SendPreOverridePropertyEvent and SendPostOverridePropertyEvent instead!\n@param Object owning the property\n@param PropertyPath leading to the property that is about to be overridden\n@param ChangeType of the current operation"
    },
