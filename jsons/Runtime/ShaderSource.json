    {
      "id": "set",
      "name": "Set",
      "category": "ShaderSource",
      "signature": "Set(Target, In Src, Additional Slack)",
      "params": [
        {
          "name": "Target",
          "type": "FShaderSource*"
        },
        {
          "name": "In Src",
          "type": "FViewType"
        },
        {
          "name": "Additional Slack",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Set the given string as the contents of this shader source object. The inner allocation will grow to fit\nthe string contents as needed.\nNote that this will incur a memcpy of the string contents.\n@param InSrc The source string to be copied\n@param AdditionalSlack optional additional space to allocate; this is on top of the automatic padding."
    },
    {
      "id": "shrink-to-len",
      "name": "ShrinkToLen",
      "category": "ShaderSource",
      "signature": "ShrinkToLen(Target, Num, Allow Shrinking)",
      "params": [
        {
          "name": "Target",
          "type": "FShaderSource*"
        },
        {
          "name": "Num",
          "type": "Int"
        },
        {
          "name": "Allow Shrinking",
          "type": "EAllowShrinking",
          "default": "EAllowShrinking::Default"
        }
      ],
      "returnType": "Void",
      "docs": "Reduces the set size of the stored string length, optionally shrinking the allocation.\n@param Num the desired allocation size (padding bytes will be added on top of this)\n@param AllowShrinking whether to reallocate or keep the existing larger size allocation"
    },
