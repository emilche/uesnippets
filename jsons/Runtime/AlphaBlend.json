{
  "id": "alpha-blend",
  "label": "AlphaBlend",
  "includepath": "AlphaBlend.h",
  "includes": [
    "CoreMinimal",
    "ObjectMacros",
    "AlphaBlend.generated"
  ],
  "functions": [
    {
      "id": "set-blend-option",
      "name": "SetBlendOption",
      "category": "AlphaBlend",
      "signature": "SetBlendOption(Target, In Blend Option)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Blend Option",
          "type": "EAlphaBlendOption"
        }
      ],
      "returnType": "Void",
      "docs": "Setters - need to refresh cached value"
    },
    {
      "id": "set-custom-curve",
      "name": "SetCustomCurve",
      "category": "AlphaBlend",
      "signature": "SetCustomCurve(Target, In Custom Curve)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Custom Curve",
          "type": "UCurveFloat*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "set-blend-time",
      "name": "SetBlendTime",
      "category": "AlphaBlend",
      "signature": "SetBlendTime(Target, In Blend Time)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Blend Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Update transition blend time. This new value will be applied in the next Update."
    },
    {
      "id": "set-value-range",
      "name": "SetValueRange",
      "category": "AlphaBlend",
      "signature": "SetValueRange(Target, Begin, Desired)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "Begin",
          "type": "Float"
        },
        {
          "name": "Desired",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the range of values to map to the interpolation\n@param Begin : this is start value\n@param Desired : this is target value\nThis can be (0, 1) if you'd like to increase, or it can be (1, 0) if you'd like to get to 0"
    },
    {
      "id": "set-desired-value",
      "name": "SetDesiredValue",
      "category": "AlphaBlend",
      "signature": "SetDesiredValue(Target, In Desired)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Desired",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the final desired value for the blended value"
    },
    {
      "id": "set-alpha",
      "name": "SetAlpha",
      "category": "AlphaBlend",
      "signature": "SetAlpha(Target, In Alpha)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Alpha",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the Lerp alpha value directly. PLEASE NOTE that this modifies the Blended Value right away."
    },
    {
      "id": "update",
      "name": "Update",
      "category": "AlphaBlend",
      "signature": "Update(Target, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "Update interpolation, has to be called once every frame.\n@return How much time remains after the blend completed if applicable\ne.g. if we have 0.01s left on the blend and update at 30Hz (~0.033s) we would return ~0.023s"
    },
    {
      "id": "is-complete",
      "name": "IsComplete",
      "category": "AlphaBlend",
      "signature": "IsComplete(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        }
      ],
      "returnType": "Bool",
      "docs": "Gets whether or not the blend is complete"
    },
    {
      "id": "alpha-to-blend-option",
      "name": "AlphaToBlendOption",
      "category": "AlphaBlend",
      "signature": "AlphaToBlendOption(In Alpha, In Blend Option, In Custom Curve)",
      "params": [
        {
          "name": "In Alpha",
          "type": "Float"
        },
        {
          "name": "In Blend Option",
          "type": "EAlphaBlendOption"
        },
        {
          "name": "In Custom Curve",
          "type": "UCurveFloat*",
          "default": "nullptr"
        }
      ],
      "returnType": "Float",
      "docs": "Converts InAlpha from a linear 0...1 value into the output alpha described by InBlendOption\n@param InAlpha In linear 0...1 alpha\n@param InBlendOption The type of blend to use\n@param InCustomCurve The curve to use when blend option is set to custom"
    },
    {
      "id": "reset-alpha",
      "name": "ResetAlpha",
      "category": "AlphaBlend",
      "signature": "ResetAlpha(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        }
      ],
      "returnType": "Void",
      "docs": "Reset alpha, this keeps current BlendedValue but modify Alpha to keep the blending state."
    },
    {
      "id": "reset-blend-time",
      "name": "ResetBlendTime",
      "category": "AlphaBlend",
      "signature": "ResetBlendTime(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FAlphaBlend*"
        }
      ],
      "returnType": "Void",
      "docs": "Reset Blend Time, this modifies BlendTimeRemaining and possibly Weight when BlendTimeRemaining <= 0.f"
    }
  ]
}