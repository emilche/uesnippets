      "params": [
        {
          "name": "Target",
          "type": "UUserDefinedStructEditorDataBase*"
        },
        {
          "name": "Struct",
          "type": "UUserDefinedStruct*"
        },
        {
          "name": "Name",
          "type": "Name"
        }
      ],
      "returnType": "FProperty*"
