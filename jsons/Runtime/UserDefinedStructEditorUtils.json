    {
      "id": "get-friendly-name-for-property",
      "name": "GetFriendlyNameForProperty",
      "category": "UserDefinedStructEditorUtils",
      "signature": "GetFriendlyNameForProperty(Target, Struct, Property)",
      "params": [
        {
          "name": "Target",
          "type": "UUserDefinedStructEditorDataBase*"
        },
        {
          "name": "Struct",
          "type": "UUserDefinedStruct*"
        },
        {
          "name": "Property",
          "type": "FProperty*"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "get-tooltip",
      "name": "GetTooltip",
      "category": "UserDefinedStructEditorUtils",
