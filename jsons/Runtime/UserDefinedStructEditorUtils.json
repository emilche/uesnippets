{
  "id": "user-defined-struct-editor-utils",
  "label": "UserDefinedStructEditorUtils",
  "includepath": "StructUtils/UserDefinedStructEditorUtils.h",
  "includes": [
    "UserDefinedStruct",
    "UserDefinedStructEditorUtils.generated"
  ],
  "functions": [
    {
      "id": "on-structure-changed",
      "name": "OnStructureChanged",
      "category": "UserDefinedStructEditorUtils",
      "signature": "OnStructureChanged(Struct)",
      "params": [
        {
          "name": "Struct",
          "type": "UUserDefinedStruct*"
        }
      ],
      "returnType": "Void",
      "docs": "called after UDS was changed by editor"
    },
    {
      "id": "is-structure-valid",
      "name": "IsStructureValid",
      "category": "UserDefinedStructEditorUtils",
      "signature": "IsStructureValid(Struct, Recursion Parent, Out Msg)",
      "params": [
        {
          "name": "Struct",
          "type": "UScriptStruct*"
        },
        {
          "name": "Recursion Parent",
          "type": "UStruct*",
          "default": "nullptr"
        },
        {
          "name": "Out Msg",
          "type": "String*",
          "default": "nullptr"
        }
      ],
      "returnType": "EStructureError",
      "docs": "Can the structure be a member variable for a BPGClass or BPGStruct"
    }
  ]
}