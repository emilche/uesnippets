          "type": "FModulationDestination&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "init-efd82e",
      "name": "Init",
      "category": "SoundModulationDestination",
      "signature": "Init(Target, In Device Id, In Is Buffered, In Value Normalized)",
      "params": [
        {
          "name": "Target",
          "type": "FModulationDestination*"
        },
        {
          "name": "In Device Id",
          "type": "FDeviceId"
        },
        {
          "name": "In Is Buffered",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Value Normalized",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes the modulation destination\nInDeviceId - DeviceId associated with modulation plugin instance\nbInIsBuffered - Whether or not to run destination in \"buffered mode,\" which manages an internal buffer to smooth modulation value between process calls\nbInValueNormalized - Whether or not to keep the output value in normalized, unitless [0.0f, 1.0f] space"
    },
    {
      "id": "init-8a285c",
      "name": "Init",
      "category": "SoundModulationDestination",
      "signature": "Init(Target, In Device Id, In Parameter Name, In Is Buffered, In Value Normalized)",
      "params": [
        {
          "name": "Target",
          "type": "FModulationDestination*"
        },
        {
          "name": "In Device Id",
          "type": "FDeviceId"
        },
        {
          "name": "In Parameter Name",
          "type": "Name"
        },
        {
          "name": "In Is Buffered",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Value Normalized",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Initializes the modulation destination\nInDeviceId - DeviceId associated with modulation plugin instance\nInParameterName - Name of parameter used to mix/convert destination value to/from unit space\nbInIsBuffered - Whether or not to run destination in \"buffered mode,\" which manages an internal buffer to smooth modulation value between process calls\nbInValueNormalized - Whether or not to keep the output value in normalized, unitless [0.0f, 1.0f] space"
    },
    {
      "id": "is-active",
      "name": "IsActive",
      "category": "SoundModulationDestination",
      "signature": "IsActive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FModulationDestination*"
        }
      ],
      "returnType": "Bool",
      "docs": "returns whether or not destination references an active modulator"
    },
    {
      "id": "process-control",
      "name": "ProcessControl",
      "category": "SoundModulationDestination",
      "signature": "ProcessControl(Target, In Value Unit Base, In Num Samples)",
      "params": [
        {
          "name": "Target",
          "type": "FModulationDestination*"
        },
        {
          "name": "In Value Unit Base",
          "type": "Float"
        },
        {
          "name": "In Num Samples",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Bool",
      "docs": "Updates internal value (or buffer if set to bIsBuffered) to current modulated result using the provided value as the base carrier value to modulate.\nReturns true if value was updated."
    },
