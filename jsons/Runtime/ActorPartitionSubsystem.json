    {
      "id": "get-actor-4b3aa5",
      "name": "GetActor",
      "category": "ActorPartitionSubsystem",
      "signature": "GetActor(Target, In Actor Class, In Cell Coords, In Create, In Guid, In Grid Size, In Bounds Search, In Actor Created)",
      "params": [
        {
          "name": "Target",
          "type": "UActorPartitionSubsystem*"
        },
        {
          "name": "In Actor Class",
          "type": "TSubclassOf<APartitionActor>&"
        },
        {
          "name": "In Cell Coords",
          "type": "FCellCoord&"
        },
        {
          "name": "In Create",
          "type": "Bool"
        },
        {
          "name": "In Guid",
          "type": "FGuid&",
          "default": "FGuid()"
        },
        {
          "name": "In Grid Size",
          "type": "UInt",
          "default": "0"
        },
        {
          "name": "In Bounds Search",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "In Actor Created",
          "type": "TFunctionRef<void ( APartitionActor* )>",
          "default": "DefaultPartitionActorCreated"
        }
      ],
      "returnType": "APartitionActor*",
      "docs": "Returns a matching actor based on the parameters being provided\n@param InActorClass The type of actor we are searching for.\n@param InCellCoords The cell coordinate of that actor.\n@param bInCreate If the actor doesn't existe should we created it.\n@param InGuid Optional, if multiple actors of the same InActorClass exist user can provide Guid id.\n@param InGridSize Optional, if not provided the InActorClass CDO will be used to determine GridSize.\n@param bInBoundsSearch Optional, if not specified existing actors will be searched in the cell bounds only."
    },
