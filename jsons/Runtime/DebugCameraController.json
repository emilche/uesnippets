{
  "id": "debug-camera-controller",
  "label": "DebugCameraController",
  "includepath": "Engine/DebugCameraController.h",
  "includes": [
    "CoreMinimal",
    "HitResult",
    "ObjectMacros",
    "EngineTypes",
    "FinalPostProcessSettings",
    "SceneTypes",
    "PlayerController",
    "DebugCameraController.generated"
  ],
  "functions": [
    {
      "id": "get-selected-actor",
      "name": "GetSelectedActor",
      "category": "Debug Camera",
      "signature": "GetSelectedActor(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        }
      ],
      "returnType": "AActor*",
      "docs": "Returns the currently selected actor, or null if it is invalid or not set"
    },
    {
      "id": "set-pawn-movement-speed-scale",
      "name": "SetPawnMovementSpeedScale",
      "category": "Debug Camera",
      "signature": "SetPawnMovementSpeedScale(Target, New Speed Scale)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "New Speed Scale",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the pawn movement speed scale."
    },
    {
      "id": "apply-speed-scale",
      "name": "ApplySpeedScale",
      "category": "DebugCameraController",
      "signature": "ApplySpeedScale(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "on-activate",
      "name": "OnActivate",
      "category": "DebugCameraController",
      "signature": "OnActivate(Target, Original PC)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "Original PC",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void",
      "docs": "Function called on activation debug camera controller"
    },
    {
      "id": "receive-on-deactivate",
      "name": "ReceiveOnDeactivate",
      "category": "DebugCameraController",
      "signature": "ReceiveOnDeactivate(Target, Restored PC)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "Restored PC",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void",
      "docs": "Function called on deactivation of debug camera controller.\n@param RestoredPC The Player Controller that the player input is being returned to."
    },
    {
      "id": "on-deactivate",
      "name": "OnDeactivate",
      "category": "DebugCameraController",
      "signature": "OnDeactivate(Target, Restored PC)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "Restored PC",
          "type": "APlayerController*"
        }
      ],
      "returnType": "Void",
      "docs": "Function called on deactivation debug camera controller"
    },
    {
      "id": "update-hidden-components",
      "name": "UpdateHiddenComponents",
      "category": "DebugCameraController",
      "signature": "UpdateHiddenComponents(Target, View Location, Hidden Components)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "View Location",
          "type": "FVector&"
        },
        {
          "name": "Hidden Components",
          "type": "TSet<FPrimitiveComponentId>&"
        }
      ],
      "returnType": "Void",
      "docs": "Builds a list of components that are hidden based upon gameplay\n@param ViewLocation the view point to hide/unhide from\n@param HiddenComponents the list to add to/remove from"
    },
    {
      "id": "post-initialize-components",
      "name": "PostInitializeComponents",
      "category": "DebugCameraController",
      "signature": "PostInitializeComponents(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "console-command",
      "name": "ConsoleCommand",
      "category": "DebugCameraController",
      "signature": "ConsoleCommand(Target, Command, Write To Log)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "Command",
          "type": "String&"
        },
        {
          "name": "Write To Log",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "String"
    },
    {
      "id": "add-cheats",
      "name": "AddCheats",
      "category": "DebugCameraController",
      "signature": "AddCheats(Target, Force)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "Force",
          "type": "Bool"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "end-spectating-state",
      "name": "EndSpectatingState",
      "category": "DebugCameraController",
      "signature": "EndSpectatingState(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "spawn-spectator-pawn",
      "name": "SpawnSpectatorPawn",
      "category": "DebugCameraController",
      "signature": "SpawnSpectatorPawn(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        }
      ],
      "returnType": "ASpectatorPawn*",
      "docs": "Custom spawn to spawn a default SpectatorPawn, to use as a spectator and initialize it. By default it is spawned at the PC's current location and rotation."
    },
    {
      "id": "receive-on-actor-selected",
      "name": "ReceiveOnActorSelected",
      "category": "Debug Camera",
      "signature": "ReceiveOnActorSelected(Target, New Selected Actor, Select Hit Location, Select Hit Normal, Hit)",
      "params": [
        {
          "name": "Target",
          "type": "ADebugCameraController*"
        },
        {
          "name": "New Selected Actor",
          "type": "AActor*"
        },
        {
          "name": "Select Hit Location",
          "type": "FVector&"
        },
        {
          "name": "Select Hit Normal",
          "type": "FVector&"
        },
        {
          "name": "Hit",
          "type": "FHitResult&"
        }
      ],
      "returnType": "Void",
      "docs": "Called when an actor has been selected with the primary key (e.g. left mouse button).\nThe selection trace starts from the center of the debug camera's view.\n@param SelectHitLocation The exact world-space location where the selection trace hit the New Selected Actor.\n@param SelectHitNormal The world-space surface normal of the New Selected Actor at the hit location."
    }
  ]
}