        },
        {
          "name": "In Collection",
          "type": "FManagedArrayCollection&"
        },
        {
          "name": "Skip List",
          "type": "TMap<FName,TSet<FName>>*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Copy attributes that match the input collection. This is a utility to easily sync collections\n@param InCollection - All groups from this collection found in the input will be sized accordingly\n@param SkipList - Group/Attrs to skip. Keys are group names, values are attributes in those groups."
    },
    {
      "id": "copy-matching-attributes-from-6f80a1",
      "name": "CopyMatchingAttributesFrom",
      "category": "ManagedArrayCollection",
      "signature": "CopyMatchingAttributesFrom(Target, From Collection, Skip List)",
      "params": [
        {
          "name": "Target",
          "type": "FManagedArrayCollection*"
        },
        {
          "name": "From Collection",
          "type": "FManagedArrayCollection&"
        },
        {
          "name": "Skip List",
          "type": "TArrayView<FAttributeAndGroupId>"
        }
      ],
      "returnType": "Void",
      "docs": "Copy attributes that match the input collection. This is a utility to easily sync collections\nThis version is recommend to be used as it is more performant overall\n- it only resize the necessary groups\n- it takes a array view for the skip list\n- it has a more contained logic that reduces the number of lookups for attributes in the maps\n@param InCollection - All groups from this collection found in the input will be sized accordingly\n@param SkipList - Group/Attrs to skip. Keys are group names, values are attributes in those groups."
    },
