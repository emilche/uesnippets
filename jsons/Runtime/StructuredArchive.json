  "functions": [
    {
      "id": "f-structured-archive-cace49",
      "name": "FStructuredArchive",
      "category": "StructuredArchive",
      "signature": "FStructuredArchive(In Formatter)",
      "params": [
        {
          "name": "In Formatter",
          "type": "FArchiveFormatterType&"
        }
      ],
      "returnType": "Void",
      "docs": "Manages the state of an underlying FStructuredArchiveFormatter, and provides a consistent API for reading and writing to a structured archive.\nBoth reading and writing to the archive are *forward only* from an interface point of view. There is no point at which it is possible to\nrequire seeking."
    },
    {
      "id": "f-structured-archive-d9eecb",
      "name": "FStructuredArchive",
      "category": "StructuredArchive",
      "signature": "FStructuredArchive()",
      "params": [],
      "returnType": "Void",
      "docs": "Default destructor. Closes the archive."
    },
    {
      "id": "open",
      "name": "Open",
      "category": "StructuredArchive",
      "signature": "Open(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStructuredArchive*"
        }
      ],
      "returnType": "FStructuredArchiveSlot",
      "docs": "Start writing to the archive, and gets an interface to the root slot."
    },
    {
      "id": "close",
      "name": "Close",
      "category": "StructuredArchive",
      "signature": "Close(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStructuredArchive*"
        }
      ],
      "returnType": "Void",
      "docs": "Flushes any remaining scope to the underlying formatter and closes the archive."
    },
    {
      "id": "enter-slot",
      "name": "EnterSlot",
      "category": "StructuredArchive",
      "signature": "EnterSlot(Target, Slot, Entering Attributed Value)",
      "params": [
        {
          "name": "Target",
          "type": "FStructuredArchive*"
        },
        {
          "name": "Slot",
          "type": "UE::StructuredArchive::Private::FSlotPosition"
        },
        {
          "name": "Entering Attributed Value",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "The next element id to be assigned"
    },
    {
      "id": "enter-slot-as-type",
      "name": "EnterSlotAsType",
      "category": "StructuredArchive",
      "signature": "EnterSlotAsType(Target, Slot, Element Type)",
      "params": [
        {
          "name": "Target",
          "type": "FStructuredArchive*"
        },
        {
          "name": "Slot",
          "type": "UE::StructuredArchive::Private::FSlotPosition"
        },
        {
          "name": "Element Type",
          "type": "UE::StructuredArchive::Private::EElementType"
        }
      ],
      "returnType": "Int",
      "docs": "Enters the current slot, adding an element onto the stack. Asserts if the archive is not in a state about to write to an empty-slot.\n@return  The depth of the newly-entered slot."
    },
    {
      "id": "leave-slot",
      "name": "LeaveSlot",
      "category": "StructuredArchive",
      "signature": "LeaveSlot(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FStructuredArchive*"
        }
      ],
      "returnType": "Void",
      "docs": "Leaves slot at the top of the current scope"
    },
    {
      "id": "set-scope",
      "name": "SetScope",
      "category": "StructuredArchive",
      "signature": "SetScope(Target, Slot)",
      "params": [
