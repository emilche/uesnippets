      "id": "f-shader-parameters-metadata-8fa29d",
      "name": "FShaderParametersMetadata",
      "category": "ShaderParameterMetadata",
      "signature": "FShaderParametersMetadata(Use Case, In Binding Flags, In Layout Name, In Struct Type Name, In Shader Variable Name, In Static Slot Name, In File Name, In File Line, In Size, In Members, Force Complete Initialization, Out Layout Initializer, In Usage Flags)",
      "params": [
        {
          "name": "Use Case",
          "type": "EUseCase"
        },
        {
          "name": "In Binding Flags",
          "type": "EUniformBufferBindingFlags"
        },
        {
          "name": "In Layout Name",
          "type": "TCHAR*"
        },
        {
          "name": "In Struct Type Name",
          "type": "TCHAR*"
        },
        {
          "name": "In Shader Variable Name",
          "type": "TCHAR*"
        },
        {
          "name": "In Static Slot Name",
          "type": "TCHAR*"
        },
        {
          "name": "In File Name",
          "type": "ANSICHAR*"
        },
        {
          "name": "In File Line",
          "type": "Int"
        },
        {
          "name": "In Size",
          "type": "UInt"
        },
        {
          "name": "In Members",
          "type": "TArray<FMember>&"
        },
        {
          "name": "Force Complete Initialization",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Out Layout Initializer",
          "type": "FRHIUniformBufferLayoutInitializer*",
          "default": "nullptr"
        },
        {
          "name": "In Usage Flags",
          "type": "EUsageFlags",
          "default": "EUsageFlags::None"
        }
      ],
      "returnType": "Void",
      "docs": "Initialization constructor.\nEUseCase::UniformBuffer are listed in the global GetStructList() that will be visited at engine startup to know all the global uniform buffer\nthat can generate code in /Engine/Generated/GeneratedUniformBuffers.ush. Their initialization will be finished during the this list\ntraversal. bForceCompleteInitialization force to ignore the list for EUseCase::UniformBuffer and instead handle it like a standalone non\nglobally listed EUseCase::ShaderParameterStruct. This is required for the ShaderCompileWorker to deserialize them without side global effects."
    },
