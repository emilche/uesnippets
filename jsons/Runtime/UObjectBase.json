    {
      "id": "is-valid-low-level-fast",
      "name": "IsValidLowLevelFast",
      "category": "UObjectBase",
      "signature": "IsValidLowLevelFast(Target, Recursive)",
      "params": [
        {
          "name": "Target",
          "type": "UObjectBase*"
        },
        {
          "name": "Recursive",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Bool",
      "docs": "Faster version of IsValidLowLevel.\nChecks to see if the object appears to be valid by checking pointers and their alignment.\nName and InternalIndex checks are less accurate than IsValidLowLevel.\n@param bRecursive true if the Class pointer should be checked with IsValidLowLevelFast\n@return true if this appears to be a valid object"
    },
    {
      "id": "get-unique-id",
      "name": "GetUniqueID",
      "category": "UObjectBase",
      "signature": "GetUniqueID(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UObjectBase*"
        }
      ],
      "returnType": "UInt",
      "docs": "Returns the unique ID of the object...these are reused so it is only unique while the object is alive.\nUseful as a tag."
    },
