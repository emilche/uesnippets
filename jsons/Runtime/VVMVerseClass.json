        }
      ],
      "returnType": "UE::Core::FVersePath"
    },
    {
      "id": "track-default-initialized-properties",
      "name": "TrackDefaultInitializedProperties",
      "category": "VVMVerseClass",
      "signature": "TrackDefaultInitializedProperties(Target, Default Data)",
