    {
      "id": "rename-default-subobjects",
      "name": "RenameDefaultSubobjects",
      "category": "VVMVerseClass",
      "signature": "RenameDefaultSubobjects(In Object)",
      "params": [
        {
          "name": "In Object",
          "type": "UObject*"
        }
      ],
      "returnType": "Void",
      "docs": "Renames default sub-objects on a CDO so that they're unique (named after properties they are assigned to)\n@param  InObject Object (usually a CDO) whose default sub-objects are to be renamed"
    },
    {
      "id": "validate-subobject-archetypes",
      "name": "ValidateSubobjectArchetypes",
      "category": "VVMVerseClass",
      "signature": "ValidateSubobjectArchetypes(In Object, In Archetype)",
      "params": [
        {
          "name": "In Object",
          "type": "UObject*"
        },
        {
          "name": "In Archetype",
          "type": "UObject*"
        }
      ],
      "returnType": "Bool",
      "docs": "Checks that the sub-objects of a given Verse object are using the correct sub-archetype.\n@param  InObject Object whose default sub-objects we are validating\n@param  InArchetype The archetype of InObject"
    },
    {
      "id": "enable-dynamic-instanced-reference-support",
      "name": "EnableDynamicInstancedReferenceSupport",
      "category": "VVMVerseClass",
      "signature": "EnableDynamicInstancedReferenceSupport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "disable-dynamic-instanced-reference-support",
      "name": "DisableDynamicInstancedReferenceSupport",
      "category": "VVMVerseClass",
      "signature": "DisableDynamicInstancedReferenceSupport(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "for-each-verse-function",
      "name": "ForEachVerseFunction",
      "category": "VVMVerseClass",
      "signature": "ForEachVerseFunction(Target, Object, Operation, Iteration Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Operation",
          "type": "TFunctionRef<bool ( FVerseFunctionDescriptor )>"
        },
        {
          "name": "Iteration Flags",
          "type": "EFieldIterationFlags",
          "default": "EFieldIterationFlags::None"
        }
      ],
      "returnType": "Void",
      "docs": "Iterates over Verse Function Properties on an object instance and executes a callback with VerseFunction value and its Verse name.\n@param Object Object instance to iterate Verse Functions for\n@param Operation callback for each of the found Verse Functions. When the callback returns false, iteration is stopped.\n@param IterationFlags Additional options used when iterating over Verse Function properties"
    },
    {
      "id": "find-verse-function-by-display-name",
      "name": "FindVerseFunctionByDisplayName",
      "category": "VVMVerseClass",
      "signature": "FindVerseFunctionByDisplayName(Target, Object, Display Name, Search Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Display Name",
          "type": "String&"
        },
        {
          "name": "Search Flags",
          "type": "EFieldIterationFlags",
          "default": "EFieldIterationFlags::None"
        }
      ],
      "returnType": "FVerseFunctionDescriptor",
      "docs": "Returns a VerseFunction value given its display name\n@param Object Object instance to iterate Verse Functions for\n@param VerseName Display name of the function\n@param SearchFlags Additional options used when iterating over Verse Function properties\n@return VerseFunction value acquired from the provided Object instance or invalid function value if none was found."
    },
    {
      "id": "get-verse-function-parameter-count",
      "name": "GetVerseFunctionParameterCount",
      "category": "VVMVerseClass",
      "signature": "GetVerseFunctionParameterCount(Func)",
      "params": [
        {
          "name": "Func",
          "type": "UFunction*"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the number of parameters a verse function takes"
    },
    {
