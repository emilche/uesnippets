    {
      "id": "for-each-verse-function",
      "name": "ForEachVerseFunction",
      "category": "VVMVerseClass",
      "signature": "ForEachVerseFunction(Target, Object, Operation, Iteration Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Operation",
          "type": "TFunctionRef<bool ( FVerseFunctionDescriptor )>"
        },
        {
          "name": "Iteration Flags",
          "type": "EFieldIterationFlags",
          "default": "EFieldIterationFlags::None"
        }
      ],
      "returnType": "Void",
      "docs": "Iterates over Verse Function Properties on an object instance and executes a callback with VerseFunction value and its Verse name.\n@param Object Object instance to iterate Verse Functions for\n@param Operation callback for each of the found Verse Functions. When the callback returns false, iteration is stopped.\n@param IterationFlags Additional options used when iterating over Verse Function properties"
    },
    {
      "id": "find-verse-function-by-display-name",
      "name": "FindVerseFunctionByDisplayName",
      "category": "VVMVerseClass",
      "signature": "FindVerseFunctionByDisplayName(Target, Object, Display Name, Search Flags)",
      "params": [
        {
          "name": "Target",
          "type": "UVerseClass*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Display Name",
          "type": "String&"
        },
        {
          "name": "Search Flags",
          "type": "EFieldIterationFlags",
          "default": "EFieldIterationFlags::None"
        }
      ],
      "returnType": "FVerseFunctionDescriptor",
      "docs": "Returns a VerseFunction value given its display name\n@param Object Object instance to iterate Verse Functions for\n@param VerseName Display name of the function\n@param SearchFlags Additional options used when iterating over Verse Function properties\n@return VerseFunction value acquired from the provided Object instance or invalid function value if none was found."
    },
