    },
    {
      "id": "set-meta-class",
      "name": "SetMetaClass",
      "category": "UnrealTypePrivate",
      "signature": "SetMetaClass(Target, New Meta Class)",
      "params": [
        {
          "name": "Target",
          "type": "UClassProperty*"
        },
        {
          "name": "New Meta Class",
          "type": "UClass*"
        }
      ],
      "returnType": "Void",
      "docs": "Setter function for this property's MetaClass member. Favor this function\nwhilst loading (since, to handle circular dependencies, we defer some\nclass loads and use a placeholder class instead). It properly handles\ndeferred loading placeholder classes (so they can properly be replaced\nlater).\n@param  NewMetaClass    The MetaClass you want this property set with."
    },
    {
      "id": "set-interface-class",
      "name": "SetInterfaceClass",
      "category": "UnrealTypePrivate",
      "signature": "SetInterfaceClass(Target, New Interface Class)",
      "params": [
