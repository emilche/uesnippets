    {
      "id": "get-owner-property",
      "name": "GetOwnerProperty",
      "category": "UnrealTypePrivate",
      "signature": "GetOwnerProperty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProperty*"
        }
      ],
      "returnType": "UProperty*",
      "docs": "Returns the first UProperty in this property's Outer chain that does not have a UProperty for an Outer"
    },
    {
      "id": "has-any-property-flags",
      "name": "HasAnyPropertyFlags",
      "category": "UnrealTypePrivate",
      "signature": "HasAnyPropertyFlags(Target, Flags To Check)",
      "params": [
        {
          "name": "Target",
          "type": "UProperty*"
        },
        {
          "name": "Flags To Check",
          "type": "UInt64"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "has-all-property-flags",
      "name": "HasAllPropertyFlags",
      "category": "UnrealTypePrivate",
      "signature": "HasAllPropertyFlags(Target, Flags To Check)",
      "params": [
        {
          "name": "Target",
          "type": "UProperty*"
        },
        {
          "name": "Flags To Check",
          "type": "UInt64"
        }
      ],
      "returnType": "Bool",
      "docs": "Used to safely check whether all of the passed in flags are set. This is required\nas PropertyFlags currently is a 64 bit data type and bool is a 32 bit data type so\nsimply using PropertyFlags&CPF_MyFlagBiggerThanMaxInt won't work correctly when\nassigned directly to an bool.\n@param FlagsToCheck\tObject flags to check for\n@return true if all of the passed in flags are set (including no flags passed in), false otherwise"
    },
    {
      "id": "is-editor-only-property",
      "name": "IsEditorOnlyProperty",
      "category": "UnrealTypePrivate",
      "signature": "IsEditorOnlyProperty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UProperty*"
        }
      ],
      "returnType": "Bool",
      "docs": "Editor-only properties are those that only are used with the editor is present or cannot be removed from serialisation.\nEditor-only properties include: EditorOnly properties\nProperties that cannot be removed from serialisation are:\nBoolean properties (may affect GCC_BITFIELD_MAGIC computation)\nNative properties (native serialisation)"
    },
