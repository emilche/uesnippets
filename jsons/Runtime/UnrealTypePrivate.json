      "id": "set-bool-size",
      "name": "SetBoolSize",
      "category": "UnrealTypePrivate",
      "signature": "SetBoolSize(Target, In Size, Is Native Bool, In Bit Mask)",
      "params": [
        {
          "name": "Target",
          "type": "UBoolProperty*"
        },
        {
          "name": "In Size",
          "type": "UInt"
        },
        {
          "name": "Is Native Bool",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "In Bit Mask",
          "type": "UInt",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the bitfield/bool type and size.\nThis function must be called before UBoolProperty can be used.\n@param InSize size of the bitfield/bool type.\n@param bIsNativeBool true if this property represents C++ bool type."
