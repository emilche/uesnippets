          "type": "TSharedRef<SWidget>&"
        }
      ],
      "returnType": "Int",
      "docs": "Removes a slot from this box panel which contains the specified SWidget\n@param SlotWidget The widget to match when searching through the slots\n@returns The index in the children array where the slot was removed and -1 if no slot was found matching the widget"
