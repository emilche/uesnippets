          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "When true, use the WrapSize property to determine where to wrap to the next line."
    },
    {
      "id": "set-orientation",
      "name": "SetOrientation",
      "category": "SWrapBox",
