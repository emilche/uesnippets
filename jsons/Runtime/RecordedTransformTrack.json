      "name": "IsTimeValid",
      "category": "RecordedTransformTrack",
      "signature": "IsTimeValid(Target, In Time)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Time",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Validates that the time is within the track timestamp bounds (inclusive)"
    },
    {
      "id": "find-last-key-before",
      "name": "FindLastKeyBefore",
      "category": "RecordedTransformTrack",
      "signature": "FindLastKeyBefore(Target, In Time)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Time",
          "type": "Float"
        }
      ],
      "returnType": "Int",
      "docs": "Finds the index of the key immediately before the provided time. Or the exact\nframe in the case of an exact time match"
    },
    {
      "id": "find-recorded-frame",
      "name": "FindRecordedFrame",
      "category": "RecordedTransformTrack",
      "signature": "FindRecordedFrame(Target, In Time, In Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "In Tolerance",
          "type": "Float",
          "default": "UE_SMALL_NUMBER"
        }
      ],
      "returnType": "FRecordedFrame*",
      "docs": "Find a frame at InTime if available within a specified tolarance of the timestamp"
    },
    {
      "id": "find-recorded-frame-index",
      "name": "FindRecordedFrameIndex",
      "category": "RecordedTransformTrack",
      "signature": "FindRecordedFrameIndex(Target, In Time, In Tolerance)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "In Tolerance",
          "type": "Float",
          "default": "UE_SMALL_NUMBER"
        }
      ],
      "returnType": "Int",
      "docs": "Find a frame index at InTime if available within a specified tolarance of the timestamp"
    },
    {
      "id": "get-frames-for-time",
      "name": "GetFramesForTime",
      "category": "RecordedTransformTrack",
      "signature": "GetFramesForTime(Target, In Time, Out First, Out Second)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "Out First",
          "type": "FRecordedFrame*&"
        },
        {
          "name": "Out Second",
          "type": "FRecordedFrame*&"
        }
      ],
      "returnType": "Void",
      "docs": "Given a time, return either one or two frames. If InTime is exactly on a frame then only that frame is returned.\nIf we are beyond the end of the track only the last is returned. For times in the middle of the track that are\nnot exactly on a frame then the frame before and after the time are returned."
    },
    {
      "id": "get-transform-at-time",
      "name": "GetTransformAtTime",
      "category": "RecordedTransformTrack",
      "signature": "GetTransformAtTime(Target, In Index, In Time)",
      "params": [
        {
          "name": "Target",
