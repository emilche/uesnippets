        },
        {
          "name": "In Time",
          "type": "Float"
        },
        {
          "name": "Sample Width",
          "type": "Float",
          "default": "1.0f / 120.0f"
        }
      ],
      "returnType": "FVector",
      "docs": "Get an interpolated linear velocity for the specified particle at the provided time - using SampleWidth to pick out a window of interpolation"
    },
