        },
        {
          "name": "In Time",
          "type": "Float"
        }
      ],
      "returnType": "FTransform",
      "docs": "Given a time, get an interpolated transform from the track for a provided particle"
    },
    {
      "id": "get-disabled-at-time",
      "name": "GetDisabledAtTime",
      "category": "RecordedTransformTrack",
      "signature": "GetDisabledAtTime(Target, In Index, In Time)",
