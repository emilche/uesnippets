        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Index",
          "type": "Int"
        },
        {
          "name": "In Time",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Get whether a particle is disabled at a provided time"
    },
    {
      "id": "get-was-active-in-window",
      "name": "GetWasActiveInWindow",
      "category": "RecordedTransformTrack",
      "signature": "GetWasActiveInWindow(Target, In Index, In Begin Time, In End Time)",
      "params": [
        {
          "name": "Target",
          "type": "FRecordedTransformTrack*"
        },
        {
          "name": "In Index",
          "type": "Int"
        },
        {
          "name": "In Begin Time",
          "type": "Float"
        },
        {
          "name": "In End Time",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Given two times, find out if the provided particle was ever active within them"
    },
    {
      "id": "get-linear-velocity-at-time",
      "name": "GetLinearVelocityAtTime",
      "category": "RecordedTransformTrack",
      "signature": "GetLinearVelocityAtTime(Target, In Index, In Time, Sample Width)",
      "params": [
        {
          "name": "Target",
