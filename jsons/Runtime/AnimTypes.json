    {
      "id": "was-synchronized-counter",
      "name": "WasSynchronizedCounter",
      "category": "AnimTypes",
      "signature": "WasSynchronizedCounter(Target, In Other Counter)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphTraversalCounter*"
        },
        {
          "name": "In Other Counter",
          "type": "FGraphTraversalCounter&"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if this counter is either synchronized with another or is one update behind"
    },
    {
      "id": "was-synchronized-last-frame",
      "name": "WasSynchronizedLastFrame",
      "category": "AnimTypes",
      "signature": "WasSynchronizedLastFrame(Target, In Other Counter)",
      "params": [
        {
          "name": "Target",
          "type": "FGraphTraversalCounter*"
        },
        {
          "name": "In Other Counter",
          "type": "FGraphTraversalCounter&"
        }
      ],
      "returnType": "Bool",
      "docs": "Check whether this counter and another were either synchronized this global frame or were\nsynced one frame interval previously. A frame interval is the size of SkipFrames. This means\nthat if under URO a number of frames are skipped, this check will consider counters from the\nlast frame before the skip and the first frame after the skip as \"was synchronized\"\nUse this to test whether or not there's been a period when the owning animation instance has\nnot been updated."
    },
