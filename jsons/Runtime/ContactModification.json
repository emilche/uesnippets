  "functions": [
    {
      "id": "disable",
      "name": "Disable",
      "category": "ContactModification",
      "signature": "Disable(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Void",
      "docs": "Disable all contact points for this pair of bodies."
    },
    {
      "id": "enable",
      "name": "Enable",
      "category": "ContactModification",
      "signature": "Enable(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Void",
      "docs": "Enables all contact points for this pair of bodies. This does nothing unless Disable() was previously called."
    },
    {
      "id": "convert-to-probe",
      "name": "ConvertToProbe",
      "category": "ContactModification",
      "signature": "ConvertToProbe(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Void",
      "docs": "Convert the constraint between this pair of bodies into a probe. Collision callbacks will still occur if the\nbodies collide (a contact occurring in contact modification does not mean a contact actually has occurred\nyet, but that it may)"
    },
    {
      "id": "convert-to-non-probe",
      "name": "ConvertToNonProbe",
      "category": "ContactModification",
      "signature": "ConvertToNonProbe(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Void",
      "docs": "Convert the constraint from probe to a regular physical collision"
    },
    {
      "id": "get-is-probe",
      "name": "GetIsProbe",
      "category": "ContactModification",
      "signature": "GetIsProbe(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Bool",
      "docs": "Return true if this constraint is a probe type"
    },
    {
      "id": "get-num-contacts",
      "name": "GetNumContacts",
      "category": "ContactModification",
      "signature": "GetNumContacts(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "Int",
      "docs": "@return Number of contact points in constraint pair. ContactPointIdx must be below number of contacts."
    },
    {
      "id": "get-deepest-contact-index",
      "name": "GetDeepestContactIndex",
