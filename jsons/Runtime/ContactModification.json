    {
      "id": "get-restitution-threshold",
      "name": "GetRestitutionThreshold",
      "category": "ContactModification",
      "signature": "GetRestitutionThreshold(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        }
      ],
      "returnType": "FReal",
      "docs": "@return Restitution threshold of contact. If velocity of object is below this threshold, no restitution is applied."
    },
    {
      "id": "modify-restitution-threshold",
      "name": "ModifyRestitutionThreshold",
      "category": "ContactModification",
      "signature": "ModifyRestitutionThreshold(Target, Restitution)",
