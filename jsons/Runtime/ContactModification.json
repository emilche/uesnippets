    {
      "id": "get-separation",
      "name": "GetSeparation",
      "category": "ContactModification",
      "signature": "GetSeparation(Target, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "FReal",
      "docs": "@return separation of contact locations in direction of normal."
    },
    {
      "id": "get-target-separation",
      "name": "GetTargetSeparation",
      "category": "ContactModification",
      "signature": "GetTargetSeparation(Target, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "FReal",
      "docs": "@return desired separation of contact locations in direction of normal."
    },
    {
      "id": "modify-target-separation",
      "name": "ModifyTargetSeparation",
      "category": "ContactModification",
      "signature": "ModifyTargetSeparation(Target, Target Separation, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Target Separation",
          "type": "FReal"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Set the desired separation at the contact point (negative for penetration)."
    },
    {
      "id": "get-world-normal",
      "name": "GetWorldNormal",
      "category": "ContactModification",
      "signature": "GetWorldNormal(Target, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "FVec3",
      "docs": "@brief Get the world-space contact normal.\n@note The contact normal always points away from the second body.\nE.g., a sphere lying on a flat ground could return a WorldNormal pointing up or down, depending on whether the\nsphere is the first or second body in the constraint.\n@return Normal of contact in world space."
    },
    {
      "id": "modify-world-normal",
      "name": "ModifyWorldNormal",
      "category": "ContactModification",
      "signature": "ModifyWorldNormal(Target, Normal, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Normal",
          "type": "FVec3&"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Modify contact normal in world space. If modifying separation and normal, order of operations should be considered.\n@note The contact normal should always point away from the second body."
    },
    {
      "id": "get-world-contact-locations",
      "name": "GetWorldContactLocations",
      "category": "ContactModification",
      "signature": "GetWorldContactLocations(Target, Contact Point Idx, Out Location 0, Out Location 1)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        },
        {
          "name": "Out Location 0",
          "type": "FVec3&"
        },
        {
          "name": "Out Location 1",
          "type": "FVec3&"
        }
      ],
      "returnType": "Void",
      "docs": "Get contact location on each body in world space."
    },
    {
      "id": "get-world-contact-location",
      "name": "GetWorldContactLocation",
      "category": "ContactModification",
      "signature": "GetWorldContactLocation(Target, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "FVec3",
      "docs": "@return Contact location. This is midpoint of each body's contact location."
    },
    {
      "id": "modify-world-contact-locations",
      "name": "ModifyWorldContactLocations",
      "category": "ContactModification",
      "signature": "ModifyWorldContactLocations(Target, Location 0, Location 1, Contact Point Idx)",
      "params": [
        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Location 0",
          "type": "FVec3&"
        },
        {
          "name": "Location 1",
          "type": "FVec3&"
        },
        {
          "name": "Contact Point Idx",
          "type": "Int"
        }
      ],
      "returnType": "Void",
      "docs": "Modify contact location of each body in world space. If modifying locations and separation, order of operations should be considered."
    },
    {
      "id": "get-restitution",
      "name": "GetRestitution",
