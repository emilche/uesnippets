        {
          "name": "Target",
          "type": "FContactPairModifier*"
        },
        {
          "name": "Restitution",
          "type": "FReal"
        }
      ],
      "returnType": "Void",
      "docs": "Modify restitution threshold of contact. If velocity of object is below this threshold, no restitution is applied."
    },
