    {
      "id": "convert-7d7cb4",
      "name": "Convert",
      "category": "GenericPlatformString",
      "signature": "Convert<SourceEncoding, DestEncoding>(Dest, Dest Size, Src, Src Size)",
      "params": [
        {
          "name": "Dest",
          "type": "DestEncoding*"
        },
        {
          "name": "Dest Size",
          "type": "Int"
        },
        {
          "name": "Src",
          "type": "SourceEncoding*"
        },
        {
          "name": "Src Size",
          "type": "Int"
        }
      ],
      "returnType": "template<SourceEncoding,DestEncoding> DestEncoding*",
      "docs": "Converts the [Src, Src+SrcSize) string range from SourceEncoding to DestEncoding and writes it to the [Dest, Dest+DestSize) range.\nThe Src range should contain a null terminator if a null terminator is required in the output.\nIf the Dest range is not big enough to hold the converted output, NULL is returned.  In this case, nothing should be assumed about the contents of Dest.\n@param Dest      The start of the destination buffer.\n@param DestSize  The size of the destination buffer.\n@param Src       The start of the string to convert.\n@param SrcSize   The number of Src elements to convert.\n@return          A pointer to one past the last-written element."
    },
    {
      "id": "converted-length-39e0d1",
      "name": "ConvertedLength",
      "category": "GenericPlatformString",
      "signature": "ConvertedLength<DestEncoding, SourceEncoding>(Src)",
      "params": [
        {
          "name": "Src",
          "type": "SourceEncoding*"
        }
      ],
      "returnType": "template<DestEncoding,SourceEncoding> int32",
      "docs": "Returns the required buffer length for the null-terminated Src string when converted to the DestChar encoding.\nThe returned length includes the space for the null terminator (equivalent to strlen+1).\n@param  Src  The start of the string to convert.\n@return      The number of DestChar elements that Src will be converted into."
    },
    {
