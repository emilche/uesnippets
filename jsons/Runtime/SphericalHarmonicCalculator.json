{
  "id": "spherical-harmonic-calculator",
  "label": "SphericalHarmonicCalculator",
  "includepath": "SphericalHarmonicCalculator.h",
  "includes": [
    "CoreMinimal",
    "BufferVectorOperations",
    "UnrealMemory",
    "Matrix",
    "UnrealMathSSE",
    "Vector2D"
  ],
  "functions": [
    {
      "id": "compute-soundfield-channel-gains",
      "name": "ComputeSoundfieldChannelGains",
      "category": "SphericalHarmonicCalculator",
      "signature": "ComputeSoundfieldChannelGains(Order, Azimuth, Elevation, Out Gains)",
      "params": [
        {
          "name": "Order",
          "type": "Int"
        },
        {
          "name": "Azimuth",
          "type": "Float"
        },
        {
          "name": "Elevation",
          "type": "Float"
        },
        {
          "name": "Out Gains",
          "type": "Float*"
        }
      ],
      "returnType": "Void",
      "docs": "Azimuth angle is measured CCW from front.\nElevation is 0 horizontal plane, + is above horizontal plane"
    },
    {
      "id": "generate-first-order-rotation-matrix-given-radians",
      "name": "GenerateFirstOrderRotationMatrixGivenRadians",
      "category": "SphericalHarmonicCalculator",
      "signature": "GenerateFirstOrderRotationMatrixGivenRadians(Rot X Radians, Rot Y Radians, Rot Z Radians, Out Matrix)",
      "params": [
        {
          "name": "Rot X Radians",
          "type": "Float"
        },
        {
          "name": "Rot Y Radians",
          "type": "Float"
        },
        {
          "name": "Rot Z Radians",
          "type": "Float"
        },
        {
          "name": "Out Matrix",
          "type": "FMatrix&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "generate-first-order-rotation-matrix-given-degrees",
      "name": "GenerateFirstOrderRotationMatrixGivenDegrees",
      "category": "SphericalHarmonicCalculator",
      "signature": "GenerateFirstOrderRotationMatrixGivenDegrees(Rot X Degrees, Rot Y Degrees, Rot Z Degrees, Out Matrix)",
      "params": [
        {
          "name": "Rot X Degrees",
          "type": "Float"
        },
        {
          "name": "Rot Y Degrees",
          "type": "Float"
        },
        {
          "name": "Rot Z Degrees",
          "type": "Float"
        },
        {
          "name": "Out Matrix",
          "type": "FMatrix&"
        }
      ],
      "returnType": "Void"
    }
  ]
}