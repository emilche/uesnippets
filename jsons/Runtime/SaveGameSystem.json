      "name": "DoesSaveGameExistAsync",
      "category": "SaveGameSystem",
      "signature": "DoesSaveGameExistAsync(Target, Name, Platform User Id, Callback)",
      "params": [
        {
          "name": "Target",
          "type": "ISaveGameSystem*"
        },
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Platform User Id",
          "type": "FPlatformUserId"
        },
        {
          "name": "Callback",
          "type": "FSaveGameAsyncExistsCallback"
        }
      ],
      "returnType": "Void",
      "docs": "Asyncronously checks if the named savegame exists. Default implementation runs blocking version on a background thread"
    },
