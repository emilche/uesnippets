      "id": "get-spawn-amount",
      "name": "GetSpawnAmount",
      "category": "ParticleModuleSpawnBase",
      "signature": "GetSpawnAmount(Target, Context, Offset, Old Leftover, Delta Time, Number, Rate)",
      "params": [
        {
          "name": "Target",
          "type": "UParticleModuleSpawnBase*"
        },
