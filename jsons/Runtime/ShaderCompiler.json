    {
      "id": "process-async-results-3e9219",
      "name": "ProcessAsyncResults",
      "category": "ShaderCompiler",
      "signature": "ProcessAsyncResults(Target, Time Slice, Block On Global Shader Completion)",
      "params": [
        {
          "name": "Target",
          "type": "FShaderCompilingManager*"
        },
        {
          "name": "Time Slice",
          "type": "Float"
        },
        {
          "name": "Block On Global Shader Completion",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "docs": "Processes completed asynchronous shader maps, and assigns them to relevant materials.\n@param TimeSlice - When more than 0, ProcessAsyncResults will be bandwidth throttled by the given timeslice, to limit hitching.\nProcessAsyncResults will then have to be called often to finish all shader maps (eg from Tick).  Otherwise, all compiled shader maps will be processed.\n@param bBlockOnGlobalShaderCompletion - When enabled, ProcessAsyncResults will block until global shader maps are complete.\nThis must be done before using global shaders for rendering."
    },
