    {
      "id": "compute-golden-spiral-points-be1361",
      "name": "ComputeGoldenSpiralPoints",
      "category": "Sphere",
      "signature": "ComputeGoldenSpiralPoints(Points, Center, Radius, Num Points, Bottom Half, Top Half, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<TVec3<T>>&"
        },
        {
          "name": "Center",
          "type": "TVec3<T>&"
        },
        {
          "name": "Radius",
          "type": "T"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Bottom Half",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Top Half",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Use the golden spiral method to evenly distribute points on a sphere.\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the sphere, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Center is the center of the sphere.\n\\p Radius is the radius of the sphere.\n\\p NumPoints is the number of points to generate.\n\\p BottomHalf causes the bottom half of the sphere to be generated,\nstarting at \\p Center - (0, 0, \\p Radius).\n\\p TopHalf causes the top half of the sphere to be generated,\nstarting at \\p Center.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
