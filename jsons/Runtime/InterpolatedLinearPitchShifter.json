{
  "id": "interpolated-linear-pitch-shifter",
  "label": "InterpolatedLinearPitchShifter",
  "includepath": "DSP/InterpolatedLinearPitchShifter.h",
  "includes": [
    "CoreMinimal",
    "Dsp",
    "ParamInterpolator"
  ],
  "functions": [
    {
      "id": "f-linear-pitch-shifter",
      "name": "FLinearPitchShifter",
      "category": "InterpolatedLinearPitchShifter",
      "signature": "FLinearPitchShifter(In Num Channels)",
      "params": [
        {
          "name": "In Num Channels",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "public :"
    },
    {
      "id": "reset",
      "name": "Reset",
      "category": "InterpolatedLinearPitchShifter",
      "signature": "Reset(Target, In Num Channels, In Initial Pitch Shift Semitones, In Interp Length Frames)",
      "params": [
        {
          "name": "Target",
          "type": "FLinearPitchShifter*"
        },
        {
          "name": "In Num Channels",
          "type": "Int"
        },
        {
          "name": "In Initial Pitch Shift Semitones",
          "type": "Float",
          "default": "0.0f"
        },
        {
          "name": "In Interp Length Frames",
          "type": "Int",
          "default": "100"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "process-audio",
      "name": "ProcessAudio",
      "category": "InterpolatedLinearPitchShifter",
      "signature": "ProcessAudio(Target, Input Buffer, Output Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FLinearPitchShifter*"
        },
        {
          "name": "Input Buffer",
          "type": "TArrayView<float>"
        },
        {
          "name": "Output Buffer",
          "type": "Audio::TCircularAudioBuffer<float>&"
        }
      ],
      "returnType": "Int"
    },
    {
      "id": "update-pitch-shift",
      "name": "UpdatePitchShift",
      "category": "InterpolatedLinearPitchShifter",
      "signature": "UpdatePitchShift(Target, In New Pitch Semitones)",
      "params": [
        {
          "name": "Target",
          "type": "FLinearPitchShifter*"
        },
        {
          "name": "In New Pitch Semitones",
          "type": "Float"
        }
      ],
      "returnType": "Void"
    }
  ]
}