        {
          "name": "Num",
          "type": "Int"
        },
        {
          "name": "Asset Type",
          "type": "Text&"
        },
        {
          "name": "Log Category",
          "type": "FLogCategoryBase&"
        },
        {
          "name": "Post Compile Single",
          "type": "TFunctionRef<void ( ICompilable* )>"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "f-async-compilation-standard-c-vars",
      "name": "FAsyncCompilationStandardCVars",
      "category": "AsyncCompilationHelpers",
      "signature": "FAsyncCompilationStandardCVars(Asset Type, Asset Type Plural Lower Case, Finish All Command)",
      "params": [
        {
          "name": "Asset Type",
          "type": "TCHAR*"
        },
        {
          "name": "Asset Type Plural Lower Case",
          "type": "TCHAR*"
        },
        {
          "name": "Finish All Command",
          "type": "FConsoleCommandDelegate&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "ensure-initialized-c-vars",
      "name": "EnsureInitializedCVars",
      "category": "AsyncCompilationHelpers",
      "signature": "EnsureInitializedCVars(In Name, In C Var Async Compilation, In C Var Async Compilation Max Concurrency, Experimental Settings Name)",
      "params": [
        {
          "name": "In Name",
          "type": "TCHAR*"
        },
        {
          "name": "In C Var Async Compilation",
          "type": "TAutoConsoleVariable<int32>&"
        },
        {
          "name": "In C Var Async Compilation Max Concurrency",
          "type": "TAutoConsoleVariable<int32>&"
        },
        {
          "name": "Experimental Settings Name",
          "type": "Name",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "bind-thread-pool-to-c-var",
      "name": "BindThreadPoolToCVar",
      "category": "AsyncCompilationHelpers",
      "signature": "BindThreadPoolToCVar(In Thread Pool Wrapper, In C Var Async Compilation, In C Var Async Compilation Resume, In C Var Async Compilation Max Concurrency)",
      "params": [
        {
          "name": "In Thread Pool Wrapper",
          "type": "FQueuedThreadPoolWrapper*"
        },
        {
          "name": "In C Var Async Compilation",
          "type": "TAutoConsoleVariable<int32>&"
        },
        {
          "name": "In C Var Async Compilation Resume",
          "type": "TAutoConsoleVariable<int32>&"
        },
        {
          "name": "In C Var Async Compilation Max Concurrency",
          "type": "TAutoConsoleVariable<int32>&"
        }
      ],
      "returnType": "Void"
