    },
    {
      "id": "compare-storage",
      "name": "CompareStorage",
      "category": "AttributeStorage",
      "signature": "CompareStorage(Base Storage, Version Storage, Removed Attributes, Added Attributes, Modified Attributes)",
      "params": [
        {
          "name": "Base Storage",
          "type": "FAttributeStorage&"
        },
        {
          "name": "Version Storage",
          "type": "FAttributeStorage&"
        },
        {
          "name": "Removed Attributes",
          "type": "TArray<FAttributeKey>&"
        },
        {
          "name": "Added Attributes",
          "type": "TArray<FAttributeKey>&"
        },
        {
          "name": "Modified Attributes",
          "type": "TArray<FAttributeKey>&"
        }
      ],
      "returnType": "Void",
      "docs": "Compare two storage objects to know which properties were modified/added/removed.\n@param BaseStorage - The reference storage.\n@param VersionStorage - The storage with the changes.\n@param RemovedAttribute - All attributes that are in base storage but not in version storage. Contains keys that are only valid for the base storage.\n@param AddedAttributes - All attributes that are in version storage but not in base storage. Contains keys that are only valid for the version storage.\n@param ModifiedAttributes - All attributes that are in both storage but have a different hash (different value)."
    },
    {
      "id": "copy-storage-attributes-211a24",
