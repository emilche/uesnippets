      "category": "AttributeStorage",
      "signature": "CopyStorageAttributes(Source Storage, Destination Storage, Attribute Keys)",
      "params": [
        {
          "name": "Source Storage",
          "type": "FAttributeStorage&"
        },
        {
          "name": "Destination Storage",
          "type": "FAttributeStorage&"
        },
        {
          "name": "Attribute Keys",
          "type": "TArray<FAttributeKey>&"
        }
      ],
      "returnType": "Void",
      "docs": "Copy an array of attributes from the source storage to the destination storage. If the attribute already exists in the destination, the value will be updated.\nIf a key does not exist in the source it will not be copied/created in the destination.\n@param SourceStorage - The storage source.\n@param DestinationStorage - The storage destination.\n@param AttributeKeys - All attributes that must be copied from the source to the destination."
    },
    {
      "id": "copy-storage-attributes-9fcc59",
