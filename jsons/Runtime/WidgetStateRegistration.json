{
  "id": "widget-state-registration",
  "label": "WidgetStateRegistration",
  "includepath": "Binding/States/WidgetStateRegistration.h",
  "includes": [
    "CoreMinimal",
    "Object",
    "SoftObjectPath",
    "WidgetStateBitfield",
    "WidgetStateRegistration.generated"
  ],
  "functions": [
    {
      "id": "get-state-name",
      "name": "GetStateName",
      "category": "WidgetStateRegistration",
      "signature": "GetStateName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetBinaryStateRegistration*"
        }
      ],
      "returnType": "Name",
      "docs": "Called once during WidgetStateSettings initialization to get this widget state's name",
      "supportedTargets": [
        "UWidgetBinaryStateRegistration*",
        "UWidgetHoveredStateRegistration*",
        "UWidgetPressedStateRegistration*",
        "UWidgetDisabledStateRegistration*",
        "UWidgetSelectedStateRegistration*",
        "UWidgetEnumStateRegistration*"
      ]
    },
    {
      "id": "get-registered-widget-state",
      "name": "GetRegisteredWidgetState",
      "category": "WidgetStateRegistration",
      "signature": "GetRegisteredWidgetState(Target, In Widget)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetBinaryStateRegistration*"
        },
        {
          "name": "In Widget",
          "type": "UWidget*"
        }
      ],
      "returnType": "Bool",
      "docs": "Called on widget registration to correctly initialize widget state based on the current widget",
      "supportedTargets": [
        "UWidgetBinaryStateRegistration*",
        "UWidgetHoveredStateRegistration*",
        "UWidgetPressedStateRegistration*",
        "UWidgetDisabledStateRegistration*",
        "UWidgetSelectedStateRegistration*",
        "UWidgetEnumStateRegistration*"
      ]
    },
    {
      "id": "get-registered-widget-uses-state",
      "name": "GetRegisteredWidgetUsesState",
      "category": "WidgetStateRegistration",
      "signature": "GetRegisteredWidgetUsesState(Target, In Widget)",
      "params": [
        {
          "name": "Target",
          "type": "UWidgetEnumStateRegistration*"
        },
        {
          "name": "In Widget",
          "type": "UWidget*"
        }
      ],
      "returnType": "Bool",
      "docs": "Called on widget registration to determine if this widget uses the given state"
    }
  ]
}