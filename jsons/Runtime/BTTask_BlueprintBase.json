      "name": "ReceiveExecute",
      "category": "BTTask_BlueprintBase",
      "signature": "ReceiveExecute(Target, Owner Actor)",
      "params": [
        {
          "name": "Target",
          "type": "UBTTask_BlueprintBase*"
        },
        {
          "name": "Owner Actor",
          "type": "AActor*"
        }
      ],
      "returnType": "protected : TObjectPtr<AAIController> AIOwner",
      "docs": "set if ReceiveTick is implemented by blueprint"
    },
    {
      "id": "receive-abort",
      "name": "ReceiveAbort",
      "category": "BTTask_BlueprintBase",
      "signature": "ReceiveAbort(Target, Owner Actor)",
      "params": [
        {
          "name": "Target",
          "type": "UBTTask_BlueprintBase*"
        },
        {
          "name": "Owner Actor",
          "type": "AActor*"
        }
      ],
      "returnType": "Void",
      "docs": "if blueprint graph contains this event, task will stay active until FinishAbort is called\n@Note that if both generic and AI event versions are implemented only the more\nsuitable one will be called, meaning the AI version if called for AI, generic one otherwise"
    },
    {
      "id": "receive-tick",
      "name": "ReceiveTick",
      "category": "BTTask_BlueprintBase",
      "signature": "ReceiveTick(Target, Owner Actor, Delta Seconds)",
      "params": [
        {
          "name": "Target",
          "type": "UBTTask_BlueprintBase*"
        },
        {
          "name": "Owner Actor",
          "type": "AActor*"
        },
        {
          "name": "Delta Seconds",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "tick function\n@Note that if both generic and AI event versions are implemented only the more\nsuitable one will be called, meaning the AI version if called for AI, generic one otherwise"
    },
    {
      "id": "receive-execute-ai",
      "name": "ReceiveExecuteAI",
      "category": "AI",
