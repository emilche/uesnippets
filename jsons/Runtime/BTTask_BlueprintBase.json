      "category": "AI",
      "signature": "SetFinishOnMessage(Target, Message Name)",
      "params": [
        {
          "name": "Target",
          "type": "UBTTask_BlueprintBase*"
        },
        {
          "name": "Message Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "task execution will be finished (with result 'Success') after receiving specified message"
    },
    {
      "id": "set-finish-on-message-with-id",
