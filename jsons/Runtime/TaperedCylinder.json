    {
      "id": "compute-golden-spiral-points-f7a644",
      "name": "ComputeGoldenSpiralPoints",
      "category": "TaperedCylinder",
      "signature": "ComputeGoldenSpiralPoints(Points, Origin, Axis, Radius 1, Radius 2, Height, Num Points, Include End Caps, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Origin",
          "type": "FVec3&"
        },
        {
          "name": "Axis",
          "type": "FVec3&"
        },
        {
          "name": "Radius 1",
          "type": "FReal"
        },
        {
          "name": "Radius 2",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Include End Caps",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Use the golden spiral method to generate evenly spaced points on a tapered\ncylinder (truncated cone).\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the cylinder, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Origin is the bottom-most point of the tapered cylinder.\n\\p Axis is the orientation of the tapered cylinder.\n\\p Radius1 is the first radius of the tapered cylinder.\n\\p Radius2 is the second radius of the tapered cylinder.\n\\p Height is the height of the tapered cylinder.\n\\p NumPoints is the number of points to generate.\n\\p IncludeEndCaps determines whether or not points are generated on the\nend caps of the tapered cylinder.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
    {
      "id": "compute-golden-spiral-points-unoriented",
      "name": "ComputeGoldenSpiralPointsUnoriented",
      "category": "TaperedCylinder",
      "signature": "ComputeGoldenSpiralPointsUnoriented(Points, Radius 1, Radius 2, Height, Num Points, Include End Caps, Spiral Seed)",
      "params": [
        {
          "name": "Points",
          "type": "TArray<FVec3>&"
        },
        {
          "name": "Radius 1",
          "type": "FReal"
        },
        {
          "name": "Radius 2",
          "type": "FReal"
        },
        {
          "name": "Height",
          "type": "FReal"
        },
        {
          "name": "Num Points",
          "type": "Int"
        },
        {
          "name": "Include End Caps",
          "type": "Bool",
          "default": "true"
        },
        {
          "name": "Spiral Seed",
          "type": "Int",
          "default": "0"
        }
      ],
      "returnType": "Void",
      "docs": "Generates points on a tapered cylinder (truncated cone), oriented about\nthe Z axis, varying from [-Height/2, Height/2].\nTODO: Note that this method does not produce evenly spaced points!  It'll\nbunch points together on the side of the cylinder with the smaller radius,\nand spread them apart on the larger.  We need a routine that operates in\nconical space, rather than cylindrical.  That said, points are distributed\nevenly between the two end caps, proportional to their respective areas.\nThe \"golden\" part is derived from the golden ratio; stand at the center,\nturn a golden ratio of whole turns, then emit a point in that direction.\nPoints are generated starting from the bottom of the cylinder, ending at\nthe top.  Contiguous entries in \\p Points generally will not be spatially\nadjacent.\n\\p Points to append to.\n\\p Radius1 is the first radius of the tapered cylinder.\n\\p Radius2 is the second radius of the tapered cylinder.\n\\p Height is the height of the cylinder.\n\\p NumPoints is the number of points to generate.\n\\p IncludeEndCaps determines whether or not points are generated on the\nend caps of the cylinder.\n\\p SpiralSeed is the starting index for golden spiral generation.  When\nusing this method to continue a spiral started elsewhere, \\p SpiralSeed\nshould equal the number of particles already created."
    },
