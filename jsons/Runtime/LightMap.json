    {
      "id": "allocate-light-map",
      "name": "AllocateLightMap",
      "category": "LightMap",
      "signature": "AllocateLightMap(Light Map Outer, Source Quantized Data, Source Shadow Map Data, Bounds, In Padding Type, In Lightmap Flags)",
      "params": [
        {
          "name": "Light Map Outer",
          "type": "UObject*"
        },
        {
          "name": "Source Quantized Data",
          "type": "FQuantizedLightmapData*&"
        },
        {
          "name": "Source Shadow Map Data",
          "type": "TMap<ULightComponent*,FShadowMapData2D*>&"
        },
        {
          "name": "Bounds",
          "type": "FBoxSphereBounds&"
        },
        {
          "name": "In Padding Type",
          "type": "ELightMapPaddingType"
        },
        {
          "name": "In Lightmap Flags",
          "type": "ELightMapFlags"
        }
      ],
      "returnType": "TRefCountPtr<FLightMap2D>",
      "docs": "Allocates texture space for the light-map and stores the light-map's raw data for deferred encoding.\nIf the light-map has no lights in it, it will return NULL.\nSourceQuantizedData will be deleted by this function.\n@param\tLightMapOuter - The package to create the light-map and textures in.\n@param\tSourceQuantizedData - If the data is already quantized, the values will be in here, and not in RawData.\n@param\tSourceShadowMapData - Shadow map data to be combined into the lightmap atlas, used when creating VT lightmaps\n@param\tBounds - The bounds of the primitive the light-map will be rendered on.  Used as a hint to pack light-maps on nearby primitives in the same texture.\n@param\tInPaddingType - the method for padding the lightmap.\n@param\tLightmapFlags - flags that determine how the lightmap is stored (e.g. streamed or not)"
    },
    {
      "id": "allocate-instanced-light-map",
      "name": "AllocateInstancedLightMap",
      "category": "LightMap",
      "signature": "AllocateInstancedLightMap(Light Map Outer, Component, Source Quantized Data, Instanced Shadow Map Data, Registry, Map Build Data Id, Bounds, In Padding Type, Lightmap Flags)",
      "params": [
        {
          "name": "Light Map Outer",
          "type": "UObject*"
        },
        {
          "name": "Component",
          "type": "UInstancedStaticMeshComponent*"
        },
        {
          "name": "Source Quantized Data",
          "type": "TArray<TUniquePtr<FQuantizedLightmapData>>"
        },
        {
          "name": "Instanced Shadow Map Data",
          "type": "TArray<TMap<ULightComponent*,TUniquePtr<FShadowMapData2D>>>&&"
        },
        {
          "name": "Registry",
          "type": "UMapBuildDataRegistry*"
        },
        {
          "name": "Map Build Data Id",
          "type": "FGuid"
        },
        {
          "name": "Bounds",
          "type": "FBoxSphereBounds&"
        },
        {
          "name": "In Padding Type",
          "type": "ELightMapPaddingType"
        },
        {
          "name": "Lightmap Flags",
          "type": "ELightMapFlags"
        }
      ],
      "returnType": "TRefCountPtr<FLightMap2D>",
      "docs": "Allocates texture space for the light-map and stores the light-map's raw data for deferred encoding.\nIf the light-map has no lights in it, it will return NULL.\nSourceQuantizedData will be deleted by this function.\n@param\tComponent - The component that owns this lightmap\n@param\tSourceQuantizedData - If the data is already quantized, the values will be in here, and not in RawData.\n@param\tBounds - The bounds of the primitive the light-map will be rendered on.  Used as a hint to pack light-maps on nearby primitives in the same texture.\n@param\tInPaddingType - the method for padding the lightmap.\n@param\tLightmapFlags - flags that determine how the lightmap is stored (e.g. streamed or not)"
    },
