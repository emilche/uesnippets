    {
      "id": "get-signed-distance-between-position-and-locus",
      "name": "GetSignedDistanceBetweenPositionAndLocus",
      "category": "VstNode",
      "signature": "GetSignedDistanceBetweenPositionAndLocus(A, B, Source Text)",
      "params": [
        {
          "name": "A",
          "type": "SLocus&"
        },
        {
          "name": "B",
          "type": "SPosition&"
        },
        {
          "name": "Source Text",
          "type": "CUTF8StringView&"
        }
      ],
      "returnType": "int32_t",
      "docs": "Gets the signed distance between a locus and a row/column text position. The closest distance to the locus range is used.\n@param A \t\t\tThe locus range to compare.\n@param B \t\t\tThe text position to compare.\n@param SourceText \tThe original source text that both the locus and position refer to ranges of.\n@return \t\t\tThe signed distance between the two. If A comes before B, the result is positive and vice versa."
    }
  ]
