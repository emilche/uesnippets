{
  "id": "package-file-summary",
  "label": "PackageFileSummary",
  "includepath": "UObject/PackageFileSummary.h",
  "includes": [
    "Array",
    "UnrealString",
    "CoreMinimal",
    "CoreTypes",
    "IoHash",
    "EngineVersion",
    "Guid",
    "CustomVersion",
    "StructuredArchive",
    "ObjectVersion"
  ],
  "functions": [
    {
      "id": "set-file-versions",
      "name": "SetFileVersions",
      "category": "PackageFileSummary",
      "signature": "SetFileVersions(Target, Epic UE 4, Epic UE 5, Licensee UE, In Save Unversioned)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageFileSummary*"
        },
        {
          "name": "Epic UE 4",
          "type": "Int"
        },
        {
          "name": "Epic UE 5",
          "type": "Int"
        },
        {
          "name": "Licensee UE",
          "type": "Int"
        },
        {
          "name": "In Save Unversioned",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Used to manually set the package file and licensee versions"
    },
    {
      "id": "is-file-version-valid",
      "name": "IsFileVersionValid",
      "category": "PackageFileSummary",
      "signature": "IsFileVersionValid(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageFileSummary*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns false if the summary is unversioned and the current process does not support that.\nIf this returns false and the summary was loaded from disk then the serialization of the summary was aborted early!"
    },
    {
      "id": "get-saved-hash",
      "name": "GetSavedHash",
      "category": "PackageFileSummary",
      "signature": "GetSavedHash(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageFileSummary*"
        }
      ],
      "returnType": "FIoHash",
      "docs": "Hash of the package's .uasset/.umap file when it was last saved by the editor."
    },
    {
      "id": "set-saved-hash",
      "name": "SetSavedHash",
      "category": "PackageFileSummary",
      "signature": "SetSavedHash(Target, In Saved Hash)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageFileSummary*"
        },
        {
          "name": "In Saved Hash",
          "type": "FIoHash&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-saved-hash-relative-offset",
      "name": "GetSavedHashRelativeOffset",
      "category": "PackageFileSummary",
      "signature": "GetSavedHashRelativeOffset(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPackageFileSummary*"
        }
      ],
      "returnType": "Int64"
    }
  ]
}