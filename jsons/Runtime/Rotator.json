        {
          "name": "Target",
          "type": "TRotator*"
        }
      ],
      "returnType": "nodiscard ] ] TRotator",
      "docs": "Returns the inverse of the rotator."
    },
    {
      "id": "vector",
      "name": "Vector",
      "category": "Rotator",
      "signature": "Vector(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        }
      ],
      "returnType": "nodiscard ] ] TVector<T>",
      "docs": "Convert a rotation into a unit vector facing in its direction.\n@return Rotation as a unit direction vector."
    },
    {
      "id": "quaternion",
      "name": "Quaternion",
      "category": "Rotator",
      "signature": "Quaternion(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        }
      ],
      "returnType": "nodiscard ] ] TQuat<T>",
      "docs": "Get Rotation as a quaternion.\n@return Rotation as a quaternion."
    },
    {
      "id": "euler",
      "name": "Euler",
      "category": "Rotator",
      "signature": "Euler(Target)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        }
      ],
      "returnType": "nodiscard ] ] TVector<T>",
      "docs": "Convert a Rotator into floating-point Euler angles (in degrees). Rotator now stored in degrees.\n@return Rotation as a Euler angle vector."
    },
    {
      "id": "rotate-vector",
      "name": "RotateVector",
      "category": "Rotator",
      "signature": "RotateVector(Target, V)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        },
        {
          "name": "V",
          "type": "UE::Math::TVector<T>&"
        }
      ],
      "returnType": "nodiscard ] ] TVector<T>",
      "docs": "Rotate a vector rotated by this rotator.\n@param V The vector to rotate.\n@return The rotated vector."
    },
    {
      "id": "unrotate-vector",
      "name": "UnrotateVector",
      "category": "Rotator",
      "signature": "UnrotateVector(Target, V)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        },
        {
          "name": "V",
          "type": "UE::Math::TVector<T>&"
        }
      ],
      "returnType": "nodiscard ] ] TVector<T>",
      "docs": "Returns the vector rotated by the inverse of this rotator.\n@param V The vector to rotate.\n@return The rotated vector."
    },
    {
      "id": "get-winding-and-remainder",
      "name": "GetWindingAndRemainder",
      "category": "Rotator",
      "signature": "GetWindingAndRemainder(Target, Winding, Remainder)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        },
        {
          "name": "Winding",
          "type": "TRotator<T>&"
        },
        {
          "name": "Remainder",
          "type": "TRotator<T>&"
        }
      ],
      "returnType": "Void",
      "docs": "Decompose this Rotator into a Winding part (multiples of 360) and a Remainder part.\nRemainder will always be in [-180, 180] range.\n@param Winding[Out] the Winding part of this Rotator\n@param Remainder[Out] the Remainder"
    },
    {
