      "name": "NetSerialize",
      "category": "Rotator",
      "signature": "NetSerialize(Target, Ar, Map, Out Success)",
      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        },
        {
