          "type": "UPackageMap*"
        },
        {
          "name": "Out Success",
          "type": "Bool&"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "make-from-euler",
      "name": "MakeFromEuler",
      "category": "Rotator",
      "signature": "MakeFromEuler(Euler)",
      "params": [
        {
          "name": "Euler",
          "type": "TVector<T>&"
        }
      ],
      "returnType": "nodiscard ] ] TRotator",
      "docs": "Convert a vector of floating-point Euler angles (in degrees) into a Rotator. Rotator now stored in degrees\n@param Euler Euler angle vector.\n@return A rotator from a Euler angle."
