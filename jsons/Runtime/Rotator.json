      "params": [
        {
          "name": "Target",
          "type": "TRotator*"
        },
        {
          "name": "Ar",
          "type": "FArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Serializes the rotator compressed for e.g. network transmission (use shorts though).\n@param\tAr\tArchive to serialize to/ from"
    },
