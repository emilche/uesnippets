    {
      "id": "convert-to-external-uniform-buffer",
      "name": "ConvertToExternalUniformBuffer",
      "category": "RenderGraphBuilder",
      "signature": "ConvertToExternalUniformBuffer(Target, Uniform Buffer)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBuilder*"
        },
        {
          "name": "Uniform Buffer",
          "type": "FRDGUniformBufferRef"
        }
      ],
      "returnType": "FRHIUniformBuffer*",
      "docs": "For a graph-created uniform buffer, this forces immediate allocation of the underlying resource, effectively promoting it\nto an external resource. This will increase memory pressure, but allows access to the RHI resource.\nGraph resources that are referenced in the buffer will be converted to external.\nThis is primarily used as an aid for porting code incrementally to RDG."
    },
    {
      "id": "use-external-access-mode-0447cf",
      "name": "UseExternalAccessMode",
      "category": "RenderGraphBuilder",
      "signature": "UseExternalAccessMode(Target, Resource, Read Only Access, Pipelines)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBuilder*"
        },
        {
          "name": "Resource",
          "type": "FRDGViewableResource*"
        },
        {
          "name": "Read Only Access",
          "type": "ERHIAccess"
        },
        {
          "name": "Pipelines",
          "type": "ERHIPipeline",
          "default": "ERHIPipeline::Graphics"
        }
      ],
      "returnType": "Void",
      "docs": "Configures the resource for external access for all subsequent passes, or until UseInternalAccessMode is called.\nOnly read-only access states are allowed. When in external access mode, it is safe to access the underlying RHI\nresource directly in later RDG passes. This method is only allowed for registered or externally converted resources.\nThe method effectively guarantees that RDG will transition the resource into the desired state for all subsequent\npasses so long as the resource remains externally accessible."
    },
    {
      "id": "use-external-access-mode-22c26a",
      "name": "UseExternalAccessMode",
      "category": "RenderGraphBuilder",
      "signature": "UseExternalAccessMode(Target, Resources, Read Only Access, Pipelines)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBuilder*"
        },
        {
          "name": "Resources",
          "type": "TArrayView<FRDGViewableResource*>"
        },
        {
          "name": "Read Only Access",
          "type": "ERHIAccess"
        },
        {
          "name": "Pipelines",
          "type": "ERHIPipeline",
          "default": "ERHIPipeline::Graphics"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "use-internal-access-mode-5f62f9",
      "name": "UseInternalAccessMode",
      "category": "RenderGraphBuilder",
      "signature": "UseInternalAccessMode(Target, Resource)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBuilder*"
        },
        {
          "name": "Resource",
          "type": "FRDGViewableResource*"
        }
      ],
      "returnType": "Void",
      "docs": "Use this method to resume tracking of a resource after calling UseExternalAccessMode. It is safe to call this method\neven if external access mode was not enabled (it will simply no-op). It is not valid to access the underlying RHI\nresource in any pass added after calling this method."
    },
