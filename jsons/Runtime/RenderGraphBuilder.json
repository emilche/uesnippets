    {
      "id": "convert-to-external-texture",
      "name": "ConvertToExternalTexture",
      "category": "RenderGraphBuilder",
      "signature": "ConvertToExternalTexture(Target, Texture)",
      "params": [
        {
          "name": "Target",
          "type": "FRDGBuilder*"
        },
        {
          "name": "Texture",
          "type": "FRDGTextureRef"
        }
      ],
      "returnType": "TRefCountPtr<IPooledRenderTarget>&",
      "docs": "For graph-created resources, this forces immediate allocation of the underlying pooled resource, effectively promoting it\nto an external resource. This will increase memory pressure, but allows for querying the pooled resource with GetPooled{Texture, Buffer}.\nThis is primarily used as an aid for porting code incrementally to RDG."
    },
