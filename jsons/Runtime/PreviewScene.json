{
  "id": "preview-scene",
  "label": "PreviewScene",
  "includepath": "PreviewScene.h",
  "includes": [
    "CoreMinimal",
    "GCObject",
    "World"
  ],
  "functions": [
    {
      "id": "add-component",
      "name": "AddComponent",
      "category": "PreviewScene",
      "signature": "AddComponent(Target, Component, Local To World, Attach To Root)",
      "params": [
        {
          "name": "Target",
          "type": "FPreviewScene*"
        },
        {
          "name": "Component",
          "type": "UActorComponent*"
        },
        {
          "name": "Local To World",
          "type": "FTransform&"
        },
        {
          "name": "Attach To Root",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a component to the preview scene.  This attaches the component to the scene, and takes ownership of it."
    },
    {
      "id": "remove-component",
      "name": "RemoveComponent",
      "category": "PreviewScene",
      "signature": "RemoveComponent(Target, Component)",
      "params": [
        {
          "name": "Target",
          "type": "FPreviewScene*"
        },
        {
          "name": "Component",
          "type": "UActorComponent*"
        }
      ],
      "returnType": "Void",
      "docs": "Removes a component from the preview scene.  This detaches the component from the scene, and returns ownership of it."
    },
