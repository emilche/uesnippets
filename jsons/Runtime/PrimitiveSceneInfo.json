        {
          "name": "Out Min LOD",
          "type": "Int8&"
        },
        {
          "name": "Out Max LOD",
          "type": "Int8&"
        }
      ],
      "returnType": "Void",
      "docs": "Will output the LOD ranges of the static meshes used with this primitive."
