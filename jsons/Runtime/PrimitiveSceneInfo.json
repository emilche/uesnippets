      "name": "RequestGPUSceneUpdate",
      "category": "PrimitiveSceneInfo",
      "signature": "RequestGPUSceneUpdate(Target, Primitive Dirty State)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimitiveSceneInfo*"
        },
        {
          "name": "Primitive Dirty State",
          "type": "EPrimitiveDirtyState",
          "default": "EPrimitiveDirtyState::ChangedAll"
        }
      ],
      "returnType": "Bool",
      "docs": "Adds a request to update GPU scene representation."
    },
    {
      "id": "refresh-nanite-raster-bins",
      "name": "RefreshNaniteRasterBins",
      "category": "PrimitiveSceneInfo",
      "signature": "RefreshNaniteRasterBins(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPrimitiveSceneInfo*"
        }
      ],
      "returnType": "Void",
      "docs": "Refreshes a primitive's references to raster bins. To be called after changes that might have invalidated them."
    },
    {
      "id": "get-static-meshes-lod-range",
      "name": "GetStaticMeshesLODRange",
      "category": "PrimitiveSceneInfo",
      "signature": "GetStaticMeshesLODRange(Target, Out Min LOD, Out Max LOD)",
      "params": [
        {
          "name": "Target",
