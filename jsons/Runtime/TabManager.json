      "id": "register-tab-spawner",
      "name": "RegisterTabSpawner",
      "category": "TabManager",
      "signature": "RegisterTabSpawner(Target, Tab Id, On Spawn Tab, Can Spawn Tab)",
      "params": [
        {
          "name": "Target",
          "type": "FTabManager*"
        },
        {
          "name": "Tab Id",
          "type": "Name"
        },
        {
          "name": "On Spawn Tab",
          "type": "FOnSpawnTab&"
        },
        {
          "name": "Can Spawn Tab",
          "type": "FCanSpawnTab&",
          "default": "FCanSpawnTab()"
        }
      ],
      "returnType": "FTabSpawnerEntry&",
      "docs": "Register a new tab spawner with the tab manager.  The spawner will be called when anyone calls\nInvokeTab().\n@param TabId The TabId to register the spawner for.\n@param OnSpawnTab The callback that will be used to spawn the tab.\n@param CanSpawnTab The callback that will be used to ask if spawning the tab is allowed\n@return The registration entry for the spawner."
    },
