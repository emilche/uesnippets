    {
      "id": "discard-transient-state",
      "name": "DiscardTransientState",
      "category": "MovieScenePreAnimatedStateExtension",
      "signature": "DiscardTransientState(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPreAnimatedStateExtension*"
        }
      ],
      "returnType": "Void",
      "docs": "Discard any transient state and all meta-data for any currently animating objects, whilst preserving the cached values internally.\nCalling this function will cause any currently animating 'RestoreState' sections to re-cache their values if they are re-evaluated\nAny 'RestoreState' sections which are deleted or subsequently not-evaluated will not cause their values to be restored"
    },
    {
      "id": "discard-state-for-group",
      "name": "DiscardStateForGroup",
