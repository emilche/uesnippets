      ],
      "returnType": "public : void",
      "docs": "Restore any state for any persistent tokens captured during the course of evaluation\n@param Params    Parameters for restoration - if TerminalInstanceHandle is invalid then _all_ state will be restored, regardless of the instance it was cached from"
    },
