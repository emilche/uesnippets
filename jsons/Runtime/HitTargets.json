          "name": "Target",
          "type": "UGizmoLambdaHitTarget*"
        },
        {
          "name": "Hovering",
          "type": "Bool"
        }
      ],
      "returnType": "Void",
      "supportedTargets": [
        "UGizmoLambdaHitTarget*",
