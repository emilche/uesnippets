    {
      "id": "adjust-size-db4e28",
      "name": "AdjustSize",
      "category": "NetSerializerArrayStorage",
      "signature": "AdjustSize(Target, Context, In Num, In Alignment)",
      "params": [
        {
          "name": "Target",
          "type": "FNetSerializerAlignedStorage*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "In Num",
          "type": "SizeType"
        },
        {
          "name": "In Alignment",
          "type": "SizeType"
        }
      ],
      "returnType": "Void",
      "docs": "Helper class to manage storage of untyped dynamic storage with arbitrary alignment in quantized data.\nIf storage is used to store elements that themselves uses dynamic allocations the user must take care to properly free and clone such elements properly prior to and/or after changing sizes.\nFNetSerializerAlignedStorage is only intended to be used from within Quantized replication states that requires dynamic storage as it has very specific expectations and limitations.\nNOTE: A NetSerializer using FNetSerializerAlignedStorage MUST specify the trait bHasDynamicState and forward appropriate calls to Clone and Free to this class.\nA zero constructed state is considered valid."
    },
    {
      "id": "free",
      "name": "Free",
      "category": "NetSerializerArrayStorage",
      "signature": "Free(Target, Context)",
      "params": [
        {
          "name": "Target",
          "type": "FNetSerializerAlignedStorage*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        }
      ],
      "returnType": "template<QuantizedElementType,AllocationPolicy> void FNetSerializerArrayStorage<QuantizedElementType,AllocationPolicy",
      "docs": "Free - Free allocated memory and reset state. it is valid to pass in a zero-initialized state\nThe state storage in which the storage is located is expected to be in a valid state which can either be zero initialized or a previous valid state.\nShould typically only be called from within a the implemntation of NetSerializer::FreeDynamicState()",
      "supportedTargets": [
        "FNetSerializerAlignedStorage*",
        "FNetSerializerArrayStorage*"
      ]
    },
    {
      "id": "clone",
      "name": "Clone",
      "category": "NetSerializerArrayStorage",
      "signature": "Clone(Target, Context, Source)",
      "params": [
        {
          "name": "Target",
          "type": "FNetSerializerAlignedStorage*"
        },
        {
          "name": "Context",
          "type": "FNetSerializationContext&"
        },
        {
          "name": "Source",
          "type": "FNetSerializerAlignedStorage&"
        }
      ],
      "returnType": "Void",
      "docs": "Clone - Clone dynamic storage from Source\nNo assumptions of the validity of the target is made, as this is typically called AFTER a memcopy is made to the target state\nwhich invalidates all dynamic data\nShould typically only be called from within a the implemntation of NetSerializer::CloneDynamicState()"
    },
