    },
    {
      "id": "notify-received-rpc",
      "name": "NotifyReceivedRPC",
      "category": "RPCDoSDetection",
      "signature": "NotifyReceivedRPC(Target, Reader, Unmapped Guids, Object, Function, Function Name)",
      "params": [
        {
          "name": "Target",
          "type": "FRPCDoSDetection*"
        },
        {
          "name": "Reader",
          "type": "FNetBitReader&"
        },
        {
          "name": "Unmapped Guids",
          "type": "TSet<FNetworkGUID>&"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Function",
          "type": "UFunction*"
        },
        {
          "name": "Function Name",
          "type": "Name"
        }
      ],
      "returnType": "ERPCNotifyResult",
      "docs": "If RPC monitoring is enabled, provides a notification for every RPC that is received, with the ability to block it.\n@param Reader\t\t\tThe net bit reader containing the packet data, in case parsing of RPC parameters is desired\n@param UnmappedGuids\t\tReference to the set of unmapped Guid's - in case it's necessary for parsing RPC parameters\n@param Object\t\t\tThe UObject the RPC will be called on\n@param Function\t\t\tThe UFunction representing the RPC\n@param FunctionName\t\tThe cached name of the function\n@return\t\t\t\t\tWhether or not to block the RPC"
    },
    {
      "id": "lightweight-received-rpc",
      "name": "LightweightReceivedRPC",
      "category": "RPCDoSDetection",
      "signature": "LightweightReceivedRPC(Target, Function, Function Name)",
      "params": [
        {
          "name": "Target",
          "type": "FRPCDoSDetection*"
        },
        {
          "name": "Function",
          "type": "UFunction*"
        },
        {
          "name": "Function Name",
          "type": "Name"
        }
      ],
      "returnType": "Void",
      "docs": "If RPC monitoring is disabled, does extremely lightweight tracking of RPC calls, for monitoring tracking triggers,\nand to allow a chance for deducing full RPC tracking information if monitoring is enabled while receiving\n(so that e.g. if an RPC DoS attack enables monitoring, information on the RPC responsible can be recovered).\n@param Function\t\t\tThe UFunction representing the RPC\n@param FunctionName\t\tThe cached name of the function"
    },
