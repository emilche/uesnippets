{
  "id": "input-device-properties",
  "label": "InputDeviceProperties",
  "includepath": "GameFramework/InputDeviceProperties.h",
  "includes": [
    "CoreMinimal",
    "Object",
    "IInputInterface",
    "InputDeviceSubsystem",
    "InputDeviceProperties.generated"
  ],
  "functions": [
    {
      "id": "recalculate-duration",
      "name": "RecalculateDuration",
      "category": "InputDeviceProperties",
      "signature": "RecalculateDuration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceProperty*"
        }
      ],
      "returnType": "Float",
      "docs": "Recalculates this device property's duration. This should be called whenever there are changes made\nto things like curves, or other time sensitive properties."
    },
    {
      "id": "get-device-specific-data",
      "name": "GetDeviceSpecificData",
      "category": "InputDeviceProperties",
      "signature": "GetDeviceSpecificData(Target, User Id, Device Id, In Device Data)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceProperty*"
        },
        {
          "name": "User Id",
          "type": "FPlatformUserId"
        },
        {
          "name": "Device Id",
          "type": "FInputDeviceId"
        },
        {
          "name": "In Device Data",
          "type": "TMap<FName,TDataLayout>&"
        }
      ],
      "returnType": "template<class TDataLayout> TDataLayout*"
    },
    {
      "id": "reset-device-property-implementation",
      "name": "ResetDeviceProperty_Implementation",
      "category": "InputDeviceProperties",
      "signature": "ResetDeviceProperty_Implementation(Target, Platform User, Device Id, Force Reset)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceTriggerEffect*"
        },
        {
          "name": "Platform User",
          "type": "FPlatformUserId"
        },
        {
          "name": "Device Id",
          "type": "FInputDeviceId"
        },
        {
          "name": "Force Reset",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Native C++ implementation of ResetDeviceProperty\nOverride this in C++ to alter the device property behavior in native code.\n@see ResetDeviceProperty"
    },
    {
      "id": "apply-device-property",
      "name": "ApplyDeviceProperty",
      "category": "InputDevice",
      "signature": "ApplyDeviceProperty(Target, User Id, Device Id)",
      "params": [
        {
          "name": "Target",
          "type": "UInputDeviceTriggerEffect*"
        },
        {
          "name": "User Id",
          "type": "FPlatformUserId"
        },
        {
          "name": "Device Id",
          "type": "FInputDeviceId"
        }
      ],
      "returnType": "Void",
      "docs": "Apply the device property from GetInternalDeviceProperty to the given platform user.\nNote: To remove any applied affects of this device property, call ResetDeviceProperty.\n@param UserId\t\tThe owning Platform User whose input device this property should be applied to.",
      "supportedTargets": [
        "UInputDeviceTriggerEffect*",
        "UInputDeviceAudioBasedVibrationProperty*"
      ]
    }
  ]
}