    {
      "id": "on-low-level-alloc",
      "name": "OnLowLevelAlloc",
      "category": "LowLevelMemTracker",
      "signature": "OnLowLevelAlloc(Target, Tracker, Ptr, Size, Default Tag, Alloc Type, Track In Mem Pro)",
      "params": [
        {
          "name": "Target",
          "type": "FLowLevelMemTracker*"
        },
        {
          "name": "Tracker",
          "type": "ELLMTracker"
        },
        {
          "name": "Ptr",
          "type": "void*"
        },
        {
          "name": "Size",
          "type": "UInt64"
        },
        {
          "name": "Default Tag",
          "type": "ELLMTag",
          "default": "ELLMTag::Untagged"
        },
        {
          "name": "Alloc Type",
          "type": "ELLMAllocType",
          "default": "ELLMAllocType::None"
        },
        {
          "name": "Track In Mem Pro",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Records the use of memory that was allocated for a pointer.\n@param Tracker Which tracker to use, the high-level default tracker for regular engine allocations, or the\nlow-level platform tracker for memory management systems.\n@param Ptr The pointer that was allocated.\n@param Size The size of the memory that was allocated for the pointer.\n@param DefaultTag The tag to use if there is no tag already in scope on the callstack.\n@param AllocType Type of allocation, FMalloc for regular allocations done through GMalloc, System for others.\n@param bTrackInMemPro Whether to pass the allocation/free information on to FMemProProfiler."
    },
    {
      "id": "on-low-level-free",
      "name": "OnLowLevelFree",
      "category": "LowLevelMemTracker",
      "signature": "OnLowLevelFree(Target, Tracker, Ptr, Alloc Type, Track In Mem Pro)",
      "params": [
        {
          "name": "Target",
          "type": "FLowLevelMemTracker*"
        },
        {
          "name": "Tracker",
          "type": "ELLMTracker"
        },
        {
          "name": "Ptr",
          "type": "void*"
        },
        {
          "name": "Alloc Type",
          "type": "ELLMAllocType",
          "default": "ELLMAllocType::None"
        },
        {
          "name": "Track In Mem Pro",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Records the release of memory that was allocated for a pointer.\n@param Tracker Which tracker to use, the high-level default tracker for regular engine allocations, or the\nlow-level platform tracker for memory management systems.\n@param Ptr The pointer that was freed.\n@param AllocType Type of allocation, FMalloc for regular allocations done through GMalloc, System for others.\n@param bTrackInMemPro Whether to pass the allocation/free information on to FMemProProfiler."
    },
    {
