{
  "id": "key-chain-utilities",
  "label": "KeyChainUtilities",
  "includepath": "Misc/KeyChainUtilities.h",
  "includes": [
    "Base64",
    "CoreDelegates",
    "CoreMinimal",
    "FileManager",
    "IEngineCrypto",
    "NamedAESKey",
    "RSA",
    "Archive",
    "JsonSerializer"
  ],
  "functions": [
    {
      "id": "get-signing-key",
      "name": "GetSigningKey",
      "category": "KeyChainUtilities",
      "signature": "GetSigningKey(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        }
      ],
      "returnType": "PRAGMA_DISABLE_DEPRECATION_WARNINGS FRSAKeyHandle"
    },
    {
      "id": "set-signing-key",
      "name": "SetSigningKey",
      "category": "KeyChainUtilities",
      "signature": "SetSigningKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        },
        {
          "name": "Key",
          "type": "FRSAKeyHandle"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-principal-encryption-key",
      "name": "GetPrincipalEncryptionKey",
      "category": "KeyChainUtilities",
      "signature": "GetPrincipalEncryptionKey(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        }
      ],
      "returnType": "FNamedAESKey*"
    },
    {
      "id": "set-principal-encryption-key",
      "name": "SetPrincipalEncryptionKey",
      "category": "KeyChainUtilities",
      "signature": "SetPrincipalEncryptionKey(Target, Key)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        },
        {
          "name": "Key",
          "type": "FNamedAESKey*"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-encryption-keys",
      "name": "GetEncryptionKeys",
      "category": "KeyChainUtilities",
      "signature": "GetEncryptionKeys(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        }
      ],
      "returnType": "TMap<FGuid,FNamedAESKey>&"
    },
    {
      "id": "set-encryption-keys",
      "name": "SetEncryptionKeys",
      "category": "KeyChainUtilities",
      "signature": "SetEncryptionKeys(Target, Keys)",
      "params": [
        {
          "name": "Target",
          "type": "FKeyChain*"
        },
        {
          "name": "Keys",
          "type": "TMap<FGuid,FNamedAESKey>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "parse-rsa-key-from-json",
      "name": "ParseRSAKeyFromJson",
      "category": "KeyChainUtilities",
      "signature": "ParseRSAKeyFromJson(In Obj)",
      "params": [
        {
          "name": "In Obj",
          "type": "TSharedPtr<FJsonObject>"
        }
      ],
      "returnType": "FRSAKeyHandle"
    },
    {
      "id": "load-key-chain-from-file",
      "name": "LoadKeyChainFromFile",
      "category": "KeyChainUtilities",
      "signature": "LoadKeyChainFromFile(In Filename, Out Crypto Settings)",
      "params": [
        {
          "name": "In Filename",
          "type": "String&"
        },
        {
          "name": "Out Crypto Settings",
          "type": "FKeyChain&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "apply-encryption-keys",
      "name": "ApplyEncryptionKeys",
      "category": "KeyChainUtilities",
      "signature": "ApplyEncryptionKeys(Key Chain)",
      "params": [
        {
          "name": "Key Chain",
          "type": "FKeyChain&"
        }
      ],
      "returnType": "Void"
    }
  ]
}