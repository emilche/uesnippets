      "id": "request-space-for-characters",
      "name": "RequestSpaceForCharacters",
      "category": "ShaderPrintParameters",
      "signature": "RequestSpaceForCharacters(Max Element Count)",
      "params": [
        {
          "name": "Max Element Count",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Call to ensure enough space for some number of characters, is added cumulatively each frame, to make\nit possible for several systems to request a certain number independently.\nIs used to grow the max element count for subsequent frames (as the allocation happens early in the frame).\n@param The number of characters requested."
    },
    {
      "id": "request-space-for-lines",
      "name": "RequestSpaceForLines",
      "category": "ShaderPrintParameters",
      "signature": "RequestSpaceForLines(Max Element Count)",
      "params": [
        {
          "name": "Max Element Count",
          "type": "UInt"
        }
      ],
      "returnType": "Void",
      "docs": "Call to ensure enough space for some number of lines segments, is added cumulatively each frame, to make\nit possible for several systems to request a certain number independently.\nIs used to grow the max element count for subsequent frames (as the allocation happens early in the frame).\n@param The number of line segments requested."
    },
    {
      "id": "request-space-for-triangles",
      "name": "RequestSpaceForTriangles",
      "category": "ShaderPrintParameters",
