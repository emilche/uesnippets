    {
      "id": "register-http-callback-1f47cf",
      "name": "RegisterHttpCallback",
      "category": "ExternalRpcRegistrationComponent",
      "signature": "RegisterHttpCallback(Target, In Route Info, Handler, Override If Bound)",
      "params": [
        {
          "name": "Target",
          "type": "UExternalRpcRegistrationComponent*"
        },
        {
          "name": "In Route Info",
          "type": "FExternalRouteInfo"
        },
        {
          "name": "Handler",
          "type": "FHttpRequestHandler&"
        },
        {
          "name": "Override If Bound",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Hooks up a given delegate to the assigned route for external access. Use if you already have an FExternalRouteInfo object.\n@param  InRouteInfo A fully initialized FExternalRouteInfo object that describes the overall endpoint.\n@param  Handler  The function delegate to call when this route is accessed.\n@param  bOverrideIfBound  Whether or not this registry should override any previously registered route."
    },
    {
      "id": "register-http-callback-5369e8",
      "name": "RegisterHttpCallback",
      "category": "ExternalRpcRegistrationComponent",
      "signature": "RegisterHttpCallback(Target, Route Name, Http Path, Request Verbs, Handler, Override If Bound, Optional Category, Optional Content Type, Optional In Arguments)",
      "params": [
        {
          "name": "Target",
          "type": "UExternalRpcRegistrationComponent*"
        },
        {
          "name": "Route Name",
          "type": "Name"
        },
        {
          "name": "Http Path",
          "type": "FHttpPath&"
        },
        {
          "name": "Request Verbs",
          "type": "EHttpServerRequestVerbs&"
        },
        {
          "name": "Handler",
          "type": "FHttpRequestHandler&"
        },
        {
          "name": "Override If Bound",
          "type": "Bool",
          "default": "false"
        },
        {
          "name": "Optional Category",
          "type": "String",
          "default": "TEXT(\"\")"
        },
        {
          "name": "Optional Content Type",
          "type": "String",
          "default": "{}"
        },
        {
          "name": "Optional In Arguments",
          "type": "TArray<FExternalRpcArgumentDesc>",
          "default": "TArray<FExternalRpcArgumentDesc>()"
        }
      ],
      "returnType": "Void",
      "docs": "Hooks up a given delegate to the assigned route for external access. Handles creation of FExternalRouteInfo from its core parts.\n@param  RouteName   The friendly name of the route - used frequently in gauntlet for easier use.\n@param  HttpPath  Desired route for this delegate. Will be appended onto http://<host>:<listenport>\n@param  RequestVerbs  Verbs that should be accepted on this route.\n@param  Handler  The function delegate to call when this route is accessed.\n@param  bOverrideIfBound  Whether or not this registry should override any previously registered delegate at this route.\n@param  OptionalCategory  An optional category that can be added for organizational purposes\n@param  OptionalContentType  The sort of content type that is expected for the request body\n@param  OptionalInArguments  A list of arguments expected by this route. Can be set to optional or mandatory."
    },
    {
      "id": "http-send-message-to-listener",
      "name": "HttpSendMessageToListener",
      "category": "ExternalRpcRegistrationComponent",
      "signature": "HttpSendMessageToListener(Target, Message Category, Message Payload)",
      "params": [
        {
          "name": "Target",
          "type": "UExternalRpcRegistrationComponent*"
        },
        {
          "name": "Message Category",
          "type": "String"
        },
        {
          "name": "Message Payload",
          "type": "String"
        }
      ],
      "returnType": "Bool",
      "docs": "Send a message to all listeners with a custom category and payload for consumption by external processes.\n@param  MessageCategory   The category of the message to be sent.\n@param  MessagePayload  The payload of the message to be sent.\n@return Always needs to return true because of how the HttpRequest works."
    },
    {
      "id": "http-update-ip-on-listener",
      "name": "HttpUpdateIpOnListener",
      "category": "ExternalRpcRegistrationComponent",
      "signature": "HttpUpdateIpOnListener(Target, Target Name, Message Payload)",
      "params": [
        {
          "name": "Target",
          "type": "UExternalRpcRegistrationComponent*"
        },
        {
          "name": "Target Name",
          "type": "String"
        },
        {
          "name": "Message Payload",
          "type": "String"
        }
      ],
      "returnType": "Bool",
      "docs": "Send a message to all listeners describing the game IP of the current process.\nMostly used when dealing with devices that have more than one IP to signify what its hostname should be.\n@param  TargetName   The name of the target process updating its ip.\n@param  MessagePayload  The IP of the process.\n@return Always needs to return true because of how the HttpRequest works."
    },
