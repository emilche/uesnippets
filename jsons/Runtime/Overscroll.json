{
  "id": "overscroll",
  "label": "Overscroll",
  "includepath": "Framework/Layout/Overscroll.h",
  "includes": [
    "CoreMinimal",
    "Platform",
    "Geometry"
  ],
  "functions": [
    {
      "id": "scroll-by",
      "name": "ScrollBy",
      "category": "Overscroll",
      "signature": "ScrollBy(Target, Allotted Geometry, Local Delta Scroll)",
      "params": [
        {
          "name": "Target",
          "type": "FOverscroll*"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        },
        {
          "name": "Local Delta Scroll",
          "type": "Float"
        }
      ],
      "returnType": "Float",
      "docs": "@return The Amount actually scrolled"
    },
    {
      "id": "get-overscroll",
      "name": "GetOverscroll",
      "category": "Overscroll",
      "signature": "GetOverscroll(Target, Allotted Geometry)",
      "params": [
        {
          "name": "Target",
          "type": "FOverscroll*"
        },
        {
          "name": "Allotted Geometry",
          "type": "FGeometry&"
        }
      ],
      "returnType": "Float",
      "docs": "How far the user scrolled above/below the beginning/end of the list."
    },
    {
      "id": "update-overscroll",
      "name": "UpdateOverscroll",
      "category": "Overscroll",
      "signature": "UpdateOverscroll(Target, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FOverscroll*"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Ticks the overscroll manager so it can animate."
    },
    {
      "id": "should-apply-overscroll",
      "name": "ShouldApplyOverscroll",
      "category": "Overscroll",
      "signature": "ShouldApplyOverscroll(Target, Is At Start Of List, Is At End Of List, Scroll Delta)",
      "params": [
        {
          "name": "Target",
          "type": "FOverscroll*"
        },
        {
          "name": "Is At Start Of List",
          "type": "Bool"
        },
        {
          "name": "Is At End Of List",
          "type": "Bool"
        },
        {
          "name": "Scroll Delta",
          "type": "Float"
        }
      ],
      "returnType": "Bool",
      "docs": "Should ScrollDelta be applied to overscroll or to regular item scrolling.\n@param bIsAtStartOfList  Are we at the very beginning of the list (i.e. showing the first item at the top of the view)?\n@param bIsAtEndOfList    Are we showing the last item on the screen completely?\n@param ScrollDelta       How much the user is trying to scroll in Slate Units.\n@return true if the user's scrolling should be applied toward overscroll."
    },
    {
      "id": "reset-overscroll",
      "name": "ResetOverscroll",
      "category": "Overscroll",
      "signature": "ResetOverscroll(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FOverscroll*"
        }
      ],
      "returnType": "Void",
      "docs": "Resets the overscroll amout."
    }
  ]
}