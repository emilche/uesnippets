  ],
  "functions": [
    {
      "id": "append",
      "name": "Append",
      "category": "ARFilter",
      "signature": "Append(Target, Other)",
      "params": [
        {
          "name": "Target",
          "type": "FARFilter*"
        },
        {
          "name": "Other",
          "type": "FARFilter&"
        }
      ],
      "returnType": "Void",
      "docs": "Only if bRecursiveClasses is true, the results will exclude classes (and subclasses) in this list"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "ARFilter",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FARFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this filter has no entries"
    },
    {
      "id": "is-recursive",
      "name": "IsRecursive",
      "category": "ARFilter",
      "signature": "IsRecursive(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FARFilter*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if this filter is recursive"
    },
    {
      "id": "clear",
      "name": "Clear",
      "category": "ARFilter",
      "signature": "Clear(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FARFilter*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears this filter of all entries"
    },
    {
      "id": "sort-for-saving",
      "name": "SortForSaving",
      "category": "ARFilter",
      "signature": "SortForSaving(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FARFilter*"
        }
      ],
      "returnType": "Void",
      "docs": "Sort the structures (e.g. PackageNames) on this filter to be deterministic for saving the structure during\ncooking. This is also required for correctness of operator== when comparing the order-independent arrays."
    }
  ]
