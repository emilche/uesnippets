    {
      "id": "create-automatic-conversion-node-and-connections",
      "name": "CreateAutomaticConversionNodeAndConnections",
      "category": "EdGraphSchema",
      "signature": "CreateAutomaticConversionNodeAndConnections(Target, A, B)",
      "params": [
        {
          "name": "Target",
          "type": "UEdGraphSchema*"
        },
        {
          "name": "A",
          "type": "UEdGraphPin*"
        },
        {
          "name": "B",
          "type": "UEdGraphPin*"
        }
      ],
      "returnType": "Bool",
      "docs": "Try to create an automatic cast or other conversion node node to facilitate a connection between two pins.\nIt makes the cast node, a connection between A and the cast node, and a connection from the cast node to B.two\nThis method is called when a connection is made where CanCreateConnection returned bCanAutoConvert.\n@param\tA\tThe first pin.\n@param\tB\tThe second pin.\n@return\tTrue if a cast node and connection were made; false if the connection failed and had no side effects."
    },
    {
      "id": "create-promoted-connection",
      "name": "CreatePromotedConnection",
      "category": "EdGraphSchema",
