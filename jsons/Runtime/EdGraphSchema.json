        },
        {
          "name": "B",
          "type": "UEdGraphPin*"
        }
      ],
      "returnType": "Bool",
      "docs": "Try to create a promotion from one type to another in order to make a connection between two pins.\n@param\tA\tThe first pin.\n@param\tB\tThe second pin.\n@return\tTrue if the promotion and connection were successful; False if the connection failed."
    },
    {
