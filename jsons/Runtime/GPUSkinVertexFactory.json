    {
      "id": "use-unlimited-bone-influences",
      "name": "UseUnlimitedBoneInfluences",
      "category": "GPUSkinVertexFactory",
      "signature": "UseUnlimitedBoneInfluences(Max Bone Influences, Target Platform)",
      "params": [
        {
          "name": "Max Bone Influences",
          "type": "UInt"
        },
        {
          "name": "Target Platform",
          "type": "ITargetPlatform*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-unlimited-bone-influences",
      "name": "GetUnlimitedBoneInfluences",
      "category": "GPUSkinVertexFactory",
      "signature": "GetUnlimitedBoneInfluences(Target Platform)",
      "params": [
        {
          "name": "Target Platform",
          "type": "ITargetPlatform*",
          "default": "nullptr"
        }
      ],
      "returnType": "Bool"
    },
    {
      "id": "get-bone-influence-limit-for-asset",
      "name": "GetBoneInfluenceLimitForAsset",
      "category": "GPUSkinVertexFactory",
      "signature": "GetBoneInfluenceLimitForAsset(Asset Provided Limit, Target Platform)",
      "params": [
        {
          "name": "Asset Provided Limit",
          "type": "Int"
        },
        {
          "name": "Target Platform",
          "type": "ITargetPlatform*",
          "default": "nullptr"
        }
      ],
      "returnType": "Int",
      "docs": "Returns the maximum number of bone influences that should be used for a skeletal mesh, given\nthe user-requested limit.\nIf the requested limit is 0, the limit will be determined from the project settings.\nThe return value is guaranteed to be greater than zero, but note that it may be higher than\nthe maximum supported bone influences."
    },
    {
      "id": "get-always-use-deformer-for-unlimited-bone-influences",
      "name": "GetAlwaysUseDeformerForUnlimitedBoneInfluences",
      "category": "GPUSkinVertexFactory",
      "signature": "GetAlwaysUseDeformerForUnlimitedBoneInfluences(Platform)",
      "params": [
        {
          "name": "Platform",
          "type": "EShaderPlatform"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if mesh LODs with Unlimited Bone Influences must always be rendered using a\nMesh Deformer for the given shader platform."
    }
