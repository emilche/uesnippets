    {
      "id": "parallel-insert-dense-point-set",
      "name": "ParallelInsertDensePointSet",
      "category": "SparseDynamicPointOctree3",
      "signature": "ParallelInsertDensePointSet(Target, Max Point ID, Get Position Func)",
      "params": [
        {
          "name": "Target",
          "type": "FSparseDynamicPointOctree3*"
        },
        {
          "name": "Max Point ID",
          "type": "Int"
        },
        {
          "name": "Get Position Func",
          "type": "TFunctionRef<FVector3d ( int )>"
        }
      ],
      "returnType": "Void",
      "docs": "Insert a set of dense points with IDs in range [0, MaxPointID-1], in parallel.\nThe points are only inserted in leaf nodes, at MaxTreeDepth level, so that value should\nbe set conservatively. Parallel insertion is across root cells, so if the RootDimension\nis larger than the point set bounds, this will be slower than incremental construction.\nConfigureFromPointCountEstimate() provides reasonable values for large point sets.\n@param GetPositionFunc function that returns position of point (Required to reinsert points on expand)"
    },
