      "name": "FProgressScope",
      "category": "ProgressCancel",
      "signature": "FProgressScope(Progress Cancel, Progress Amount, Message)",
      "params": [
        {
          "name": "Progress Cancel",
          "type": "FProgressCancel*"
        },
        {
          "name": "Progress Amount",
          "type": "Float"
        },
        {
          "name": "Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "public :",
      "docs": "@param ProgressCancel\t\tProgress will be tracked on this. If null, the FProgressScope will do nothing.\n@param ProgressAmount\t\tAmount to increase progress w/in this scope (as a fraction of the current outer-scope active progress range)"
    },
    {
      "id": "done",
      "name": "Done",
      "category": "ProgressCancel",
      "signature": "Done(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FProgressScope*"
        }
      ],
      "returnType": "Void",
      "docs": "Advance to the end of the scope's progress range and close the scope"
    },
    {
      "id": "create-scope-to",
      "name": "CreateScopeTo",
      "category": "ProgressCancel",
      "signature": "CreateScopeTo(Progress Cancel, Progress To, Message)",
      "params": [
        {
          "name": "Progress Cancel",
          "type": "FProgressCancel*"
        },
        {
          "name": "Progress To",
          "type": "Float"
        },
        {
          "name": "Message",
          "type": "Text&",
          "default": "FText()"
        }
      ],
      "returnType": "FProgressScope",
      "docs": "@param ProgressCancel\t\tProgress will be tracked on this. If null, the FProgressScope will do nothing.\n@param ProgressTo\t\t\tTarget value to increase progress to w/in this scope (as a fraction of the current outer-scope active progress range)\n@param Message\t\t\t\tOptional message describing the work to be done\n@return\t\t\t\t\t\tA new FProgressScope that covers work from the current progress to the target progress value (relative to the current scope)"
    }
