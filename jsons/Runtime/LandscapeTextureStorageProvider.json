        "ULandscapeTextureMipEdgeOverrideFactory*",
        "ULandscapeTextureStorageProviderFactory*"
      ]
    },
    {
      "id": "will-provide-mip-data-without-disk",
      "name": "WillProvideMipDataWithoutDisk",
      "category": "LandscapeTextureStorageProvider",
      "signature": "WillProvideMipDataWithoutDisk(Target)",
      "params": [
        {
          "name": "Target",
          "type": "ULandscapeTextureMipEdgeOverrideFactory*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if TextureMipDataProviders allocated by this factory can provide MipData by themselves,\neven without loading from disk at all, so streaming can be enabled for their textures.",
