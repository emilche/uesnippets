    {
      "id": "find-property-by-path-checked",
      "name": "FindPropertyByPathChecked",
      "category": "InterchangeBaseNode",
      "signature": "FindPropertyByPathChecked(Target, Container, Outer, Property Path)",
      "params": [
        {
          "name": "Target",
          "type": "UInterchangeBaseNode*"
        },
        {
          "name": "Container",
          "type": "TVariant<UObject*,uint8*>&"
        },
        {
          "name": "Outer",
          "type": "UStruct*"
        },
        {
          "name": "Property Path",
          "type": "FStringView"
        }
      ],
      "returnType": "FProperty*",
      "docs": "Finds a property by name in Outer and supports looking into FStructProperties (embedded structs) with a '.' separating the property names.\n@param Container - The container for the property values. If the final property is inside a UScriptStruct, the container will be set to the UScriptStruct instance address.\n@param Outer - The UStruct containing the top level property.\n@param PropertyPath - A dot separated chain of properties. Doesn't support going through external objects.\n@return The Property matching the last name in the PropertyPath."
    },
