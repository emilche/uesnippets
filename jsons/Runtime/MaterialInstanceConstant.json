      "id": "set-parent-editor-only",
      "name": "SetParentEditorOnly",
      "category": "MaterialInstanceConstant",
      "signature": "SetParentEditorOnly(Target, New Parent, Recache Shader)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialInstanceConstant*"
        },
        {
          "name": "New Parent",
          "type": "UMaterialInterface*"
        },
        {
          "name": "Recache Shader",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Set the parent of this material instance. This function may only be called in the Editor!\nWARNING: You MUST call PostEditChange afterwards to propagate changes to other materials in the chain!\n@param NewParent - The new parent for this material instance.\n@param RecacheShader - Will recache required shaders."
    },
    {
      "id": "copy-material-uniform-parameters-editor-only",
      "name": "CopyMaterialUniformParametersEditorOnly",
      "category": "MaterialInstanceConstant",
      "signature": "CopyMaterialUniformParametersEditorOnly(Target, Source, Include Static Params)",
      "params": [
        {
          "name": "Target",
          "type": "UMaterialInstanceConstant*"
        },
        {
          "name": "Source",
          "type": "UMaterialInterface*"
        },
        {
          "name": "Include Static Params",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Void",
      "docs": "Copies the uniform parameters (scalar, vector and texture) from a material or instance hierarchy.\nThis will typically be faster than parsing all expressions but still slow as it must walk the full\nmaterial hierarchy as each parameter may be overridden at any level in the chain.\nNote: This will not copy font parameters"
    },
