      "signature": "GetNumMatchingEntities(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FMassEntityQuery*"
        }
      ],
      "returnType": "Int",
      "docs": "Goes through ValidArchetypes and sums up the number of entities contained in them.\nNote that the function is not const because calling it can result in re-caching of ValidArchetypes\n@return the number of entities this given query would process if called \"now\""
    },
    {
      "id": "get-num-matching-entities-33c6c8",
      "name": "GetNumMatchingEntities",
      "category": "MassEntityQuery",
      "signature": "GetNumMatchingEntities(Target, Entity Collections)",
      "params": [
        {
          "name": "Target",
          "type": "FMassEntityQuery*"
        },
        {
          "name": "Entity Collections",
          "type": "TConstArrayView<FMassArchetypeEntityCollection>"
        }
      ],
      "returnType": "Int",
      "docs": "Sums the entity range lengths for each collection in EntityCollections, where the collection's\narchetype matches the query's requirements.\n@return the number of entities this given query would process if called \"now\" for EntityCollections"
    },
