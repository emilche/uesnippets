    {
      "id": "update-external-acceleration-structure-external",
      "name": "UpdateExternalAccelerationStructure_External",
      "category": "PBDRigidsEvolution",
      "signature": "UpdateExternalAccelerationStructure_External(Target, External Structure, Pending External)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionBase*"
        },
        {
          "name": "External Structure",
          "type": "ISpatialAccelerationCollection<FAccelerationStructureHandle,FReal,3>*&"
        },
        {
          "name": "Pending External",
          "type": "FPendingSpatialDataQueue&"
        }
      ],
      "returnType": "Void",
      "docs": "Make a copy of the acceleration structure to allow for external modification.\nThis is needed for supporting sync operations on SQ structure from game thread. You probably want to go through solver which maintains PendingExternal"
    },
    {
      "id": "flush-spatial-acceleration",
      "name": "FlushSpatialAcceleration",
      "category": "PBDRigidsEvolution",
      "signature": "FlushSpatialAcceleration(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Perform a blocking flush of the spatial acceleration structure for situations where we aren't simulating but must have an up to date structure"
    },
    {
      "id": "rebuild-spatial-acceleration-for-perf-test",
      "name": "RebuildSpatialAccelerationForPerfTest",
      "category": "PBDRigidsEvolution",
      "signature": "RebuildSpatialAccelerationForPerfTest(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionBase*"
        }
      ],
      "returnType": "Void",
      "docs": "Rebuilds the spatial acceleration from scratch. This should only be used for perf testing"
    },
    {
      "id": "compute-intermediate-spatial-acceleration",
      "name": "ComputeIntermediateSpatialAcceleration",
      "category": "PBDRigidsEvolution",
      "signature": "ComputeIntermediateSpatialAcceleration(Target, Block)",
      "params": [
        {
          "name": "Target",
          "type": "FPBDRigidsEvolutionBase*"
        },
        {
          "name": "Block",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Ticks computation of acceleration structures. Normally handled by Advance, but if not advancing can be called to incrementally build structures."
    },
