{
  "id": "hlod-proxy",
  "label": "HLODProxy",
  "includepath": "Engine/HLODProxy.h",
  "includes": [
    "CoreMinimal",
    "HLODProxyDesc",
    "HLODProxyMesh",
    "HLODProxy.generated"
  ],
  "functions": [
    {
      "id": "get-map",
      "name": "GetMap",
      "category": "HLODProxy",
      "signature": "GetMap(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        }
      ],
      "returnType": "TSoftObjectPtr<UWorld>",
      "docs": "Get the owner map for this HLOD proxy"
    },
    {
      "id": "add-lod-actor",
      "name": "AddLODActor",
      "category": "HLODProxy",
      "signature": "AddLODActor(Target, In LOD Actor)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In LOD Actor",
          "type": "ALODActor*"
        }
      ],
      "returnType": "UHLODProxyDesc*",
      "docs": "Register an HLODProxyDesc, building it from an existing LODActor"
    },
    {
      "id": "add-mesh",
      "name": "AddMesh",
      "category": "HLODProxy",
      "signature": "AddMesh(Target, In LOD Actor, In Static Mesh, In Key)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In LOD Actor",
          "type": "ALODActor*"
        },
        {
          "name": "In Static Mesh",
          "type": "UStaticMesh*"
        },
        {
          "name": "In Key",
          "type": "Name&"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a static mesh and the key used to generate it"
    },
    {
      "id": "clean",
      "name": "Clean",
      "category": "HLODProxy",
      "signature": "Clean(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Clean out invalid proxy mesh entries"
    },
    {
      "id": "spawn-lod-actors",
      "name": "SpawnLODActors",
      "category": "HLODProxy",
      "signature": "SpawnLODActors(Target, In Level)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In Level",
          "type": "ULevel*"
        }
      ],
      "returnType": "Void",
      "docs": "Spawn LODActors from the HLODProxyDescs found in this proxy."
    },
    {
      "id": "update-hlod-descs",
      "name": "UpdateHLODDescs",
      "category": "HLODProxy",
      "signature": "UpdateHLODDescs(Target, In Level)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In Level",
          "type": "ULevel*"
        }
      ],
      "returnType": "Void",
      "docs": "Update the HLODDesc stored in this proxy using existing LODActors from the level"
    },
    {
      "id": "find-first-actor",
      "name": "FindFirstActor",
      "category": "HLODProxy",
      "signature": "FindFirstActor(LOD Actor)",
      "params": [
        {
          "name": "LOD Actor",
          "type": "ALODActor*"
        }
      ],
      "returnType": "AActor*",
      "docs": "Helper for recursive traversing LODActors to retrieve a semi deterministic first AActor for resulting asset naming"
    },
    {
      "id": "extract-components",
      "name": "ExtractComponents",
      "category": "HLODProxy",
      "signature": "ExtractComponents(LOD Actor, In Out Components)",
      "params": [
        {
          "name": "LOD Actor",
          "type": "ALODActor*"
        },
        {
          "name": "In Out Components",
          "type": "TArray<UPrimitiveComponent*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Extract components that we would use for LOD generation. Used to generate keys for LOD actors."
    },
    {
      "id": "generate-key-for-actor",
      "name": "GenerateKeyForActor",
      "category": "HLODProxy",
      "signature": "GenerateKeyForActor(LOD Actor, Must Undo Level Transform)",
      "params": [
        {
          "name": "LOD Actor",
          "type": "ALODActor*"
        },
        {
          "name": "Must Undo Level Transform",
          "type": "Bool",
          "default": "true"
        }
      ],
      "returnType": "Name",
      "docs": "Build a unique key for the LOD actor, used to determine if the actor needs rebuilding"
    },
    {
      "id": "get-crc-6b056f",
      "name": "GetCRC",
      "category": "HLODProxy",
      "signature": "GetCRC(In Transform, In CRC)",
      "params": [
        {
          "name": "In Transform",
          "type": "FTransform&"
        },
        {
          "name": "In CRC",
          "type": "UInt",
          "default": "0"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-crc-6d1a3f",
      "name": "GetCRC",
      "category": "HLODProxy",
      "signature": "GetCRC(In Material Interface, In CRC)",
      "params": [
        {
          "name": "In Material Interface",
          "type": "UMaterialInterface*"
        },
        {
          "name": "In CRC",
          "type": "UInt",
          "default": "0"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-crc-c9db79",
      "name": "GetCRC",
      "category": "HLODProxy",
      "signature": "GetCRC(In Texture, In CRC)",
      "params": [
        {
          "name": "In Texture",
          "type": "UTexture*"
        },
        {
          "name": "In CRC",
          "type": "UInt",
          "default": "0"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-crc-ea941b",
      "name": "GetCRC",
      "category": "HLODProxy",
      "signature": "GetCRC(In Static Mesh, In CRC, In Consider Physic Data)",
      "params": [
        {
          "name": "In Static Mesh",
          "type": "UStaticMesh*"
        },
        {
          "name": "In CRC",
          "type": "UInt",
          "default": "0"
        },
        {
          "name": "In Consider Physic Data",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "get-crc-2c7806",
      "name": "GetCRC",
      "category": "HLODProxy",
      "signature": "GetCRC(In Component, In CRC, Transform Components)",
      "params": [
        {
          "name": "In Component",
          "type": "UStaticMeshComponent*"
        },
        {
          "name": "In CRC",
          "type": "UInt",
          "default": "0"
        },
        {
          "name": "Transform Components",
          "type": "FTransform&",
          "default": "FTransform::Identity"
        }
      ],
      "returnType": "UInt"
    },
    {
      "id": "is-empty",
      "name": "IsEmpty",
      "category": "HLODProxy",
      "signature": "IsEmpty(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        }
      ],
      "returnType": "Bool",
      "docs": "Returns true if proxy doesn't contain any mesh entry."
    },
    {
      "id": "delete-package",
      "name": "DeletePackage",
      "category": "HLODProxy",
      "signature": "DeletePackage(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        }
      ],
      "returnType": "Void",
      "docs": "Destroy all assets & delete this HLOD proxy package."
    },
    {
      "id": "set-hlod-baking-transform",
      "name": "SetHLODBakingTransform",
      "category": "HLODProxy",
      "signature": "SetHLODBakingTransform(Target, In Transform)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In Transform",
          "type": "FTransform&"
        }
      ],
      "returnType": "Bool",
      "docs": "Specify the transform to apply to the source meshes when building HLODs."
    },
    {
      "id": "extract-static-mesh-components-from-lod-actor",
      "name": "ExtractStaticMeshComponentsFromLODActor",
      "category": "HLODProxy",
      "signature": "ExtractStaticMeshComponentsFromLODActor(LOD Actor, In Out Components)",
      "params": [
        {
          "name": "LOD Actor",
          "type": "ALODActor*"
        },
        {
          "name": "In Out Components",
          "type": "TArray<UStaticMeshComponent*>&"
        }
      ],
      "returnType": "Void",
      "docs": "Recursively retrieves StaticMeshComponents from a LODActor and its child LODActors\n@param Actor - LODActor instance\n@param InOutComponents - Will hold the StaticMeshComponents"
    },
    {
      "id": "contains-data-for-actor",
      "name": "ContainsDataForActor",
      "category": "HLODProxy",
      "signature": "ContainsDataForActor(Target, In LOD Actor)",
      "params": [
        {
          "name": "Target",
          "type": "UHLODProxy*"
        },
        {
          "name": "In LOD Actor",
          "type": "ALODActor*"
        }
      ],
      "returnType": "Bool",
      "docs": "Check if we contain data for the specified actor"
    }
  ]
}