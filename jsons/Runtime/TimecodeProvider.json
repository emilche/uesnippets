{
  "id": "timecode-provider",
  "label": "TimecodeProvider",
  "includepath": "Engine/TimecodeProvider.h",
  "functions": [
    {
      "id": "fetch-timecode",
      "name": "FetchTimecode",
      "category": "Provider",
      "signature": "FetchTimecode(Target, Out Frame Time)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        },
        {
          "name": "Out Frame Time",
          "type": "FQualifiedFrameTime&"
        }
      ],
      "returnType": "enum class ETimecodeProviderSynchronizationState",
      "docs": "Fetch current timecode from its source. e.g. From hardware/network/file/etc.\nIt is recommended to cache the fetched timecode."
    },
    {
      "id": "get-qualified-frame-time",
      "name": "GetQualifiedFrameTime",
      "category": "Provider",
      "signature": "GetQualifiedFrameTime(Target, F Qualified Frame Time)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        },
        {
          "name": "F Qualified Frame Time",
          "type": ") PURE_VIRTUAL ( UTimecodeProvider::GetQualifiedFrameTime,return"
        }
      ],
      "returnType": "FQualifiedFrameTime",
      "docs": "Return current frame time.\nSince it may be called several times per frame, it is suggested to return a cached value."
    },
    {
      "id": "get-delayed-qualified-frame-time",
      "name": "GetDelayedQualifiedFrameTime",
      "category": "Provider",
      "signature": "GetDelayedQualifiedFrameTime(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        }
      ],
      "returnType": "FQualifiedFrameTime",
      "docs": "Return current frame time with FrameDelay applied.\nOnly assume valid when GetSynchronizationState() returns Synchronized."
    },
    {
      "id": "get-timecode",
      "name": "GetTimecode",
      "category": "Provider",
      "signature": "GetTimecode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        }
      ],
      "returnType": "FTimecode",
      "docs": "Return the frame time converted into a timecode value."
    },
    {
      "id": "get-delayed-timecode",
      "name": "GetDelayedTimecode",
      "category": "Provider",
      "signature": "GetDelayedTimecode(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        }
      ],
      "returnType": "FTimecode",
      "docs": "Return the delayed frame time converted into a timecode value."
    },
    {
      "id": "get-frame-rate",
      "name": "GetFrameRate",
      "category": "Provider",
      "signature": "GetFrameRate(Target)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        }
      ],
      "returnType": "FFrameRate",
      "docs": "Return the frame rate of the frame time."
    },
    {
      "id": "get-synchronization-state",
      "name": "GetSynchronizationState",
      "category": "Provider",
      "signature": "GetSynchronizationState(Target, Closed)",
      "params": [
        {
          "name": "Target",
          "type": "UTimecodeProvider*"
        },
        {
          "name": "Closed",
          "type": ") PURE_VIRTUAL ( UTimecodeProvider::IsSynchronized,return ETimecodeProviderSynchronizationState::"
        }
      ],
      "returnType": "ETimecodeProviderSynchronizationState",
      "docs": "The state of the TimecodeProvider and if it's currently synchronized and the Timecode and FrameRate getters are valid."
    }
  ]
}