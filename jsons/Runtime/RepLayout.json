{
  "id": "rep-layout",
  "label": "RepLayout",
  "includepath": "Net/RepLayout.h",
  "includes": [
    "CoreMinimal",
    "NetworkGuid",
    "CoreNet",
    "EngineTypes",
    "GCObject",
    "StaticBitArray",
    "GuidReferences",
    "NetTokenExportContext",
    "PushModel",
    "RepChangedPropertyTracker",
    "CopyQualifiersFromTo"
  ],
  "functions": [
    {
      "id": "create-from-class",
      "name": "CreateFromClass",
      "category": "RepLayout",
      "signature": "CreateFromClass(In Object Class, Server Connection, Flags)",
      "params": [
        {
          "name": "In Object Class",
          "type": "UClass*"
        },
        {
          "name": "Server Connection",
          "type": "UNetConnection*",
          "default": "nullptr"
        },
        {
          "name": "Flags",
          "type": "ECreateRepLayoutFlags",
          "default": "ECreateRepLayoutFlags::None"
        }
      ],
      "returnType": "TSharedPtr<FRepLayout>",
      "docs": "Creates a new FRepLayout for the given class."
    },
    {
      "id": "create-from-struct",
      "name": "CreateFromStruct",
      "category": "RepLayout",
      "signature": "CreateFromStruct(In Struct, Server Connection, Flags)",
      "params": [
        {
          "name": "In Struct",
          "type": "UStruct*"
        },
        {
          "name": "Server Connection",
          "type": "UNetConnection*",
          "default": "nullptr"
        },
        {
          "name": "Flags",
          "type": "ECreateRepLayoutFlags",
          "default": "ECreateRepLayoutFlags::None"
        }
      ],
      "returnType": "TSharedPtr<FRepLayout>",
      "docs": "Creates a new FRepLayout for the given struct."
    },
    {
      "id": "send-properties-for-rpc",
      "name": "SendPropertiesForRPC",
      "category": "RepLayout",
      "signature": "SendPropertiesForRPC(Target, Function, Channel, Writer, Data)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        },
        {
          "name": "Function",
          "type": "UFunction*"
        },
        {
          "name": "Channel",
          "type": "UActorChannel*"
        },
        {
          "name": "Writer",
          "type": "FNetBitWriter&"
        },
        {
          "name": "Data",
          "type": "FConstRepObjectDataBuffer"
        }
      ],
      "returnType": "Void",
      "docs": "@see SendProperties."
    },
    {
      "id": "build-shared-serialization-for-rpc",
      "name": "BuildSharedSerializationForRPC",
      "category": "RepLayout",
      "signature": "BuildSharedSerializationForRPC(Target, Data, Net Token Store)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        },
        {
          "name": "Data",
          "type": "FConstRepObjectDataBuffer"
        },
        {
          "name": "Net Token Store",
          "type": "UE::Net::FNetTokenStore*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void",
      "docs": "Builds shared serialization state for a multicast rpc"
    },
    {
      "id": "clear-shared-serialization-for-rpc",
      "name": "ClearSharedSerializationForRPC",
      "category": "RepLayout",
      "signature": "ClearSharedSerializationForRPC(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        }
      ],
      "returnType": "Void",
      "docs": "Clears shared serialization state for a multicast rpc"
    },
    {
      "id": "serialize-properties-for-struct",
      "name": "SerializePropertiesForStruct",
      "category": "RepLayout",
      "signature": "SerializePropertiesForStruct(Target, Struct, Ar, Map, Data, Has Unmapped, Owning Object)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        },
        {
          "name": "Struct",
          "type": "UStruct*"
        },
        {
          "name": "Ar",
          "type": "FBitArchive&"
        },
        {
          "name": "Map",
          "type": "UPackageMap*"
        },
        {
          "name": "Data",
          "type": "FRepObjectDataBuffer"
        },
        {
          "name": "Has Unmapped",
          "type": "Bool&"
        },
        {
          "name": "Owning Object",
          "type": "UObject*",
          "default": "nullptr"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "serialize-object-replicated-properties",
      "name": "SerializeObjectReplicatedProperties",
      "category": "RepLayout",
      "signature": "SerializeObjectReplicatedProperties(Target, Object, Ar)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        },
        {
          "name": "Object",
          "type": "UObject*"
        },
        {
          "name": "Ar",
          "type": "FBitArchive&"
        }
      ],
      "returnType": "Void",
      "docs": "Serializes all replicated properties of a UObject in or out of an archive (depending on what type of archive it is)."
    },
    {
      "id": "add-referenced-objects",
      "name": "AddReferencedObjects",
      "category": "RepLayout",
      "signature": "AddReferencedObjects(Target, Collector)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        },
        {
          "name": "Collector",
          "type": "FReferenceCollector&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "get-referencer-name",
      "name": "GetReferencerName",
      "category": "RepLayout",
      "signature": "GetReferencerName(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FRepLayout*"
        }
      ],
      "returnType": "String"
    }
  ]
}