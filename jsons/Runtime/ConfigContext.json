    },
    {
      "id": "load-44244a",
      "name": "Load",
      "category": "ConfigContext",
      "signature": "Load(Target, Ini Name)",
      "params": [
        {
          "name": "Target",
          "type": "FConfigContext*"
        },
        {
          "name": "Ini Name",
          "type": "TCHAR*"
        }
      ],
      "returnType": "Bool",
      "docs": "Use the context to perform the actual load operation. Note that this is where you specify the Ini name (for instance \"Engine\"), meaning\nyou can use the same context for multiple configs (Engine, Game, Input, etc)"
    },
    {
      "id": "load-b9b2a6",
      "name": "Load",
      "category": "ConfigContext",
      "signature": "Load(Target, Ini Name, Out Filename)",
      "params": [
        {
          "name": "Target",
          "type": "FConfigContext*"
        },
        {
          "name": "Ini Name",
          "type": "TCHAR*"
        },
        {
          "name": "Out Filename",
          "type": "String&"
        }
      ],
      "returnType": "Bool",
      "docs": "Use the context to perform the actual load operation as above, but will return the generated final ini filename (in the case of GConfig, this would\nbe the key used to look up into GConfig, for example)"
    },
    {
      "id": "get-per-platform-dirs",
      "name": "GetPerPlatformDirs",
      "category": "ConfigContext",
      "signature": "GetPerPlatformDirs(Target, Platform Name)",
      "params": [
        {
          "name": "Target",
          "type": "FConfigContext*"
        },
        {
          "name": "Platform Name",
          "type": "String&"
        }
      ],
      "returnType": "FPerPlatformDirs&",
      "docs": "Return the paths to use to find hierarchical config files for the given platform (note that these are independent of the ini name)"
    }
