  "functions": [
    {
      "id": "add-asset",
      "name": "AddAsset",
      "category": "DataflowContextAssetStore",
      "signature": "AddAsset(Target, Persistent Asset Path, Asset Class)",
      "params": [
        {
          "name": "Target",
          "type": "FContextAssetStore*"
        },
        {
          "name": "Persistent Asset Path",
          "type": "String&"
        },
        {
          "name": "Asset Class",
          "type": "UClass*"
        }
      ],
      "returnType": "UObject*",
      "docs": "Create an new asset to be commited later ( when the terminal nodes are evaluated )\nWhen commited, the asset will be duplicated to a final package matching PersistentAssetPath\n@return an UObject owned by the transient package"
    },
    {
      "id": "commit-asset-d57f83",
      "name": "CommitAsset",
      "category": "DataflowContextAssetStore",
      "signature": "CommitAsset(Target, Transient Asset Path)",
      "params": [
        {
          "name": "Target",
          "type": "FContextAssetStore*"
        },
        {
          "name": "Transient Asset Path",
          "type": "String&"
        }
      ],
      "returnType": "UObject*",
      "docs": "Commit the asset matching the TransientAssetPath\nIf such asset was added previously this will duplicate it and save it to a persistent package\n@return the newly created persistent UObject asset"
    },
    {
      "id": "commit-asset-734c05",
      "name": "CommitAsset",
      "category": "DataflowContextAssetStore",
      "signature": "CommitAsset(Target, Transient Asset)",
      "params": [
        {
          "name": "Target",
          "type": "FContextAssetStore*"
        },
        {
          "name": "Transient Asset",
          "type": "UObject*"
        }
      ],
      "returnType": "UObject*",
      "docs": "Commit the asset matching the TransientAsset\nIf such asset was added previously this will duplicate it and save it to a package matching AssetPath\n@return the newly created persistent UObject asset"
    },
    {
