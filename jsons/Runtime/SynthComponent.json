    {
      "id": "fade-in",
      "name": "FadeIn",
      "category": "Audio",
      "signature": "FadeIn(Target, Fade In Duration, Fade Volume Level, Start Time, Fade Curve)",
      "params": [
        {
          "name": "Target",
          "type": "USynthComponent*"
        },
        {
          "name": "Fade In Duration",
          "type": "Float"
        },
        {
          "name": "Fade Volume Level",
          "type": "Float",
          "default": "1.0f"
        },
        {
          "name": "Start Time",
          "type": "Float",
          "default": "0.0f"
        },
        {
          "name": "Fade Curve",
          "type": "EAudioFaderCurve",
          "default": "EAudioFaderCurve::Linear"
        }
      ],
      "returnType": "Void",
      "docs": "This function allows designers to call Play on an Audio Component instance while applying a volume curve over time.\nParameters allow designers to indicate the duration of the fade, the curve shape, and the start time if seeking into the sound.\n@param FadeInDuration How long it should take to reach the FadeVolumeLevel\n@param FadeVolumeLevel The percentage of the AudioComponents's calculated volume to fade to\n@param FadeCurve The curve to use when interpolating between the old and new volume"
    },
    {
      "id": "fade-out",
      "name": "FadeOut",
      "category": "Audio",
      "signature": "FadeOut(Target, Fade Out Duration, Fade Volume Level, Fade Curve)",
      "params": [
        {
          "name": "Target",
          "type": "USynthComponent*"
        },
        {
          "name": "Fade Out Duration",
          "type": "Float"
        },
        {
          "name": "Fade Volume Level",
          "type": "Float"
        },
        {
          "name": "Fade Curve",
          "type": "EAudioFaderCurve",
          "default": "EAudioFaderCurve::Linear"
        }
      ],
      "returnType": "Void",
      "docs": "This function allows designers to call a delayed Stop on an Audio Component instance while applying a\nvolume curve over time. Parameters allow designers to indicate the duration of the fade and the curve shape.\n@param FadeOutDuration how long it should take to reach the FadeVolumeLevel\n@param FadeVolumeLevel the percentage of the AudioComponents's calculated volume in which to fade to\n@param FadeCurve The curve to use when interpolating between the old and new volume"
    },
    {
      "id": "adjust-volume",
      "name": "AdjustVolume",
      "category": "Audio",
      "signature": "AdjustVolume(Target, Adjust Volume Duration, Adjust Volume Level, Fade Curve)",
      "params": [
        {
          "name": "Target",
          "type": "USynthComponent*"
        },
        {
          "name": "Adjust Volume Duration",
          "type": "Float"
        },
        {
          "name": "Adjust Volume Level",
          "type": "Float"
        },
        {
          "name": "Fade Curve",
          "type": "EAudioFaderCurve",
          "default": "EAudioFaderCurve::Linear"
        }
      ],
      "returnType": "Void",
      "docs": "This function allows designers to trigger an adjustment to the sound instance\u2019s playback Volume with options for smoothly applying a curve over time.\n@param AdjustVolumeDuration The length of time in which to interpolate between the initial volume and the new volume.\n@param AdjustVolumeLevel The new volume to set the Audio Component to.\n@param FadeCurve The curve used when interpolating between the old and new volume."
    },
    {
      "id": "set-modulation-routing",
      "name": "SetModulationRouting",
      "category": "Audio",
      "signature": "SetModulationRouting(Target, Modulators, Destination, Routing Method)",
      "params": [
        {
          "name": "Target",
          "type": "USynthComponent*"
        },
        {
          "name": "Modulators",
          "type": "TSet<USoundModulatorBase*>&"
        },
        {
          "name": "Destination",
          "type": "EModulationDestination"
        },
        {
          "name": "Routing Method",
          "type": "EModulationRouting",
          "default": "EModulationRouting::Inherit"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the routing for one of the given Synth component's Modulation Destinations.\n@param Modulators The set of modulators to apply to the given destination on the component.\n@param Destination The destination to assign the modulators to.\n@param RoutingMethod The routing method to use for the given modulator."
    },
