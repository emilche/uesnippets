          "type": "EModulationDestination"
        },
        {
          "name": "Routing Method",
          "type": "EModulationRouting",
          "default": "EModulationRouting::Inherit"
        }
      ],
      "returnType": "Void",
      "docs": "Sets the routing for one of the given Synth component's Modulation Destinations.\n@param Modulators The set of modulators to apply to the given destination on the component.\n@param Destination The destination to assign the modulators to.\n@param RoutingMethod The routing method to use for the given modulator."
