  "functions": [
    {
      "id": "overlap-query",
      "name": "OverlapQuery",
      "category": "GeometryQueries",
      "signature": "OverlapQuery(A, ATM, B, BTM, Thickness, Out MTD)",
      "params": [
        {
          "name": "A",
          "type": "FImplicitObject&"
        },
        {
          "name": "ATM",
          "type": "FRigidTransform3&"
        },
        {
          "name": "B",
          "type": "QueryGeometry&"
        },
        {
          "name": "BTM",
          "type": "FRigidTransform3&"
        },
        {
          "name": "Thickness",
          "type": "FReal",
          "default": "0"
        },
        {
          "name": "Out MTD",
          "type": "FMTDInfo*",
          "default": "nullptr"
        }
      ],
      "returnType": "template<QueryGeometry> bool"
    },
    {
      "id": "sweep-query",
      "name": "SweepQuery",
      "category": "GeometryQueries",
      "signature": "SweepQuery(A, ATM, B, BTM, Dir, Length, Out Time, Out Position, Out Normal, Out Face Index, Out Face Normal, Thickness, Compute MTD)",
      "params": [
        {
          "name": "A",
          "type": "FImplicitObject&"
        },
        {
          "name": "ATM",
          "type": "FRigidTransform3&"
        },
        {
          "name": "B",
          "type": "SweptGeometry&"
        },
        {
          "name": "BTM",
          "type": "FRigidTransform3&"
        },
        {
          "name": "Dir",
          "type": "FVec3&"
        },
        {
          "name": "Length",
          "type": "FReal"
        },
        {
          "name": "Out Time",
          "type": "FReal&"
        },
        {
          "name": "Out Position",
          "type": "FVec3&"
        },
        {
          "name": "Out Normal",
          "type": "FVec3&"
        },
        {
          "name": "Out Face Index",
          "type": "Int&"
        },
        {
          "name": "Out Face Normal",
          "type": "FVec3&"
        },
        {
          "name": "Thickness",
          "type": "FReal"
        },
        {
          "name": "Compute MTD",
          "type": "Bool"
        }
      ],
      "returnType": "template<SweptGeometry> bool"
    }
  ]
}