      "category": "ShaderParameters",
      "signature": "CreateUniformBufferShaderDeclaration(Name, Uniform Buffer Struct, Uniform Buffer SB Layout)",
      "params": [
        {
          "name": "Name",
          "type": "TCHAR*"
        },
        {
          "name": "Uniform Buffer Struct",
