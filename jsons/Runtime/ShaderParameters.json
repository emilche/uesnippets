        {
          "name": "Out Environment",
          "type": "FShaderCompilerEnvironment&"
        },
        {
          "name": "In Uniform Buffers",
          "type": "TSet<FShaderParametersMetadata*>&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "bind-e4ed39",
      "name": "Bind",
      "category": "ShaderParameters",
      "signature": "Bind(Target, Parameter Map, Parameter Name, Flags)",
      "params": [
        {
          "name": "Target",
          "type": "FShaderParameter*"
        },
        {
          "name": "Parameter Map",
          "type": "FShaderParameterMap&"
        },
        {
          "name": "Parameter Name",
          "type": "TCHAR*"
        },
        {
          "name": "Flags",
