        },
        {
          "name": "Out Environment",
          "type": "FShaderCompilerEnvironment&"
        }
      ],
      "returnType": "Void"
    },
    {
      "id": "bind-06fe1d",
      "name": "Bind",
      "category": "ShaderParameters",
