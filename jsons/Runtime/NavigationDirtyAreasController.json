    {
      "id": "add-area-2004ed",
      "name": "AddArea",
      "category": "NavigationDirtyAreasController",
      "signature": "AddArea(Target, New Area, Flags, Element Provider Func, Dirty Element, Debug Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationDirtyAreasController*"
        },
        {
          "name": "New Area",
          "type": "FBox&"
        },
        {
          "name": "Flags",
          "type": "ENavigationDirtyFlag"
        },
        {
          "name": "Element Provider Func",
          "type": "TFunction<TSharedPtr<FNavigationElement> ( )>&",
          "default": "nullptr"
        },
        {
          "name": "Dirty Element",
          "type": "FNavigationDirtyElement*",
          "default": "nullptr"
        },
        {
          "name": "Debug Reason",
          "type": "Name&",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Add a dirty area to the queue based on the provided bounds and flags.\nBounds must be valid and non-empty otherwise the request will be ignored and a warning reported.\nAccumulation must be allowed and flags valid otherwise the add is ignored.\n@param NewArea Bounding box of the affected area\n@param Flags Indicates the type of modification applied to the area\n@param ElementProviderFunc Optional function to retrieve source element that can be used for error reporting and navmesh exclusion\n@param DirtyElement Optional dirty element\n@param DebugReason Source of the new area"
    },
    {
      "id": "add-area-193733",
      "name": "AddArea",
      "category": "NavigationDirtyAreasController",
      "signature": "AddArea(Target, New Area, Flags, Object Provider Func, Dirty Element, Debug Reason)",
      "params": [
        {
          "name": "Target",
