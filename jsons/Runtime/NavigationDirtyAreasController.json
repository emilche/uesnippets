    {
      "id": "add-areas-8472e8",
      "name": "AddAreas",
      "category": "NavigationDirtyAreasController",
      "signature": "AddAreas(Target, New Areas, Flags, Element Provider Func, Dirty Element, Debug Reason)",
      "params": [
        {
          "name": "Target",
          "type": "FNavigationDirtyAreasController*"
        },
        {
          "name": "New Areas",
          "type": "TConstArrayView<FBox>"
        },
        {
          "name": "Flags",
          "type": "ENavigationDirtyFlag"
        },
        {
          "name": "Element Provider Func",
          "type": "TFunction<TSharedPtr<FNavigationElement> ( )>&",
          "default": "nullptr"
        },
        {
          "name": "Dirty Element",
          "type": "FNavigationDirtyElement*",
          "default": "nullptr"
        },
        {
          "name": "Debug Reason",
          "type": "Name&",
          "default": "NAME_None"
        }
      ],
      "returnType": "Void",
      "docs": "Add non-empty list of dirty areas to the queue based on the provided bounds and flags.\nBounds must be valid and non-empty otherwise the request will be ignored and a warning reported.\nAccumulation must be allowed and flags valid otherwise the add is ignored.\nA check will be triggered if an empty array is provided.\n@param NewAreas Array of bounding boxes of the affected areas\n@param Flags Indicates the type of modification applied to the area\n@param ElementProviderFunc Optional function to retrieve source element that can be used for error reporting and navmesh exclusion\n@param DirtyElement Optional dirty element\n@param DebugReason Source of the new area"
    },
