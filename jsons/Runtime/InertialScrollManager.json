{
  "id": "inertial-scroll-manager",
  "label": "InertialScrollManager",
  "includepath": "Framework/Layout/InertialScrollManager.h",
  "includes": [
    "Array",
    "CoreMinimal"
  ],
  "functions": [
    {
      "id": "add-scroll-sample",
      "name": "AddScrollSample",
      "category": "InertialScrollManager",
      "signature": "AddScrollSample(Target, Delta, Current Time)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        },
        {
          "name": "Delta",
          "type": "Float"
        },
        {
          "name": "Current Time",
          "type": "Double"
        }
      ],
      "returnType": "Void",
      "docs": "Adds a scroll velocity sample to help calculate a smooth velocity"
    },
    {
      "id": "update-scroll-velocity",
      "name": "UpdateScrollVelocity",
      "category": "InertialScrollManager",
      "signature": "UpdateScrollVelocity(Target, In Delta Time)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        },
        {
          "name": "In Delta Time",
          "type": "Float"
        }
      ],
      "returnType": "Void",
      "docs": "Updates the current scroll velocity. Call every frame."
    },
    {
      "id": "clear-scroll-velocity",
      "name": "ClearScrollVelocity",
      "category": "InertialScrollManager",
      "signature": "ClearScrollVelocity(Target, In Should Stop Scroll Now)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        },
        {
          "name": "In Should Stop Scroll Now",
          "type": "Bool",
          "default": "false"
        }
      ],
      "returnType": "Void",
      "docs": "Stop the accumulation of inertial scroll.\n@param bInShouldStopScrollNow true implies the scroll will stop instantly, else the list will scroll until any accumulated scroll offset is cleared."
    },
    {
      "id": "get-scroll-velocity",
      "name": "GetScrollVelocity",
      "category": "InertialScrollManager",
      "signature": "GetScrollVelocity(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        }
      ],
      "returnType": "Float",
      "docs": "Gets the calculated velocity of the scroll."
    },
    {
      "id": "get-should-stop-scroll-now",
      "name": "GetShouldStopScrollNow",
      "category": "InertialScrollManager",
      "signature": "GetShouldStopScrollNow(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        }
      ],
      "returnType": "Bool",
      "docs": "Gets the the value of bShouldStopScrollNow."
    },
    {
      "id": "reset-should-stop-scroll-now",
      "name": "ResetShouldStopScrollNow",
      "category": "InertialScrollManager",
      "signature": "ResetShouldStopScrollNow(Target)",
      "params": [
        {
          "name": "Target",
          "type": "FInertialScrollManager*"
        }
      ],
      "returnType": "Void",
      "docs": "Set the value of bShouldStopScrollNow to false."
    }
  ]
}